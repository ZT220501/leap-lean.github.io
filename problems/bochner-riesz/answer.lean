  have h_occ_P : ∀ (z : EuclideanSpace ℝ (Fin 2)) (r : ℝ), ρ ≤ r → r ≤ 1 →
      ((Finset.univ.filter (fun u : Fin N => ‖y u - z‖ < 3 * r)).card : ℝ) ≤
        B_P * (r / ρ) ^ d := by
    intro z r hr₀ hr₁
    rw [← hBP_eq]
    exact h_occ_P_raw z r hr₀ hr₁
  have h_occ_B : ∀ (a₀ r : ℝ), ρ ≤ r → r ≤ 1 →
      ((Finset.univ.filter (fun v : Fin Q => |a_samp v - a₀| < 2 * r)).card : ℝ) ≤
        B_B * (r / ρ) ^ s := by
    intro a₀ r hr₀ hr₁
    rw [← hBB_eq]
    exact h_occ_B_raw a₀ r hr₀ hr₁

  
  obtain ⟨M₀, P, T_fam, hM₀_pos, hM₀_lb, hP_dyad, hP_rho_raw,
      hT_geom, hT_deg_shell, hT_rho_raw, h_biUnion_ub⟩ :=
    h_inc_regularize N Q hN_ge1 hQ_ge1 ρ d s q M C_cov B_P B_B
      hρ hρ_sixth hd₀ hs₀ hq_pos hM hC h1_le_BP h1_le_BB hN_lb hQ_lb
      y (fun u => hy_P_dom (ω_P u)) a_samp (fun v => ha_sl_dom (ω_B v))
      (fun u v => G (ω_P u) (ω_B v)) h_edges h_occ_P h_occ_B
      (fun v => S_tilde (ω_B v)) (fun v => hS_tilde_card (ω_B v))
      (fun u v hGuv => hS_tilde_cov (ω_P u) (ω_B v) hGuv)

  
  let L_sh : ℕ := Nat.log 2 Q + 1
  have hL_sh_ub : (L_sh : ℝ) ≤ C_log * ρ ^ (-η) := by
    let k_Q := Nat.log 2 Q
    have h2kQ_le : ((2 ^ k_Q : ℕ) : ℝ) ≤ 2 * ρ⁻¹ := by
      have h_nat : 2 ^ k_Q ≤ Q := Nat.pow_log_le_self 2 (by omega)
      have h_real : ((2 ^ k_Q : ℕ) : ℝ) ≤ (Q : ℝ) := by exact_mod_cast h_nat
      have h_ρs_le : ρ ^ (-s) ≤ ρ⁻¹ := by
        rw [← Real.rpow_neg_one ρ]
        exact Real.rpow_le_rpow_of_exponent_ge hρ hρ_lt_one.le (by linarith only [hs₁])
      linarith only [h_real, hQ_ub, h_ρs_le]
    have h_bern : 1 + (k_Q : ℝ) * δ_2 ≤ ((2 : ℝ) ^ η) ^ k_Q := by
      have h1 := one_add_mul_le_pow (a := δ_2) (by linarith only [hδ_2_pos]) k_Q
      have h_add : 1 + δ_2 = (2 : ℝ) ^ η := by dsimp [δ_2]; ring
      rwa [h_add] at h1
    have h_pow_eq : ((2 : ℝ) ^ η) ^ k_Q = (((2 ^ k_Q : ℕ) : ℝ)) ^ η := by
      rw [← Real.rpow_natCast ((2 : ℝ) ^ η) k_Q, ← Real.rpow_mul (by norm_num) η (k_Q : ℝ),
          mul_comm η (k_Q : ℝ), Real.rpow_mul (by norm_num) (k_Q : ℝ) η, Real.rpow_natCast]
      push_cast
      rfl
    have h2η_le2 : (2 : ℝ) ^ η ≤ 2 := by
      calc (2 : ℝ) ^ η ≤ (2 : ℝ) ^ (1 : ℝ) :=
            Real.rpow_le_rpow_of_exponent_le (by norm_num) (by linarith only [hη_le_eighth])
        _ = 2 := Real.rpow_one 2
    have h_rhs_ub : (((2 ^ k_Q : ℕ) : ℝ)) ^ η ≤ 2 * ρ ^ (-η) := by
      calc (((2 ^ k_Q : ℕ) : ℝ)) ^ η
          ≤ (2 * ρ⁻¹) ^ η := Real.rpow_le_rpow (by positivity) h2kQ_le hη_pos.le
        _ = (2 : ℝ) ^ η * (ρ⁻¹) ^ η := Real.mul_rpow (by norm_num) (by positivity)
        _ = (2 : ℝ) ^ η * ρ ^ (-η) := by rw [Real.inv_rpow hρ.le, Real.rpow_neg hρ.le]
        _ ≤ 2 * ρ ^ (-η) := mul_le_mul_of_nonneg_right h2η_le2 (Real.rpow_nonneg hρ.le _)
    have hkQ_ub : (k_Q : ℝ) ≤ (2 / δ_2) * ρ ^ (-η) := by
      have h1 : (k_Q : ℝ) * δ_2 ≤ 2 * ρ ^ (-η) := by
        linarith only [h_bern, h_pow_eq, h_rhs_ub]
      rw [div_mul_eq_mul_div, le_div_iff₀ hδ_2_pos]
      exact h1
    have h1_le_ρη : 1 ≤ ρ ^ (-η) := by
      calc (1 : ℝ) = ρ ^ (0 : ℝ) := (Real.rpow_zero ρ).symm
        _ ≤ ρ ^ (-η) := Real.rpow_le_rpow_of_exponent_ge hρ hρ_lt_one.le (by linarith only [hη_pos])
    change ((k_Q + 1 : ℕ) : ℝ) ≤ (2 / δ_2 + 1) * ρ ^ (-η)
    push_cast
    linarith only [hkQ_ub, h1_le_ρη]

  have hC_rho_lt : C_rho ≤ ρ ^ (-η) := by
    have h1 : ρ ^ η < (C_rho⁻¹ ^ (1 / η)) ^ η :=
      Real.rpow_lt_rpow hρ.le hρ_lt_rset hη_pos
    rw [← Real.rpow_mul (by positivity), one_div_mul_cancel hη_pos.ne', Real.rpow_one] at h1
    have h_inv := (inv_lt_inv₀ (inv_pos.mpr hC_rho_pos) (Real.rpow_pos_of_pos hρ η)).mpr h1
    rw [inv_inv, ← Real.rpow_neg hρ.le] at h_inv
    exact h_inv.le

  have h_const_P_le : 4 * B_P ^ 2 * (L_sh : ℝ) / q ≤ ρ ^ (-η₀) := by
    have h_alg : 4 * B_P ^ 2 * (C_log * ρ ^ (-η)) / q = C_rho * ρ ^ (-8 * η) := by
      dsimp [B_P, C_rho, q]
      have h_pow : (ρ ^ (-3 * η)) ^ 2 * ρ ^ (-η) / ρ ^ η = ρ ^ (-8 * η) := by
        rw [sq, div_eq_mul_inv, ← Real.rpow_neg hρ.le,
            ← Real.rpow_add hρ, ← Real.rpow_add hρ, ← Real.rpow_add hρ]
        congr 1
        ring
      calc 4 * (C_P0 * ρ ^ (-3 * η)) ^ 2 * (C_log * ρ ^ (-η)) / ρ ^ η
          = (4 * C_P0 ^ 2 * C_log) * ((ρ ^ (-3 * η)) ^ 2 * ρ ^ (-η) / ρ ^ η) := by ring
        _ = (4 * C_P0 ^ 2 * C_log) * ρ ^ (-8 * η) := by rw [h_pow]
    calc 4 * B_P ^ 2 * (L_sh : ℝ) / q
        ≤ 4 * B_P ^ 2 * (C_log * ρ ^ (-η)) / q := by
          refine div_le_div_of_nonneg_right ?_ hq_pos.le
          exact mul_le_mul_of_nonneg_left hL_sh_ub (by positivity)
      _ = C_rho * ρ ^ (-8 * η) := h_alg
      _ ≤ ρ ^ (-η) * ρ ^ (-8 * η) :=
          mul_le_mul_of_nonneg_right hC_rho_lt (Real.rpow_nonneg hρ.le _)
      _ = ρ ^ (-9 * η) := by rw [← Real.rpow_add hρ]; ring_nf
      _ ≤ ρ ^ (-η₀) :=
          Real.rpow_le_rpow_of_exponent_ge hρ hρ_lt_one.le (by linarith only [hη_pos, h12η_le_η₀])

  have h_const_B_le : 4 * B_B ^ 2 / q ≤ ρ ^ (-η₀) := by
    have hBB_le_BP : B_B ≤ B_P :=
      mul_le_mul_of_nonneg_right hCB0_le_CP0 (Real.rpow_nonneg hρ.le _)
    have h1_le_Lsh : (1 : ℝ) ≤ (L_sh : ℝ) := by
      have : 1 ≤ L_sh := by dsimp [L_sh]; omega
      exact_mod_cast this
    have h_sq : B_B ^ 2 ≤ B_P ^ 2 :=
      pow_le_pow_left₀ (by linarith only [h1_le_BB]) hBB_le_BP 2
    have h_le_P : 4 * B_B ^ 2 / q ≤ 4 * B_P ^ 2 * (L_sh : ℝ) / q := by
      refine div_le_div_of_nonneg_right ?_ hq_pos.le
      calc 4 * B_B ^ 2 = (4 * B_B ^ 2) * 1 := (mul_one _).symm
        _ ≤ (4 * B_P ^ 2) * (L_sh : ℝ) :=
            mul_le_mul (by linarith only [h_sq]) h1_le_Lsh zero_le_one (by positivity)
    exact le_trans h_le_P h_const_P_le

  have h_rhoset_mono : ∀ {γ_exp C₁ C₂ : ℝ} {F : Finset (Set (EuclideanSpace ℝ (Fin 2)))},
      C₁ ≤ C₂ → IsRhoSet ρ γ_exp C₁ F → IsRhoSet ρ γ_exp C₂ F := by
    intro γ_exp C₁ C₂ F hC12 ⟨hF_ne, hF_b⟩
    refine ⟨hF_ne, fun z r hr₀ hr₁ => le_trans (hF_b z r hr₀ hr₁) ?_⟩
    refine mul_le_mul_of_nonneg_right ?_ (Nat.cast_nonneg _)
    exact mul_le_mul_of_nonneg_right hC12 (Real.rpow_nonneg (le_trans hρ.le hr₀) _)

  have hP_rhoset : IsRhoSet ρ d (ρ ^ (-η₀)) P := h_rhoset_mono h_const_P_le hP_rho_raw
  have hT_rhoset : ∀ p ∈ P, IsRhoSet ρ s (ρ ^ (-η₀)) (T_fam p) :=
    fun p hp => h_rhoset_mono h_const_B_le (hT_rho_raw p hp)

  have h_rw_est := h_rw ρ M₀ P T_fam hρ hρ_lt_ρ₀ hM₀_pos
    hP_dyad hP_rhoset hT_geom hT_deg_shell hT_rhoset

  let χ : ℝ := min 1 (min d ((d + s) / 2))
  have h_q_BB : q / (8 * B_B) = ρ ^ (4 * η) / (8 * C_B0) := by
    dsimp [q, B_B]
    have h_canc : ρ ^ (3 * η) * ρ ^ (-3 * η) = 1 := by
      rw [← Real.rpow_add hρ]
      have hz : 3 * η + -3 * η = 0 := by ring
      rw [hz, Real.rpow_zero]
    rw [div_eq_div_iff (by positivity) (by positivity)]
    calc ρ ^ η * (8 * C_B0)
        = (ρ ^ η * 1) * (8 * C_B0) := by ring
      _ = (ρ ^ η * (ρ ^ (3 * η) * ρ ^ (-3 * η))) * (8 * C_B0) := by rw [← h_canc]
      _ = (ρ ^ η * ρ ^ (3 * η)) * (8 * (C_B0 * ρ ^ (-3 * η))) := by ring
      _ = ρ ^ (4 * η) * (8 * (C_B0 * ρ ^ (-3 * η))) := by
          rw [← Real.rpow_add hρ]
          ring_nf

  have h_M_lb1 : C_end * (ρ ^ (-χ + α / 2) * ρ ^ (4 * η)) ≤ M := by
    have h_lhs_le : c_rw * ρ ^ (-χ + α / 2) * ((ρ ^ (4 * η) / (8 * C_B0)) * (Q : ℝ)) ≤
        (Q : ℝ) * (2 * (K_c : ℝ) + 1) * M := by
      rw [← h_q_BB]
      exact le_trans
        (mul_le_mul_of_nonneg_left hM₀_lb (by positivity))
        (le_trans h_rw_est h_biUnion_ub)
    have h_Q_canc : (c_rw * ρ ^ (-χ + α / 2) * (ρ ^ (4 * η) / (8 * C_B0))) * (Q : ℝ) ≤
        ((2 * (K_c : ℝ) + 1) * M) * (Q : ℝ) := by
      linarith only [h_lhs_le]
    have h_no_Q := le_of_mul_le_mul_right h_Q_canc hQ_pos_real
    have h2Kc_pos : (0 : ℝ) < 2 * (K_c : ℝ) + 1 := by positivity
    have h_div : (c_rw * ρ ^ (-χ + α / 2) * (ρ ^ (4 * η) / (8 * C_B0))) /
        (2 * (K_c : ℝ) + 1) ≤ M := by
      rw [div_le_iff₀ h2Kc_pos]
      linarith only [h_no_Q]
    refine le_trans (le_of_eq ?_) h_div
    dsimp [C_end]
    field_simp [hC_B0_pos.ne', h2Kc_pos.ne']

  have h_end_pow : ρ ^ (α / 4) ≤ C_end := by
    have hα4_pos : 0 < α / 4 := by positivity
    have h1 : ρ ^ (α / 4) < ((min 1 C_end) ^ (4 / α)) ^ (α / 4) :=
      Real.rpow_lt_rpow hρ.le hρ_lt_end hα4_pos
    have h_mul1 : (4 / α) * (α / 4) = 1 := by field_simp [hα.ne']
    rw [← Real.rpow_mul (by positivity), h_mul1, Real.rpow_one] at h1
    exact le_trans h1.le (min_le_right 1 C_end)

  calc ρ ^ (-χ + α)
      ≤ ρ ^ (α / 4 + (-χ + α / 2 + 4 * η)) :=
        Real.rpow_le_rpow_of_exponent_ge hρ hρ_lt_one.le (by linarith only [h24η_le_α, hη_pos])
    _ = ρ ^ (α / 4) * (ρ ^ (-χ + α / 2) * ρ ^ (4 * η)) := by
        rw [Real.rpow_add hρ, Real.rpow_add hρ]
    _ ≤ C_end * (ρ ^ (-χ + α / 2) * ρ ^ (4 * η)) :=
        mul_le_mul_of_nonneg_right h_end_pow (by positivity)
    _ ≤ M := h_M_lb1

theorem affine_block_kl_core {N_P N_Θ k_grp N_obs : ℕ}
    (hk : 1 ≤ k_grp)
    (p0 : Fin N_P → Fin N_Θ → ℝ)
    (Q : Fin k_grp → Fin N_P → Fin N_Θ → ℤ × ℤ)
    (F : Fin N_obs → Fin N_P → Fin N_Θ → ℤ × ℤ × ℤ × ℤ)
    (H_set : Fin N_P → Fin N_Θ → Prop)
    (ζ v M_low : ℝ)
    (hp0_nn : ∀ i b, 0 ≤ p0 i b)
    (hp0_sum : (∑ i : Fin N_P, ∑ b : Fin N_Θ, p0 i b) = 1)
    (hζ_nn : 0 ≤ ζ)
    (hH_mass :
      letI := Classical.propDecidable
      1 - ζ ≤ ∑ i : Fin N_P, ∑ b : Fin N_Θ, if H_set i b then p0 i b else 0)
    (hv_pos : 0 < v)
    (hM_low_pos : 0 < M_low)
    (hM_low_le : M_low ≤ 1 - ζ -
      (pairKLDivergence p0 + condCoordMultiInfo p0 Q + 1) / v) :
    letI := Classical.propDecidable
    let N_tot : ℕ := N_obs + k_grp + 2
    let δ : ℝ := M_low / (2 * (N_tot : ℝ))
    ∃ (M_ret : ℝ) (π : Fin N_P → Fin N_Θ → ℝ),
      M_low / 2 ≤ M_ret ∧ M_ret ≤ 1 ∧
      (∀ i b, 0 ≤ π i b) ∧
      (∑ i : Fin N_P, ∑ b : Fin N_Θ, π i b = 1) ∧
      (∀ i b, 0 < π i b → H_set i b ∧ 0 < p0 i b) ∧
      (∀ i b, M_ret * π i b ≤ p0 i b) ∧
      (∀ i b, π i b ≤ Real.exp v * M_ret * δ ^ (-2 : ℤ) *
        (∑ b', π i b') * (∑ i', π i' b)) ∧
      (∀ b, 0 < (∑ i, π i b) →
        ∀ q : Fin k_grp → ℤ × ℤ,
          let lam_b := ∑ i, π i b
          (∑ i : Fin N_P, if (∀ g, Q g i b = q g) then π i b / lam_b else 0) ≤
            Real.exp v * δ ^ (-(k_grp : ℤ)) *
              ∏ g : Fin k_grp,
                (∑ i : Fin N_P, if Q g i b = q g then π i b / lam_b else 0)) ∧
      (∀ (m_idx : Fin N_obs) (z : ℤ × ℤ × ℤ × ℤ),
        let r_F := ∑ i : Fin N_P, ∑ b : Fin N_Θ,
          if F m_idx i b = z then M_ret * π i b else 0
        let p0_F := ∑ i : Fin N_P, ∑ b : Fin N_Θ,
          if F m_idx i b = z then p0 i b else 0
        0 < r_F → δ * p0_F ≤ r_F ∧ r_F ≤ p0_F) :=
by
  classical
  intro N_tot δ
  have hN_tot_pos : (0 : ℝ) < (N_tot : ℝ) := by
    dsimp [N_tot]
    positivity
  have hδ_pos : 0 < δ := by
    dsimp [δ]
    positivity
  
  have h_kl_pt : ∀ (p q : ℝ), 0 ≤ p → 0 ≤ q → (0 < p → 0 < q) →
      (if Real.exp v * q < p then v * p else 0) ≤
        p * Real.log (p / q) + (1 / 2 : ℝ) * q := by
    intro p q hp_nn hq_nn hpq
    by_cases hp : 0 < p
    · have hq : 0 < q := hpq hp
      by_cases h_lt : Real.exp v * q < p
      · rw [if_pos h_lt]
        have h_div : Real.exp v < p / q := (lt_div_iff₀ hq).mpr h_lt
        have h_log : v ≤ Real.log (p / q) := by
          have h1 := Real.log_le_log (Real.exp_pos v) h_div.le
          rwa [Real.log_exp] at h1
        have h_mul : v * p ≤ p * Real.log (p / q) := by
          calc v * p ≤ Real.log (p / q) * p := mul_le_mul_of_nonneg_right h_log hp_nn
            _ = p * Real.log (p / q) := mul_comm _ _
        linarith
      · rw [if_neg h_lt]
        have h1 : Real.log (q / (2 * p)) ≤ q / (2 * p) - 1 :=
          Real.log_le_sub_one_of_pos (by positivity)
        have h2 : Real.log 2 ≤ 2 - 1 :=
          Real.log_le_sub_one_of_pos (by norm_num)
        have h_prod : (p / q) * (q / (2 * p)) = (2 : ℝ)⁻¹ := by
          field_simp [hp.ne', hq.ne']
        have h_log_sum : Real.log (p / q) + Real.log (q / (2 * p)) = -Real.log 2 := by
          have hpq_ne : p / q ≠ 0 := div_ne_zero hp.ne' hq.ne'
          have hqp_ne : q / (2 * p) ≠ 0 := by positivity
          rw [← Real.log_mul hpq_ne hqp_ne, h_prod, Real.log_inv]
        have h_nonneg_inner : 0 ≤ Real.log (p / q) + q / (2 * p) := by
          linarith
        have h_mul : 0 ≤ p * (Real.log (p / q) + q / (2 * p)) :=
          mul_nonneg hp_nn h_nonneg_inner
        have h_simp : p * (Real.log (p / q) + q / (2 * p)) =
            p * Real.log (p / q) + (1 / 2 : ℝ) * q := by
          have hp_ne : p ≠ 0 := hp.ne'
          field_simp [hp_ne]
        linarith
    · have hp0 : p = 0 := le_antisymm (not_lt.mp hp) hp_nn
      subst hp0
      have h_not : ¬ (Real.exp v * q < 0) :=
        not_lt.mpr (mul_nonneg (Real.exp_pos v).le hq_nn)
      rw [if_neg h_not]
      linarith

  
  let mu0 : Fin N_P → ℝ := fun i => ∑ b : Fin N_Θ, p0 i b
  let lam0 : Fin N_Θ → ℝ := fun b => ∑ i : Fin N_P, p0 i b
  have hmu0_nn : ∀ i, 0 ≤ mu0 i := fun i => Finset.sum_nonneg (fun b _ => hp0_nn i b)
  have hlam0_nn : ∀ b, 0 ≤ lam0 b := fun b => Finset.sum_nonneg (fun i _ => hp0_nn i b)
  have hlam0_sum : ∑ b : Fin N_Θ, lam0 b = 1 := by
    dsimp [lam0]
    rw [Finset.sum_comm]
    exact hp0_sum

  
  have h_pair_tail :
      v * (∑ i : Fin N_P, ∑ b : Fin N_Θ,
        if Real.exp v * mu0 i * lam0 b < p0 i b then p0 i b else 0) ≤
        pairKLDivergence p0 + 1 / 2 := by
    have h_lhs : v * (∑ i : Fin N_P, ∑ b : Fin N_Θ,
          if Real.exp v * mu0 i * lam0 b < p0 i b then p0 i b else 0) =
        ∑ i : Fin N_P, ∑ b : Fin N_Θ,
          if Real.exp v * (mu0 i * lam0 b) < p0 i b then v * p0 i b else 0 := by
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl (fun b _ => ?_)
      rw [← mul_assoc]
      split_ifs <;> ring
    rw [h_lhs]
    have h_sum_le :
        (∑ i : Fin N_P, ∑ b : Fin N_Θ,
          if Real.exp v * (mu0 i * lam0 b) < p0 i b then v * p0 i b else 0) ≤
        ∑ i : Fin N_P, ∑ b : Fin N_Θ,
          (p0 i b * Real.log (p0 i b / (mu0 i * lam0 b)) +
            (1 / 2 : ℝ) * (mu0 i * lam0 b)) := by
      refine Finset.sum_le_sum (fun i _ => Finset.sum_le_sum (fun b _ => ?_))
      refine h_kl_pt (p0 i b) (mu0 i * lam0 b) (hp0_nn i b)
        (mul_nonneg (hmu0_nn i) (hlam0_nn b)) (fun hp => ?_)
      have h1 : p0 i b ≤ mu0 i :=
        Finset.single_le_sum (fun b' _ => hp0_nn i b') (Finset.mem_univ b)
      have h2 : p0 i b ≤ lam0 b :=
        Finset.single_le_sum (fun i' _ => hp0_nn i' b) (Finset.mem_univ i)
      exact mul_pos (lt_of_lt_of_le hp h1) (lt_of_lt_of_le hp h2)
    have h_rhs :
        (∑ i : Fin N_P, ∑ b : Fin N_Θ,
          (p0 i b * Real.log (p0 i b / (mu0 i * lam0 b)) +
            (1 / 2 : ℝ) * (mu0 i * lam0 b))) =
        pairKLDivergence p0 + 1 / 2 := by
      simp only [Finset.sum_add_distrib]
      congr 1
      have h_prod_sum :
          (∑ i : Fin N_P, ∑ b : Fin N_Θ, (1 / 2 : ℝ) * (mu0 i * lam0 b)) =
          (1 / 2 : ℝ) * ((∑ i : Fin N_P, mu0 i) * (∑ b : Fin N_Θ, lam0 b)) := by
        calc (∑ i : Fin N_P, ∑ b : Fin N_Θ, (1 / 2 : ℝ) * (mu0 i * lam0 b))
            = ∑ i : Fin N_P, ((1 / 2 : ℝ) * mu0 i) * (∑ b : Fin N_Θ, lam0 b) := by
                refine Finset.sum_congr rfl (fun i _ => ?_)
                rw [Finset.mul_sum]
                exact Finset.sum_congr rfl (fun b _ => by ring)
          _ = (∑ i : Fin N_P, (1 / 2 : ℝ) * mu0 i) * (∑ b : Fin N_Θ, lam0 b) :=
                (Finset.sum_mul _ _ _).symm
          _ = (1 / 2 : ℝ) * ((∑ i : Fin N_P, mu0 i) * (∑ b : Fin N_Θ, lam0 b)) := by
                rw [← Finset.mul_sum, mul_assoc]
      rw [h_prod_sum, hp0_sum, hlam0_sum]
      ring
    linarith

  
  let q_joint : Fin N_P → Fin N_Θ → ℝ := fun i b =>
    ∑ i' : Fin N_P, if (∀ g : Fin k_grp, Q g i' b = Q g i b) then p0 i' b else 0
  let p_prod : Fin N_P → Fin N_Θ → ℝ := fun i b =>
    ∏ g : Fin k_grp, (∑ i' : Fin N_P, if Q g i' b = Q g i b then p0 i' b / lam0 b else 0)
  have h_coord_tail :
      v * (∑ i : Fin N_P, ∑ b : Fin N_Θ,
        if Real.exp v * lam0 b * p_prod i b < q_joint i b then p0 i b else 0) ≤
        condCoordMultiInfo p0 Q + 1 / 2 := by
    let p_joint : Fin N_P → Fin N_Θ → ℝ := fun i b =>
      ∑ i' : Fin N_P,
        if (∀ g : Fin k_grp, Q g i' b = Q g i b) then p0 i' b / lam0 b else 0
    have h_col : ∀ b : Fin N_Θ,
        (∑ i : Fin N_P,
          if Real.exp v * lam0 b * p_prod i b < q_joint i b then v * p0 i b else 0) ≤
        (∑ i : Fin N_P, p0 i b * Real.log (p_joint i b / p_prod i b)) +
          (1 / 2 : ℝ) * lam0 b := by
      intro b
      by_cases hlam : 0 < lam0 b
      · let tup : Fin N_P → (Fin k_grp → ℤ × ℤ) := fun i g => Q g i b
        let S_b : Finset (Fin k_grp → ℤ × ℤ) := Finset.univ.image tup
        let ξ_joint : (Fin k_grp → ℤ × ℤ) → ℝ := fun q =>
          ∑ i' : Fin N_P, if tup i' = q then p0 i' b / lam0 b else 0
        let ξ_marg : Fin k_grp → (ℤ × ℤ) → ℝ := fun g u =>
          ∑ i' : Fin N_P, if Q g i' b = u then p0 i' b / lam0 b else 0
        let ξ_prod : (Fin k_grp → ℤ × ℤ) → ℝ := fun q =>
          ∏ g : Fin k_grp, ξ_marg g (q g)
        have hξ_joint_nn : ∀ q, 0 ≤ ξ_joint q := fun q =>
          Finset.sum_nonneg (fun i' _ => by
            split_ifs
            · exact div_nonneg (hp0_nn i' b) hlam.le
            · exact le_rfl)
        have hξ_marg_nn : ∀ g u, 0 ≤ ξ_marg g u := fun g u =>
          Finset.sum_nonneg (fun i' _ => by
            split_ifs
            · exact div_nonneg (hp0_nn i' b) hlam.le
            · exact le_rfl)
        have hξ_prod_nn : ∀ q, 0 ≤ ξ_prod q := fun q =>
          Finset.prod_nonneg (fun g _ => hξ_marg_nn g (q g))
        have hp_joint_eq : ∀ i, p_joint i b = ξ_joint (tup i) := by
          intro i
          refine Finset.sum_congr rfl (fun i' _ => ?_)
          exact if_congr (funext_iff.symm) rfl rfl
        have hp_prod_eq : ∀ i, p_prod i b = ξ_prod (tup i) := fun _ => rfl
        have hq_joint_eq : ∀ i, q_joint i b = lam0 b * ξ_joint (tup i) := by
          intro i
          dsimp [q_joint, ξ_joint]
          rw [Finset.mul_sum]
          refine Finset.sum_congr rfl (fun i' _ => ?_)
          have h_iff : (∀ g : Fin k_grp, Q g i' b = Q g i b) ↔ tup i' = tup i :=
            funext_iff.symm
          rw [if_congr h_iff rfl rfl]
          split_ifs
          · exact (mul_div_cancel₀ (p0 i' b) hlam.ne').symm
          · ring
        have h_group : ∀ Φ : (Fin k_grp → ℤ × ℤ) → ℝ,
            (∑ i : Fin N_P, p0 i b * Φ (tup i)) =
              lam0 b * ∑ q ∈ S_b, ξ_joint q * Φ q := by
          intro Φ
          have h1 : ∀ i : Fin N_P,
              p0 i b * Φ (tup i) =
                ∑ q ∈ S_b, if tup i = q then p0 i b * Φ q else 0 := by
            intro i
            have hmem : tup i ∈ S_b := Finset.mem_image_of_mem tup (Finset.mem_univ i)
            symm
            rw [Finset.sum_eq_single (tup i)
              (fun q _ hq => if_neg (Ne.symm hq))
              (fun h_not => absurd hmem h_not), if_pos rfl]
          simp_rw [h1]
          rw [Finset.sum_comm, Finset.mul_sum]
          refine Finset.sum_congr rfl (fun q _ => ?_)
          dsimp [ξ_joint]
          rw [← mul_assoc, Finset.mul_sum, Finset.sum_mul]
          refine Finset.sum_congr rfl (fun i' _ => ?_)
          split_ifs
          · rw [mul_div_cancel₀ (p0 i' b) hlam.ne']
          · ring
        have h_col_lhs :
            (∑ i : Fin N_P,
              if Real.exp v * lam0 b * p_prod i b < q_joint i b then v * p0 i b else 0) =
            lam0 b * ∑ q ∈ S_b,
              (if Real.exp v * ξ_prod q < ξ_joint q then v * ξ_joint q else 0) := by
          have h_rew :
              (∑ i : Fin N_P,
                if Real.exp v * lam0 b * p_prod i b < q_joint i b then v * p0 i b else 0) =
              ∑ i : Fin N_P, p0 i b *
                (if Real.exp v * ξ_prod (tup i) < ξ_joint (tup i) then v else 0) := by
            refine Finset.sum_congr rfl (fun i _ => ?_)
            have h_cond : (Real.exp v * lam0 b * p_prod i b < q_joint i b) ↔
                (Real.exp v * ξ_prod (tup i) < ξ_joint (tup i)) := by
              rw [hq_joint_eq i, hp_prod_eq i]
              have h_mul_eq : Real.exp v * lam0 b * ξ_prod (tup i) =
                  lam0 b * (Real.exp v * ξ_prod (tup i)) := by ring
              rw [h_mul_eq]
              exact ⟨fun h => lt_of_mul_lt_mul_left h hlam.le,
                     fun h => mul_lt_mul_of_pos_left h hlam⟩
            rw [if_congr h_cond rfl rfl]
            split_ifs <;> ring
          rw [h_rew,
              h_group (fun q => if Real.exp v * ξ_prod q < ξ_joint q then v else 0)]
          congr 1
          refine Finset.sum_congr rfl (fun q _ => ?_)
          split_ifs <;> ring
        have h_col_rhs :
            (∑ i : Fin N_P, p0 i b * Real.log (p_joint i b / p_prod i b)) +
              (1 / 2 : ℝ) * lam0 b =
            lam0 b * ((∑ q ∈ S_b, ξ_joint q * Real.log (ξ_joint q / ξ_prod q)) + 1 / 2) := by
          have h_rew :
              (∑ i : Fin N_P, p0 i b * Real.log (p_joint i b / p_prod i b)) =
              ∑ i : Fin N_P, p0 i b * Real.log (ξ_joint (tup i) / ξ_prod (tup i)) := by
            refine Finset.sum_congr rfl (fun i _ => ?_)
            rw [hp_joint_eq i, hp_prod_eq i]
          rw [h_rew,
              h_group (fun q => Real.log (ξ_joint q / ξ_prod q))]
          ring
        rw [h_col_lhs, h_col_rhs]
        refine mul_le_mul_of_nonneg_left ?_ hlam.le
        have h_sb_kl :
            (∑ q ∈ S_b, if Real.exp v * ξ_prod q < ξ_joint q then v * ξ_joint q else 0) ≤
            (∑ q ∈ S_b, ξ_joint q * Real.log (ξ_joint q / ξ_prod q)) +
              (1 / 2 : ℝ) * ∑ q ∈ S_b, ξ_prod q := by
          calc (∑ q ∈ S_b, if Real.exp v * ξ_prod q < ξ_joint q then v * ξ_joint q else 0)
              ≤ ∑ q ∈ S_b, (ξ_joint q * Real.log (ξ_joint q / ξ_prod q) +
                  (1 / 2 : ℝ) * ξ_prod q) := by
                refine Finset.sum_le_sum (fun q _ => ?_)
                refine h_kl_pt (ξ_joint q) (ξ_prod q) (hξ_joint_nn q) (hξ_prod_nn q) (fun hpos => ?_)
                obtain ⟨i₀, _, hi₀_ne⟩ := Finset.exists_ne_zero_of_sum_ne_zero hpos.ne'
                have hi₀_tup : tup i₀ = q := by
                  by_contra hne
                  rw [if_neg hne] at hi₀_ne
                  exact hi₀_ne rfl
                rw [if_pos hi₀_tup] at hi₀_ne
                have hi₀_pos : 0 < p0 i₀ b / lam0 b :=
                  lt_of_le_of_ne (div_nonneg (hp0_nn i₀ b) hlam.le) (Ne.symm hi₀_ne)
                refine Finset.prod_pos (fun g _ => ?_)
                have hqg : Q g i₀ b = q g := congr_fun hi₀_tup g
                have h_term_le :
                    (if Q g i₀ b = q g then p0 i₀ b / lam0 b else 0) ≤ ξ_marg g (q g) :=
                  Finset.single_le_sum
                    (f := fun i' => if Q g i' b = q g then p0 i' b / lam0 b else 0)
                    (fun i' _ => by
                      split_ifs
                      · exact div_nonneg (hp0_nn i' b) hlam.le
                      · exact le_rfl)
                    (Finset.mem_univ i₀)
                rw [if_pos hqg] at h_term_le
                exact lt_of_lt_of_le hi₀_pos h_term_le
            _ = (∑ q ∈ S_b, ξ_joint q * Real.log (ξ_joint q / ξ_prod q)) +
                  (1 / 2 : ℝ) * ∑ q ∈ S_b, ξ_prod q := by
                rw [Finset.sum_add_distrib, Finset.mul_sum]
        have h_prod_sum_le : ∑ q ∈ S_b, ξ_prod q ≤ 1 := by
          let U : Fin k_grp → Finset (ℤ × ℤ) :=
            fun g => Finset.univ.image (fun i : Fin N_P => Q g i b)
          have h_sub : S_b ⊆ Fintype.piFinset U := by
            intro q hq
            obtain ⟨i, _, rfl⟩ := Finset.mem_image.mp hq
            exact Fintype.mem_piFinset.mpr (fun g =>
              Finset.mem_image_of_mem _ (Finset.mem_univ i))
          calc ∑ q ∈ S_b, ξ_prod q
              ≤ ∑ q ∈ Fintype.piFinset U, ∏ g : Fin k_grp, ξ_marg g (q g) :=
                Finset.sum_le_sum_of_subset_of_nonneg h_sub
                  (fun q _ _ => hξ_prod_nn q)
            _ = ∏ g : Fin k_grp, ∑ u ∈ U g, ξ_marg g u :=
                (Finset.prod_univ_sum U ξ_marg).symm
            _ = ∏ _g : Fin k_grp, (1 : ℝ) := by
                refine Finset.prod_congr rfl (fun g _ => ?_)
                dsimp [ξ_marg]
                rw [Finset.sum_comm]
                have h_inner : ∀ i' : Fin N_P,
                    (∑ u ∈ U g, if Q g i' b = u then p0 i' b / lam0 b else 0) =
                      p0 i' b / lam0 b := by
                  intro i'
                  have hmem : Q g i' b ∈ U g :=
                    Finset.mem_image_of_mem _ (Finset.mem_univ i')
                  rw [Finset.sum_eq_single (Q g i' b)
                    (fun u _ hu => if_neg (Ne.symm hu))
                    (fun h_not => absurd hmem h_not), if_pos rfl]
                simp_rw [h_inner]
                rw [← Finset.sum_div]
                exact div_self hlam.ne'
            _ = 1 := Finset.prod_const_one
        linarith
      · have hlam0 : lam0 b = 0 := le_antisymm (not_lt.mp hlam) (hlam0_nn b)
        have hp0_b : ∀ i : Fin N_P, p0 i b = 0 := by
          intro i
          have hle : p0 i b ≤ lam0 b :=
            Finset.single_le_sum (fun i' _ => hp0_nn i' b) (Finset.mem_univ i)
          exact le_antisymm (hle.trans hlam0.le) (hp0_nn i b)
        simp [hp0_b, hlam0]
    have h_lhs_comm :
        v * (∑ i : Fin N_P, ∑ b : Fin N_Θ,
          if Real.exp v * lam0 b * p_prod i b < q_joint i b then p0 i b else 0) =
        ∑ b : Fin N_Θ, ∑ i : Fin N_P,
          if Real.exp v * lam0 b * p_prod i b < q_joint i b then v * p0 i b else 0 := by
      rw [Finset.sum_comm, Finset.mul_sum]
      refine Finset.sum_congr rfl (fun b _ => ?_)
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      split_ifs <;> ring
    have h_rhs_comm :
        condCoordMultiInfo p0 Q + 1 / 2 =
        ∑ b : Fin N_Θ,
          ((∑ i : Fin N_P, p0 i b * Real.log (p_joint i b / p_prod i b)) +
            (1 / 2 : ℝ) * lam0 b) := by
      rw [Finset.sum_add_distrib, ← Finset.mul_sum, hlam0_sum, mul_one]
      congr 1
      unfold condCoordMultiInfo
      dsimp only
      rw [Finset.sum_comm]
      refine Finset.sum_congr rfl (fun b _ => Finset.sum_congr rfl (fun i _ => ?_))
      have h_num :
          (∑ i' : Fin N_P,
            @ite _ (∀ g : Fin k_grp, Q g i' b = Q g i b) (Classical.propDecidable _)
              (p0 i' b / lam0 b) 0) = p_joint i b := by
        refine Finset.sum_congr rfl (fun i' _ => ?_)
        by_cases hc : ∀ g : Fin k_grp, Q g i' b = Q g i b
        · rw [if_pos hc, if_pos hc]
        · rw [if_neg hc, if_neg hc]
      have h_den :
          (∏ g : Fin k_grp, ∑ i' : Fin N_P,
            @ite _ (Q g i' b = Q g i b) (Classical.propDecidable _)
              (p0 i' b / lam0 b) 0) = p_prod i b := by
        refine Finset.prod_congr rfl (fun g _ => Finset.sum_congr rfl (fun i' _ => ?_))
        by_cases hc : Q g i' b = Q g i b
        · rw [if_pos hc, if_pos hc]
        · rw [if_neg hc, if_neg hc]
      rw [h_num, h_den]
    rw [h_lhs_comm, h_rhs_comm]
    exact Finset.sum_le_sum (fun b _ => h_col b)

  
  let Good : Fin N_P → Fin N_Θ → Prop := fun i b =>
    H_set i b ∧
    p0 i b ≤ Real.exp v * mu0 i * lam0 b ∧
    q_joint i b ≤ Real.exp v * lam0 b * p_prod i b
  let r0 : Fin N_P → Fin N_Θ → ℝ := fun i b => if Good i b then p0 i b else 0
  have hr0_nn : ∀ i b, 0 ≤ r0 i b := fun i b => by
    dsimp [r0]
    split_ifs
    · exact hp0_nn i b
    · exact le_rfl
  have hr0_le : ∀ i b, r0 i b ≤ p0 i b := fun i b => by
    dsimp [r0]
    split_ifs
    · exact le_rfl
    · exact hp0_nn i b
  have hr0_mass : M_low ≤ ∑ i : Fin N_P, ∑ b : Fin N_Θ, r0 i b := by
    have hH_mass' : 1 - ζ ≤ ∑ i : Fin N_P, ∑ b : Fin N_Θ, if H_set i b then p0 i b else 0 := by
      refine le_trans hH_mass (le_of_eq ?_)
      exact Finset.sum_congr rfl (fun i _ =>
        Finset.sum_congr rfl (fun b _ => if_congr Iff.rfl rfl rfl))
    have h_pt : ∀ (i : Fin N_P) (b : Fin N_Θ),
        (if H_set i b then p0 i b else 0) ≤
          r0 i b +
          (if Real.exp v * mu0 i * lam0 b < p0 i b then p0 i b else 0) +
          (if Real.exp v * lam0 b * p_prod i b < q_joint i b then p0 i b else 0) := by
      intro i b
      have hp_nn := hp0_nn i b
      dsimp [r0, Good]
      by_cases hH : H_set i b
      · by_cases hP : Real.exp v * mu0 i * lam0 b < p0 i b
        · rw [if_pos hH, if_pos hP]
          have h_notG : ¬ (H_set i b ∧ p0 i b ≤ Real.exp v * mu0 i * lam0 b ∧
              q_joint i b ≤ Real.exp v * lam0 b * p_prod i b) :=
            fun hg => not_lt_of_ge hg.2.1 hP
          rw [if_neg h_notG]
          split_ifs <;> linarith
        · by_cases hC : Real.exp v * lam0 b * p_prod i b < q_joint i b
          · rw [if_pos hH, if_neg hP, if_pos hC]
            have h_notG : ¬ (H_set i b ∧ p0 i b ≤ Real.exp v * mu0 i * lam0 b ∧
                q_joint i b ≤ Real.exp v * lam0 b * p_prod i b) :=
              fun hg => not_lt_of_ge hg.2.2 hC
            rw [if_neg h_notG]
            linarith
          · have hG : H_set i b ∧ p0 i b ≤ Real.exp v * mu0 i * lam0 b ∧
                q_joint i b ≤ Real.exp v * lam0 b * p_prod i b :=
              ⟨hH, not_lt.mp hP, not_lt.mp hC⟩
            rw [if_pos hH, if_pos hG, if_neg hP, if_neg hC]
            linarith
      · rw [if_neg hH]
        have h_notG : ¬ (H_set i b ∧ p0 i b ≤ Real.exp v * mu0 i * lam0 b ∧
            q_joint i b ≤ Real.exp v * lam0 b * p_prod i b) :=
          fun hg => hH hg.1
        rw [if_neg h_notG]
        split_ifs <;> linarith
    have h_sum_pt :
        (∑ i : Fin N_P, ∑ b : Fin N_Θ, if H_set i b then p0 i b else 0) ≤
        (∑ i : Fin N_P, ∑ b : Fin N_Θ, r0 i b) +
        (∑ i : Fin N_P, ∑ b : Fin N_Θ,
          if Real.exp v * mu0 i * lam0 b < p0 i b then p0 i b else 0) +
        (∑ i : Fin N_P, ∑ b : Fin N_Θ,
          if Real.exp v * lam0 b * p_prod i b < q_joint i b then p0 i b else 0) := by
      calc (∑ i : Fin N_P, ∑ b : Fin N_Θ, if H_set i b then p0 i b else 0)
          ≤ ∑ i : Fin N_P, ∑ b : Fin N_Θ,
              (r0 i b +
                (if Real.exp v * mu0 i * lam0 b < p0 i b then p0 i b else 0) +
                (if Real.exp v * lam0 b * p_prod i b < q_joint i b then p0 i b else 0)) :=
            Finset.sum_le_sum (fun i _ => Finset.sum_le_sum (fun b _ => h_pt i b))
        _ = _ := by simp only [Finset.sum_add_distrib]
    have h_tails_div :
        (∑ i : Fin N_P, ∑ b : Fin N_Θ,
          if Real.exp v * mu0 i * lam0 b < p0 i b then p0 i b else 0) +
        (∑ i : Fin N_P, ∑ b : Fin N_Θ,
          if Real.exp v * lam0 b * p_prod i b < q_joint i b then p0 i b else 0) ≤
        (pairKLDivergence p0 + condCoordMultiInfo p0 Q + 1) / v := by
      rw [le_div_iff₀ hv_pos]
      linarith [h_pair_tail, h_coord_tail]
    linarith [hH_mass', h_sum_pt, h_tails_div, hM_low_le]

  
  let G : Fin N_tot → Fin N_P → Fin N_Θ → ℤ × ℤ × ℤ × ℤ := fun α i b =>
    if h1 : α.1 < N_obs then F ⟨α.1, h1⟩ i b
    else if h2 : α.1 < N_obs + k_grp then
      let g : Fin k_grp := ⟨α.1 - N_obs, by omega⟩
      ((b.1 : ℤ), (Q g i b).1, (Q g i b).2, 0)
    else if α.1 = N_obs + k_grp then ((i.1 : ℤ), 0, 0, 0)
    else ((b.1 : ℤ), 0, 0, 0)

  let Ω := Fin N_P × Fin N_Θ
  let Z := ℤ × ℤ × ℤ × ℤ
  let U_obs : Fin N_tot → Finset Z :=
    fun α => Finset.univ.image (fun x : Ω => G α x.1 x.2)
  let slice : Fin N_tot → Finset (Fin N_tot × Z) :=
    fun α => (U_obs α).image (Prod.mk α)
  let A0 : Finset (Fin N_tot × Z) := Finset.univ.biUnion slice
  let S_of : Finset (Fin N_tot × Z) → Finset Ω :=
    fun B => Finset.univ.filter (fun x : Ω => ∀ α : Fin N_tot, (α, G α x.1 x.2) ∈ B)
  let fibMass : Finset (Fin N_tot × Z) → (Fin N_tot × Z) → ℝ :=
    fun B p => ∑ x ∈ S_of B, if G p.1 x.1 x.2 = p.2 then r0 x.1 x.2 else 0
  let p0Fib : (Fin N_tot × Z) → ℝ :=
    fun p => ∑ x : Ω, if G p.1 x.1 x.2 = p.2 then p0 x.1 x.2 else 0
  have hp0Fib_nn : ∀ p, 0 ≤ p0Fib p := fun p =>
    Finset.sum_nonneg (fun x _ => by
      split_ifs
      · exact hp0_nn x.1 x.2
      · exact le_rfl)
  have h_erase_S : ∀ (B : Finset (Fin N_tot × Z)) (p₀ : Fin N_tot × Z),
      S_of (B.erase p₀) = (S_of B).filter (fun x : Ω => ¬ (G p₀.1 x.1 x.2 = p₀.2)) := by
    intro B p₀
    ext x
    simp only [S_of, Finset.mem_filter, Finset.mem_univ, true_and, Finset.mem_erase]
    constructor
    · intro h
      exact ⟨fun α => (h α).2, fun heq => (h p₀.1).1 (Prod.ext rfl heq)⟩
    · rintro ⟨hB, hne⟩ α
      refine ⟨?_, hB α⟩
      intro heq
      apply hne
      have h1 : α = p₀.1 := congr_arg Prod.fst heq
      have h2 : G α x.1 x.2 = p₀.2 := congr_arg Prod.snd heq
      subst h1
      exact h2
  have h_erase_mass : ∀ (B : Finset (Fin N_tot × Z)) (p₀ : Fin N_tot × Z),
      (∑ x ∈ S_of B, r0 x.1 x.2) - (∑ x ∈ S_of (B.erase p₀), r0 x.1 x.2) =
        fibMass B p₀ := by
    intro B p₀
    rw [h_erase_S B p₀]
    have h_split := Finset.sum_filter_add_sum_filter_not
      (S_of B) (fun x : Ω => G p₀.1 x.1 x.2 = p₀.2) (fun x : Ω => r0 x.1 x.2)
    have h_filt : (∑ x ∈ (S_of B).filter (fun x : Ω => G p₀.1 x.1 x.2 = p₀.2), r0 x.1 x.2) =
        fibMass B p₀ :=
      Finset.sum_filter (fun x : Ω => G p₀.1 x.1 x.2 = p₀.2) (fun x : Ω => r0 x.1 x.2)
    linarith
  have h_trim_ind : ∀ (n : ℕ) (B : Finset (Fin N_tot × Z)), B.card = n →
      ∃ B' : Finset (Fin N_tot × Z), B' ⊆ B ∧
        (∀ p ∈ B', δ * p0Fib p ≤ fibMass B' p) ∧
        (∑ x ∈ S_of B, r0 x.1 x.2) - (∑ x ∈ S_of B', r0 x.1 x.2) ≤
          ∑ p ∈ B \ B', δ * p0Fib p := by
    intro n
    refine Nat.strong_induction_on n (fun n ih B hcard => ?_)
    by_cases hall : ∀ p ∈ B, δ * p0Fib p ≤ fibMass B p
    · refine ⟨B, Finset.Subset.rfl, hall, ?_⟩
      simp
    · push_neg at hall
      obtain ⟨p₀, hp₀_mem, hp₀_lt⟩ := hall
      let B₁ := B.erase p₀
      have hcard_lt : B₁.card < n := hcard ▸ Finset.card_erase_lt_of_mem hp₀_mem
      obtain ⟨B', hB'_sub, hB'_fl, hB'_loss⟩ := ih B₁.card hcard_lt B₁ rfl
      have hB'_sub_B : B' ⊆ B := hB'_sub.trans (Finset.erase_subset p₀ B)
      refine ⟨B', hB'_sub_B, hB'_fl, ?_⟩
      have hp₀_not_B₁ : p₀ ∉ B₁ := by simp [B₁]
      have hp₀_not_sdiff : p₀ ∉ B₁ \ B' :=
        fun h => hp₀_not_B₁ (Finset.mem_sdiff.mp h).1
      have h_ins_sub : insert p₀ (B₁ \ B') ⊆ B \ B' := by
        intro p hp
        rcases Finset.mem_insert.mp hp with rfl | hp1
        · exact Finset.mem_sdiff.mpr ⟨hp₀_mem, fun hpB' => hp₀_not_B₁ (hB'_sub hpB')⟩
        · exact Finset.mem_sdiff.mpr
            ⟨Finset.erase_subset p₀ B (Finset.mem_sdiff.mp hp1).1,
             (Finset.mem_sdiff.mp hp1).2⟩
      have h_sdiff_sum :
          δ * p0Fib p₀ + (∑ p ∈ B₁ \ B', δ * p0Fib p) ≤
            ∑ p ∈ B \ B', δ * p0Fib p := by
        have h_ins_eq :
            ∑ p ∈ insert p₀ (B₁ \ B'), δ * p0Fib p =
              δ * p0Fib p₀ + ∑ p ∈ B₁ \ B', δ * p0Fib p :=
          Finset.sum_insert hp₀_not_sdiff
        rw [← h_ins_eq]
        exact Finset.sum_le_sum_of_subset_of_nonneg h_ins_sub
          (fun p _ _ => mul_nonneg hδ_pos.le (hp0Fib_nn p))
      have h_step := h_erase_mass B p₀
      change (∑ x ∈ S_of B, r0 x.1 x.2) - (∑ x ∈ S_of B₁, r0 x.1 x.2) = fibMass B p₀ at h_step
      linarith

  obtain ⟨B', hB'_sub_A0, hB'_fl, hB'_loss⟩ := h_trim_ind A0.card A0 rfl
  have hS_A0 : S_of A0 = Finset.univ := by
    ext x
    simp only [S_of, Finset.mem_filter, Finset.mem_univ, true_and, iff_true]
    intro α
    refine Finset.mem_biUnion.mpr ⟨α, Finset.mem_univ α, ?_⟩
    exact Finset.mem_image_of_mem (Prod.mk α)
      (Finset.mem_image_of_mem (fun y : Ω => G α y.1 y.2) (Finset.mem_univ x))
  have hA0_sum : ∑ p ∈ A0, δ * p0Fib p = (N_tot : ℝ) * δ := by
    have h_disj : (↑(Finset.univ : Finset (Fin N_tot)) : Set (Fin N_tot)).PairwiseDisjoint slice := by
      intro α₁ _ α₂ _ hne
      change Disjoint (slice α₁) (slice α₂)
      rw [Finset.disjoint_left]
      intro p hp1 hp2
      obtain ⟨z₁, _, rfl⟩ := Finset.mem_image.mp hp1
      obtain ⟨z₂, _, h2⟩ := Finset.mem_image.mp hp2
      exact hne (congr_arg Prod.fst h2).symm
    dsimp [A0]
    rw [Finset.sum_biUnion h_disj]
    have h_each : ∀ α : Fin N_tot, ∑ p ∈ slice α, δ * p0Fib p = δ := by
      intro α
      dsimp [slice]
      have h_inj : Set.InjOn (Prod.mk α) (U_obs α : Set Z) :=
        fun z₁ _ z₂ _ h => congr_arg Prod.snd h
      rw [Finset.sum_image h_inj, ← Finset.mul_sum]
      have h_p0_alpha : ∑ z ∈ U_obs α, p0Fib (α, z) = 1 := by
        dsimp [p0Fib]
        rw [Finset.sum_comm]
        have h_in : ∀ x : Ω,
            (∑ z ∈ U_obs α, if G α x.1 x.2 = z then p0 x.1 x.2 else 0) = p0 x.1 x.2 := by
          intro x
          have hmem : G α x.1 x.2 ∈ U_obs α :=
            Finset.mem_image_of_mem _ (Finset.mem_univ x)
          rw [Finset.sum_eq_single (G α x.1 x.2)
            (fun z _ hz => if_neg (Ne.symm hz))
            (fun h_not => absurd hmem h_not), if_pos rfl]
        simp_rw [h_in]
        rw [Fintype.sum_prod_type]
        exact hp0_sum
      rw [h_p0_alpha, mul_one]
    simp_rw [h_each]
    simp

  let r : Fin N_P → Fin N_Θ → ℝ := fun i b => if (i, b) ∈ S_of B' then r0 i b else 0
  have hr_nn : ∀ i b, 0 ≤ r i b := fun i b => by
    dsimp [r]
    split_ifs
    · exact hr0_nn i b
    · exact le_rfl
  have hr_le_r0 : ∀ i b, r i b ≤ r0 i b := fun i b => by
    dsimp [r]
    split_ifs
    · exact le_rfl
    · exact hr0_nn i b
  have hr_le_p0 : ∀ i b, r i b ≤ p0 i b := fun i b => (hr_le_r0 i b).trans (hr0_le i b)
  have hr_sum_eq : (∑ i : Fin N_P, ∑ b : Fin N_Θ, r i b) = ∑ x ∈ S_of B', r0 x.1 x.2 := by
    rw [← Fintype.sum_prod_type (fun x : Ω => r x.1 x.2)]
    dsimp [r]
    rw [← Finset.sum_filter]
    congr 1
    ext x
    simp
  have hr0_sum_eq : (∑ i : Fin N_P, ∑ b : Fin N_Θ, r0 i b) = ∑ x ∈ S_of A0, r0 x.1 x.2 := by
    rw [hS_A0, ← Fintype.sum_prod_type (fun x : Ω => r0 x.1 x.2)]
  have hr_mass_lb :
      (∑ i : Fin N_P, ∑ b : Fin N_Θ, r0 i b) - (N_tot : ℝ) * δ ≤
        ∑ i : Fin N_P, ∑ b : Fin N_Θ, r i b := by
    have h_sdiff_le : ∑ p ∈ A0 \ B', δ * p0Fib p ≤ (N_tot : ℝ) * δ := by
      rw [← hA0_sum]
      exact Finset.sum_le_sum_of_subset_of_nonneg Finset.sdiff_subset
        (fun p _ _ => mul_nonneg hδ_pos.le (hp0Fib_nn p))
    linarith [hr_sum_eq, hr0_sum_eq, hB'_loss, h_sdiff_le]
  have hr_fib : ∀ (α : Fin N_tot) (z : Z),
      let r_G := ∑ i : Fin N_P, ∑ b : Fin N_Θ, if G α i b = z then r i b else 0
      let p0_G := ∑ i : Fin N_P, ∑ b : Fin N_Θ, if G α i b = z then p0 i b else 0
      0 < r_G → δ * p0_G ≤ r_G ∧ r_G ≤ p0_G := by
    intro α z r_G p0_G hr_G_pos
    have hr_G_eq : r_G = fibMass B' (α, z) := by
      dsimp [r_G, fibMass]
      rw [← Fintype.sum_prod_type (fun x : Ω => if G α x.1 x.2 = z then r x.1 x.2 else 0)]
      have h_rew : ∀ x : Ω,
          (if G α x.1 x.2 = z then r x.1 x.2 else 0) =
          if x ∈ S_of B' then (if G α x.1 x.2 = z then r0 x.1 x.2 else 0) else 0 := by
        intro x
        dsimp [r]
        split_ifs <;> rfl
      simp_rw [h_rew]
      rw [← Finset.sum_filter]
      congr 1
      ext x
      simp
    have hp0_G_eq : p0_G = p0Fib (α, z) := by
      dsimp [p0_G, p0Fib]
      rw [← Fintype.sum_prod_type (fun x : Ω => if G α x.1 x.2 = z then p0 x.1 x.2 else 0)]
    refine ⟨?_, ?_⟩
    · rw [hr_G_eq] at hr_G_pos ⊢
      rw [hp0_G_eq]
      obtain ⟨x₀, hx₀_mem, hx₀_ne⟩ := Finset.exists_ne_zero_of_sum_ne_zero hr_G_pos.ne'
      have hx₀_eq : G α x₀.1 x₀.2 = z := by
        by_contra hne
        rw [if_neg hne] at hx₀_ne
        exact hx₀_ne rfl
      have h_mem_B' : (α, z) ∈ B' := by
        rw [← hx₀_eq]
        exact (Finset.mem_filter.mp hx₀_mem).2 α
      exact hB'_fl (α, z) h_mem_B'
    · exact Finset.sum_le_sum (fun i _ => Finset.sum_le_sum (fun b _ => by
        split_ifs
        · exact hr_le_p0 i b
        · exact le_rfl))

  
  let M_ret : ℝ := ∑ i : Fin N_P, ∑ b : Fin N_Θ, r i b
  have hM_ret_lb : M_low / 2 ≤ M_ret := by
    have h_Nδ : (N_tot : ℝ) * δ = M_low / 2 := by
      dsimp [δ]
      have hN_ne : (N_tot : ℝ) ≠ 0 := hN_tot_pos.ne'
      field_simp [hN_ne]
    linarith [hr0_mass, hr_mass_lb, h_Nδ]
  have hM_ret_pos : 0 < M_ret := lt_of_lt_of_le (half_pos hM_low_pos) hM_ret_lb
  have hM_ret_le_one : M_ret ≤ 1 := by
    calc M_ret ≤ ∑ i : Fin N_P, ∑ b : Fin N_Θ, p0 i b :=
          Finset.sum_le_sum (fun i _ => Finset.sum_le_sum (fun b _ => hr_le_p0 i b))
      _ = 1 := hp0_sum

  let π : Fin N_P → Fin N_Θ → ℝ := fun i b => r i b / M_ret
  have hπ_nn : ∀ i b, 0 ≤ π i b := fun i b => div_nonneg (hr_nn i b) hM_ret_pos.le
  have hM_mul_π : ∀ i b, M_ret * π i b = r i b :=
    fun i b => mul_div_cancel₀ (r i b) hM_ret_pos.ne'
  have hπ_sum : (∑ i : Fin N_P, ∑ b : Fin N_Θ, π i b) = 1 := by
    dsimp [π]
    simp_rw [← Finset.sum_div]
    exact div_self hM_ret_pos.ne'
  have hπ_supp_good : ∀ i b, 0 < r i b → Good i b ∧ 0 < p0 i b := by
    intro i b hr_pos
    have hr0_pos : 0 < r0 i b := lt_of_lt_of_le hr_pos (hr_le_r0 i b)
    have hG : Good i b := by
      by_contra hnot
      have h0 : r0 i b = 0 := if_neg hnot
      linarith
    exact ⟨hG, lt_of_lt_of_le hr0_pos (hr0_le i b)⟩

  refine ⟨M_ret, π, hM_ret_lb, hM_ret_le_one, hπ_nn, hπ_sum, ?_, ?_, ?_, ?_, ?_⟩
  
  · intro i b hπ_pos
    have hr_pos : 0 < r i b := by
      have h1 : 0 < M_ret * π i b := mul_pos hM_ret_pos hπ_pos
      rwa [hM_mul_π i b] at h1
    obtain ⟨hG, hp0_pos⟩ := hπ_supp_good i b hr_pos
    exact ⟨hG.1, hp0_pos⟩
  
  · intro i b
    rw [hM_mul_π i b]
    exact hr_le_p0 i b
  
  · intro i b
    let μ_i := ∑ b' : Fin N_Θ, π i b'
    let lam_b := ∑ i' : Fin N_P, π i' b
    have hμ_nn : 0 ≤ μ_i := Finset.sum_nonneg (fun b' _ => hπ_nn i b')
    have hlam_b_nn : 0 ≤ lam_b := Finset.sum_nonneg (fun i' _ => hπ_nn i' b)
    by_cases hr_pos : 0 < r i b
    · have hG := (hπ_supp_good i b hr_pos).1
      
      let idx_P : Fin N_tot := ⟨N_obs + k_grp, by dsimp [N_tot]; omega⟩
      let z_P : Z := ((i.1 : ℤ), 0, 0, 0)
      have hG_P : ∀ (i' : Fin N_P) (b' : Fin N_Θ), G idx_P i' b' = z_P ↔ i' = i := by
        intro i' b'
        have h1 : ¬ (idx_P.1 < N_obs) := by dsimp [idx_P]; omega
        have h2 : ¬ (idx_P.1 < N_obs + k_grp) := by dsimp [idx_P]; omega
        have h3 : idx_P.1 = N_obs + k_grp := rfl
        dsimp [G, z_P]
        rw [dif_neg h1, dif_neg h2, if_pos h3]
        constructor
        · intro heq
          have hi_eq : (i'.1 : ℤ) = (i.1 : ℤ) := congr_arg Prod.fst heq
          exact Fin.ext (Nat.cast_injective hi_eq)
        · rintro rfl
          rfl
      have h_sum_P : ∀ w : Fin N_P → Fin N_Θ → ℝ,
          (∑ i' : Fin N_P, ∑ b' : Fin N_Θ, if G idx_P i' b' = z_P then w i' b' else 0) =
          ∑ b' : Fin N_Θ, w i b' := by
        intro w
        have h_in : ∀ i' : Fin N_P,
            (∑ b' : Fin N_Θ, if G idx_P i' b' = z_P then w i' b' else 0) =
            if i' = i then ∑ b' : Fin N_Θ, w i' b' else 0 := by
          intro i'
          by_cases hi' : i' = i
          · rw [if_pos hi']
            refine Finset.sum_congr rfl (fun b' _ => ?_)
            rw [if_pos ((hG_P i' b').mpr hi')]
          · rw [if_neg hi']
            refine Finset.sum_eq_zero (fun b' _ => ?_)
            rw [if_neg (fun h => hi' ((hG_P i' b').mp h))]
        simp_rw [h_in]
        rw [Finset.sum_eq_single i
          (fun i' _ hi' => if_neg hi')
          (fun h_not => absurd (Finset.mem_univ i) h_not), if_pos rfl]
      have hr_P_pos :
          0 < ∑ i' : Fin N_P, ∑ b' : Fin N_Θ, if G idx_P i' b' = z_P then r i' b' else 0 := by
        rw [h_sum_P r]
        exact lt_of_lt_of_le hr_pos
          (Finset.single_le_sum (f := fun b' => r i b')
            (fun b' _ => hr_nn i b') (Finset.mem_univ b))
      have h_fl_P := (hr_fib idx_P z_P hr_P_pos).1
      rw [h_sum_P r, h_sum_P p0] at h_fl_P
      have hr_P_eq : (∑ b' : Fin N_Θ, r i b') = M_ret * μ_i := by
        dsimp [μ_i]
        rw [Finset.mul_sum]
        exact Finset.sum_congr rfl (fun b' _ => (hM_mul_π i b').symm)
      rw [hr_P_eq] at h_fl_P
      have hmu0_le : mu0 i ≤ δ⁻¹ * (M_ret * μ_i) := by
        have h1 : mu0 i * δ ≤ M_ret * μ_i := by linarith [h_fl_P]
        have h2 := (le_div_iff₀ hδ_pos).mpr h1
        rwa [div_eq_inv_mul] at h2

      
      let idx_Θ : Fin N_tot := ⟨N_obs + k_grp + 1, by dsimp [N_tot]; omega⟩
      let z_Θ : Z := ((b.1 : ℤ), 0, 0, 0)
      have hG_Θ : ∀ (i' : Fin N_P) (b' : Fin N_Θ), G idx_Θ i' b' = z_Θ ↔ b' = b := by
        intro i' b'
        have h1 : ¬ (idx_Θ.1 < N_obs) := by dsimp [idx_Θ]; omega
        have h2 : ¬ (idx_Θ.1 < N_obs + k_grp) := by dsimp [idx_Θ]; omega
        have h3 : ¬ (idx_Θ.1 = N_obs + k_grp) := by dsimp [idx_Θ]; omega
        dsimp [G, z_Θ]
        rw [dif_neg h1, dif_neg h2, if_neg h3]
        constructor
        · intro heq
          have hb_eq : (b'.1 : ℤ) = (b.1 : ℤ) := congr_arg Prod.fst heq
          exact Fin.ext (Nat.cast_injective hb_eq)
        · rintro rfl
          rfl
      have h_sum_Θ : ∀ w : Fin N_P → Fin N_Θ → ℝ,
          (∑ i' : Fin N_P, ∑ b' : Fin N_Θ, if G idx_Θ i' b' = z_Θ then w i' b' else 0) =
          ∑ i' : Fin N_P, w i' b := by
        intro w
        rw [Finset.sum_comm]
        have h_in : ∀ b' : Fin N_Θ,
            (∑ i' : Fin N_P, if G idx_Θ i' b' = z_Θ then w i' b' else 0) =
            if b' = b then ∑ i' : Fin N_P, w i' b' else 0 := by
          intro b'
          by_cases hb' : b' = b
          · rw [if_pos hb']
            refine Finset.sum_congr rfl (fun i' _ => ?_)
            rw [if_pos ((hG_Θ i' b').mpr hb')]
          · rw [if_neg hb']
            refine Finset.sum_eq_zero (fun i' _ => ?_)
            rw [if_neg (fun h => hb' ((hG_Θ i' b').mp h))]
        simp_rw [h_in]
        rw [Finset.sum_eq_single b
          (fun b' _ hb' => if_neg hb')
          (fun h_not => absurd (Finset.mem_univ b) h_not), if_pos rfl]
      have hr_Θ_pos :
          0 < ∑ i' : Fin N_P, ∑ b' : Fin N_Θ, if G idx_Θ i' b' = z_Θ then r i' b' else 0 := by
        rw [h_sum_Θ r]
        exact lt_of_lt_of_le hr_pos
          (Finset.single_le_sum (f := fun i' => r i' b)
            (fun i' _ => hr_nn i' b) (Finset.mem_univ i))
      have h_fl_Θ := (hr_fib idx_Θ z_Θ hr_Θ_pos).1
      rw [h_sum_Θ r, h_sum_Θ p0] at h_fl_Θ
      have hr_Θ_eq : (∑ i' : Fin N_P, r i' b) = M_ret * lam_b := by
        dsimp [lam_b]
        rw [Finset.mul_sum]
        exact Finset.sum_congr rfl (fun i' _ => (hM_mul_π i' b).symm)
      rw [hr_Θ_eq] at h_fl_Θ
      have hlam0_le : lam0 b ≤ δ⁻¹ * (M_ret * lam_b) := by
        have h1 : lam0 b * δ ≤ M_ret * lam_b := by linarith [h_fl_Θ]
        have h2 := (le_div_iff₀ hδ_pos).mpr h1
        rwa [div_eq_inv_mul] at h2

      have h_prod_le : mu0 i * lam0 b ≤
          (δ⁻¹ * (M_ret * μ_i)) * (δ⁻¹ * (M_ret * lam_b)) :=
        mul_le_mul hmu0_le hlam0_le (hlam0_nn b) (by positivity)
      have hr_bound : r i b ≤
          M_ret * (Real.exp v * M_ret * (δ⁻¹ ^ 2) * μ_i * lam_b) := by
        calc r i b ≤ p0 i b := hr_le_p0 i b
          _ ≤ Real.exp v * mu0 i * lam0 b := hG.2.1
          _ = Real.exp v * (mu0 i * lam0 b) := mul_assoc _ _ _
          _ ≤ Real.exp v * ((δ⁻¹ * (M_ret * μ_i)) * (δ⁻¹ * (M_ret * lam_b))) :=
              mul_le_mul_of_nonneg_left h_prod_le (Real.exp_pos v).le
          _ = M_ret * (Real.exp v * M_ret * (δ⁻¹ ^ 2) * μ_i * lam_b) := by ring
      have h_zpow : δ⁻¹ ^ 2 = δ ^ (-2 : ℤ) := by
        rw [inv_pow, ← zpow_ofNat, ← zpow_neg]
      have hπ_le : π i b ≤ Real.exp v * M_ret * (δ⁻¹ ^ 2) * μ_i * lam_b := by
        dsimp [π]
        rw [div_le_iff₀ hM_ret_pos]
        linarith
      rwa [h_zpow] at hπ_le
    · have hr0_eq : r i b = 0 := le_antisymm (not_lt.mp hr_pos) (hr_nn i b)
      have hπ0 : π i b = 0 := by simp [π, hr0_eq]
      rw [hπ0]
      have hδ_zpow : 0 ≤ δ ^ (-2 : ℤ) := zpow_nonneg hδ_pos.le (-2)
      positivity
  
  · intro b hlam_b q
    dsimp only
    let lam_b := ∑ i : Fin N_P, π i b
    let S_lhs := ∑ i : Fin N_P, if (∀ g, Q g i b = q g) then π i b / lam_b else 0
    let π_marg : Fin k_grp → ℝ := fun g =>
      ∑ i : Fin N_P, if Q g i b = q g then π i b / lam_b else 0
    suffices h_main :
        S_lhs ≤ Real.exp v * δ ^ (-(k_grp : ℤ)) * ∏ g : Fin k_grp, π_marg g by
      have h_lhs_eq :
          (∑ i : Fin N_P, @ite _ (∀ g, Q g i b = q g) (Classical.propDecidable _)
            (π i b / (∑ i, π i b)) 0) = S_lhs := by
        refine Finset.sum_congr rfl (fun i _ => ?_)
        by_cases hc : ∀ g, Q g i b = q g
        · rw [if_pos hc, if_pos hc]
        · rw [if_neg hc, if_neg hc]
      have h_rhs_eq :
          (∏ g : Fin k_grp, ∑ i : Fin N_P,
            @ite _ (Q g i b = q g) (Classical.propDecidable _)
              (π i b / (∑ i, π i b)) 0) =
          ∏ g : Fin k_grp, π_marg g := by
        refine Finset.prod_congr rfl (fun g _ => Finset.sum_congr rfl (fun i _ => ?_))
        by_cases hc : Q g i b = q g
        · rw [if_pos hc, if_pos hc]
        · rw [if_neg hc, if_neg hc]
      rw [h_lhs_eq, h_rhs_eq]
      exact h_main
    have hπ_marg_nn : ∀ g, 0 ≤ π_marg g := fun g =>
      Finset.sum_nonneg (fun i _ => by
        split_ifs
        · exact div_nonneg (hπ_nn i b) hlam_b.le
        · exact le_rfl)
    by_cases hS_ne : S_lhs = 0
    · rw [hS_ne]
      have hδ_zpow : 0 ≤ δ ^ (-(k_grp : ℤ)) := zpow_nonneg hδ_pos.le _
      have h_prod_nn : 0 ≤ ∏ g : Fin k_grp, π_marg g :=
        Finset.prod_nonneg (fun g _ => hπ_marg_nn g)
      exact mul_nonneg (mul_nonneg (Real.exp_pos v).le hδ_zpow) h_prod_nn
    · obtain ⟨i₀, _, hi₀_ne⟩ := Finset.exists_ne_zero_of_sum_ne_zero hS_ne
      have hq_i₀ : ∀ g, Q g i₀ b = q g := by
        by_contra hnot
        rw [if_neg hnot] at hi₀_ne
        exact hi₀_ne rfl
      rw [if_pos hq_i₀] at hi₀_ne
      have hπ_i₀_pos : 0 < π i₀ b := by
        have h_div_pos : 0 < π i₀ b / lam_b :=
          lt_of_le_of_ne (div_nonneg (hπ_nn i₀ b) hlam_b.le) (Ne.symm hi₀_ne)
        have h1 := mul_pos h_div_pos hlam_b
        rwa [div_mul_cancel₀ _ hlam_b.ne'] at h1
      have hr_i₀_pos : 0 < r i₀ b := by
        have h1 := mul_pos hM_ret_pos hπ_i₀_pos
        rwa [hM_mul_π i₀ b] at h1
      obtain ⟨hG_i₀, hp0_i₀_pos⟩ := hπ_supp_good i₀ b hr_i₀_pos
      have hlam0_pos : 0 < lam0 b :=
        lt_of_lt_of_le hp0_i₀_pos
          (Finset.single_le_sum (fun i' _ => hp0_nn i' b) (Finset.mem_univ i₀))
      let rΘ_b : ℝ := M_ret * lam_b
      have hrΘ_pos : 0 < rΘ_b := mul_pos hM_ret_pos hlam_b
      have hrΘ_eq_sum : rΘ_b = ∑ i : Fin N_P, r i b := by
        dsimp [rΘ_b, lam_b]
        rw [Finset.mul_sum]
        exact Finset.sum_congr rfl (fun i _ => hM_mul_π i b)
      have hrΘ_le_lam0 : rΘ_b ≤ lam0 b := by
        rw [hrΘ_eq_sum]
        exact Finset.sum_le_sum (fun i _ => hr_le_p0 i b)
      have hr_eq_rΘ : ∀ i : Fin N_P, r i b = rΘ_b * (π i b / lam_b) := by
        intro i
        calc r i b = M_ret * π i b := (hM_mul_π i b).symm
          _ = M_ret * ((π i b / lam_b) * lam_b) := by rw [div_mul_cancel₀ _ hlam_b.ne']
          _ = (M_ret * lam_b) * (π i b / lam_b) := by ring
      let ξ0 : Fin k_grp → ℝ := fun g =>
        ∑ i' : Fin N_P, if Q g i' b = q g then p0 i' b / lam0 b else 0
      have hξ0_nn : ∀ g, 0 ≤ ξ0 g := fun g =>
        Finset.sum_nonneg (fun i' _ => by
          split_ifs
          · exact div_nonneg (hp0_nn i' b) hlam0_pos.le
          · exact le_rfl)

      
      have h_joint_ub : rΘ_b * S_lhs ≤ Real.exp v * lam0 b * ∏ g : Fin k_grp, ξ0 g := by
        have h_lhs_r : rΘ_b * S_lhs =
            ∑ i : Fin N_P, if (∀ g, Q g i b = q g) then r i b else 0 := by
          dsimp [S_lhs]
          rw [Finset.mul_sum]
          refine Finset.sum_congr rfl (fun i _ => ?_)
          split_ifs
          · exact (hr_eq_rΘ i).symm
          · ring
        have h_le_qj :
            (∑ i : Fin N_P, if (∀ g, Q g i b = q g) then r i b else 0) ≤ q_joint i₀ b := by
          dsimp [q_joint]
          refine Finset.sum_le_sum (fun i _ => ?_)
          have h_iff : (∀ g, Q g i b = q g) ↔ (∀ g, Q g i b = Q g i₀ b) :=
            ⟨fun h g => (h g).trans (hq_i₀ g).symm,
             fun h g => (h g).trans (hq_i₀ g)⟩
          rw [if_congr h_iff rfl rfl]
          split_ifs
          · exact hr_le_p0 i b
          · exact le_rfl
        have hp_prod_i₀ : p_prod i₀ b = ∏ g : Fin k_grp, ξ0 g := by
          dsimp [p_prod, ξ0]
          refine Finset.prod_congr rfl (fun g _ => Finset.sum_congr rfl (fun i' _ => ?_))
          have h_iff : (Q g i' b = Q g i₀ b) ↔ (Q g i' b = q g) := by rw [hq_i₀ g]
          exact if_congr h_iff rfl rfl
        calc rΘ_b * S_lhs
            ≤ q_joint i₀ b := h_lhs_r ▸ h_le_qj
          _ ≤ Real.exp v * lam0 b * p_prod i₀ b := hG_i₀.2.2
          _ = Real.exp v * lam0 b * ∏ g : Fin k_grp, ξ0 g := by rw [hp_prod_i₀]

      
      have hξ0_le : ∀ g : Fin k_grp,
          ξ0 g ≤ δ⁻¹ * (rΘ_b / lam0 b) * π_marg g := by
        intro g
        let idx_g : Fin N_tot := ⟨N_obs + g.1, by dsimp [N_tot]; omega⟩
        let z_g : Z := ((b.1 : ℤ), (q g).1, (q g).2, 0)
        have hG_g : ∀ (i' : Fin N_P) (b' : Fin N_Θ),
            G idx_g i' b' = z_g ↔ (b' = b ∧ Q g i' b' = q g) := by
          intro i' b'
          have h1 : ¬ (idx_g.1 < N_obs) := by dsimp [idx_g]; omega
          have h2 : idx_g.1 < N_obs + k_grp := by dsimp [idx_g]; omega
          have hg_eq : (⟨idx_g.1 - N_obs, by omega⟩ : Fin k_grp) = g := by
            ext
            dsimp [idx_g]
            omega
          dsimp [G, z_g]
          rw [dif_neg h1, dif_pos h2, hg_eq]
          constructor
          · intro heq
            rcases Prod.mk.inj heq with ⟨hb_eq, heq2⟩
            rcases Prod.mk.inj heq2 with ⟨hq1, heq3⟩
            rcases Prod.mk.inj heq3 with ⟨hq2, _⟩
            exact ⟨Fin.ext (Nat.cast_injective hb_eq), Prod.ext hq1 hq2⟩
          · rintro ⟨rfl, hqg⟩
            rw [hqg]
        have h_sum_g : ∀ w : Fin N_P → Fin N_Θ → ℝ,
            (∑ i' : Fin N_P, ∑ b' : Fin N_Θ, if G idx_g i' b' = z_g then w i' b' else 0) =
            ∑ i' : Fin N_P, if Q g i' b = q g then w i' b else 0 := by
          intro w
          rw [Finset.sum_comm]
          have h_in : ∀ b' : Fin N_Θ,
              (∑ i' : Fin N_P, if G idx_g i' b' = z_g then w i' b' else 0) =
              if b' = b then ∑ i' : Fin N_P, if Q g i' b' = q g then w i' b' else 0 else 0 := by
            intro b'
            by_cases hb' : b' = b
            · rw [if_pos hb']
              refine Finset.sum_congr rfl (fun i' _ => ?_)
              have h_iff : G idx_g i' b' = z_g ↔ Q g i' b' = q g :=
                ⟨fun h => ((hG_g i' b').mp h).2, fun h => (hG_g i' b').mpr ⟨hb', h⟩⟩
              exact if_congr h_iff rfl rfl
            · rw [if_neg hb']
              refine Finset.sum_eq_zero (fun i' _ => ?_)
              rw [if_neg (fun h => hb' ((hG_g i' b').mp h).1)]
          simp_rw [h_in]
          rw [Finset.sum_eq_single b
            (fun b' _ hb' => if_neg hb')
            (fun h_not => absurd (Finset.mem_univ b) h_not), if_pos rfl]
        have hr_g_pos :
            0 < ∑ i' : Fin N_P, ∑ b' : Fin N_Θ, if G idx_g i' b' = z_g then r i' b' else 0 := by
          rw [h_sum_g r]
          have h_le : (if Q g i₀ b = q g then r i₀ b else 0) ≤
              ∑ i' : Fin N_P, if Q g i' b = q g then r i' b else 0 :=
            Finset.single_le_sum
              (f := fun i' => if Q g i' b = q g then r i' b else 0)
              (fun i' _ => by
                split_ifs
                · exact hr_nn i' b
                · exact le_rfl)
              (Finset.mem_univ i₀)
          rw [if_pos (hq_i₀ g)] at h_le
          exact lt_of_lt_of_le hr_i₀_pos h_le
        have h_fl_g := (hr_fib idx_g z_g hr_g_pos).1
        rw [h_sum_g r, h_sum_g p0] at h_fl_g
        have hr_g_eq : (∑ i' : Fin N_P, if Q g i' b = q g then r i' b else 0) =
            rΘ_b * π_marg g := by
          dsimp [π_marg]
          rw [Finset.mul_sum]
          refine Finset.sum_congr rfl (fun i' _ => ?_)
          split_ifs
          · exact hr_eq_rΘ i'
          · ring
        have hp0_g_eq : (∑ i' : Fin N_P, if Q g i' b = q g then p0 i' b else 0) =
            lam0 b * ξ0 g := by
          dsimp [ξ0]
          rw [Finset.mul_sum]
          refine Finset.sum_congr rfl (fun i' _ => ?_)
          split_ifs
          · exact (mul_div_cancel₀ (p0 i' b) hlam0_pos.ne').symm
          · ring
        rw [hr_g_eq, hp0_g_eq] at h_fl_g
        have h_pos_denom : 0 < δ * lam0 b := mul_pos hδ_pos hlam0_pos
        have h_div : ξ0 g ≤ (rΘ_b * π_marg g) / (δ * lam0 b) := by
          rw [le_div_iff₀ h_pos_denom]
          linarith [h_fl_g]
        have h_alg : (rΘ_b * π_marg g) / (δ * lam0 b) =
            δ⁻¹ * (rΘ_b / lam0 b) * π_marg g := by
          have hδ_ne := hδ_pos.ne'
          have hl0_ne := hlam0_pos.ne'
          field_simp [hδ_ne, hl0_ne]
        rwa [h_alg] at h_div

      have h_prod_bound :
          ∏ g : Fin k_grp, ξ0 g ≤
          (δ⁻¹ ^ k_grp) * ((rΘ_b / lam0 b) ^ k_grp) * ∏ g : Fin k_grp, π_marg g := by
        calc ∏ g : Fin k_grp, ξ0 g
            ≤ ∏ g : Fin k_grp, (δ⁻¹ * (rΘ_b / lam0 b) * π_marg g) :=
              Finset.prod_le_prod₀ (fun g _ => hξ0_nn g) (fun g _ => hξ0_le g)
          _ = (∏ _g : Fin k_grp, (δ⁻¹ * (rΘ_b / lam0 b))) * ∏ g : Fin k_grp, π_marg g :=
              Finset.prod_mul_distrib
          _ = (δ⁻¹ * (rΘ_b / lam0 b)) ^ k_grp * ∏ g : Fin k_grp, π_marg g := by
              rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin]
          _ = (δ⁻¹ ^ k_grp) * ((rΘ_b / lam0 b) ^ k_grp) * ∏ g : Fin k_grp, π_marg g := by
              rw [mul_pow, mul_assoc]

      have h_pow_cancel : lam0 b * ((rΘ_b / lam0 b) ^ k_grp) ≤ rΘ_b := by
        have hk_eq : k_grp = (k_grp - 1) + 1 := (Nat.sub_add_cancel hk).symm
        rw [hk_eq, pow_succ]
        have h_cancel : lam0 b * ((rΘ_b / lam0 b) ^ (k_grp - 1) * (rΘ_b / lam0 b)) =
            rΘ_b * ((rΘ_b / lam0 b) ^ (k_grp - 1)) := by
          have hl0_ne := hlam0_pos.ne'
          field_simp [hl0_ne]
        rw [h_cancel]
        have h_rat_nn : 0 ≤ rΘ_b / lam0 b := div_nonneg hrΘ_pos.le hlam0_pos.le
        have h_rat_le : rΘ_b / lam0 b ≤ 1 := (div_le_one hlam0_pos).mpr hrΘ_le_lam0
        have h_pow_le : (rΘ_b / lam0 b) ^ (k_grp - 1) ≤ 1 :=
          pow_le_one₀ h_rat_nn h_rat_le
        calc rΘ_b * ((rΘ_b / lam0 b) ^ (k_grp - 1))
            ≤ rΘ_b * 1 := mul_le_mul_of_nonneg_left h_pow_le hrΘ_pos.le
          _ = rΘ_b := mul_one _

      have h_zpow_k : δ⁻¹ ^ k_grp = δ ^ (-(k_grp : ℤ)) := by
        rw [inv_pow, ← zpow_natCast, ← zpow_neg]
      have h_prod_nn : 0 ≤ ∏ g : Fin k_grp, π_marg g :=
        Finset.prod_nonneg (fun g _ => hπ_marg_nn g)
      have h_total :
          rΘ_b * S_lhs ≤
          rΘ_b * (Real.exp v * δ ^ (-(k_grp : ℤ)) * ∏ g : Fin k_grp, π_marg g) := by
        calc rΘ_b * S_lhs
            ≤ Real.exp v * lam0 b * ∏ g : Fin k_grp, ξ0 g := h_joint_ub
          _ = Real.exp v * (lam0 b * ∏ g : Fin k_grp, ξ0 g) := mul_assoc _ _ _
          _ ≤ Real.exp v * (lam0 b *
                ((δ⁻¹ ^ k_grp) * ((rΘ_b / lam0 b) ^ k_grp) * ∏ g : Fin k_grp, π_marg g)) :=
              mul_le_mul_of_nonneg_left
                (mul_le_mul_of_nonneg_left h_prod_bound hlam0_pos.le)
                (Real.exp_pos v).le
          _ = (lam0 b * ((rΘ_b / lam0 b) ^ k_grp)) *
                (Real.exp v * (δ⁻¹ ^ k_grp) * ∏ g : Fin k_grp, π_marg g) := by ring
          _ ≤ rΘ_b * (Real.exp v * (δ⁻¹ ^ k_grp) * ∏ g : Fin k_grp, π_marg g) :=
              mul_le_mul_of_nonneg_right h_pow_cancel (by positivity)
          _ = rΘ_b * (Real.exp v * δ ^ (-(k_grp : ℤ)) * ∏ g : Fin k_grp, π_marg g) := by
              rw [h_zpow_k]
      exact le_of_mul_le_mul_left h_total hrΘ_pos
  
  · intro m_idx z
    dsimp only
    let idx_m : Fin N_tot := ⟨m_idx.1, by dsimp [N_tot]; omega⟩
    have hG_m : ∀ (i : Fin N_P) (b : Fin N_Θ), G idx_m i b = F m_idx i b := by
      intro i b
      have h1 : idx_m.1 < N_obs := m_idx.2
      have hm_eq : (⟨idx_m.1, h1⟩ : Fin N_obs) = m_idx := by
        ext
        rfl
      dsimp [G]
      rw [dif_pos h1, hm_eq]
    have hr_rew :
        (∑ i : Fin N_P, ∑ b : Fin N_Θ,
          @ite _ (F m_idx i b = z) (Classical.propDecidable _) (M_ret * π i b) 0) =
        ∑ i : Fin N_P, ∑ b : Fin N_Θ, if G idx_m i b = z then r i b else 0 := by
      refine Finset.sum_congr rfl (fun i _ => Finset.sum_congr rfl (fun b _ => ?_))
      by_cases hc : F m_idx i b = z
      · have hc' : G idx_m i b = z := (hG_m i b).trans hc
        rw [if_pos hc, if_pos hc', hM_mul_π i b]
      · have hc' : ¬ (G idx_m i b = z) := fun h => hc ((hG_m i b).symm.trans h)
        rw [if_neg hc, if_neg hc']
    have hp0_rew :
        (∑ i : Fin N_P, ∑ b : Fin N_Θ,
          @ite _ (F m_idx i b = z) (Classical.propDecidable _) (p0 i b) 0) =
        ∑ i : Fin N_P, ∑ b : Fin N_Θ, if G idx_m i b = z then p0 i b else 0 := by
      refine Finset.sum_congr rfl (fun i _ => Finset.sum_congr rfl (fun b _ => ?_))
      by_cases hc : F m_idx i b = z
      · have hc' : G idx_m i b = z := (hG_m i b).trans hc
        rw [if_pos hc, if_pos hc']
      · have hc' : ¬ (G idx_m i b = z) := fun h => hc ((hG_m i b).symm.trans h)
        rw [if_neg hc, if_neg hc']
    rw [hr_rew, hp0_rew]
    exact hr_fib idx_m z

theorem zoomed_orient_prefix_homogenization (γ m σ : ℝ) (hγ₀ : 0 < γ) (hγ₁ : γ < 1) (hm : 0 < m)
    (sys : MatchedAspectProfileSystem γ m)
    (hσ₀ : 0 < σ) (hσ₁ : σ ≤ 1 / 4) (hσ_κ : 4 * m * σ ≤ sys.κ)
    (i u h K η_err : ℝ) (M : ℕ)
    (hi : 0 < i) (hu : u ∈ Set.Ioo (0 : ℝ) 1) (hh : 0 < h)
    (hK : max 2 (2 / m) ≤ K) (huKh : u + K * h < 1)
    (hM : 2 ≤ M) (hη : 0 < η_err) :
    let δ₀ : ℝ := min 1 m / (K * ((⌈4 / σ⌉₊ : ℝ) + 2))
    0 < δ₀ ∧ K * δ₀ ≤ 1 ∧
    ∃ (t₀ c_ret : ℝ),
      t₀ ∈ Set.Icc (0 : ℝ) (1 - K * δ₀) ∧ 0 < c_ret ∧
      ∃ᶠ k : ℕ in Filter.atTop,
        ∃ E_norm : Finset (Fin (sys.N_ω k)),
          c_ret ≤ (∑ ω ∈ E_norm, sys.π_seq k ω) ∧
          ∀ (r_idx : ℕ), 1 ≤ r_idx → r_idx ≤ M →
            ∀ ω ∈ E_norm, 0 < sys.π_seq k ω →
              letI := Classical.propDecidable
              let ε := sys.ε_seq k
              let u' := u + t₀ * h
              let h' := δ₀ * h
              let d := (r_idx : ℝ) / (M : ℝ)
              let E_obs := fun ω' : Fin (sys.N_ω k) =>
                rowObs6 ε m (sys.V_seq k (sys.T_seq k ω')) (sys.A_seq k (sys.T_seq k ω'))
                  (sys.c_seq k ω') (sys.R_seq k ω')
                  (i, i + u', i + m * u', i + (1 + m) * u', u')
              let R_d := fun ω' : Fin (sys.N_ω k) =>
                dyadicRealBin ε (m * u' + d * h') (sys.R_seq k ω')
              (∑ ω' ∈ E_norm,
                if E_obs ω' = E_obs ω ∧ R_d ω' = R_d ω then sys.π_seq k ω' else 0) ≤
              ε ^ (((5 / 4 : ℝ) * σ * d - η_err) * h') *
                (∑ ω' ∈ E_norm, if E_obs ω' = E_obs ω then sys.π_seq k ω' else 0) :=
by
  have h_ite_c : ∀ (p : Prop) {d₁ d₂ : Decidable p} (a b : ℝ),
      @ite ℝ p d₁ a b = @ite ℝ p d₂ a b :=
    fun _ {d₁ d₂} _ _ => Subsingleton.elim d₁ d₂ ▸ rfl

  
  have h_s2 : ∀ (ε : ℝ), 0 < ε → ε < 1 / 2 →
      (∀ (v₁ v₂ c₁ c₂ : ℝ), v₁ ≤ v₂ →
        dyadicTimeBin ε v₂ c₁ = dyadicTimeBin ε v₂ c₂ →
        dyadicTimeBin ε v₁ c₁ = dyadicTimeBin ε v₁ c₂) ∧
      (∀ (L₁ L₂ x₁ x₂ : ℝ), L₁ ≤ L₂ →
        dyadicRealBin ε L₂ x₁ = dyadicRealBin ε L₂ x₂ →
        dyadicRealBin ε L₁ x₁ = dyadicRealBin ε L₁ x₂) ∧
      (∀ (L₁ L₂ Δ : ℝ), L₁ ≤ L₂ → L₂ - L₁ ≤ Δ →
        ∃ (N : ℕ) (lo : ℤ → ℤ),
          1 ≤ N ∧ (N : ℝ) ≤ 2 * ε ^ (-Δ) ∧
          ∀ x : ℝ,
            let q₁ := dyadicRealBin ε L₁ x
            let q₂ := dyadicRealBin ε L₂ x
            lo q₁ ≤ q₂ ∧ q₂ < lo q₁ + (N : ℤ)) ∧
      (∀ (m' i' u' : ℝ) (V₁ A₁ V₂ A₂ : EuclideanSpace ℝ (Fin 2)) (c₁ R₁ c₂ R₂ : ℝ),
        V₁ = V₂ → A₁ = A₂ →
        dyadicTimeBin ε u' c₁ = dyadicTimeBin ε u' c₂ →
        dyadicRealBin ε (m' * u') R₁ = dyadicRealBin ε (m' * u') R₂ →
        rowObs6 ε m' V₁ A₁ c₁ R₁ (i', i' + u', i' + m' * u', i' + (1 + m') * u', u') =
        rowObs6 ε m' V₂ A₂ c₂ R₂ (i', i' + u', i' + m' * u', i' + (1 + m') * u', u')) := by
    intro ε hε₀ hε₁
    have hε_le1 : ε ≤ 1 := by linarith
    have h_inv_gt1 : 1 < ε⁻¹ := (one_lt_inv₀ hε₀).mpr (by linarith)
    have hell_pos : 0 < Real.log (ε⁻¹) := Real.log_pos h_inv_gt1
    have hlog2_pos : 0 < Real.log 2 := Real.log_pos one_lt_two
    have hell2_pos : 0 < Real.log (ε⁻¹) / Real.log 2 := div_pos hell_pos hlog2_pos
    have h_real_div : ∀ (L₁ L₂ : ℝ), L₁ ≤ L₂ →
        let m₁ := dyadicRealLevel ε L₁
        let m₂ := dyadicRealLevel ε L₂
        let d_r : ℕ := (m₂ - m₁).toNat
        m₁ ≤ m₂ ∧ m₂ = m₁ + (d_r : ℤ) ∧
        ∀ x : ℝ, dyadicRealBin ε L₁ x = dyadicRealBin ε L₂ x / ((2 ^ d_r : ℕ) : ℤ) := by
      intro L₁ L₂ hL
      dsimp only
      set m₁ := dyadicRealLevel ε L₁
      set m₂ := dyadicRealLevel ε L₂
      have hm_le : m₁ ≤ m₂ :=
        Int.floor_mono (mul_le_mul_of_nonneg_right hL hell2_pos.le)
      set d_r : ℕ := (m₂ - m₁).toNat
      have hdr_eq : (d_r : ℤ) = m₂ - m₁ := Int.toNat_of_nonneg (sub_nonneg.mpr hm_le)
      have hm₂_eq : m₂ = m₁ + (d_r : ℤ) := by omega
      refine ⟨hm_le, hm₂_eq, fun x => ?_⟩
      unfold dyadicRealBin
      change ⌊x * (2 : ℝ) ^ m₁⌋ = ⌊x * (2 : ℝ) ^ m₂⌋ / ((2 ^ d_r : ℕ) : ℤ)
      have h_pow : x * (2 : ℝ) ^ m₁ = (x * (2 : ℝ) ^ m₂) / ((2 ^ d_r : ℕ) : ℝ) := by
        rw [hm₂_eq, zpow_add₀ (by norm_num : (2 : ℝ) ≠ 0), zpow_natCast]
        have h2pos : (0 : ℝ) < ((2 ^ d_r : ℕ) : ℝ) := by positivity
        push_cast
        field_simp [h2pos.ne']
      rw [h_pow, Int.floor_div_natCast]
    refine ⟨?_, ?_, ?_, ?_⟩
    · intro v₁ v₂ c₁ c₂ hv h_eq
      have hrpow : ε ^ (-v₁) ≤ ε ^ (-v₂) :=
        Real.rpow_le_rpow_of_exponent_ge hε₀ hε_le1 (neg_le_neg hv)
      have hm_le : dyadicTimeLevel ε v₁ ≤ dyadicTimeLevel ε v₂ :=
        Nat.clog_mono_right 2 (Nat.ceil_mono hrpow)
      set m₁ := dyadicTimeLevel ε v₁
      set m₂ := dyadicTimeLevel ε v₂
      set d_t : ℕ := m₂ - m₁
      have hm₂_eq : m₂ = m₁ + d_t := (Nat.add_sub_of_le hm_le).symm
      have h_div_c : ∀ c : ℝ,
          dyadicTimeBin ε v₁ c = dyadicTimeBin ε v₂ c / ((2 ^ d_t : ℕ) : ℤ) := by
        intro c
        unfold dyadicTimeBin
        change min ⌊c * (2 : ℝ) ^ m₁⌋ ((2 ^ m₁ : ℤ) - 1) =
          min ⌊c * (2 : ℝ) ^ m₂⌋ ((2 ^ m₂ : ℤ) - 1) / ((2 ^ d_t : ℕ) : ℤ)
        by_cases hc : c < 1
        · have h_min : ∀ m' : ℕ,
              min ⌊c * (2 : ℝ) ^ m'⌋ ((2 ^ m' : ℤ) - 1) = ⌊c * (2 : ℝ) ^ m'⌋ := by
            intro m'
            refine min_eq_left ?_
            have h_lt : ⌊c * (2 : ℝ) ^ m'⌋ < (2 ^ m' : ℤ) := by
              rw [Int.floor_lt]
              have h2m : (0 : ℝ) < (2 : ℝ) ^ m' := by positivity
