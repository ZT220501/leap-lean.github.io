        have h1 : 2 * r_norm * ε ^ (-(b₀ + m * u)) + 2 =
            (96 * (N : ℝ) + 180) * (ε ^ (b₀ + m * u - ν) * ε ^ (-(b₀ + m * u))) + 2 := by
          dsimp only [r_norm]; ring
        rw [h1, hnorm_cancel]
        linarith
      have hε_bmu_le_b : ε ^ (b₀ + m * u) ≤ ε ^ b₀ :=
        h_rpow_anti b₀ (b₀ + m * u) (by linarith)
      have hε_bmu_le_rn : ε ^ (b₀ + m * u) ≤ ε ^ (b₀ + m * u - ν) :=
        h_rpow_anti (b₀ + m * u - ν) (b₀ + m * u) (by linarith)
      have hε_bd_eq : ε ^ b₀ * ε ^ d = ε ^ (b₀ + m * u - ν) := by
        rw [← Real.rpow_add hε₀]; congr 1; dsimp only [d]; ring
      have h_cross_cap : 3 * ((2 * ε ^ b₀) * E_align + 2 * ε ^ (b₀ + m * u)) ≤ r_norm := by
        have h1 : 3 * ((2 * ε ^ b₀) * E_align + 2 * ε ^ (b₀ + m * u)) =
            (48 * (N : ℝ) + 84) * (ε ^ b₀ * ε ^ d) + 6 * ε ^ (b₀ + m * u) := by
          dsimp only [E_align]; ring
        rw [h1, hε_bd_eq]
        dsimp only [r_norm]
        linarith
      refine ⟨I_X, I_W, I_par, I_perp, hIX_10, hIW_c.trans h_rn_card,
        hIpar_18, hIperp_c.trans h_rn_card, fun w₂ => ?_⟩
      let w₂' := chartRowVec useChart0 w₂
      have h_in_par : ∀ x : EuclideanSpace ℝ (Fin 2),
          inner ℝ (chartRowVec useChart0 x) e'_u1 = inner ℝ x e_u1 :=
        fun x => (h_crv_props useChart0 x e_u1 0).2.1
      have h_in_perp : ∀ x : EuclideanSpace ℝ (Fin 2),
          inner ℝ (chartRowVec useChart0 x) (perp2D e'_u1) = inner ℝ x (perp2D e_u1) := by
        intro x
        rw [← (h_crv_props useChart0 e_u1 0 0).2.2.1]
        exact (h_crv_props useChart0 x (perp2D e_u1) 0).2.1
      refine ⟨?_, ?_⟩
      · rintro ⟨hbin_par, hbin_perp⟩
        have hd_par : |inner ℝ w₂' e'_u1 - inner ℝ w₁' e'_u1| ≤ 2 * ε ^ b₀ := by
          rw [h_in_par w₂, h_in_par w₁]
          exact ((h_real_lvl ε b₀ hε₀ hε₁).2.2.2 _ _ hbin_par).2.le
        have hd_perp : |inner ℝ w₂' (perp2D e'_u1) - inner ℝ w₁' (perp2D e'_u1)| ≤
            2 * ε ^ (b₀ + m * u) := by
          rw [h_in_perp w₂, h_in_perp w₁]
