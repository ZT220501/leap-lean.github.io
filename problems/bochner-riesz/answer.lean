  obtain ⟨q₀, hq₀_M, h_freq_rs⟩ := h_s4 τ J₁ hτ_pos hJ₁_ge1 m_cell w_seq h_rs_ev
  change q₀ + M ≤ Q at hq₀_M

  
  let t₀ : ℝ := (q₀ : ℝ) * τ / (m * h)
