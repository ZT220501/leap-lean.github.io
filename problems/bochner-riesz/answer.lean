                  ∑ k : Fin n, c j * F_LL k j (i, u)) + q j * (-F_VL j (i, u)) := by
                rw [h1]
                ring
            _ = q j * (∑ k : Fin n, (c k - c j) * (-F_LL k j (i, u))) +
                  q j * (-F_VL j (i, u)) := by
                rw [h2]
            _ = (∑ k : Fin n, q j * (c k - c j) * (-F_LL k j (i, u))) +
                  q j * (-F_VL j (i, u)) := by
                rw [h3]
        rw [h_rew, h_sym_sum]
      have h_ll_le :
          ((1 / 2 : ℝ) * c_gap ^ 2) *
            (∑ j : Fin n, ∑ k : Fin n, if j = k then 0 else |F_LL k j (i, u)|) ≤
          (1 / 2 : ℝ) * ∑ j : Fin n, ∑ k : Fin n, (c k - c j) ^ 2 * (-F_LL k j (i, u)) := by
        rw [Finset.mul_sum, Finset.mul_sum]
        refine Finset.sum_le_sum fun j _ => ?_
        rw [Finset.mul_sum, Finset.mul_sum]
        refine Finset.sum_le_sum fun k _ => ?_
        by_cases hjk : j = k
        · simp [hjk]
        · simp only [hjk, ↓reduceIte]
          have hneg : F_LL k j (i, u) ≤ 0 := hs.2.2.1 k j (Ne.symm hjk)
          have habs : |F_LL k j (i, u)| = -F_LL k j (i, u) := abs_of_nonpos hneg
          rw [habs, ← mul_assoc]
