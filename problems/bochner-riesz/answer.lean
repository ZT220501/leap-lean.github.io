      obtain ⟨hV2_in, hV2_bd⟩ := h_fl_in (V_part tid 1) (le_trans (h_coord_le _ 1) (hVA tid).1)
      obtain ⟨hA1_in, hA1_bd⟩ := h_fl_in (A_part tid 0) (le_trans (h_coord_le _ 0) (hVA tid).2)
      obtain ⟨hA2_in, hA2_bd⟩ := h_fl_in (A_part tid 1) (le_trans (h_coord_le _ 1) (hVA tid).2)
      let q0 : (↥box_0 × ↥box_0) × (↥box_0 × ↥box_0) :=
        ((⟨⌊V_part tid 0⌋, hV1_in⟩, ⟨⌊V_part tid 1⌋, hV2_in⟩),
         (⟨⌊A_part tid 0⌋, hA1_in⟩, ⟨⌊A_part tid 1⌋, hA2_in⟩))
      let m0 : MenuType := (dp0, dir0,
        (⟨q0.1.1.val, h_box0_sub _ q0.1.1.prop⟩, ⟨q0.1.2.val, h_box0_sub _ q0.1.2.prop⟩),
        (⟨q0.2.1.val, h_box0_sub _ q0.2.1.prop⟩, ⟨q0.2.2.val, h_box0_sub _ q0.2.2.prop⟩))
      have hm0_in : m0 ∈ S₀ := by
        refine Finset.mem_image.mpr ⟨q0, ?_, rfl⟩
        simp [Finset.mem_product]
      refine ⟨m0, hm0_in, (h_cap_mem m0 tid).mpr ?_⟩
      have hb_m0 : b_menu m0 = 0 := by simp [b_menu, m0, dp0]
      have ha_m0 : a_menu m0 = 0 := by simp [a_menu, m0, dp0]
      have he_m0 : e_menu m0 = e₀_unit := hu10_eq
      have h_in_e0 : ∀ X : EuclideanSpace ℝ (Fin 2),
