              have h2 : ‖iteratedDeriv (n + 1 - (i + 1)) h t‖ ≤ K_maj B n :=
                ih_n (n + 1 - (i + 1)) h_sub t
              have h12 : ‖iteratedDeriv (i + 1) Ψ t‖ * ‖iteratedDeriv (n + 1 - (i + 1)) h t‖ ≤
                  D_phase (i + 1) * K_maj B n :=
