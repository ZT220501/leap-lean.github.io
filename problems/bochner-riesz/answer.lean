      linarith
    have hSstd_le : S_std.card ≤ ⌈C_loc * ε ^ (-2 * ν)⌉₊ := by
      refine h_card_ceil _ _ ?_
      have hceq : (S_std.card : ℝ) =
          ((I_Vpar.card : ℝ) * (I_Ppar.card : ℝ)) *
