              Q_raw (⟨i, d⟩, m) tid *
                Real.log (Q_raw (⟨i, d⟩, m) tid / (p_T_glob tid * Q_D_raw (⟨i, d⟩, m))) := by
          dsimp only [ITD_glob_val, Q_glob, Q_D_glob]
          rw [mul_div_cancel₀ _ hell_ne]
          calc ∑ tid : Fin N_T, ∑ k : Fin N_glob,
                Q_raw (equivG.symm k) tid *
                  Real.log (Q_raw (equivG.symm k) tid /
                    (p_T_glob tid * (∑ t', Q_raw (equivG.symm k) t')))
              = ∑ k : Fin N_glob, ∑ tid : Fin N_T,
                  Q_raw (equivG.symm k) tid *
                    Real.log (Q_raw (equivG.symm k) tid /
                      (p_T_glob tid * Q_D_raw (equivG.symm k))) := Finset.sum_comm
            _ = ∑ idx : Idx, ∑ tid : Fin N_T,
                  Q_raw idx tid * Real.log (Q_raw idx tid / (p_T_glob tid * Q_D_raw idx)) :=
                equivG.symm.sum_comp (fun idx : Idx =>
                  ∑ tid : Fin N_T,
                    Q_raw idx tid * Real.log (Q_raw idx tid / (p_T_glob tid * Q_D_raw idx)))
            _ = _ := by rw [Fintype.sum_prod_type, Fintype.sum_sigma]
        have h_term_split : ∀ (i : Fin S_J.card) (d : Fin (N_D_f i))
            (m : Fin M_sub) (tid : Fin N_T),
            Q_raw (⟨i, d⟩, m) tid *
                Real.log (Q_raw (⟨i, d⟩, m) tid / (p_T_glob tid * Q_D_raw (⟨i, d⟩, m))) =
              Q_raw (⟨i, d⟩, m) tid * (-Real.log (p_J_fn ((e_J i).1))) +
              Q_raw (⟨i, d⟩, m) tid *
                Real.log (q_loc_f i tid d / (p_T_loc i tid * q_D_loc i d)) +
              Q_raw (⟨i, d⟩, m) tid *
                Real.log ((p_J_fn ((e_J i).1) * q_D_loc i d) / Q_D_raw (⟨i, d⟩, m)) := by
          intro i d m tid
          have hQ_nn_r : 0 ≤ Q_raw (⟨i, d⟩, m) tid := by
            dsimp only [Q_raw]
            split_ifs
            · exact mul_nonneg (hpJ_nn _) ((h_opt i).2.1 tid d)
            · exact le_rfl
          rcases eq_or_lt_of_le hQ_nn_r with h0 | hQ_pos
          · rw [← h0]; simp
          · have hpj_pos : 0 < p_J_fn ((e_J i).1) := (hπj_props ((e_J i).1) (e_J i).2).1
            have hq_pos : 0 < q_loc_f i tid d := by
              dsimp only [Q_raw] at hQ_pos
              split_ifs at hQ_pos
              · exact pos_of_mul_pos_right hQ_pos hpj_pos.le
              · linarith
            have hsel_eq : sel_f i d tid = m := by
              dsimp only [Q_raw] at hQ_pos
              split_ifs at hQ_pos with hs
              · exact hs
              · linarith
            have hj_eq : J_part tid = (e_J i).1 := h_tid_j i d tid hq_pos
            have hpTl_pos : 0 < p_T_loc i tid := by
              have hsum_d : ∑ d' : Fin (N_D_f i), q_loc_f i tid d' = p_T_loc i tid :=
                (h_opt i).2.2.1 tid
              rw [← hsum_d]
              exact lt_of_lt_of_le hq_pos
                (Finset.single_le_sum (fun d' _ => (h_opt i).2.1 tid d') (Finset.mem_univ d))
            have hqDl_pos : 0 < q_D_loc i d :=
              lt_of_lt_of_le hq_pos
                (Finset.single_le_sum (fun t' _ => (h_opt i).2.1 t' d) (Finset.mem_univ tid))
            have hpTg_eq : p_T_glob tid = p_J_fn ((e_J i).1) * p_T_loc i tid := by
              have hr := hpT_rel i tid
              rw [if_pos hj_eq] at hr
              exact hr.symm
            have hQD_pos : 0 < Q_D_raw (⟨i, d⟩, m) := by
              refine lt_of_lt_of_le hQ_pos
                (Finset.single_le_sum (f := fun t' => Q_raw (⟨i, d⟩, m) t')
                  (fun t' _ => ?_) (Finset.mem_univ tid))
              dsimp only [Q_raw]
              split_ifs
              · exact mul_nonneg (hpJ_nn _) ((h_opt i).2.1 t' d)
              · exact le_rfl
            have hQ_val : Q_raw (⟨i, d⟩, m) tid = p_J_fn ((e_J i).1) * q_loc_f i tid d := by
              dsimp only [Q_raw]; rw [if_pos hsel_eq]
            have h_arg_eq : Q_raw (⟨i, d⟩, m) tid / (p_T_glob tid * Q_D_raw (⟨i, d⟩, m)) =
                ((p_J_fn ((e_J i).1))⁻¹ * (q_loc_f i tid d / (p_T_loc i tid * q_D_loc i d))) *
                  ((p_J_fn ((e_J i).1) * q_D_loc i d) / Q_D_raw (⟨i, d⟩, m)) := by
              rw [hQ_val, hpTg_eq]
              field_simp [hpj_pos.ne', hpTl_pos.ne', hqDl_pos.ne', hQD_pos.ne']
            have hf1_pos : 0 < (p_J_fn ((e_J i).1))⁻¹ := inv_pos.mpr hpj_pos
            have hf2_pos : 0 < q_loc_f i tid d / (p_T_loc i tid * q_D_loc i d) := by positivity
            have hf3_pos : 0 < (p_J_fn ((e_J i).1) * q_D_loc i d) / Q_D_raw (⟨i, d⟩, m) := by
              positivity
            rw [h_arg_eq,
              Real.log_mul (mul_pos hf1_pos hf2_pos).ne' hf3_pos.ne',
              Real.log_mul hf1_pos.ne' hf2_pos.ne',
              Real.log_inv]
            ring
        have h_sum1 : (∑ i : Fin S_J.card, ∑ d : Fin (N_D_f i), ∑ m : Fin M_sub, ∑ tid : Fin N_T,
              Q_raw (⟨i, d⟩, m) tid * (-Real.log (p_J_fn ((e_J i).1)))) = ell * H_J := by
          calc ∑ i : Fin S_J.card, ∑ d : Fin (N_D_f i), ∑ m : Fin M_sub, ∑ tid : Fin N_T,
                Q_raw (⟨i, d⟩, m) tid * (-Real.log (p_J_fn ((e_J i).1)))
              = ∑ i : Fin S_J.card,
                  (p_J_fn ((e_J i).1) * (∑ d : Fin (N_D_f i), q_D_loc i d)) *
                    (-Real.log (p_J_fn ((e_J i).1))) := by
                  refine Finset.sum_congr rfl (fun i _ => ?_)
                  simp_rw [← Finset.sum_mul]
                  congr 1
                  change (∑ d : Fin (N_D_f i), ∑ m : Fin M_sub, Q_D_raw (⟨i, d⟩, m)) = _
                  simp_rw [hQD_sum_m, ← Finset.mul_sum]
            _ = ∑ i : Fin S_J.card, -(p_J_fn ((e_J i).1) * Real.log (p_J_fn ((e_J i).1))) := by
                  refine Finset.sum_congr rfl (fun i _ => ?_)
                  rw [hqD_loc_sum i, mul_one]; ring
            _ = ∑ j ∈ S_J, -(p_J_fn j * Real.log (p_J_fn j)) :=
                  h_sum_eJ (fun j => -(p_J_fn j * Real.log (p_J_fn j)))
            _ = ell * H_J := by
                  dsimp only [H_J]
                  rw [Finset.mul_sum]
                  refine Finset.sum_congr rfl (fun j _ => ?_)
                  field_simp [hell_ne]
        have h_sum2 : (∑ i : Fin S_J.card, ∑ d : Fin (N_D_f i), ∑ m : Fin M_sub, ∑ tid : Fin N_T,
              Q_raw (⟨i, d⟩, m) tid *
                Real.log (q_loc_f i tid d / (p_T_loc i tid * q_D_loc i d))) =
            ell * ∑ i : Fin S_J.card, p_J_fn ((e_J i).1) * ITD_loc_fn i := by
          rw [Finset.mul_sum]
          refine Finset.sum_congr rfl (fun i _ => ?_)
          dsimp only [ITD_loc_fn]
          have h_lhs : (∑ d : Fin (N_D_f i), ∑ m : Fin M_sub, ∑ tid : Fin N_T,
                Q_raw (⟨i, d⟩, m) tid *
                  Real.log (q_loc_f i tid d / (p_T_loc i tid * q_D_loc i d))) =
              p_J_fn ((e_J i).1) * ∑ tid : Fin N_T, ∑ d : Fin (N_D_f i),
                q_loc_f i tid d * Real.log (q_loc_f i tid d / (p_T_loc i tid * q_D_loc i d)) := by
            rw [Finset.mul_sum]
            calc ∑ d : Fin (N_D_f i), ∑ m : Fin M_sub, ∑ tid : Fin N_T,
                  Q_raw (⟨i, d⟩, m) tid *
                    Real.log (q_loc_f i tid d / (p_T_loc i tid * q_D_loc i d))
                = ∑ d : Fin (N_D_f i), ∑ tid : Fin N_T,
                    (∑ m : Fin M_sub, Q_raw (⟨i, d⟩, m) tid) *
                      Real.log (q_loc_f i tid d / (p_T_loc i tid * q_D_loc i d)) := by
                    refine Finset.sum_congr rfl (fun d _ => ?_)
                    rw [Finset.sum_comm]
                    refine Finset.sum_congr rfl (fun tid _ => (Finset.sum_mul _ _ _).symm)
              _ = ∑ tid : Fin N_T, p_J_fn ((e_J i).1) * ∑ d : Fin (N_D_f i),
                    q_loc_f i tid d *
                      Real.log (q_loc_f i tid d / (p_T_loc i tid * q_D_loc i d)) := by
                    rw [Finset.sum_comm]
                    refine Finset.sum_congr rfl (fun tid _ => ?_)
                    rw [Finset.mul_sum]
                    refine Finset.sum_congr rfl (fun d _ => ?_)
                    have h_m : (∑ m : Fin M_sub, Q_raw (⟨i, d⟩, m) tid) =
                        p_J_fn ((e_J i).1) * q_loc_f i tid d := by
                      dsimp only [Q_raw]; simp
                    rw [h_m, mul_assoc]
          rw [h_lhs]
          field_simp [hell_ne]
        have h_sum3 : (∑ i : Fin S_J.card, ∑ d : Fin (N_D_f i), ∑ m : Fin M_sub, ∑ tid : Fin N_T,
              Q_raw (⟨i, d⟩, m) tid *
                Real.log ((p_J_fn ((e_J i).1) * q_D_loc i d) / Q_D_raw (⟨i, d⟩, m))) ≤
            Real.log (M_sub : ℝ) := by
          have h_id_bound : ∀ (i : Fin S_J.card) (d : Fin (N_D_f i)),
              (∑ m : Fin M_sub, ∑ tid : Fin N_T,
                Q_raw (⟨i, d⟩, m) tid *
                  Real.log ((p_J_fn ((e_J i).1) * q_D_loc i d) / Q_D_raw (⟨i, d⟩, m))) ≤
                (p_J_fn ((e_J i).1) * q_D_loc i d) * Real.log (M_sub : ℝ) := by
            intro i d
            simp_rw [← Finset.sum_mul]
            let S_id : ℝ := p_J_fn ((e_J i).1) * q_D_loc i d
            change (∑ m : Fin M_sub, Q_D_raw (⟨i, d⟩, m) *
              Real.log (S_id / Q_D_raw (⟨i, d⟩, m))) ≤ S_id * Real.log (M_sub : ℝ)
            have hSid_eq : ∑ m : Fin M_sub, Q_D_raw (⟨i, d⟩, m) = S_id := hQD_sum_m i d
            have hQD_nn : ∀ m : Fin M_sub, 0 ≤ Q_D_raw (⟨i, d⟩, m) := fun m =>
              Finset.sum_nonneg (fun tid _ => by
                dsimp only [Q_raw]; split_ifs
                · exact mul_nonneg (hpJ_nn _) ((h_opt i).2.1 tid d)
                · exact le_rfl)
            have hSid_nn : 0 ≤ S_id := by rw [← hSid_eq]; exact Finset.sum_nonneg (fun m _ => hQD_nn m)
            rcases eq_or_lt_of_le hSid_nn with hS0 | hSid_pos
            · have hall0 : ∀ m : Fin M_sub, Q_D_raw (⟨i, d⟩, m) = 0 := by
                intro m
                have hle : Q_D_raw (⟨i, d⟩, m) ≤ S_id := by
                  rw [← hSid_eq]
                  exact Finset.single_le_sum (fun m' _ => hQD_nn m') (Finset.mem_univ m)
                exact le_antisymm (by linarith) (hQD_nn m)
              simp [← hS0, hall0]
            · have h_diff_le0 : (∑ m : Fin M_sub,
                  (Q_D_raw (⟨i, d⟩, m) * Real.log (S_id / Q_D_raw (⟨i, d⟩, m)) -
                    Q_D_raw (⟨i, d⟩, m) * Real.log (M_sub : ℝ))) ≤ 0 := by
                have h_pt_m : ∀ m : Fin M_sub,
                    Q_D_raw (⟨i, d⟩, m) * Real.log (S_id / Q_D_raw (⟨i, d⟩, m)) -
                      Q_D_raw (⟨i, d⟩, m) * Real.log (M_sub : ℝ) ≤
                      S_id / (M_sub : ℝ) - Q_D_raw (⟨i, d⟩, m) := by
                  intro m
                  rcases eq_or_lt_of_le (hQD_nn m) with hm0 | hm_pos
                  · rw [← hm0]; simp [div_nonneg hSid_pos.le hM_pos.le]
                  · have h_log_comb :
                        Real.log (S_id / Q_D_raw (⟨i, d⟩, m)) - Real.log (M_sub : ℝ) =
                          Real.log (S_id / ((M_sub : ℝ) * Q_D_raw (⟨i, d⟩, m))) := by
                      rw [← Real.log_div (div_pos hSid_pos hm_pos).ne' hM_pos.ne', div_div,
                        mul_comm (Q_D_raw (⟨i, d⟩, m))]
                    have hlog := Real.log_le_sub_one_of_pos
                      (div_pos hSid_pos (mul_pos hM_pos hm_pos))
                    have hm_mul := mul_le_mul_of_nonneg_left hlog hm_pos.le
                    have hcanc : Q_D_raw (⟨i, d⟩, m) *
                        (S_id / ((M_sub : ℝ) * Q_D_raw (⟨i, d⟩, m)) - 1) =
                        S_id / (M_sub : ℝ) - Q_D_raw (⟨i, d⟩, m) := by
                      field_simp [hM_pos.ne', hm_pos.ne']
                    have h_sub_m : Q_D_raw (⟨i, d⟩, m) * Real.log (S_id / Q_D_raw (⟨i, d⟩, m)) -
                        Q_D_raw (⟨i, d⟩, m) * Real.log (M_sub : ℝ) =
                        Q_D_raw (⟨i, d⟩, m) *
                          Real.log (S_id / ((M_sub : ℝ) * Q_D_raw (⟨i, d⟩, m))) := by
                      rw [← mul_sub, h_log_comb]
                    linarith
                calc ∑ m : Fin M_sub,
                      (Q_D_raw (⟨i, d⟩, m) * Real.log (S_id / Q_D_raw (⟨i, d⟩, m)) -
                        Q_D_raw (⟨i, d⟩, m) * Real.log (M_sub : ℝ))
                    ≤ ∑ m : Fin M_sub, (S_id / (M_sub : ℝ) - Q_D_raw (⟨i, d⟩, m)) :=
                      Finset.sum_le_sum (fun m _ => h_pt_m m)
                  _ = (M_sub : ℝ) * (S_id / (M_sub : ℝ)) - S_id := by
                      rw [Finset.sum_sub_distrib, hSid_eq]
                      simp
                  _ = 0 := by rw [mul_div_cancel₀ _ hM_pos.ne', sub_self]
              rw [Finset.sum_sub_distrib, ← Finset.sum_mul, hSid_eq] at h_diff_le0
              linarith
          calc ∑ i : Fin S_J.card, ∑ d : Fin (N_D_f i), ∑ m : Fin M_sub, ∑ tid : Fin N_T,
                Q_raw (⟨i, d⟩, m) tid *
                  Real.log ((p_J_fn ((e_J i).1) * q_D_loc i d) / Q_D_raw (⟨i, d⟩, m))
              ≤ ∑ i : Fin S_J.card, ∑ d : Fin (N_D_f i),
                  (p_J_fn ((e_J i).1) * q_D_loc i d) * Real.log (M_sub : ℝ) :=
                Finset.sum_le_sum (fun i _ => Finset.sum_le_sum (fun d _ => h_id_bound i d))
            _ = (∑ i : Fin S_J.card, p_J_fn ((e_J i).1) * (∑ d : Fin (N_D_f i), q_D_loc i d)) *
                  Real.log (M_sub : ℝ) := by
                rw [Finset.sum_mul]
                refine Finset.sum_congr rfl (fun i _ => ?_)
                rw [← Finset.sum_mul, ← Finset.mul_sum]
            _ = Real.log (M_sub : ℝ) := by
                simp_rw [hqD_loc_sum, mul_one]
                rw [h_sum_eJ p_J_fn, hpJ_sum, one_mul]
        have h_split_all : ell * ITD_glob_val =
            ell * H_J + (ell * ∑ i : Fin S_J.card, p_J_fn ((e_J i).1) * ITD_loc_fn i) +
              ∑ i : Fin S_J.card, ∑ d : Fin (N_D_f i), ∑ m : Fin M_sub, ∑ tid : Fin N_T,
                Q_raw (⟨i, d⟩, m) tid *
                  Real.log ((p_J_fn ((e_J i).1) * q_D_loc i d) / Q_D_raw (⟨i, d⟩, m)) := by
          rw [h_raw_sum, ← h_sum1, ← h_sum2]
          simp_rw [h_term_split, Finset.sum_add_distrib]
        have h_ell_ub : ell * ITD_glob_val ≤
            ell * (H_J + (∑ i : Fin S_J.card, p_J_fn ((e_J i).1) * ITD_loc_fn i) +
              Real.log (M_sub : ℝ) / ell) := by
          have h_rhs : ell * (H_J + (∑ i : Fin S_J.card, p_J_fn ((e_J i).1) * ITD_loc_fn i) +
              Real.log (M_sub : ℝ) / ell) =
              ell * H_J + (ell * ∑ i : Fin S_J.card, p_J_fn ((e_J i).1) * ITD_loc_fn i) +
                Real.log (M_sub : ℝ) := by
            rw [mul_add, mul_add, mul_div_cancel₀ _ hell_ne]
          linarith
        exact le_of_mul_le_mul_left h_ell_ub hell_pos
      have h_glob_mem : Ew_glob_val - ITD_glob_val ≤
          classicalRootSupremum ε L_glob γ N_ω N_T π T_idx V_part A_part := by
        refine le_csSup h_glob_bdd ?_
        exact ⟨N_glob, b_glob, a_glob, e_glob, V_glob, A_glob, Q_glob,
          hQ_ba, hQ_nn, hQ_sum_tid, hQ_geom, rfl⟩
      have h_opt_avg :
          (∑ j ∈ S_J, p_J_fn j *
            classicalRootSupremum ε L_loc γ N_ω N_T (π_j_fn j) T_idx
              (V_loc_part j) (A_loc_part j)) - δ ≤
          ∑ i : Fin S_J.card, p_J_fn ((e_J i).1) * (Ew_loc_fn i - ITD_loc_fn i) := by
        rw [← h_sum_eJ (fun j => p_J_fn j *
          classicalRootSupremum ε L_loc γ N_ω N_T (π_j_fn j) T_idx
            (V_loc_part j) (A_loc_part j))]
        have h_δ_sum : δ = ∑ i : Fin S_J.card, p_J_fn ((e_J i).1) * δ := by
          rw [← Finset.sum_mul, h_sum_eJ p_J_fn, hpJ_sum, one_mul]
        rw [h_δ_sum, ← Finset.sum_sub_distrib]
        refine Finset.sum_le_sum (fun i _ => ?_)
        rw [← mul_sub]
        exact mul_le_mul_of_nonneg_left ((h_opt i).2.2.2.2).le (hpJ_nn _)
      have h_sub_sum : (∑ i : Fin S_J.card, p_J_fn ((e_J i).1) * (Ew_loc_fn i - ITD_loc_fn i)) =
          (∑ i : Fin S_J.card, p_J_fn ((e_J i).1) * Ew_loc_fn i) -
          (∑ i : Fin S_J.card, p_J_fn ((e_J i).1) * ITD_loc_fn i) := by
        rw [← Finset.sum_sub_distrib]
        refine Finset.sum_congr rfl (fun i _ => mul_sub _ _ _)
      linarith [hEw_lb, hITD_ub, h_glob_mem, h_opt_avg, h_sub_sum]
    let Φ : α_J → ℝ := fun j =>
      (-finMutualInfo ε (π_j_fn j) T_idx (G_loc j) +
