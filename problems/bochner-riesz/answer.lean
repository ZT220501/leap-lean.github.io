        rw [h_id]
        have hsc := abs_le.mp h_sc_bd
        have hRa_eq : (R_ang : ℝ) = (N_ang : ℝ) + 1 := by dsimp only [R_ang]; push_cast; rfl
        rw [hRa_eq]
        exact abs_le.mpr ⟨by linarith, by linarith⟩
      have h_in_s : kang₂ ∈ I_ang s := by
        have h_bds := abs_le.mp h_int_r
