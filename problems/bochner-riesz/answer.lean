          fin_cases j <;> simp [d3]
        have hE_pos3 : ∀ j k : Fin 3, E3 j k → 0 < c3 k - c3 j := by
          intro j k hjk
          fin_cases j <;> fin_cases k <;> simp [E3, c3] at hjk ⊢ <;> norm_num
        have h_cone34 : ∀ (L : Fin 3 → ℝ) (v : ℝ),
            InResolutionCone 3 c3 E3 (L, v) →
            InResolutionCone 4 c4_1 E_cone4 (embed34 L, v) := by
          intro L v ⟨hv, hL⟩
          refine ⟨hv, fun j k hE => ?_⟩
          have h01 := hL 0 1 (by decide)
          have h12 := hL 1 2 (by decide)
          rcases hE with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ <;>
            simp [embed34, c4_1, c3, hm1] at h01 h12 ⊢ <;> linarith
        have h_cone_mid : ∀ (L : Fin 3 → ℝ) (v h : ℝ),
            0 ≤ h →
            InResolutionCone 3 c3 E3 (L, v) →
            InResolutionCone 3 c3 E3 (Function.update L 1 (L 1 + h), v) →
            InResolutionCone 4 c4_1 E_cone4 (Function.update (embed34 L) 1 (L 1 + h), v) := by
          intro L v h hh ⟨hv, hL⟩ ⟨_, hLh⟩
          refine ⟨hv, fun j k hE => ?_⟩
          have h01 := hL 0 1 (by decide)
          have h12 := hL 1 2 (by decide)
          have h01_h := hLh 0 1 (by decide)
          rcases hE with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ <;>
            simp [embed34, c4_1, c3, hm1, Function.update] at h01 h12 h01_h ⊢ <;> linarith
        have h_upd0 : ∀ (L : Fin 3 → ℝ) (t : ℝ),
