    have h_rhs_eq : ρ_l ^ (-κ_l) * ρ_tilde ^ (-a_pt 2) = ρ_tilde ^ (-(κ_l / t) + -a_pt 2) := by
      rw [hρ_neg_κ_eq, ← Real.rpow_add hρ_t_pos]
    rw [h_rhs_eq] at h_res
    have h_exp_lt : -χ₁ + α₁ / 2 < -(κ_l / t) + -a_pt 2 := by
