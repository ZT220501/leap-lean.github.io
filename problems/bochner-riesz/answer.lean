          have hρ_ne : ρ_t ≠ 0 := hρ_t_pos.ne'
          rw [← mul_assoc, mul_div_mul_right _ _ hρ_ne, div_eq_mul_inv, ← Real.rpow_neg hε₀.le]
        rw [h_divR_r, h_divD_r] at hJ_cnt
        have hJ_f1 : 2 * (C_cov * ε ^ (-h)) + 3 ≤ 4 * C_cov * ε ^ (-h) := by
