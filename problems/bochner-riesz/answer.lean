        rw [hu_supp t ht, mul_zero]
      have hdh_sm : ∀ k : ℕ, ContDiff ℝ k (deriv h) := fun k => (hh_sm (k + 1)).deriv'
      have hdh_supp : ∀ t₀ : ℝ, R_w < |t₀| → deriv h t₀ = 0 := by
