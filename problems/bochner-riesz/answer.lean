          refine Finset.sum_congr rfl (fun ω hω => ?_)
          have hx_mem : X ω ∈ A_X := Finset.mem_image_of_mem X hω
          have hy_ivl := h_ivl ω (Finset.mem_filter.mp hω).2
          have hy_mem : Y ω ∈ I_x (X ω) := Finset.mem_Ico.mpr hy_ivl
