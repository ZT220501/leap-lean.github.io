    have h_abv_u : ε ^ (a + u) ≤ ε ^ ((b + v) + u) :=
      Real.rpow_le_rpow_of_exponent_ge hε₀ (by linarith) (by linarith)
    have h_c1_mem : dyadicRealBin ε b (inner ℝ V e_c) ∈
