            rw [h1]
            field_simp [hpcD_pos.ne', hqlaw_pos.ne']
          rw [h_rat, Real.log_mul (div_pos hqlaw_pos hpcD_pos).ne' (div_pos hW_pos hqlaw_pos).ne']
