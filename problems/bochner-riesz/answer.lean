              Finset.sum_congr rfl (fun _ _ => Finset.sum_comm)
          _ = ∑ α : Fin N_T, ∑ z : Fin N_Z, ∑ d : Fin N_D, -(q z d α * Real.log (q z d α / p_D d)) :=
              Finset.sum_comm
          _ = ∑ α : Fin N_T, ∑ d : Fin N_D, ∑ z : Fin N_Z, -(q z d α * Real.log (q z d α / p_D d)) :=
