        rw [abs_mul, abs_of_nonneg hc0, h_id_eq]
        have h_sum_abs : |t * iteratedDeriv m (f_vec e) t + (m : ℝ) * iteratedDeriv k (f_vec e) t| ≤
            4 * A ^ (m + 1) * ((m.factorial : ℝ) ^ 3) +
              (m : ℝ) * A ^ m * (((m - 1).factorial : ℝ) ^ 3) := by
          calc |t * iteratedDeriv m (f_vec e) t + (m : ℝ) * iteratedDeriv k (f_vec e) t|
