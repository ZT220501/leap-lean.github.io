        rw [h0, ← mul_assoc, mul_inv_cancel₀ hv₀₁_pos.ne', one_mul]
      have hv₀₁_1 : θ₁.2 - θ₀.2 = α₀₁ * d 1 := by
        have h1 : d 1 = α₀₁⁻¹ * (θ₁.2 - θ₀.2) := by rw [hd_eq]; simp [v₀₁]
