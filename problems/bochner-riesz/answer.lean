          have hπ₀_pos : 0 < π₂ idx₀ b₀ := lt_of_le_of_ne (hπ₂_nn idx₀ b₀) (Ne.symm hidx₀_ne)
          obtain ⟨hH₀, hp0₂_pos⟩ := hπ₂_supp idx₀ b₀ hπ₀_pos
