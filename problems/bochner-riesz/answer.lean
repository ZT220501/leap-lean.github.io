    have h_cs_par : ∀ u_vec : EuclideanSpace ℝ (Fin 2), ‖u_vec‖ = 1 →
        ∀ w : EuclideanSpace ℝ (Fin 2),
          |inner ℝ w u_vec| ≤ |inner ℝ w e₀| + |inner ℝ w (perp2D e₀)| := by
      intro u_vec hu_vec w
