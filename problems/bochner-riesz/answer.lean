        _ = g₀ ^ 2 + g₁ ^ 2 := by rw [heD_sq]; ring
    have ht_sq_le : t₂ ^ 2 ≤ t₁ ^ 2 := pow_le_pow_left₀ ht₂_pos.le ht₂_le_t₁ 2
    dsimp only [Q_fn]
    rw [hm1_e, hm2_e]
    calc (t₁ * (e_D 0 * g₀ + e_D 1 * g₁)) ^ 2 + (t₂ * (-(e_D 1) * g₀ + e_D 0 * g₁)) ^ 2
