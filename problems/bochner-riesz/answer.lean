        ((hE 2).contDiffAt.isSymmSndFDerivAt (by simp)).eq (0, 1) (1, 0)
      rw [h_s_deriv, ← h_symm]
      exact h_u_deriv
    let F₁ : ℝ × ℝ → ℝ := fun p => deriv (fun y' => F (y', p.2)) p.1
    obtain ⟨hF₁_cd, hF₁_comm⟩ := h_clairaut_gen F hF_cd
    have hθ_deriv_eq : ∀ y : ℝ, deriv θ_pos y = F₁ (y, 1) - F₁ (y, 0) := by
