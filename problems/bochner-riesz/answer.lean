    exact abs_le.mpr ⟨h_dn, h_up⟩

  
  have stepD_schur :
      ∀ (s M_fib K₀ : ℝ), 0 < s → 0 ≤ M_fib → 0 ≤ K₀ →
      ∀ (V_P τ : EuclideanSpace ℝ (Fin 2))
        (N_Q : ℕ) (V_T : Fin N_Q → EuclideanSpace ℝ (Fin 2))
        (c_T : Fin N_Q → ℂ) (W : Finset (Fin N_Q))
        (M_ker : Fin N_Q → Fin N_Q → ℝ),
        (letI := Classical.propDecidable
         ∀ m : ℤ,
           ((W.filter (fun T => Int.floor (inner ℝ (V_T T - V_P) τ / s) = m)).card : ℝ) ≤ M_fib) →
        (∀ T₁ ∈ W, ∀ T₂ ∈ W,
          M_ker T₁ T₂ ≤ K₀ / (1 + |inner ℝ (V_T T₁ - V_T T₂) τ| / s) ^ 4) →
