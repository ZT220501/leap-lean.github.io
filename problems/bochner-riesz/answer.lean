      calc ∑ k₂ ∈ K₂, ∑ o ∈ S_obs, m_set o (F₂ k₂)
          ≤ ∑ k₂ ∈ K₂, (C_sub_bes * ∑ α ∈ F₂ k₂, ‖sub.c_at α‖ ^ 2) :=
            Finset.sum_le_sum (fun k₂ _ => h_bessel (F₂ k₂))
        _ = C_sub_bes * ∑ k₂ ∈ K₂, ∑ α ∈ F₂ k₂, ‖sub.c_at α‖ ^ 2 := (Finset.mul_sum _ _ _).symm
        _ = C_sub_bes * ∑ α ∈ T_P, ‖sub.c_at α‖ ^ 2 := by
            rw [← Finset.sum_biUnion hF₂_disj, hF₂_union]
        _ ≤ C_sub_bes * (w_max * (T_P.card : ℝ)) :=
