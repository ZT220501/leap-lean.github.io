          (∑ ω ∈ F_pos, π ω * (-Real.log (finProbAt2 π X Y ω / finProbAt π X ω))) -
            Real.log M_cap := by
        have h1 : ∀ ω ∈ F_pos,
            π ω * (-Real.log (finProbAt2 π X Y ω / finProbAt π X ω) - Real.log M_cap) =
              π ω * (-Real.log (finProbAt2 π X Y ω / finProbAt π X ω)) -
                π ω * Real.log M_cap := fun ω _ => by ring
        rw [Finset.sum_congr rfl h1, Finset.sum_sub_distrib, ← Finset.sum_mul, h_sum_Fpos, one_mul]
      have h_rhs : ∑ ω ∈ F_pos,
            ((π ω * (finProbAt π X ω / finProbAt2 π X Y ω)) / M_cap - π ω) ≤ 0 := by
        rw [Finset.sum_sub_distrib, ← Finset.sum_div, h_sum_Fpos]
        have h1 : (∑ ω ∈ F_pos, π ω * (finProbAt π X ω / finProbAt2 π X Y ω)) / M_cap ≤ 1 :=
          (div_le_one hM_pos).mpr h_ratio_sum
        linarith
      linarith
    · intro τ hτ
      have h_restrict : (∑ ω : Fin N_ω,
            if finProbAt2 π X Y ω < τ * finProbAt π X ω then π ω else 0) =
          ∑ ω ∈ F_pos, if finProbAt2 π X Y ω < τ * finProbAt π X ω then π ω else 0 := by
        symm
        refine Finset.sum_subset (Finset.subset_univ F_pos) (fun ω _ hω => ?_)
        rw [Finset.mem_filter] at hω
        have h0 : π ω = 0 :=
          le_antisymm (not_lt.mp fun h => hω ⟨Finset.mem_univ ω, h⟩) (hπ_nn ω)
        simp [h0]
      rw [h_restrict, ← Finset.sum_fiberwise_of_maps_to (t := F_pos.image X)
        (fun ω hω => Finset.mem_image_of_mem X hω)]
      calc ∑ x ∈ F_pos.image X,
            ∑ ω ∈ F_pos.filter (fun ω => X ω = x),
              (if finProbAt2 π X Y ω < τ * finProbAt π X ω then π ω else 0)
          ≤ ∑ x ∈ F_pos.image X,
              (M_cap * τ) * (∑ ω ∈ F_pos.filter (fun ω => X ω = x), π ω) := by
            refine Finset.sum_le_sum (fun x hx => ?_)
            obtain ⟨ω_x, hω_x_mem, hω_x_eq⟩ := Finset.mem_image.mp hx
            have hω_x_pos : 0 < π ω_x := (Finset.mem_filter.mp hω_x_mem).2
            have hcard_x : ((S_fib x).card : ℝ) ≤ M_cap := by
              rw [← hω_x_eq]
              exact h_card ω_x hω_x_pos
            let F_x := F_pos.filter (fun ω => X ω = x)
            let p_x := ∑ ω ∈ F_x, π ω
            have hp_x_nn : 0 ≤ p_x := Finset.sum_nonneg (fun ω _ => hπ_nn ω)
            rw [← Finset.sum_fiberwise_of_maps_to (s := F_x) (t := S_fib x)
              (fun ω hω => by
                have h1 := Finset.mem_filter.mp hω
                rw [← h1.2]
                exact h_mem ω (Finset.mem_filter.mp h1.1).2)]
            calc ∑ y ∈ S_fib x, ∑ ω ∈ F_x.filter (fun ω => Y ω = y),
                  (if finProbAt2 π X Y ω < τ * finProbAt π X ω then π ω else 0)
                ≤ ∑ _y ∈ S_fib x, τ * p_x := by
                  refine Finset.sum_le_sum (fun y _ => ?_)
                  let F_xy := F_x.filter (fun ω => Y ω = y)
                  change ∑ ω ∈ F_xy,
                    (if finProbAt2 π X Y ω < τ * finProbAt π X ω then π ω else 0) ≤ τ * p_x
                  by_cases hex : ∃ ω₀ ∈ F_xy, finProbAt2 π X Y ω₀ < τ * finProbAt π X ω₀
                  · obtain ⟨ω₀, hω₀, hlt₀⟩ := hex
                    have h1 := Finset.mem_filter.mp hω₀
                    have h2 := Finset.mem_filter.mp h1.1
                    rw [h_Fx_eq x ω₀ h2.2, h_Fxy_eq x y ω₀ h2.2 h1.2] at hlt₀
                    calc ∑ ω ∈ F_xy,
                          (if finProbAt2 π X Y ω < τ * finProbAt π X ω then π ω else 0)
                        ≤ ∑ ω ∈ F_xy, π ω :=
                          Finset.sum_le_sum (fun ω _ => by
                            split_ifs <;> [exact le_rfl; exact hπ_nn ω])
                      _ ≤ τ * p_x := hlt₀.le
                  · push_neg at hex
                    have h_zero : ∑ ω ∈ F_xy,
                        (if finProbAt2 π X Y ω < τ * finProbAt π X ω then π ω else 0) = 0 :=
                      Finset.sum_eq_zero (fun ω hω => if_neg (not_lt.mpr (hex ω hω)))
                    rw [h_zero]
                    exact mul_nonneg hτ hp_x_nn
              _ = ((S_fib x).card : ℝ) * (τ * p_x) := by simp [Finset.sum_const, nsmul_eq_mul]
              _ ≤ M_cap * (τ * p_x) := mul_le_mul_of_nonneg_right hcard_x (mul_nonneg hτ hp_x_nn)
              _ = (M_cap * τ) * p_x := by ring
        _ = (M_cap * τ) * ∑ x ∈ F_pos.image X, ∑ ω ∈ F_pos.filter (fun ω => X ω = x), π ω :=
            (Finset.mul_sum _ _ _).symm
        _ = (M_cap * τ) * ∑ ω ∈ F_pos, π ω := by
            rw [Finset.sum_fiberwise_of_maps_to (fun ω hω => Finset.mem_image_of_mem X hω)]
        _ = M_cap * τ := by rw [h_sum_Fpos, mul_one]

  have h_univ_ent : ∀ (ε : ℝ), 0 < ε → ε < 1 / 2 →
      ∀ {N_ω : ℕ} {α β : Type} [DecidableEq β] (π : Fin N_ω → ℝ)
        (X : Fin N_ω → α) (Y : Fin N_ω → β)
        (S_fib : α → Finset β) (M_cap : ℝ),
        (∀ ω, 0 ≤ π ω) → (∑ ω : Fin N_ω, π ω = 1) →
        0 < M_cap →
        (∀ ω, 0 < π ω → Y ω ∈ S_fib (X ω)) →
        (∀ ω, 0 < π ω → ((S_fib (X ω)).card : ℝ) ≤ M_cap) →
        finCondEntropy ε π X Y ≤ Real.log M_cap / Real.log (ε⁻¹) :=
    fun ε hε₀ hε₁ _ _ _ _ π X Y S_fib M_cap hπ_nn hπ_sum hM h_mem h_card =>
      (h_univ_fib ε hε₀ hε₁ π X Y S_fib M_cap hπ_nn hπ_sum hM h_mem h_card).1

  have h_s3 : ∀ (ε : ℝ), 0 < ε → ε < 1 / 2 →
      ∀ {N_ω N_T : ℕ} (π : Fin N_ω → ℝ) (T_idx : Fin N_ω → Fin N_T) (c_s : Fin N_ω → ℝ),
        (∀ ω, 0 ≤ π ω) →
        (∑ ω : Fin N_ω, π ω = 1) →
        (∀ ω, 0 < π ω → c_s ω ∈ Set.Icc (0 : ℝ) 1) →
        (finCondEntropy ε π T_idx (fun ω => dyadicTimeBin ε 0 (c_s ω)) = 0 ∧
          ∀ ω, 0 < π ω →
            condSurprise ε π T_idx (fun ω' => dyadicTimeBin ε 0 (c_s ω')) ω = 0) ∧
        (∀ (r q : ℝ), 0 ≤ r → r ≤ q →
          (∀ ω, 0 < π ω →
            condSurprise ε π (fun ω' => (T_idx ω', dyadicTimeBin ε r (c_s ω')))
                (fun ω' => dyadicTimeBin ε q (c_s ω')) ω =
              condSurprise ε π T_idx (fun ω' => dyadicTimeBin ε q (c_s ω')) ω -
                condSurprise ε π T_idx (fun ω' => dyadicTimeBin ε r (c_s ω')) ω) ∧
          0 ≤ finCondEntropy ε π T_idx (fun ω => dyadicTimeBin ε q (c_s ω)) -
                finCondEntropy ε π T_idx (fun ω => dyadicTimeBin ε r (c_s ω)) ∧
          finCondEntropy ε π T_idx (fun ω => dyadicTimeBin ε q (c_s ω)) -
            finCondEntropy ε π T_idx (fun ω => dyadicTimeBin ε r (c_s ω)) ≤
              (q - r) + Real.log 4 / Real.log (ε⁻¹)) ∧
        (∀ (r q ν : ℝ), 0 ≤ r → r ≤ q → 0 < ν →
          (∑ ω : Fin N_ω,
            if (q - r) + ν + Real.log 4 / Real.log (ε⁻¹) <
              |condSurprise ε π T_idx (fun ω' => dyadicTimeBin ε q (c_s ω')) ω -
                condSurprise ε π T_idx (fun ω' => dyadicTimeBin ε r (c_s ω')) ω|
            then π ω else 0) ≤ ε ^ ν) := by
    clear γ m hγ₀ hγ₁ hm h_two
    intro ε hε₀ hε₁ N_ω N_T π T_idx c_s hπ_nn hπ_sum hc_mem
    have h_ell_pos : 0 < Real.log (ε⁻¹) := (h_dyad_pow ε hε₀ hε₁).2.1
    have h_bin0 : ∀ c ∈ Set.Icc (0 : ℝ) 1, dyadicTimeBin ε 0 c = 0 := by
      intro c hc
      have hm0 : dyadicTimeLevel ε 0 = 0 := by
        simp [dyadicTimeLevel]
      unfold dyadicTimeBin
      rw [hm0]
      simp only [pow_zero, mul_one, sub_self]
      exact min_eq_right (Int.floor_nonneg.mpr hc.1)
    have h_part1_surp : ∀ ω, 0 < π ω →
        condSurprise ε π T_idx (fun ω' => dyadicTimeBin ε 0 (c_s ω')) ω = 0 := by
      intro ω hω
      have hp1_pos : 0 < finProbAt π T_idx ω :=
        ((h_prob_pos ε hε₀ hε₁ π T_idx (fun ω' => dyadicTimeBin ε 0 (c_s ω')) hπ_nn hπ_sum).1 ω hω).2.2.1
      have hp_eq : finProbAt2 π T_idx (fun ω' => dyadicTimeBin ε 0 (c_s ω')) ω =
          finProbAt π T_idx ω := by
        unfold finProbAt2 finProbAt
        refine Finset.sum_congr rfl (fun ω' _ => ?_)
        by_cases hω' : 0 < π ω'
        · have hb' := h_bin0 (c_s ω') (hc_mem ω' hω')
          have hb := h_bin0 (c_s ω) (hc_mem ω hω)
          by_cases hT : T_idx ω' = T_idx ω
          · rw [if_pos ⟨hT, hb'.trans hb.symm⟩, if_pos hT]
          · rw [if_neg (fun h => hT h.1), if_neg hT]
        · have h0 : π ω' = 0 := le_antisymm (not_lt.mp hω') (hπ_nn ω')
          simp [h0]
      unfold condSurprise
      rw [hp_eq, div_self hp1_pos.ne', Real.log_one]
      ring
    have h_part1_ent : finCondEntropy ε π T_idx (fun ω => dyadicTimeBin ε 0 (c_s ω)) = 0 := by
      unfold finCondEntropy
      refine Finset.sum_eq_zero (fun ω _ => ?_)
      by_cases hω : 0 < π ω
      · rw [h_part1_surp ω hω, mul_zero]
      · have h0 : π ω = 0 := le_antisymm (not_lt.mp hω) (hπ_nn ω)
        simp [h0]
    have h_nest : ∀ (r q : ℝ), 0 ≤ r → r ≤ q →
        let m_r := dyadicTimeLevel ε r
        let m_q := dyadicTimeLevel ε q
        m_r ≤ m_q ∧
        (∀ c ∈ Set.Icc (0 : ℝ) 1,
          let K : ℤ := (2 : ℤ) ^ (m_q - m_r)
          dyadicTimeBin ε r c * K ≤ dyadicTimeBin ε q c ∧
          dyadicTimeBin ε q c < (dyadicTimeBin ε r c + 1) * K) ∧
        ((2 : ℝ) ^ (m_q - m_r) < 4 * ε ^ (-(q - r))) := by
      intro r q hr hle
      have hq : 0 ≤ q := le_trans hr hle
      have hε_le1 : ε ≤ 1 := by linarith
      let m_r := dyadicTimeLevel ε r
      let m_q := dyadicTimeLevel ε q
      have hm_le : m_r ≤ m_q := by
        dsimp [m_r, m_q, dyadicTimeLevel]
        exact Nat.clog_mono_right 2 (Nat.ceil_mono
          (Real.rpow_le_rpow_of_exponent_ge hε₀ hε_le1 (by linarith)))
      have h_pow_r := (h_dyad_pow ε hε₀ hε₁).2.2 r hr
      have h_pow_q := (h_dyad_pow ε hε₀ hε₁).2.2 q hq
      have h_diff_pow : (2 : ℝ) ^ (m_q - m_r) < 4 * ε ^ (-(q - r)) := by
        have h_mul_pow : (2 : ℝ) ^ (m_q - m_r) * (2 : ℝ) ^ m_r = (2 : ℝ) ^ m_q := by
          rw [← pow_add, Nat.sub_add_cancel hm_le]
        have h_pos_r : (0 : ℝ) < (2 : ℝ) ^ m_r := by positivity
        have h_div : (2 : ℝ) ^ (m_q - m_r) = (2 : ℝ) ^ m_q / (2 : ℝ) ^ m_r := by
          rw [← h_mul_pow, mul_div_cancel_right₀ _ h_pos_r.ne']
        rw [h_div]
        calc (2 : ℝ) ^ m_q / (2 : ℝ) ^ m_r
            < (4 * ε ^ (-q)) / (2 : ℝ) ^ m_r :=
              div_lt_div_of_pos_right h_pow_q.2 h_pos_r
          _ ≤ (4 * ε ^ (-q)) / (ε ^ (-r)) :=
              div_le_div_of_nonneg_left (by positivity) (by positivity) h_pow_r.1
          _ = 4 * (ε ^ (-q) / ε ^ (-r)) := by ring
          _ = 4 * ε ^ (-(q - r)) := by
              rw [← Real.rpow_sub hε₀]
              ring_nf
      refine ⟨hm_le, ?_, h_diff_pow⟩
      intro c hc K
      have hK_pos : (0 : ℤ) < K := by positivity
      have hK_real_pos : (0 : ℝ) < (K : ℝ) := by exact_mod_cast hK_pos
      have h_pow_int : (2 ^ m_q : ℤ) = (2 ^ m_r : ℤ) * K := by
        dsimp [K, m_r, m_q]
        rw [← pow_add, Nat.add_sub_of_le hm_le]
      have h_pow_real : (2 : ℝ) ^ m_q = (2 : ℝ) ^ m_r * (K : ℝ) := by
        dsimp [K, m_r, m_q]
        push_cast
        rw [← pow_add, Nat.add_sub_of_le hm_le]
      rcases eq_or_lt_of_le hc.2 with rfl | hc_lt1
      · have hbr : dyadicTimeBin ε r 1 = (2 ^ m_r : ℤ) - 1 := by
          unfold dyadicTimeBin
          change min ⌊(1 : ℝ) * (2 : ℝ) ^ m_r⌋ ((2 ^ m_r : ℤ) - 1) = (2 ^ m_r : ℤ) - 1
          have hfl : ⌊(1 : ℝ) * (2 : ℝ) ^ m_r⌋ = (2 ^ m_r : ℤ) := by
            rw [one_mul]
            exact_mod_cast Int.floor_intCast (2 ^ m_r : ℤ)
          rw [hfl]
          omega
        have hbq : dyadicTimeBin ε q 1 = (2 ^ m_q : ℤ) - 1 := by
          unfold dyadicTimeBin
          change min ⌊(1 : ℝ) * (2 : ℝ) ^ m_q⌋ ((2 ^ m_q : ℤ) - 1) = (2 ^ m_q : ℤ) - 1
          have hfl : ⌊(1 : ℝ) * (2 : ℝ) ^ m_q⌋ = (2 ^ m_q : ℤ) := by
            rw [one_mul]
            exact_mod_cast Int.floor_intCast (2 ^ m_q : ℤ)
          rw [hfl]
          omega
        rw [hbr, hbq, h_pow_int]
        constructor <;> nlinarith
      · have hbr : dyadicTimeBin ε r c = ⌊c * (2 : ℝ) ^ m_r⌋ := by
          unfold dyadicTimeBin
          change min ⌊c * (2 : ℝ) ^ m_r⌋ ((2 ^ m_r : ℤ) - 1) = ⌊c * (2 : ℝ) ^ m_r⌋
          have hlt : ⌊c * (2 : ℝ) ^ m_r⌋ < (2 ^ m_r : ℤ) := by
            rw [Int.floor_lt]
            push_cast
            nlinarith [show (0 : ℝ) < (2 : ℝ) ^ m_r by positivity]
          exact min_eq_left (by omega)
        have hbq : dyadicTimeBin ε q c = ⌊c * (2 : ℝ) ^ m_q⌋ := by
          unfold dyadicTimeBin
          change min ⌊c * (2 : ℝ) ^ m_q⌋ ((2 ^ m_q : ℤ) - 1) = ⌊c * (2 : ℝ) ^ m_q⌋
          have hlt : ⌊c * (2 : ℝ) ^ m_q⌋ < (2 ^ m_q : ℤ) := by
            rw [Int.floor_lt]
            push_cast
            nlinarith [show (0 : ℝ) < (2 : ℝ) ^ m_q by positivity]
          exact min_eq_left (by omega)
        rw [hbr, hbq, h_pow_real]
        let kr := ⌊c * (2 : ℝ) ^ m_r⌋
        have hkr_le : (kr : ℝ) ≤ c * (2 : ℝ) ^ m_r := Int.floor_le _
        have hkr_lt : c * (2 : ℝ) ^ m_r < (kr : ℝ) + 1 := Int.lt_floor_add_one _
        constructor
        · rw [Int.le_floor]
          push_cast
          calc (kr : ℝ) * (K : ℝ) ≤ (c * (2 : ℝ) ^ m_r) * (K : ℝ) :=
                mul_le_mul_of_nonneg_right hkr_le hK_real_pos.le
            _ = c * ((2 : ℝ) ^ m_r * (K : ℝ)) := by ring
        · rw [Int.floor_lt]
          push_cast
          calc c * ((2 : ℝ) ^ m_r * (K : ℝ)) = (c * (2 : ℝ) ^ m_r) * (K : ℝ) := by ring
            _ < ((kr : ℝ) + 1) * (K : ℝ) := mul_lt_mul_of_pos_right hkr_lt hK_real_pos
    have h_part2 : ∀ (r q : ℝ), 0 ≤ r → r ≤ q →
        (∀ ω, 0 < π ω →
          condSurprise ε π (fun ω' => (T_idx ω', dyadicTimeBin ε r (c_s ω')))
              (fun ω' => dyadicTimeBin ε q (c_s ω')) ω =
            condSurprise ε π T_idx (fun ω' => dyadicTimeBin ε q (c_s ω')) ω -
              condSurprise ε π T_idx (fun ω' => dyadicTimeBin ε r (c_s ω')) ω) ∧
        0 ≤ finCondEntropy ε π T_idx (fun ω => dyadicTimeBin ε q (c_s ω)) -
              finCondEntropy ε π T_idx (fun ω => dyadicTimeBin ε r (c_s ω)) ∧
        finCondEntropy ε π T_idx (fun ω => dyadicTimeBin ε q (c_s ω)) -
          finCondEntropy ε π T_idx (fun ω => dyadicTimeBin ε r (c_s ω)) ≤
            (q - r) + Real.log 4 / Real.log (ε⁻¹) := by
      intro r q hr hle
      obtain ⟨hm_le, h_bin_int, h_pow_diff⟩ := h_nest r q hr hle
      let k_r := fun ω => dyadicTimeBin ε r (c_s ω)
      let k_q := fun ω => dyadicTimeBin ε q (c_s ω)
      let X_r := fun ω => (T_idx ω, k_r ω)
      let K : ℤ := (2 : ℤ) ^ (dyadicTimeLevel ε q - dyadicTimeLevel ε r)
      have hK_pos : (0 : ℤ) < K := by positivity
      have h_det_r : ∀ ω' ω, 0 < π ω' → 0 < π ω → k_q ω' = k_q ω → k_r ω' = k_r ω := by
        intro ω' ω hω' hω hkq
        have hb' := h_bin_int (c_s ω') (hc_mem ω' hω')
        have hb := h_bin_int (c_s ω) (hc_mem ω hω)
        change k_r ω' * K ≤ k_q ω' ∧ k_q ω' < (k_r ω' + 1) * K at hb'
        change k_r ω * K ≤ k_q ω ∧ k_q ω < (k_r ω + 1) * K at hb
        rw [hkq] at hb'
        have h1 : k_r ω' * K < (k_r ω + 1) * K := lt_of_le_of_lt hb'.1 hb.2
        have h2 : k_r ω * K < (k_r ω' + 1) * K := lt_of_le_of_lt hb.1 hb'.2
        nlinarith
      have h_tele : ∀ ω, 0 < π ω →
          condSurprise ε π X_r k_q ω =
            condSurprise ε π T_idx k_q ω - condSurprise ε π T_idx k_r ω := by
        intro ω hω
        have hp_Xr_kq : finProbAt2 π X_r k_q ω = finProbAt2 π T_idx k_q ω := by
          unfold finProbAt2
          refine Finset.sum_congr rfl (fun ω' _ => ?_)
          by_cases hω' : 0 < π ω'
          · by_cases hTq : T_idx ω' = T_idx ω ∧ k_q ω' = k_q ω
            · have hkr := h_det_r ω' ω hω' hω hTq.2
              have hXr : X_r ω' = X_r ω := Prod.ext hTq.1 hkr
              rw [if_pos ⟨hXr, hTq.2⟩, if_pos hTq]
            · have hXr_not : ¬ (X_r ω' = X_r ω ∧ k_q ω' = k_q ω) :=
                fun h => hTq ⟨congr_arg Prod.fst h.1, h.2⟩
              rw [if_neg hXr_not, if_neg hTq]
          · have h0 : π ω' = 0 := le_antisymm (not_lt.mp hω') (hπ_nn ω')
            simp [h0]
        have hp_Xr : finProbAt π X_r ω = finProbAt2 π T_idx k_r ω := by
          unfold finProbAt finProbAt2
          refine Finset.sum_congr rfl (fun ω' _ => ?_)
          by_cases hXr : X_r ω' = X_r ω
          · rw [if_pos hXr, if_pos ⟨congr_arg Prod.fst hXr, congr_arg Prod.snd hXr⟩]
          · have hnot : ¬ (T_idx ω' = T_idx ω ∧ k_r ω' = k_r ω) :=
              fun h => hXr (Prod.ext h.1 h.2)
            rw [if_neg hXr, if_neg hnot]
        obtain ⟨hp_Tq, _, hp_T, _⟩ := (h_prob_pos ε hε₀ hε₁ π T_idx k_q hπ_nn hπ_sum).1 ω hω
        obtain ⟨hp_Tr, _, _, _⟩ := (h_prob_pos ε hε₀ hε₁ π T_idx k_r hπ_nn hπ_sum).1 ω hω
        unfold condSurprise
        rw [hp_Xr_kq, hp_Xr]
        have h_div_id : finProbAt2 π T_idx k_q ω / finProbAt2 π T_idx k_r ω =
            (finProbAt2 π T_idx k_q ω / finProbAt π T_idx ω) /
              (finProbAt2 π T_idx k_r ω / finProbAt π T_idx ω) := by
          rw [div_div_div_cancel_right₀ hp_T.ne']
        rw [h_div_id, Real.log_div (div_pos hp_Tq hp_T).ne' (div_pos hp_Tr hp_T).ne']
        ring
      have h_ent_diff : finCondEntropy ε π T_idx k_q - finCondEntropy ε π T_idx k_r =
          finCondEntropy ε π X_r k_q := by
        unfold finCondEntropy
        rw [← Finset.sum_sub_distrib]
        refine Finset.sum_congr rfl (fun ω _ => ?_)
        by_cases hω : 0 < π ω
        · rw [h_tele ω hω]
          ring
        · have h0 : π ω = 0 := le_antisymm (not_lt.mp hω) (hπ_nn ω)
          simp [h0]
      refine ⟨h_tele, ?_, ?_⟩
      · rw [h_ent_diff]
        exact (h_prob_pos ε hε₀ hε₁ π X_r k_q hπ_nn hπ_sum).2
      · rw [h_ent_diff]
        let S_fib : Fin N_T × ℤ → Finset ℤ := fun p => Finset.Ico (p.2 * K) ((p.2 + 1) * K)
        let M_cap : ℝ := 4 * ε ^ (-(q - r))
        have hM_pos : 0 < M_cap := by positivity
        have h_mem_fib : ∀ ω, 0 < π ω → k_q ω ∈ S_fib (X_r ω) := by
          intro ω hω
