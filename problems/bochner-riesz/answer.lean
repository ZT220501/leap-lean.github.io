  obtain ⟨w₀, _, hw₀_max⟩ :=
    Finset.exists_max_image Finset.univ (fun w : Fin J₂ => ∑ ω ∈ E₂ w, P₀ ω) h_univ_J₂_ne
  let m'_w0 : ℝ := ∑ ω ∈ E₂ w₀, P₀ ω
  have hm'_w0_lb : 1 / (2 * (J₂ : ℝ)) ≤ m'_w0 := by
    have h_le : (1 / 2 : ℝ) ≤ (J₂ : ℝ) * m'_w0 := by
      calc (1 / 2 : ℝ) ≤ ∑ w : Fin J₂, ∑ ω ∈ E₂ w, P₀ ω := h_sum_E₂_half
