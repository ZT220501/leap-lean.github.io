    obtain ⟨A_keep, B_keep, hM_ge, hA_lb, hB_lb⟩ :=
      h_lemma26 G_j μ_child lam hGj_nn hGj_sum hμc_nn hμc_sum hlam_nn hlam_sum
    let M_keep : ℝ := ∑ a ∈ A_keep, ∑ b ∈ B_keep, G_j a b
