  have h_prob_eq_pos : ∀ {α : Type} [DecidableEq α] (Z : Fin N_ω → α) (ω : Fin N_ω),
      finProbAt π Z ω = ∑ ω' ∈ Ω_pos, if Z ω' = Z ω then π ω' else 0 := by
    intro α _ Z ω
    dsimp only [finProbAt]
    trans (∑ ω' : Fin N_ω, if Z ω' = Z ω then π ω' else 0)
    · refine Finset.sum_congr rfl (fun ω' _ => ?_)
      by_cases h : Z ω' = Z ω <;> simp [h]
    · symm
      refine Finset.sum_subset (Finset.subset_univ Ω_pos) (fun ω' _ hnot => ?_)
      have h_not_pos : ¬ 0 < π ω' := fun hp => hnot ((h_mem_pos ω').mpr hp)
      have h0 : π ω' = 0 := le_antisymm (le_of_not_gt h_not_pos) (h_law.1 ω')
      simp [h0]
