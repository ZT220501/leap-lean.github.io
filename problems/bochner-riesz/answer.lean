      have hkq0 : 0 ≤ k / Q := Int.ediv_nonneg hk0 hQ_pos.le
      have hkq1 : k / Q < M_v := by nlinarith
      have hk_r0 : (0 : ℝ) ≤ (k : ℝ) := by exact_mod_cast hk0
      have hk_r1 : (k : ℝ) ≤ (2 : ℝ) ^ m_e - 1 := by
        have hk_le : k ≤ (2 : ℤ) ^ m_e - 1 := by omega
        have hcast : (k : ℝ) ≤ (((2 : ℤ) ^ m_e - 1 : ℤ) : ℝ) := by exact_mod_cast hk_le
        simpa using hcast
