    · 
      have hd_ne1 : d_dim ≠ 1 := by
        rw [hd2_eq]
        exact Nat.succ_succ_ne_one 0
      obtain ⟨hbD_eq, haD_eq⟩ := hd2 hd2_eq
      let c_q : ((ℕ × (ℤ × ℤ) × (ℤ × ℤ)) × ℕ × (ℤ × ℤ)) → EuclideanSpace ℝ (Fin 2) := fun q =>
        X'_d - gridPt2D s_loc q.2.2
      let I_Z0 : ((ℕ × (ℤ × ℤ) × (ℤ × ℤ)) × ℕ × (ℤ × ℤ)) → Finset ℤ := fun q =>
        Finset.Icc (Int.floor (c_q q 0 / σ_loc - 2 * B_sys ^ 2))
                   (Int.floor (c_q q 0 / σ_loc + 2 * B_sys ^ 2))
      let I_Z1 : ((ℕ × (ℤ × ℤ) × (ℤ × ℤ)) × ℕ × (ℤ × ℤ)) → Finset ℤ := fun q =>
