            = ((loc_idx.1 : ℝ) * (((2 : ℝ) ^ (m_t - m_r)) * Δ_time) +
                ((r_loc : ℝ) + 1 / 2) * Δ_time - ((loc_idx.1 : ℝ) + 1 / 2)) * s_c := by ring
          _ = (((r_loc : ℝ) + 1 / 2) * Δ_time - 1 / 2) * s_c := by rw [h_cancel]; ring
      have hV_id : V'_at α - V'_D = w_V2 + w_V3 := by
        dsimp only [V'_at, V'_D, w_V2, w_V3]
        rw [← smul_sub, ← smul_add]
