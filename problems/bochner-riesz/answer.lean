      simp [MeasureTheory.measureReal_def, hRo_vol o, ENNReal.toReal_ofReal (sq_nonneg σ)]
    have hRo_sub : ∀ o ∈ S_Z, R_o o ⊆ R_strip := by
      intro o ho p hp
      obtain ⟨hn_bd, hτ_bd⟩ := hS_Z o ho
      obtain ⟨hn_lo, hn_hi⟩ := abs_le.mp hn_bd
      obtain ⟨hτ_lo, hτ_hi⟩ := abs_le.mp hτ_bd
      rw [hR_strip]
      refine ⟨⟨?_, ?_⟩, ⟨?_, ?_⟩⟩
      · linarith [hp.1.1]
      · linarith [hp.1.2]
      · linarith [hp.2.1, hB]
      · linarith [hp.2.2, hB]
    have hRo_dist : ∀ o ∈ S_Z, ∀ p ∈ R_o o,
        ‖(x_Z + p.1 • n_P + p.2 • τ_P) - X_O o‖ ≤ σ := by
      intro o _ p hp
      have h_vec : (x_Z + p.1 • n_P + p.2 • τ_P) - X_O o =
          (p.1 - t_n o) • n_P + (p.2 - t_τ o) • τ_P := by
        have hX := h_decomp (X_O o - x_Z)
        change X_O o - x_Z = t_n o • n_P + t_τ o • τ_P at hX
        have h1 : (x_Z + p.1 • n_P + p.2 • τ_P) - X_O o =
            (p.1 • n_P + p.2 • τ_P) - (X_O o - x_Z) := by abel
        rw [h1, hX]
        module
      have hd1 : |p.1 - t_n o| ≤ σ / 2 := abs_le.mpr ⟨by linarith [hp.1.1], by linarith [hp.1.2]⟩
      have hd2 : |p.2 - t_τ o| ≤ σ / 2 := abs_le.mpr ⟨by linarith [hp.2.1], by linarith [hp.2.2]⟩
      have hsq1 : (p.1 - t_n o) ^ 2 ≤ (σ / 2) ^ 2 := by
        rw [← sq_abs]
        exact pow_le_pow_left₀ (abs_nonneg _) hd1 2
      have hsq2 : (p.2 - t_τ o) ^ 2 ≤ (σ / 2) ^ 2 := by
        rw [← sq_abs]
        exact pow_le_pow_left₀ (abs_nonneg _) hd2 2
      have h_norm_sq : ‖(x_Z + p.1 • n_P + p.2 • τ_P) - X_O o‖ ^ 2 ≤ σ ^ 2 := by
        rw [h_vec, h_pyth]
        nlinarith
      nlinarith [norm_nonneg ((x_Z + p.1 • n_P + p.2 • τ_P) - X_O o)]
    let μ_st := MeasureTheory.volume.restrict R_strip
    have h_site_int : ∀ o ∈ S_Z,
        σ ^ 2 * a o ≤ ∫ p, (R_o o).indicator Ψ p ∂μ_st := by
      intro o ho
      have h_res_eq : μ_st.restrict (R_o o) = MeasureTheory.volume.restrict (R_o o) := by
        dsimp [μ_st]
        rw [MeasureTheory.Measure.restrict_restrict (hRo_meas o),
          Set.inter_eq_left.mpr (hRo_sub o ho)]
      have h_ind_eq : (∫ p, (R_o o).indicator Ψ p ∂μ_st) = ∫ p in R_o o, Ψ p := by
        rw [MeasureTheory.integral_indicator (hRo_meas o), h_res_eq]
      have hΨ_Ro_int : MeasureTheory.IntegrableOn Ψ (R_o o) MeasureTheory.volume :=
        MeasureTheory.IntegrableOn.mono_set hΨ_int (hRo_sub o ho)
      have h_const_int : MeasureTheory.IntegrableOn (fun _ : ℝ × ℝ => a o) (R_o o) MeasureTheory.volume :=
        MeasureTheory.integrableOn_const (hRo_lt_top o).ne
      have h_mono := MeasureTheory.setIntegral_mono_on h_const_int hΨ_Ro_int (hRo_meas o)
        (fun p hp => h_pt o ho p (hRo_dist o ho p hp))
      rw [MeasureTheory.setIntegral_const, hRo_real o, smul_eq_mul] at h_mono
      rwa [h_ind_eq]
    have h_sum_le : σ ^ 2 * ∑ o ∈ S_Z, a o ≤
        ∫ p, (∑ o ∈ S_Z, (R_o o).indicator Ψ p) ∂μ_st := by
      calc σ ^ 2 * ∑ o ∈ S_Z, a o
          = ∑ o ∈ S_Z, σ ^ 2 * a o := Finset.mul_sum _ _ _
        _ ≤ ∑ o ∈ S_Z, ∫ p, (R_o o).indicator Ψ p ∂μ_st := Finset.sum_le_sum h_site_int
        _ = ∫ p, (∑ o ∈ S_Z, (R_o o).indicator Ψ p) ∂μ_st :=
            (MeasureTheory.integral_finsetSum S_Z
              (fun o _ => hΨ_int.indicator (hRo_meas o))).symm
    let L_B : ℕ := ⌈B_cell⌉₊
    let N_ov : ℕ := (2 * L_B + 1) ^ 2 * N_mult
    let B_ℤ : Finset (ℤ × ℤ) :=
      Finset.Icc (-(L_B : ℤ)) (L_B : ℤ) ×ˢ Finset.Icc (-(L_B : ℤ)) (L_B : ℤ)
    have hB_ℤ_card : B_ℤ.card = (2 * L_B + 1) ^ 2 := by
      dsimp [B_ℤ]
      have h_int_eq : (L_B : ℤ) + 1 - -(L_B : ℤ) = ((2 * L_B + 1 : ℕ) : ℤ) := by
        push_cast
        ring
      rw [Finset.card_product, Int.card_Icc, h_int_eq, Int.toNat_natCast, sq]
    let q_V : Fin N_obs → ℤ × ℤ := fun o =>
      (⌊(V_O o - V_P).ofLp 0 / ρ⌋, ⌊(V_O o - V_P).ofLp 1 / ρ⌋)
    have h_ov_pt : ∀ p ∈ R_strip,
        ∑ o ∈ S_Z, (R_o o).indicator Ψ p ≤ (N_ov : ℝ) * Ψ p := by
      classical
      intro p hp
      let A_p : Finset (Fin N_obs) := S_Z.filter (fun o => p ∈ R_o o)
      have h_sum_ind : ∑ o ∈ S_Z, (R_o o).indicator Ψ p = (A_p.card : ℝ) * Ψ p := by
        have h_each : ∀ o ∈ S_Z, (R_o o).indicator Ψ p = if p ∈ R_o o then Ψ p else 0 :=
          fun o _ => Set.indicator_apply (R_o o) Ψ p
        rw [Finset.sum_congr rfl h_each, ← Finset.sum_filter, Finset.sum_const, nsmul_eq_mul]
      rw [h_sum_ind]
      have h_maps : ∀ o ∈ A_p, q_V o ∈ B_ℤ := by
        intro o ho
        have ho_S : o ∈ S_Z := (Finset.mem_filter.mp ho).1
        have hV_bd : ‖V_O o - V_P‖ ≤ (L_B : ℝ) * ρ :=
          le_trans (hV_O o ho_S) (mul_le_mul_of_nonneg_right (Nat.le_ceil B_cell) hρ.le)
        have h_coord : ∀ i : Fin 2, ⌊(V_O o - V_P).ofLp i / ρ⌋ ∈ Finset.Icc (-(L_B : ℤ)) (L_B : ℤ) := by
          intro i
          have hi_abs : |(V_O o - V_P).ofLp i| ≤ (L_B : ℝ) * ρ := by
            calc |(V_O o - V_P).ofLp i| = ‖(V_O o - V_P).ofLp i‖ := (Real.norm_eq_abs _).symm
              _ ≤ ‖V_O o - V_P‖ := PiLp.norm_apply_le (V_O o - V_P) i
              _ ≤ (L_B : ℝ) * ρ := hV_bd
          obtain ⟨hi1, hi2⟩ := abs_le.mp hi_abs
          have h_div1 : -(L_B : ℝ) ≤ (V_O o - V_P).ofLp i / ρ := by
            rw [le_div_iff₀ hρ]
            linarith
          have h_div2 : (V_O o - V_P).ofLp i / ρ ≤ (L_B : ℝ) := by
            rw [div_le_iff₀ hρ]
            linarith
          rw [Finset.mem_Icc]
          refine ⟨Int.le_floor.mpr (by push_cast; exact h_div1), ?_⟩
          exact Int.cast_le (R := ℝ).mp (le_trans (Int.floor_le _) (by push_cast; exact h_div2))
        exact Finset.mem_product.mpr ⟨h_coord 0, h_coord 1⟩
      have h_fib : ∀ k ∈ A_p.image q_V,
          (A_p.filter (fun o => q_V o = k)).card ≤ N_mult := by
        intro k _
        let v_k : EuclideanSpace ℝ (Fin 2) := V_P + WithLp.toLp 2 (fun i : Fin 2 =>
          if i = 0 then ρ * ((k.1 : ℝ) + 1 / 2) else ρ * ((k.2 : ℝ) + 1 / 2))
        let x_p : EuclideanSpace ℝ (Fin 2) := x_Z + p.1 • n_P + p.2 • τ_P
        have h_fib_ok : ∀ o ∈ A_p.filter (fun o => q_V o = k),
            ‖V_O o - v_k‖ ≤ ρ ∧ ‖X_O o - x_p‖ ≤ σ := by
          intro o ho
          obtain ⟨ho_A, hqk⟩ := Finset.mem_filter.mp ho
          obtain ⟨ho_S, hp_Ro⟩ := Finset.mem_filter.mp ho_A
          have hk1 : ⌊(V_O o - V_P).ofLp 0 / ρ⌋ = k.1 := congrArg Prod.fst hqk
          have hk2 : ⌊(V_O o - V_P).ofLp 1 / ρ⌋ = k.2 := congrArg Prod.snd hqk
          have hc0 : |(V_O o - v_k).ofLp 0| ≤ ρ / 2 := by
            have hfl : (k.1 : ℝ) ≤ (V_O o - V_P).ofLp 0 / ρ := by rw [← hk1]; exact Int.floor_le _
            have hlt : (V_O o - V_P).ofLp 0 / ρ < (k.1 : ℝ) + 1 := by
              rw [← hk1]; exact Int.lt_floor_add_one _
            have hm1 := (le_div_iff₀ hρ).mp hfl
            have hm2 := (div_lt_iff₀ hρ).mp hlt
            have hdiff : (V_O o - v_k).ofLp 0 = (V_O o - V_P).ofLp 0 - ρ * ((k.1 : ℝ) + 1 / 2) := by
              simp [v_k]
              ring
            rw [hdiff]
            exact abs_le.mpr ⟨by linarith, by linarith⟩
          have hc1 : |(V_O o - v_k).ofLp 1| ≤ ρ / 2 := by
            have hfl : (k.2 : ℝ) ≤ (V_O o - V_P).ofLp 1 / ρ := by rw [← hk2]; exact Int.floor_le _
            have hlt : (V_O o - V_P).ofLp 1 / ρ < (k.2 : ℝ) + 1 := by
              rw [← hk2]; exact Int.lt_floor_add_one _
            have hm1 := (le_div_iff₀ hρ).mp hfl
            have hm2 := (div_lt_iff₀ hρ).mp hlt
            have hdiff : (V_O o - v_k).ofLp 1 = (V_O o - V_P).ofLp 1 - ρ * ((k.2 : ℝ) + 1 / 2) := by
              simp [v_k]
              ring
            rw [hdiff]
            exact abs_le.mpr ⟨by linarith, by linarith⟩
          have hV_norm : ‖V_O o - v_k‖ ≤ ρ := by
            have hsq : ‖V_O o - v_k‖ ^ 2 ≤ ρ ^ 2 := by
              rw [EuclideanSpace.norm_sq_eq, Fin.sum_univ_two, Real.norm_eq_abs, Real.norm_eq_abs]
              have h0s : |(V_O o - v_k).ofLp 0| ^ 2 ≤ (ρ / 2) ^ 2 :=
                pow_le_pow_left₀ (abs_nonneg _) hc0 2
              have h1s : |(V_O o - v_k).ofLp 1| ^ 2 ≤ (ρ / 2) ^ 2 :=
                pow_le_pow_left₀ (abs_nonneg _) hc1 2
              nlinarith
            nlinarith [norm_nonneg (V_O o - v_k)]
          have hX_norm : ‖X_O o - x_p‖ ≤ σ := by
            rw [norm_sub_rev]
            exact hRo_dist o ho_S p hp_Ro
          exact ⟨hV_norm, hX_norm⟩
        exact Nat.cast_le (α := ℝ).mp (h_pack v_k x_p _ h_fib_ok)
      have h_card_img : (A_p.image q_V).card ≤ B_ℤ.card :=
        Finset.card_le_card (Finset.image_subset_iff.mpr h_maps)
      have h_card_Ap : A_p.card ≤ N_ov := by
        calc A_p.card
            ≤ N_mult * (A_p.image q_V).card :=
              Finset.card_le_mul_card_image_of_maps_to (fun o ho => Finset.mem_image_of_mem q_V ho)
                N_mult h_fib
          _ = (A_p.image q_V).card * N_mult := Nat.mul_comm _ _
          _ ≤ B_ℤ.card * N_mult := Nat.mul_le_mul_right N_mult h_card_img
          _ = N_ov := by rw [hB_ℤ_card]
      exact mul_le_mul_of_nonneg_right (by exact_mod_cast h_card_Ap) (hΨ_nn p hp)
    have h_int_ov : (∫ p, (∑ o ∈ S_Z, (R_o o).indicator Ψ p) ∂μ_st) ≤
        (N_ov : ℝ) * ∫ p, Ψ p ∂μ_st := by
      have h_lhs_int : MeasureTheory.Integrable
          (fun p => ∑ o ∈ S_Z, (R_o o).indicator Ψ p) μ_st :=
        MeasureTheory.integrable_finsetSum S_Z (fun o _ => hΨ_int.indicator (hRo_meas o))
      have h_rhs_int : MeasureTheory.Integrable (fun p => (N_ov : ℝ) * Ψ p) μ_st :=
        hΨ_int.const_mul (N_ov : ℝ)
      have h_ae : (fun p => ∑ o ∈ S_Z, (R_o o).indicator Ψ p) ≤ᵐ[μ_st]
          (fun p => (N_ov : ℝ) * Ψ p) := by
        filter_upwards [MeasureTheory.ae_restrict_mem hR_meas] with p hp
        exact h_ov_pt p hp
      calc (∫ p, (∑ o ∈ S_Z, (R_o o).indicator Ψ p) ∂μ_st)
          ≤ ∫ p, (N_ov : ℝ) * Ψ p ∂μ_st := MeasureTheory.integral_mono_ae h_lhs_int h_rhs_int h_ae
        _ = (N_ov : ℝ) * ∫ p, Ψ p ∂μ_st := MeasureTheory.integral_const_mul _ _
    have h_comb : σ ^ 2 * ∑ o ∈ S_Z, a o ≤ (N_ov : ℝ) * ∫ p in R_strip, Ψ p :=
      le_trans h_sum_le h_int_ov
    have h_mul := mul_le_mul_of_nonneg_left h_comb (pow_nonneg (inv_nonneg.mpr hσ.le) 2)
    have h_cancel : σ⁻¹ ^ 2 * (σ ^ 2 * ∑ o ∈ S_Z, a o) = ∑ o ∈ S_Z, a o := by
      field_simp [hσ.ne']
    rw [h_cancel] at h_mul
    calc ∑ o ∈ S_Z, a o
        ≤ σ⁻¹ ^ 2 * ((N_ov : ℝ) * ∫ p in R_strip, Ψ p) := h_mul
      _ = (N_ov : ℝ) * (σ⁻¹ ^ 2 * ∫ p in R_strip, Ψ p) := by ring

  
  have modulated_strip_tsum_integral_bound :
      ∀ (Φ₀ : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → ℝ),
        Continuous Φ₀ →
      ∀ (lam_loc ρ σ c_end R_h M_strip S_w : ℝ),
        0 < ρ → 0 < σ → 0 < R_h → 0 ≤ M_strip → 0 ≤ S_w →
      ∀ (V_P x_Z n_P : EuclideanSpace ℝ (Fin 2))
        (R_strip : Set (ℝ × ℝ)), IsCompact R_strip →
      ∀ (h_W : EuclideanSpace ℝ (Fin 2) → ℂ), Continuous h_W →
        (∀ v : EuclideanSpace ℝ (Fin 2), R_h ≤ ‖v - V_P‖ → h_W v = 0) →
      ∀ (J : Finset (ℤ × ℤ)) (w : ℤ × ℤ → ℝ),
        (∀ n, 0 ≤ w n) → Summable w → (∑' n : ℤ × ℤ, w n ≤ S_w) →
      ∀ (μ : (ℤ × ℤ) → (ℤ × ℤ) → EuclideanSpace ℝ (Fin 2) → ℂ),
        (∀ j ∈ J, ∀ n : ℤ × ℤ, Continuous (μ j n)) →
        (∀ j ∈ J, ∀ (n : ℤ × ℤ) (v : EuclideanSpace ℝ (Fin 2)), ‖μ j n v‖ ≤ 1) →
        (∀ j ∈ J, ∀ n : ℤ × ℤ,
          σ⁻¹ ^ 2 * ∫ p in R_strip,
            ‖(ρ⁻¹ : ℂ) * ∫ v : EuclideanSpace ℝ (Fin 2),
              h_W v * μ j n v *
                Complex.exp (Complex.I *
                  ((lam_loc * Φ₀ (c_end, x_Z + p.1 • n_P + p.2 • perp2D n_P, v) : ℝ) : ℂ))‖ ^ 2 ≤
            M_strip) →
        let J_op : (ℤ × ℤ) → (ℤ × ℤ) → EuclideanSpace ℝ (Fin 2) → ℂ := fun j n x =>
          (ρ⁻¹ : ℂ) * ∫ v : EuclideanSpace ℝ (Fin 2),
            h_W v * μ j n v *
              Complex.exp (Complex.I * ((lam_loc * Φ₀ (c_end, x, v) : ℝ) : ℂ))
        let Ψ : ℝ × ℝ → ℝ := fun p =>
          ∑ j ∈ J, ∑' n : ℤ × ℤ, w n * ‖J_op j n (x_Z + p.1 • n_P + p.2 • perp2D n_P)‖ ^ 2
        (∃ B₀ : ℝ, 0 ≤ B₀ ∧ ∀ j ∈ J, ∀ (n : ℤ × ℤ) (x : EuclideanSpace ℝ (Fin 2)),
          ‖J_op j n x‖ ≤ B₀) ∧
        (∀ p : ℝ × ℝ, 0 ≤ Ψ p) ∧
        MeasureTheory.Integrable Ψ (MeasureTheory.volume.restrict R_strip) ∧
        σ⁻¹ ^ 2 * ∫ p in R_strip, Ψ p ≤ (J.card : ℝ) * S_w * M_strip := by
    intro Φ₀ hΦ₀_cont lam_loc ρ σ c_end R_h M_strip S_w hρ hσ _hRh hM_strip _hSw
      V_P x_Z n_P R_strip hR_comp h_W hh_W_cont hh_W_supp J w hw_nn hw_sum hw_le
      μ hμ_cont hμ_le h_strip_mod
    dsimp only
    let E := EuclideanSpace ℝ (Fin 2)
    let J_op : (ℤ × ℤ) → (ℤ × ℤ) → E → ℂ := fun j n x =>
      (ρ⁻¹ : ℂ) * ∫ v : E,
        h_W v * μ j n v *
          Complex.exp (Complex.I * ((lam_loc * Φ₀ (c_end, x, v) : ℝ) : ℂ))
    let x_st : ℝ × ℝ → E := fun p => x_Z + p.1 • n_P + p.2 • perp2D n_P
    let Ψ : ℝ × ℝ → ℝ := fun p =>
      ∑ j ∈ J, ∑' n : ℤ × ℤ, w n * ‖J_op j n (x_st p)‖ ^ 2
    have hh_W_csupp : HasCompactSupport h_W := by
      refine HasCompactSupport.intro (isCompact_closedBall V_P R_h) (fun v hv => ?_)
      rw [Metric.mem_closedBall, dist_eq_norm, not_le] at hv
      exact hh_W_supp v hv.le
    have hh_W_norm_int : MeasureTheory.Integrable (fun v : E => ‖h_W v‖) MeasureTheory.volume :=
      hh_W_cont.norm.integrable_of_hasCompactSupport hh_W_csupp.norm
    let B₀ : ℝ := ρ⁻¹ * ∫ v : E, ‖h_W v‖
    have hB₀_nn : 0 ≤ B₀ :=
      mul_nonneg (inv_nonneg.mpr hρ.le) (MeasureTheory.integral_nonneg (fun _ => norm_nonneg _))
    have h_pt_dom : ∀ j ∈ J, ∀ (n : ℤ × ℤ) (x v : E),
        ‖h_W v * μ j n v * Complex.exp (Complex.I * ((lam_loc * Φ₀ (c_end, x, v) : ℝ) : ℂ))‖ ≤
          ‖h_W v‖ := by
      intro j hj n x v
      rw [norm_mul, norm_mul, Complex.norm_exp_I_mul_ofReal, mul_one]
      calc ‖h_W v‖ * ‖μ j n v‖ ≤ ‖h_W v‖ * 1 :=
            mul_le_mul_of_nonneg_left (hμ_le j hj n v) (norm_nonneg _)
        _ = ‖h_W v‖ := mul_one _
    have hJ_op_bound : ∀ j ∈ J, ∀ (n : ℤ × ℤ) (x : E), ‖J_op j n x‖ ≤ B₀ := by
      intro j hj n x
      dsimp [J_op, B₀]
      rw [norm_mul, norm_inv, Complex.norm_real, Real.norm_of_nonneg hρ.le]
      refine mul_le_mul_of_nonneg_left ?_ (inv_nonneg.mpr hρ.le)
      refine le_trans (MeasureTheory.norm_integral_le_integral_norm _) ?_
      have h_int_norm : MeasureTheory.Integrable
          (fun v : E => ‖h_W v * μ j n v *
            Complex.exp (Complex.I * ((lam_loc * Φ₀ (c_end, x, v) : ℝ) : ℂ))‖)
          MeasureTheory.volume := by
        have hc : Continuous (fun v : E => h_W v * μ j n v *
            Complex.exp (Complex.I * ((lam_loc * Φ₀ (c_end, x, v) : ℝ) : ℂ))) :=
          ((hh_W_cont.mul (hμ_cont j hj n)).mul
            (Complex.continuous_exp.comp (continuous_const.mul
              (Complex.continuous_ofReal.comp
                (continuous_const.mul (hΦ₀_cont.comp
                  (continuous_const.prodMk (continuous_const.prodMk continuous_id))))))))
        exact hh_W_norm_int.mono' hc.norm.aestronglyMeasurable
          (Filter.Eventually.of_forall (fun v => by
            rw [Real.norm_of_nonneg (norm_nonneg _)]
            exact h_pt_dom j hj n x v))
      exact MeasureTheory.integral_mono h_int_norm hh_W_norm_int (h_pt_dom j hj n x)
    have hJ_op_cont : ∀ j ∈ J, ∀ n : ℤ × ℤ, Continuous (J_op j n) := by
      intro j hj n
      dsimp [J_op]
      refine continuous_const.mul ?_
      refine MeasureTheory.continuous_of_dominated
        (bound := fun v : E => ‖h_W v‖) ?_ ?_ hh_W_norm_int ?_
      · intro x
        have hc : Continuous (fun v : E => h_W v * μ j n v *
            Complex.exp (Complex.I * ((lam_loc * Φ₀ (c_end, x, v) : ℝ) : ℂ))) :=
          ((hh_W_cont.mul (hμ_cont j hj n)).mul
            (Complex.continuous_exp.comp (continuous_const.mul
              (Complex.continuous_ofReal.comp
                (continuous_const.mul (hΦ₀_cont.comp
                  (continuous_const.prodMk (continuous_const.prodMk continuous_id))))))))
        exact hc.aestronglyMeasurable
      · intro x
        exact Filter.Eventually.of_forall (fun v => h_pt_dom j hj n x v)
      · refine Filter.Eventually.of_forall (fun v => ?_)
        exact (continuous_const.mul (Complex.continuous_exp.comp (continuous_const.mul
          (Complex.continuous_ofReal.comp (continuous_const.mul
            (hΦ₀_cont.comp (continuous_const.prodMk (continuous_id.prodMk continuous_const))))))))
    have hx_st_cont : Continuous x_st := by
      dsimp [x_st]
      exact (continuous_const.add (continuous_fst.smul continuous_const)).add
        (continuous_snd.smul continuous_const)
    let f_jn : (ℤ × ℤ) → (ℤ × ℤ) → ℝ × ℝ → ℝ := fun j n p =>
      w n * ‖J_op j n (x_st p)‖ ^ 2
    have hf_jn_cont : ∀ j ∈ J, ∀ n : ℤ × ℤ, Continuous (f_jn j n) := by
      intro j hj n
      dsimp [f_jn]
      exact continuous_const.mul ((((hJ_op_cont j hj n).comp hx_st_cont).norm).pow 2)
    have hf_jn_nn : ∀ j n p, 0 ≤ f_jn j n p := fun _ n _ =>
      mul_nonneg (hw_nn n) (sq_nonneg _)
    have hf_jn_le : ∀ j ∈ J, ∀ (n : ℤ × ℤ) (p : ℝ × ℝ),
        ‖f_jn j n p‖ ≤ B₀ ^ 2 * w n := by
      intro j hj n p
      rw [Real.norm_of_nonneg (hf_jn_nn j n p)]
      calc w n * ‖J_op j n (x_st p)‖ ^ 2
          ≤ w n * B₀ ^ 2 :=
            mul_le_mul_of_nonneg_left
              (pow_le_pow_left₀ (norm_nonneg _) (hJ_op_bound j hj n (x_st p)) 2) (hw_nn n)
        _ = B₀ ^ 2 * w n := mul_comm _ _
    have h_tsum_cont : ∀ j ∈ J, Continuous (fun p : ℝ × ℝ => ∑' n : ℤ × ℤ, f_jn j n p) := by
      intro j hj
      exact continuous_tsum (hf_jn_cont j hj) (hw_sum.mul_left (B₀ ^ 2)) (hf_jn_le j hj)
    have hΨ_cont : Continuous Ψ :=
      continuous_finsetSum J (fun j hj => h_tsum_cont j hj)
    have hΨ_nn : ∀ p : ℝ × ℝ, 0 ≤ Ψ p := fun p =>
      Finset.sum_nonneg (fun j _ => tsum_nonneg (fun n => hf_jn_nn j n p))
    let μ_st := MeasureTheory.volume.restrict R_strip
    have hΨ_int : MeasureTheory.Integrable Ψ μ_st :=
      hΨ_cont.continuousOn.integrableOn_compact hR_comp
    have hR_lt_top : MeasureTheory.volume R_strip < ⊤ := hR_comp.measure_lt_top
    have h_j_bound : ∀ j ∈ J,
        σ⁻¹ ^ 2 * ∫ p, (∑' n : ℤ × ℤ, f_jn j n p) ∂μ_st ≤ S_w * M_strip := by
      intro j hj
      have hf_int : ∀ n : ℤ × ℤ, MeasureTheory.Integrable (f_jn j n) μ_st := fun n =>
        (hf_jn_cont j hj n).continuousOn.integrableOn_compact hR_comp
      have h_int_norm_sum : Summable (fun n : ℤ × ℤ => ∫ p, ‖f_jn j n p‖ ∂μ_st) := by
        refine Summable.of_nonneg_of_le
          (fun n => MeasureTheory.integral_nonneg (fun _ => norm_nonneg _)) (fun n => ?_)
          (hw_sum.mul_left (B₀ ^ 2 * MeasureTheory.volume.real R_strip))
        have h_bd : ‖∫ p in R_strip, ‖f_jn j n p‖‖ ≤
            (B₀ ^ 2 * w n) * MeasureTheory.volume.real R_strip := by
          refine MeasureTheory.norm_setIntegral_le_of_norm_le_const hR_lt_top (fun p _ => ?_)
          rw [Real.norm_of_nonneg (norm_nonneg _)]
          exact hf_jn_le j hj n p
        have h_int_nn : 0 ≤ ∫ p, ‖f_jn j n p‖ ∂μ_st :=
          MeasureTheory.integral_nonneg (fun _ => norm_nonneg _)
        rw [← Real.norm_of_nonneg h_int_nn]
        calc ‖∫ p, ‖f_jn j n p‖ ∂μ_st‖
            ≤ (B₀ ^ 2 * w n) * MeasureTheory.volume.real R_strip := h_bd
          _ = (B₀ ^ 2 * MeasureTheory.volume.real R_strip) * w n := by ring
      rw [← MeasureTheory.integral_tsum_of_summable_integral_norm hf_int h_int_norm_sum,
        ← tsum_mul_left]
      have h_term_le : ∀ n : ℤ × ℤ,
          σ⁻¹ ^ 2 * ∫ p, f_jn j n p ∂μ_st ≤ w n * M_strip := by
        intro n
        dsimp [f_jn]
        rw [MeasureTheory.integral_const_mul]
        calc σ⁻¹ ^ 2 * (w n * ∫ p, ‖J_op j n (x_st p)‖ ^ 2 ∂μ_st)
            = w n * (σ⁻¹ ^ 2 * ∫ p, ‖J_op j n (x_st p)‖ ^ 2 ∂μ_st) := by ring
          _ ≤ w n * M_strip := mul_le_mul_of_nonneg_left (h_strip_mod j hj n) (hw_nn n)
      have h_lhs_sum : Summable (fun n : ℤ × ℤ => σ⁻¹ ^ 2 * ∫ p, f_jn j n p ∂μ_st) := by
        refine Summable.of_nonneg_of_le
          (fun n => mul_nonneg (pow_nonneg (inv_nonneg.mpr hσ.le) 2)
            (MeasureTheory.integral_nonneg (fun p => hf_jn_nn j n p)))
          h_term_le (hw_sum.mul_right M_strip)
      calc ∑' n : ℤ × ℤ, σ⁻¹ ^ 2 * ∫ p, f_jn j n p ∂μ_st
          ≤ ∑' n : ℤ × ℤ, w n * M_strip :=
            h_lhs_sum.tsum_le_tsum h_term_le (hw_sum.mul_right M_strip)
        _ = (∑' n : ℤ × ℤ, w n) * M_strip := tsum_mul_right
        _ ≤ S_w * M_strip := mul_le_mul_of_nonneg_right hw_le hM_strip
    have h_tot_bd : σ⁻¹ ^ 2 * ∫ p, Ψ p ∂μ_st ≤ (J.card : ℝ) * S_w * M_strip := by
      have h_each_int : ∀ j ∈ J,
          MeasureTheory.Integrable (fun p => ∑' n : ℤ × ℤ, f_jn j n p) μ_st := fun j hj =>
        (h_tsum_cont j hj).continuousOn.integrableOn_compact hR_comp
      dsimp [Ψ]
      rw [MeasureTheory.integral_finsetSum J h_each_int, Finset.mul_sum]
      calc ∑ j ∈ J, σ⁻¹ ^ 2 * ∫ p, (∑' n : ℤ × ℤ, f_jn j n p) ∂μ_st
          ≤ ∑ _j ∈ J, S_w * M_strip := Finset.sum_le_sum h_j_bound
        _ = (J.card : ℝ) * (S_w * M_strip) := by rw [Finset.sum_const, nsmul_eq_mul]
        _ = (J.card : ℝ) * S_w * M_strip := by ring
    exact ⟨⟨B₀, hB₀_nn, hJ_op_bound⟩, hΨ_nn, hΨ_int, h_tot_bd⟩

  
  have haar_2d : ∀ (ρ : ℝ), 0 < ρ → ∀ (V_P : EuclideanSpace ℝ (Fin 2))
      (H : EuclideanSpace ℝ (Fin 2) → ℂ),
      (ρ⁻¹ : ℂ) * ∫ v : EuclideanSpace ℝ (Fin 2), H v =
        (ρ : ℂ) * ∫ z : EuclideanSpace ℝ (Fin 2), H (V_P + ρ • z) := by
    intro ρ hρ V_P H
    have h_tr : (∫ v : EuclideanSpace ℝ (Fin 2), H v) =
        ∫ w : EuclideanSpace ℝ (Fin 2), H (V_P + w) :=
      (MeasureTheory.integral_add_left_eq_self H V_P).symm
    have h_sm := MeasureTheory.Measure.integral_comp_smul
      (μ := (MeasureTheory.volume : MeasureTheory.Measure (EuclideanSpace ℝ (Fin 2))))
      (f := fun w => H (V_P + w)) ρ
    rw [finrank_euclideanSpace_fin] at h_sm
    have h_abs : |(ρ ^ 2)⁻¹| = ρ⁻¹ ^ 2 := by
      rw [abs_of_pos (inv_pos.mpr (pow_pos hρ 2)), inv_pow]
    rw [h_abs, Complex.real_smul] at h_sm
    rw [h_tr, h_sm, ← mul_assoc]
    have h_alg : (ρ : ℂ) * (((ρ⁻¹ ^ 2 : ℝ) : ℂ)) = (ρ⁻¹ : ℂ) := by
      push_cast
      have hne : (ρ : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hρ.ne'
      field_simp [hne]
    rw [h_alg]

  
  obtain ⟨C_χ, hC_χ, h_pou_smooth, h_pou_supp, h_pou_deriv, h_gabor⟩ :=
    gevrey_partition_and_fourier_synthesis
  obtain ⟨B_amp, hB_amp, h_slice⟩ :=
    equal_time_phase_diff_slice_bounds a₀ a₁ A C_χ M_win ha₀ ha₁ hA hC_χ h_pou_smooth h_pou_deriv
  obtain ⟨C_ibp, hC_ibp, h_ibp⟩ :=
    nonstationary_phase_1d_arbitrary_ibp 4 2 (by norm_num) B_amp (fun _ => 0)
  have h_lin_ibp : ∀ (L : ℝ), 0 < L →
      ∀ (u : ℝ → ℂ), (∀ k : ℕ, ContDiff ℝ k u) →
        (∀ t : ℝ, 2 ≤ |t| → u t = 0) →
        (∀ k : ℕ, k ≤ 4 → ∀ t : ℝ, ‖iteratedDeriv k u t‖ ≤ B_amp k) →
        ‖∫ t : ℝ, u t * Complex.exp (Complex.I * ((L * t : ℝ) : ℂ))‖ ≤ C_ibp / L ^ 4 := by
    have h_zero_iter : ∀ (k : ℕ) (t : ℝ), iteratedDeriv k (fun _ : ℝ => (0 : ℝ)) t = 0 := by
      intro k
      induction k with
      | zero => intro _; rfl
      | succ k ih =>
        intro t
        rw [iteratedDeriv_succ, funext ih, deriv_const]
    intro L hL u hu_sm hu_supp hu_der
    have hθ_deriv : deriv (fun t : ℝ => L * t) = fun _ : ℝ => L := by
      funext t
      have hd : HasDerivAt (fun s : ℝ => L * s) (L * 1) t := (hasDerivAt_id t).const_mul L
      rw [mul_one] at hd
      exact hd.deriv
    refine h_ibp L hL (fun t => L * t)
      (fun k => contDiff_const.mul contDiff_id)
      (fun t _ => by rw [hθ_deriv])
      (fun m hm1 _ t _ => ?_)
      u hu_sm hu_supp hu_der
    obtain ⟨m', rfl⟩ := Nat.exists_eq_succ_of_ne_zero (by omega : m ≠ 0)
    rw [hθ_deriv, iteratedDeriv_succ']
    have hd0 : deriv (fun _ : ℝ => L) = fun _ : ℝ => (0 : ℝ) :=
      funext (fun s => deriv_const s L)
    rw [hd0, h_zero_iter m' t]
    simp

  obtain ⟨C_coeff, hC_coeff, ⟨hw_sum, hw_le⟩, h_coeff_bd, h_wcs⟩ :=
    rapid_fourier_coeff_and_weighted_cs C_ibp B_amp hC_ibp hB_amp h_lin_ibp

  let w : ℤ × ℤ → ℝ := fun n =>
    (((1 + |(n.1 : ℝ)|) ^ 2) * ((1 + |(n.2 : ℝ)|) ^ 2))⁻¹
  have hw_nn : ∀ n : ℤ × ℤ, 0 ≤ w n := fun n => by dsimp [w]; positivity
  let R_pat : ℝ := B_cell + R_win + 1
  have hR_pat_ge1 : 1 ≤ R_pat := by dsimp [R_pat]; linarith
  obtain ⟨J_pat, hJ_pat_eq⟩ : ∃ J : Finset (ℤ × ℤ), J = pktVelBox 1 R_pat := ⟨_, rfl⟩
  obtain ⟨N_ov, hN_ov_eq⟩ : ∃ n : ℕ, n = (2 * ⌈B_cell⌉₊ + 1) ^ 2 * N_mult := ⟨_, rfl⟩
  have hC_χ_pos : 0 < C_χ := lt_of_lt_of_le zero_lt_one hC_χ
  have hC_coeff_pos : 0 < C_coeff := lt_of_lt_of_le zero_lt_one hC_coeff
  let K_pt : ℝ := (9 / 16 : ℝ) * C_χ ^ 2 * C_coeff ^ 2 * (J_pat.card : ℝ)
  have hK_pt_nn : 0 ≤ K_pt := by
    dsimp [K_pt]
    exact mul_nonneg
      (mul_nonneg (mul_nonneg (by norm_num) (sq_nonneg C_χ)) (sq_nonneg C_coeff))
      (Nat.cast_nonneg _)
  let C_dec : ℝ := max 1 (9 * (N_ov : ℝ) * (J_pat.card : ℝ) * K_pt)
  have hC_dec_ge1 : 1 ≤ C_dec := le_max_left _ _
  have hC_dec_ge_prod : 9 * (N_ov : ℝ) * (J_pat.card : ℝ) * K_pt ≤ C_dec := le_max_right _ _

  refine ⟨C_dec, hC_dec_ge1, ?_⟩
  intro Φ₀ ζ₀ h_phase lam_loc ρ s c_end hlam hs hsρ hρ1 hlam_lo _hlam_hi hc_end
    V_P x_Z n_P hn_P N_obs V_O X_O ψ_O S_Z h_obs
    h_W M_strip hh_W_cont hh_W_supp hM_strip h_mod
  obtain ⟨hO_reg, hO_pack, hS_Z⟩ := h_obs
  have hΦ₀_cont : Continuous Φ₀ := (h_phase.1 0).continuous
  have hρ : 0 < ρ := lt_of_lt_of_le hs hsρ
  let σ : ℝ := (lam_loc * ρ)⁻¹
  have hσ : 0 < σ := inv_pos.mpr (mul_pos hlam hρ)
  have hB_pos : 0 < B_cell := by linarith
  have hσ_le : σ ≤ B_cell * s := by
    have h_lam_s_le : lam_loc * s ≤ lam_loc * ρ := mul_le_mul_of_nonneg_left hsρ hlam.le
    have h_sig_le1 : σ ≤ (lam_loc * s)⁻¹ := inv_anti₀ (mul_pos hlam hs) h_lam_s_le
    have h_inv_s2 : (lam_loc * s ^ 2)⁻¹ ≤ B_cell := by
      have h1 := inv_anti₀ (inv_pos.mpr hB_pos) hlam_lo
      rwa [inv_inv] at h1
    have h_eq_s : (lam_loc * s)⁻¹ = (lam_loc * s ^ 2)⁻¹ * s := by
