          _ = (∑ q ∈ F_set, q_Q q) * Real.log M_cell := (Finset.sum_mul _ _ _).symm
          _ = Real.log M_cell := by rw [hq_law_sum, one_mul]
      have h_eq_sum : ∑ z ∈ Z_act, ∑ q ∈ F_set,
