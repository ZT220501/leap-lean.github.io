  have he₂_le_Δ : e₂ ≤ Δ_star / 160 := min_le_left _ _
  have he₂_le_α : e₂ ≤ α * a₀ / 16 := min_le_right _ _
  let ζ₂ : ℝ := e₂ / 20
  have hζ₂_pos : 0 < ζ₂ := by dsimp [ζ₂]; linarith only [he₂_pos]
  let θ_R : ℝ := ζ₂ * Δ_star / 1024
  have hθ_R_pos : 0 < θ_R := div_pos (mul_pos hζ₂_pos hΔ_pos) (by norm_num)
  obtain ⟨R₀_nat, hR₀_nat⟩ := exists_nat_gt (32 / (θ_R * Δ_star))
  let R : ℕ := R₀_nat + 2
  have hR_ge2 : 2 ≤ R := Nat.le_add_left 2 R₀_nat
  have hR_pos : 0 < (R : ℝ) := by positivity
  have hR_gt : 32 / (θ_R * Δ_star) < (R : ℝ) := by
