        intro k t
        rw [← iteratedDeriv_succ']
        exact hh_maj (k + 1) (k + 1) le_rfl t
      let g₁ : ℝ → ℂ := fun t => -(Complex.I * (L : ℂ)⁻¹) * Complex.exp (Complex.I * (θ t : ℂ))
      have hg₁_deriv : ∀ t : ℝ, HasDerivAt g₁ (Ψ t * Complex.exp (Complex.I * (θ t : ℂ))) t := by
        intro t
        have hdθ : HasDerivAt (fun s => (θ s : ℂ)) ((deriv θ t : ℝ) : ℂ) t :=
          Complex.ofRealCLM.hasFDerivAt.comp_hasDerivAt t
            ((((hθ_sm 1).hasStrictFDerivAt (by simp)).hasFDerivAt (x := t)).hasDerivAt)
        have hd_exp : HasDerivAt (fun s => Complex.exp (Complex.I * (θ s : ℂ)))
            (Complex.exp (Complex.I * (θ t : ℂ)) * (Complex.I * ((deriv θ t : ℝ) : ℂ))) t :=
          (hdθ.const_mul Complex.I).cexp
        have hd_g := hd_exp.const_mul (-(Complex.I * (L : ℂ)⁻¹))
        refine hd_g.congr_deriv ?_
        have hΨ_val : Ψ t = (L : ℂ)⁻¹ * ((deriv θ t : ℝ) : ℂ) := by
          dsimp [Ψ, ψ]
          push_cast
          rfl
        rw [hΨ_val]
        let E_exp : ℂ := Complex.exp (Complex.I * (θ t : ℂ))
        let D_θ : ℂ := ((deriv θ t : ℝ) : ℂ)
        change -(Complex.I * (L : ℂ)⁻¹) * (E_exp * (Complex.I * D_θ)) =
          ((L : ℂ)⁻¹ * D_θ) * E_exp
        have hI : Complex.I * Complex.I = -1 := Complex.I_mul_I
        calc -(Complex.I * (L : ℂ)⁻¹) * (E_exp * (Complex.I * D_θ))
            = -(Complex.I * Complex.I) * ((L : ℂ)⁻¹ * D_θ) * E_exp := by ring
          _ = ((L : ℂ)⁻¹ * D_θ) * E_exp := by rw [hI]; ring
      have hh_deriv : ∀ t : ℝ, HasDerivAt h (deriv h t) t :=
        fun t => (((hh_sm 1).hasStrictFDerivAt (by simp)).hasFDerivAt (x := t)).hasDerivAt
      have h_ibp_eq : ∫ t : ℝ, u t * Complex.exp (Complex.I * (θ t : ℂ)) =
          (Complex.I * (L : ℂ)⁻¹) * ∫ t : ℝ, deriv h t * Complex.exp (Complex.I * (θ t : ℂ)) := by
        rw [h_whole_eq_ivl u θ hu_supp, h_whole_eq_ivl (deriv h) θ hdh_supp]
        have h_integrand : (fun t : ℝ => u t * Complex.exp (Complex.I * (θ t : ℂ))) =
            (fun t : ℝ => h t * (Ψ t * Complex.exp (Complex.I * (θ t : ℂ)))) := by
          ext t
          rw [← mul_assoc, mul_comm (h t) (Ψ t), h_prod t]
        rw [h_integrand]
        have h_int1 : IntervalIntegrable (deriv h) MeasureTheory.volume (-(R_w + 1)) (R_w + 1) :=
          (hdh_sm 0).continuous.intervalIntegrable _ _
        have h_int2 : IntervalIntegrable (fun t => Ψ t * Complex.exp (Complex.I * (θ t : ℂ)))
            MeasureTheory.volume (-(R_w + 1)) (R_w + 1) :=
          ((hΨ_sm 0).continuous.mul
            (Complex.continuous_exp.comp
