  have hσ_prod : σ_max * σ_min = D_prod := by
    dsimp only [σ_max, σ_min]
    rw [← Real.sqrt_mul hlam_plus_pos.le, hlam_prod, Real.sqrt_sq hD_pos.le]
  let ell : ℝ := Real.log (ε⁻¹)
  have hell_eq : ell = -Real.log ε := Real.log_inv ε
