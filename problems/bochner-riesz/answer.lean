            (if qXY x y ≤ (ε ^ τ / (N : ℝ)) * qX x then qXY x y else 0) := by
          rw [Finset.sum_comm]
          refine Finset.sum_congr rfl (fun x _ => ?_)
          rw [Finset.sum_comm]
          refine Finset.sum_congr rfl (fun y _ => ?_)
          by_cases h_le : qXY x y ≤ (ε ^ τ / (N : ℝ)) * qX x <;> simp [h_le, qXY]
      _ ≤ ∑ x ∈ A_X, ∑ _y ∈ I_x x, ((ε ^ τ / (N : ℝ)) * qX x) := by
          refine Finset.sum_le_sum (fun x _ => Finset.sum_le_sum (fun y _ => ?_))
          by_cases h_le : qXY x y ≤ (ε ^ τ / (N : ℝ)) * qX x
          · simp [h_le]
          · simp only [h_le, ↓reduceIte]
            exact mul_nonneg (div_nonneg hετ_pos.le hN_pos.le)
