          exact mul_le_mul hR_mqv_abs hV0 (abs_nonneg _) (by linarith)
        have htri := abs_sub (V_p 1) (R_mqv * X)
        dsimp [W]
        nlinarith
      have hZ_abs : |Z| ≤ 2 * B_sys * (B_sys + 2) := by
        have hCV1 : |C_qv * (V_p 1)| ≤ 1 * B_sys := by
          rw [abs_mul]
          exact mul_le_mul hC_abs hV1 (abs_nonneg _) zero_le_one
        have hRY : |R_mqv * Y| ≤ (B_sys + 1) * (2 * B_sys) := by
          rw [abs_mul]
          exact mul_le_mul hR_mqv_abs hY_abs (abs_nonneg _) (by linarith)
        have ht1 := abs_sub (A_p 1 + C_qv * (V_p 1)) (R_mqv * Y)
        have ht2 := abs_add_le (A_p 1) (C_qv * (V_p 1))
        dsimp [Z]
        nlinarith
      dsimp only [rowObs6, S_glob]
      simp only [Finset.mem_product]
      exact ⟨Finset.mem_Ico.mpr ⟨hkc_nn, hkc_lt⟩,
        h_iv_mem (m * q_v) R_s 0 B_sys (by simpa only [sub_zero] using hRs),
        h_iv_mem (q_L 0) X 0 B_sys (by simpa only [sub_zero] using hV0),
        h_iv_mem (q_L 1) Y 0 (2 * B_sys) (by simpa only [sub_zero] using hY_abs),
        h_iv_mem (q_L 2) W 0 (B_sys * (B_sys + 2)) (by simpa only [sub_zero] using hW_abs),
        h_iv_mem (q_L 3) Z 0 (2 * B_sys * (B_sys + 2)) (by simpa only [sub_zero] using hZ_abs)⟩

theorem row_obs_particle_chain_and_markov_tail {N_ω N_T : ℕ}
    (ε m : ℝ) (hε₀ : 0 < ε) (hε₁ : ε < 1 / 2)
    (π : Fin N_ω → ℝ) (hπ_nn : ∀ ω, 0 ≤ π ω)
    (T : Fin N_ω → Fin N_T)
    (V A : Fin N_T → EuclideanSpace ℝ (Fin 2))
    (c_s R_s : Fin N_ω → ℝ)
    (q : ℝ × ℝ × ℝ × ℝ × ℝ) :
    let O := fun ω' : Fin N_ω =>
      rowObs6 ε m (V (T ω')) (A (T ω')) (c_s ω') (R_s ω') q
    let kc := fun ω' : Fin N_ω => dyadicTimeBin ε q.2.2.2.2 (c_s ω')
    let kr := fun ω' : Fin N_ω => dyadicRealBin ε (m * q.2.2.2.2) (R_s ω')
    (∀ {α β : Type} (X : Fin N_ω → α) (Y : Fin N_ω → β) (ω : Fin N_ω),
      condSurprise ε π X (fun ω' => [Y ω']) ω = condSurprise ε π X Y ω) ∧
    (∀ {α β : Type} (X : Fin N_ω → α) (Y : Fin N_ω → β) (ω : Fin N_ω),
      0 < π ω → 0 ≤ condSurprise ε π X Y ω) ∧
    (∀ {α β : Type} (X : Fin N_ω → α) (Y : Fin N_ω → β) (τ : ℝ),
      0 < τ →
      (∑ ω : Fin N_ω, if τ < |condSurprise ε π X Y ω| then π ω else 0) ≤
        finCondEntropy ε π X Y / τ) ∧
    (∀ ω : Fin N_ω, 0 < π ω →
      condSurprise ε π T O ω =
        condSurprise ε π T kc ω + condSurprise ε π (fun ω' => (T ω', kc ω')) kr ω) ∧
    finCondEntropy ε π T O =
      finCondEntropy ε π T kc + finCondEntropy ε π (fun ω' => (T ω', kc ω')) kr ∧
    finCondEntropy ε π (fun _ => ()) O =
      finMutualInfo ε π T O + finCondEntropy ε π T kc +
        finCondEntropy ε π (fun ω' => (T ω', kc ω')) kr :=
by
  rcases q with ⟨L_X, L_Y, L_W, L_Z, v⟩
  intro O kc kr
  have hε_lt1 : ε < 1 := by linarith
  have hell_pos : 0 < Real.log (ε⁻¹) :=
    Real.log_pos ((one_lt_inv₀ hε₀).mpr hε_lt1)
  have h_prob1_pos : ∀ {α : Type} (X : Fin N_ω → α) (ω : Fin N_ω),
      0 < π ω → 0 < finProbAt π X ω := by
    intro α X ω hpos
    dsimp only [finProbAt]
    refine lt_of_lt_of_le ?_ (Finset.single_le_sum ?_ (Finset.mem_univ ω))
    · simp [hpos]
    · intro ω' _
      by_cases h : X ω' = X ω <;> simp [h, hπ_nn ω']
  have h_prob2_pos : ∀ {α β : Type} (X : Fin N_ω → α) (Y : Fin N_ω → β) (ω : Fin N_ω),
      0 < π ω → 0 < finProbAt2 π X Y ω := by
    intro α β X Y ω hpos
    dsimp only [finProbAt2]
    refine lt_of_lt_of_le ?_ (Finset.single_le_sum ?_ (Finset.mem_univ ω))
    · simp [hpos]
    · intro ω' _
      by_cases h : X ω' = X ω ∧ Y ω' = Y ω <;> simp [h, hπ_nn ω']
  have h_prob2_le : ∀ {α β : Type} (X : Fin N_ω → α) (Y : Fin N_ω → β) (ω : Fin N_ω),
      finProbAt2 π X Y ω ≤ finProbAt π X ω := by
    intro α β X Y ω
    dsimp only [finProbAt2, finProbAt]
    refine Finset.sum_le_sum (fun ω' _ => ?_)
    by_cases h1 : X ω' = X ω
    · by_cases h2 : Y ω' = Y ω <;> simp [h1, h2, hπ_nn ω']
    · simp [h1]
  have h_c1 : ∀ {α β : Type} (X : Fin N_ω → α) (Y : Fin N_ω → β) (ω : Fin N_ω),
      condSurprise ε π X (fun ω' => [Y ω']) ω = condSurprise ε π X Y ω := by
    intro α β X Y ω
    unfold condSurprise
    have h_eq : finProbAt2 π X (fun ω' => [Y ω']) ω = finProbAt2 π X Y ω := by
      dsimp only [finProbAt2]
      refine Finset.sum_congr rfl (fun ω' _ => ?_)
      by_cases h : X ω' = X ω ∧ Y ω' = Y ω
      · have h' : X ω' = X ω ∧ [Y ω'] = [Y ω] := ⟨h.1, congrArg (fun z => [z]) h.2⟩
        simp only [h', h]
      · have h' : ¬ (X ω' = X ω ∧ [Y ω'] = [Y ω]) := fun hc =>
          h ⟨hc.1, List.singleton_inj.mp hc.2⟩
        simp only [h', h, ↓reduceIte]
    rw [h_eq]
  have h_c2 : ∀ {α β : Type} (X : Fin N_ω → α) (Y : Fin N_ω → β) (ω : Fin N_ω),
      0 < π ω → 0 ≤ condSurprise ε π X Y ω := by
    intro α β X Y ω hpos
    unfold condSurprise
    have hp1 : 0 < finProbAt π X ω := h_prob1_pos X ω hpos
    have hp2 : 0 < finProbAt2 π X Y ω := h_prob2_pos X Y ω hpos
    have hp_le : finProbAt2 π X Y ω ≤ finProbAt π X ω := h_prob2_le X Y ω
    have h_div_nn : 0 ≤ finProbAt2 π X Y ω / finProbAt π X ω := div_nonneg hp2.le hp1.le
    have h_div_le1 : finProbAt2 π X Y ω / finProbAt π X ω ≤ 1 := (div_le_one hp1).mpr hp_le
    have h_log_np : Real.log (finProbAt2 π X Y ω / finProbAt π X ω) ≤ 0 :=
      Real.log_nonpos h_div_nn h_div_le1
    exact div_nonneg (neg_nonneg.mpr h_log_np) hell_pos.le
  have h_c3 : ∀ {α β : Type} (X : Fin N_ω → α) (Y : Fin N_ω → β) (τ : ℝ),
      0 < τ →
      (∑ ω : Fin N_ω, if τ < |condSurprise ε π X Y ω| then π ω else 0) ≤
        finCondEntropy ε π X Y / τ := by
    intro α β X Y τ hτ
    rw [le_div_iff₀ hτ, Finset.sum_mul]
    unfold finCondEntropy
    refine Finset.sum_le_sum (fun ω _ => ?_)
    by_cases hpos : 0 < π ω
    · have h_nn : 0 ≤ condSurprise ε π X Y ω := h_c2 X Y ω hpos
      by_cases hgt : τ < |condSurprise ε π X Y ω|
      · simp only [hgt, ↓reduceIte]
        have hgt' : τ < condSurprise ε π X Y ω := by rwa [abs_of_nonneg h_nn] at hgt
        exact mul_le_mul_of_nonneg_left hgt'.le (hπ_nn ω)
      · simp only [hgt, ↓reduceIte, zero_mul]
        exact mul_nonneg (hπ_nn ω) h_nn
    · have h0 : π ω = 0 := le_antisymm (not_lt.mp hpos) (hπ_nn ω)
      simp [h0]
  have h_TO_iff : ∀ ω' ω : Fin N_ω,
      (T ω' = T ω ∧ O ω' = O ω) ↔ ((T ω' = T ω ∧ kc ω' = kc ω) ∧ kr ω' = kr ω) := by
    intro ω' ω
    constructor
    · rintro ⟨hT, hO⟩
      have hkc : kc ω' = kc ω := congrArg Prod.fst hO
      have hkr : kr ω' = kr ω := congrArg (fun z => z.2.1) hO
      exact ⟨⟨hT, hkc⟩, hkr⟩
    · rintro ⟨⟨hT, hkc⟩, hkr⟩
      refine ⟨hT, ?_⟩
      have hkc' : dyadicTimeBin ε v (c_s ω') = dyadicTimeBin ε v (c_s ω) := hkc
      have hkr' : dyadicRealBin ε (m * v) (R_s ω') = dyadicRealBin ε (m * v) (R_s ω) := hkr
      have hC : dyadicTimeMid ε v (c_s ω') = dyadicTimeMid ε v (c_s ω) := by
        unfold dyadicTimeMid
        rw [hkc']
      have hR : dyadicRealMid ε (m * v) (R_s ω') = dyadicRealMid ε (m * v) (R_s ω) := by
        unfold dyadicRealMid
        rw [hkr']
      dsimp only [O, rowObs6]
      rw [hT, hkc', hkr', hC, hR]
  have h_prob_Tkc : ∀ ω : Fin N_ω,
      finProbAt π (fun ω' => (T ω', kc ω')) ω = finProbAt2 π T kc ω := by
    intro ω
    dsimp only [finProbAt, finProbAt2]
    refine Finset.sum_congr rfl (fun ω' _ => ?_)
    simp [Prod.ext_iff]
  have h_prob_Tkckr : ∀ ω : Fin N_ω,
      finProbAt2 π (fun ω' => (T ω', kc ω')) kr ω = finProbAt2 π T O ω := by
    intro ω
    dsimp only [finProbAt2]
    refine Finset.sum_congr rfl (fun ω' _ => ?_)
    by_cases h : T ω' = T ω ∧ O ω' = O ω
    · rcases (h_TO_iff ω' ω).mp h with ⟨⟨hT, hkc⟩, hkr⟩
      simp [hT, hkc, hkr, h.2]
    · have h' : ¬ ((T ω', kc ω') = (T ω, kc ω) ∧ kr ω' = kr ω) := fun hc =>
        h ((h_TO_iff ω' ω).mpr ⟨⟨congrArg Prod.fst hc.1, congrArg Prod.snd hc.1⟩, hc.2⟩)
      simp only [h', h, ↓reduceIte]
  have h_c4 : ∀ ω : Fin N_ω, 0 < π ω →
      condSurprise ε π T O ω =
        condSurprise ε π T kc ω + condSurprise ε π (fun ω' => (T ω', kc ω')) kr ω := by
    intro ω hpos
    unfold condSurprise
    rw [h_prob_Tkc ω, h_prob_Tkckr ω]
    have hp_T : 0 < finProbAt π T ω := h_prob1_pos T ω hpos
    have hp_Tkc : 0 < finProbAt2 π T kc ω := h_prob2_pos T kc ω hpos
    have hp_TO : 0 < finProbAt2 π T O ω := h_prob2_pos T O ω hpos
    have h_mul : finProbAt2 π T O ω / finProbAt π T ω =
        (finProbAt2 π T O ω / finProbAt2 π T kc ω) *
          (finProbAt2 π T kc ω / finProbAt π T ω) := by
      have h1 : finProbAt π T ω ≠ 0 := hp_T.ne'
      have h2 : finProbAt2 π T kc ω ≠ 0 := hp_Tkc.ne'
      field_simp
    have h_log : Real.log (finProbAt2 π T O ω / finProbAt π T ω) =
        Real.log (finProbAt2 π T O ω / finProbAt2 π T kc ω) +
          Real.log (finProbAt2 π T kc ω / finProbAt π T ω) := by
      rw [h_mul]
      exact Real.log_mul (div_ne_zero hp_TO.ne' hp_Tkc.ne') (div_ne_zero hp_Tkc.ne' hp_T.ne')
    rw [h_log]
    ring
  have h_c5 : finCondEntropy ε π T O =
      finCondEntropy ε π T kc + finCondEntropy ε π (fun ω' => (T ω', kc ω')) kr := by
    unfold finCondEntropy
    rw [← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl (fun ω _ => ?_)
    by_cases hpos : 0 < π ω
    · rw [h_c4 ω hpos, mul_add]
    · have h0 : π ω = 0 := le_antisymm (not_lt.mp hpos) (hπ_nn ω)
      simp [h0]
  have h_c6 : finCondEntropy ε π (fun _ => ()) O =
      finMutualInfo ε π T O + finCondEntropy ε π T kc +
        finCondEntropy ε π (fun ω' => (T ω', kc ω')) kr := by
    unfold finMutualInfo
    linarith [h_c5]
  exact ⟨@h_c1, @h_c2, @h_c3, h_c4, h_c5, h_c6⟩

theorem real_cone_row_obs_surprise_concentration (γ m : ℝ) (hγ₀ : 0 < γ) (hγ₁ : γ < 1) (hm : 0 < m)
    (sys : MatchedAspectProfileSystem γ m)
    (N_pts : ℕ) (p : Fin N_pts → (Fin 4 → ℝ) × ℝ)
    (hp_cone : ∀ r : Fin N_pts,
      InResolutionCone 4 ![0, 1, m, 1 + m] E_cone4 (p r))
    (δ_pt : ℝ) (hδ_pt : 0 < δ_pt) :
    ∀ᶠ k : ℕ in Filter.atTop,
      ∃ E_pts : Finset (Fin (sys.N_ω k)),
        (∀ ω ∈ E_pts, 0 < sys.π_seq k ω) ∧
        1 - δ_pt ≤ (∑ ω ∈ E_pts, sys.π_seq k ω) ∧
        ∀ ω ∈ E_pts, ∀ r : Fin N_pts,
          let ε := sys.ε_seq k
          let O_r := fun ω' : Fin (sys.N_ω k) =>
            rowObs6 ε m (sys.V_seq k (sys.T_seq k ω')) (sys.A_seq k (sys.T_seq k ω'))
              (sys.c_seq k ω') (sys.R_seq k ω')
              ((p r).1 0, (p r).1 1, (p r).1 2, (p r).1 3, (p r).2)
          let k_c := fun ω' : Fin (sys.N_ω k) =>
            dyadicTimeBin ε (p r).2 (sys.c_seq k ω')
          let k_r := fun ω' : Fin (sys.N_ω k) =>
            dyadicRealBin ε (m * (p r).2) (sys.R_seq k ω')
          |condSurprise ε (sys.π_seq k) (fun _ => ()) O_r ω -
            (sys.f_raw (p r) + sys.S (p r).2)| ≤ δ_pt ∧
          |condSurprise ε (sys.π_seq k) (sys.T_seq k) k_c ω -
            sys.S (p r).2| ≤ δ_pt ∧
          |condSurprise ε (sys.π_seq k)
            (fun ω' => (sys.T_seq k ω', k_c ω')) k_r ω| ≤ δ_pt :=
by
  obtain ⟨hs1_fib, hs1_ui, _, _⟩ := bounded_fiber_surprise_and_restriction_transfer
  let ell_fn : ℕ → ℝ := fun k => Real.log ((sys.ε_seq k)⁻¹)
  have hell_pos : ∀ k : ℕ, 0 < ell_fn k := by
    intro k
    have hε₀ := (sys.hε_bounds k).1
    have hε₁ := (sys.hε_bounds k).2
    have h_gt1 : 1 < (sys.ε_seq k)⁻¹ := (one_lt_inv₀ hε₀).mpr (by linarith)
    exact Real.log_pos h_gt1
  have h_ell_inv : Filter.Tendsto (fun k => (ell_fn k)⁻¹) Filter.atTop (nhds 0) := by
    have h_gt0 : Filter.Tendsto sys.ε_seq Filter.atTop (nhdsWithin 0 (Set.Ioi 0)) :=
      tendsto_nhdsWithin_of_tendsto_nhds_of_eventually_within sys.ε_seq sys.hε_tendsto
        (Filter.Eventually.of_forall (fun k => (sys.hε_bounds k).1))
    have h_inv : Filter.Tendsto (fun k => (sys.ε_seq k)⁻¹) Filter.atTop Filter.atTop :=
      h_gt0.inv_tendsto_nhdsGT_zero
    have h_log : Filter.Tendsto ell_fn Filter.atTop Filter.atTop :=
      Real.tendsto_log_atTop.comp h_inv
    exact tendsto_inv_atTop_zero.comp h_log
  have h_eps_div_ell : Filter.Tendsto (fun k => sys.ε_seq k / ell_fn k) Filter.atTop (nhds 0) := by
    have h_mul := sys.hε_tendsto.mul h_ell_inv
    simpa [div_eq_mul_inv] using h_mul
  have h_rpow_tendsto : ∀ τ : ℝ, 0 < τ →
      Filter.Tendsto (fun k => (sys.ε_seq k) ^ τ) Filter.atTop (nhds 0) := by
    intro τ hτ
    have hc := (Real.continuousAt_rpow_const 0 τ (Or.inr hτ.le)).tendsto.comp sys.hε_tendsto
    rwa [Real.zero_rpow hτ.ne'] at hc
  have h_log_bound : ∀ (k N₁ N₂ : ℕ) (C β : ℝ),
      1 ≤ N₂ → N₂ ≤ N₁ → 0 < C →
      (N₁ : ℝ) ≤ C * (sys.ε_seq k) ^ (-β) →
      Real.log (max (N₁ : ℝ) (N₂ : ℝ)) / ell_fn k ≤ Real.log C * (ell_fn k)⁻¹ + β := by
    intro k N₁ N₂ C β hN₂_pos hN₂₁ hC hN₁_le
    have hε₀ : 0 < sys.ε_seq k := (sys.hε_bounds k).1
    have hmax : max (N₁ : ℝ) (N₂ : ℝ) = (N₁ : ℝ) := max_eq_left (by exact_mod_cast hN₂₁)
    have hN₁_pos : (0 : ℝ) < (N₁ : ℝ) := by
      have : 1 ≤ N₁ := le_trans hN₂_pos hN₂₁
      exact_mod_cast (by omega : 0 < N₁)
    have hlog_le : Real.log (N₁ : ℝ) ≤ Real.log C + β * ell_fn k := by
      calc Real.log (N₁ : ℝ)
          ≤ Real.log (C * (sys.ε_seq k) ^ (-β)) := Real.log_le_log hN₁_pos hN₁_le
        _ = Real.log C + Real.log ((sys.ε_seq k) ^ (-β)) :=
            Real.log_mul hC.ne' (Real.rpow_pos_of_pos hε₀ (-β)).ne'
        _ = Real.log C + (-β) * Real.log (sys.ε_seq k) := by rw [Real.log_rpow hε₀]
        _ = Real.log C + β * ell_fn k := by
            dsimp [ell_fn]
            rw [Real.log_inv]
            ring
    rw [hmax]
    have hell_k_pos : 0 < ell_fn k := hell_pos k
    have hdiv := div_le_div_of_nonneg_right hlog_le hell_k_pos.le
    have hsplit : (Real.log C + β * ell_fn k) / ell_fn k = Real.log C * (ell_fn k)⁻¹ + β := by
      rw [add_div, mul_div_cancel_right₀ β hell_k_pos.ne', div_eq_mul_inv]
    linarith
  have h_single : ∀ (pt : (Fin 4 → ℝ) × ℝ),
      InResolutionCone 4 ![0, 1, m, 1 + m] E_cone4 pt →
      ∀ (δ_mass : ℝ), 0 < δ_mass →
      ∀ᶠ k : ℕ in Filter.atTop,
        ∃ E_pt : Finset (Fin (sys.N_ω k)),
          (∀ ω ∈ E_pt, 0 < sys.π_seq k ω) ∧
          1 - δ_mass ≤ (∑ ω ∈ E_pt, sys.π_seq k ω) ∧
          ∀ ω ∈ E_pt,
            let ε := sys.ε_seq k
            let O_p := fun ω' : Fin (sys.N_ω k) =>
              rowObs6 ε m (sys.V_seq k (sys.T_seq k ω')) (sys.A_seq k (sys.T_seq k ω'))
                (sys.c_seq k ω') (sys.R_seq k ω')
                (pt.1 0, pt.1 1, pt.1 2, pt.1 3, pt.2)
            let kc_p := fun ω' : Fin (sys.N_ω k) =>
              dyadicTimeBin ε pt.2 (sys.c_seq k ω')
            let kr_p := fun ω' : Fin (sys.N_ω k) =>
              dyadicRealBin ε (m * pt.2) (sys.R_seq k ω')
            |condSurprise ε (sys.π_seq k) (fun _ => ()) O_p ω -
              (sys.f_raw pt + sys.S pt.2)| ≤ δ_pt ∧
            |condSurprise ε (sys.π_seq k) (sys.T_seq k) kc_p ω -
              sys.S pt.2| ≤ δ_pt ∧
            |condSurprise ε (sys.π_seq k)
              (fun ω' => (sys.T_seq k ω', kc_p ω')) kr_p ω| ≤ δ_pt := by
    intro pt hp δ_mass hδ_mass
    let L : Fin 4 → ℝ := pt.1
    let v : ℝ := pt.2
    have hv₀ : 0 < v := hp.1.1
    have hv₁ : v < 1 := hp.1.2
    have hp_Lv : InResolutionCone 4 ![0, 1, m, 1 + m] E_cone4 (L, v) := hp
    let η_rat : ℝ := min (δ_pt / (4 * (2 * (5 + m) + 2))) ((1 - v) / 2)
    have hη_denom_pos : 0 < 4 * (2 * (5 + m) + 2) := by positivity
    have hη_rat : 0 < η_rat := lt_min (div_pos hδ_pt hη_denom_pos) (by linarith)
    have hη_rat_cap : (2 * (5 + m) + 2) * η_rat ≤ δ_pt / 4 := by
      have h1 : η_rat ≤ δ_pt / (4 * (2 * (5 + m) + 2)) := min_le_left _ _
      have h2 := mul_le_mul_of_nonneg_left h1 (by positivity : 0 ≤ 2 * (5 + m) + 2)
      have hne : (2 * (5 + m) + 2 : ℝ) ≠ 0 := by positivity
      have h_eq : (2 * (5 + m) + 2) * (δ_pt / (4 * (2 * (5 + m) + 2))) = δ_pt / 4 := by
        field_simp [hne]
      linarith
    let δ_hom : ℝ := min (δ_pt / 4) (δ_mass / 4)
    have hδ_hom : 0 < δ_hom := lt_min (by positivity) (by positivity)
    have hδ_hom_pt : δ_hom ≤ δ_pt / 4 := min_le_left _ _
    have hδ_hom_mass : δ_hom ≤ δ_mass / 4 := min_le_right _ _
    obtain ⟨q_v, hqv_gt, hqv_lt⟩ := exists_rat_btwn (by linarith : v < v + η_rat)
    obtain ⟨q₀, hq₀_gt, hq₀_lt⟩ := exists_rat_btwn (by linarith : L 0 < L 0 + η_rat)
    obtain ⟨q₁, hq₁_gt, hq₁_lt⟩ := exists_rat_btwn (by linarith : L 1 < L 1 + η_rat)
    obtain ⟨q₂, hq₂_gt, hq₂_lt⟩ := exists_rat_btwn (by linarith : L 2 < L 2 + η_rat)
    obtain ⟨q₃, hq₃_gt, hq₃_lt⟩ := exists_rat_btwn (by linarith : L 3 < L 3 + η_rat)
    have hqv_ioo : (q_v : ℝ) ∈ Set.Ioo (0 : ℝ) 1 := by
      refine ⟨by linarith, ?_⟩
      have hη_le : η_rat ≤ (1 - v) / 2 := min_le_right _ _
      linarith
