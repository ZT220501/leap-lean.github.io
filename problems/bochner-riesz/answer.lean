              _ = -(p o d * Real.log (p o d / p_D d)) := by rw [hmul]
          · simp only [hbd, ↓reduceIte]
            rw [Finset.mul_sum]
            refine Finset.sum_eq_zero (fun o _ => ?_)
            have hpb0 : p_b b o d = 0 := by simp [p_b, hbd]
            simp [hpb0]
        · simp only [hπ, ↓reduceIte]
          refine (Finset.sum_eq_zero (fun d hd => ?_)).symm
          have hbd := (Finset.mem_filter.mp hd).2
          exact Finset.sum_eq_zero (fun o _ => by simp [hπ_zero_p b hπ o d hbd])
      simp_rw [h_b]
      rw [h_sum_fib bin_D _ _, Finset.sum_comm]
    have hT1_le : T1 p ≤
        (∑ b : Fin S_bins, if 0 < π_b b then π_b b * T1 (p_b b) else 0) +
          Real.log (S_bins : ℝ) := by
      have hT1_p : T1 p = ∑ b : Fin S_bins, ∑ o : Fin N_O, -(P_OB o b * Real.log (p_O o)) := by
        dsimp only [T1]
        have h1 : ∀ o : Fin N_O,
            -(p_O o * Real.log (p_O o)) = ∑ b : Fin S_bins, -(P_OB o b * Real.log (p_O o)) := by
          intro o
          rw [Finset.sum_neg_distrib, ← Finset.sum_mul, hPOB_sum_b o]
        exact (Finset.sum_congr rfl (fun o _ => h1 o)).trans Finset.sum_comm
      have hpt : ∀ (b : Fin S_bins) (o : Fin N_O),
          -(P_OB o b * Real.log (p_O o)) ≤
            (if 0 < π_b b then π_b b * -(pb_O b o * Real.log (pb_O b o)) else 0) +
              -(P_OB o b * Real.log (π_b b)) := by
        intro b o
        by_cases h0 : P_OB o b = 0
        · by_cases hπ : 0 < π_b b
          · have hpb0 : pb_O b o = 0 := by rw [hpb_O b hπ o, h0, zero_div]
            simp [h0, hπ, hpb0]
          · simp [h0, hπ]
        · have hpos : 0 < P_OB o b := lt_of_le_of_ne (hPOB_nn o b) (Ne.symm h0)
          have hle_π : P_OB o b ≤ π_b b :=
            Finset.single_le_sum (fun o' _ => hPOB_nn o' b) (Finset.mem_univ o)
          have hπ : 0 < π_b b := lt_of_lt_of_le hpos hle_π
          have hle_pO : P_OB o b ≤ p_O o := by
            rw [← hPOB_sum_b o]
            exact Finset.single_le_sum (fun b' _ => hPOB_nn o b') (Finset.mem_univ b)
          have hpO_pos : 0 < p_O o := lt_of_lt_of_le hpos hle_pO
          have hpbO_eq : pb_O b o = P_OB o b / π_b b := hpb_O b hπ o
          have hpbO_pos : 0 < pb_O b o := by rw [hpbO_eq]; exact div_pos hpos hπ
          have hpbO_le : pb_O b o ≤ p_O o / π_b b := by
            rw [hpbO_eq]
            exact div_le_div_of_nonneg_right hle_pO hπ.le
          have hlog_le : Real.log (pb_O b o) ≤ Real.log (p_O o) - Real.log (π_b b) := by
            rw [← Real.log_div hpO_pos.ne' hπ.ne']
            exact Real.log_le_log hpbO_pos hpbO_le
          have hmul_le := mul_le_mul_of_nonneg_left
            (show -Real.log (p_O o) ≤ -Real.log (pb_O b o) - Real.log (π_b b) by linarith only [hlog_le])
            hpos.le
          simp only [hπ, ↓reduceIte]
          have hprod : π_b b * pb_O b o = P_OB o b := by
            rw [hpbO_eq, mul_div_cancel₀ _ hπ.ne']
          have h_alg : π_b b * -(pb_O b o * Real.log (pb_O b o)) + -(P_OB o b * Real.log (π_b b)) =
              P_OB o b * (-Real.log (pb_O b o) - Real.log (π_b b)) := by
            rw [← hprod]; ring
          linarith only [hmul_le, h_alg]
      have h_b : ∀ b : Fin S_bins,
          (∑ o : Fin N_O, -(P_OB o b * Real.log (p_O o))) ≤
            (if 0 < π_b b then π_b b * T1 (p_b b) else 0) + -(π_b b * Real.log (π_b b)) := by
        intro b
        have hs := Finset.sum_le_sum (fun o (_ : o ∈ Finset.univ) => hpt b o)
        have hneg : (∑ o : Fin N_O, -(P_OB o b * Real.log (π_b b))) =
            -(π_b b * Real.log (π_b b)) := by
          rw [Finset.sum_neg_distrib, ← Finset.sum_mul, hPOB_sum_o b]
        have h_ite_sum :
            (∑ o : Fin N_O, if 0 < π_b b then π_b b * -(pb_O b o * Real.log (pb_O b o)) else 0) =
              if 0 < π_b b then π_b b * T1 (p_b b) else 0 := by
          by_cases hπ : 0 < π_b b
          · simp only [hπ, ↓reduceIte, ← Finset.mul_sum]
            rfl
          · simp [hπ]
        rwa [Finset.sum_add_distrib, hneg, h_ite_sum] at hs
      have hsum_b := Finset.sum_le_sum (fun b (_ : b ∈ Finset.univ) => h_b b)
      rw [← hT1_p, Finset.sum_add_distrib] at hsum_b
      have hS_pos : 0 < (S_bins : ℝ) := Nat.cast_pos.mpr (Nat.lt_of_lt_of_le Nat.zero_lt_one hS)
      have hent_π : (∑ b : Fin S_bins, -(π_b b * Real.log (π_b b))) ≤ Real.log (S_bins : ℝ) :=
        h_card_ent_one Finset.univ π_b (S_bins : ℝ) (fun b _ => hπ_nn b) hπ_sum hS_pos (by simp)
      linarith only [hsum_b, hent_π]
    have hscore_split :
        (∑ b : Fin S_bins, if 0 < π_b b then π_b b * score_fn (p_b b) else 0) =
          (∑ b : Fin S_bins, if 0 < π_b b then π_b b * T1 (p_b b) else 0) / ell +
          (1 / 2 : ℝ) * ((∑ b : Fin S_bins, if 0 < π_b b then π_b b * T2 (p_b b) else 0) / ell) +
          (3 / 2 : ℝ) * ((∑ b : Fin S_bins, if 0 < π_b b then π_b b * T3 (p_b b) else 0) / ell) +
          (1 / 2 : ℝ) * (∑ b : Fin S_bins, if 0 < π_b b then π_b b * T4 (p_b b) else 0) := by
      have hterm : ∀ b : Fin S_bins,
          (if 0 < π_b b then π_b b * score_fn (p_b b) else 0) =
            (if 0 < π_b b then π_b b * T1 (p_b b) else 0) / ell +
            (1 / 2 : ℝ) * ((if 0 < π_b b then π_b b * T2 (p_b b) else 0) / ell) +
            (3 / 2 : ℝ) * ((if 0 < π_b b then π_b b * T3 (p_b b) else 0) / ell) +
            (1 / 2 : ℝ) * (if 0 < π_b b then π_b b * T4 (p_b b) else 0) := by
        intro b
        by_cases hπ : 0 < π_b b
        · simp only [hπ, ↓reduceIte, score_fn, T1, T2, T3, T4]
          ring
        · simp [hπ]
      simp_rw [hterm, Finset.sum_add_distrib, ← Finset.mul_sum, ← Finset.sum_div]
    rw [hscore_split, hT2_eq, hT3_eq, hT4_eq]
    have hT1_div : T1 p / ell ≤
        (∑ b : Fin S_bins, if 0 < π_b b then π_b b * T1 (p_b b) else 0) / ell +
          Real.log (S_bins : ℝ) / ell := by
      rw [← add_div]
      exact div_le_div_of_nonneg_right hT1_le hell_nn
    change T1 p / ell + (1 / 2 : ℝ) * (T2 p / ell) + (3 / 2 : ℝ) * (T3 p / ell) +
        (1 / 2 : ℝ) * T4 p ≤ _
    have h_alg :
        ((∑ b : Fin S_bins, if 0 < π_b b then π_b b * T1 (p_b b) else 0) / ell +
          (1 / 2 : ℝ) * (T2 p / ell) + (3 / 2 : ℝ) * (T3 p / ell) + (1 / 2 : ℝ) * T4 p) +
          Real.log (S_bins : ℝ) / ell =
        ((∑ b : Fin S_bins, if 0 < π_b b then π_b b * T1 (p_b b) else 0) / ell +
          Real.log (S_bins : ℝ) / ell) +
          (1 / 2 : ℝ) * (T2 p / ell) + (3 / 2 : ℝ) * (T3 p / ell) + (1 / 2 : ℝ) * T4 p := by ring
    rw [h_alg]
    exact add_le_add (add_le_add (add_le_add hT1_div le_rfl) le_rfl) le_rfl

  
  
  
  · intro N_O N_D N_Z N_T N_R p m_O Z_of r_Z r_D T_of_Z K_mass M_amb
      hK_mass hM_amb hp_nn hp_sum hm_pos hr_sync hZ_fib hM_card
    letI := Classical.propDecidable
    intro p_O p_D p_ZD q q_T q_TD q_TR
    let F_z : Fin N_Z → Finset (Fin N_O) := fun z => Finset.univ.filter (fun o => Z_of o = z)
    let p_Z : Fin N_Z → ℝ := fun z => ∑ o ∈ F_z z, p_O o
    let w_O : Fin N_O → ℝ := fun o => if 0 < p_O o then m_O o else 0
    let q_ZT : Fin N_Z → Fin N_T → ℝ := fun z α => ∑ d : Fin N_D, q z d α
    have hpO_nn : ∀ o, 0 ≤ p_O o := fun o => Finset.sum_nonneg (fun d _ => hp_nn o d)
    have hpD_nn : ∀ d, 0 ≤ p_D d := fun d => Finset.sum_nonneg (fun o _ => hp_nn o d)
    have hpZD_nn : ∀ z d, 0 ≤ p_ZD z d := fun z d => Finset.sum_nonneg (fun o _ => hp_nn o d)
    have hpZ_nn : ∀ z, 0 ≤ p_Z z := fun z => Finset.sum_nonneg (fun o _ => hpO_nn o)
    have hpZ_eq : ∀ z, ∑ d : Fin N_D, p_ZD z d = p_Z z := fun z => Finset.sum_comm
    have hpZD_sum_z : ∀ d, ∑ z : Fin N_Z, p_ZD z d = p_D d :=
      fun d => h_sum_fib Z_of (fun o => p o d) _
    have hpZ_sum : ∑ z : Fin N_Z, p_Z z = 1 :=
      (h_sum_fib Z_of p_O _).trans hp_sum
    have hpD_sum : ∑ d : Fin N_D, p_D d = 1 := Finset.sum_comm.trans hp_sum
    have hq_nn : ∀ z d α, 0 ≤ q z d α := by
      intro z d α
      dsimp only [q]
      split_ifs
      · exact div_nonneg (hpZD_nn z d) (Nat.cast_nonneg _)
      · exact le_rfl
    have hT_ne_of_pZ : ∀ z, 0 < p_Z z → (T_of_Z z).Nonempty :=
      fun z hpz => (hZ_fib z hpz).1
    have hT_ne_of_pZD : ∀ z d, 0 < p_ZD z d → (T_of_Z z).Nonempty := by
      intro z d hpzd
      refine hT_ne_of_pZ z (lt_of_lt_of_le hpzd ?_)
      rw [← hpZ_eq z]
      exact Finset.single_le_sum (fun d' _ => hpZD_nn z d') (Finset.mem_univ d)
    have hq_sum_α : ∀ z d, ∑ α : Fin N_T, q z d α = p_ZD z d :=
      fun z d => h_unif_sum (T_of_Z z) (p_ZD z d) _ (hpZD_nn z d) (hT_ne_of_pZD z d)
    have hq_tot : ∑ z, ∑ d, ∑ α, q z d α = 1 := by
      simp_rw [hq_sum_α, hpZ_eq, hpZ_sum]
    have hq_supp : ∀ z d α, 0 < q z d α →
        α ∈ T_of_Z z ∧ ∃ o, Z_of o = z ∧ 0 < p o d := by
      intro z d α hq_pos
      dsimp only [q] at hq_pos
      by_cases hα : α ∈ T_of_Z z
      · simp only [hα, ↓reduceIte] at hq_pos
        have hcard_pos : 0 < ((T_of_Z z).card : ℝ) :=
          Nat.cast_pos.mpr (Finset.card_pos.mpr ⟨α, hα⟩)
        have hpzd_pos : 0 < p_ZD z d := (div_pos_iff_of_pos_right hcard_pos).mp hq_pos
        obtain ⟨o, ho, hpod⟩ :=
          (Finset.sum_pos_iff_of_nonneg (fun o' _ => hp_nn o' d)).mp hpzd_pos
        exact ⟨hα, o, (Finset.mem_filter.mp ho).2, hpod⟩
      · simp only [hα, ↓reduceIte] at hq_pos
        exact False.elim (lt_irrefl 0 hq_pos)
    have hq_sync : ∀ z d α, 0 < q z d α → r_Z z = r_D d := by
      intro z d α hq_pos
      obtain ⟨_, o, hzo, hpod⟩ := hq_supp z d α hq_pos
      rw [← hzo]
      exact hr_sync o d hpod
    refine ⟨hq_nn, hq_tot, hq_supp, ?_⟩

    
    have hw_nn : ∀ o, 0 ≤ w_O o := by
      intro o; dsimp only [w_O]; split_ifs with h
      · exact (hm_pos o h).le
      · exact le_rfl
    have hw_pos : ∀ o, 0 < p_O o → 0 < w_O o := by
      intro o hpO; dsimp only [w_O]; simp only [hpO, ↓reduceIte]; exact hm_pos o hpO
    have hw_log_O : ∀ o, p_O o * Real.log (m_O o) = p_O o * Real.log (w_O o) := by
      intro o; dsimp only [w_O]
      by_cases hpO : 0 < p_O o
      · simp only [hpO, ↓reduceIte]
      · have hpO0 : p_O o = 0 := le_antisymm (not_lt.mp hpO) (hpO_nn o)
        simp [hpO0]
    have hw_log_OD : ∀ o d, p o d * Real.log (m_O o) = p o d * Real.log (w_O o) := by
      intro o d; dsimp only [w_O]
      by_cases hpO : 0 < p_O o
      · simp only [hpO, ↓reduceIte]
      · have hpO0 : p_O o = 0 := le_antisymm (not_lt.mp hpO) (hpO_nn o)
        have hpod0 : p o d = 0 :=
          (Finset.sum_eq_zero_iff_of_nonneg (fun d' _ => hp_nn o d')).mp hpO0 d (Finset.mem_univ d)
        simp [hpod0]
    have hfib_uncond : ∀ z : Fin N_Z,
        (∑ o ∈ F_z z, (-(p_O o * Real.log (p_O o)) + p_O o * Real.log (w_O o))) ≤
          -(p_Z z * Real.log (p_Z z)) + p_Z z * Real.log ((T_of_Z z).card : ℝ) +
            p_Z z * Real.log K_mass := by
      intro z
      by_cases hpz0 : p_Z z = 0
      · have ho0 : ∀ o ∈ F_z z, p_O o = 0 :=
          (Finset.sum_eq_zero_iff_of_nonneg (fun o _ => hpO_nn o)).mp hpz0
        rw [hpz0, Finset.sum_eq_zero (fun o ho => by simp [ho0 o ho])]
        simp
      · have hpz_pos : 0 < p_Z z := lt_of_le_of_ne (hpZ_nn z) (Ne.symm hpz0)
        obtain ⟨hne_z, hmass_z⟩ := hZ_fib z hpz_pos
        have hcard_pos : 0 < ((T_of_Z z).card : ℝ) := Nat.cast_pos.mpr (Finset.card_pos.mpr hne_z)
        let B_z := K_mass * ((T_of_Z z).card : ℝ)
        have hBz_pos : 0 < B_z := mul_pos hK_mass hcard_pos
        have hsplit := h_sum_ent_split_one (F_z z) p_O (p_Z z) (fun o _ => hpO_nn o) rfl
        have hg := h_gibbs (F_z z) p_O w_O (p_Z z) B_z
          (fun o _ => hpO_nn o) rfl hBz_pos (fun o _ => hw_nn o) (fun o _ => hw_pos o) hmass_z
        rw [Finset.sum_add_distrib] at hg ⊢
        rw [hsplit]
        have hlogB : Real.log B_z = Real.log K_mass + Real.log ((T_of_Z z).card : ℝ) :=
          Real.log_mul hK_mass.ne' hcard_pos.ne'
        rw [hlogB] at hg
        linarith only [hg]
    have hfib_cond : ∀ (z : Fin N_Z) (d : Fin N_D),
        (∑ o ∈ F_z z, (-(p o d * Real.log (p o d / p_D d)) + p o d * Real.log (w_O o))) ≤
          -(p_ZD z d * Real.log (p_ZD z d / p_D d)) +
            p_ZD z d * Real.log ((T_of_Z z).card : ℝ) + p_ZD z d * Real.log K_mass := by
      intro z d
      by_cases hpz0 : p_Z z = 0
      · have hpzd0 : p_ZD z d = 0 := by
          have hle : p_ZD z d ≤ p_Z z := by
            rw [← hpZ_eq z]
            exact Finset.single_le_sum (fun d' _ => hpZD_nn z d') (Finset.mem_univ d)
          exact le_antisymm (hle.trans_eq hpz0) (hpZD_nn z d)
        have ho0 : ∀ o ∈ F_z z, p o d = 0 :=
          (Finset.sum_eq_zero_iff_of_nonneg (fun o _ => hp_nn o d)).mp hpzd0
        rw [hpzd0, Finset.sum_eq_zero (fun o ho => by simp [ho0 o ho])]
        simp
      · have hpz_pos : 0 < p_Z z := lt_of_le_of_ne (hpZ_nn z) (Ne.symm hpz0)
        obtain ⟨hne_z, hmass_z⟩ := hZ_fib z hpz_pos
        have hcard_pos : 0 < ((T_of_Z z).card : ℝ) := Nat.cast_pos.mpr (Finset.card_pos.mpr hne_z)
        let B_z := K_mass * ((T_of_Z z).card : ℝ)
        have hBz_pos : 0 < B_z := mul_pos hK_mass hcard_pos
        have hsplit := h_sum_ent_split (F_z z) (fun o => p o d) (p_ZD z d) (p_D d)
          (fun o _ => hp_nn o d) rfl
          (fun o _ hpod => lt_of_lt_of_le hpod
            (Finset.single_le_sum (fun o' _ => hp_nn o' d) (Finset.mem_univ o)))
        have hg := h_gibbs (F_z z) (fun o => p o d) w_O (p_ZD z d) B_z
          (fun o _ => hp_nn o d) rfl hBz_pos (fun o _ => hw_nn o)
          (fun o _ hpod => hw_pos o (lt_of_lt_of_le hpod
            (Finset.single_le_sum (fun d' _ => hp_nn o d') (Finset.mem_univ d))))
          hmass_z
        rw [Finset.sum_add_distrib] at hg ⊢
        rw [hsplit]
        have hlogB : Real.log B_z = Real.log K_mass + Real.log ((T_of_Z z).card : ℝ) :=
          Real.log_mul hK_mass.ne' hcard_pos.ne'
        rw [hlogB] at hg
        linarith only [hg]
    let H_O := ∑ o : Fin N_O, -(p_O o * Real.log (p_O o))
    let H_OD := ∑ o : Fin N_O, ∑ d : Fin N_D, -(p o d * Real.log (p o d / p_D d))
    let E_m := ∑ o : Fin N_O, p_O o * Real.log (m_O o)
    let H_Z := ∑ z : Fin N_Z, -(p_Z z * Real.log (p_Z z))
    let H_ZD := ∑ z : Fin N_Z, ∑ d : Fin N_D, -(p_ZD z d * Real.log (p_ZD z d / p_D d))
    let E_card := ∑ z : Fin N_Z, p_Z z * Real.log ((T_of_Z z).card : ℝ)
    have hsum_uncond : H_O + E_m ≤ H_Z + E_card + Real.log K_mass := by
      have hs := Finset.sum_le_sum (fun z (_ : z ∈ Finset.univ) => hfib_uncond z)
      rw [h_sum_fib Z_of _ _, Finset.sum_add_distrib,
        Finset.sum_add_distrib, Finset.sum_add_distrib, ← Finset.sum_mul, hpZ_sum, one_mul] at hs
      have hEm : (∑ o : Fin N_O, p_O o * Real.log (w_O o)) = E_m :=
        Finset.sum_congr rfl (fun o _ => (hw_log_O o).symm)
      rwa [hEm] at hs
    have hsum_cond : H_OD + E_m ≤ H_ZD + E_card + Real.log K_mass := by
      have hs : (∑ z : Fin N_Z, ∑ d : Fin N_D,
          ∑ o ∈ F_z z, (-(p o d * Real.log (p o d / p_D d)) + p o d * Real.log (w_O o))) ≤
        ∑ z : Fin N_Z, ∑ d : Fin N_D,
          (-(p_ZD z d * Real.log (p_ZD z d / p_D d)) +
            p_ZD z d * Real.log ((T_of_Z z).card : ℝ) + p_ZD z d * Real.log K_mass) :=
        Finset.sum_le_sum (fun z _ => Finset.sum_le_sum (fun d _ => hfib_cond z d))
      have hlhs : (∑ z : Fin N_Z, ∑ d : Fin N_D,
          ∑ o ∈ F_z z, (-(p o d * Real.log (p o d / p_D d)) + p o d * Real.log (w_O o))) =
            H_OD + E_m := by
        have h1 : ∀ z : Fin N_Z,
            (∑ d : Fin N_D, ∑ o ∈ F_z z,
              (-(p o d * Real.log (p o d / p_D d)) + p o d * Real.log (w_O o))) =
            ∑ o ∈ F_z z, ∑ d : Fin N_D,
              (-(p o d * Real.log (p o d / p_D d)) + p o d * Real.log (m_O o)) := by
          intro z
          rw [Finset.sum_comm]
          exact Finset.sum_congr rfl (fun o _ =>
            Finset.sum_congr rfl (fun d _ => by rw [hw_log_OD o d]))
        simp_rw [h1]
        rw [h_sum_fib Z_of _ _]
        simp_rw [Finset.sum_add_distrib, ← Finset.sum_mul]
        rfl
      have hrhs : (∑ z : Fin N_Z, ∑ d : Fin N_D,
          (-(p_ZD z d * Real.log (p_ZD z d / p_D d)) +
            p_ZD z d * Real.log ((T_of_Z z).card : ℝ) + p_ZD z d * Real.log K_mass)) =
            H_ZD + E_card + Real.log K_mass := by
        simp_rw [Finset.sum_add_distrib, ← Finset.sum_mul, hpZ_eq]
        rw [hpZ_sum, one_mul]
      rwa [hlhs, hrhs] at hs

    
    have hM_pos : 0 < (M_amb : ℝ) := Nat.cast_pos.mpr (Nat.lt_of_lt_of_le Nat.zero_lt_one hM_amb)
    have hqZT_eq : ∀ z α,
        q_ZT z α = if α ∈ T_of_Z z then p_Z z / ((T_of_Z z).card : ℝ) else 0 := by
      intro z α
      dsimp only [q_ZT, q]
      by_cases hα : α ∈ T_of_Z z
      · simp only [hα, ↓reduceIte, ← Finset.sum_div, hpZ_eq]
      · simp [hα]
    have hqZT_nn : ∀ z α, 0 ≤ q_ZT z α := fun z α => Finset.sum_nonneg (fun d _ => hq_nn z d α)
    have hqTR_nn : ∀ α rv, 0 ≤ q_TR α rv :=
      fun α rv => Finset.sum_nonneg (fun z _ => hqZT_nn z α)
    have hqTR_sum_rv : ∀ α, ∑ rv : Fin N_R, q_TR α rv = q_T α :=
      fun α => h_sum_fib r_Z (fun z => q_ZT z α) _
    have hqT_sum : ∑ α : Fin N_T, q_T α = 1 := by
      calc ∑ α : Fin N_T, q_T α
          = ∑ α : Fin N_T, ∑ z : Fin N_Z, ∑ d : Fin N_D, q z d α := rfl
        _ = ∑ z : Fin N_Z, ∑ α : Fin N_T, ∑ d : Fin N_D, q z d α := Finset.sum_comm
        _ = ∑ z : Fin N_Z, ∑ d : Fin N_D, ∑ α : Fin N_T, q z d α :=
            Finset.sum_congr rfl (fun _ _ => Finset.sum_comm)
        _ = 1 := hq_tot
    have hqTD_sum_α : ∀ d, ∑ α : Fin N_T, q_TD α d = p_D d := by
      intro d
      calc ∑ α : Fin N_T, ∑ z : Fin N_Z, q z d α
          = ∑ z : Fin N_Z, ∑ α : Fin N_T, q z d α := Finset.sum_comm
        _ = ∑ z : Fin N_Z, p_ZD z d := Finset.sum_congr rfl (fun z _ => hq_sum_α z d)
        _ = p_D d := hpZD_sum_z d
    let H_qT := ∑ α : Fin N_T, -(q_T α * Real.log (q_T α))
    let H_qTD := ∑ α : Fin N_T, ∑ d : Fin N_D, -(q_TD α d * Real.log (q_TD α d / p_D d))
    let H_qTR := ∑ α : Fin N_T, ∑ rv : Fin N_R, -(q_TR α rv * Real.log (q_TR α rv / q_T α))
    have hZT_eq :
        (∑ z : Fin N_Z, ∑ α : Fin N_T, -(q_ZT z α * Real.log (q_ZT z α))) = H_Z + E_card := by
      have hz : ∀ z : Fin N_Z,
          (∑ α : Fin N_T, -(q_ZT z α * Real.log (q_ZT z α))) =
            -(p_Z z * Real.log (p_Z z)) + p_Z z * Real.log ((T_of_Z z).card : ℝ) := by
        intro z
        have hcongr : (∑ α : Fin N_T, -(q_ZT z α * Real.log (q_ZT z α))) =
            ∑ α : Fin N_T,
              -((if α ∈ T_of_Z z then p_Z z / ((T_of_Z z).card : ℝ) else 0) *
                Real.log ((if α ∈ T_of_Z z then p_Z z / ((T_of_Z z).card : ℝ) else 0) / 1)) := by
          refine Finset.sum_congr rfl (fun α _ => ?_)
          rw [hqZT_eq z α, div_one]
        rw [hcongr]
        simpa [div_one] using h_unif_ent (T_of_Z z) (p_Z z) 1 inferInstance
          (hpZ_nn z) (hT_ne_of_pZ z) (fun _ => zero_lt_one)
      simp_rw [hz]
      exact Finset.sum_add_distrib
    have hZT_le : H_Z + E_card ≤ H_qT + H_qTR + Real.log (M_amb : ℝ) := by
      rw [← hZT_eq, Finset.sum_comm]
      have hα_le : ∀ α : Fin N_T,
          (∑ z : Fin N_Z, -(q_ZT z α * Real.log (q_ZT z α))) ≤
            -(q_T α * Real.log (q_T α)) +
              (∑ rv : Fin N_R, -(q_TR α rv * Real.log (q_TR α rv / q_T α))) +
              q_T α * Real.log (M_amb : ℝ) := by
