      have h_int_r : |(kang₂ : ℝ) - ((kang₁ : ℝ) - (s : ℝ) * (M_mu : ℝ))| ≤ (R_ang : ℝ) := by
        have h_id : (kang₂ : ℝ) - ((kang₁ : ℝ) - (s : ℝ) * (M_mu : ℝ)) =
            ((kang₂ : ℝ) - (θ_u2 / Real.pi) * (2 : ℝ) ^ m_mu) -
            ((kang₁ : ℝ) - (θ_u1 / Real.pi) * (2 : ℝ) ^ m_mu) +
            ((θ_u2 - θ_u1 + (s : ℝ) * Real.pi) / Real.pi) * (2 : ℝ) ^ m_mu := by
          rw [hM_mu_eq]
          have hpi_ne : Real.pi ≠ 0 := ne_of_gt Real.pi_pos
