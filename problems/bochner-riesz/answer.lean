        have hJ_f2 : 6 * (4 * ((2 : ℝ) ^ m₂)⁻¹ * ε ^ (-h)) + 4 ≤ 52 * ε ^ (-(h / 4)) := by
          have h1 : ((2 : ℝ) ^ m₂)⁻¹ * ε ^ (-h) ≤ (2 * ε ^ ((3 / 4 : ℝ) * h)) * ε ^ (-h) :=
            mul_le_mul_of_nonneg_right h2m2_inv_hi (Real.rpow_nonneg hε₀.le _)
          have h2 : (2 * ε ^ ((3 / 4 : ℝ) * h)) * ε ^ (-h) = 2 * ε ^ (-(h / 4)) := by
