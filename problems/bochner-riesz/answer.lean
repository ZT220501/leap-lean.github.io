                (mul_nonneg (mul_nonneg hKprod.le hKB.le) (hqB_nn b₁))
          _ = K_prod * K_B * q_B b₁ * δ_strip := by ring
      calc (∑ b₁, ∑ b₂, if |Δ_fn b₁ b₂| ≤ (1 / 16 : ℝ) * ρ_strip then (∑ a, W₂ a b₁ b₂) else 0)
          ≤ ∑ b₁, K_prod * K_B * q_B b₁ * δ_strip := Finset.sum_le_sum (fun b₁ _ => h_b1 b₁)
        _ = K_prod * K_B * δ_strip * ∑ b₁, q_B b₁ := by
            rw [Finset.mul_sum]; refine Finset.sum_congr rfl (fun _ _ => by ring)
        _ = K_prod * K_B * δ_strip := by rw [hqB_sum, mul_one]
        _ < 1 / 2 := h_strip_small
    have h_wide_gt : 1 / 2 < ∑ b₁, ∑ b₂,
        if (1 / 16 : ℝ) * ρ_strip < |Δ_fn b₁ b₂| then (∑ a, W₂ a b₁ b₂) else 0 := by
      have h_split : (∑ b₁, ∑ b₂,
