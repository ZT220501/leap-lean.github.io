      let q := r_idx / K
      let rl := r_idx % K
      let s_c := ((2 : ℝ) ^ m_r)⁻¹
      let C_r := ((q : ℝ) + 1 / 2) * s_c
      let C_t := ((r_idx : ℝ) + 1 / 2) * ((2 : ℝ) ^ m_t)⁻¹
