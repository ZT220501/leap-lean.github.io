theorem strip_two_replica_b0_slice_bound (s q z α : ℝ)
    (hs₀ : 0 < s) (hs₁ : s ≤ 1)
    (hq₁ : 1 < q) (hq₂ : q ≤ 2)
    (hz₀ : 0 ≤ z) (hz₁ : z < 1)
    (hα : 0 < α)
    (h_core : FiniteMarginalCoreBound)
    (h_proj : WeightedTaggedProjectionBound) :
    ∃ (η ρ₁ : ℝ), 0 < η ∧ 0 < ρ₁ ∧ ρ₁ < 1 / 2 ∧
      ∀ (N_P N_Θ : ℕ) (ρ ρ_tilde κ : ℝ)
        (e_n : EuclideanSpace ℝ (Fin 2)) (c₀ : ℝ)
        (π_orig π_tilde : Fin N_P → Fin N_Θ → ℝ)
        (P_pt : Fin N_P → Fin 4 → ℝ)
        (θ_lbl : Fin N_Θ → ℝ × ℝ),
        0 < ρ → ρ < 1 / 2 → ρ ≤ ρ_tilde → ρ_tilde < ρ₁ → 0 < κ →
        ρ ^ (-κ) ≤ ρ_tilde ^ (-η) →
        ‖e_n‖ = 1 →
        (∀ i j, |P_pt i j| ≤ 4) →
        (∀ b, |(θ_lbl b).1| ≤ 4 ∧ |(θ_lbl b).2| ≤ 4) →
        (∀ i b, 0 ≤ π_orig i b) →
        (∀ b : Fin N_Θ,
          let lam_b := ∑ i, π_orig i b
          0 < lam_b →
          ∀ (k_X : ℤ) (k_U : ℤ × ℤ) (k_Z : ℤ),
            letI := Classical.propDecidable
            let bX := fun i => canonicalGridBin ρ (canonicalShear4 (P_pt i) (θ_lbl b) 0)
            let bU := fun i => (canonicalGridBin ρ (canonicalShear4 (P_pt i) (θ_lbl b) 1),
                                canonicalGridBin ρ (canonicalShear4 (P_pt i) (θ_lbl b) 2))
            let bZ := fun i => canonicalGridBin ρ (canonicalShear4 (P_pt i) (θ_lbl b) 3)
            (∑ i : Fin N_P,
              if bX i = k_X ∧ bU i = k_U ∧ bZ i = k_Z then π_orig i b / lam_b else 0) ≤
            ρ ^ (-κ) *
              (∑ i, if bX i = k_X then π_orig i b / lam_b else 0) *
              (∑ i, if bU i = k_U then π_orig i b / lam_b else 0) *
              (∑ i, if bZ i = k_Z then π_orig i b / lam_b else 0)) →
        (∀ b : Fin N_Θ, ∀ (z₀ : EuclideanSpace ℝ (Fin 2)) (r : ℝ),
          let lam_b := ∑ i, π_orig i b
          0 < lam_b → ρ ≤ r → r ≤ 1 →
          letI := Classical.propDecidable
          (∑ i : Fin N_P,
            if ‖canonicalMidU ρ (P_pt i) (θ_lbl b) - z₀‖ < r
            then π_orig i b / lam_b else 0) ≤ ρ ^ (-κ) * r ^ q) →
        (∀ b : Fin N_Θ, ∀ (z₀ r : ℝ),
          let lam_b := ∑ i, π_orig i b
          0 < lam_b → ρ ≤ r → r ≤ 1 →
          letI := Classical.propDecidable
          (∑ i : Fin N_P,
            if |canonicalGridMid ρ (canonicalShear4 (P_pt i) (θ_lbl b) 3) - z₀| < r
            then π_orig i b / lam_b else 0) ≤ ρ ^ (-κ) * r ^ z) →
        (∀ b : Fin N_Θ, 0 < (∑ i, π_orig i b) →
          ∃ S_cov : Finset ℝ,
