        exact_mod_cast h_u
      have h_coef : (S_obs.card : ℝ) * (16 * (N_ret : ℝ) * E_far) ≤ 1 := by
        have h1 : (S_obs.card : ℝ) * (16 * (N_ret : ℝ) * E_far) ≤
