      change ‖(ρ_t⁻¹ : ℂ) * ∫ v, g_at v * ψ_o (ρ_t⁻¹ • (v - V_o)) *
        Complex.exp (Complex.I * ((lam_sys * Φ₀ (C_t, X_o, v) : ℝ) : ℂ))‖ ^ 2 = 0
      simp_rw [h_zero_fn, MeasureTheory.integral_zero]
      simp
    · intro e he M_sl hM_sl h_slice_bd
      obtain ⟨R_e, hR_e_app⟩ := h_rot_equiv e he
      have he_sq : (e 0) ^ 2 + (e 1) ^ 2 = 1 := by
        have h1 : ‖e‖ ^ 2 = 1 := by rw [he]; norm_num
        rw [PiLp.norm_sq_eq_of_L2, Fin.sum_univ_two] at h1
        simpa [Real.norm_eq_abs, sq_abs] using h1
      let G_z : EuclideanSpace ℝ (Fin 2) → ℂ := fun z =>
        (star (ψ_at z) * ψ_o (ρ_t⁻¹ • (V_at - V_o) + (ρ_r / ρ_t) • z)) *
          Complex.exp (Complex.I *
            ((lam_sys * (Φ₀ (C_t, X_o, V_at + ρ_r • z) -
