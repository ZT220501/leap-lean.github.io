                  (if J_fn ω = j then π ω else 0) *
                    condSurprise ε (π_j_fn j) (fun _ => ()) (G_loc j) ω := by
                  refine Finset.sum_congr rfl (fun j hj => ?_)
                  dsimp only [finCondEntropy]
                  rw [Finset.mul_sum]
                  refine Finset.sum_congr rfl (fun ω _ => ?_)
                  rw [← mul_assoc, (hπj_props j hj).2.2.2.2 ω]
