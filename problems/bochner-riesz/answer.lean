  have h_cramer : ∀ (N_A N_B : ℕ)
      (s_rate s_dir K_A K_B K_prod δ_strip ρ_strip δ_cov r_ball M_dir C_ball : ℝ)
      (a_mid : EuclideanSpace ℝ (Fin 2))
      (ξ : Fin N_A → EuclideanSpace ℝ (Fin 2))
      (θ_B : Fin N_B → EuclideanSpace ℝ (Fin 2))
      (μ_A : Fin N_A → ℝ) (μ_B : Fin N_B → ℝ)
      (q : Fin N_A → Fin N_B → ℝ),
      (s_dir = 1 ∨ s_dir = -1) →
      0 < K_A → 0 < K_B → 0 < K_prod →
      0 < ρ_strip → 0 ≤ δ_cov →
      0 < M_dir → 0 ≤ C_ball → 0 < r_ball →
      32 * δ_cov / ρ_strip < r_ball →
      (∀ a, 0 ≤ μ_A a) → (∀ b, 0 ≤ μ_B b) →
      (∀ a b, 0 ≤ q a b) → (∑ a, ∑ b, q a b = 1) →
      (∀ a b, 0 < q a b → 0 < ‖θ_B b - a_mid‖ ∧ ‖θ_B b - a_mid‖ ≤ 16) →
      (∀ a b, q a b ≤ K_prod * (∑ b', q a b') * (∑ a', q a' b)) →
      (∀ a, (∑ b, q a b) ≤ K_A * μ_A a) →
      (∀ b, (∑ a, q a b) ≤ K_B * μ_B b) →
      K_prod * K_B * δ_strip < 1 / 2 →
      (∀ (e : EuclideanSpace ℝ (Fin 2)) (c₀ : ℝ), ‖e‖ = 1 →
        (∑ b : Fin N_B, if |inner ℝ (θ_B b) e - c₀| ≤ ρ_strip then μ_B b else 0) ≤ δ_strip) →
      (∀ z₀ : EuclideanSpace ℝ (Fin 2),
        (∑ a : Fin N_A, if ‖ξ a - z₀‖ < r_ball then μ_A a else 0) ≤ C_ball * r_ball ^ s_rate) →
      (∀ b : Fin N_B, 0 < (∑ a, q a b) →
        ∃ S_cov : Finset ℝ,
