      have h_sm : |(1 / 2 : ℝ) * inner ℝ δV e_φ| = (1 / 2 : ℝ) * |inner ℝ δV e_φ| := by
        rw [abs_mul, abs_of_nonneg (by norm_num : (0 : ℝ) ≤ 1 / 2)]
      linarith
    have hU_pφ : |inner ℝ δU (perp2D e_φ)| ≤ 15 * d₂₁ := by
      dsimp [δU]
      rw [inner_add_left, inner_smul_left]
      simp only [RCLike.conj_to_real]
      have h_tri := abs_add_le (inner ℝ δA (perp2D e_φ)) ((1 / 2 : ℝ) * inner ℝ δV (perp2D e_φ))
      have h_sm : |(1 / 2 : ℝ) * inner ℝ δV (perp2D e_φ)| =
          (1 / 2 : ℝ) * |inner ℝ δV (perp2D e_φ)| := by
        rw [abs_mul, abs_of_nonneg (by norm_num : (0 : ℝ) ≤ 1 / 2)]
      linarith
    have h1 : |inner ℝ δU e_φ / d₂₀| ≤ 15 := by
      rw [abs_div, abs_of_pos hd₂₀_pos, div_le_iff₀ hd₂₀_pos]
