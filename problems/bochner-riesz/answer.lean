          _ = 1 := by rw [hpe₀_norm, hpe_c_norm, mul_one]
      calc |inner ℝ w e₀ * inner ℝ e₀ (perp2D e_c) + inner ℝ w (perp2D e₀) * inner ℝ (perp2D e₀) (perp2D e_c)|
          ≤ |inner ℝ w e₀ * inner ℝ e₀ (perp2D e_c)| +
              |inner ℝ w (perp2D e₀) * inner ℝ (perp2D e₀) (perp2D e_c)| := abs_add_le _ _
        _ = |inner ℝ w e₀| * |inner ℝ e₀ (perp2D e_c)| +
              |inner ℝ w (perp2D e₀)| * |inner ℝ (perp2D e₀) (perp2D e_c)| := by rw [abs_mul, abs_mul]
        _ ≤ |inner ℝ w e₀| * (6 * ε ^ v) + |inner ℝ w (perp2D e₀)| * 1 :=
