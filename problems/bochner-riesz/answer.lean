      linarith
    obtain ⟨N_j, lo', hN1, hN2, hlo'⟩ :=
      (h_s2 ε hε0 hε1).2.2.1 (m * u') (m * u' + d_j * h') h' hL_le hL_diff
    exact ⟨N_j, fun e => lo' e.2.1, hN1, hN2, fun ω _ => hlo' (sys.R_seq k ω)⟩

  let N₂_fn : Fin M → ℕ := fun j => Classical.choose (h_ico_stg2 j)
