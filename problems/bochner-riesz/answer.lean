      have hqb_eq_pA' : q_b b_sel =
          ∑ o : Fin N_O, ∑ d : Fin N_D, if E b_sel o d ∧ GoodFib_b b_sel (P_in o) then p o d else 0 := by
        dsimp [q_b, E']
        refine Finset.sum_congr rfl (fun o _ => Finset.sum_congr rfl (fun d _ => ?_))
        simp [hb_sel_mem]
      have hpA'_pos : 0 < ∑ o : Fin N_O, ∑ d : Fin N_D, if E b_sel o d ∧ GoodFib_b b_sel (P_in o) then p o d else 0 := by
        rwa [← hqb_eq_pA']
      have hcred_raw := hret_sel hpA'_pos
      rw [hκ_ret_inv] at hcred_raw
      have hp_sel_eq : p_sel = fun o d =>
          if E b_sel o d ∧ GoodFib_b b_sel (P_in o) then
            p o d / (∑ o₁ : Fin N_O, ∑ d₁ : Fin N_D, if E b_sel o₁ d₁ ∧ GoodFib_b b_sel (P_in o₁) then p o₁ d₁ else 0)
          else 0 := by
        ext o d
        dsimp [p_sel, q_bin]
        rw [hπ_cast, hqb_eq_pA']
        by_cases he : E b_sel o d ∧ GoodFib_b b_sel (P_in o)
        · have he' : E' b_sel o d := ⟨hb_sel_mem, he.1, he.2⟩
          rw [if_pos ⟨(hbin_iff b_sel o d).mpr he', hpA'_pos⟩, if_pos he]
        · have hne' : ¬ E' b_sel o d := fun hc => he ⟨hc.2.1, hc.2.2⟩
          rw [if_neg (fun hc => hne' ((hbin_iff b_sel o d).mp hc.1)), if_neg he]
      rwa [hp_sel_eq]

theorem two_copy_isotropic_normal_prediction (γ : ℝ) (hγ₀ : 0 < γ) (hγ₁ : γ < 1)
    (h_mod : UniformPacketGrowthModulus γ (quantumPacketRate γ))
    (h_perp_norm : ∀ u : EuclideanSpace ℝ (Fin 2), ‖perp2D u‖ = ‖u‖)
    (h_symm : ∀ u v : EuclideanSpace ℝ (Fin 2),
      ‖u‖ = 1 → ‖v‖ = 1 → projAngleDist u v = projAngleDist v u)
    (h_cramer : ∀ u v : EuclideanSpace ℝ (Fin 2),
      ‖u‖ = 1 → ‖v‖ = 1 →
      ∀ z : EuclideanSpace ℝ (Fin 2),
        projAngleDist u v * ‖z‖ ≤ |inner ℝ z u| + |inner ℝ z v|)
    (h_fib_ent : ∀ {ε : ℝ}, 0 < ε → ε < 1 / 2 →
      ∀ {N_X N_Y : ℕ} (P : Fin N_X → Fin N_Y → ℝ) {B_fib : ℝ},
        0 < B_fib → (∀ x y, 0 ≤ P x y) → (∑ x, ∑ y, P x y = 1) →
        (letI := Classical.propDecidable
         ∀ y : Fin N_Y, (0 < ∑ x, P x y) →
           ((Finset.univ.filter (fun x : Fin N_X => 0 < P x y)).card : ℝ) ≤ B_fib) →
        let P_Y := fun y => ∑ x, P x y
        (∑ x, ∑ y, -(P x y * Real.log (P x y / P_Y y))) / Real.log (ε⁻¹) ≤
          Real.log B_fib / Real.log (ε⁻¹)) :
    ∀ (cls : PacketBoundClass) (h e₀ ζ_sh δ_mod : ℝ) (M_L : ℕ),
      0 < h → 64 * h < γ * e₀ → 0 < ζ_sh → 64 * ζ_sh ≤ 2 * γ * e₀ - 28 * h →
      0 < δ_mod → 64 * δ_mod ≤ 2 * γ * e₀ - 28 * h → 64 ≤ M_L →
      ∃ ε_norm : ℝ, 0 < ε_norm ∧ ε_norm < 1 / 2 ∧
        ∀ (ε H_P L t lam_sys : ℝ) (m_r m_t N_O N_D : ℕ)
          (Φ₀ : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → ℝ)
          (ζ₀ : EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → EuclideanSpace ℝ (Fin 2))
          (f : EuclideanSpace ℝ (Fin 2) → ℂ)
          (τ_V τ_X : EuclideanSpace ℝ (Fin 2))
          (r_O : Fin N_O → ℕ) (V_O X_O : Fin N_O → EuclideanSpace ℝ (Fin 2))
          (ψ_O : Fin N_O → EuclideanSpace ℝ (Fin 2) → ℂ) (b_D a_D : Fin N_D → ℝ)
          (r_D : Fin N_D → ℕ) (e_D V_D X_D : Fin N_D → EuclideanSpace ℝ (Fin 2))
          (p : Fin N_O → Fin N_D → ℝ) (b_ref a_ref Δ_cur : ℝ),
          ε < ε_norm → 2 * h < t → t ≤ 1 → t ≤ L → t ≤ H_P →
          IsValidPacketEnv cls ε H_P L lam_sys Φ₀ ζ₀ f →
          ε ^ (t - 2 * h) ≤ ((2 : ℝ) ^ m_r)⁻¹ → ((2 : ℝ) ^ m_r)⁻¹ ≤ 2 * ε ^ (t - 2 * h) →
          m_r ≤ m_t → cls.B_sys⁻¹ * ε ^ t ≤ ((2 : ℝ) ^ m_t)⁻¹ → ((2 : ℝ) ^ m_t)⁻¹ ≤ cls.B_sys * ε ^ t →
          IsAdmissiblePacketLaw ε H_P L t cls.B_sys cls.R_win cls.N_mult cls.M_win
            lam_sys m_t Φ₀ f N_O N_D r_O V_O X_O ψ_O b_D a_D r_D e_D V_D X_D p →
          e₀ ≤ a_ref - b_ref → (H_P - t) / 2 - ζ_sh ≤ a_ref →
          (∀ o d, 0 < p o d → |b_D d - b_ref| ≤ ζ_sh ∧ |a_D d - a_ref| ≤ ζ_sh) →
          64 * Δ_cur ≤ 2 * γ * e₀ - 28 * h →
          generalPacketRootScore ε H_P L cls.R_dom γ lam_sys Φ₀ f +
            quantumPacketRate γ * t - Δ_cur ≤
            generalPacketScore ε γ H_P t lam_sys m_t Φ₀ f N_O N_D r_O V_O X_O ψ_O b_D a_D p →
          ∃ n_buf : (ℕ × (ℤ × ℤ) × (ℤ × ℤ)) → EuclideanSpace ℝ (Fin 2),
            letI := Classical.propDecidable
            (∀ p_c, ‖n_buf p_c‖ = 1) ∧
            3 / 4 ≤ ∑ o : Fin N_O, ∑ d : Fin N_D,
              if projAngleDist (perp2D (e_D d))
                   (n_buf (coarseOfFineCell M_L
                     (fineOutCell ε H_P t (t - 2 * h) m_r m_t τ_V τ_X
                       (r_O o) (V_O o) (X_O o)))) ≤ ε ^ (4 * h)
              then p o d else 0 :=
by
  have h_card_Icc : ∀ (L U B : ℝ), 0 ≤ B → U - L ≤ B →
      ((Finset.Icc ⌊L⌋ ⌊U⌋).card : ℝ) ≤ B + 2 := by
    intro L U B hB hUL
    by_cases hle : ⌊L⌋ ≤ ⌊U⌋
    · have hcard : ((Finset.Icc ⌊L⌋ ⌊U⌋).card : ℤ) = ⌊U⌋ + 1 - ⌊L⌋ :=
        Int.card_Icc_of_le ⌊L⌋ ⌊U⌋ (by omega)
      have hcard_r : ((Finset.Icc ⌊L⌋ ⌊U⌋).card : ℝ) = (⌊U⌋ : ℝ) + 1 - (⌊L⌋ : ℝ) := by
        exact_mod_cast hcard
      linarith [Int.floor_le U, Int.sub_one_lt_floor L]
    · rw [Finset.Icc_eq_empty (by omega)]
      simp; linarith

  have h_box2_card : ∀ (s R : ℝ) (τ z₀ : EuclideanSpace ℝ (Fin 2)) (S : Finset (ℤ × ℤ)),
      0 < s → 0 ≤ R →
      (∀ k ∈ S, ∃ z : EuclideanSpace ℝ (Fin 2), roundShift2D s τ z = k ∧ ‖z - z₀‖ ≤ R) →
      (S.card : ℝ) ≤ (2 * R / s + 2) ^ 2 := by
    intro s R τ z₀ S hs hR hS
    let I0 := Finset.Icc ⌊(z₀ 0 - τ 0 - R) / s⌋ ⌊(z₀ 0 - τ 0 + R) / s⌋
    let I1 := Finset.Icc ⌊(z₀ 1 - τ 1 - R) / s⌋ ⌊(z₀ 1 - τ 1 + R) / s⌋
    have hsub : S ⊆ I0 ×ˢ I1 := by
      intro k hk
      obtain ⟨z, rfl, hz⟩ := hS k hk
      have hz0 : |z 0 - z₀ 0| ≤ R := by
        have h1 : |(z - z₀) 0| ≤ ‖z - z₀‖ := by
          simpa [Real.norm_eq_abs] using PiLp.norm_apply_le (z - z₀) 0
        exact le_trans h1 hz
      have hz1 : |z 1 - z₀ 1| ≤ R := by
        have h1 : |(z - z₀) 1| ≤ ‖z - z₀‖ := by
          simpa [Real.norm_eq_abs] using PiLp.norm_apply_le (z - z₀) 1
        exact le_trans h1 hz
      rw [Finset.mem_product, Finset.mem_Icc, Finset.mem_Icc]
      unfold roundShift2D
      dsimp only
      refine ⟨⟨Int.floor_mono ?_, Int.floor_mono ?_⟩, ⟨Int.floor_mono ?_, Int.floor_mono ?_⟩⟩
      · exact div_le_div_of_nonneg_right (by linarith [(abs_le.mp hz0).1]) hs.le
      · exact div_le_div_of_nonneg_right (by linarith [(abs_le.mp hz0).2]) hs.le
      · exact div_le_div_of_nonneg_right (by linarith [(abs_le.mp hz1).1]) hs.le
      · exact div_le_div_of_nonneg_right (by linarith [(abs_le.mp hz1).2]) hs.le
    have hc_nat : S.card ≤ (I0 ×ˢ I1).card := Finset.card_le_card hsub
    rw [Finset.card_product] at hc_nat
    have hc_r : (S.card : ℝ) ≤ (I0.card : ℝ) * (I1.card : ℝ) := by exact_mod_cast hc_nat
    have h2Rs_nn : 0 ≤ 2 * R / s := div_nonneg (by linarith) hs.le
    have hI0 : (I0.card : ℝ) ≤ 2 * R / s + 2 := by
      refine h_card_Icc _ _ (2 * R / s) h2Rs_nn ?_
      have h_eq : (z₀ 0 - τ 0 + R) / s - (z₀ 0 - τ 0 - R) / s = 2 * R / s := by ring
      linarith
    have hI1 : (I1.card : ℝ) ≤ 2 * R / s + 2 := by
      refine h_card_Icc _ _ (2 * R / s) h2Rs_nn ?_
      have h_eq : (z₀ 1 - τ 1 + R) / s - (z₀ 1 - τ 1 - R) / s = 2 * R / s := by ring
      linarith
    calc (S.card : ℝ) ≤ (I0.card : ℝ) * (I1.card : ℝ) := hc_r
      _ ≤ (2 * R / s + 2) * (2 * R / s + 2) :=
          mul_le_mul hI0 hI1 (Nat.cast_nonneg _) (by linarith)
      _ = (2 * R / s + 2) ^ 2 := (sq _).symm

  have h_box4_card : ∀ (R₁ R₂ : ℝ) (p₀ : ℕ × (ℤ × ℤ) × (ℤ × ℤ))
      (S : Finset (ℕ × (ℤ × ℤ) × (ℤ × ℤ))),
      0 ≤ R₁ → 0 ≤ R₂ →
      (∀ p_c ∈ S, p_c.1 = p₀.1 ∧
        |(p_c.2.1.1 : ℝ) - (p₀.2.1.1 : ℝ)| ≤ R₁ ∧
        |(p_c.2.1.2 : ℝ) - (p₀.2.1.2 : ℝ)| ≤ R₁ ∧
        |(p_c.2.2.1 : ℝ) - (p₀.2.2.1 : ℝ)| ≤ R₂ ∧
        |(p_c.2.2.2 : ℝ) - (p₀.2.2.2 : ℝ)| ≤ R₂) →
      (S.card : ℝ) ≤ (2 * R₁ + 2) ^ 2 * (2 * R₂ + 2) ^ 2 := by
    intro R₁ R₂ p₀ S hR₁ hR₂ hS
    let J11 := Finset.Icc ⌊(p₀.2.1.1 : ℝ) - R₁⌋ ⌊(p₀.2.1.1 : ℝ) + R₁⌋
    let J12 := Finset.Icc ⌊(p₀.2.1.2 : ℝ) - R₁⌋ ⌊(p₀.2.1.2 : ℝ) + R₁⌋
    let J21 := Finset.Icc ⌊(p₀.2.2.1 : ℝ) - R₂⌋ ⌊(p₀.2.2.1 : ℝ) + R₂⌋
    let J22 := Finset.Icc ⌊(p₀.2.2.2 : ℝ) - R₂⌋ ⌊(p₀.2.2.2 : ℝ) + R₂⌋
    have h_int_mem : ∀ (m m₀ : ℤ) (R : ℝ), |(m : ℝ) - (m₀ : ℝ)| ≤ R →
        m ∈ Finset.Icc ⌊(m₀ : ℝ) - R⌋ ⌊(m₀ : ℝ) + R⌋ := by
      intro m m₀ R hm
      have habs := abs_le.mp hm
      rw [Finset.mem_Icc]
      refine ⟨?_, ?_⟩
      · have h1 : ⌊(m₀ : ℝ) - R⌋ ≤ ⌊(m : ℝ)⌋ := Int.floor_mono (by linarith)
        rwa [Int.floor_intCast] at h1
      · have h2 : ⌊(m : ℝ)⌋ ≤ ⌊(m₀ : ℝ) + R⌋ := Int.floor_mono (by linarith)
        rwa [Int.floor_intCast] at h2
    have hc_nat : S.card ≤ ((J11 ×ˢ J12) ×ˢ (J21 ×ˢ J22)).card := by
      refine Finset.card_le_card_of_injOn (fun p_c => p_c.2) ?_ ?_
      · intro p_c hp_c
        obtain ⟨_, hb1, hb2, hb3, hb4⟩ := hS p_c hp_c
        simp only [Finset.coe_product, Set.mem_prod, Finset.mem_coe]
        exact ⟨⟨h_int_mem _ _ _ hb1, h_int_mem _ _ _ hb2⟩,
               ⟨h_int_mem _ _ _ hb3, h_int_mem _ _ _ hb4⟩⟩
      · intro x hx y hy hxy
        have hx1 := (hS x hx).1
        have hy1 := (hS y hy).1
        exact Prod.ext (hx1.trans hy1.symm) hxy
    simp only [Finset.card_product] at hc_nat
    have hc_r : (S.card : ℝ) ≤
        ((J11.card : ℝ) * (J12.card : ℝ)) * ((J21.card : ℝ) * (J22.card : ℝ)) := by
      exact_mod_cast hc_nat
    have c11 : (J11.card : ℝ) ≤ 2 * R₁ + 2 := h_card_Icc _ _ (2 * R₁) (by linarith) (by linarith)
    have c12 : (J12.card : ℝ) ≤ 2 * R₁ + 2 := h_card_Icc _ _ (2 * R₁) (by linarith) (by linarith)
    have c21 : (J21.card : ℝ) ≤ 2 * R₂ + 2 := h_card_Icc _ _ (2 * R₂) (by linarith) (by linarith)
    have c22 : (J22.card : ℝ) ≤ 2 * R₂ + 2 := h_card_Icc _ _ (2 * R₂) (by linarith) (by linarith)
    have p1 : (J11.card : ℝ) * (J12.card : ℝ) ≤ (2 * R₁ + 2) ^ 2 := by
      rw [sq]; exact mul_le_mul c11 c12 (Nat.cast_nonneg _) (by linarith)
    have p2 : (J21.card : ℝ) * (J22.card : ℝ) ≤ (2 * R₂ + 2) ^ 2 := by
      rw [sq]; exact mul_le_mul c21 c22 (Nat.cast_nonneg _) (by linarith)
    exact le_trans hc_r (mul_le_mul p1 p2 (by positivity) (by positivity))

  have h_centerX_eq : fineCellCenterX = fineCellCenterV := rfl

  have h_mid_coarse : ∀ (M : ℕ) (s : ℝ) (τ z : EuclideanSpace ℝ (Fin 2)) (k : ℤ × ℤ),
      1 ≤ M → 0 < s →
      ((roundShift2D s τ z).1 / (M : ℤ), (roundShift2D s τ z).2 / (M : ℤ)) = k →
      let S := (M : ℝ) * s
      |(z - fineCellCenterV S τ k) 0| ≤ (1 / 2) * S ∧
      |(z - fineCellCenterV S τ k) 1| ≤ (1 / 2) * S ∧
      ‖z - fineCellCenterV S τ k‖ ≤ S := by
    intro M s τ z k hM hs hk S
    have hM_pos : (0 : ℝ) < (M : ℝ) := Nat.cast_pos.mpr (Nat.lt_of_lt_of_le Nat.zero_lt_one hM)
    have hS : 0 < S := mul_pos hM_pos hs
    have hk0 : ⌊(z 0 - τ 0) / S⌋ = k.1 := by
      have h1 : (roundShift2D s τ z).1 / (M : ℤ) = k.1 := congrArg Prod.fst hk
      unfold roundShift2D at h1; dsimp only at h1
      rw [← Int.floor_div_natCast, div_div, mul_comm s (M : ℝ)] at h1
      exact h1
    have hk1 : ⌊(z 1 - τ 1) / S⌋ = k.2 := by
      have h1 : (roundShift2D s τ z).2 / (M : ℤ) = k.2 := congrArg Prod.snd hk
      unfold roundShift2D at h1; dsimp only at h1
      rw [← Int.floor_div_natCast, div_div, mul_comm s (M : ℝ)] at h1
      exact h1
    have hc0 : |(z - fineCellCenterV S τ k) 0| ≤ (1 / 2) * S := by
      have lo := (le_div_iff₀ hS).mp (hk0 ▸ Int.floor_le ((z 0 - τ 0) / S))
      have hi := (div_lt_iff₀ hS).mp (hk0 ▸ Int.lt_floor_add_one ((z 0 - τ 0) / S))
      have val : (z - fineCellCenterV S τ k) 0 = (z 0 - τ 0) - (S * (k.1 : ℝ) + (1 / 2) * S) := by
        simp [fineCellCenterV, gridPt2D]; ring
      rw [val, abs_le]
      exact ⟨by linarith, by linarith⟩
    have hc1 : |(z - fineCellCenterV S τ k) 1| ≤ (1 / 2) * S := by
      have lo := (le_div_iff₀ hS).mp (hk1 ▸ Int.floor_le ((z 1 - τ 1) / S))
      have hi := (div_lt_iff₀ hS).mp (hk1 ▸ Int.lt_floor_add_one ((z 1 - τ 1) / S))
      have val : (z - fineCellCenterV S τ k) 1 = (z 1 - τ 1) - (S * (k.2 : ℝ) + (1 / 2) * S) := by
        simp [fineCellCenterV, gridPt2D]; ring
      rw [val, abs_le]
      exact ⟨by linarith, by linarith⟩
    refine ⟨hc0, hc1, ?_⟩
    have hnsq : ‖z - fineCellCenterV S τ k‖ ^ 2 ≤ S ^ 2 := by
      rw [PiLp.norm_sq_eq_of_L2, Fin.sum_univ_two]
      simp only [Real.norm_eq_abs]
      have s0 : |(z - fineCellCenterV S τ k) 0| ^ 2 ≤ ((1 / 2) * S) ^ 2 :=
        sq_le_sq' (by linarith [abs_nonneg ((z - fineCellCenterV S τ k) 0)]) hc0
      have s1 : |(z - fineCellCenterV S τ k) 1| ^ 2 ≤ ((1 / 2) * S) ^ 2 :=
        sq_le_sq' (by linarith [abs_nonneg ((z - fineCellCenterV S τ k) 1)]) hc1
      nlinarith
    nlinarith [norm_nonneg (z - fineCellCenterV S τ k), hS]

  have h_mid_unit : ∀ (s : ℝ) (τ z : EuclideanSpace ℝ (Fin 2)) (k : ℤ × ℤ),
      0 < s → roundShift2D s τ z = k →
      |(z - fineCellCenterV s τ k) 0| ≤ (1 / 2) * s ∧
      |(z - fineCellCenterV s τ k) 1| ≤ (1 / 2) * s ∧
      ‖z - fineCellCenterV s τ k‖ ≤ s := by
    intro s τ z k hs hk
    have hk' : ((roundShift2D s τ z).1 / ((1 : ℕ) : ℤ),
                (roundShift2D s τ z).2 / ((1 : ℕ) : ℤ)) = k := by
      simp [hk]
    simpa [one_mul] using h_mid_coarse 1 s τ z k le_rfl hs hk'

  have h_parseval : ∀ (z e : EuclideanSpace ℝ (Fin 2)) (R₁ R₂ : ℝ),
      ‖e‖ = 1 → |inner ℝ z e| ≤ R₁ → |inner ℝ z (perp2D e)| ≤ R₂ →
      0 ≤ R₂ → R₂ ≤ R₁ → ‖z‖ ≤ 2 * R₁ := by
    intro z e R₁ R₂ he h1 h2 hR₂ hR₂₁
    have he_sq : (e 0) ^ 2 + (e 1) ^ 2 = 1 := by
      have hn : ‖e‖ ^ 2 = 1 := by rw [he, one_pow]
      rw [PiLp.norm_sq_eq_of_L2, Fin.sum_univ_two] at hn
      simpa [Real.norm_eq_abs, sq_abs] using hn
    have hz_id : ‖z‖ ^ 2 = (inner ℝ z e) ^ 2 + (inner ℝ z (perp2D e)) ^ 2 := by
      rw [PiLp.norm_sq_eq_of_L2, PiLp.inner_apply, PiLp.inner_apply,
        Fin.sum_univ_two, Fin.sum_univ_two]
      simp [perp2D, Real.norm_eq_abs, sq_abs]
      linear_combination ((z 0) ^ 2 + (z 1) ^ 2) * he_sq.symm
    have hs1 : (inner ℝ z e) ^ 2 ≤ R₁ ^ 2 :=
      sq_le_sq' (by linarith [(abs_le.mp h1).1]) (abs_le.mp h1).2
    have hs2 : (inner ℝ z (perp2D e)) ^ 2 ≤ R₂ ^ 2 :=
      sq_le_sq' (by linarith [(abs_le.mp h2).1]) (abs_le.mp h2).2
    have hs_tot : ‖z‖ ^ 2 ≤ (2 * R₁) ^ 2 := by nlinarith [hz_id, hs1, hs2, hR₂, hR₂₁]
    nlinarith [norm_nonneg z, hR₂, hR₂₁, hs_tot]

  have h_sh_cond : ∀ {α β : Type} [Fintype α] [Fintype β] (P : α → β → ℝ),
      (∀ x y, 0 ≤ P x y) →
      (∑ x, ∑ y, -(P x y * Real.log (P x y / (∑ x', P x' y)))) =
        (∑ x, ∑ y, -(P x y * Real.log (P x y))) -
        (∑ y, -((∑ x', P x' y) * Real.log (∑ x', P x' y))) := by
    intro α β _ _ P hP
    rw [Finset.sum_comm (f := fun x y => -(P x y * Real.log (P x y / (∑ x', P x' y)))),
        Finset.sum_comm (f := fun x y => -(P x y * Real.log (P x y))),
        ← Finset.sum_sub_distrib]
    refine Finset.sum_congr rfl (fun y _ => ?_)
    let S := ∑ x', P x' y
    have hS_term : -(S * Real.log S) = ∑ x, -(P x y * Real.log S) := by
      simp only [S, Finset.sum_mul, Finset.sum_neg_distrib]
    rw [hS_term, ← Finset.sum_sub_distrib]
    refine Finset.sum_congr rfl (fun x _ => ?_)
    by_cases hx0 : P x y = 0
    · simp [hx0]
    · have hx_pos : 0 < P x y := lt_of_le_of_ne (hP x y) (Ne.symm hx0)
      have hS_pos : 0 < S := lt_of_lt_of_le hx_pos
        (Finset.single_le_sum (fun x' _ => hP x' y) (Finset.mem_univ x))
      rw [Real.log_div hx_pos.ne' hS_pos.ne']; ring

  have h_sh_fiber : ∀ {α β : Type} [Fintype α] [Fintype β] [DecidableEq β]
      (g : α → β) (μ : α → ℝ),
      (∀ x, 0 ≤ μ x) →
      let μ_B := fun b => ∑ x ∈ Finset.univ.filter (fun x => g x = b), μ x
      (∑ x, -(μ x * Real.log (μ x / μ_B (g x)))) =
        (∑ x, -(μ x * Real.log (μ x))) - (∑ b, -(μ_B b * Real.log (μ_B b))) := by
    intro α β _ _ _ g μ hμ μ_B
    rw [← Finset.sum_fiberwise Finset.univ g (fun x => -(μ x * Real.log (μ x / μ_B (g x)))),
        ← Finset.sum_fiberwise Finset.univ g (fun x => -(μ x * Real.log (μ x))),
        ← Finset.sum_sub_distrib]
    refine Finset.sum_congr rfl (fun b _ => ?_)
    let F_b := Finset.univ.filter (fun x => g x = b)
    have hB_term : -(μ_B b * Real.log (μ_B b)) = ∑ x ∈ F_b, -(μ x * Real.log (μ_B b)) := by
      simp only [μ_B, F_b, Finset.sum_mul, Finset.sum_neg_distrib]
    change (∑ x ∈ F_b, -(μ x * Real.log (μ x / μ_B (g x)))) =
      (∑ x ∈ F_b, -(μ x * Real.log (μ x))) - -(μ_B b * Real.log (μ_B b))
    rw [hB_term, ← Finset.sum_sub_distrib]
    refine Finset.sum_congr rfl (fun x hx => ?_)
    have hgx : g x = b := (Finset.mem_filter.mp hx).2
    rw [hgx]
    by_cases hx0 : μ x = 0
    · simp [hx0]
    · have hx_pos : 0 < μ x := lt_of_le_of_ne (hμ x) (Ne.symm hx0)
      have hB_pos : 0 < μ_B b := lt_of_lt_of_le hx_pos
        (Finset.single_le_sum (fun x' _ => hμ x') hx)
      rw [Real.log_div hx_pos.ne' hB_pos.ne']; ring

  have h_sh_dom : ∀ {α β : Type} [Fintype α] [Fintype β] (P : α → β → ℝ),
      (∀ x y, 0 ≤ P x y) →
      (∑ x, -((∑ y, P x y) * Real.log (∑ y, P x y))) ≤
        ∑ x, ∑ y, -(P x y * Real.log (P x y)) := by
    intro α β _ _ P hP
