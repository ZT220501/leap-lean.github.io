      let x_p := A_part (T_idx ω) + (dyadicTimeMid ε u (c_s ω)) • V
      have h_rot_V := h_rot e_s0 e' (V - V₀) (h_unit_norm _ _) (h_unit_norm _ _)
      have h_rot_X := h_rot e_s0 e' (x_p - x_p0) (h_unit_norm _ _) (h_unit_norm _ _)
      have h_eb_ge_ea : ε ^ a ≤ ε ^ b := hε_anti hba
      have h_ebu_ge_eau : ε ^ (a + u) ≤ ε ^ (b + u) := hε_anti (by linarith)
      have h_bd_eq : ε ^ b * ε ^ d = ε ^ (a - ν) := by
        rw [← Real.rpow_add hε₀]
        congr 1
        dsimp only [d]
        ring
      have h_ea_le : ε ^ a ≤ ε ^ (a - ν) := hε_anti (by linarith)
      have h_bud_eq : ε ^ (b + u) * ε ^ d = ε ^ ((a + u) - ν) := by
        rw [← Real.rpow_add hε₀]
        congr 1
        dsimp only [d]
        ring
      have h_eau_le : ε ^ (a + u) ≤ ε ^ ((a + u) - ν) := hε_anti (by linarith)
      refine ⟨Finset.mem_singleton.mpr hd1, hk'_S2, ?_, ?_, ?_, ?_⟩
      · dsimp only [stdApertureObs]
        refine h_rb_int b _ _ 4 ?_
        rw [← inner_sub_left, Nat.cast_ofNat]
        linarith [h_rot_V.1, hd3, hd4, h_eb_ge_ea]
      · dsimp only [stdApertureObs]
        refine (h_rb_pow 26 ν hν.le).2 a _ _ ?_
        rw [← inner_sub_left, Nat.cast_ofNat]
        have h_prod_bd : |inner ℝ (V - V₀) e_s0| * |inner ℝ e_s0 (perp2D e')| ≤
            24 * ε ^ (a - ν) := by
          calc |inner ℝ (V - V₀) e_s0| * |inner ℝ e_s0 (perp2D e')|
              ≤ (2 * ε ^ b) * (12 * ε ^ d) :=
                mul_le_mul hd3 h_sin_raw (abs_nonneg _) (by positivity)
            _ = 24 * (ε ^ b * ε ^ d) := by ring
            _ = 24 * ε ^ (a - ν) := by rw [h_bd_eq]
        linarith [h_rot_V.2.1, h_prod_bd, hd4, h_ea_le]
      · dsimp only [stdApertureObs]
        refine h_rb_int (b + u) _ _ 4 ?_
        rw [← inner_sub_left, Nat.cast_ofNat]
        linarith [h_rot_X.1, hd5, hd6, h_ebu_ge_eau]
      · dsimp only [stdApertureObs]
        refine (h_rb_pow 26 ν hν.le).2 (a + u) _ _ ?_
        rw [← inner_sub_left, Nat.cast_ofNat]
        have h_prod_bd : |inner ℝ (x_p - x_p0) e_s0| * |inner ℝ e_s0 (perp2D e')| ≤
            24 * ε ^ ((a + u) - ν) := by
          calc |inner ℝ (x_p - x_p0) e_s0| * |inner ℝ e_s0 (perp2D e')|
              ≤ (2 * ε ^ (b + u)) * (12 * ε ^ d) :=
                mul_le_mul hd5 h_sin_raw (abs_nonneg _) (by positivity)
            _ = 24 * (ε ^ (b + u) * ε ^ d) := by ring
            _ = 24 * ε ^ ((a + u) - ν) := by rw [h_bud_eq]
        linarith [h_rot_X.2.1, h_prod_bd, hd6, h_eau_le]
    · rw [Finset.card_singleton, one_mul]
      dsimp only [N_good]
      have h_mul1 := Nat.mul_le_mul_right (2 * 4 + 1) hS2_card
      have h_mul2 := Nat.mul_le_mul_right (2 * B_gd + 1) h_mul1
      have h_mul3 := Nat.mul_le_mul_right (2 * 4 + 1) h_mul2
      exact Nat.mul_le_mul_right (2 * B_gd + 1) h_mul3

theorem std_aperture_two_copy_angle_bounds (γ m : ℝ) (hγ₀ : 0 < γ) (hγ₁ : γ < 1) (hm : 0 ≤ m)
    (h_two : (2 : ℝ) ∈ ValidClassicalGrowthRates γ) :
    (∀ (u η_loss : ℝ), 0 < u → u ≤ 1 → 0 < η_loss →
      ∃ (δ_in ε₀ : ℝ), 0 < δ_in ∧ 0 < ε₀ ∧ ε₀ < 1 / 2 ∧
        ∀ (ε b a : ℝ), 0 < ε → ε < ε₀ → 0 ≤ b → b ≤ a → a + u ≤ 1 + m →
        ∀ {N_ω N_T : ℕ} (π : Fin N_ω → ℝ) (T_idx : Fin N_ω → Fin N_T)
          (V_part A_part : Fin N_T → EuclideanSpace ℝ (Fin 2)) (c_s θ_s : Fin N_ω → ℝ),
          IsUnitBallTimeLaw π V_part A_part c_s →
          (∀ ω, 0 < π ω → θ_s ω ∈ Set.Ico (0 : ℝ) Real.pi) →
          stdApertureDeficit ε γ (1 + m) u b a π T_idx V_part A_part c_s θ_s ≤ δ_in →
          ∃ θ_det : Fin N_T × ℤ → ℝ,
            (∀ p, θ_det p ∈ Set.Ico (0 : ℝ) Real.pi) ∧
            stdApertureDeficit ε γ (1 + m) u b a π T_idx V_part A_part c_s
              (fun ω => θ_det (T_idx ω, dyadicTimeBin ε u (c_s ω))) ≤ η_loss) ∧
    (∀ (u b a d η_slack : ℝ),
      0 < u → u ≤ 1 → 0 ≤ b → b < a → a + u ≤ 1 + m →
      0 < d → d < a - b → 0 < η_slack →
      ∃ ε₀ : ℝ, 0 < ε₀ ∧ ε₀ < 1 / 2 ∧
        ∀ (ε : ℝ), 0 < ε → ε < ε₀ →
        ∀ {N_ω N_T : ℕ} (π : Fin N_ω → ℝ) (T_idx : Fin N_ω → Fin N_T)
          (V_part A_part : Fin N_T → EuclideanSpace ℝ (Fin 2))
          (c_s θ₂ : Fin N_ω → ℝ) (θ_det : Fin N_T × ℤ → ℝ),
          IsUnitBallTimeLaw π V_part A_part c_s →
          (∀ p, θ_det p ∈ Set.Ico (0 : ℝ) Real.pi) →
          (∀ ω, 0 < π ω → θ₂ ω ∈ Set.Ico (0 : ℝ) Real.pi) →
          (let θ₁ := fun ω => θ_det (T_idx ω, dyadicTimeBin ε u (c_s ω))
           let M_d : ℤ := (2 : ℤ) ^ (dyadicTimeLevel ε d)
           (∀ ω, 0 < π ω →
             1 < cyclicBinDist M_d (angBin ε d (θ₁ ω)) (angBin ε d (θ₂ ω))) →
           2 * γ * (a - b - d) ≤
             stdApertureDeficit ε γ (1 + m) u b a π T_idx V_part A_part c_s θ₁ +
             stdApertureDeficit ε γ (1 + m) u b a π T_idx V_part A_part c_s θ₂ +
             η_slack)) :=
by
  have h_log_gt_of_lt_exp : ∀ (K ε : ℝ), 0 < ε → ε < Real.exp (-K) → K < Real.log (ε⁻¹) := by
    intro K ε hε_pos hε_lt
    have h1 : ε * Real.exp K < Real.exp (-K) * Real.exp K :=
      mul_lt_mul_of_pos_right hε_lt (Real.exp_pos K)
    rw [← Real.exp_add, neg_add_cancel, Real.exp_zero] at h1
    have h2 : Real.exp K < ε⁻¹ := by
      have h_mul := mul_lt_mul_of_pos_left h1 (inv_pos.mpr hε_pos)
      rwa [← mul_assoc, inv_mul_cancel₀ (ne_of_gt hε_pos), one_mul, mul_one] at h_mul
    have h3 := Real.log_lt_log (Real.exp_pos K) h2
    rwa [Real.log_exp] at h3
  have h_log_nat_pow : ∀ (ε C α : ℝ) (N : ℕ),
      0 < ε → 1 ≤ C → 1 ≤ N → (N : ℝ) ≤ C * ε ^ (-α) →
      Real.log (N : ℝ) ≤ Real.log C + α * Real.log (ε⁻¹) := by
    intro ε C α N hε_pos hC_ge hN_ge hN_le
    have hN_pos : (0 : ℝ) < (N : ℝ) := by exact_mod_cast (Nat.pos_of_ne_zero (by omega))
    have hC_pos : 0 < C := by linarith
    have hpow_pos : 0 < ε ^ (-α) := Real.rpow_pos_of_pos hε_pos (-α)
    have h_le : Real.log (N : ℝ) ≤ Real.log (C * ε ^ (-α)) := Real.log_le_log hN_pos hN_le
    rw [Real.log_mul (ne_of_gt hC_pos) (ne_of_gt hpow_pos), Real.log_rpow hε_pos] at h_le
    rw [Real.log_inv]
    linarith
  have h_master_sep : ∀ (u ν_gap η_err : ℝ),
      0 < u → u ≤ 1 → 0 < ν_gap → 0 < η_err →
      ∃ ε₀ : ℝ, 0 < ε₀ ∧ ε₀ < 1 / 2 ∧
        ∀ (ε b a d : ℝ),
          0 < ε → ε < ε₀ →
          0 ≤ b → b < a → a + u ≤ 1 + m →
          0 < d → ν_gap ≤ a - b - d →
        ∀ {N_ω N_T : ℕ} (π : Fin N_ω → ℝ) (T_idx : Fin N_ω → Fin N_T)
          (V_part A_part : Fin N_T → EuclideanSpace ℝ (Fin 2))
          (c_s θ₁ θ₂ : Fin N_ω → ℝ),
          IsUnitBallTimeLaw π V_part A_part c_s →
          (∀ ω, 0 < π ω →
            θ₁ ω ∈ Set.Ico (0 : ℝ) Real.pi ∧ θ₂ ω ∈ Set.Ico (0 : ℝ) Real.pi) →
          (let C_u := fun ω => dyadicTimeBin ε u (c_s ω)
           let D₁ := fun ω => stdApertureObs ε u b a
             (V_part (T_idx ω)) (A_part (T_idx ω)) (c_s ω) (θ₁ ω)
           let D₂ := fun ω => stdApertureObs ε u b a
             (V_part (T_idx ω)) (A_part (T_idx ω)) (c_s ω) (θ₂ ω)
           finCondEntropy ε π (fun ω => (T_idx ω, C_u ω)) D₁ +
             finCondEntropy ε π (fun ω => (T_idx ω, C_u ω)) D₂ ≤
             finCondEntropy ε π (fun ω => (T_idx ω, C_u ω)) (fun ω => (D₁ ω, D₂ ω))) →
          (let M_d : ℤ := (2 : ℤ) ^ (dyadicTimeLevel ε d)
           let P_sep := ∑ ω : Fin N_ω,
             if 1 < cyclicBinDist M_d (angBin ε d (θ₁ ω)) (angBin ε d (θ₂ ω))
             then π ω else 0
           2 * γ * (a - b - d) * P_sep ≤
             stdApertureDeficit ε γ (1 + m) u b a π T_idx V_part A_part c_s θ₁ +
             stdApertureDeficit ε γ (1 + m) u b a π T_idx V_part A_part c_s θ₂ +
             η_err) := by
    intro u ν_gap η_err hu₀ hu₁ hν hη_err
    let ξ : ℝ := min (ν_gap / 4) (η_err / 8)
    have hξ_pos : 0 < ξ := lt_min (by positivity) (by positivity)
    have hξ_le_err : ξ ≤ η_err / 8 := min_le_right _ _
    let δ_cl : ℝ := η_err / 16
    have hδ_cl_pos : 0 < δ_cl := by positivity
    obtain ⟨ε_geom, hε_geom_pos, hε_geom_lt, h_geom⟩ :=
      two_aperture_common_intersection_geometry γ m u ξ ν_gap δ_cl
        hγ₀ hγ₁ hm h_two hu₀ hu₁ hξ_pos hν hδ_cl_pos
    let C_gc : ℕ := 3000000 * (⌊(1 + m) / ξ⌋₊ + 1)
    have hC_gc_ge : 1 ≤ C_gc := by
      dsimp only [C_gc]
      omega
    have h_log2_pos : 0 < Real.log 2 := Real.log_pos (by norm_num)
    have h_logC_nn : 0 ≤ Real.log (C_gc : ℝ) := Real.log_nonneg (by exact_mod_cast hC_gc_ge)
    let K_ent : ℝ := 16 * (Real.log 2 + Real.log (C_gc : ℝ)) / η_err + 1
    have hK_ent_gt1 : 1 < K_ent := by
      dsimp only [K_ent]
      have h_div_pos : 0 < 16 * (Real.log 2 + Real.log (C_gc : ℝ)) / η_err :=
        div_pos (mul_pos (by norm_num) (by linarith)) hη_err
      linarith
    let ε_ent : ℝ := Real.exp (-K_ent)
    refine ⟨min ε_geom ε_ent, lt_min hε_geom_pos (Real.exp_pos _),
      lt_of_le_of_lt (min_le_left _ _) hε_geom_lt, ?_⟩
    intro ε b a d hε₀ hε_lt hb hba hau hd h_gap
      N_ω N_T π T_idx V_part A_part c_s θ₁ θ₂ h_law hθ h_subindep
    have hε_lt_geom : ε < ε_geom := lt_of_lt_of_le hε_lt (min_le_left _ _)
    have hε_lt_ent : ε < ε_ent := lt_of_lt_of_le hε_lt (min_le_right _ _)
    have hε_lt_half : ε < 1 / 2 := lt_trans hε_lt_geom hε_geom_lt
    have h_log_gt : K_ent < Real.log (ε⁻¹) := h_log_gt_of_lt_exp K_ent ε hε₀ hε_lt_ent
    have h_ell_pos : 0 < Real.log (ε⁻¹) := by linarith
    have h_ent_small : (Real.log 2 + Real.log (C_gc : ℝ)) / Real.log (ε⁻¹) < η_err / 16 := by
      rw [div_lt_iff₀ h_ell_pos]
      have h_div : 16 * (Real.log 2 + Real.log (C_gc : ℝ)) / η_err < Real.log (ε⁻¹) := by
        dsimp only [K_ent] at h_log_gt
        linarith
      have h_mul := (div_lt_iff₀ hη_err).mp h_div
      linarith [mul_comm η_err (Real.log (ε⁻¹))]
    let C_u := fun ω : Fin N_ω => dyadicTimeBin ε u (c_s ω)
    let D₁ := fun ω : Fin N_ω => stdApertureObs ε u b a
      (V_part (T_idx ω)) (A_part (T_idx ω)) (c_s ω) (θ₁ ω)
    let D₂ := fun ω : Fin N_ω => stdApertureObs ε u b a
      (V_part (T_idx ω)) (A_part (T_idx ω)) (c_s ω) (θ₂ ω)
    let M_d : ℤ := (2 : ℤ) ^ (dyadicTimeLevel ε d)
    let P_sep := ∑ ω : Fin N_ω,
      if 1 < cyclicBinDist M_d (angBin ε d (θ₁ ω)) (angBin ε d (θ₂ ω))
      then π ω else 0
    obtain ⟨G_c, hGc_t, hGc_card, hGc_ineq, h_cond1, h_cond2⟩ :
        ∃ G_c : Fin N_ω → ℕ × (ℤ × ℤ × ℤ × ℤ × ℤ × ℤ),
          (∀ ω, (G_c ω).2.1 = dyadicTimeBin ε u (c_s ω)) ∧
          True ∧
          (2 * γ * (a - b - d - 2 * ξ) * P_sep - ξ ≤
            stdApertureDeficit ε γ (1 + m) u b a π T_idx V_part A_part c_s θ₁ +
            stdApertureDeficit ε γ (1 + m) u b a π T_idx V_part A_part c_s θ₂ +
            4 * δ_cl * u +
            (finMutualInfo ε π T_idx (fun ω => (D₁ ω, D₂ ω)) +
              finMutualInfo ε π T_idx G_c -
              finMutualInfo ε π T_idx D₁ -
              finMutualInfo ε π T_idx D₂)) ∧
          finCondEntropy ε π D₁ G_c ≤ η_err / 16 ∧
          finCondEntropy ε π D₂ G_c ≤ η_err / 16 := by
      letI := Classical.propDecidable
      obtain ⟨G_c, hGc_t, hGc_card, hGc_ineq⟩ :=
        h_geom ε b a d hε₀ hε_lt_geom hb hba hau hd h_gap π T_idx V_part A_part c_s θ₁ θ₂ h_law hθ
      obtain ⟨_, h_supp, _, _⟩ :=
        fin_entropy_submod_and_support_bounds ε hε₀ hε_lt_half π h_law.1 h_law.2.1
      have h_empty_bad : ((Finset.univ.filter (fun ω : Fin N_ω =>
          0 < π ω ∧ false = true)).image G_c).card ≤ 1 := by
        have h_emp : Finset.univ.filter (fun ω : Fin N_ω =>
            0 < π ω ∧ false = true) = ∅ := by
          rw [Finset.filter_eq_empty_iff]
          intro ω _ h_bad
          exact Bool.false_ne_true h_bad.2
        rw [h_emp, Finset.image_empty, Finset.card_empty]
        exact zero_le_one
      have h_cond1 : finCondEntropy ε π D₁ G_c ≤ η_err / 16 := by
        have h_raw := h_supp D₁ G_c (fun _ => false) C_gc 1 hC_gc_ge le_rfl
          (fun ω₀ hω₀ => by
            have h_eq : Finset.univ.filter (fun ω : Fin N_ω =>
                0 < π ω ∧ false = false ∧ D₁ ω = D₁ ω₀) =
              Finset.univ.filter (fun ω : Fin N_ω => 0 < π ω ∧ D₁ ω = D₁ ω₀) :=
              Finset.filter_congr (fun _ _ =>
                ⟨fun h => ⟨h.1, h.2.2⟩, fun h => ⟨h.1, rfl, h.2⟩⟩)
            rw [h_eq]
            exact (hGc_card ω₀ hω₀).1)
          h_empty_bad
        rw [Nat.cast_one, Real.log_one, mul_zero, add_zero] at h_raw
        exact le_trans h_raw h_ent_small.le
      have h_cond2 : finCondEntropy ε π D₂ G_c ≤ η_err / 16 := by
        have h_raw := h_supp D₂ G_c (fun _ => false) C_gc 1 hC_gc_ge le_rfl
          (fun ω₀ hω₀ => by
            have h_eq : Finset.univ.filter (fun ω : Fin N_ω =>
                0 < π ω ∧ false = false ∧ D₂ ω = D₂ ω₀) =
              Finset.univ.filter (fun ω : Fin N_ω => 0 < π ω ∧ D₂ ω = D₂ ω₀) :=
              Finset.filter_congr (fun _ _ =>
                ⟨fun h => ⟨h.1, h.2.2⟩, fun h => ⟨h.1, rfl, h.2⟩⟩)
