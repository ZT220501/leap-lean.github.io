  have h_rpow_cancel : ∀ a : ℝ, ε ^ a * ε ^ (-a) = 1 ∧ ε ^ (-a) * ε ^ a = 1 := fun a => by
    have h1 : ε ^ a * ε ^ (-a) = 1 := by
      rw [← Real.rpow_add hε₀, add_neg_cancel, Real.rpow_zero]
    exact ⟨h1, by rw [mul_comm, h1]⟩
  have h_rpow_step_d : ∀ a d : ℝ, ε ^ (a + d * h') = ε ^ a * ρ ^ d := fun a d => by
    dsimp [ρ]
    rw [Real.rpow_add hε₀, mul_comm d h', Real.rpow_mul hε₀.le]
  have h_rpow_step_1 : ∀ a : ℝ, ε ^ (a + h') = ε ^ a * ρ := fun a => by
    simpa using h_rpow_step_d a 1
  have h_step_pos : ∀ s L : ℝ, 0 < dyadicRealStep s L := fun s L =>
    zpow_pos (by norm_num : (0 : ℝ) < 2) _
  have h_bin_eq_floor : ∀ s L x : ℝ, dyadicRealBin s L x = ⌊x / dyadicRealStep s L⌋ :=
    fun s L x => by
      unfold dyadicRealBin dyadicRealStep
      rw [zpow_neg, div_inv_eq_mul]

  
  let iccLeft : ℝ → ℕ → Finset ℤ := fun A W => Finset.Icc ⌊A⌋ (⌊A⌋ + (W : ℤ))
  have h_iccLeft_card : ∀ (A : ℝ) (W : ℕ), (iccLeft A W).card = W + 1 := fun A W => by
    dsimp [iccLeft]
    rw [Int.card_Icc]
    omega
  have h_iccLeft_mem : ∀ (A y B : ℝ) (W : ℕ),
      A ≤ y → y ≤ B → B - A ≤ (W : ℝ) → ⌊y⌋ ∈ iccLeft A W :=
    fun A y B W hAy hyB hBA => by
      dsimp [iccLeft]
      refine Finset.mem_Icc.mpr ⟨Int.floor_mono hAy, ?_⟩
      have hlt : ⌊y⌋ < ⌊A⌋ + (W : ℤ) + 1 := by
        rw [Int.floor_lt]
        have h1 := Int.lt_floor_add_one A
        push_cast
        linarith
      omega

  let iccCenter : ℝ → ℕ → Finset ℤ := fun c H => Finset.Icc (⌊c⌋ - (H : ℤ)) (⌊c⌋ + (H : ℤ))
  have h_iccCenter_card : ∀ (c : ℝ) (H : ℕ), (iccCenter c H).card = 2 * H + 1 := fun c H => by
    dsimp [iccCenter]
    rw [Int.card_Icc]
    omega
  have h_iccCenter_mem : ∀ (x x₀ Δ : ℝ) (H : ℕ),
      0 < Δ → |x - x₀| ≤ (H : ℝ) * Δ → ⌊x / Δ⌋ ∈ iccCenter (x₀ / Δ) H :=
    fun x x₀ Δ H hΔ h => by
      dsimp [iccCenter]
      obtain ⟨h1, h2⟩ := abs_le.mp h
      have hd1 : x₀ / Δ - (H : ℝ) ≤ x / Δ := by
        have := div_le_div_of_nonneg_right (by linarith : x₀ - (H : ℝ) * Δ ≤ x) hΔ.le
        rwa [sub_div, mul_div_cancel_right₀ _ hΔ.ne'] at this
      have hd2 : x / Δ ≤ x₀ / Δ + (H : ℝ) := by
        have := div_le_div_of_nonneg_right (by linarith : x ≤ x₀ + (H : ℝ) * Δ) hΔ.le
        rwa [add_div, mul_div_cancel_right₀ _ hΔ.ne'] at this
      refine Finset.mem_Icc.mpr ⟨?_, ?_⟩
      · rw [← Int.floor_sub_natCast]
        exact Int.floor_mono hd1
      · have hlt : ⌊x / Δ⌋ < ⌊x₀ / Δ⌋ + (H : ℤ) + 1 := by
          rw [Int.floor_lt]
          have ha := Int.lt_floor_add_one (x₀ / Δ)
          push_cast
          linarith
        omega

  have h_gridMid_err : ∀ z : ℝ, |canonicalGridMid ρ z - z| ≤ (1 / 2) * ρ := fun z => by
    unfold canonicalGridMid canonicalGridBin
    have h1 : (⌊z / ρ⌋ : ℝ) * ρ ≤ z := (le_div_iff₀ hρ₀).mp (Int.floor_le (z / ρ))
    have h2 : z < ((⌊z / ρ⌋ : ℝ) + 1) * ρ := (div_lt_iff₀ hρ₀).mp (Int.lt_floor_add_one (z / ρ))
    rw [abs_le]
    constructor <;> linarith

  have h_coarsen_mid_and_floor : ∀ (kc kf D : ℤ) (Δf Δc : ℝ),
      1 ≤ D → kc = kf / D → 0 < Δf → Δc = (D : ℝ) * Δf →
      |(((kf : ℝ) + 1 / 2) * Δf) - (((kc : ℝ) + 1 / 2) * Δc)| ≤ (1 / 2) * Δc ∧
      ⌊(((kf : ℝ) + 1 / 2) * Δf) / Δc⌋ = kc :=
    fun kc kf D Δf Δc hD hkc hΔf hΔc => by
      have hD_pos : (0 : ℤ) < D := by omega
      have hD_real_pos : (0 : ℝ) < (D : ℝ) := by exact_mod_cast hD_pos
      let r : ℤ := kf % D
      have hkf_eq : kf = D * kc + r := by
        rw [hkc]
        exact (Int.mul_ediv_add_emod kf D).symm
      have hr0 : (0 : ℝ) ≤ (r : ℝ) := by exact_mod_cast Int.emod_nonneg kf (by omega)
      have hr1 : (r : ℝ) ≤ (D : ℝ) - 1 := by
        have hlt : r < D := Int.emod_lt_of_pos kf hD_pos
        have hle : r ≤ D - 1 := by omega
        exact_mod_cast hle
      have hkf_real : (kf : ℝ) = (D : ℝ) * (kc : ℝ) + (r : ℝ) := by exact_mod_cast hkf_eq
      constructor
      · rw [hΔc, hkf_real]
        have h_diff : (((D : ℝ) * (kc : ℝ) + (r : ℝ) + 1 / 2) * Δf -
            ((kc : ℝ) + 1 / 2) * ((D : ℝ) * Δf)) =
          ((r : ℝ) + 1 / 2 - (1 / 2) * (D : ℝ)) * Δf := by ring
        rw [h_diff, abs_mul, abs_of_pos hΔf]
        have habs : |(r : ℝ) + 1 / 2 - (1 / 2) * (D : ℝ)| ≤ (1 / 2) * (D : ℝ) := by
          rw [abs_le]
          constructor <;> linarith
        calc |(r : ℝ) + 1 / 2 - (1 / 2) * (D : ℝ)| * Δf
            ≤ ((1 / 2) * (D : ℝ)) * Δf := mul_le_mul_of_nonneg_right habs hΔf.le
          _ = (1 / 2) * ((D : ℝ) * Δf) := by ring
      · have h_quot : (((kf : ℝ) + 1 / 2) * Δf) / Δc =
            (kc : ℝ) + ((r : ℝ) + 1 / 2) / (D : ℝ) := by
          rw [hΔc, hkf_real]
          field_simp [hΔf.ne', hD_real_pos.ne']
          ring
        rw [h_quot]
        refine le_antisymm ?_ ?_
        · have hlt : ⌊(kc : ℝ) + ((r : ℝ) + 1 / 2) / (D : ℝ)⌋ < kc + 1 := by
            rw [Int.floor_lt]
            have h_lt1 : ((r : ℝ) + 1 / 2) / (D : ℝ) < 1 := by
              rw [div_lt_one hD_real_pos]
              linarith
            push_cast
            linarith
          omega
        · rw [Int.le_floor]
          have h_nn : 0 ≤ ((r : ℝ) + 1 / 2) / (D : ℝ) :=
            div_nonneg (by linarith) hD_real_pos.le
          linarith

  have h_time_step_mul : ∀ (m₁ m₂ : ℕ), m₁ ≤ m₂ →
      ((2 ^ (m₂ - m₁) : ℤ) : ℝ) * ((2 : ℝ) ^ m₂)⁻¹ = ((2 : ℝ) ^ m₁)⁻¹ :=
    fun m₁ m₂ hm12 => by
      push_cast
      have hpow : (2 : ℝ) ^ (m₂ - m₁) * (2 : ℝ) ^ m₁ = (2 : ℝ) ^ m₂ := by
        rw [← pow_add, Nat.sub_add_cancel hm12]
      have hne1 : (2 : ℝ) ^ m₁ ≠ 0 := pow_ne_zero m₁ (by norm_num)
      have hne2 : (2 : ℝ) ^ m₂ ≠ 0 := pow_ne_zero m₂ (by norm_num)
      field_simp [hne1, hne2]
      linarith

  have h_real_step_mul : ∀ (s L₁ L₂ : ℝ),
      dyadicRealLevel s L₁ ≤ dyadicRealLevel s L₂ →
      ((2 ^ (dyadicRealLevel s L₂ - dyadicRealLevel s L₁).toNat : ℤ) : ℝ) *
        dyadicRealStep s L₂ = dyadicRealStep s L₁ :=
    fun s L₁ L₂ hℓ => by
      unfold dyadicRealStep
      have hnn : 0 ≤ dyadicRealLevel s L₂ - dyadicRealLevel s L₁ := sub_nonneg.mpr hℓ
      push_cast
      rw [← zpow_natCast (2 : ℝ) (dyadicRealLevel s L₂ - dyadicRealLevel s L₁).toNat,
          Int.toNat_of_nonneg hnn, ← zpow_add₀ (by norm_num : (2 : ℝ) ≠ 0)]
      congr 1
      omega

  
  let packObs6 : (ℤ × ℤ) → (Fin 4 → ℤ) → (ℤ × ℤ × ℤ × ℤ × ℤ × ℤ) :=
    fun kr kv => (kr.1, kr.2, kv 0, kv 1, kv 2, kv 3)
  let unpackObs6 : (ℤ × ℤ × ℤ × ℤ × ℤ × ℤ) → (Fin 4 → ℤ) :=
    fun o => ![o.2.2.1, o.2.2.2.1, o.2.2.2.2.1, o.2.2.2.2.2]
  have h_pack_unpack : ∀ o : (ℤ × ℤ × ℤ × ℤ × ℤ × ℤ),
      packObs6 (o.1, o.2.1) (unpackObs6 o) = o := fun _ => rfl
  have h_obs6_box_mem : ∀ (kr : ℤ × ℤ) (I : Fin 4 → Finset ℤ) (o : ℤ × ℤ × ℤ × ℤ × ℤ × ℤ),
      (o.1, o.2.1) = kr → (∀ j : Fin 4, unpackObs6 o j ∈ I j) →
      o ∈ (Fintype.piFinset I).image (packObs6 kr) :=
    fun kr I o hkr hmem => by
      refine Finset.mem_image.mpr ⟨unpackObs6 o, Fintype.mem_piFinset.mpr hmem, ?_⟩
      rw [← hkr, h_pack_unpack]
  have h_obs6_box_card : ∀ (kr : ℤ × ℤ) (I : Fin 4 → Finset ℤ),
      ((Fintype.piFinset I).image (packObs6 kr)).card ≤ ∏ j : Fin 4, (I j).card :=
    fun kr I => Finset.card_image_le.trans (le_of_eq (Fintype.card_piFinset I))

  let L₀ : Fin 4 → ℝ := ![i, i + u', i + m * u', i + (1 + m) * u']
  let shearFactor : Fin 4 → ℝ := ![1, 3 / 2, 2, 3]
  let H_adv : Fin 4 → ℕ := ![1, 2, 2, 3]

  have h_shear_add : ∀ (P₁ P₂ : Fin 4 → ℝ) (ab : ℝ × ℝ) (j : Fin 4),
      canonicalShear4 (fun k => P₁ k + P₂ k) ab j =
        canonicalShear4 P₁ ab j + canonicalShear4 P₂ ab j :=
    fun P₁ P₂ ab j => by
      fin_cases j <;> simp [canonicalShear4] <;> ring

  have h_shear_sub : ∀ (P₁ P₂ : Fin 4 → ℝ) (ab : ℝ × ℝ) (j : Fin 4),
      canonicalShear4 (fun k => P₁ k - P₂ k) ab j =
        canonicalShear4 P₁ ab j - canonicalShear4 P₂ ab j :=
    fun P₁ P₂ ab j => by
      fin_cases j <;> simp [canonicalShear4] <;> ring

  have h_shear_inv : ∀ (P : Fin 4 → ℝ) (ab : ℝ × ℝ) (j : Fin 4),
      canonicalShear4 (canonicalShear4 P ab) (-ab.1, -ab.2) j = P j :=
    fun P ab j => by
      fin_cases j <;> simp [canonicalShear4] <;> ring

  have h_shear_scale : ∀ (P : Fin 4 → ℝ) (θ : ℝ × ℝ) (j : Fin 4),
      canonicalShear4 (fun k => ε ^ (L₀ k) * P k) (ε ^ u' * θ.1, ε ^ (m * u') * θ.2) j =
        ε ^ (L₀ j) * canonicalShear4 P θ j :=
    fun P θ j => by
      have hL1 : ε ^ (i + u') = ε ^ i * ε ^ u' := Real.rpow_add hε₀ i u'
      have hL2 : ε ^ (i + m * u') = ε ^ i * ε ^ (m * u') := Real.rpow_add hε₀ i (m * u')
      have hL3 : ε ^ (i + (1 + m) * u') = ε ^ i * ε ^ u' * ε ^ (m * u') := by
        rw [show i + (1 + m) * u' = (i + u') + m * u' by ring, Real.rpow_add hε₀, hL1]
      fin_cases j <;> simp [canonicalShear4, L₀, hL1, hL2, hL3] <;> ring

  have h_shear_bound : ∀ (E : Fin 4 → ℝ) (B : ℝ) (ab : ℝ × ℝ),
      0 ≤ B → (∀ k : Fin 4, |E k| ≤ B) → |ab.1| ≤ 1 / 2 → |ab.2| ≤ 1 →
      ∀ j : Fin 4, |canonicalShear4 E ab j| ≤ shearFactor j * B :=
    fun E B ab hB hE hab1 hab2 j => by
      fin_cases j
      · dsimp [canonicalShear4, shearFactor]
        linarith [hE 0]
      · dsimp [canonicalShear4, shearFactor]
        have hm1 : |ab.1 * E 0| ≤ (1 / 2) * B := by
          rw [abs_mul]
          exact mul_le_mul hab1 (hE 0) (abs_nonneg _) (by norm_num)
        calc |E 1 + ab.1 * E 0| ≤ |E 1| + |ab.1 * E 0| := abs_add_le _ _
          _ ≤ B + (1 / 2) * B := add_le_add (hE 1) hm1
          _ = (3 / 2) * B := by ring
      · dsimp [canonicalShear4, shearFactor]
        have hm2 : |ab.2 * E 0| ≤ 1 * B := by
          rw [abs_mul]
          exact mul_le_mul hab2 (hE 0) (abs_nonneg _) zero_le_one
        calc |E 2 + ab.2 * E 0| ≤ |E 2| + |ab.2 * E 0| := abs_add_le _ _
          _ ≤ B + 1 * B := add_le_add (hE 2) hm2
          _ = 2 * B := by ring
      · dsimp [canonicalShear4, shearFactor]
        have hm1 : |ab.1 * E 2| ≤ (1 / 2) * B := by
          rw [abs_mul]
          exact mul_le_mul hab1 (hE 2) (abs_nonneg _) (by norm_num)
        have hm2 : |ab.2 * E 1| ≤ 1 * B := by
          rw [abs_mul]
          exact mul_le_mul hab2 (hE 1) (abs_nonneg _) zero_le_one
        have hab12 : |ab.1 * ab.2| ≤ 1 / 2 := by
          rw [abs_mul]
          calc |ab.1| * |ab.2| ≤ (1 / 2) * 1 :=
                mul_le_mul hab1 hab2 (abs_nonneg _) (by norm_num)
            _ = 1 / 2 := by ring
        have hm3 : |ab.1 * ab.2 * E 0| ≤ (1 / 2) * B := by
          rw [abs_mul]
          exact mul_le_mul hab12 (hE 0) (abs_nonneg _) (by norm_num)
        calc |E 3 + ab.1 * E 2 + ab.2 * E 1 + ab.1 * ab.2 * E 0|
            ≤ |E 3 + ab.1 * E 2 + ab.2 * E 1| + |ab.1 * ab.2 * E 0| := abs_add_le _ _
          _ ≤ |E 3 + ab.1 * E 2| + |ab.2 * E 1| + |ab.1 * ab.2 * E 0| :=
              add_le_add (abs_add_le _ _) le_rfl
          _ ≤ |E 3| + |ab.1 * E 2| + |ab.2 * E 1| + |ab.1 * ab.2 * E 0| :=
              add_le_add (add_le_add (abs_add_le _ _) le_rfl) le_rfl
          _ ≤ B + (1 / 2) * B + 1 * B + (1 / 2) * B :=
              add_le_add (add_le_add (add_le_add (hE 3) hm1) hm2) hm3
          _ = 3 * B := by ring

  let D₀_bar : (ℤ × ℤ × ℤ × ℤ × ℤ × ℤ) → (Fin 4 → ℝ) :=
    fun e j => ((unpackObs6 e j : ℝ) + 1 / 2) * dyadicRealStep ε (L₀ j)
  let δ_of : (ℤ × ℤ × ℤ × ℤ × ℤ × ℤ) → (ℤ × ℤ) → ℝ × ℝ :=
    fun e β => (ε ^ u' * (θ_fn e β).1, ε ^ (m * u') * (θ_fn e β).2)
  let offset : (ℤ × ℤ × ℤ × ℤ × ℤ × ℤ) → (ℤ × ℤ) → (Fin 4 → ℝ) :=
    fun e β => canonicalShear4 (D₀_bar e) (δ_of e β)
  let physVec : EuclideanSpace ℝ (Fin 2) → EuclideanSpace ℝ (Fin 2) → ℝ → ℝ → (Fin 4 → ℝ) :=
    fun V_p A_p C R =>
      ![V_p 0, A_p 0 + C * V_p 0, V_p 1 - R * V_p 0,
        A_p 1 + C * V_p 1 - R * (A_p 0 + C * V_p 0)]
  let P_raw_fn : EuclideanSpace ℝ (Fin 2) → EuclideanSpace ℝ (Fin 2) → ℝ → ℝ → (Fin 4 → ℝ) :=
    fun V_p A_p c_s R_s =>
      let D₀ := physVec V_p A_p (dyadicTimeMid ε u' c_s) (dyadicRealMid ε (m * u') R_s)
      fun j => ε ^ (-L₀ j) * (D₀ j - dyadicRealMid ε (L₀ j) (D₀ j))

  have h_traj : ∀ (V_p A_p : EuclideanSpace ℝ (Fin 2)) (c_s R_s : ℝ),
      let e := e_fn V_p A_p c_s R_s
      let κ := κ_fn V_p A_p c_s R_s
      let β := β_fn c_s R_s
      let θ := θ_fn e β
      let P_raw := P_raw_fn V_p A_p c_s R_s
      let D₀ := physVec V_p A_p (dyadicTimeMid ε u' c_s) (dyadicRealMid ε (m * u') R_s)
      let D₁ := physVec V_p A_p (dyadicTimeMid ε v₁ c_s) (dyadicRealMid ε (m * v₁) R_s)
      κ = (fun j => canonicalGridBin ρ (P_raw j)) ∧
      gridMidPt4 ρ κ = (fun j => canonicalGridMid ρ (P_raw j)) ∧
      (∀ j : Fin 4, |P_raw j| ≤ 1) ∧
      (∀ j : Fin 4, |gridMidPt4 ρ κ j - P_raw j| ≤ (1 / 2) * ρ) ∧
      |θ.1| ≤ 1 / 2 ∧ |θ.2| ≤ 1 ∧
      (∀ j : Fin 4,
        |canonicalShear4 (gridMidPt4 ρ κ) θ j - canonicalShear4 P_raw θ j| ≤ (3 / 2) * ρ) ∧
      (∀ j : Fin 4, D₀ j = D₀_bar e j + ε ^ (L₀ j) * P_raw j) ∧
      (∀ j : Fin 4, D₁ j = canonicalShear4 D₀ (δ_of e β) j) ∧
      (∀ j : Fin 4, D₁ j = offset e β j + ε ^ (L₀ j) * canonicalShear4 P_raw θ j) :=
    fun V_p A_p c_s R_s => by
      dsimp only
      set e := e_fn V_p A_p c_s R_s
      set κ := κ_fn V_p A_p c_s R_s
      set β := β_fn c_s R_s
      set θ := θ_fn e β
      set P_raw := P_raw_fn V_p A_p c_s R_s
      set D₀ := physVec V_p A_p (dyadicTimeMid ε u' c_s) (dyadicRealMid ε (m * u') R_s)
      set D₁ := physVec V_p A_p (dyadicTimeMid ε v₁ c_s) (dyadicRealMid ε (m * v₁) R_s)
      have hκ_eq : κ = (fun j => canonicalGridBin ρ (P_raw j)) := rfl
      have h_gmid_eq : gridMidPt4 ρ κ = (fun j => canonicalGridMid ρ (P_raw j)) := rfl
      have hP_le1 : ∀ j : Fin 4, |P_raw j| ≤ 1 := fun j => by
        dsimp [P_raw, P_raw_fn]
        obtain ⟨_, _, _, _, _, _, _, _, _, h_rmid⟩ :=
          h_dyad ε 0 0 0 (L₀ j) (L₀ j) (D₀ j) hε₀ hε₁ le_rfl le_rfl le_rfl
        have hpos : 0 < ε ^ (-L₀ j) := Real.rpow_pos_of_pos hε₀ _
        rw [abs_mul, abs_of_pos hpos]
        calc ε ^ (-L₀ j) * |D₀ j - dyadicRealMid ε (L₀ j) (D₀ j)|
            ≤ ε ^ (-L₀ j) * ε ^ (L₀ j) := mul_le_mul_of_nonneg_left h_rmid hpos.le
          _ = 1 := (h_rpow_cancel (L₀ j)).2
      have h_gmid_err : ∀ j : Fin 4, |gridMidPt4 ρ κ j - P_raw j| ≤ (1 / 2) * ρ := fun j => by
        rw [h_gmid_eq]
        exact h_gridMid_err (P_raw j)
      obtain ⟨h_tlvl, h_tbin, _, h_tstep_hi, _, h_rlvl, h_rbin, _, h_rstep_hi, _⟩ :=
        h_dyad ε u' v₁ c_s (m * u') (m * v₁) R_s hε₀ hε₁ hu'0 huv₁ hmuv₁
      have hθ1 : |θ.1| ≤ 1 / 2 := by
        dsimp [θ, θ_fn, cellThetaOfBins]
        have he1 : e.1 = dyadicTimeBin ε u' c_s := rfl
        have hβ1 : β.1 = dyadicTimeBin ε v₁ c_s := rfl
        rw [he1, hβ1]
        let Dc : ℤ := (2 ^ (dyadicTimeLevel ε v₁ - dyadicTimeLevel ε u') : ℤ)
        have hDc : 1 ≤ Dc := one_le_pow₀ (by norm_num : (1 : ℤ) ≤ 2)
        have hΔf_pos : 0 < ((2 : ℝ) ^ (dyadicTimeLevel ε v₁))⁻¹ :=
          inv_pos.mpr (pow_pos (by norm_num : (0 : ℝ) < 2) _)
        have hΔc_eq : ((2 : ℝ) ^ (dyadicTimeLevel ε u'))⁻¹ =
            (Dc : ℝ) * ((2 : ℝ) ^ (dyadicTimeLevel ε v₁))⁻¹ :=
          (h_time_step_mul _ _ h_tlvl).symm
        have h_cm := (h_coarsen_mid_and_floor _ _ Dc _ _ hDc h_tbin hΔf_pos hΔc_eq).1
        have h_diff_le : |(((dyadicTimeBin ε v₁ c_s : ℝ) + 1 / 2) *
            ((2 : ℝ) ^ (dyadicTimeLevel ε v₁))⁻¹) -
            (((dyadicTimeBin ε u' c_s : ℝ) + 1 / 2) *
            ((2 : ℝ) ^ (dyadicTimeLevel ε u'))⁻¹)| ≤ (1 / 2) * ε ^ u' :=
          h_cm.trans (mul_le_mul_of_nonneg_left h_tstep_hi (by norm_num))
        have hpos : 0 < ε ^ (-u') := Real.rpow_pos_of_pos hε₀ _
        rw [abs_mul, abs_of_pos hpos]
        calc ε ^ (-u') * |(((dyadicTimeBin ε v₁ c_s : ℝ) + 1 / 2) *
              ((2 : ℝ) ^ (dyadicTimeLevel ε v₁))⁻¹) -
              (((dyadicTimeBin ε u' c_s : ℝ) + 1 / 2) *
              ((2 : ℝ) ^ (dyadicTimeLevel ε u'))⁻¹)|
            ≤ ε ^ (-u') * ((1 / 2) * ε ^ u') := mul_le_mul_of_nonneg_left h_diff_le hpos.le
          _ = (1 / 2) * (ε ^ (-u') * ε ^ u') := by ring
          _ = 1 / 2 := by rw [(h_rpow_cancel u').2]; ring
      have hθ2 : |θ.2| ≤ 1 := by
        dsimp [θ, θ_fn, cellThetaOfBins]
