        (E_v.image (fun p => ⌊(x_pt p - c_pt p * v_bar) / ρ⌋)).card := by
      have h_eq_fn : (fun p =>
          (⌊(x2 p 0 - c_pt p * v2 0) / ρ⌋, ⌊(x2 p 1 - c_pt p * v2 1) / ρ⌋)) =
          (fun z : ℤ => (z, (0 : ℤ))) ∘ (fun p => ⌊(x_pt p - c_pt p * v_bar) / ρ⌋) := by
        ext p <;> simp [x2, v2]
      rw [h_eq_fn, ← Finset.image_image]
      exact Finset.card_image_of_injective _ (fun a b hab => (Prod.ext_iff.mp hab).1)
    rwa [h_img] at h2d

  let Δ_star : ℝ := (β - γ) / 10
  have hΔ_pos : 0 < Δ_star := by dsimp [Δ_star]; linarith only [hβ_gt_γ]
  have hΔ_le : Δ_star ≤ 1 / 5 := by dsimp [Δ_star]; linarith only [hγ₀, hβ_le_two]
