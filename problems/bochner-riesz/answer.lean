        ∃ ε_sgn : ℝ, (ε_sgn = 1 ∨ ε_sgn = -1) ∧
          let θ_pos : ℝ → ℝ := fun y => ε_sgn * Θ y
          (∀ k : ℕ, ContDiff ℝ k θ_pos) ∧
          (∀ y : ℝ, L ≤ deriv θ_pos y) ∧
          (∀ m : ℕ, 1 ≤ m → ∀ y : ℝ, |iteratedDeriv m (deriv θ_pos) y| ≤ L * D_phase m) := by
    intro Φ₀ ζ₀ h_phase lam_loc s c_end hlam hs hs1 hlam_lo hlam_hi hc_end
      x₀ n_P v v' hn_P h_norm_off h_tan_sep
    obtain ⟨hΦ_cd, hζ_cd, _, _, _, hΦ_grad, hζ_symm, hζ_pd, hζ_gev⟩ := h_phase
    dsimp only
    let τ_P : EuclideanSpace ℝ (Fin 2) := perp2D n_P
    let δ : EuclideanSpace ℝ (Fin 2) := v - v'
    let δ_n : ℝ := inner ℝ δ n_P
    let δ_τ : ℝ := inner ℝ δ τ_P
    let L : ℝ := (a₀ / (2 * B_cell)) * (|δ_τ| / s)
    let D_phase : ℕ → ℝ := fun m => (4 * B_cell ^ 2 / a₀) * A ^ (m + 1) * ((m.factorial : ℝ) ^ 3)
    have hn_sq : (n_P 0) ^ 2 + (n_P 1) ^ 2 = 1 := by
      have h1 : ‖n_P‖ ^ 2 = 1 := by rw [hn_P]; norm_num
      rw [PiLp.norm_sq_eq_of_L2, Fin.sum_univ_two] at h1
      simpa [Real.norm_eq_abs, sq_abs] using h1
    have hτ_norm : ‖τ_P‖ = 1 := by
      have hsq : ‖τ_P‖ ^ 2 = 1 := by
        rw [PiLp.norm_sq_eq_of_L2, Fin.sum_univ_two]
        simp only [τ_P, perp2D, Real.norm_eq_abs, sq_abs]
        dsimp
        linear_combination hn_sq
      nlinarith [norm_nonneg τ_P]
    have h_orth : inner ℝ τ_P n_P = 0 := by
      rw [PiLp.inner_apply, Fin.sum_univ_two]
      simp [τ_P, perp2D]
      ring
    have hδ_decomp : δ = δ_n • n_P + δ_τ • τ_P := by
      ext i
      fin_cases i
      · simp [δ_n, δ_τ, τ_P, perp2D, PiLp.inner_apply, Fin.sum_univ_two]
        linear_combination -(δ.ofLp 0) * hn_sq
      · simp [δ_n, δ_τ, τ_P, perp2D, PiLp.inner_apply, Fin.sum_univ_two]
        linear_combination -(δ.ofLp 1) * hn_sq
    have hδ_norm_sq : ‖δ‖ ^ 2 = δ_n ^ 2 + δ_τ ^ 2 := by
      conv_lhs => rw [hδ_decomp]
      rw [PiLp.norm_sq_eq_of_L2, Fin.sum_univ_two]
      simp only [τ_P, perp2D, PiLp.add_apply, PiLp.smul_apply, smul_eq_mul,
        Real.norm_eq_abs, sq_abs]
      dsimp
      linear_combination (δ_n ^ 2 + δ_τ ^ 2) * hn_sq
    have ha_ratio : 1 ≤ a₁ / a₀ := (one_le_div ha₀).mpr ha₁
    have h_Bs_le : (B_cell + 8) * s ≤ (a₁ * (B_cell + 8) / a₀) * s := by
      have hBs_nn : 0 ≤ (B_cell + 8) * s := by positivity
      have h_eq : (a₁ * (B_cell + 8) / a₀) * s = (a₁ / a₀) * ((B_cell + 8) * s) := by ring
      rw [h_eq]
      nlinarith [ha_ratio, hBs_nn]
    have hδ_n_le_τ : |δ_n| ≤ |δ_τ| :=
      le_trans h_norm_off (le_trans h_Bs_le h_tan_sep)
    have hδ_τ_pos : 0 < |δ_τ| := by
      have h1 : (B_cell + 8) * s ≤ |δ_τ| := le_trans h_Bs_le h_tan_sep
      nlinarith [hB, hs]
    have hL_pos : 0 < L := by
      dsimp only [L]
      positivity
    have hδ_norm_le : ‖δ‖ ≤ 2 * |δ_τ| := by
      have h1 : ‖δ‖ ^ 2 ≤ (2 * |δ_τ|) ^ 2 := by
        rw [hδ_norm_sq]
        have hn2 : δ_n ^ 2 ≤ |δ_τ| ^ 2 := by
          rw [← sq_abs δ_n]
          exact pow_le_pow_left₀ (abs_nonneg _) hδ_n_le_τ 2
        have hτ2 : δ_τ ^ 2 = |δ_τ| ^ 2 := (sq_abs _).symm
        nlinarith
      nlinarith [norm_nonneg δ, hδ_τ_pos]
    refine ⟨hL_pos, ?_⟩
    let ε_sgn : ℝ := if 0 ≤ δ_τ then 1 else -1
    have hε_cases : ε_sgn = 1 ∨ ε_sgn = -1 := by
      dsimp only [ε_sgn]; split_ifs <;> simp
    have hε_abs : |ε_sgn| = 1 := by
      rcases hε_cases with h | h <;> simp [h]
    have hε_mul : ε_sgn * δ_τ = |δ_τ| := by
