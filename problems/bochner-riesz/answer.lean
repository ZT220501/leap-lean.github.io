        exact le_trans hm_step (mul_le_mul_of_nonneg_right h_fac hm_par_nn)
      · rw [if_neg hq_b₀] at hb₀
        exact absurd rfl hb₀
  have h_pair_factor_le : ∀ (ev M_r d_val : ℝ),
      0 ≤ ev → M_r ≤ 1 → 0 < d_val → 1 ≤ d_val⁻¹ →
      ev * M_r * d_val ^ (-2 : ℤ) ≤ ev * d_val ^ (-3 : ℤ) := by
    intro ev M_r d_val hev hMr hd_pos hd_ge1
    have hd2_eq : d_val ^ (-2 : ℤ) = (d_val⁻¹) ^ 2 := (inv_pow d_val 2).symm
    have hd3_eq : d_val ^ (-3 : ℤ) = (d_val⁻¹) ^ 3 := (inv_pow d_val 3).symm
    rw [hd2_eq, hd3_eq]
    have hd2_nn : 0 ≤ (d_val⁻¹) ^ 2 := sq_nonneg _
    have hd2_le_d3 : (d_val⁻¹) ^ 2 ≤ (d_val⁻¹) ^ 3 := by
      calc (d_val⁻¹) ^ 2 = (d_val⁻¹) ^ 2 * 1 := (mul_one _).symm
        _ ≤ (d_val⁻¹) ^ 2 * d_val⁻¹ := mul_le_mul_of_nonneg_left hd_ge1 hd2_nn
        _ = (d_val⁻¹) ^ 3 := by ring
    calc ev * M_r * (d_val⁻¹) ^ 2
        ≤ ev * 1 * (d_val⁻¹) ^ 2 :=
          mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hMr hev) hd2_nn
      _ = ev * (d_val⁻¹) ^ 2 := by ring
      _ ≤ ev * (d_val⁻¹) ^ 3 := mul_le_mul_of_nonneg_left hd2_le_d3 hev
  
  let K : ℝ := max 2 (2 / m)
  have hK_ge2 : 2 ≤ K := le_max_left 2 (2 / m)
  have hK_pos : 0 < K := by linarith only [hK_ge2]
  let N_blk : ℝ := (⌈4 / σ⌉₊ : ℝ) + 2
  have hN_blk_ge2 : 2 ≤ N_blk := by
    dsimp [N_blk]
    have h0 : (0 : ℝ) ≤ (⌈4 / σ⌉₊ : ℝ) := Nat.cast_nonneg _
    linarith only [h0]
  have hN_blk_pos : 0 < N_blk := by linarith only [hN_blk_ge2]
  let δ₀ : ℝ := min 1 m / (K * N_blk)
  have hmin1m_pos : 0 < min 1 m := lt_min zero_lt_one hm
  have hmin1m_le1 : min 1 m ≤ 1 := min_le_left 1 m
  have hδ₀_pos : 0 < δ₀ := div_pos hmin1m_pos (mul_pos hK_pos hN_blk_pos)
  have hKδ₀_le1 : K * δ₀ ≤ 1 := by
    have h_eq : K * δ₀ = min 1 m / N_blk := by
      dsimp [δ₀]
      field_simp [hK_pos.ne', hN_blk_pos.ne']
    rw [h_eq, div_le_one hN_blk_pos]
    linarith only [hmin1m_le1, hN_blk_ge2]
  have h_ev_u : ∀ᶠ n in Filter.atTop, u + K * h_seq n < 1 := by
    have h_lim : Filter.Tendsto (fun n => u + K * h_seq n) Filter.atTop (nhds (u + K * 0)) :=
      tendsto_const_nhds.add (tendsto_const_nhds.mul hh_lim)
    rw [mul_zero, add_zero] at h_lim
    exact h_lim.eventually (gt_mem_nhds hu.2)
  have h_ev_S : ∀ η_a : ℝ, 0 < η_a →
      ∀ᶠ n in Filter.atTop, ∀ t₀ ∈ Set.Icc (0 : ℝ) (1 - K * δ₀),
        ∀ a b : ℝ, 0 ≤ a → a ≤ b → b ≤ K →
          |(sys.S ((u + t₀ * h_seq n) + b * (δ₀ * h_seq n)) -
            sys.S ((u + t₀ * h_seq n) + a * (δ₀ * h_seq n))) / (δ₀ * h_seq n) -
            s * (b - a)| ≤ η_a := by
    intro η_a hη_a
    have h_o := hasDerivAt_iff_isLittleO_nhds_zero.mp hS_der
    let c_S : ℝ := δ₀ * η_a / 2
    have hc_S : 0 < c_S := by positivity
    obtain ⟨δ_S, hδ_S_pos, hδ_S⟩ := Metric.eventually_nhds_iff.mp (h_o.bound hc_S)
    filter_upwards [hh_lim.eventually (gt_mem_nhds hδ_S_pos)] with n hn t₀ ht₀ a b ha hab hbK
    have hh_n : 0 < h_seq n := hh_pos n
    have hh'_n : 0 < δ₀ * h_seq n := mul_pos hδ₀_pos hh_n
    let t₁ : ℝ := t₀ * h_seq n + a * (δ₀ * h_seq n)
    let t₂ : ℝ := t₀ * h_seq n + b * (δ₀ * h_seq n)
    have ht₁_nn : 0 ≤ t₁ :=
      add_nonneg (mul_nonneg ht₀.1 hh_n.le) (mul_nonneg ha hh'_n.le)
    have ht₂_nn : 0 ≤ t₂ :=
      add_nonneg (mul_nonneg ht₀.1 hh_n.le) (mul_nonneg (le_trans ha hab) hh'_n.le)
    have ht₂_le_h : t₂ ≤ h_seq n := by
      calc t₂ = (t₀ + b * δ₀) * h_seq n := by dsimp [t₂]; ring
        _ ≤ (1 - K * δ₀ + K * δ₀) * h_seq n := by
            refine mul_le_mul_of_nonneg_right ?_ hh_n.le
            have hb_le : b * δ₀ ≤ K * δ₀ := mul_le_mul_of_nonneg_right hbK hδ₀_pos.le
            linarith only [ht₀.2, hb_le]
        _ = h_seq n := by ring
    have ht₁_le_h : t₁ ≤ h_seq n :=
      le_trans (add_le_add le_rfl (mul_le_mul_of_nonneg_right hab hh'_n.le)) ht₂_le_h
    have hb1 := hδ_S (y := t₁) (by
      rw [Real.dist_eq, sub_zero, abs_of_nonneg ht₁_nn]; linarith only [ht₁_le_h, hn])
    have hb2 := hδ_S (y := t₂) (by
      rw [Real.dist_eq, sub_zero, abs_of_nonneg ht₂_nn]; linarith only [ht₂_le_h, hn])
    rw [Real.norm_eq_abs, Real.norm_eq_abs, abs_of_nonneg ht₁_nn] at hb1
    rw [Real.norm_eq_abs, Real.norm_eq_abs, abs_of_nonneg ht₂_nn] at hb2
    have h_eq1 : (u + t₀ * h_seq n) + a * (δ₀ * h_seq n) = u + t₁ := by dsimp [t₁]; ring
    have h_eq2 : (u + t₀ * h_seq n) + b * (δ₀ * h_seq n) = u + t₂ := by dsimp [t₂]; ring
    have h_num : |(sys.S (u + t₂) - sys.S (u + t₁)) - s * (b - a) * (δ₀ * h_seq n)| ≤
        η_a * (δ₀ * h_seq n) := by
      have h_id : (sys.S (u + t₂) - sys.S (u + t₁)) - s * (b - a) * (δ₀ * h_seq n) =
          (sys.S (u + t₂) - sys.S u - t₂ * s) - (sys.S (u + t₁) - sys.S u - t₁ * s) := by
        dsimp [t₁, t₂]; ring
      rw [h_id]
      calc |(sys.S (u + t₂) - sys.S u - t₂ * s) - (sys.S (u + t₁) - sys.S u - t₁ * s)|
          ≤ |sys.S (u + t₂) - sys.S u - t₂ * s| + |sys.S (u + t₁) - sys.S u - t₁ * s| :=
            abs_sub _ _
        _ ≤ c_S * t₂ + c_S * t₁ := add_le_add hb2 hb1
        _ ≤ c_S * h_seq n + c_S * h_seq n :=
            add_le_add (mul_le_mul_of_nonneg_left ht₂_le_h hc_S.le)
              (mul_le_mul_of_nonneg_left ht₁_le_h hc_S.le)
        _ = η_a * (δ₀ * h_seq n) := by dsimp [c_S]; ring
    have h_quot : (sys.S (u + t₂) - sys.S (u + t₁)) / (δ₀ * h_seq n) - s * (b - a) =
        ((sys.S (u + t₂) - sys.S (u + t₁)) - s * (b - a) * (δ₀ * h_seq n)) / (δ₀ * h_seq n) := by
      field_simp [hh'_n.ne']
    rw [h_eq1, h_eq2, h_quot, abs_div, abs_of_pos hh'_n, div_le_iff₀ hh'_n]
    exact h_num
  have h_ev_blow_gen : ∀ (n : ℕ) (c : Fin n → ℝ) (E : Fin n → Fin n → Prop)
      (F : ((Fin n → ℝ) × ℝ) → ℝ) (a_n : Fin n → ℝ),
      (∀ j : Fin n, |c j| ≤ 2 + m) →
      (∀ (R ε_err : ℝ), 1 ≤ R → 0 < ε_err →
        ∀ᶠ idx in Filter.atTop, ∀ ξ : (Fin n → ℝ) × ℝ,
          InDispCone n c E ξ → (∀ j, |ξ.1 j| ≤ R) → |ξ.2| ≤ R →
          |(F (planeEmbed n c (i, u) + h_seq idx • ξ) - F (planeEmbed n c (i, u))) / h_seq idx -
            ((∑ j : Fin n, a_n j * ξ.1 j) + D_pt * ξ.2)| ≤ ε_err) →
      ∀ η_a : ℝ, 0 < η_a →
        ∀ᶠ idx in Filter.atTop, ∀ t₀ ∈ Set.Icc (0 : ℝ) (1 - K * δ₀),
          ∀ ζ : (Fin n → ℝ) × ℝ,
            InDispCone n c E ζ → (∀ j, |ζ.1 j| ≤ K + 2) → |ζ.2| ≤ K + 2 →
            |(F (planeEmbed n c (i, u + t₀ * h_seq idx) + (δ₀ * h_seq idx) • ζ) -
              F (planeEmbed n c (i, u + t₀ * h_seq idx))) / (δ₀ * h_seq idx) -
              ((∑ j : Fin n, a_n j * ζ.1 j) + D_pt * ζ.2)| ≤ η_a := by
    intro n c E F a_n hc_bd h_bl η_a hη_a
