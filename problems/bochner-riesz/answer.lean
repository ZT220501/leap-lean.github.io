    mul_le_mul_of_nonneg_right (by linarith) ht_pos.le
  linarith

theorem gauge_rescaling_and_duration_saturation (γ : ℝ) (hγ₀ : 0 < γ) (hγ₁ : γ < 1)
    (h_one : (1 : ℝ) ∈ ValidPacketGrowthRates γ)
    (h_gt : γ / 2 < quantumPacketRate γ) :
    0 < quantumPacketRate γ ∧
    quantumPacketRate γ ≤ 1 ∧
    LocalPhaseRescalingValid ∧
    DurationScalingValid γ ∧
    UniformPacketGrowthModulus γ (quantumPacketRate γ) ∧
    (∀ Δ : ℝ, 0 < Δ → ∃ cls : PacketBoundClass, IsDurationOneSaturatingClass γ Δ cls) :=
by
  have _ := hγ₁
  have hβ_pos : 0 < quantumPacketRate γ := by linarith
  have h_bdd : BddBelow (ValidPacketGrowthRates γ) := ⟨0, fun _ hb => hb.1⟩
  have hβ_le : quantumPacketRate γ ≤ 1 := csInf_le h_bdd h_one

  
  have h_resc : LocalPhaseRescalingValid := by
    intro a₀ a₁ A _ _ hA Φ₀ ζ₀ h_phase m_r m_t q_r hm_le hq_r
      ε H_P t r b_star s_v lam_sys hε hs_v_pos hs_v_le hs_v_eq _
      V_J X_J f hf_meas hf_l2
    dsimp only
    let s_c : ℝ := ((2 : ℝ) ^ m_r)⁻¹
    let C_r : ℝ := ((q_r : ℝ) + 1 / 2) * s_c
    let s_x : ℝ := s_c * s_v
    let c₀ : ℝ := C_r - s_c / 2
    let x₀ : EuclideanSpace ℝ (Fin 2) := X_J - (s_c / 2) • V_J
    let Φ'₀ := localGaugePhase Φ₀ m_r q_r s_v V_J X_J
    let ζ'₀ := localGaugeGrad ζ₀ m_r q_r s_v V_J X_J
    let f'₀ := localGaugeInput Φ₀ lam_sys m_r q_r s_v V_J X_J f
    have h2mr_pos : (0 : ℝ) < (2 : ℝ) ^ m_r := by positivity
    have hs_c_pos : 0 < s_c := inv_pos.mpr h2mr_pos
    have hs_x_pos : 0 < s_x := mul_pos hs_c_pos hs_v_pos
    have hs_x_ne : s_x ≠ 0 := ne_of_gt hs_x_pos
    have hq_r_le : (q_r : ℝ) + 1 ≤ (2 : ℝ) ^ m_r := by
      exact_mod_cast Nat.succ_le_of_lt hq_r
    have hq_r_sc_le1 : ((q_r : ℝ) + 1) * s_c ≤ 1 := by
      dsimp [s_c]
      rw [← div_eq_mul_inv, div_le_one h2mr_pos]
      exact hq_r_le
    have hc₀_mem : c₀ ∈ Set.Icc (0 : ℝ) 1 := by
      have hc₀_eq : c₀ = (q_r : ℝ) * s_c := by dsimp [c₀, C_r]; ring
      rw [hc₀_eq]
      refine ⟨mul_nonneg (Nat.cast_nonneg q_r) hs_c_pos.le, ?_⟩
      calc (q_r : ℝ) * s_c ≤ ((q_r : ℝ) + 1) * s_c :=
            mul_le_mul_of_nonneg_right (by linarith) hs_c_pos.le
        _ ≤ 1 := hq_r_sc_le1
    rcases h_phase with ⟨hΦ₀_smooth, hζ₀_smooth, _, _, _, hΦ₀_grad, hζ₀_symm, hζ₀_ell, hζ₀_gevrey⟩

    have hΦ'₀_smooth : ∀ k : ℕ, ContDiff ℝ k Φ'₀ := by
      intro k
      have hc_map : ContDiff ℝ k
          (fun cxv : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) =>
            C_r + s_c * (cxv.1 - 1 / 2)) :=
        contDiff_const.add (contDiff_const.mul (contDiff_fst.sub contDiff_const))
      have hx_map : ContDiff ℝ k
          (fun cxv : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) =>
            X_J + (s_c * (cxv.1 - 1 / 2)) • V_J + s_x • cxv.2.1) :=
        (contDiff_const.add
          ((contDiff_const.mul (contDiff_fst.sub contDiff_const)).smul contDiff_const)).add
          ((contDiff_const (c := s_x)).smul (contDiff_fst.comp contDiff_snd))
      have hv_map : ContDiff ℝ k
          (fun cxv : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) =>
            V_J + s_v • cxv.2.2) :=
        contDiff_const.add ((contDiff_const (c := s_v)).smul (contDiff_snd.comp contDiff_snd))
      exact contDiff_const.mul
        (((((hΦ₀_smooth k).comp (hc_map.prodMk (hx_map.prodMk hv_map))).sub
          ((hΦ₀_smooth k).comp (hc_map.prodMk (hx_map.prodMk contDiff_const)))).sub
          ((hΦ₀_smooth k).comp (contDiff_const.prodMk (contDiff_const.prodMk hv_map)))).add
          contDiff_const)

    have hζ'₀_smooth : ∀ k : ℕ, ContDiff ℝ k ζ'₀ := by
      intro k
      have hv_vp : ContDiff ℝ k
          (fun vp : EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) =>
            V_J + s_v • vp.1) :=
        contDiff_const.add ((contDiff_const (c := s_v)).smul contDiff_fst)
      have hp1_vp : ContDiff ℝ k
          (fun vp : EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) =>
            X_J - C_r • (V_J + s_v • vp.1) + s_x • (vp.2 + (1 / 2 : ℝ) • vp.1)) :=
        (contDiff_const.sub ((contDiff_const (c := C_r)).smul hv_vp)).add
          ((contDiff_const (c := s_x)).smul
            (contDiff_snd.add ((contDiff_const (c := (1 / 2 : ℝ))).smul contDiff_fst)))
      have hp2_vp : ContDiff ℝ k
          (fun vp : EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) =>
            X_J - C_r • (V_J + s_v • vp.1) + ((1 / 2 : ℝ) * s_x) • vp.1) :=
        (contDiff_const.sub ((contDiff_const (c := C_r)).smul hv_vp)).add
          ((contDiff_const (c := (1 / 2 : ℝ) * s_x)).smul contDiff_fst)
      exact (contDiff_const (c := s_x⁻¹)).smul
        (((hζ₀_smooth k).comp (hv_vp.prodMk hp1_vp)).sub
          ((hζ₀_smooth k).comp (hv_vp.prodMk hp2_vp)))

    have hΦ'₀_v0 : ∀ (c' : ℝ) (x' : EuclideanSpace ℝ (Fin 2)), Φ'₀ (c', x', 0) = 0 := by
      intro c' x'
      dsimp [Φ'₀, localGaugePhase]
      simp only [smul_zero, add_zero]
      ring

    have hΦ'₀_cx0 : ∀ v' : EuclideanSpace ℝ (Fin 2), Φ'₀ (0, 0, v') = 0 := by
      intro v'
      dsimp [Φ'₀, localGaugePhase]
      have hc0 : ((q_r : ℝ) + 1 / 2) * ((2 : ℝ) ^ m_r)⁻¹ + ((2 : ℝ) ^ m_r)⁻¹ * (0 - 1 / 2) =
          ((q_r : ℝ) + 1 / 2) * ((2 : ℝ) ^ m_r)⁻¹ - ((2 : ℝ) ^ m_r)⁻¹ / 2 := by ring
      have hx0 : X_J + (((2 : ℝ) ^ m_r)⁻¹ * (0 - 1 / 2)) • V_J +
          (((2 : ℝ) ^ m_r)⁻¹ * s_v) • (0 : EuclideanSpace ℝ (Fin 2)) =
          X_J - (((2 : ℝ) ^ m_r)⁻¹ / 2) • V_J := by
        ext i
        simp
        ring
      rw [hc0, hx0]
      ring

    have hζ'₀_p0 : ∀ v' : EuclideanSpace ℝ (Fin 2), ζ'₀ (v', 0) = 0 := by
      intro v'
      dsimp [ζ'₀, localGaugeGrad]
      have hp0 : (((2 : ℝ) ^ m_r)⁻¹ * s_v) • ((0 : EuclideanSpace ℝ (Fin 2)) + (1 / 2 : ℝ) • v') =
          ((1 / 2 : ℝ) * (((2 : ℝ) ^ m_r)⁻¹ * s_v)) • v' := by
        ext i
        simp
        ring
      rw [hp0, sub_self, smul_zero]

    have hΦ'₀_grad : ∀ (c' : ℝ), c' ∈ Set.Icc (0 : ℝ) 1 →
        ∀ (x' v' u : EuclideanSpace ℝ (Fin 2)),
          fderiv ℝ (fun w' => Φ'₀ (c', x', w')) v' u =
            inner ℝ (ζ'₀ (v', x' - c' • v')) u := by
      intro c' hc' x' v' u
      let c : ℝ := C_r + s_c * (c' - 1 / 2)
      let x : EuclideanSpace ℝ (Fin 2) := X_J + (s_c * (c' - 1 / 2)) • V_J + s_x • x'
      let v : EuclideanSpace ℝ (Fin 2) := V_J + s_v • v'
      have hc_mem : c ∈ Set.Icc (0 : ℝ) 1 := by
        have hc_eq : c = ((q_r : ℝ) + c') * s_c := by dsimp [c, C_r]; ring
        rw [hc_eq]
        refine ⟨mul_nonneg (add_nonneg (Nat.cast_nonneg q_r) hc'.1) hs_c_pos.le, ?_⟩
        calc ((q_r : ℝ) + c') * s_c ≤ ((q_r : ℝ) + 1) * s_c :=
              mul_le_mul_of_nonneg_right (by linarith [hc'.2]) hs_c_pos.le
          _ ≤ 1 := hq_r_sc_le1
      let α : EuclideanSpace ℝ (Fin 2) → EuclideanSpace ℝ (Fin 2) := fun w' => V_J + s_v • w'
      have hα_deriv : HasFDerivAt α
          (s_v • ContinuousLinearMap.id ℝ (EuclideanSpace ℝ (Fin 2))) v' := by
        have hα_eq : α = fun w' => V_J + s_v • id w' := rfl
        rw [hα_eq]
        exact ((hasFDerivAt_id v').const_smul s_v).const_add V_J
      have h_slice_comp : ∀ (cf : ℝ) (xf : EuclideanSpace ℝ (Fin 2)),
          HasFDerivAt (fun w' : EuclideanSpace ℝ (Fin 2) => Φ₀ (cf, xf, V_J + s_v • w'))
            ((fderiv ℝ (fun w => Φ₀ (cf, xf, w)) v).comp
              (s_v • ContinuousLinearMap.id ℝ (EuclideanSpace ℝ (Fin 2)))) v' := by
        intro cf xf
        have hc1 : ContDiff ℝ (1 : ℕ) (fun w : EuclideanSpace ℝ (Fin 2) => Φ₀ (cf, xf, w)) :=
          (hΦ₀_smooth 1).comp (contDiff_const.prodMk (contDiff_const.prodMk contDiff_id))
        have hdiff : DifferentiableAt ℝ (fun w : EuclideanSpace ℝ (Fin 2) => Φ₀ (cf, xf, w))
            (α v') :=
          (hc1.differentiable (by norm_num)).differentiableAt
        exact hdiff.hasFDerivAt.comp v' hα_deriv
      have h_fn : (fun w' : EuclideanSpace ℝ (Fin 2) => Φ'₀ (c', x', w')) =
          fun w' => (s_c * s_v ^ 2)⁻¹ *
            (((Φ₀ (c, x, V_J + s_v • w') - Φ₀ (c₀, x₀, V_J + s_v • w')) +
              (Φ₀ (c₀, x₀, V_J) - Φ₀ (c, x, V_J)))) := by
        ext w'
        dsimp [Φ'₀, localGaugePhase, s_c, C_r, s_x, c, x, c₀, x₀]
        ring
      have h_deriv_Φ' : HasFDerivAt (fun w' => Φ'₀ (c', x', w'))
          ((s_c * s_v ^ 2)⁻¹ •
            (((fderiv ℝ (fun w => Φ₀ (c, x, w)) v).comp
                (s_v • ContinuousLinearMap.id ℝ (EuclideanSpace ℝ (Fin 2)))) -
             ((fderiv ℝ (fun w => Φ₀ (c₀, x₀, w)) v).comp
                (s_v • ContinuousLinearMap.id ℝ (EuclideanSpace ℝ (Fin 2)))))) v' := by
        rw [h_fn]
        exact (((h_slice_comp c x).sub (h_slice_comp c₀ x₀)).add_const _).const_mul
          (s_c * s_v ^ 2)⁻¹
      rw [h_deriv_Φ'.fderiv]
      change (s_c * s_v ^ 2)⁻¹ *
          (fderiv ℝ (fun w => Φ₀ (c, x, w)) v (s_v • u) -
           fderiv ℝ (fun w => Φ₀ (c₀, x₀, w)) v (s_v • u)) =
        inner ℝ (ζ'₀ (v', x' - c' • v')) u
      rw [hΦ₀_grad c hc_mem x v (s_v • u), hΦ₀_grad c₀ hc₀_mem x₀ v (s_v • u),
        real_inner_smul_right, real_inner_smul_right]
      have hx_cv : x - c • v = X_J - C_r • v + s_x • ((x' - c' • v') + (1 / 2 : ℝ) • v') := by
        ext i
        simp [x, c, v, s_x]
        ring
      have hx₀_c₀v : x₀ - c₀ • v = X_J - C_r • v + ((1 / 2 : ℝ) * s_x) • v' := by
        ext i
        simp [x₀, c₀, v, s_x]
        ring
      rw [hx_cv, hx₀_c₀v]
      change (s_c * s_v ^ 2)⁻¹ *
          (s_v * inner ℝ (ζ₀ (v, X_J - C_r • v + s_x • ((x' - c' • v') + (1 / 2 : ℝ) • v'))) u -
           s_v * inner ℝ (ζ₀ (v, X_J - C_r • v + ((1 / 2 : ℝ) * s_x) • v')) u) =
        inner ℝ (s_x⁻¹ •
          (ζ₀ (v, X_J - C_r • v + s_x • ((x' - c' • v') + (1 / 2 : ℝ) • v')) -
           ζ₀ (v, X_J - C_r • v + ((1 / 2 : ℝ) * s_x) • v'))) u
      rw [real_inner_smul_left, inner_sub_left]
      have h_scale : (s_c * s_v ^ 2)⁻¹ * s_v = s_x⁻¹ := by
        dsimp [s_x]
        have hsc_ne : s_c ≠ 0 := ne_of_gt hs_c_pos
        have hsv_ne : s_v ≠ 0 := ne_of_gt hs_v_pos
        field_simp [hsc_ne, hsv_ne]
      linear_combination
        (inner ℝ (ζ₀ (v, X_J - C_r • v + s_x • ((x' - c' • v') + (1 / 2 : ℝ) • v'))) u -
         inner ℝ (ζ₀ (v, X_J - C_r • v + ((1 / 2 : ℝ) * s_x) • v')) u) * h_scale

    have hζ'₀_fderiv : ∀ (v' p' : EuclideanSpace ℝ (Fin 2)),
        fderiv ℝ (fun q' => ζ'₀ (v', q')) p' =
          fderiv ℝ (fun q => ζ₀ (V_J + s_v • v', q))
            (X_J - C_r • (V_J + s_v • v') + s_x • (p' + (1 / 2 : ℝ) • v')) := by
      intro v' p'
      let v : EuclideanSpace ℝ (Fin 2) := V_J + s_v • v'
      let c_shift : EuclideanSpace ℝ (Fin 2) := X_J - C_r • v + s_x • ((1 / 2 : ℝ) • v')
      let β : EuclideanSpace ℝ (Fin 2) → EuclideanSpace ℝ (Fin 2) :=
        fun q' => X_J - C_r • v + s_x • (q' + (1 / 2 : ℝ) • v')
      have hβ_eq : β = fun q' => c_shift + s_x • q' := by
        ext q' i
        simp [β, c_shift]
        ring
      have hβ_deriv : HasFDerivAt β
          (s_x • ContinuousLinearMap.id ℝ (EuclideanSpace ℝ (Fin 2))) p' := by
        rw [hβ_eq]
        exact ((hasFDerivAt_id p').const_smul s_x).const_add c_shift
      have hc1 : ContDiff ℝ (1 : ℕ) (fun q : EuclideanSpace ℝ (Fin 2) => ζ₀ (v, q)) :=
        (hζ₀_smooth 1).comp (contDiff_const.prodMk contDiff_id)
      have hdiff : DifferentiableAt ℝ (fun q : EuclideanSpace ℝ (Fin 2) => ζ₀ (v, q)) (β p') :=
        (hc1.differentiable (by norm_num)).differentiableAt
      have h_comp := hdiff.hasFDerivAt.comp p' hβ_deriv
      have h_deriv : HasFDerivAt (fun q' => ζ'₀ (v', q'))
          (s_x⁻¹ • ((fderiv ℝ (fun q => ζ₀ (v, q)) (β p')).comp
            (s_x • ContinuousLinearMap.id ℝ (EuclideanSpace ℝ (Fin 2))))) p' := by
        change HasFDerivAt
          (fun q' => s_x⁻¹ • (ζ₀ (v, β q') - ζ₀ (v, X_J - C_r • v + ((1 / 2 : ℝ) * s_x) • v'))) _ p'
        exact (h_comp.sub_const _).const_smul s_x⁻¹
      rw [h_deriv.fderiv]
      ext u
      simp only [smul_apply, ContinuousLinearMap.comp_apply,
        ContinuousLinearMap.id_apply, map_smul, smul_smul, inv_mul_cancel₀ hs_x_ne, one_smul]
      rfl

    have h_norm_phase : IsNormalizedPosDefPhase a₀ a₁ (3 * A) Φ'₀ ζ'₀ := by
      refine ⟨hΦ'₀_smooth, hζ'₀_smooth, hΦ'₀_v0, hΦ'₀_cx0, hζ'₀_p0, hΦ'₀_grad, ?_, ?_, ?_⟩
      · intro v' p' u w
        rw [hζ'₀_fderiv v' p']
        exact hζ₀_symm _ _ u w
      · intro v' p' u
        rw [hζ'₀_fderiv v' p']
        exact hζ₀_ell _ _ u
      · intro j vp
        let G : (EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2)) →
            (EuclideanSpace ℝ (Fin 2) →L[ℝ] EuclideanSpace ℝ (Fin 2)) :=
          fun q => fderiv ℝ (fun p => ζ₀ (q.1, p)) q.2
        have hG_smooth : ContDiff ℝ j G := by
          let inrE : EuclideanSpace ℝ (Fin 2) →L[ℝ]
              EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) :=
            ContinuousLinearMap.inr ℝ (EuclideanSpace ℝ (Fin 2)) (EuclideanSpace ℝ (Fin 2))
          let Λ : ((EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2)) →L[ℝ]
              EuclideanSpace ℝ (Fin 2)) →L[ℝ]
              (EuclideanSpace ℝ (Fin 2) →L[ℝ] EuclideanSpace ℝ (Fin 2)) :=
            (ContinuousLinearMap.compL ℝ (EuclideanSpace ℝ (Fin 2))
              (EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2))
              (EuclideanSpace ℝ (Fin 2))).flip inrE
          have hG_eq : G = fun q => Λ (fderiv ℝ ζ₀ q) := by
            funext q
            apply ContinuousLinearMap.ext
            intro u
            have h_slice : HasFDerivAt (fun p : EuclideanSpace ℝ (Fin 2) => (q.1, p)) inrE q.2 := by
              have h1 : (fun p : EuclideanSpace ℝ (Fin 2) => (q.1, p)) =
                  fun p => (q.1, (0 : EuclideanSpace ℝ (Fin 2))) + inrE p := by
                ext p <;> simp [inrE]
              rw [h1]
              exact inrE.hasFDerivAt.const_add (q.1, (0 : EuclideanSpace ℝ (Fin 2)))
            have h_diff : DifferentiableAt ℝ ζ₀ q :=
              ((hζ₀_smooth 1).differentiable (by norm_num)).differentiableAt
            have h_comp : HasFDerivAt (fun p : EuclideanSpace ℝ (Fin 2) => ζ₀ (q.1, p))
                ((fderiv ℝ ζ₀ q).comp inrE) q.2 := by
              have hq : (q.1, q.2) = q := Prod.mk.eta
              have h_diff' : HasFDerivAt ζ₀ (fderiv ℝ ζ₀ q) (q.1, q.2) := by
                rw [hq]
                exact h_diff.hasFDerivAt
              exact h_diff'.comp q.2 h_slice
            change fderiv ℝ (fun p => ζ₀ (q.1, p)) q.2 u = ((fderiv ℝ ζ₀ q).comp inrE) u
            rw [h_comp.fderiv]
          rw [hG_eq]
          have hfderiv : ContDiff ℝ j (fderiv ℝ ζ₀) :=
            (hζ₀_smooth (j + 1)).fderiv_right (m := (j : WithTop ℕ∞)) (by norm_cast)
          exact Λ.contDiff.comp hfderiv
        let c_const : EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) :=
          (V_J, X_J - C_r • V_J)
        let π₁ : (EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2)) →L[ℝ]
            EuclideanSpace ℝ (Fin 2) :=
          ContinuousLinearMap.fst ℝ (EuclideanSpace ℝ (Fin 2)) (EuclideanSpace ℝ (Fin 2))
        let π₂ : (EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2)) →L[ℝ]
            EuclideanSpace ℝ (Fin 2) :=
          ContinuousLinearMap.snd ℝ (EuclideanSpace ℝ (Fin 2)) (EuclideanSpace ℝ (Fin 2))
        let L_lin : (EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2)) →L[ℝ]
            (EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2)) :=
          (s_v • π₁).prod ((-((q_r : ℝ) * s_x)) • π₁ + s_x • π₂)
        have hL_norm : ‖L_lin‖ ≤ 3 := by
          refine L_lin.opNorm_le_bound (by norm_num) (fun q => ?_)
          rw [Prod.norm_def]
          have hq1 : ‖q.1‖ ≤ ‖q‖ := by rw [Prod.norm_def]; exact le_max_left _ _
          have hq2 : ‖q.2‖ ≤ ‖q‖ := by rw [Prod.norm_def]; exact le_max_right _ _
          have hq_nn : 0 ≤ ‖q‖ := norm_nonneg q
          refine max_le ?_ ?_
          · change ‖s_v • q.1‖ ≤ 3 * ‖q‖
            rw [norm_smul, Real.norm_of_nonneg hs_v_pos.le]
            nlinarith [hs_v_le, hq1, hq_nn]
          · change ‖(-((q_r : ℝ) * s_x)) • q.1 + s_x • q.2‖ ≤ 3 * ‖q‖
            have h_qr_sx_nn : 0 ≤ (q_r : ℝ) * s_x :=
              mul_nonneg (Nat.cast_nonneg q_r) hs_x_pos.le
            have h_tri : ‖(-((q_r : ℝ) * s_x)) • q.1 + s_x • q.2‖ ≤
                ((q_r : ℝ) * s_x) * ‖q.1‖ + s_x * ‖q.2‖ := by
              calc ‖(-((q_r : ℝ) * s_x)) • q.1 + s_x • q.2‖
                  ≤ ‖(-((q_r : ℝ) * s_x)) • q.1‖ + ‖s_x • q.2‖ := norm_add_le _ _
                _ = ((q_r : ℝ) * s_x) * ‖q.1‖ + s_x * ‖q.2‖ := by
                    rw [norm_smul, norm_smul, norm_neg, Real.norm_of_nonneg h_qr_sx_nn,
                      Real.norm_of_nonneg hs_x_pos.le]
            have h_sum_coeff : (q_r : ℝ) * s_x + s_x ≤ 1 := by
              calc (q_r : ℝ) * s_x + s_x = (((q_r : ℝ) + 1) * s_c) * s_v := by dsimp [s_x]; ring
                _ ≤ 1 * 1 := mul_le_mul hq_r_sc_le1 hs_v_le hs_v_pos.le zero_le_one
                _ = 1 := one_mul 1
            nlinarith [h_tri, h_sum_coeff, hq1, hq2, hq_nn, h_qr_sx_nn, hs_x_pos]
        have h_map_eq :
            (fun q : EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) =>
              fderiv ℝ (fun p' => ζ'₀ (q.1, p')) q.2) =
            (fun z : EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) =>
              G (c_const + z)) ∘ L_lin := by
          funext q
          rw [hζ'₀_fderiv q.1 q.2]
          have h_aff : (V_J + s_v • q.1,
              X_J - C_r • (V_J + s_v • q.1) + s_x • (q.2 + (1 / 2 : ℝ) • q.1)) =
              c_const + L_lin q := by
            refine Prod.ext ?_ ?_
            · rfl
            · ext i
              simp [c_const, L_lin, π₁, π₂, C_r, s_x]
              ring
          change G (V_J + s_v • q.1,
              X_J - C_r • (V_J + s_v • q.1) + s_x • (q.2 + (1 / 2 : ℝ) • q.1)) =
            G (c_const + L_lin q)
          rw [h_aff]
        let G_shift : (EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2)) →
            (EuclideanSpace ℝ (Fin 2) →L[ℝ] EuclideanSpace ℝ (Fin 2)) :=
          fun z => G (c_const + z)
        have hG_shift_smooth : ContDiff ℝ j G_shift :=
          hG_smooth.comp (contDiff_const.add contDiff_id)
        rw [h_map_eq, L_lin.iteratedFDeriv_comp_right hG_shift_smooth vp le_rfl]
        have h_add : iteratedFDeriv ℝ j G_shift (L_lin vp) =
            iteratedFDeriv ℝ j G (c_const + L_lin vp) := by
          dsimp [G_shift]
          rw [iteratedFDeriv_comp_add_left]
        rw [h_add]
        have h_norm1 :=
          (iteratedFDeriv ℝ j G (c_const + L_lin vp)).norm_compContinuousLinearMap_le
            (fun _ => L_lin)
        have h_prod : (∏ _ : Fin j, ‖L_lin‖) ≤ (3 : ℝ) ^ (j + 1) := by
          rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin]
          calc ‖L_lin‖ ^ j ≤ (3 : ℝ) ^ j := pow_le_pow_left₀ (norm_nonneg L_lin) hL_norm j
            _ ≤ (3 : ℝ) ^ (j + 1) := pow_le_pow_right₀ (by norm_num) (Nat.le_succ j)
        have h_base := hζ₀_gevrey j (c_const + L_lin vp)
        have h_fact_nn : (0 : ℝ) ≤ (j.factorial : ℝ) ^ 3 := by positivity
        have h_A_nn : (0 : ℝ) ≤ A ^ (j + 1) := pow_nonneg (by linarith) (j + 1)
        calc ‖(iteratedFDeriv ℝ j G (c_const + L_lin vp)).compContinuousLinearMap (fun _ => L_lin)‖
            ≤ ‖iteratedFDeriv ℝ j G (c_const + L_lin vp)‖ * ∏ _ : Fin j, ‖L_lin‖ := h_norm1
          _ ≤ (A ^ (j + 1) * ((j.factorial : ℝ) ^ 3)) * (3 : ℝ) ^ (j + 1) := by
              refine mul_le_mul h_base h_prod ?_ (mul_nonneg h_A_nn h_fact_nn)
              exact Finset.prod_nonneg (fun _ _ => norm_nonneg L_lin)
          _ = (3 * A) ^ (j + 1) * ((j.factorial : ℝ) ^ 3) := by
              rw [mul_pow]
              ring

    
    have h_haar : ∀ {F : Type} [NormedAddCommGroup F] [NormedSpace ℝ F]
        (H : EuclideanSpace ℝ (Fin 2) → F),
        ∫ v' : EuclideanSpace ℝ (Fin 2), H (V_J + s_v • v') =
          (s_v ^ 2)⁻¹ • ∫ v : EuclideanSpace ℝ (Fin 2), H v := by
      intro F _ _ H
      have h_smul := MeasureTheory.Measure.integral_comp_smul (μ := MeasureTheory.volume)
        (fun w : EuclideanSpace ℝ (Fin 2) => H (V_J + w)) s_v
      rw [h_smul, MeasureTheory.integral_add_left_eq_self (fun v => H v) V_J,
        finrank_euclideanSpace_fin,
        abs_of_pos (inv_pos.mpr (pow_pos hs_v_pos 2))]

    have hf'₀_meas : MeasureTheory.AEStronglyMeasurable f'₀ MeasureTheory.volume := by
      have h_qmp :=
        ((MeasureTheory.measurePreserving_add_left MeasureTheory.volume V_J).quasiMeasurePreserving).comp
          (MeasureTheory.Measure.quasiMeasurePreserving_smul MeasureTheory.volume
            (ne_of_gt hs_v_pos))
      have hf_comp_meas : MeasureTheory.AEStronglyMeasurable
          (fun v' : EuclideanSpace ℝ (Fin 2) => f (V_J + s_v • v')) MeasureTheory.volume :=
        hf_meas.comp_quasiMeasurePreserving h_qmp
      have h_tup_cont : Continuous
          (fun v' : EuclideanSpace ℝ (Fin 2) => (c₀, (x₀, V_J + s_v • v'))) :=
        continuous_const.prodMk
          (continuous_const.prodMk
            (continuous_const.add ((continuous_const (y := s_v)).smul continuous_id)))
      have h_exp_cont : Continuous (fun v' : EuclideanSpace ℝ (Fin 2) =>
          Complex.exp (Complex.I *
            ((lam_sys * (Φ₀ (c₀, x₀, V_J + s_v • v') - Φ₀ (c₀, x₀, V_J)) : ℝ) : ℂ))) :=
        Complex.continuous_exp.comp
          (continuous_const.mul
            (Complex.continuous_ofReal.comp
              (continuous_const.mul
                (((hΦ₀_smooth 0).continuous.comp h_tup_cont).sub continuous_const))))
      exact (continuous_const.aestronglyMeasurable.mul hf_comp_meas).mul
        h_exp_cont.aestronglyMeasurable

    have hf'₀_norm_sq : ∀ v' : EuclideanSpace ℝ (Fin 2),
        ‖f'₀ v'‖ ^ 2 = s_v ^ 2 * ‖f (V_J + s_v • v')‖ ^ 2 := by
      intro v'
      dsimp [f'₀, localGaugeInput]
      rw [norm_mul, norm_mul, Complex.norm_real, Real.norm_of_nonneg hs_v_pos.le,
        Complex.norm_exp_I_mul_ofReal, mul_one, mul_pow]

    have hf'₀_l2 : MeasureTheory.MemLp f'₀ 2 MeasureTheory.volume := by
      have hf_sq_int : MeasureTheory.Integrable
          (fun v : EuclideanSpace ℝ (Fin 2) => ‖f v‖ ^ 2) MeasureTheory.volume :=
        (MeasureTheory.memLp_two_iff_integrable_sq_norm hf_meas).mp hf_l2
      have hf_shift_int : MeasureTheory.Integrable
          (fun w : EuclideanSpace ℝ (Fin 2) => ‖f (V_J + w)‖ ^ 2) MeasureTheory.volume :=
        hf_sq_int.comp_add_left V_J
      have hf_aff_int : MeasureTheory.Integrable
          (fun v' : EuclideanSpace ℝ (Fin 2) => ‖f (V_J + s_v • v')‖ ^ 2) MeasureTheory.volume :=
        hf_shift_int.comp_smul (ne_of_gt hs_v_pos)
      exact (MeasureTheory.memLp_two_iff_integrable_sq_norm hf'₀_meas).mpr
        ((hf_aff_int.const_mul (s_v ^ 2)).congr
          (Filter.Eventually.of_forall (fun v' => (hf'₀_norm_sq v').symm)))

    have hf'₀_int_eq : ∫ v', ‖f'₀ v'‖ ^ 2 = ∫ v, ‖f v‖ ^ 2 := by
      simp_rw [hf'₀_norm_sq]
      rw [MeasureTheory.integral_const_mul, h_haar (fun v => ‖f v‖ ^ 2), smul_eq_mul,
        ← mul_assoc, mul_inv_cancel₀ (pow_ne_zero 2 (ne_of_gt hs_v_pos)), one_mul]

    have hf'₀_supp : ∀ R_supp : ℝ, (∀ v, R_supp ≤ ‖v - V_J‖ → f v = 0) →
        ∀ v', s_v⁻¹ * R_supp ≤ ‖v'‖ → f'₀ v' = 0 := by
      intro R_supp hf_supp v' hv'
      have h_dist : R_supp ≤ ‖(V_J + s_v • v') - V_J‖ := by
        rw [add_sub_cancel_left, norm_smul, Real.norm_of_nonneg hs_v_pos.le]
        calc R_supp = s_v * (s_v⁻¹ * R_supp) := by
              rw [← mul_assoc, mul_inv_cancel₀ (ne_of_gt hs_v_pos), one_mul]
          _ ≤ s_v * ‖v'‖ := mul_le_mul_of_nonneg_left hv' hs_v_pos.le
      dsimp [f'₀, localGaugeInput]
      rw [hf_supp (V_J + s_v • v') h_dist]
      simp

    refine ⟨h_norm_phase, hf'₀_meas, hf'₀_l2, hf'₀_int_eq, hf'₀_supp, ?_⟩
    intro r_loc _ V'_o X'_o ψ_o
    let r_full : ℕ := q_r * 2 ^ (m_t - m_r) + r_loc
    let C_t : ℝ := ((r_full : ℝ) + 1 / 2) * ((2 : ℝ) ^ m_t)⁻¹
    let C'_box : ℝ := ((r_loc : ℝ) + 1 / 2) * ((2 : ℝ) ^ (m_t - m_r))⁻¹
    let V_o : EuclideanSpace ℝ (Fin 2) := V_J + s_v • V'_o
    let X_o : EuclideanSpace ℝ (Fin 2) := X_J + (C_t - C_r) • V_J + s_x • X'_o
    let ρ_obs : ℝ := ε ^ ((H_P - t) / 2)
    let ρ'_obs : ℝ := ε ^ ((H_P - r - 2 * b_star - (t - r)) / 2)
    have hρ'_inv : ρ'_obs⁻¹ = s_v * ρ_obs⁻¹ := by
      have hexp : (H_P - r - 2 * b_star - (t - r)) / 2 = (H_P - t) / 2 - b_star := by ring
      dsimp [ρ'_obs, ρ_obs]
      rw [hexp, Real.rpow_sub hε, ← hs_v_eq, inv_div, div_eq_mul_inv]
    have hm_add : m_r + (m_t - m_r) = m_t := Nat.add_sub_of_le hm_le
    have h2mt : (2 : ℝ) ^ m_t = (2 : ℝ) ^ m_r * (2 : ℝ) ^ (m_t - m_r) := by
      rw [← pow_add, hm_add]
    have hC_mid : C_r + s_c * (C'_box - 1 / 2) = C_t := by
      dsimp [C_r, s_c, C'_box, C_t, r_full]
      rw [h2mt]
      push_cast
      have h1 : (2 : ℝ) ^ m_r ≠ 0 := pow_ne_zero _ (by norm_num)
      have h2 : (2 : ℝ) ^ (m_t - m_r) ≠ 0 := pow_ne_zero _ (by norm_num)
      field_simp [h1, h2]
      ring
    have hX_mid : X_J + (s_c * (C'_box - 1 / 2)) • V_J + s_x • X'_o = X_o := by
      have hsc_sub : s_c * (C'_box - 1 / 2) = C_t - C_r := by linarith [hC_mid]
      rw [hsc_sub]
    let ω₀ : ℂ := Complex.exp (Complex.I * ((-lam_sys * Φ₀ (C_t, X_o, V_J) : ℝ) : ℂ))
    let H_int : EuclideanSpace ℝ (Fin 2) → ℂ := fun w =>
      f w * ψ_o (ρ_obs⁻¹ • (w - V_o)) *
        Complex.exp (Complex.I * ((lam_sys * Φ₀ (C_t, X_o, w) : ℝ) : ℂ))
    unfold generalPacketObsMass
    have h_integrand : (fun v' : EuclideanSpace ℝ (Fin 2) =>
        f'₀ v' * ψ_o (ρ'_obs⁻¹ • (v' - V'_o)) *
          Complex.exp (Complex.I *
            (((s_c * s_v ^ 2 * lam_sys) * Φ'₀ (C'_box, X'_o, v') : ℝ) : ℂ))) =
        fun v' => ((s_v : ℂ) * ω₀) * H_int (V_J + s_v • v') := by
      ext v'
      have h_win : ρ'_obs⁻¹ • (v' - V'_o) = ρ_obs⁻¹ • ((V_J + s_v • v') - V_o) := by
        rw [hρ'_inv]
        ext i
        simp [V_o]
        ring
      have h_phase_val :
          (s_c * s_v ^ 2 * lam_sys) * Φ'₀ (C'_box, X'_o, v') =
            lam_sys * (Φ₀ (C_t, X_o, V_J + s_v • v') - Φ₀ (C_t, X_o, V_J) -
              Φ₀ (c₀, x₀, V_J + s_v • v') + Φ₀ (c₀, x₀, V_J)) := by
        change (s_c * s_v ^ 2 * lam_sys) *
          ((s_c * s_v ^ 2)⁻¹ *
            (Φ₀ (C_r + s_c * (C'_box - 1 / 2),
                X_J + (s_c * (C'_box - 1 / 2)) • V_J + s_x • X'_o, V_J + s_v • v') -
             Φ₀ (C_r + s_c * (C'_box - 1 / 2),
                X_J + (s_c * (C'_box - 1 / 2)) • V_J + s_x • X'_o, V_J) -
             Φ₀ (c₀, x₀, V_J + s_v • v') + Φ₀ (c₀, x₀, V_J))) = _
        rw [hC_mid, hX_mid]
        have hne : s_c * s_v ^ 2 ≠ 0 := ne_of_gt (by positivity)
        field_simp [hne]
      have h_exp_split :
          Complex.I * ((lam_sys * (Φ₀ (c₀, x₀, V_J + s_v • v') - Φ₀ (c₀, x₀, V_J)) : ℝ) : ℂ) +
            Complex.I * (((s_c * s_v ^ 2 * lam_sys) * Φ'₀ (C'_box, X'_o, v') : ℝ) : ℂ) =
          Complex.I * ((-lam_sys * Φ₀ (C_t, X_o, V_J) : ℝ) : ℂ) +
            Complex.I * ((lam_sys * Φ₀ (C_t, X_o, V_J + s_v • v') : ℝ) : ℂ) := by
        rw [h_phase_val]
        push_cast
        ring
      dsimp [f'₀, localGaugeInput, ω₀, H_int, s_c, C_r, c₀, x₀]
      rw [h_win]
      calc (s_v : ℂ) * f (V_J + s_v • v') *
            Complex.exp (Complex.I *
              ((lam_sys * (Φ₀ (c₀, x₀, V_J + s_v • v') - Φ₀ (c₀, x₀, V_J)) : ℝ) : ℂ)) *
            ψ_o (ρ_obs⁻¹ • (V_J + s_v • v' - V_o)) *
            Complex.exp (Complex.I *
              (((s_c * s_v ^ 2 * lam_sys) * Φ'₀ (C'_box, X'_o, v') : ℝ) : ℂ))
          = (s_v : ℂ) * f (V_J + s_v • v') * ψ_o (ρ_obs⁻¹ • (V_J + s_v • v' - V_o)) *
              (Complex.exp (Complex.I *
                ((lam_sys * (Φ₀ (c₀, x₀, V_J + s_v • v') - Φ₀ (c₀, x₀, V_J)) : ℝ) : ℂ)) *
               Complex.exp (Complex.I *
                (((s_c * s_v ^ 2 * lam_sys) * Φ'₀ (C'_box, X'_o, v') : ℝ) : ℂ))) := by ring
        _ = (s_v : ℂ) * f (V_J + s_v • v') * ψ_o (ρ_obs⁻¹ • (V_J + s_v • v' - V_o)) *
              (ω₀ * Complex.exp (Complex.I *
                ((lam_sys * Φ₀ (C_t, X_o, V_J + s_v • v') : ℝ) : ℂ))) := by
              rw [← Complex.exp_add, h_exp_split, Complex.exp_add]
        _ = ((s_v : ℂ) * ω₀) * H_int (V_J + s_v • v') := by
              dsimp [H_int]
              ring
    change ‖(ρ'_obs⁻¹ : ℂ) * ∫ v', f'₀ v' * ψ_o (ρ'_obs⁻¹ • (v' - V'_o)) *
        Complex.exp (Complex.I *
          (((s_c * s_v ^ 2 * lam_sys) * Φ'₀ (C'_box, X'_o, v') : ℝ) : ℂ))‖ ^ 2 =
      ‖(ρ_obs⁻¹ : ℂ) * ∫ v, H_int v‖ ^ 2
    rw [h_integrand, MeasureTheory.integral_const_mul, h_haar H_int, Complex.real_smul]
    have h_cancel : ((ρ'_obs : ℂ))⁻¹ *
        (((s_v : ℂ) * ω₀) * ((((s_v ^ 2)⁻¹ : ℝ) : ℂ) * ∫ v, H_int v)) =
        ω₀ * (((ρ_obs : ℂ))⁻¹ * ∫ v, H_int v) := by
      have hρ'_c : ((ρ'_obs : ℂ))⁻¹ = ((s_v * ρ_obs⁻¹ : ℝ) : ℂ) := by
        rw [← Complex.ofReal_inv, hρ'_inv]
      rw [hρ'_c, ← Complex.ofReal_inv]
      have hsv_ne : (s_v : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr (ne_of_gt hs_v_pos)
      push_cast
      field_simp [hsv_ne]
    rw [h_cancel, norm_mul]
    have hω_norm : ‖ω₀‖ = 1 := Complex.norm_exp_I_mul_ofReal _
    rw [hω_norm, one_mul]

  
  have h_dur : DurationScalingValid γ := by
    intro ε H_P L d R_dom B_sys R_win N_mult M_win lam_sys m_time Φ₀ f
      N_O N_D r_O V_O X_O ψ_O b_D a_D r_D e_D V_D X_D p
      hε hε_lt hd _
    have hd_ne : d ≠ 0 := ne_of_gt hd
    have h_rpow_div : ∀ x : ℝ, (ε ^ d) ^ (x / d) = ε ^ x := by
      intro x
      rw [← Real.rpow_mul hε.le, mul_div_cancel₀ x hd_ne]
    have h_ell_d : Real.log ((ε ^ d)⁻¹) = d * Real.log (ε⁻¹) := by
      rw [← Real.inv_rpow hε.le, Real.log_rpow (inv_pos.mpr hε)]
    have h_ell_pos : 0 < Real.log (ε⁻¹) := by
      refine Real.log_pos ?_
      rw [one_lt_inv₀ hε]
      linarith
    have h_ell_ne : Real.log (ε⁻¹) ≠ 0 := ne_of_gt h_ell_pos
    have h_rho_eq : (ε ^ d) ^ ((H_P / d - 1) / 2) = ε ^ ((H_P - d) / 2) := by
      have hexp : (H_P / d - 1) / 2 = ((H_P - d) / 2) / d := by
        field_simp [hd_ne]
      rw [hexp, h_rpow_div]
    have h_obs_eq : ∀ (r_idx : ℕ) (V_o X_o : EuclideanSpace ℝ (Fin 2))
        (ψ_o : EuclideanSpace ℝ (Fin 2) → ℂ),
        generalPacketObsMass (ε ^ d) (H_P / d) 1 lam_sys m_time Φ₀ f r_idx V_o X_o ψ_o =
          generalPacketObsMass ε H_P d lam_sys m_time Φ₀ f r_idx V_o X_o ψ_o := by
      intro r_idx V_o X_o ψ_o
      unfold generalPacketObsMass
      simp only [h_rho_eq]

    have h_root_eq :
        generalPacketRootScore (ε ^ d) (H_P / d) (L / d) R_dom γ lam_sys Φ₀ f =
          d⁻¹ * generalPacketRootScore ε H_P L R_dom γ lam_sys Φ₀ f := by
      unfold generalPacketRootScore
      let O₀ := rootSiteFinset lam_sys R_dom
      let ρ₀ := (Real.sqrt lam_sys)⁻¹
      let ell := Real.log (ε⁻¹)
      let S_orig : Set ℝ :=
        { (3 / 2 : ℝ) * (Real.log (∫ v : EuclideanSpace ℝ (Fin 2), ‖f v‖ ^ 2) / ell) } ∪
        { s : ℝ | ∃ (N_D' : ℕ) (b a : Fin N_D' → ℝ)
            (e_dir V_c X_c : Fin N_D' → EuclideanSpace ℝ (Fin 2))
            (p' : ((ℤ × ℤ) × (ℤ × ℤ)) → Fin N_D' → ℝ),
            (∀ j : Fin N_D', 0 ≤ b j ∧ b j ≤ a j ∧ a j ≤ min L (H_P / 2) ∧ ‖e_dir j‖ = 1) ∧
            (∀ o j, 0 ≤ p' o j) ∧
            (∀ o j, o ∉ O₀ → p' o j = 0) ∧
            (∑ o ∈ O₀, ∑ j : Fin N_D', p' o j = 1) ∧
            (∀ o ∈ O₀, ∀ j : Fin N_D', 0 < p' o j →
              0 < canonicalRootMass lam_sys Φ₀ f o ∧
              |inner ℝ (gridPt2D ρ₀ o.1 - V_c j) (e_dir j)| ≤ 10 * ε ^ (b j) ∧
              |inner ℝ (gridPt2D ρ₀ o.1 - V_c j) (perp2D (e_dir j))| ≤ 10 * ε ^ (a j) ∧
              |inner ℝ (gridPt2D ρ₀ o.2 - X_c j) (e_dir j)| ≤ 10 * ε ^ (b j) ∧
              |inner ℝ (gridPt2D ρ₀ o.2 - X_c j) (perp2D (e_dir j))| ≤ 10 * ε ^ (a j)) ∧
            (let p_O := fun o => ∑ j : Fin N_D', p' o j
             let p_D := fun j => ∑ o ∈ O₀, p' o j
             let H_O := (∑ o ∈ O₀, -(p_O o * Real.log (p_O o))) / ell
             let H_O_D := (∑ o ∈ O₀, ∑ j : Fin N_D',
               -(p' o j * Real.log (p' o j / p_D j))) / ell
             let E_mass := (∑ o ∈ O₀,
               p_O o * Real.log (canonicalRootMass lam_sys Φ₀ f o)) / ell
             let E_w := ∑ j : Fin N_D',
               p_D j * ((1 + γ) * b j + (1 - γ) * a j)
             s = H_O + (1 / 2 : ℝ) * H_O_D + (3 / 2 : ℝ) * E_mass + (1 / 2 : ℝ) * E_w) }
      let S_scaled : Set ℝ :=
        { (3 / 2 : ℝ) * (Real.log (∫ v : EuclideanSpace ℝ (Fin 2), ‖f v‖ ^ 2) /
            Real.log ((ε ^ d)⁻¹)) } ∪
        { s : ℝ | ∃ (N_D' : ℕ) (b' a' : Fin N_D' → ℝ)
            (e_dir V_c X_c : Fin N_D' → EuclideanSpace ℝ (Fin 2))
            (p' : ((ℤ × ℤ) × (ℤ × ℤ)) → Fin N_D' → ℝ),
            (∀ j : Fin N_D', 0 ≤ b' j ∧ b' j ≤ a' j ∧
              a' j ≤ min (L / d) ((H_P / d) / 2) ∧ ‖e_dir j‖ = 1) ∧
            (∀ o j, 0 ≤ p' o j) ∧
            (∀ o j, o ∉ O₀ → p' o j = 0) ∧
            (∑ o ∈ O₀, ∑ j : Fin N_D', p' o j = 1) ∧
            (∀ o ∈ O₀, ∀ j : Fin N_D', 0 < p' o j →
              0 < canonicalRootMass lam_sys Φ₀ f o ∧
              |inner ℝ (gridPt2D ρ₀ o.1 - V_c j) (e_dir j)| ≤ 10 * (ε ^ d) ^ (b' j) ∧
              |inner ℝ (gridPt2D ρ₀ o.1 - V_c j) (perp2D (e_dir j))| ≤ 10 * (ε ^ d) ^ (a' j) ∧
              |inner ℝ (gridPt2D ρ₀ o.2 - X_c j) (e_dir j)| ≤ 10 * (ε ^ d) ^ (b' j) ∧
              |inner ℝ (gridPt2D ρ₀ o.2 - X_c j) (perp2D (e_dir j))| ≤ 10 * (ε ^ d) ^ (a' j)) ∧
            (let p_O := fun o => ∑ j : Fin N_D', p' o j
             let p_D := fun j => ∑ o ∈ O₀, p' o j
             let H_O := (∑ o ∈ O₀, -(p_O o * Real.log (p_O o))) / Real.log ((ε ^ d)⁻¹)
             let H_O_D := (∑ o ∈ O₀, ∑ j : Fin N_D',
               -(p' o j * Real.log (p' o j / p_D j))) / Real.log ((ε ^ d)⁻¹)
             let E_mass := (∑ o ∈ O₀,
               p_O o * Real.log (canonicalRootMass lam_sys Φ₀ f o)) / Real.log ((ε ^ d)⁻¹)
             let E_w := ∑ j : Fin N_D',
               p_D j * ((1 + γ) * b' j + (1 - γ) * a' j)
             s = H_O + (1 / 2 : ℝ) * H_O_D + (3 / 2 : ℝ) * E_mass + (1 / 2 : ℝ) * E_w) }
      change sSup S_scaled = d⁻¹ * sSup S_orig
      have h_set_eq : S_scaled = (fun y => d⁻¹ * y) '' S_orig := by
        ext x
        constructor
        · rintro (hx_base | ⟨N_D', b', a', e_dir, V_c, X_c, p', h_ap, hp_nn, hp_out,
            hp_sum, h_cap, hx_eq⟩)
          · rw [Set.mem_singleton_iff] at hx_base
            refine ⟨(3 / 2 : ℝ) * (Real.log (∫ v, ‖f v‖ ^ 2) / ell), Or.inl rfl, ?_⟩
            rw [hx_base, h_ell_d]
            dsimp [ell]
            field_simp [hd_ne, h_ell_ne]
          · refine ⟨d * x, Or.inr ⟨N_D', fun j => d * b' j, fun j => d * a' j,
              e_dir, V_c, X_c, p', ?_, hp_nn, hp_out, hp_sum, ?_, ?_⟩, ?_⟩
            · intro j
              obtain ⟨hb0, hba, ha_min, he⟩ := h_ap j
              refine ⟨mul_nonneg hd.le hb0, mul_le_mul_of_nonneg_left hba hd.le,
                le_min ?_ ?_, he⟩
              · have h1 : a' j ≤ L / d := le_trans ha_min (min_le_left _ _)
                exact (le_div_iff₀' hd).mp h1
              · have h2 : a' j ≤ (H_P / d) / 2 := le_trans ha_min (min_le_right _ _)
                have h2' : a' j ≤ (H_P / 2) / d := by
                  calc a' j ≤ (H_P / d) / 2 := h2
                    _ = (H_P / 2) / d := by ring
                exact (le_div_iff₀' hd).mp h2'
            · intro o ho j hp_pos
              obtain ⟨hm, hc1, hc2, hc3, hc4⟩ := h_cap o ho j hp_pos
              rw [← Real.rpow_mul hε.le] at hc1 hc2 hc3 hc4
              exact ⟨hm, hc1, hc2, hc3, hc4⟩
            · rw [hx_eq, h_ell_d]
              dsimp [ell]
              have hEw : (∑ j : Fin N_D', (∑ o ∈ O₀, p' o j) *
                    ((1 + γ) * (d * b' j) + (1 - γ) * (d * a' j))) =
                  d * ∑ j : Fin N_D', (∑ o ∈ O₀, p' o j) *
                    ((1 + γ) * b' j + (1 - γ) * a' j) := by
                rw [Finset.mul_sum]
                refine Finset.sum_congr rfl (fun j _ => ?_)
                ring
              rw [hEw]
              field_simp [hd_ne, h_ell_ne]
            · exact inv_mul_cancel_left₀ hd_ne x
        · rintro ⟨y, hy_mem, rfl⟩
          rcases hy_mem with hy_base | ⟨N_D', b, a, e_dir, V_c, X_c, p', h_ap, hp_nn,
            hp_out, hp_sum, h_cap, hy_eq⟩
          · rw [Set.mem_singleton_iff] at hy_base
            left
            rw [Set.mem_singleton_iff, hy_base, h_ell_d]
