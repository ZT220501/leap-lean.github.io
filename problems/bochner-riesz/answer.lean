      let b₀ : Fin S_k := ⟨m_k, hm_lt⟩
      have hEb₀ : E_k b₀ o d := hm_eq
      calc p o d = if E_k b₀ o d then p o d else 0 := by simp [hEb₀]
        _ ≤ ∑ b : Fin S_k, if E_k b o d then p o d else 0 :=
          Finset.single_le_sum (f := fun b => if E_k b o d then p o d else 0)
            (fun b _ => by split_ifs <;> linarith only [hp_nn o d]) (Finset.mem_univ b₀)

  have h_d1_sum_le : ∀ {N_J : ℕ} {d₀ B_tot : ℝ} {π_J d₁ d₂ d₃ : Fin N_J → ℝ},
      0 ≤ d₀ → (∀ j, 0 ≤ π_J j) →
      (∀ j, 0 < π_J j → 0 ≤ d₁ j ∧ 0 ≤ d₂ j ∧ 0 ≤ d₃ j) →
      d₀ + (∑ j : Fin N_J, π_J j * (d₁ j + d₂ j + d₃ j)) ≤ B_tot →
