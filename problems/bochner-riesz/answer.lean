    let q_Q : ((ℤ × ℤ) × (ℤ × ℤ)) → ℝ := fun q => ∑ d : Fin N_D, q_law q d
    have hq_Q_nn : ∀ q, 0 ≤ q_Q q := fun q => Finset.sum_nonneg (fun d _ => hq_law_nn q d)
