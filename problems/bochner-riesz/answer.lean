              finProbAt π (fun ω' => (X ω', Z ω')) ω / p_Ec := by
            unfold finProbAt
            dsimp only [π_Ec, p_Ec, chartRowRestrictPi]
            rw [Finset.sum_div]
            refine Finset.sum_congr rfl (fun ω' _ => ?_)
            by_cases hω' : ω' ∈ E
            · have hω'c : ω' ∉ Eᶜ := by simp [hω']
              have hZ' : Z ω' = true := decide_eq_true hω'
              split_ifs with h1 h2 h3 <;> first | rfl | simp_all [Prod.ext_iff]
            · have hω'c : ω' ∈ Eᶜ := Finset.mem_compl.mpr hω'
              have hZ' : Z ω' = false := decide_eq_false hω'
              split_ifs with h1 h2 h3 <;> first | rfl | simp_all [Prod.ext_iff]
          have h_surp : condSurprise ε π_Ec X Y ω =
              condSurprise ε π (fun ω' => (X ω', Z ω')) Y ω := by
            unfold condSurprise
            rw [hp2_eq, hp1_eq, div_div_div_cancel_right₀ hp_Ec_pos.ne']
          rw [h_wE, zero_mul, mul_zero, zero_add, ← mul_assoc, h_wEc, h_surp]
      
      have h_ent_swap : ∀ {α β γ_t : Type} (X : Fin N_ω → α) (A : Fin N_ω → β)
          (B : Fin N_ω → γ_t),
          finCondEntropy ε π X (fun ω => (A ω, B ω)) =
            finCondEntropy ε π X (fun ω => (B ω, A ω)) := by
        intro α β γ_t X A B
        unfold finCondEntropy condSurprise
        refine Finset.sum_congr rfl (fun ω _ => ?_)
        have hp2 : finProbAt2 π X (fun ω' => (A ω', B ω')) ω =
            finProbAt2 π X (fun ω' => (B ω', A ω')) ω := by
          unfold finProbAt2
          refine Finset.sum_congr rfl (fun ω' _ => ?_)
          split_ifs with h1 h2 <;> simp_all [Prod.ext_iff, and_comm]
        rw [hp2]
      have h_ent_chain : ∀ {α β γ_t : Type} (X : Fin N_ω → α) (A : Fin N_ω → β)
          (B : Fin N_ω → γ_t),
          finCondEntropy ε π X (fun ω => (A ω, B ω)) =
            finCondEntropy ε π X A + finCondEntropy ε π (fun ω => (X ω, A ω)) B := by
        intro α β γ_t X A B
        unfold finCondEntropy
        rw [← Finset.sum_add_distrib]
        refine Finset.sum_congr rfl (fun ω _ => ?_)
        by_cases h0 : π ω = 0
        · simp [h0]
        · have hω_pos : 0 < π ω := lt_of_le_of_ne (hπ_nn ω) (Ne.symm h0)
          have hpXAB_eq : finProbAt2 π (fun ω' => (X ω', A ω')) B ω =
              finProbAt2 π X (fun ω' => (A ω', B ω')) ω := by
            unfold finProbAt2
            refine Finset.sum_congr rfl (fun ω' _ => ?_)
            split_ifs with h1 h2 <;> simp_all [Prod.ext_iff, and_assoc]
          have hpXA_eq : finProbAt π (fun ω' => (X ω', A ω')) ω = finProbAt2 π X A ω := by
            unfold finProbAt finProbAt2
            refine Finset.sum_congr rfl (fun ω' _ => ?_)
            split_ifs with h1 h2 <;> simp_all [Prod.ext_iff]
          have hpXAB_ge : π ω ≤ finProbAt2 π X (fun ω' => (A ω', B ω')) ω := by
            unfold finProbAt2
            refine le_trans ?_ (Finset.single_le_sum
              (fun ω' _ => by split_ifs <;> [exact hπ_nn ω'; exact le_rfl])
              (Finset.mem_univ ω))
            simp
          have hpXA_ge : finProbAt2 π X (fun ω' => (A ω', B ω')) ω ≤ finProbAt2 π X A ω := by
            unfold finProbAt2
            refine Finset.sum_le_sum (fun ω' _ => ?_)
            split_ifs with h1 h2 <;> simp_all [Prod.ext_iff, hπ_nn ω']
          have hpX_ge : finProbAt2 π X A ω ≤ finProbAt π X ω := by
            unfold finProbAt2 finProbAt
            refine Finset.sum_le_sum (fun ω' _ => ?_)
            split_ifs with h1 h2 <;> simp_all [hπ_nn ω']
          have hpXAB_pos : 0 < finProbAt2 π X (fun ω' => (A ω', B ω')) ω :=
            lt_of_lt_of_le hω_pos hpXAB_ge
          have hpXA_pos : 0 < finProbAt2 π X A ω := lt_of_lt_of_le hpXAB_pos hpXA_ge
          have hpX_pos : 0 < finProbAt π X ω := lt_of_lt_of_le hpXA_pos hpX_ge
          unfold condSurprise
          rw [hpXAB_eq, hpXA_eq]
          have h_prod_eq : finProbAt2 π X (fun ω' => (A ω', B ω')) ω / finProbAt π X ω =
              (finProbAt2 π X A ω / finProbAt π X ω) *
                (finProbAt2 π X (fun ω' => (A ω', B ω')) ω / finProbAt2 π X A ω) := by
            have h1 := hpX_pos.ne'
            have h2 := hpXA_pos.ne'
            field_simp [h1, h2]
          rw [h_prod_eq, Real.log_mul (div_ne_zero hpXA_pos.ne' hpX_pos.ne')
            (div_ne_zero hpXAB_pos.ne' hpXA_pos.ne')]
          ring
      
      have h_Z_bounds : ∀ {α : Type} (W : Fin N_ω → α),
          0 ≤ finCondEntropy ε π W Z ∧ finCondEntropy ε π W Z ≤ Real.log 2 / ell := by
        intro α W
        constructor
        · unfold finCondEntropy condSurprise
          refine Finset.sum_nonneg (fun ω _ => ?_)
          by_cases h0 : π ω = 0
          · simp [h0]
          · have hω_pos : 0 < π ω := lt_of_le_of_ne (hπ_nn ω) (Ne.symm h0)
            have hpWZ_ge : π ω ≤ finProbAt2 π W Z ω := by
              unfold finProbAt2
              refine le_trans ?_ (Finset.single_le_sum
                (fun ω' _ => by split_ifs <;> [exact hπ_nn ω'; exact le_rfl])
                (Finset.mem_univ ω))
              simp
            have hpW_ge : finProbAt2 π W Z ω ≤ finProbAt π W ω := by
              unfold finProbAt2 finProbAt
              refine Finset.sum_le_sum (fun ω' _ => ?_)
              split_ifs with h1 h2 <;> simp_all [hπ_nn ω']
            have hpWZ_pos : 0 < finProbAt2 π W Z ω := lt_of_lt_of_le hω_pos hpWZ_ge
            have hpW_pos : 0 < finProbAt π W ω := lt_of_lt_of_le hpWZ_pos hpW_ge
            have h_rat_nn : 0 ≤ finProbAt2 π W Z ω / finProbAt π W ω :=
              div_nonneg hpWZ_pos.le hpW_pos.le
            have h_rat_le1 : finProbAt2 π W Z ω / finProbAt π W ω ≤ 1 :=
              (div_le_one hpW_pos).mpr hpW_ge
            have h_log_np : Real.log (finProbAt2 π W Z ω / finProbAt π W ω) ≤ 0 :=
              Real.log_nonpos h_rat_nn h_rat_le1
            exact mul_nonneg (hπ_nn ω) (div_nonneg (neg_nonneg.mpr h_log_np) hell_pos.le)
        · have h_pt_kl : ∀ ω : Fin N_ω,
              π ω * (-(Real.log (finProbAt2 π W Z ω / finProbAt π W ω))) ≤
                π ω * Real.log 2 +
                  ((1 / 2 : ℝ) * (π ω * finProbAt π W ω / finProbAt2 π W Z ω) - π ω) := by
            intro ω
            by_cases h0 : π ω = 0
            · simp [h0]
            · have hω_pos : 0 < π ω := lt_of_le_of_ne (hπ_nn ω) (Ne.symm h0)
              have hpWZ_ge : π ω ≤ finProbAt2 π W Z ω := by
                unfold finProbAt2
                refine le_trans ?_ (Finset.single_le_sum
                  (fun ω' _ => by split_ifs <;> [exact hπ_nn ω'; exact le_rfl])
                  (Finset.mem_univ ω))
                simp
              have hpW_ge : finProbAt2 π W Z ω ≤ finProbAt π W ω := by
                unfold finProbAt2 finProbAt
                refine Finset.sum_le_sum (fun ω' _ => ?_)
                split_ifs with h1 h2 <;> simp_all [hπ_nn ω']
              let a := finProbAt2 π W Z ω
              let b := finProbAt π W ω
              have ha_pos : 0 < a := lt_of_lt_of_le hω_pos hpWZ_ge
              have hb_pos : 0 < b := lt_of_lt_of_le ha_pos hpW_ge
              have h_neg_log : -(Real.log (a / b)) = Real.log 2 + Real.log (b / (2 * a)) := by
                rw [← Real.log_inv, inv_div]
                have h_ba : b / a = 2 * (b / (2 * a)) := by
                  have ha_ne := ha_pos.ne'
                  field_simp [ha_ne]
                rw [h_ba, Real.log_mul (by norm_num) (by positivity)]
              have h_kl := Real.log_le_sub_one_of_pos (by positivity : 0 < b / (2 * a))
              have h_mul := mul_le_mul_of_nonneg_left
                (add_le_add_left h_kl (Real.log 2)) hω_pos.le
              change π ω * (-(Real.log (a / b))) ≤
                π ω * Real.log 2 + ((1 / 2 : ℝ) * (π ω * b / a) - π ω)
              rw [h_neg_log]
              have h_alg : π ω * (Real.log 2 + (b / (2 * a) - 1)) =
                  π ω * Real.log 2 + ((1 / 2 : ℝ) * (π ω * b / a) - π ω) := by ring
              linarith
          have h_dbl_sum :
              (∑ ω : Fin N_ω, π ω * finProbAt π W ω / finProbAt2 π W Z ω) ≤ 2 := by
            haveI : DecidableEq α := Classical.typeDecidableEq α
            have h_expand : ∀ ω : Fin N_ω,
                π ω * finProbAt π W ω / finProbAt2 π W Z ω =
                ∑ ω' : Fin N_ω, if W ω' = W ω then
                  π ω' * (π ω / finProbAt2 π W Z ω) else 0 := by
              intro ω
              unfold finProbAt
              rw [Finset.mul_sum, Finset.sum_div]
              refine Finset.sum_congr rfl (fun ω' _ => ?_)
              split_ifs <;> ring
            simp_rw [h_expand]
            rw [Finset.sum_comm]
            have h_inner_le : ∀ ω' : Fin N_ω,
                (∑ ω : Fin N_ω, if W ω' = W ω then
                  π ω' * (π ω / finProbAt2 π W Z ω) else 0) ≤ 2 * π ω' := by
              intro ω'
              have h_pull : (∑ ω : Fin N_ω, if W ω' = W ω then
                    π ω' * (π ω / finProbAt2 π W Z ω) else 0) =
                  π ω' * (∑ ω : Fin N_ω, if W ω' = W ω then
                    π ω / finProbAt2 π W Z ω else 0) := by
                rw [Finset.mul_sum]
                refine Finset.sum_congr rfl (fun ω _ => ?_)
                split_ifs <;> ring
              rw [h_pull]
              let M_t : ℝ := ∑ ω'' : Fin N_ω, if W ω'' = W ω' ∧ Z ω'' = true then π ω'' else 0
              let M_f : ℝ := ∑ ω'' : Fin N_ω, if W ω'' = W ω' ∧ Z ω'' = false then π ω'' else 0
              have h_split_Z : (∑ ω : Fin N_ω, if W ω' = W ω then
                    π ω / finProbAt2 π W Z ω else 0) =
                  M_t / M_t + M_f / M_f := by
                have h_pt : ∀ ω : Fin N_ω,
                    (if W ω' = W ω then π ω / finProbAt2 π W Z ω else 0) =
                    ((if W ω = W ω' ∧ Z ω = true then π ω else 0) / M_t) +
                    ((if W ω = W ω' ∧ Z ω = false then π ω else 0) / M_f) := by
                  intro ω
                  cases hZω : Z ω
                  · by_cases hW : W ω' = W ω
                    · have hWf : finProbAt2 π W Z ω = M_f := by
                        unfold finProbAt2
                        dsimp only [M_f]
                        refine Finset.sum_congr rfl (fun ω'' _ => ?_)
                        split_ifs with h1 h2 <;> simp_all
                      rw [if_pos hW, hWf, if_neg (by simp [hZω]), if_pos ⟨hW.symm, rfl⟩,
                        zero_div, zero_add]
                    · have hW' : W ω ≠ W ω' := fun heq => hW heq.symm
                      rw [if_neg hW, if_neg (by simp [hW']), if_neg (by simp [hW']),
                        zero_div, zero_div, add_zero]
                  · by_cases hW : W ω' = W ω
                    · have hWt : finProbAt2 π W Z ω = M_t := by
                        unfold finProbAt2
                        dsimp only [M_t]
                        refine Finset.sum_congr rfl (fun ω'' _ => ?_)
                        split_ifs with h1 h2 <;> simp_all
                      rw [if_pos hW, hWt, if_pos ⟨hW.symm, rfl⟩, if_neg (by simp [hZω]),
                        zero_div, add_zero]
                    · have hW' : W ω ≠ W ω' := fun heq => hW heq.symm
                      rw [if_neg hW, if_neg (by simp [hW']), if_neg (by simp [hW']),
                        zero_div, zero_div, add_zero]
                simp_rw [h_pt]
                rw [Finset.sum_add_distrib, ← Finset.sum_div, ← Finset.sum_div]
              have h_mt : M_t / M_t ≤ 1 := by
                by_cases hm : M_t = 0
                · simp [hm]
                · rw [div_self hm]
              have h_mf : M_f / M_f ≤ 1 := by
                by_cases hm : M_f = 0
                · simp [hm]
                · rw [div_self hm]
              rw [h_split_Z]
              nlinarith [hπ_nn ω']
            calc (∑ ω' : Fin N_ω, ∑ ω : Fin N_ω, if W ω' = W ω then
                  π ω' * (π ω / finProbAt2 π W Z ω) else 0)
                ≤ ∑ ω' : Fin N_ω, 2 * π ω' := Finset.sum_le_sum (fun ω' _ => h_inner_le ω')
              _ = 2 * ∑ ω' : Fin N_ω, π ω' := (Finset.mul_sum _ _ _).symm
              _ = 2 := by rw [hπ_sum, mul_one]
          have h_sum_kl :
              (∑ ω : Fin N_ω, π ω * (-(Real.log (finProbAt2 π W Z ω / finProbAt π W ω)))) ≤
                Real.log 2 := by
            have h1 := Finset.sum_le_sum (fun ω (_ : ω ∈ Finset.univ) => h_pt_kl ω)
            rw [Finset.sum_add_distrib, ← Finset.sum_mul, Finset.sum_sub_distrib,
              ← Finset.mul_sum, hπ_sum] at h1
            linarith [h1, h_dbl_sum]
          have h_ce_eq : finCondEntropy ε π W Z =
              (∑ ω : Fin N_ω, π ω * (-(Real.log (finProbAt2 π W Z ω / finProbAt π W ω)))) /
                ell := by
            unfold finCondEntropy condSurprise
            rw [Finset.sum_div]
            refine Finset.sum_congr rfl (fun ω _ => ?_)
            dsimp only [ell]
            ring
          rw [h_ce_eq]
          exact div_le_div_of_nonneg_right h_sum_kl hell_pos.le
      
      have h_sc_split :
          stdApertureScore ε γ u b_u a_u π T_idx V_part A_part c_s θ_s +
            finMutualInfo ε π T_idx Z - 3 * Real.log 2 / ell ≤
          p_E * stdApertureScore ε γ u b_u a_u π_E T_idx V_part A_part c_s θ_s +
            (1 - p_E) * stdApertureScore ε γ u b_u a_u π_Ec T_idx V_part A_part c_s θ_s := by
        let U : Fin N_ω → Unit := fun _ => ()
        let O_std := fun ω =>
          stdApertureObs ε u b_u a_u (V_part (T_idx ω)) (A_part (T_idx ω)) (c_s ω) (θ_s ω)
        let k_t := fun ω => dyadicTimeBin ε u (c_s ω)
        have h_diff_id : ∀ {α β : Type} (X : Fin N_ω → α) (A : Fin N_ω → β),
            finCondEntropy ε π (fun ω => (X ω, Z ω)) A =
              finCondEntropy ε π X A - finCondEntropy ε π X Z +
                finCondEntropy ε π (fun ω => (X ω, A ω)) Z := by
          intro α β X A
          have hc1 := h_ent_chain X A Z
          have hc2 := h_ent_chain X Z A
          have hs := h_ent_swap X A Z
          linarith
        have hc_UO := h_ent_conv U O_std
        have hc_TO := h_ent_conv T_idx O_std
        have hc_Tk := h_ent_conv T_idx k_t
        have hd_UO := h_diff_id U O_std
        have hd_TO := h_diff_id T_idx O_std
        have hd_Tk := h_diff_id T_idx k_t
        have hz_UO := (h_Z_bounds (fun ω => (U ω, O_std ω))).2
        have hz_TO := (h_Z_bounds (fun ω => (T_idx ω, O_std ω))).1
        have hz_T := (h_Z_bounds T_idx).2
        have hz_Tk := (h_Z_bounds (fun ω => (T_idx ω, k_t ω))).1
        unfold stdApertureScore finMutualInfo
        change ((1 + γ) * b_u + (1 - γ) * a_u) -
            (finCondEntropy ε π U O_std - finCondEntropy ε π T_idx O_std) +
            2 * finCondEntropy ε π T_idx k_t +
            (finCondEntropy ε π U Z - finCondEntropy ε π T_idx Z) -
            3 * Real.log 2 / ell ≤
          p_E * (((1 + γ) * b_u + (1 - γ) * a_u) -
            (finCondEntropy ε π_E U O_std - finCondEntropy ε π_E T_idx O_std) +
            2 * finCondEntropy ε π_E T_idx k_t) +
          (1 - p_E) * (((1 + γ) * b_u + (1 - γ) * a_u) -
            (finCondEntropy ε π_Ec U O_std - finCondEntropy ε π_Ec T_idx O_std) +
            2 * finCondEntropy ε π_Ec T_idx k_t)
        have h_lin_comb :
            p_E * (((1 + γ) * b_u + (1 - γ) * a_u) -
              (finCondEntropy ε π_E U O_std - finCondEntropy ε π_E T_idx O_std) +
              2 * finCondEntropy ε π_E T_idx k_t) +
            (1 - p_E) * (((1 + γ) * b_u + (1 - γ) * a_u) -
              (finCondEntropy ε π_Ec U O_std - finCondEntropy ε π_Ec T_idx O_std) +
              2 * finCondEntropy ε π_Ec T_idx k_t) =
            ((1 + γ) * b_u + (1 - γ) * a_u) -
              ((p_E * finCondEntropy ε π_E U O_std +
                  (1 - p_E) * finCondEntropy ε π_Ec U O_std) -
                (p_E * finCondEntropy ε π_E T_idx O_std +
                  (1 - p_E) * finCondEntropy ε π_Ec T_idx O_std)) +
              2 * (p_E * finCondEntropy ε π_E T_idx k_t +
                (1 - p_E) * finCondEntropy ε π_Ec T_idx k_t) := by ring
        rw [h_lin_comb, hc_UO, hc_TO, hc_Tk, hd_UO, hd_TO, hd_Tk]
        have h_3log2 : 3 * Real.log 2 / ell =
            Real.log 2 / ell + 2 * (Real.log 2 / ell) := by ring
        linarith
      
      let S_root_of : (Fin N_ω → ℝ) → Set ℝ := fun μ =>
        let p_T_μ : Fin N_T → ℝ := fun tid => ∑ ω : Fin N_ω, if T_idx ω = tid then μ ω else 0
        { s : ℝ | ∃ (N_D : ℕ)
            (b_D a_D : Fin N_D → ℝ)
            (e_D V_D A_D : Fin N_D → EuclideanSpace ℝ (Fin 2))
            (q : Fin N_T → Fin N_D → ℝ),
            (∀ d : Fin N_D, 0 ≤ b_D d ∧ b_D d ≤ a_D d ∧ a_D d ≤ L ∧ ‖e_D d‖ = 1) ∧
            (∀ tid d, 0 ≤ q tid d) ∧
            (∀ tid : Fin N_T, ∑ d : Fin N_D, q tid d = p_T_μ tid) ∧
            (∀ tid : Fin N_T, ∀ d : Fin N_D, 0 < q tid d →
              |inner ℝ (V_part tid - V_D d) (e_D d)| ≤ 10 * ε ^ (b_D d) ∧
              |inner ℝ (V_part tid - V_D d) (perp2D (e_D d))| ≤ 10 * ε ^ (a_D d) ∧
              |inner ℝ (A_part tid - A_D d) (e_D d)| ≤ 10 * ε ^ (b_D d) ∧
              |inner ℝ (A_part tid - A_D d) (perp2D (e_D d))| ≤ 10 * ε ^ (a_D d)) ∧
            (let q_D := fun d => ∑ tid : Fin N_T, q tid d
             let I_TD := (∑ tid : Fin N_T, ∑ d : Fin N_D,
               q tid d * Real.log (q tid d / (p_T_μ tid * q_D d))) / ell
             let E_w := ∑ d : Fin N_D, q_D d * ((1 + γ) * b_D d + (1 - γ) * a_D d)
             s = E_w - I_TD) }
      
      have h_root_ne_bdd : ∀ (μ : Fin N_ω → ℝ),
          (∀ ω, 0 ≤ μ ω) → (∑ ω : Fin N_ω, μ ω = 1) →
          (S_root_of μ).Nonempty ∧ BddAbove (S_root_of μ) := by
        intro μ hμ_nn hμ_sum
        let p_T_μ : Fin N_T → ℝ := fun tid => ∑ ω : Fin N_ω, if T_idx ω = tid then μ ω else 0
        have hpT_nn : ∀ tid, 0 ≤ p_T_μ tid := fun tid =>
          Finset.sum_nonneg (fun ω _ => by split_ifs <;> [exact hμ_nn ω; exact le_rfl])
        have hpT_sum : ∑ tid : Fin N_T, p_T_μ tid = 1 := by
          dsimp only [p_T_μ]
          rw [Finset.sum_comm]
          simp [hμ_sum]
        constructor
        · refine ⟨0, 1, (fun _ => 0), (fun _ => 0),
            (fun _ => WithLp.toLp 2 ![1, 0]), (fun _ => 0), (fun _ => 0),
            (fun tid _ => p_T_μ tid), ?_, ?_, ?_, ?_, ?_⟩
          · intro _
            refine ⟨le_rfl, le_rfl, hL, ?_⟩
            have hsq : ‖(WithLp.toLp 2 ![1, 0] : EuclideanSpace ℝ (Fin 2))‖ ^ 2 = 1 ^ 2 := by
              rw [PiLp.norm_sq_eq_of_L2, Fin.sum_univ_two]
              simp
            exact (sq_eq_sq₀ (norm_nonneg _) zero_le_one).mp hsq
          · intro tid _
            exact hpT_nn tid
          · intro tid
            simp [p_T_μ]
          · intro tid _ _
            let e₀ : EuclideanSpace ℝ (Fin 2) := WithLp.toLp 2 ![1, 0]
            have he₀ : ‖e₀‖ = 1 := by
              have hsq : ‖e₀‖ ^ 2 = 1 ^ 2 := by
                rw [PiLp.norm_sq_eq_of_L2, Fin.sum_univ_two]
                simp [e₀]
              exact (sq_eq_sq₀ (norm_nonneg _) zero_le_one).mp hsq
            have hep₀ : ‖perp2D e₀‖ = 1 := (h_perp_norm e₀).trans he₀
            obtain ⟨hv_le, ha_le⟩ := hVA tid
            have h_cap_v1 : |inner ℝ (V_part tid - 0) e₀| ≤ 10 * ε ^ (0 : ℝ) := by
              rw [sub_zero, Real.rpow_zero]
              calc |inner ℝ (V_part tid) e₀|
                  ≤ ‖V_part tid‖ * ‖e₀‖ := abs_real_inner_le_norm _ _
                _ ≤ 1 * 1 := by rw [he₀]; linarith
                _ ≤ 10 * 1 := by norm_num
            have h_cap_v2 : |inner ℝ (V_part tid - 0) (perp2D e₀)| ≤ 10 * ε ^ (0 : ℝ) := by
              rw [sub_zero, Real.rpow_zero]
              calc |inner ℝ (V_part tid) (perp2D e₀)|
                  ≤ ‖V_part tid‖ * ‖perp2D e₀‖ := abs_real_inner_le_norm _ _
                _ ≤ 1 * 1 := by rw [hep₀]; linarith
                _ ≤ 10 * 1 := by norm_num
            have h_cap_a1 : |inner ℝ (A_part tid - 0) e₀| ≤ 10 * ε ^ (0 : ℝ) := by
              rw [sub_zero, Real.rpow_zero]
              calc |inner ℝ (A_part tid) e₀|
                  ≤ ‖A_part tid‖ * ‖e₀‖ := abs_real_inner_le_norm _ _
