            have h_c : (gridPt2D σ_r (kx0, kx1) - x₀) 0 = σ_r * (kx0 : ℝ) - x₀ 0 := rfl
            rw [h_c] at hc0
            have h_div : |(kx0 : ℝ) - x₀ 0 / σ_r| = |σ_r * (kx0 : ℝ) - x₀ 0| / σ_r := by
              have : (kx0 : ℝ) - x₀ 0 / σ_r = (σ_r * (kx0 : ℝ) - x₀ 0) / σ_r := by
