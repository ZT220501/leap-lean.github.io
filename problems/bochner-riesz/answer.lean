      WithLp.toLp 2 (fun i : Fin 2 => if i = 0 then v_bar else 0)
    have h2d := hs1_int S_P E_v c_pt x2 v2 ρ R₀ m_ch hρ hR₀ hm_ch hsub (fun p hp => by
      obtain ⟨F_p, hFp_sub, hFp_card, hFp_int⟩ := hF p hp
      refine ⟨F_p, hFp_sub, hFp_card, fun p' hp' => ?_⟩
      simp only [x2, v2, ↓reduceIte, Fin.isValue, one_ne_zero, mul_zero, sub_zero, abs_zero]
      exact ⟨hFp_int p' hp', mul_nonneg hR₀ hρ.le⟩)
