  let K₀ : EuclideanSpace ℝ (Fin 3) → ℂ := fun z => bochnerRieszKernel δ z * (χ₀ z : ℂ)
  let a_neg : ℕ → EuclideanSpace ℝ (Fin 3) → ℂ := fun j => ⇑Complex.conjLIE ∘ a_pos j
  refine ⟨K₀, a_pos, a_neg, M, Φ, ?_, ?_, ?_, ?_, ?_, ?_⟩
