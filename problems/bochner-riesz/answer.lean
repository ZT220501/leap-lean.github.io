                    (∑ i : Fin N_P, if bU₁ i = k_U then w₁ i else 0) * μ_comp 1 2 v₂
                  else 0 := by
                refine Finset.sum_le_sum (fun k_U _ => ?_)
                split_ifs
                · have hcp := h_coord_prod b₁ hlam_o1_pos v₀.1 k_U v₂.1
                  dsimp only at hcp
                  rw [hμ1_0, hμ1_2]
                  refine le_trans ?_ (le_trans hcp ?_)
                  · exact le_of_eq (h_ite_congr Finset.univ _ _ w₁
                      (fun _ _ => ⟨fun h => ⟨h.1.1, h.2, h.1.2⟩, fun h => ⟨⟨h.1, h.2.2⟩, h.2.1⟩⟩))
                  · refine le_of_eq ?_
                    dsimp only [w₁, lam_o₁]
                    congr 1
                    · congr 1
