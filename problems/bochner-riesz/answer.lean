      have h_b1 := mul_le_mul_of_nonneg_left h_bes_K₁ h_nn_b1
      have h_b2 := mul_le_mul_of_nonneg_left h_bes_K₂ h_nn_b2
      have h_b3 := mul_le_mul_of_nonneg_left h_bes_TP h_nn_b3
      linarith only [h_step1, h_b1, h_b2, h_b3, h_sum_far]

    
    let B_core : ℝ := C_sub_bes * C_cov ^ 3 * (M_mult : ℝ) * R_tr ^ 2
    let Wt : ℝ := w_max * (T_P.card : ℝ)
