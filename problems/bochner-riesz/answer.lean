        let V' := chartRowVec useChart0 V
        let A' := chartRowVec useChart0 A
        P' 0 = A' 0 + C_v * V' 0 ∧
        P' 1 - R_mv * P' 0 = A' 1 + C_v * V' 1 - R_mv * (A' 0 + C_v * V' 0) := by
      intro V A C_v R_mv
      have hlin := (h_crv_props useChart0 A V C_v).2.2.2.1
      refine ⟨?_, ?_⟩
      · rw [hlin]; simp [PiLp.add_apply, PiLp.smul_apply]
      · rw [hlin]; simp [PiLp.add_apply, PiLp.smul_apply]
    refine ⟨?_, ?_, ?_, ?_⟩
    · 
      intro hkang_eq
      exact hSkr_mem R₂ (h_kr_pair hkang_eq)
    · 
      intro hkr_eq
      obtain ⟨s, hs_mem, hs_ang⟩ := h_kang_pair hkr_eq
      obtain ⟨hk1_fl, _, _⟩ := h_ang_bin ε (m * u) θ_u1 hθ_u1
      obtain ⟨hk2_fl, _, _⟩ := h_ang_bin ε (m * u) θ_u2 hθ_u2
      have h2mu_pos : 0 < (2 : ℝ) ^ m_mu := by positivity
      have h2mu_lt : (2 : ℝ) ^ m_mu < 2 * ε ^ (-(m * u)) :=
        (h_time_lvl ε (m * u) hε₀ hε₁ hmu_pos).2.1
      have hM_mu_eq : (M_mu : ℝ) = (2 : ℝ) ^ m_mu := by dsimp only [M_mu]; push_cast; rfl
      have h_sc_bd : |((θ_u2 - θ_u1 + (s : ℝ) * Real.pi) / Real.pi) * (2 : ℝ) ^ m_mu| ≤
          (N_ang : ℝ) := by
        rw [abs_mul, abs_div, abs_of_pos Real.pi_pos, abs_of_pos h2mu_pos]
        have hdiv : |θ_u2 - θ_u1 + (s : ℝ) * Real.pi| / Real.pi ≤
