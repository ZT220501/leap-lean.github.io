  let F_pin : ℝ → ℝ → ℝ := fun s_dir => if s_dir = 1 then prof.F_1 else prof.F_0
  let F_opp : ℝ → ℝ → ℝ := fun s_dir => if s_dir = 1 then prof.F_0 else prof.F_1
  have h_homog_sym : ∀ (s_dir d ε : ℝ),
      (s_dir = 1 ∨ s_dir = -1) → d ∈ Set.Icc (0 : ℝ) 1 → 0 < ε →
      ∃ N₀ : ℕ, ∀ n : ℕ, N₀ ≤ n →
        let l := prof.φ n
        let ρ := blk.ρ_seq l
        let Pi_sym : Fin (blk.N_Θ l) → Fin (blk.N_Θ l) → ℝ :=
          fun a b => ∑ i, ∑ b₂, threeReplicaStar blk l i a b b₂
        ∀ a b : Fin (blk.N_Θ l),
          (∃ b₂, (if s_dir = 1 then (a, b, b₂) else (b, a, b₂)) ∈ prof.E_seq n) →
          let d_cur := dirBin ρ d (dirVec (s_dir • (paramVec blk l b - paramVec blk l a)))
          0 < (∑ a', Pi_sym a' b) ∧
          ρ ^ (F_pin s_dir d + ε) * (∑ a', Pi_sym a' b) ≤
            (∑ a', if dirBin ρ d (dirVec (s_dir • (paramVec blk l b - paramVec blk l a'))) = d_cur
                   then Pi_sym a' b else 0) ∧
          (∑ a', if dirBin ρ d (dirVec (s_dir • (paramVec blk l b - paramVec blk l a'))) = d_cur
                 then Pi_sym a' b else 0) ≤
            ρ ^ (F_pin s_dir d - ε) * (∑ a', Pi_sym a' b) ∧
          (∑ b', if dirBin ρ d (dirVec (s_dir • (paramVec blk l b' - paramVec blk l a))) = d_cur
                 then Pi_sym a b' else 0) ≤
            ρ ^ (F_opp s_dir d - ε) * (∑ i, blk.π_seq l i a) := by
    intro s_dir d ε hs_dir hd hε
    obtain ⟨N₀_0, hN0⟩ := prof.h_dir0_homog d hd ε hε
    obtain ⟨N₀_1, hN1⟩ := prof.h_dir1_homog d hd ε hε
    refine ⟨max N₀_0 N₀_1, fun n hn => ?_⟩
    dsimp only
    let l := prof.φ n
    let ρ := blk.ρ_seq l
    let Pi_sym : Fin (blk.N_Θ l) → Fin (blk.N_Θ l) → ℝ :=
      fun a b => ∑ i, ∑ b₂, threeReplicaStar blk l i a b b₂
    intro a b ⟨b₂, ht⟩
    have hn0 : N₀_0 ≤ n := le_trans (le_max_left _ _) hn
    have hn1 : N₀_1 ≤ n := le_trans (le_max_right _ _) hn
    rcases hs_dir with rfl | rfl
    · simp only [if_true] at ht
      have h_pos_t := prof.hE_pos n (a, b, b₂) ht
      have hp1_eq : (∑ i, ∑ b₀, ∑ b₂', threeReplicaStar blk l i b₀ b b₂') = ∑ a', Pi_sym a' b :=
        Finset.sum_comm
      have hp0_eq : (∑ i, ∑ b₁, ∑ b₂', threeReplicaStar blk l i a b₁ b₂') =
          ∑ i, blk.π_seq l i a := h_star_marg0 l a
      have hp1_pos : 0 < ∑ a', Pi_sym a' b := by
        rw [← hp1_eq]
        refine lt_of_lt_of_le h_pos_t (Finset.sum_le_sum (fun i _ => ?_))
        refine le_trans
          (Finset.single_le_sum (fun b₂' _ => h_star_nn l i a b b₂') (Finset.mem_univ b₂)) ?_
        exact Finset.single_le_sum
          (fun b₀ _ => Finset.sum_nonneg (fun b₂' _ => h_star_nn l i b₀ b b₂'))
          (Finset.mem_univ a)
      have hp0_pos : 0 < ∑ i, blk.π_seq l i a := by
        rw [← hp0_eq]
        refine lt_of_lt_of_le h_pos_t (Finset.sum_le_sum (fun i _ => ?_))
        refine le_trans
          (Finset.single_le_sum (fun b₂' _ => h_star_nn l i a b b₂') (Finset.mem_univ b₂)) ?_
        exact Finset.single_le_sum
          (fun b₁ _ => Finset.sum_nonneg (fun b₂' _ => h_star_nn l i a b₁ b₂'))
          (Finset.mem_univ b)
      obtain ⟨h1_lo, h1_hi⟩ := hN1 n hn1 (a, b, b₂) ht
      obtain ⟨_, h0_hi⟩ := hN0 n hn0 (a, b, b₂) ht
      dsimp only at h1_lo h1_hi h0_hi
      dsimp only [F_pin, F_opp]
      simp only [if_true, one_smul]
      have hj1_eq : (∑ i, ∑ a', ∑ b₂',
          @ite ℝ (dirBin ρ d (dirVec (paramVec blk l b - paramVec blk l a')) =
            dirBin ρ d (dirVec (paramVec blk l b - paramVec blk l a)))
            (Classical.propDecidable _) (threeReplicaStar blk l i a' b b₂') 0) =
          ∑ a', if dirBin ρ d (dirVec (paramVec blk l b - paramVec blk l a')) =
            dirBin ρ d (dirVec (paramVec blk l b - paramVec blk l a))
          then Pi_sym a' b else 0 := by
        rw [Finset.sum_comm]
        refine Finset.sum_congr rfl (fun a' _ => ?_)
        by_cases hc : dirBin ρ d (dirVec (paramVec blk l b - paramVec blk l a')) =
            dirBin ρ d (dirVec (paramVec blk l b - paramVec blk l a))
        · simp [hc, Pi_sym]
        · simp [hc]
      have hj0_eq : (∑ i, ∑ b', ∑ b₂',
          @ite ℝ (dirBin ρ d (dirVec (paramVec blk l b' - paramVec blk l a)) =
            dirBin ρ d (dirVec (paramVec blk l b - paramVec blk l a)))
            (Classical.propDecidable _) (threeReplicaStar blk l i a b' b₂') 0) =
          ∑ b', if dirBin ρ d (dirVec (paramVec blk l b' - paramVec blk l a)) =
            dirBin ρ d (dirVec (paramVec blk l b - paramVec blk l a))
