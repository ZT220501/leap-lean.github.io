    have hell : 0 < Real.log (ε⁻¹) := h_ell_pos hε₀ hε₁
    have h_log_le : Real.log ((2 ^ m_u : ℕ) : ℝ) ≤ 2 * Real.log (ε⁻¹) := by
      calc Real.log ((2 ^ m_u : ℕ) : ℝ)
          ≤ Real.log ((ε⁻¹) ^ (2 : ℕ)) := Real.log_le_log (by positivity) h_le_sq
