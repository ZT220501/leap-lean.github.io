        calc ε ^ w ≤ ε ^ r * (s_v * ε ^ (u + t_cl)) := h1
          _ ≤ s_c * (s_v * ε ^ (u + t_cl)) :=
              mul_le_mul_of_nonneg_right hs_c1
                (mul_nonneg (Real.rpow_pos_of_pos hε₀ _).le (Real.rpow_pos_of_pos hε₀ _).le)
          _ = s_x * ε ^ (u + t_cl) := by dsimp only [s_x]; ring
      have hsXZ_Xb : s_XZ ≤ s_x * ε ^ (b_G d + t_cl) :=
        h_sx_rpow (b_G d) (a_tilde + t) (by dsimp only [a_G] at hbG_le_aG; linarith only [hbG_le_aG])
      have hsXZ_Xa : s_XZ ≤ s_x * ε ^ (a_G d + t_cl) :=
        h_sx_rpow (a_G d) (a_tilde + t) (by dsimp only [a_G]; linarith only)
      have hrXb_le : ε ^ (b_D d + t) ≤ s_x * ε ^ (b_G d + t_cl) :=
        h_sx_rpow (b_G d) (b_D d + t) (by linarith only [hbG_le_b])
      have hrXa_le : ε ^ (a_D d + t) ≤ s_x * ε ^ (a_G d + t_cl) :=
        h_sx_rpow (a_G d) (a_D d + t) (by dsimp only [a_G]; linarith only [hat_le_ad])

      have h_rloc_lt : r_D d % N_R < 2 ^ (m_t - m_r) := Nat.mod_lt _ hNR_pos
      have h_line := h_s2.2.2.2.1 m_r m_t q_r (r_D d % N_R) hmr_le_mt h_rloc_lt
      obtain ⟨hcmid_Icc, _, h_line_ap⟩ := h_line
      obtain ⟨h4_Vb, h4_Va, h4_Xb, h4_Xa⟩ := h_line_ap s_v cls.B_sys s_VZ s_XZ
        (ε ^ (b_D d)) (ε ^ (a_D d)) (ε ^ (b_D d + t)) (ε ^ (a_D d + t))
        (ε ^ (b_G d)) (ε ^ (a_G d)) (ε ^ (b_G d + t_cl)) (ε ^ (a_G d + t_cl))
        V_J X_J (V_at α) (X_at α) (V_O o_d) (X_O o_d) (V_D d) (X_D d) (e_D d)
        (Real.rpow_pos_of_pos hε₀ b_star) hB_sys_pos.le (hadm_D d).2.2.2.2
        hVa_Vo hXa_Xo hVod_b hVod_a hXod_b hXod_a
        hsVZ_Vb hsVZ_Va hrVb_le hrVa_le hsXZ_Xb hsXZ_Xa hrXb_le hrXa_le
      have h5B_le : 5 + cls.B_sys ≤ B_cl := by
        dsimp only [B_cl]; linarith only [cls.hB_sys, cls.hR_win]
      have hcmid_eq : ((k_time ω : ℝ) + 1 / 2) * Δ_time =
          (((r_D d % N_R : ℕ) : ℝ) + 1 / 2) * Δ_time := by
        rw [hk_eq, hrv_eq, Int.cast_natCast]
      dsimp only
      rw [hT_eq, hG_eq, hcmid_eq]
      exact ⟨hcmid_Icc, by rw [hk_eq, hkG_eq],
        le_trans h4_Vb (mul_le_mul_of_nonneg_right h5B_le (Real.rpow_pos_of_pos hε₀ _).le),
        le_trans h4_Va (mul_le_mul_of_nonneg_right h5B_le (Real.rpow_pos_of_pos hε₀ _).le),
        le_trans h4_Xb (mul_le_mul_of_nonneg_right h5B_le (Real.rpow_pos_of_pos hε₀ _).le),
        le_trans h4_Xa (mul_le_mul_of_nonneg_right h5B_le (Real.rpow_pos_of_pos hε₀ _).le)⟩

    
    have h_cl_bound := h_cl_est ε t_cl L_cl Δ_time
      hε₀ hε_lt_cl (min_le_left _ _) htcl_le_Lcl hLcl_le_K hΔ_Bcl_lo hΔ_Bcl_hi
      N_ω N_ret N_D π_ω T_idx k_time G_idx V_part A_part b_G a_G e_D V_G X_G k_G
      hπ_ω_nn hπ_ω_sum hVA_Bcl hG_dom h_cl_faith

    
    have h_cap_15 : ∀ (b_F a_F : ℝ) (e_F V_F A_F : EuclideanSpace ℝ (Fin 2))
        (S_cap : Finset (Fin N_ret)),
        0 ≤ b_F → b_F ≤ a_F → a_F ≤ L_cl → ‖e_F‖ = 1 →
        (∀ α ∈ S_cap,
          |inner ℝ (V_part α - V_F) e_F| ≤ 10 * ε ^ b_F ∧
          |inner ℝ (V_part α - V_F) (perp2D e_F)| ≤ 10 * ε ^ a_F ∧
          |inner ℝ (A_part α - A_F) e_F| ≤ 10 * ε ^ b_F ∧
          |inner ℝ (A_part α - A_F) (perp2D e_F)| ≤ 10 * ε ^ a_F) →
        (S_cap.card : ℝ) ≤ C_cov * 50625 * ε ^ (-sub.g_bin + pktWeight γ b_F a_F - 2 * ξ) := by
      intro b_F a_F e_F V_F A_F S_cap hb0 hba haL he1 hS_cap
      have h15_ge1 : (1 : ℝ) ≤ 15 := by norm_num
      have h15_pow : (15 : ℝ) ^ (4 : ℕ) = 50625 := by norm_num
      letI := Classical.propDecidable
      let X_F : EuclideanSpace ℝ (Fin 2) := A_F + (1 / 2 : ℝ) • V_F
      have hcap_raw := hsub_cap b_F a_F 15 e_F V_F X_F hb0 hba haL h15_ge1 he1
      have hr_if : (if r = 0 then (Real.sqrt lam_sys)⁻¹ else ε ^ ((H_P - r) / 2)) = ρ_r :=
        if_neg hr_pos.ne'
      simp only [hr_if] at hcap_raw
      let F_15 := Finset.univ.filter (fun α : Fin N_ret =>
        |inner ℝ (V'_at α - V_F) e_F| ≤ 15 * ε ^ b_F ∧
        |inner ℝ (V'_at α - V_F) (perp2D e_F)| ≤ 15 * ε ^ a_F ∧
        |inner ℝ (X'_at α - X_F) e_F| ≤ 15 * ε ^ b_F ∧
        |inner ℝ (X'_at α - X_F) (perp2D e_F)| ≤ 15 * ε ^ a_F)
      have h_sub_15 : S_cap ⊆ F_15 := by
        intro α hα
        have h15 := (h_s2.2.2.2.2 (V'_at α) (X'_at α) V_F A_F e_F (ε ^ b_F) (ε ^ a_F)
          (Real.rpow_pos_of_pos hε₀ _).le (Real.rpow_pos_of_pos hε₀ _).le).2 (hS_cap α hα)
        exact Finset.mem_filter.mpr ⟨Finset.mem_univ α, h15⟩
      have hcard_le : (S_cap.card : ℝ) ≤ (F_15.card : ℝ) := by
        exact_mod_cast Finset.card_le_card h_sub_15
      rw [h15_pow] at hcap_raw
      exact le_trans hcard_le hcap_raw

    obtain ⟨hHT_le, hRoot_le⟩ :=
      h_s4 ε L_cl sub.g_bin hε₀ hε₁ hLcl_nn hNret_1 π_ω T_idx V_part A_part
        hπ_ω_nn hπ_ω_sum h_cap_15

    
    let q_T : Fin N_ret → ℝ := fun α => ∑ z : Fin N_Z, ∑ d : Fin N_D, q z d α
    have hpT_fun_eq : (fun α : Fin N_ret => ∑ ω : Fin N_ω, if T_idx ω = α then π_ω ω else 0) = q_T :=
      funext hp_T_eq_qT
    rw [hpT_fun_eq] at hHT_le hRoot_le

    
    have h_log_Kmass : (3 / 2 : ℝ) * (Real.log K_mass / ell) =
        (3 / 2 : ℝ) * (Real.log (2 * (C_sub_bes + 1)) / ell) +
        (3 / 2 : ℝ) * ξ +
        (3 / 2 : ℝ) * (Real.log sub.m_bin / ell) := by
      dsimp only [K_mass]
      have h2C_pos : 0 < 2 * (C_sub_bes + 1) := by linarith only [hC_bes]
      have hrp_pos : 0 < ε ^ (-ξ) := Real.rpow_pos_of_pos hε₀ (-ξ)
      rw [Real.log_mul (mul_pos h2C_pos hrp_pos).ne' hm_bin_pos.ne',
        Real.log_mul h2C_pos.ne' hrp_pos.ne', Real.log_rpow hε₀]
      have h_xi_ell : -ξ * Real.log ε = ξ * ell := by
        dsimp only [ell]
        rw [Real.log_inv]
        ring
      rw [h_xi_ell, add_div, add_div, mul_div_cancel_right₀ ξ hell_pos.ne']
      ring

    have h_log_6561 : Real.log ((6561 : ℕ) : ℝ) = Real.log 6561 := by norm_num
    rw [h_log_6561] at h_ent_step
    have h_tcl_exp : (γ + δ_cl) * t_cl = 2 * (γ * h_slk) + 2 * (δ_cl * h_slk) := by
      dsimp only [t_cl]; ring
    rw [h_tcl_exp] at h_cl_bound

    
    dsimp only [score_fn, Target_bin, subclassProxyA, Err_bin, C_bin_log, ell, q, p_ZD, p_bD, p_bO, q_T, π_ω, T_idx, G_idx, k_time, N_ω] at h_ent_step h_Ew_le h_score_flat h_cl_bound hRoot_le hHT_le h_log_Kmass ⊢
    have hCbin_div :
        (3 / 2 * Real.log 6561 + 3 / 2 * Real.log (2 * (C_sub_bes + 1)) +
          1 / 2 * Real.log (50625 * C_cov)) / Real.log ε⁻¹ =
        3 / 2 * (Real.log 6561 / Real.log ε⁻¹) +
        3 / 2 * (Real.log (2 * (C_sub_bes + 1)) / Real.log ε⁻¹) +
        1 / 2 * (Real.log (50625 * C_cov) / Real.log ε⁻¹) := by ring
    rw [hCbin_div]
    linarith only [h_ent_step, h_Ew_le, h_score_flat, h_cl_bound, hRoot_le, hHT_le, h_log_Kmass]

  
  
  
  have h_avg_bins :
      (∑ b : Fin S_a, if 0 < π_b b then π_b b * score_fn (p_b b) else 0) ≤ Target_bin := by
    have h_pt : ∀ b : Fin S_a,
        (if 0 < π_b b then π_b b * score_fn (p_b b) else 0) ≤ π_b b * Target_bin := by
      intro b
      by_cases hpos : 0 < π_b b
      · rw [if_pos hpos]
        exact mul_le_mul_of_nonneg_left (h_per_bin b hpos) hpos.le
      · rw [if_neg hpos]
        have hz : π_b b = 0 := le_antisymm (le_of_not_gt hpos) (hπ_b_nn b)
        simp [hz]
    calc (∑ b : Fin S_a, if 0 < π_b b then π_b b * score_fn (p_b b) else 0)
        ≤ ∑ b : Fin S_a, π_b b * Target_bin := Finset.sum_le_sum (fun b _ => h_pt b)
      _ = (∑ b : Fin S_a, π_b b) * Target_bin := (Finset.sum_mul _ _ _).symm
      _ = Target_bin := by rw [hπ_b_sum, one_mul]

  have h_log_combine : Err_bin + Real.log (S_a : ℝ) / ell ≤ e_slk := by
    have h_sum_c : C_bin_log / ell + Real.log (S_a : ℝ) / ell = C_log / ell := by
      dsimp only [C_log]
      rw [← add_div, add_comm]
    have h_δh : δ_cl * h_slk = e_slk / 8 := by
      dsimp only [δ_cl]
      have hh_ne : h_slk ≠ 0 := hh_slk.ne'
      field_simp [hh_ne]
    dsimp only [Err_bin]
    linarith only [h_sum_c, hClog_ell, h_δh, hη_a_eslk, h16ξ, he_slk]

  rw [h_win_eq_score]
  dsimp only [Target_bin, score_fn, π_b, p_b, ell] at h_score_split h_avg_bins h_log_combine ⊢
  linarith only [h_score_split, h_avg_bins, h_log_combine]

theorem annulus_grid_and_dyadic_paving_card_bounds : (∀ (M_L : ℕ) (s : ℝ) (τ z₁ z₂ : EuclideanSpace ℝ (Fin 2)),
      1 ≤ M_L → 0 < s →
      (let p₁ := roundShift2D s τ z₁
       let p₂ := roundShift2D s τ z₂
       (p₁.1 / (M_L : ℤ), p₁.2 / (M_L : ℤ)) = (p₂.1 / (M_L : ℤ), p₂.2 / (M_L : ℤ))) →
      ‖z₁ - z₂‖ ≤ 2 * (M_L : ℝ) * s) ∧
    (∀ (s : ℝ) (v : EuclideanSpace ℝ (Fin 2)),
      0 < s → ‖v - gridPt2D s (roundShift2D s 0 v)‖ ≤ 2 * s) ∧
    (∀ (m₁ m₂ : ℕ) (ρ : ℝ),
      m₁ ≤ m₂ → 0 < ρ →
      let s₁ := ((2 : ℝ) ^ m₁)⁻¹ * ρ
      let s₂ := ((2 : ℝ) ^ m₂)⁻¹ * ρ
      let K : ℤ := ((2 ^ (m₂ - m₁) : ℕ) : ℤ)
      (∀ v : EuclideanSpace ℝ (Fin 2),
        roundShift2D s₁ 0 v =
          ((roundShift2D s₂ 0 v).1 / K, (roundShift2D s₂ 0 v).2 / K)) ∧
      (∀ k₂ : ℤ × ℤ,
        ‖gridPt2D s₂ k₂ - gridPt2D s₁ (k₂.1 / K, k₂.2 / K)‖ ≤ 2 * s₁)) ∧
    (∀ (s R : ℝ) (v₀ : EuclideanSpace ℝ (Fin 2)) (S : Finset (ℤ × ℤ)),
      0 < s → 0 ≤ R →
      (∀ k ∈ S, ‖gridPt2D s k - v₀‖ ≤ R) →
      (S.card : ℝ) ≤ (2 * (R / s) + 3) ^ 2) ∧
    (∀ (s R Δ : ℝ) (v₀ : EuclideanSpace ℝ (Fin 2)) (S : Finset (ℤ × ℤ)),
      0 < s → 0 < R → 0 < Δ → Δ ≤ R / 2 →
      (∀ k ∈ S, R - Δ ≤ ‖gridPt2D s k - v₀‖ ∧ ‖gridPt2D s k - v₀‖ ≤ R) →
      (S.card : ℝ) ≤ 2 * (2 * (R / s) + 3) * (6 * (Δ / s) + 4)) ∧
    (∀ {ι : Type} (s : ℝ) (e₀ V₀ X₀ : EuclideanSpace ℝ (Fin 2))
       (V X : ι → EuclideanSpace ℝ (Fin 2)) (F : Finset ι),
      0 < s → ‖e₀‖ = 1 →
      (∀ a ∈ F,
        |inner ℝ (V a - V₀) e₀| ≤ s ∧
        |inner ℝ (V a - V₀) (perp2D e₀)| ≤ s ∧
        |inner ℝ (X a - X₀) e₀| ≤ s ∧
        |inner ℝ (X a - X₀) (perp2D e₀)| ≤ s) →
      ((F.image (fun a => (roundShift2D s 0 (V a), roundShift2D s 0 (X a)))).card : ℝ) ≤ 625) :=
by
  have h_norm_sq : ∀ w : EuclideanSpace ℝ (Fin 2), ‖w‖ ^ 2 = (w 0) ^ 2 + (w 1) ^ 2 := by
    intro w
    rw [EuclideanSpace.norm_sq_eq w, Fin.sum_univ_two]
    simp [Real.norm_eq_abs, sq_abs]
  have h_mem_Icc_floor : ∀ (L U : ℝ) (a : ℤ),
      L ≤ (a : ℝ) → (a : ℝ) ≤ U → a ∈ Finset.Icc ⌊L⌋ ⌊U⌋ := by
    intro L U a hL hU
    rw [Finset.mem_Icc]
    refine ⟨?_, Int.le_floor.mpr hU⟩
    have h1 : ⌊L⌋ ≤ ⌊(a : ℝ)⌋ := Int.floor_mono hL
    rwa [Int.floor_intCast] at h1
  have h_card_Icc_floor : ∀ (L U B : ℝ),
      0 ≤ B → U - L ≤ B → ((Finset.Icc ⌊L⌋ ⌊U⌋).card : ℝ) ≤ B + 2 := by
    intro L U B hB hUL
    rw [Int.card_Icc]
    set d : ℤ := ⌊U⌋ + 1 - ⌊L⌋
    rcases le_or_gt d 0 with hd | hd
    · rw [Int.toNat_eq_zero.mpr hd, Nat.cast_zero]
      linarith
    · have hd_cast : ((d.toNat : ℕ) : ℝ) = (⌊U⌋ : ℝ) + 1 - (⌊L⌋ : ℝ) := by
        have h_z : ((d.toNat : ℕ) : ℤ) = d := Int.toNat_of_nonneg hd.le
        calc ((d.toNat : ℕ) : ℝ) = (((d.toNat : ℕ) : ℤ) : ℝ) := (Int.cast_natCast _).symm
          _ = (d : ℝ) := by rw [h_z]
          _ = (⌊U⌋ : ℝ) + 1 - (⌊L⌋ : ℝ) := by dsimp [d]; push_cast; ring
      rw [hd_cast]
      have hU_le : (⌊U⌋ : ℝ) ≤ U := Int.floor_le U
      have hL_lt : L < (⌊L⌋ : ℝ) + 1 := Int.lt_floor_add_one L
      linarith
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro M_L s τ z₁ z₂ hML hs hp
    set M : ℤ := (M_L : ℤ)
    have hM_pos : 0 < M := by omega
    have hM_ne : M ≠ 0 := hM_pos.ne'
    have hML_r : (1 : ℝ) ≤ (M_L : ℝ) := by exact_mod_cast hML
    have h_coord : ∀ (x₁ x₂ c : ℝ),
        ⌊(x₁ - c) / s⌋ / M = ⌊(x₂ - c) / s⌋ / M →
        (x₁ - x₂) ^ 2 ≤ ((M_L : ℝ) * s) ^ 2 := by
      intro x₁ x₂ c hq
      set k₁ : ℤ := ⌊(x₁ - c) / s⌋
      set k₂ : ℤ := ⌊(x₂ - c) / s⌋
      have hed₁ := Int.mul_ediv_add_emod k₁ M
      have hed₂ := Int.mul_ediv_add_emod k₂ M
      rw [hq] at hed₁
      set q_prod : ℤ := M * (k₂ / M)
      have hr₁_lo : 0 ≤ k₁ % M := Int.emod_nonneg k₁ hM_ne
      have hr₁_hi : k₁ % M < M := Int.emod_lt_of_pos k₁ hM_pos
      have hr₂_lo : 0 ≤ k₂ % M := Int.emod_nonneg k₂ hM_ne
      have hr₂_hi : k₂ % M < M := Int.emod_lt_of_pos k₂ hM_pos
      have hk_lo_z : -(M - 1) ≤ k₁ - k₂ := by omega
      have hk_hi_z : k₁ - k₂ ≤ M - 1 := by omega
      have hk_lo : -((M_L : ℝ) - 1) ≤ (k₁ : ℝ) - (k₂ : ℝ) := by
        have h1 : ((-(M - 1) : ℤ) : ℝ) ≤ ((k₁ - k₂ : ℤ) : ℝ) := Int.cast_le.mpr hk_lo_z
        dsimp [M] at h1
        push_cast at h1
        linarith
      have hk_hi : (k₁ : ℝ) - (k₂ : ℝ) ≤ (M_L : ℝ) - 1 := by
        have h1 : ((k₁ - k₂ : ℤ) : ℝ) ≤ ((M - 1 : ℤ) : ℝ) := Int.cast_le.mpr hk_hi_z
        dsimp [M] at h1
        push_cast at h1
        linarith
      have hu₁_lo : (k₁ : ℝ) ≤ (x₁ - c) / s := Int.floor_le _
      have hu₁_hi : (x₁ - c) / s < (k₁ : ℝ) + 1 := Int.lt_floor_add_one _
      have hu₂_lo : (k₂ : ℝ) ≤ (x₂ - c) / s := Int.floor_le _
      have hu₂_hi : (x₂ - c) / s < (k₂ : ℝ) + 1 := Int.lt_floor_add_one _
      have hdiff_lo : -(M_L : ℝ) < (x₁ - c) / s - (x₂ - c) / s := by linarith
      have hdiff_hi : (x₁ - c) / s - (x₂ - c) / s < (M_L : ℝ) := by linarith
      have h_id : x₁ - x₂ = ((x₁ - c) / s - (x₂ - c) / s) * s := by
        rw [sub_mul, div_mul_cancel₀ _ hs.ne', div_mul_cancel₀ _ hs.ne']
        ring
      rw [h_id]
      have hx_lo : -((M_L : ℝ) * s) < ((x₁ - c) / s - (x₂ - c) / s) * s := by nlinarith
      have hx_hi : ((x₁ - c) / s - (x₂ - c) / s) * s < (M_L : ℝ) * s := by nlinarith
      nlinarith
    have hp_inj := Prod.mk.inj hp
    have hc0 : (z₁ 0 - z₂ 0) ^ 2 ≤ ((M_L : ℝ) * s) ^ 2 := h_coord (z₁ 0) (z₂ 0) (τ 0) hp_inj.1
    have hc1 : (z₁ 1 - z₂ 1) ^ 2 ≤ ((M_L : ℝ) * s) ^ 2 := h_coord (z₁ 1) (z₂ 1) (τ 1) hp_inj.2
    have hnsq : ‖z₁ - z₂‖ ^ 2 ≤ (2 * (M_L : ℝ) * s) ^ 2 := by
      have hsub := h_norm_sq (z₁ - z₂)
      simp only [PiLp.sub_apply] at hsub
      nlinarith
    have h_nn1 : 0 ≤ ‖z₁ - z₂‖ := norm_nonneg _
    have h_nn2 : 0 ≤ 2 * (M_L : ℝ) * s := by positivity
    nlinarith
  · intro s v hs
    have h_1d : ∀ x : ℝ, (x - s * (⌊x / s⌋ : ℝ)) ^ 2 ≤ s ^ 2 := by
      intro x
      have h_lo : (⌊x / s⌋ : ℝ) ≤ x / s := Int.floor_le (x / s)
      have h_hi : x / s < (⌊x / s⌋ : ℝ) + 1 := Int.lt_floor_add_one (x / s)
      have hx_lo : s * (⌊x / s⌋ : ℝ) ≤ x := by
        have := mul_le_mul_of_nonneg_left h_lo hs.le
        rwa [mul_div_cancel₀ _ hs.ne'] at this
      have hx_hi : x < s * (⌊x / s⌋ : ℝ) + s := by
        have := mul_lt_mul_of_pos_left h_hi hs
        rw [mul_div_cancel₀ _ hs.ne', mul_add, mul_one] at this
        exact this
      nlinarith
    let w := gridPt2D s (roundShift2D s 0 v)
    have hw0 : (v - w) 0 = v 0 - s * (⌊v 0 / s⌋ : ℝ) := by
      simp [w, gridPt2D, roundShift2D]
    have hw1 : (v - w) 1 = v 1 - s * (⌊v 1 / s⌋ : ℝ) := by
      simp [w, gridPt2D, roundShift2D]
    have hnsq : ‖v - w‖ ^ 2 ≤ (2 * s) ^ 2 := by
      rw [h_norm_sq (v - w), hw0, hw1]
      have h0 := h_1d (v 0)
      have h1 := h_1d (v 1)
      nlinarith
    have h_nn : 0 ≤ ‖v - w‖ := norm_nonneg _
    nlinarith
  · intro m₁ m₂ ρ hm hρ
    dsimp only
    set s₁ : ℝ := ((2 : ℝ) ^ m₁)⁻¹ * ρ
    set s₂ : ℝ := ((2 : ℝ) ^ m₂)⁻¹ * ρ
    set K_N : ℕ := 2 ^ (m₂ - m₁)
    set K : ℤ := (K_N : ℤ)
