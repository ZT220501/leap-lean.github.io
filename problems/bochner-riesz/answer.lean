  have posSupport_zero_of_not_mem {N_ω : ℕ} {π : Fin N_ω → ℝ} (h_nn : ∀ ω, 0 ≤ π ω)
      {ω : Fin N_ω} (hω : ω ∉ stdApPosSupport π) : π ω = 0 := by
    unfold stdApPosSupport at hω
    simp only [Finset.mem_filter, Finset.mem_univ, true_and, not_lt] at hω
    exact le_antisymm hω (h_nn ω)
  have sum_posSupport_mul {N_ω : ℕ} {π : Fin N_ω → ℝ} (h_nn : ∀ ω, 0 ≤ π ω)
      (f : Fin N_ω → ℝ) :
      ∑ ω : Fin N_ω, π ω * f ω = ∑ ω ∈ stdApPosSupport π, π ω * f ω := by
    symm
    apply Finset.sum_subset (Finset.subset_univ _)
    intro ω _ hω
    rw [posSupport_zero_of_not_mem h_nn hω, zero_mul]
  have sum_posSupport_eq_one {N_ω : ℕ} {π : Fin N_ω → ℝ}
      (h_nn : ∀ ω, 0 ≤ π ω) (h_sum : ∑ ω : Fin N_ω, π ω = 1) :
      ∑ ω ∈ stdApPosSupport π, π ω = 1 := by
    have := sum_posSupport_mul h_nn (fun _ => (1 : ℝ))
    simp only [mul_one] at this
    linarith
  have finProbAt_eq_sum_posSupport {N_ω : ℕ} {α : Type} {π : Fin N_ω → ℝ}
      (h_nn : ∀ ω, 0 ≤ π ω) (X : Fin N_ω → α) (ω : Fin N_ω) :
      finProbAt π X ω = (letI := Classical.propDecidable
        ∑ ω' ∈ stdApPosSupport π, if X ω' = X ω then π ω' else 0) := by
    unfold finProbAt
    let _ := Classical.propDecidable
    symm
    apply Finset.sum_subset (Finset.subset_univ _)
    intro ω' _ hω'
    rw [posSupport_zero_of_not_mem h_nn hω']
    split_ifs <;> rfl
  have finProbAt_pos_of_mem {N_ω : ℕ} {α : Type} {π : Fin N_ω → ℝ}
      (h_nn : ∀ ω, 0 ≤ π ω) (X : Fin N_ω → α) {ω : Fin N_ω} (hω : ω ∈ stdApPosSupport π) :
      0 < finProbAt π X ω := by
    unfold stdApPosSupport at hω
    simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hω
    unfold finProbAt
    let _ := Classical.propDecidable
    have h_le : π ω ≤ ∑ ω' : Fin N_ω, if X ω' = X ω then π ω' else 0 := by
      have := Finset.single_le_sum (f := fun ω' => if X ω' = X ω then π ω' else 0)
        (fun ω' _ => by split_ifs <;> [exact h_nn ω'; exact le_rfl]) (Finset.mem_univ ω)
      simpa using this
    linarith
  have finProbAt2_eq_finProbAt_prod {N_ω : ℕ} {α β : Type} (π : Fin N_ω → ℝ)
      (X : Fin N_ω → α) (Y : Fin N_ω → β) (ω : Fin N_ω) :
      finProbAt2 π X Y ω = finProbAt π (fun ω' => (X ω', Y ω')) ω := by
    unfold finProbAt2 finProbAt
    let _ := Classical.propDecidable
    refine Finset.sum_congr rfl (fun ω' _ => ?_)
    simp only [Prod.ext_iff]
  have rawFinEntropy_congr {N_ω : ℕ} {α β : Type} (ε : ℝ) {π : Fin N_ω → ℝ}
      (h_nn : ∀ ω, 0 ≤ π ω) (X : Fin N_ω → α) (Y : Fin N_ω → β)
      (h_eq : ∀ ω₁ ∈ stdApPosSupport π, ∀ ω₂ ∈ stdApPosSupport π, (X ω₁ = X ω₂ ↔ Y ω₁ = Y ω₂)) :
      stdApRawEntropy ε π X = stdApRawEntropy ε π Y := by
    unfold stdApRawEntropy
    congr 1
    refine Finset.sum_congr rfl (fun ω hω => ?_)
    congr 2
    congr 1
    unfold finProbAt
    let _ := Classical.propDecidable
    have hX : (∑ ω' : Fin N_ω, if X ω' = X ω then π ω' else 0) =
        ∑ ω' ∈ stdApPosSupport π, if X ω' = X ω then π ω' else 0 := by
      symm
      apply Finset.sum_subset (Finset.subset_univ _)
      intro ω' _ hω'
      rw [posSupport_zero_of_not_mem h_nn hω']
      split_ifs <;> rfl
    have hY : (∑ ω' : Fin N_ω, if Y ω' = Y ω then π ω' else 0) =
        ∑ ω' ∈ stdApPosSupport π, if Y ω' = Y ω then π ω' else 0 := by
      symm
      apply Finset.sum_subset (Finset.subset_univ _)
      intro ω' _ hω'
      rw [posSupport_zero_of_not_mem h_nn hω']
      split_ifs <;> rfl
    rw [hX, hY]
    refine Finset.sum_congr rfl (fun ω' hω' => ?_)
    have heq := h_eq ω' hω' ω hω
    by_cases h1 : X ω' = X ω
    · have h2 : Y ω' = Y ω := heq.mp h1
      simp [h1, h2]
    · have h2 : Y ω' ≠ Y ω := fun hy => h1 (heq.mpr hy)
      simp [h1, h2]
  have finCondEntropy_eq_raw_sub {N_ω : ℕ} {α β : Type} (ε : ℝ) {π : Fin N_ω → ℝ}
      (h_nn : ∀ ω, 0 ≤ π ω) (X : Fin N_ω → α) (Y : Fin N_ω → β) :
      finCondEntropy ε π X Y =
        stdApRawEntropy ε π (fun ω => (X ω, Y ω)) - stdApRawEntropy ε π X := by
    unfold finCondEntropy stdApRawEntropy
    rw [sum_posSupport_mul h_nn, ← sub_div, ← Finset.sum_sub_distrib]
    have h_div : (∑ ω ∈ stdApPosSupport π, π ω * condSurprise ε π X Y ω) =
        (∑ ω ∈ stdApPosSupport π, π ω * -(Real.log (finProbAt2 π X Y ω / finProbAt π X ω))) /
          Real.log (ε⁻¹) := by
      unfold condSurprise
      rw [Finset.sum_div]
      refine Finset.sum_congr rfl (fun ω _ => ?_)
      ring
    rw [h_div]
    congr 1
    refine Finset.sum_congr rfl (fun ω hω => ?_)
    rw [finProbAt2_eq_finProbAt_prod]
    have hpXY : 0 < finProbAt π (fun ω' => (X ω', Y ω')) ω :=
      finProbAt_pos_of_mem h_nn _ hω
    have hpX : 0 < finProbAt π X ω := finProbAt_pos_of_mem h_nn _ hω
    rw [Real.log_div hpXY.ne' hpX.ne']
    ring
  have rawFinEntropy_unit {N_ω : ℕ} (ε : ℝ) {π : Fin N_ω → ℝ}
      (h_sum : ∑ ω : Fin N_ω, π ω = 1) :
      stdApRawEntropy ε π (fun _ => ()) = 0 := by
    unfold stdApRawEntropy finProbAt
    have h1 : ∀ ω ∈ stdApPosSupport π,
        (letI := Classical.propDecidable; ∑ ω' : Fin N_ω, if () = () then π ω' else 0) = 1 := by
      intro _ _
      simpa using h_sum
    have h_sum0 : ∑ ω ∈ stdApPosSupport π,
        -(π ω * Real.log (letI := Classical.propDecidable
          ∑ ω' : Fin N_ω, if () = () then π ω' else 0)) = 0 := by
      refine Finset.sum_eq_zero (fun ω hω => ?_)
      rw [h1 ω hω, Real.log_one, mul_zero, neg_zero]
    rw [h_sum0, zero_div]
  have finMutualInfo_eq_raw {N_ω : ℕ} {α β : Type} (ε : ℝ) {π : Fin N_ω → ℝ}
      (h_nn : ∀ ω, 0 ≤ π ω) (h_sum : ∑ ω : Fin N_ω, π ω = 1)
      (X : Fin N_ω → α) (Y : Fin N_ω → β) :
      finMutualInfo ε π X Y =
        stdApRawEntropy ε π Y - stdApRawEntropy ε π (fun ω => (X ω, Y ω)) + stdApRawEntropy ε π X := by
    unfold finMutualInfo
    rw [finCondEntropy_eq_raw_sub ε h_nn (fun _ => ()) Y,
        finCondEntropy_eq_raw_sub ε h_nn X Y,
        rawFinEntropy_unit ε h_sum]
    have h_unitY : stdApRawEntropy ε π (fun ω => ((), Y ω)) = stdApRawEntropy ε π Y := by
      apply rawFinEntropy_congr ε h_nn
      intro ω₁ _ ω₂ _
      simp
    rw [h_unitY]
    ring
  have finCondEntropy_nonneg {N_ω : ℕ} {α β : Type} {ε : ℝ} {π : Fin N_ω → ℝ}
      (hε₀ : 0 < ε) (hε₁ : ε < 1 / 2) (h_nn : ∀ ω, 0 ≤ π ω)
      (X : Fin N_ω → α) (Y : Fin N_ω → β) :
      0 ≤ finCondEntropy ε π X Y := by
    have hell : 0 < Real.log (ε⁻¹) := log_eps_inv_pos hε₀ hε₁
    unfold finCondEntropy
    rw [sum_posSupport_mul h_nn]
    refine Finset.sum_nonneg (fun ω hω => ?_)
    have hπ_pos : 0 < π ω := (Finset.mem_filter.mp hω).2
    refine mul_nonneg hπ_pos.le ?_
    unfold condSurprise
    refine div_nonneg ?_ hell.le
    rw [neg_nonneg]
    have hp2_pos : 0 < finProbAt2 π X Y ω := by
      rw [finProbAt2_eq_finProbAt_prod]
      exact finProbAt_pos_of_mem h_nn _ hω
    have hp_le : finProbAt2 π X Y ω ≤ finProbAt π X ω := by
      unfold finProbAt2 finProbAt
      let _ := Classical.propDecidable
      refine Finset.sum_le_sum (fun ω' _ => ?_)
      by_cases h1 : X ω' = X ω
      · by_cases h2 : Y ω' = Y ω
        · simp [h1, h2]
        · simp [h1, h2, h_nn ω']
      · simp [h1]
    have hp1_pos : 0 < finProbAt π X ω := lt_of_lt_of_le hp2_pos hp_le
    exact Real.log_nonpos (div_nonneg hp2_pos.le hp1_pos.le) ((div_le_one hp1_pos).mpr hp_le)
  have finCondEntropy_cond_le {N_ω : ℕ} {τ α β : Type}
      {ε : ℝ} {π : Fin N_ω → ℝ}
      (hε₀ : 0 < ε) (hε₁ : ε < 1 / 2)
      (h_nn : ∀ ω, 0 ≤ π ω) (h_sum : ∑ ω : Fin N_ω, π ω = 1)
      (T : Fin N_ω → τ) (X : Fin N_ω → α) (Y : Fin N_ω → β) :
      finCondEntropy ε π (fun ω => (T ω, X ω)) Y ≤ finCondEntropy ε π X Y := by
    letI := Classical.decEq τ
    letI := Classical.decEq α
    letI := Classical.decEq β
    have hell : 0 < Real.log (ε⁻¹) := log_eps_inv_pos hε₀ hε₁
    unfold finCondEntropy condSurprise
    rw [sum_posSupport_mul h_nn, sum_posSupport_mul h_nn]
    rw [← sub_nonpos, ← Finset.sum_sub_distrib]
    have h_factor :
        (∑ ω ∈ stdApPosSupport π,
          (π ω * (-Real.log (finProbAt2 π (fun ω => (T ω, X ω)) Y ω /
            finProbAt π (fun ω => (T ω, X ω)) ω) / Real.log (ε⁻¹)) -
           π ω * (-Real.log (finProbAt2 π X Y ω / finProbAt π X ω) / Real.log (ε⁻¹)))) =
        (∑ ω ∈ stdApPosSupport π,
          π ω * (Real.log (finProbAt2 π X Y ω / finProbAt π X ω) -
                 Real.log (finProbAt2 π (fun ω => (T ω, X ω)) Y ω /
                   finProbAt π (fun ω => (T ω, X ω)) ω))) / Real.log (ε⁻¹) := by
      rw [Finset.sum_div]
      refine Finset.sum_congr rfl (fun ω _ => ?_)
      ring
    rw [h_factor]
    refine div_nonpos_of_nonpos_of_nonneg ?_ hell.le
    let F := stdApPosSupport π
    have h_kl : ∀ ω ∈ F,
        π ω * (Real.log (finProbAt2 π X Y ω / finProbAt π X ω) -
               Real.log (finProbAt2 π (fun ω => (T ω, X ω)) Y ω /
                 finProbAt π (fun ω => (T ω, X ω)) ω)) ≤
        π ω * ((finProbAt2 π X Y ω * finProbAt π (fun ω => (T ω, X ω)) ω) /
               (finProbAt π X ω * finProbAt2 π (fun ω => (T ω, X ω)) Y ω) - 1) := by
      intro ω hω
      have hπ_pos : 0 < π ω := (Finset.mem_filter.mp hω).2
      apply mul_le_mul_of_nonneg_left _ hπ_pos.le
      have hpX : 0 < finProbAt π X ω := finProbAt_pos_of_mem h_nn X hω
      have hpXY : 0 < finProbAt2 π X Y ω := by
        rw [finProbAt2_eq_finProbAt_prod]; exact finProbAt_pos_of_mem h_nn _ hω
      have hpTX : 0 < finProbAt π (fun ω => (T ω, X ω)) ω := finProbAt_pos_of_mem h_nn _ hω
      have hpTXY : 0 < finProbAt2 π (fun ω => (T ω, X ω)) Y ω := by
        rw [finProbAt2_eq_finProbAt_prod]; exact finProbAt_pos_of_mem h_nn _ hω
      have h_log_eq :
          Real.log (finProbAt2 π X Y ω / finProbAt π X ω) -
          Real.log (finProbAt2 π (fun ω => (T ω, X ω)) Y ω /
            finProbAt π (fun ω => (T ω, X ω)) ω) =
          Real.log ((finProbAt2 π X Y ω * finProbAt π (fun ω => (T ω, X ω)) ω) /
            (finProbAt π X ω * finProbAt2 π (fun ω => (T ω, X ω)) Y ω)) := by
        rw [← Real.log_div (div_pos hpXY hpX).ne' (div_pos hpTXY hpTX).ne']
        congr 1
        field_simp [hpX.ne', hpTX.ne', hpTXY.ne']
      rw [h_log_eq]
      exact Real.log_le_sub_one_of_pos (div_pos (mul_pos hpXY hpTX) (mul_pos hpX hpTXY))
    calc ∑ ω ∈ F, π ω * (Real.log (finProbAt2 π X Y ω / finProbAt π X ω) -
            Real.log (finProbAt2 π (fun ω => (T ω, X ω)) Y ω /
              finProbAt π (fun ω => (T ω, X ω)) ω))
        ≤ ∑ ω ∈ F, π ω * ((finProbAt2 π X Y ω * finProbAt π (fun ω => (T ω, X ω)) ω) /
            (finProbAt π X ω * finProbAt2 π (fun ω => (T ω, X ω)) Y ω) - 1) :=
          Finset.sum_le_sum h_kl
      _ = (∑ ω ∈ F, π ω * ((finProbAt2 π X Y ω * finProbAt π (fun ω => (T ω, X ω)) ω) /
            (finProbAt π X ω * finProbAt2 π (fun ω => (T ω, X ω)) Y ω))) -
            ∑ ω ∈ F, π ω := by
          rw [← Finset.sum_sub_distrib]
          refine Finset.sum_congr rfl (fun ω _ => by ring)
      _ ≤ 1 - 1 := by
          rw [sum_posSupport_eq_one h_nn h_sum]
          gcongr
          let P_X : α → ℝ := fun x => ∑ ω' ∈ F, if X ω' = x then π ω' else 0
          let P_XY : α → β → ℝ := fun x y => ∑ ω' ∈ F, if (X ω', Y ω') = (x, y) then π ω' else 0
          let P_TX : τ × α → ℝ := fun tx => ∑ ω' ∈ F, if (T ω', X ω') = tx then π ω' else 0
          let P_TXY : (τ × α) × β → ℝ := fun z =>
            ∑ ω' ∈ F, if ((T ω', X ω'), Y ω') = z then π ω' else 0
          have hpX_eq : ∀ ω, finProbAt π X ω = P_X (X ω) := by
            intro ω
            rw [finProbAt_eq_sum_posSupport h_nn X ω]
          have hpXY_eq : ∀ ω, finProbAt2 π X Y ω = P_XY (X ω) (Y ω) := by
            intro ω
            rw [finProbAt2_eq_finProbAt_prod, finProbAt_eq_sum_posSupport h_nn]
            exact Finset.sum_congr rfl (fun _ _ => by split_ifs <;> rfl)
          have hpTX_eq : ∀ ω, finProbAt π (fun ω' => (T ω', X ω')) ω = P_TX (T ω, X ω) := by
            intro ω
            rw [finProbAt_eq_sum_posSupport h_nn]
            exact Finset.sum_congr rfl (fun _ _ => by split_ifs <;> rfl)
          have hpTXY_eq : ∀ ω,
              finProbAt2 π (fun ω' => (T ω', X ω')) Y ω = P_TXY ((T ω, X ω), Y ω) := by
            intro ω
            rw [finProbAt2_eq_finProbAt_prod, finProbAt_eq_sum_posSupport h_nn]
            exact Finset.sum_congr rfl (fun _ _ => by split_ifs <;> rfl)
          let S_TX := F.image (fun ω => (T ω, X ω))
          let S_Y := F.image Y
          let S_TXY := F.image (fun ω => ((T ω, X ω), Y ω))
          have h_fib := (Finset.sum_fiberwise_of_maps_to
            (g := fun ω => ((T ω, X ω), Y ω))
            (t := S_TXY)
            (fun ω hω => Finset.mem_image_of_mem _ hω)
            (fun ω => π ω * ((finProbAt2 π X Y ω * finProbAt π (fun ω => (T ω, X ω)) ω) /
              (finProbAt π X ω * finProbAt2 π (fun ω => (T ω, X ω)) Y ω)))).symm
          rw [h_fib]
          have h_each_z : ∀ z ∈ S_TXY,
              (∑ ω ∈ F.filter (fun ω => ((T ω, X ω), Y ω) = z),
                π ω * ((finProbAt2 π X Y ω * finProbAt π (fun ω => (T ω, X ω)) ω) /
                  (finProbAt π X ω * finProbAt2 π (fun ω => (T ω, X ω)) Y ω))) =
              (P_XY z.1.2 z.2 * P_TX z.1) / P_X z.1.2 := by
            intro z hz
            obtain ⟨ω₀, hω₀F, rfl⟩ := Finset.mem_image.mp hz
            have hpz_pos : 0 < P_TXY ((T ω₀, X ω₀), Y ω₀) := by
              rw [← hpTXY_eq ω₀, finProbAt2_eq_finProbAt_prod]
              exact finProbAt_pos_of_mem h_nn _ hω₀F
            have h_congr : ∀ ω ∈ F.filter (fun ω => ((T ω, X ω), Y ω) = ((T ω₀, X ω₀), Y ω₀)),
                π ω * ((finProbAt2 π X Y ω * finProbAt π (fun ω => (T ω, X ω)) ω) /
                  (finProbAt π X ω * finProbAt2 π (fun ω => (T ω, X ω)) Y ω)) =
                π ω * ((P_XY (X ω₀) (Y ω₀) * P_TX (T ω₀, X ω₀)) /
                  (P_X (X ω₀) * P_TXY ((T ω₀, X ω₀), Y ω₀))) := by
              intro ω hω_fil
              obtain ⟨_, h_eq_z⟩ := Finset.mem_filter.mp hω_fil
              rw [hpX_eq ω, hpXY_eq ω, hpTX_eq ω, hpTXY_eq ω]
              have ht : T ω = T ω₀ := congrArg (fun p => p.1.1) h_eq_z
              have hx : X ω = X ω₀ := congrArg (fun p => p.1.2) h_eq_z
              have hy : Y ω = Y ω₀ := congrArg (fun p => p.2) h_eq_z
              rw [ht, hx, hy]
            rw [Finset.sum_congr rfl h_congr, ← Finset.sum_mul]
            have h_sum_fil : (∑ ω ∈ F.filter (fun ω => ((T ω, X ω), Y ω) = ((T ω₀, X ω₀), Y ω₀)),
                π ω) = P_TXY ((T ω₀, X ω₀), Y ω₀) := by
              dsimp [P_TXY]
              rw [Finset.sum_filter]
            rw [h_sum_fil]
            have hpX0 : P_X (X ω₀) ≠ 0 := by
              rw [← hpX_eq ω₀]; exact (finProbAt_pos_of_mem h_nn X hω₀F).ne'
            field_simp [hpX0, hpz_pos.ne']
          rw [Finset.sum_congr rfl h_each_z]
          have h_sub_prod : S_TXY ⊆ S_TX ×ˢ S_Y := by
            intro z hz
            obtain ⟨ω, hω, rfl⟩ := Finset.mem_image.mp hz
            exact Finset.mem_product.mpr ⟨Finset.mem_image_of_mem _ hω, Finset.mem_image_of_mem _ hω⟩
          have h_term_nn : ∀ z ∈ S_TX ×ˢ S_Y, z ∉ S_TXY →
              0 ≤ (P_XY z.1.2 z.2 * P_TX z.1) / P_X z.1.2 := by
            intro z _ _
            have h1 : 0 ≤ P_XY z.1.2 z.2 :=
              Finset.sum_nonneg (fun ω _ => by split_ifs <;> [exact h_nn ω; exact le_rfl])
            have h2 : 0 ≤ P_TX z.1 :=
              Finset.sum_nonneg (fun ω _ => by split_ifs <;> [exact h_nn ω; exact le_rfl])
            have h3 : 0 ≤ P_X z.1.2 :=
              Finset.sum_nonneg (fun ω _ => by split_ifs <;> [exact h_nn ω; exact le_rfl])
            exact div_nonneg (mul_nonneg h1 h2) h3
          calc ∑ z ∈ S_TXY, (P_XY z.1.2 z.2 * P_TX z.1) / P_X z.1.2
              ≤ ∑ z ∈ S_TX ×ˢ S_Y, (P_XY z.1.2 z.2 * P_TX z.1) / P_X z.1.2 :=
                Finset.sum_le_sum_of_subset_of_nonneg h_sub_prod h_term_nn
            _ = ∑ tx ∈ S_TX, ∑ y ∈ S_Y, (P_XY tx.2 y * P_TX tx) / P_X tx.2 :=
                Finset.sum_product _ _ _
            _ = ∑ tx ∈ S_TX, P_TX tx := by
                refine Finset.sum_congr rfl (fun tx htx => ?_)
                obtain ⟨ω₀, hω₀, rfl⟩ := Finset.mem_image.mp htx
                have hpX0_pos : 0 < P_X (X ω₀) := by
                  rw [← hpX_eq ω₀]; exact finProbAt_pos_of_mem h_nn X hω₀
                have h_factor_tx : (∑ y ∈ S_Y, (P_XY (X ω₀) y * P_TX (T ω₀, X ω₀)) / P_X (X ω₀)) =
                    (∑ y ∈ S_Y, P_XY (X ω₀) y) * (P_TX (T ω₀, X ω₀) / P_X (X ω₀)) := by
                  rw [Finset.sum_mul]
                  refine Finset.sum_congr rfl (fun y _ => by ring)
                rw [h_factor_tx]
                have h_sum_Y : ∑ y ∈ S_Y, P_XY (X ω₀) y = P_X (X ω₀) := by
                  dsimp [P_XY, P_X]
                  rw [Finset.sum_comm]
                  refine Finset.sum_congr rfl (fun ω hω => ?_)
                  have h_ite_y : ∀ y : β,
                      (if (X ω, Y ω) = (X ω₀, y) then π ω else 0) =
                      (if X ω = X ω₀ then (if Y ω = y then π ω else 0) else 0) := by
                    intro y
                    by_cases hx : X ω = X ω₀ <;> simp [hx]
                  simp_rw [h_ite_y]
                  by_cases hx : X ω = X ω₀
                  · simp only [hx, ↓reduceIte]
                    rw [Finset.sum_ite_eq S_Y (Y ω), if_pos (Finset.mem_image_of_mem Y hω)]
                  · simp [hx]
                rw [h_sum_Y, mul_div_cancel₀ _ hpX0_pos.ne']
            _ = 1 := by
                dsimp [P_TX]
                rw [Finset.sum_comm]
                have h_s : (∑ ω ∈ F, ∑ y ∈ S_TX, if (T ω, X ω) = y then π ω else 0) =
                    ∑ ω ∈ F, π ω := by
                  refine Finset.sum_congr rfl (fun ω hω => ?_)
                  rw [Finset.sum_ite_eq S_TX (T ω, X ω), if_pos (Finset.mem_image_of_mem _ hω)]
                rw [h_s, sum_posSupport_eq_one h_nn h_sum]
      _ = 0 := sub_self 1
  have finMutualInfo_sub_le_condEntropy {N_ω : ℕ} {τ α β : Type}
      {ε : ℝ} {π : Fin N_ω → ℝ}
      (hε₀ : 0 < ε) (hε₁ : ε < 1 / 2)
      (h_nn : ∀ ω, 0 ≤ π ω) (h_sum : ∑ ω : Fin N_ω, π ω = 1)
      (T : Fin N_ω → τ) (G₁ : Fin N_ω → α) (G₂ : Fin N_ω → β) :
      finMutualInfo ε π T G₁ - finMutualInfo ε π T G₂ ≤ finCondEntropy ε π G₂ G₁ := by
    have h1 := finCondEntropy_cond_le hε₀ hε₁ h_nn h_sum T G₁ G₂
    have h2 := finCondEntropy_nonneg hε₀ hε₁ h_nn (fun ω => (T ω, G₂ ω)) G₁
    rw [finMutualInfo_eq_raw ε h_nn h_sum T G₁,
        finMutualInfo_eq_raw ε h_nn h_sum T G₂,
        finCondEntropy_eq_raw_sub ε h_nn G₂ G₁]
    rw [finCondEntropy_eq_raw_sub ε h_nn (fun ω => (T ω, G₁ ω)) G₂,
        finCondEntropy_eq_raw_sub ε h_nn G₁ G₂] at h1
    rw [finCondEntropy_eq_raw_sub ε h_nn (fun ω => (T ω, G₂ ω)) G₁] at h2
    have h_symm1 : stdApRawEntropy ε π (fun ω => (G₁ ω, G₂ ω)) =
        stdApRawEntropy ε π (fun ω => (G₂ ω, G₁ ω)) := by
      apply rawFinEntropy_congr ε h_nn
      intro ω₁ _ ω₂ _
      simp [and_comm]
    have h_symm2 : stdApRawEntropy ε π (fun ω => ((T ω, G₁ ω), G₂ ω)) =
        stdApRawEntropy ε π (fun ω => ((T ω, G₂ ω), G₁ ω)) := by
      apply rawFinEntropy_congr ε h_nn
      intro ω₁ _ ω₂ _
      simp only [Prod.ext_iff]
      tauto
    linarith
  have finCondEntropy_le_card_bound {N_ω : ℕ} {α β : Type} [DecidableEq β]
      {ε M : ℝ} {π : Fin N_ω → ℝ}
      (hε₀ : 0 < ε) (hε₁ : ε < 1 / 2) (hM : 0 < M)
      (h_nn : ∀ ω, 0 ≤ π ω) (h_sum : ∑ ω : Fin N_ω, π ω = 1)
      (X : Fin N_ω → α) (Y : Fin N_ω → β)
      (B : α → Finset β)
      (h_mem : ∀ ω ∈ stdApPosSupport π, Y ω ∈ B (X ω))
      (h_card : ∀ x : α, ((B x).card : ℝ) ≤ M) :
      finCondEntropy ε π X Y ≤ Real.log M / Real.log (ε⁻¹) := by
    letI := Classical.decEq α
    have hell : 0 < Real.log (ε⁻¹) := log_eps_inv_pos hε₀ hε₁
    unfold finCondEntropy condSurprise
    rw [sum_posSupport_mul h_nn, ← sub_nonpos]
    let F := stdApPosSupport π
    have h_one : ∑ ω ∈ F, π ω = 1 := sum_posSupport_eq_one h_nn h_sum
    have h_lhs : (∑ ω ∈ F, π ω * (-Real.log (finProbAt2 π X Y ω / finProbAt π X ω) / Real.log (ε⁻¹))) -
        Real.log M / Real.log (ε⁻¹) =
        (∑ ω ∈ F, π ω * (-Real.log (finProbAt2 π X Y ω / finProbAt π X ω) - Real.log M)) /
          Real.log (ε⁻¹) := by
      have h_s1 : (∑ ω ∈ F, π ω * (-Real.log (finProbAt2 π X Y ω / finProbAt π X ω) / Real.log (ε⁻¹))) =
          (∑ ω ∈ F, π ω * (-Real.log (finProbAt2 π X Y ω / finProbAt π X ω))) / Real.log (ε⁻¹) := by
        rw [Finset.sum_div]
        refine Finset.sum_congr rfl (fun ω _ => by ring)
      have h_s2 : Real.log M = ∑ ω ∈ F, π ω * Real.log M := by
        rw [← Finset.sum_mul, h_one, one_mul]
      rw [h_s1, ← sub_div]
      congr 1
      conv_lhs => rw [h_s2]
      rw [← Finset.sum_sub_distrib]
      refine Finset.sum_congr rfl (fun ω _ => by ring)
    rw [h_lhs]
    refine div_nonpos_of_nonpos_of_nonneg ?_ hell.le
    have h_kl : ∀ ω ∈ F,
        π ω * (-Real.log (finProbAt2 π X Y ω / finProbAt π X ω) - Real.log M) ≤
        π ω * (finProbAt π X ω / (M * finProbAt2 π X Y ω) - 1) := by
      intro ω hω
      have hπ_pos : 0 < π ω := (Finset.mem_filter.mp hω).2
      apply mul_le_mul_of_nonneg_left _ hπ_pos.le
      have hpX : 0 < finProbAt π X ω := finProbAt_pos_of_mem h_nn X hω
      have hpXY : 0 < finProbAt2 π X Y ω := by
        rw [finProbAt2_eq_finProbAt_prod]; exact finProbAt_pos_of_mem h_nn _ hω
      have h_eq : -Real.log (finProbAt2 π X Y ω / finProbAt π X ω) - Real.log M =
          Real.log (finProbAt π X ω / (M * finProbAt2 π X Y ω)) := by
        rw [Real.log_div hpXY.ne' hpX.ne', Real.log_div hpX.ne' (mul_pos hM hpXY).ne',
            Real.log_mul hM.ne' hpXY.ne']
        ring
      rw [h_eq]
      exact Real.log_le_sub_one_of_pos (div_pos hpX (mul_pos hM hpXY))
    calc ∑ ω ∈ F, π ω * (-Real.log (finProbAt2 π X Y ω / finProbAt π X ω) - Real.log M)
        ≤ ∑ ω ∈ F, π ω * (finProbAt π X ω / (M * finProbAt2 π X Y ω) - 1) :=
          Finset.sum_le_sum h_kl
      _ = (∑ ω ∈ F, π ω * (finProbAt π X ω / (M * finProbAt2 π X Y ω))) - 1 := by
          have : ∑ ω ∈ F, π ω * (finProbAt π X ω / (M * finProbAt2 π X Y ω) - 1) =
              (∑ ω ∈ F, π ω * (finProbAt π X ω / (M * finProbAt2 π X Y ω))) - ∑ ω ∈ F, π ω := by
            rw [← Finset.sum_sub_distrib]
            refine Finset.sum_congr rfl (fun ω _ => by ring)
          rw [this, h_one]
      _ ≤ 1 - 1 := by
          gcongr
          let P_X : α → ℝ := fun x => ∑ ω' ∈ F, if X ω' = x then π ω' else 0
          let P_XY : α × β → ℝ := fun z => ∑ ω' ∈ F, if (X ω', Y ω') = z then π ω' else 0
          have hpX_eq : ∀ ω, finProbAt π X ω = P_X (X ω) := by
            intro ω
            rw [finProbAt_eq_sum_posSupport h_nn X ω]
          have hpXY_eq : ∀ ω, finProbAt2 π X Y ω = P_XY (X ω, Y ω) := by
            intro ω
            rw [finProbAt2_eq_finProbAt_prod, finProbAt_eq_sum_posSupport h_nn]
            exact Finset.sum_congr rfl (fun _ _ => by split_ifs <;> rfl)
          let S_X := F.image X
          let S_XY := F.image (fun ω => (X ω, Y ω))
          let S_cov := S_X.biUnion (fun x => (B x).image (fun y => (x, y)))
          have h_fib := (Finset.sum_fiberwise_of_maps_to
            (g := fun ω => (X ω, Y ω))
            (t := S_XY)
            (fun ω hω => Finset.mem_image_of_mem _ hω)
            (fun ω => π ω * (finProbAt π X ω / (M * finProbAt2 π X Y ω)))).symm
          rw [h_fib]
          have h_each : ∀ z ∈ S_XY,
              (∑ ω ∈ F.filter (fun ω => (X ω, Y ω) = z),
                π ω * (finProbAt π X ω / (M * finProbAt2 π X Y ω))) = P_X z.1 / M := by
            intro z hz
            obtain ⟨ω₀, hω₀F, rfl⟩ := Finset.mem_image.mp hz
            have hpXY0 : 0 < P_XY (X ω₀, Y ω₀) := by
              rw [← hpXY_eq ω₀, finProbAt2_eq_finProbAt_prod]
              exact finProbAt_pos_of_mem h_nn _ hω₀F
            have h_congr : ∀ ω ∈ F.filter (fun ω => (X ω, Y ω) = (X ω₀, Y ω₀)),
                π ω * (finProbAt π X ω / (M * finProbAt2 π X Y ω)) =
                π ω * (P_X (X ω₀) / (M * P_XY (X ω₀, Y ω₀))) := by
              intro ω hω_fil
              obtain ⟨_, h_eq_z⟩ := Finset.mem_filter.mp hω_fil
              rw [hpX_eq ω, hpXY_eq ω]
              have hx : X ω = X ω₀ := congrArg Prod.fst h_eq_z
              have hy : Y ω = Y ω₀ := congrArg Prod.snd h_eq_z
              rw [hx, hy]
            rw [Finset.sum_congr rfl h_congr, ← Finset.sum_mul]
            have h_fil_sum : (∑ ω ∈ F.filter (fun ω => (X ω, Y ω) = (X ω₀, Y ω₀)), π ω) =
                P_XY (X ω₀, Y ω₀) := by
              dsimp [P_XY]
              rw [Finset.sum_filter]
            rw [h_fil_sum]
            field_simp [hM.ne', hpXY0.ne']
          rw [Finset.sum_congr rfl h_each]
          have h_sub : S_XY ⊆ S_cov := by
            intro z hz
            obtain ⟨ω, hω, rfl⟩ := Finset.mem_image.mp hz
            refine Finset.mem_biUnion.mpr ⟨X ω, Finset.mem_image_of_mem X hω, ?_⟩
            exact Finset.mem_image_of_mem _ (h_mem ω hω)
          have h_nn_z : ∀ z ∈ S_cov, z ∉ S_XY → 0 ≤ P_X z.1 / M := by
            intro z _ _
            refine div_nonneg ?_ hM.le
            exact Finset.sum_nonneg (fun ω _ => by split_ifs <;> [exact h_nn ω; exact le_rfl])
          calc ∑ z ∈ S_XY, P_X z.1 / M
              ≤ ∑ z ∈ S_cov, P_X z.1 / M := Finset.sum_le_sum_of_subset_of_nonneg h_sub h_nn_z
            _ = ∑ x ∈ S_X, ∑ z ∈ (B x).image (fun y => (x, y)), P_X z.1 / M := by
                refine Finset.sum_biUnion ?_
                intro x₁ _ x₂ _ hne
                rw [Function.onFun, Finset.disjoint_left]
                intro z hz₁ hz₂
                obtain ⟨y₁, _, hy₁⟩ := Finset.mem_image.mp hz₁
                obtain ⟨y₂, _, hy₂⟩ := Finset.mem_image.mp hz₂
                exact hne (by rw [← hy₁] at hy₂; exact (congrArg Prod.fst hy₂).symm)
            _ ≤ ∑ x ∈ S_X, P_X x := by
                refine Finset.sum_le_sum (fun x _ => ?_)
                have h_im : ∑ z ∈ (B x).image (fun y => (x, y)), P_X z.1 / M =
                    ((B x).card : ℝ) * (P_X x / M) := by
                  rw [Finset.sum_image (fun y₁ _ y₂ _ h => congrArg Prod.snd h)]
                  simp [Finset.sum_const, nsmul_eq_mul]
                rw [h_im]
                have hpX_nn : 0 ≤ P_X x :=
                  Finset.sum_nonneg (fun ω _ => by split_ifs <;> [exact h_nn ω; exact le_rfl])
                calc ((B x).card : ℝ) * (P_X x / M)
                    ≤ M * (P_X x / M) := mul_le_mul_of_nonneg_right (h_card x) (div_nonneg hpX_nn hM.le)
                  _ = P_X x := mul_div_cancel₀ _ hM.ne'
            _ = 1 := by
                dsimp [P_X]
                rw [Finset.sum_comm]
                have h_s : (∑ ω ∈ F, ∑ x ∈ S_X, if X ω = x then π ω else 0) = ∑ ω ∈ F, π ω := by
                  refine Finset.sum_congr rfl (fun ω hω => ?_)
                  rw [Finset.sum_ite_eq S_X (X ω), if_pos (Finset.mem_image_of_mem X hω)]
                rw [h_s, h_one]
      _ = 0 := sub_self 1
  have s1_root_and_deficit_lb :
      (0 ≤ classicalGrowthRate γ ∧ classicalGrowthRate γ ≤ 2) ∧
      (∀ (ε L : ℝ) {N_ω N_T : ℕ} (π : Fin N_ω → ℝ) (T_idx : Fin N_ω → Fin N_T)
        (V_part A_part : Fin N_T → EuclideanSpace ℝ (Fin 2)) (c_s : Fin N_ω → ℝ),
        0 < ε → ε < 1 / 2 → 0 ≤ L → IsUnitBallTimeLaw π V_part A_part c_s →
        0 ≤ classicalRootSupremum ε L γ N_ω N_T π T_idx V_part A_part ∧
        classicalRootSupremum ε L γ N_ω N_T π T_idx V_part A_part ≤ 2 * L) ∧
      (∀ (K_hor u_min η : ℝ), 1 ≤ K_hor → 0 < u_min → u_min ≤ 1 → 0 < η →
        ∃ ε₀ : ℝ, 0 < ε₀ ∧ ε₀ < 1 / 2 ∧
          ∀ (ε L u b a : ℝ) {N_ω N_T : ℕ} (π : Fin N_ω → ℝ) (T_idx : Fin N_ω → Fin N_T)
            (V_part A_part : Fin N_T → EuclideanSpace ℝ (Fin 2)) (c_s θ_s : Fin N_ω → ℝ),
            0 < ε → ε < ε₀ → u_min ≤ u → u ≤ 1 → L ≤ K_hor →
            0 ≤ b → b ≤ a → a + u ≤ L →
            IsUnitBallTimeLaw π V_part A_part c_s →
            (∀ ω, 0 < π ω → θ_s ω ∈ Set.Ico (0 : ℝ) Real.pi) →
            -η ≤ stdApertureDeficit ε γ L u b a π T_idx V_part A_part c_s θ_s) := by
    have h_bdd_rates : BddBelow (ValidClassicalGrowthRates γ) := ⟨0, fun b hb => hb.1⟩
    have h_ne_rates : (ValidClassicalGrowthRates γ).Nonempty := ⟨2, h_two⟩
    have h_rate_bds : 0 ≤ classicalGrowthRate γ ∧ classicalGrowthRate γ ≤ 2 :=
      ⟨le_csInf h_ne_rates (fun b hb => hb.1), csInf_le h_bdd_rates h_two⟩
    refine ⟨h_rate_bds, ?_, ?_⟩
    · intro ε L N_ω N_T π T_idx V_part A_part c_s hε₀ hε₁ hL h_law
      rcases h_law with ⟨hπ_nn, hπ_sum, hVA_norm, _⟩
      have hell : 0 < Real.log (ε⁻¹) := log_eps_inv_pos hε₀ hε₁
      let p_T : Fin N_T → ℝ := fun tid => ∑ ω : Fin N_ω, if T_idx ω = tid then π ω else 0
      have hpT_nn : ∀ tid, 0 ≤ p_T tid := fun tid =>
        Finset.sum_nonneg (fun ω _ => by split_ifs <;> [exact hπ_nn ω; exact le_rfl])
      have hpT_sum : ∑ tid : Fin N_T, p_T tid = 1 := by
        dsimp [p_T]
        rw [Finset.sum_comm]
        simp [hπ_sum]
      unfold classicalRootSupremum
      dsimp only
      let S_root : Set ℝ := { s : ℝ | ∃ (N_D : ℕ)
        (b_D a_D : Fin N_D → ℝ)
        (e_D V_D A_D : Fin N_D → EuclideanSpace ℝ (Fin 2))
        (q : Fin N_T → Fin N_D → ℝ),
