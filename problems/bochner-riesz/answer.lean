          else 0) ≤ Real.log (M : ℝ) by
        have h_sub : (∑ m : Fin M,
            if 0 < π_bin m then
              π_bin m * (∑ o : Fin N_O, (-(q_O m o * Real.log (p_O o)) - -(q_O m o * Real.log (q_O m o))))
            else 0) =
          (∑ m : Fin M, if 0 < π_bin m then π_bin m * (∑ o : Fin N_O, -(q_O m o * Real.log (p_O o))) else 0) -
          (∑ m : Fin M, if 0 < π_bin m then π_bin m * (∑ o : Fin N_O, -(q_O m o * Real.log (q_O m o))) else 0) := by
          rw [← Finset.sum_sub_distrib]
          refine Finset.sum_congr rfl (fun m _ => ?_)
          by_cases hm : 0 < π_bin m
          · rw [if_pos hm, if_pos hm, if_pos hm, Finset.sum_sub_distrib, mul_sub]
          · rw [if_neg hm, if_neg hm, if_neg hm]; ring
        linarith only [h_diff, h_sub]
      refine le_trans (Finset.sum_le_sum (fun m _ => ?_)) (h_shannon hM π_bin hπ_nn hπ_sum)
      by_cases hm : 0 < π_bin m
      · rw [if_pos hm]
        have hqO_sum : ∑ o : Fin N_O, q_O m o = 1 := hq_sum m hm
        have h_o_le : ∀ o ∈ (Finset.univ : Finset (Fin N_O)),
            -(q_O m o * Real.log (p_O o)) - -(q_O m o * Real.log (q_O m o)) ≤
              q_O m o * (-Real.log (π_bin m)) := by
          intro o _
          have hqO_nn : 0 ≤ q_O m o := Finset.sum_nonneg (fun d _ => hq_nn m o d)
          rcases eq_or_lt_of_le hqO_nn with h0 | hqO_pos
          · rw [← h0]; simp
          · have h_le_pO : π_bin m * q_O m o ≤ p_O o := by
              rw [hp_O_rec o]
              calc π_bin m * q_O m o
                  = (if 0 < π_bin m then π_bin m * q_O m o else 0) := by rw [if_pos hm]
                _ ≤ ∑ m' : Fin M, if 0 < π_bin m' then π_bin m' * q_O m' o else 0 :=
                    Finset.single_le_sum
                      (f := fun m' => if 0 < π_bin m' then π_bin m' * q_O m' o else 0)
                      (fun m' _ => by split_ifs with hm' <;>
                        [exact mul_nonneg hm'.le (Finset.sum_nonneg (fun d _ => hq_nn m' o d)); norm_num])
                      (Finset.mem_univ m)
            have hpO_pos : 0 < p_O o := lt_of_lt_of_le (mul_pos hm hqO_pos) h_le_pO
            have h_div : q_O m o ≤ (π_bin m)⁻¹ * p_O o := by
              calc q_O m o = (π_bin m)⁻¹ * (π_bin m * q_O m o) := by field_simp [hm.ne']
                _ ≤ (π_bin m)⁻¹ * p_O o := mul_le_mul_of_nonneg_left h_le_pO (inv_nonneg.mpr hm.le)
            have hlog := Real.log_le_log hqO_pos h_div
            rw [Real.log_mul (inv_ne_zero hm.ne') hpO_pos.ne', Real.log_inv] at hlog
            have hmul := mul_le_mul_of_nonneg_left hlog hqO_pos.le
            linarith only [hmul]
        have hsum_o := Finset.sum_le_sum h_o_le
        rw [← Finset.sum_mul, hqO_sum, one_mul] at hsum_o
        have hmul_m := mul_le_mul_of_nonneg_left hsum_o hm.le
        linarith only [hmul_m]
      · rw [if_neg hm]
        have hπ0 : π_bin m = 0 := le_antisymm (le_of_not_gt hm) (hπ_nn m)
        simp [hπ0]
    
    have h_HOD_col : ∀ d : Fin N_D,
        ∑ o : Fin N_O, -(p o d * Real.log (p o d / p_D d)) ≤
        (∑ m : Fin M, if 0 < π_bin m then π_bin m * (∑ o : Fin N_O, -(q_bin m o d * Real.log (q_bin m o d / q_D m d))) else 0) +
          p_D d * Real.log (M : ℝ) := by
      intro d
      have hpD_nn : 0 ≤ p_D d := Finset.sum_nonneg (fun o _ => hp_nn o d)
      rcases eq_or_lt_of_le hpD_nn with hpD0 | hpD_pos
      · have hp0 : ∀ o, p o d = 0 := fun o =>
          le_antisymm
            (le_trans (Finset.single_le_sum (fun o' _ => hp_nn o' d) (Finset.mem_univ o)) hpD0.symm.le)
            (hp_nn o d)
        have hq0 : ∀ m, 0 < π_bin m → ∀ o, q_bin m o d = 0 := by
          intro m hm o
          have h1 := h_term m o d
          rw [if_pos hm, hp0 o, ite_self] at h1
          exact (mul_eq_zero.mp h1).resolve_left hm.ne'
        have hlhs0 : (∑ o : Fin N_O, -(p o d * Real.log (p o d / p_D d))) = 0 := by
          simp [hp0]
        have hrhs0 : (∑ m : Fin M, if 0 < π_bin m then π_bin m * (∑ o : Fin N_O, -(q_bin m o d * Real.log (q_bin m o d / q_D m d))) else 0) = 0 := by
          refine Finset.sum_eq_zero (fun m _ => ?_)
          by_cases hm : 0 < π_bin m
          · rw [if_pos hm]; simp [hq0 m hm]
          · rw [if_neg hm]
        rw [hlhs0, hrhs0, ← hpD0]; simp
      · let w_d : Fin M → ℝ := fun m => (if 0 < π_bin m then π_bin m * q_D m d else 0) / p_D d
        have hw_d_nn : ∀ m, 0 ≤ w_d m := by
          intro m; dsimp [w_d]
          refine div_nonneg ?_ hpD_pos.le
          split_ifs with hm
          · exact mul_nonneg hm.le (Finset.sum_nonneg (fun o _ => hq_nn m o d))
          · norm_num
        have hw_d_sum : ∑ m : Fin M, w_d m = 1 := by
          dsimp [w_d]
          rw [← Finset.sum_div, ← hp_D_rec d, div_self hpD_pos.ne']
        have h_lhs_d : (∑ o : Fin N_O, -(p o d * Real.log (p o d / p_D d))) =
            ∑ m : Fin M, if 0 < π_bin m then π_bin m * (∑ o : Fin N_O, -(q_bin m o d * Real.log (p o d / p_D d))) else 0 := by
          have h1 : ∀ o, -(p o d * Real.log (p o d / p_D d)) =
              ∑ m : Fin M, if 0 < π_bin m then π_bin m * -(q_bin m o d * Real.log (p o d / p_D d)) else 0 := by
            intro o
            calc -(p o d * Real.log (p o d / p_D d))
                = -((∑ m : Fin M, if 0 < π_bin m then π_bin m * q_bin m o d else 0) * Real.log (p o d / p_D d)) := by
                  congr 2; exact h_rec o d
              _ = ∑ m : Fin M, -((if 0 < π_bin m then π_bin m * q_bin m o d else 0) * Real.log (p o d / p_D d)) := by
                  rw [Finset.sum_mul, ← Finset.sum_neg_distrib]
              _ = ∑ m : Fin M, if 0 < π_bin m then π_bin m * -(q_bin m o d * Real.log (p o d / p_D d)) else 0 :=
                  Finset.sum_congr rfl (fun m _ => by split_ifs <;> ring)
          simp_rw [h1]
          rw [Finset.sum_comm]
          refine Finset.sum_congr rfl (fun m _ => ?_)
          split_ifs <;> simp [Finset.mul_sum]
        rw [h_lhs_d]
        suffices h_diff : (∑ m : Fin M,
            if 0 < π_bin m then
              π_bin m * (∑ o : Fin N_O, (-(q_bin m o d * Real.log (p o d / p_D d)) - -(q_bin m o d * Real.log (q_bin m o d / q_D m d))))
            else 0) ≤ p_D d * Real.log (M : ℝ) by
          have h_sub : (∑ m : Fin M,
              if 0 < π_bin m then
                π_bin m * (∑ o : Fin N_O, (-(q_bin m o d * Real.log (p o d / p_D d)) - -(q_bin m o d * Real.log (q_bin m o d / q_D m d))))
              else 0) =
            (∑ m : Fin M, if 0 < π_bin m then π_bin m * (∑ o : Fin N_O, -(q_bin m o d * Real.log (p o d / p_D d))) else 0) -
            (∑ m : Fin M, if 0 < π_bin m then π_bin m * (∑ o : Fin N_O, -(q_bin m o d * Real.log (q_bin m o d / q_D m d))) else 0) := by
            rw [← Finset.sum_sub_distrib]
            refine Finset.sum_congr rfl (fun m _ => ?_)
            by_cases hm : 0 < π_bin m
            · rw [if_pos hm, if_pos hm, if_pos hm, Finset.sum_sub_distrib, mul_sub]
            · rw [if_neg hm, if_neg hm, if_neg hm]; ring
          linarith only [h_diff, h_sub]
        have h_sh_d := mul_le_mul_of_nonneg_left (h_shannon hM w_d hw_d_nn hw_d_sum) hpD_pos.le
        rw [Finset.mul_sum] at h_sh_d
        refine le_trans (Finset.sum_le_sum (fun m _ => ?_)) h_sh_d
        by_cases hm : 0 < π_bin m
        · rw [if_pos hm]
          have hqD_nn : 0 ≤ q_D m d := Finset.sum_nonneg (fun o _ => hq_nn m o d)
          rcases eq_or_lt_of_le hqD_nn with hqD0 | hqD_pos
          · have hqo0 : ∀ o, q_bin m o d = 0 := fun o =>
              le_antisymm
                (le_trans (Finset.single_le_sum (fun o' _ => hq_nn m o' d) (Finset.mem_univ o)) hqD0.symm.le)
                (hq_nn m o d)
            have hwd0 : w_d m = 0 := by dsimp [w_d]; rw [if_pos hm, ← hqD0]; simp
            simp [hqo0, hwd0]
          · have hwd_eq : w_d m = (π_bin m * q_D m d) / p_D d := by dsimp [w_d]; rw [if_pos hm]
            have hwd_pos : 0 < w_d m := by rw [hwd_eq]; exact div_pos (mul_pos hm hqD_pos) hpD_pos
            have h_o_le : ∀ o ∈ (Finset.univ : Finset (Fin N_O)),
                -(q_bin m o d * Real.log (p o d / p_D d)) - -(q_bin m o d * Real.log (q_bin m o d / q_D m d)) ≤
                  q_bin m o d * (-Real.log (w_d m)) := by
              intro o _
              rcases eq_or_lt_of_le (hq_nn m o d) with h0 | hq_pos
              · rw [← h0]; simp
              · have h_le_pod : π_bin m * q_bin m o d ≤ p o d := by
                  have ht := h_term m o d
                  rw [if_pos hm] at ht
                  rw [ht]
                  split_ifs <;> [exact le_rfl; exact hp_nn o d]
                have hpod_pos : 0 < p o d := lt_of_lt_of_le (mul_pos hm hq_pos) h_le_pod
                have h_prod_le : w_d m * (q_bin m o d / q_D m d) ≤ p o d / p_D d := by
                  have h_id : w_d m * (q_bin m o d / q_D m d) = (π_bin m * q_bin m o d) / p_D d := by
                    rw [hwd_eq]
                    field_simp [hpD_pos.ne', hqD_pos.ne']
                  rw [h_id]
                  exact div_le_div_of_nonneg_right h_le_pod hpD_pos.le
                have h_ratio_le : q_bin m o d / q_D m d ≤ (w_d m)⁻¹ * (p o d / p_D d) := by
                  calc q_bin m o d / q_D m d
                      = (w_d m)⁻¹ * (w_d m * (q_bin m o d / q_D m d)) := by field_simp [hwd_pos.ne']
                    _ ≤ (w_d m)⁻¹ * (p o d / p_D d) :=
                        mul_le_mul_of_nonneg_left h_prod_le (inv_nonneg.mpr hwd_pos.le)
                have hq_div_pos : 0 < q_bin m o d / q_D m d := div_pos hq_pos hqD_pos
                have hp_div_pos : 0 < p o d / p_D d := div_pos hpod_pos hpD_pos
                have hlog := Real.log_le_log hq_div_pos h_ratio_le
                rw [Real.log_mul (inv_ne_zero hwd_pos.ne') hp_div_pos.ne', Real.log_inv] at hlog
                have hmul := mul_le_mul_of_nonneg_left hlog hq_pos.le
                linarith only [hmul]
            have hsum_o := Finset.sum_le_sum h_o_le
            rw [← Finset.sum_mul] at hsum_o
            have hmul_m := mul_le_mul_of_nonneg_left hsum_o hm.le
            have h_id2 : π_bin m * ((∑ o : Fin N_O, q_bin m o d) * (-Real.log (w_d m))) =
                p_D d * -(w_d m * Real.log (w_d m)) := by
              rw [hwd_eq]
              dsimp [q_D]
              field_simp [hpD_pos.ne']
            linarith only [hmul_m, h_id2]
        · rw [if_neg hm]
          have hwd0 : w_d m = 0 := by dsimp [w_d]; rw [if_neg hm]; simp
          simp [hwd0]
    have h_HOD : ∑ o : Fin N_O, ∑ d : Fin N_D, -(p o d * Real.log (p o d / p_D d)) ≤
        (∑ m : Fin M, if 0 < π_bin m then π_bin m * (∑ o : Fin N_O, ∑ d : Fin N_D, -(q_bin m o d * Real.log (q_bin m o d / q_D m d))) else 0) +
          Real.log (M : ℝ) := by
      rw [Finset.sum_comm]
      have hsum_d := Finset.sum_le_sum (fun d (_ : d ∈ Finset.univ) => h_HOD_col d)
      have hpD_sum : ∑ d : Fin N_D, p_D d = 1 := by
        dsimp [p_D]; rw [Finset.sum_comm, hp_sum]
      rw [Finset.sum_add_distrib, ← Finset.sum_mul, hpD_sum, one_mul] at hsum_d
      refine le_trans hsum_d ?_
      have h_swap_rhs : (∑ d : Fin N_D, ∑ m : Fin M,
          if 0 < π_bin m then π_bin m * (∑ o : Fin N_O, -(q_bin m o d * Real.log (q_bin m o d / q_D m d))) else 0) =
        ∑ m : Fin M, if 0 < π_bin m then π_bin m * (∑ o : Fin N_O, ∑ d : Fin N_D, -(q_bin m o d * Real.log (q_bin m o d / q_D m d))) else 0 := by
        rw [Finset.sum_comm]
        refine Finset.sum_congr rfl (fun m _ => ?_)
        by_cases hm : 0 < π_bin m
        · simp only [if_pos hm, ← Finset.mul_sum]
          congr 1
          exact Finset.sum_comm
        · simp [if_neg hm]
      rw [h_swap_rhs]
    
    have h_HO_div : (∑ o : Fin N_O, -(p_O o * Real.log (p_O o))) / ell ≤
        (∑ m : Fin M, (if 0 < π_bin m then π_bin m * (∑ o : Fin N_O, -(q_O m o * Real.log (q_O m o))) else 0) / ell) +
          Real.log (M : ℝ) / ell := by
      have hd := div_le_div_of_nonneg_right h_HO hell_pos.le
      rw [add_div] at hd
      conv at hd => rhs; arg 1; rw [Finset.sum_div]
      exact hd
    have h_HOD_div : (∑ o : Fin N_O, ∑ d : Fin N_D, -(p o d * Real.log (p o d / p_D d))) / ell ≤
        (∑ m : Fin M, (if 0 < π_bin m then π_bin m * (∑ o : Fin N_O, ∑ d : Fin N_D, -(q_bin m o d * Real.log (q_bin m o d / q_D m d))) else 0) / ell) +
          Real.log (M : ℝ) / ell := by
      have hd := div_le_div_of_nonneg_right h_HOD hell_pos.le
      rw [add_div] at hd
      conv at hd => rhs; arg 1; rw [Finset.sum_div]
      exact hd
    have h_Emass_div : (∑ o : Fin N_O, p_O o * Real.log (m_obs o)) / ell =
        ∑ m : Fin M, (if 0 < π_bin m then π_bin m * (∑ o : Fin N_O, q_O m o * Real.log (m_obs o)) else 0) / ell := by
      rw [h_Emass, Finset.sum_div]
    have h_rhs_expand : (∑ m : Fin M,
        if 0 < π_bin m then
          π_bin m * generalPacketScore ε γ H_P t lam_sys m_t Φ₀ f
            N_O N_D r_O V_O X_O ψ_O b_D a_D (q_bin m)
        else 0) =
      (∑ m : Fin M, (if 0 < π_bin m then π_bin m * (∑ o : Fin N_O, -(q_O m o * Real.log (q_O m o))) else 0) / ell) +
      (1 / 2 : ℝ) * (∑ m : Fin M, (if 0 < π_bin m then π_bin m * (∑ o : Fin N_O, ∑ d : Fin N_D, -(q_bin m o d * Real.log (q_bin m o d / q_D m d))) else 0) / ell) +
      (3 / 2 : ℝ) * (∑ m : Fin M, (if 0 < π_bin m then π_bin m * (∑ o : Fin N_O, q_O m o * Real.log (m_obs o)) else 0) / ell) +
      (1 / 2 : ℝ) * (∑ m : Fin M, if 0 < π_bin m then π_bin m * (∑ d : Fin N_D, q_D m d * w_ap d) else 0) := by
      rw [Finset.mul_sum, Finset.mul_sum, Finset.mul_sum,
        ← Finset.sum_add_distrib, ← Finset.sum_add_distrib, ← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl (fun m _ => ?_)
      by_cases hm : 0 < π_bin m
      · rw [if_pos hm, if_pos hm, if_pos hm, if_pos hm, if_pos hm]
        unfold generalPacketScore
        change π_bin m *
            ((∑ o : Fin N_O, -(q_O m o * Real.log (q_O m o))) / ell +
             (1 / 2 : ℝ) * ((∑ o : Fin N_O, ∑ d : Fin N_D, -(q_bin m o d * Real.log (q_bin m o d / q_D m d))) / ell) +
             (3 / 2 : ℝ) * ((∑ o : Fin N_O, q_O m o * Real.log (m_obs o)) / ell) +
             (1 / 2 : ℝ) * (∑ d : Fin N_D, q_D m d * w_ap d)) = _
        ring
      · simp [if_neg hm]
    change generalPacketScore ε γ H_P t lam_sys m_t Φ₀ f N_O N_D r_O V_O X_O ψ_O b_D a_D p ≤
      (∑ m : Fin M,
        if 0 < π_bin m then
          π_bin m * generalPacketScore ε γ H_P t lam_sys m_t Φ₀ f N_O N_D r_O V_O X_O ψ_O b_D a_D (q_bin m)
        else 0) + (3 * Real.log (M : ℝ)) / (2 * ell)
    rw [h_rhs_expand, ← h_Emass_div, ← h_Ew]
    conv_lhs => unfold generalPacketScore
    change (∑ o : Fin N_O, -(p_O o * Real.log (p_O o))) / ell +
      (1 / 2 : ℝ) * ((∑ o : Fin N_O, ∑ d : Fin N_D, -(p o d * Real.log (p o d / p_D d))) / ell) +
      (3 / 2 : ℝ) * ((∑ o : Fin N_O, p_O o * Real.log (m_obs o)) / ell) +
      (1 / 2 : ℝ) * (∑ d : Fin N_D, p_D d * w_ap d) ≤ _
    have h_pen : Real.log (M : ℝ) / ell + (1 / 2 : ℝ) * (Real.log (M : ℝ) / ell) =
        (3 * Real.log (M : ℝ)) / (2 * ell) := by ring
    linarith only [h_HO_div, h_HOD_div, h_pen]

  
  have h_emb_pull : ∀ {N'_O : ℕ} (emb : Fin N'_O → Fin N_O) (q : Fin N_O → Fin N_D → ℝ) {α' : ℝ},
      Function.Injective emb →
      (∀ o d, (∀ o' : Fin N'_O, emb o' ≠ o) → q o d = 0) →
      IsAdmissiblePacketLaw ε H_P L t cls.B_sys cls.R_win cls.N_mult cls.M_win
        lam_sys m_t Φ₀ f N_O N_D r_O V_O X_O ψ_O b_D a_D r_D e_D V_D X_D q →
      HasIncomingCredit ε H_P t h 4 d_dim N_O N_D r_O V_O X_O e_D q k_f α' →
      let p' : Fin N'_O → Fin N_D → ℝ := fun o' d => q (emb o') d
      IsAdmissiblePacketLaw ε H_P L t cls.B_sys cls.R_win cls.N_mult cls.M_win
        lam_sys m_t Φ₀ f N'_O N_D (r_O ∘ emb) (V_O ∘ emb) (X_O ∘ emb) (ψ_O ∘ emb)
        b_D a_D r_D e_D V_D X_D p' ∧
      generalPacketScore ε γ H_P t lam_sys m_t Φ₀ f N'_O N_D
        (r_O ∘ emb) (V_O ∘ emb) (X_O ∘ emb) (ψ_O ∘ emb) b_D a_D p' =
        generalPacketScore ε γ H_P t lam_sys m_t Φ₀ f N_O N_D r_O V_O X_O ψ_O b_D a_D q ∧
      HasIncomingCredit ε H_P t h 4 d_dim N'_O N_D
        (r_O ∘ emb) (V_O ∘ emb) (X_O ∘ emb) e_D p' k_f α' := by
    intro N'_O emb q α' hemb hq_out hadm_q hcred_q
    dsimp only
    have h_sum_emb : ∀ (G : Fin N_O → ℝ),
        (∀ o, (∀ o' : Fin N'_O, emb o' ≠ o) → G o = 0) →
        (∑ o' : Fin N'_O, G (emb o')) = ∑ o : Fin N_O, G o := by
      intro G hG
      rw [← Finset.sum_image (f := G) (s := Finset.univ) (g := emb) (fun x _ y _ hxy => hemb hxy)]
      refine Finset.sum_subset (Finset.subset_univ _) (fun o _ ho_not => hG o (fun o' heq => ?_))
      exact ho_not (Finset.mem_image.mpr ⟨o', Finset.mem_univ o', heq⟩)
    have hqO_out : ∀ o, (∀ o', emb o' ≠ o) → (∑ d : Fin N_D, q o d) = 0 :=
      fun o ho => Finset.sum_eq_zero (fun d _ => hq_out o d ho)
    obtain ⟨hq1, hq2, hq3, hq4, hq5, hq6, hq_nn, hq_sum, hq_supp⟩ := hadm_q
    have hp'_sum : ∑ o' : Fin N'_O, ∑ d : Fin N_D, q (emb o') d = 1 := by
      rw [h_sum_emb (fun o => ∑ d : Fin N_D, q o d) hqO_out]
      exact hq_sum
    have hp'_adm : IsAdmissiblePacketLaw ε H_P L t cls.B_sys cls.R_win cls.N_mult cls.M_win
        lam_sys m_t Φ₀ f N'_O N_D (r_O ∘ emb) (V_O ∘ emb) (X_O ∘ emb) (ψ_O ∘ emb)
        b_D a_D r_D e_D V_D X_D (fun o' d => q (emb o') d) := by
      letI := Classical.propDecidable
      refine ⟨fun o' => hq1 (emb o'), fun o' => hq2 (emb o'), fun o' => hq3 (emb o'),
        fun o' => hq4 (emb o'), ?_, hq6, fun o' d => hq_nn (emb o') d, hp'_sum,
        fun o' d hp' => hq_supp (emb o') d hp'⟩
      intro r v₀ x₀
      refine le_trans (Nat.cast_le.mpr ?_) (hq5 r v₀ x₀)
      refine Finset.card_le_card_of_injOn emb (fun o' ho' => ?_) (fun x _ y _ hxy => hemb hxy)
      rw [Finset.mem_coe, Finset.mem_filter] at ho' ⊢
      exact ⟨Finset.mem_univ _, ho'.2⟩
    have hp'_D : ∀ d : Fin N_D, (∑ o' : Fin N'_O, q (emb o') d) = ∑ o : Fin N_O, q o d :=
      fun d => h_sum_emb (fun o => q o d) (fun o ho => hq_out o d ho)
    have h_score_eq : generalPacketScore ε γ H_P t lam_sys m_t Φ₀ f N'_O N_D
        (r_O ∘ emb) (V_O ∘ emb) (X_O ∘ emb) (ψ_O ∘ emb) b_D a_D (fun o' d => q (emb o') d) =
        generalPacketScore ε γ H_P t lam_sys m_t Φ₀ f N_O N_D r_O V_O X_O ψ_O b_D a_D q := by
      unfold generalPacketScore
      dsimp only [Function.comp_apply]
      simp_rw [hp'_D]
      have h1 : (∑ o' : Fin N'_O, -((∑ d : Fin N_D, q (emb o') d) * Real.log (∑ d : Fin N_D, q (emb o') d))) =
          ∑ o : Fin N_O, -((∑ d : Fin N_D, q o d) * Real.log (∑ d : Fin N_D, q o d)) :=
        h_sum_emb (fun o => -((∑ d : Fin N_D, q o d) * Real.log (∑ d : Fin N_D, q o d)))
          (fun o ho => by rw [hqO_out o ho]; simp)
      have h2 : (∑ o' : Fin N'_O, ∑ d : Fin N_D, -(q (emb o') d * Real.log (q (emb o') d / ∑ o : Fin N_O, q o d))) =
          ∑ o : Fin N_O, ∑ d : Fin N_D, -(q o d * Real.log (q o d / ∑ o₁ : Fin N_O, q o₁ d)) :=
        h_sum_emb (fun o => ∑ d : Fin N_D, -(q o d * Real.log (q o d / ∑ o₁ : Fin N_O, q o₁ d)))
          (fun o ho => Finset.sum_eq_zero (fun d _ => by rw [hq_out o d ho]; simp))
      have h3 : (∑ o' : Fin N'_O, (∑ d : Fin N_D, q (emb o') d) *
          Real.log (generalPacketObsMass ε H_P t lam_sys m_t Φ₀ f (r_O (emb o')) (V_O (emb o')) (X_O (emb o')) (ψ_O (emb o')))) =
          ∑ o : Fin N_O, (∑ d : Fin N_D, q o d) *
            Real.log (generalPacketObsMass ε H_P t lam_sys m_t Φ₀ f (r_O o) (V_O o) (X_O o) (ψ_O o)) :=
        h_sum_emb (fun o => (∑ d : Fin N_D, q o d) *
          Real.log (generalPacketObsMass ε H_P t lam_sys m_t Φ₀ f (r_O o) (V_O o) (X_O o) (ψ_O o)))
          (fun o ho => by rw [hqO_out o ho]; simp)
      rw [h1, h2, h3]
    have h_cred_eq : HasIncomingCredit ε H_P t h 4 d_dim N'_O N_D
        (r_O ∘ emb) (V_O ∘ emb) (X_O ∘ emb) e_D (fun o' d => q (emb o') d) k_f α' := by
      letI := Classical.propDecidable
      unfold HasIncomingCredit at hcred_q ⊢
      rcases hcred_q with hk0 | ⟨hk_pos, L_grid, τ_V, τ_X, P_f, n_f, W_f, hL1, hL2, hn_f, hgeom, hal, hprob⟩
      · exact Or.inl hk0
      · refine Or.inr ⟨hk_pos, L_grid, τ_V, τ_X, P_f ∘ emb, n_f, W_f ∘ emb, hL1, hL2, hn_f,
          fun o' => hgeom (emb o'), fun hd1 o' d hp' => hal hd1 (emb o') d hp', ?_⟩
        intro p_c w
        have hf1 : (∑ o' ∈ Finset.univ.filter (fun o' => (P_f ∘ emb) o' = p_c ∧ (W_f ∘ emb) o' = w),
            ∑ d : Fin N_D, q (emb o') d) =
          ∑ o ∈ Finset.univ.filter (fun o => P_f o = p_c ∧ W_f o = w), ∑ d : Fin N_D, q o d := by
          rw [Finset.sum_filter, Finset.sum_filter]
          exact h_sum_emb (fun o => if P_f o = p_c ∧ W_f o = w then ∑ d : Fin N_D, q o d else 0)
            (fun o ho => by split_ifs <;> [exact hqO_out o ho; rfl])
        have hf2 : (∑ o' ∈ Finset.univ.filter (fun o' => (P_f ∘ emb) o' = p_c),
            ∑ d : Fin N_D, q (emb o') d) =
          ∑ o ∈ Finset.univ.filter (fun o => P_f o = p_c), ∑ d : Fin N_D, q o d := by
          rw [Finset.sum_filter, Finset.sum_filter]
          exact h_sum_emb (fun o => if P_f o = p_c then ∑ d : Fin N_D, q o d else 0)
            (fun o ho => by split_ifs <;> [exact hqO_out o ho; rfl])
        rw [hf1, hf2]
        exact hprob p_c w
    exact ⟨hp'_adm, h_score_eq, h_cred_eq⟩

  
  have h_cnt_NO : (N_O : ℝ) ≤ C_cnt * ε ^ (-(4 * cls.K_hor)) :=
    h_cnt_est ε H_P L t lam_sys m_t N_O N_D Φ₀ ζ₀ f
      r_O V_O X_O ψ_O b_D a_D r_D e_D V_D X_D p henv ht₀ ht_HP hm_t1 hadm
  have h_low_bound : ∀ (q : Fin N_O → Fin N_D → ℝ),
      IsAdmissiblePacketLaw ε H_P L t cls.B_sys cls.R_win cls.N_mult cls.M_win
        lam_sys m_t Φ₀ f N_O N_D r_O V_O X_O ψ_O b_D a_D r_D e_D V_D X_D q →
      (∀ o d, 0 < q o d →
        generalPacketObsMass ε H_P t lam_sys m_t Φ₀ f (r_O o) (V_O o) (X_O o) (ψ_O o) ≤ ε ^ A₀) →
      generalPacketScore ε γ H_P t lam_sys m_t Φ₀ f N_O N_D r_O V_O X_O ψ_O b_D a_D q ≤ -6 := by
    intro q hadm_q h_low
    obtain ⟨_, _, _, _, hpack, hd_bounds, hq_nn, hq_sum, hq_supp⟩ := hadm_q
    have hNO_ge1 : 1 ≤ N_O := by
      by_contra h0
      have hNO0 : N_O = 0 := by omega
      subst hNO0
      simp at hq_sum
    have hNO_pos : (0 : ℝ) < (N_O : ℝ) := Nat.cast_pos.mpr (by omega)
    let q_O := fun o : Fin N_O => ∑ d : Fin N_D, q o d
    let q_D := fun d : Fin N_D => ∑ o : Fin N_O, q o d
    have hqO_nn : ∀ o, 0 ≤ q_O o := fun o => Finset.sum_nonneg (fun d _ => hq_nn o d)
    have hqO_sum : ∑ o : Fin N_O, q_O o = 1 := hq_sum
    have hqD_nn : ∀ d, 0 ≤ q_D d := fun d => Finset.sum_nonneg (fun o _ => hq_nn o d)
    have hqD_sum : ∑ d : Fin N_D, q_D d = 1 := by dsimp [q_D]; rw [Finset.sum_comm, hq_sum]
    
    have h_HO_le : (∑ o : Fin N_O, -(q_O o * Real.log (q_O o))) / ell ≤
        4 * cls.K_hor + Real.log C_cnt / ell := by
      have h1 := h_shannon hNO_ge1 q_O hqO_nn hqO_sum
      have h2 := Real.log_le_log hNO_pos h_cnt_NO
      rw [Real.log_mul hC_cnt_pos.ne' (Real.rpow_pos_of_pos hε₀ _).ne',
        Real.log_rpow hε₀, hlog_eps] at h2
      have h3 : ∑ o : Fin N_O, -(q_O o * Real.log (q_O o)) ≤ Real.log C_cnt + 4 * cls.K_hor * ell := by
        linarith
      have h4 := div_le_div_of_nonneg_right h3 hell_pos.le
      rw [add_div, mul_div_cancel_right₀ _ hell_pos.ne'] at h4
      linarith
    
    have h_Emass_le : (3 / 2 : ℝ) *
        ((∑ o : Fin N_O, q_O o * Real.log (generalPacketObsMass ε H_P t lam_sys m_t Φ₀ f (r_O o) (V_O o) (X_O o) (ψ_O o))) / ell) ≤
        -6 * cls.K_hor - 6 := by
      have h_o : ∀ o ∈ (Finset.univ : Finset (Fin N_O)),
          q_O o * Real.log (generalPacketObsMass ε H_P t lam_sys m_t Φ₀ f (r_O o) (V_O o) (X_O o) (ψ_O o)) ≤
            q_O o * (-A₀ * ell) := by
        intro o _
        rcases eq_or_lt_of_le (hqO_nn o) with h0 | hpos
        · rw [← h0]; simp
        · have hex : ∃ d : Fin N_D, 0 < q o d := by
            by_contra hall; push_neg at hall
            have hz : q_O o = 0 := Finset.sum_eq_zero (fun d _ => le_antisymm (hall d) (hq_nn o d))
            linarith
          obtain ⟨d₀, hd₀⟩ := hex
          have hm_pos := (hq_supp o d₀ hd₀).1
          have hm_le := h_low o d₀ hd₀
          have hlog := Real.log_le_log hm_pos hm_le
          rw [Real.log_rpow hε₀, hlog_eps] at hlog
          exact mul_le_mul_of_nonneg_left (by linarith) hpos.le
      have hsum := Finset.sum_le_sum h_o
      rw [← Finset.sum_mul, hqO_sum, one_mul] at hsum
      have hdiv := div_le_div_of_nonneg_right hsum hell_pos.le
      rw [mul_div_cancel_right₀ _ hell_pos.ne'] at hdiv
      dsimp [A₀] at hdiv
      linarith
    
    let u_t : ℝ := (H_P - t) / 2
    let ρ_obs : ℝ := ε ^ u_t
    let σ_obs : ℝ := (lam_sys * ρ_obs)⁻¹
    let s_V : ℝ := ρ_obs
    let s_X : ℝ := cls.B_sys⁻¹ * ε ^ (u_t + t)
    have hB_pos : 0 < cls.B_sys := by linarith [cls.hB_sys]
    have hs_V_pos : 0 < s_V := Real.rpow_pos_of_pos hε₀ u_t
    have hs_X_pos : 0 < s_X := mul_pos (inv_pos.mpr hB_pos) (Real.rpow_pos_of_pos hε₀ _)
    have hlam_lo : cls.B_sys⁻¹ * ε ^ (-H_P) ≤ lam_sys := henv.2.2.2.2.2.2.1
    have hlam_hi : lam_sys ≤ cls.B_sys * ε ^ (-H_P) := henv.2.2.2.2.2.2.2.1
    have hlam_pos : 0 < lam_sys := lt_of_lt_of_le (mul_pos (inv_pos.mpr hB_pos) (Real.rpow_pos_of_pos hε₀ _)) hlam_lo
    have hσ_pos : 0 < σ_obs := inv_pos.mpr (mul_pos hlam_pos hs_V_pos)
    have hs_X_le_σ : s_X ≤ σ_obs := by
      have h_prod : s_X * (lam_sys * ρ_obs) ≤ 1 := by
        calc s_X * (lam_sys * ρ_obs)
            ≤ (cls.B_sys⁻¹ * ε ^ (u_t + t)) * ((cls.B_sys * ε ^ (-H_P)) * ε ^ u_t) :=
              mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_right hlam_hi hs_V_pos.le) hs_X_pos.le
          _ = (cls.B_sys⁻¹ * cls.B_sys) * (ε ^ (u_t + t) * (ε ^ (-H_P) * ε ^ u_t)) := by ring
          _ = 1 * ε ^ ((u_t + t) + (-H_P + u_t)) := by
              rw [inv_mul_cancel₀ hB_pos.ne', ← Real.rpow_add hε₀, ← Real.rpow_add hε₀]
          _ = 1 := by
              have hexp0 : (u_t + t) + (-H_P + u_t) = 0 := by dsimp [u_t]; ring
              rw [hexp0, Real.rpow_zero, one_mul]
      calc s_X = (s_X * (lam_sys * ρ_obs)) * σ_obs := by
            have hρ_pos : 0 < ρ_obs := hs_V_pos
            dsimp [σ_obs]; field_simp [hlam_pos.ne', hρ_pos.ne']
        _ ≤ 1 * σ_obs := mul_le_mul_of_nonneg_right h_prod hσ_pos.le
        _ = σ_obs := one_mul _
    
    have h_mid_abs : ∀ (y s : ℝ), 0 < s →
        |y - ((⌊y / s⌋ : ℝ) + 1 / 2) * s| ≤ s / 2 := by
      intro y s hs
      have hlo : (⌊y / s⌋ : ℝ) * s ≤ y := (le_div_iff₀ hs).mp (Int.floor_le (y / s))
      have hhi : y < ((⌊y / s⌋ : ℝ) + 1) * s := (div_lt_iff₀ hs).mp (Int.lt_floor_add_one (y / s))
      rw [abs_le]
      exact ⟨by linarith only [hlo, hhi], by linarith only [hlo, hhi]⟩
    have h_icc_mem_card : ∀ (R s : ℝ), 0 ≤ R → 0 < s →
        let N : ℕ := ⌈R / s⌉₊
        let I : Finset ℤ := Finset.Icc (-(N : ℤ)) (N : ℤ)
        (∀ y : ℝ, |y| ≤ R → ⌊y / s⌋ ∈ I) ∧ ((I.card : ℝ) ≤ 2 * (R / s) + 3) := by
      intro R s hR hs
      dsimp only
      let N : ℕ := ⌈R / s⌉₊
      let I : Finset ℤ := Finset.Icc (-(N : ℤ)) (N : ℤ)
      have hRs_nn : 0 ≤ R / s := div_nonneg hR hs.le
      have hN_ge : R / s ≤ (N : ℝ) := Nat.le_ceil (R / s)
      have hN_lt : (N : ℝ) < R / s + 1 := Nat.ceil_lt_add_one hRs_nn
      refine ⟨?_, ?_⟩
      · intro y hy
        obtain ⟨hylo, hyhi⟩ := abs_le.mp hy
        rw [Finset.mem_Icc]
        constructor
        · rw [Int.le_floor]
          have h1 : -(R / s) ≤ y / s := by rw [← neg_div]; exact div_le_div_of_nonneg_right hylo hs.le
          have h2 : ((-(N : ℤ) : ℤ) : ℝ) = -(N : ℝ) := by push_cast; ring
          linarith only [hN_ge, h1, h2]
        · have h1 : (⌊y / s⌋ : ℝ) ≤ R / s := le_trans (Int.floor_le _) (div_le_div_of_nonneg_right hyhi hs.le)
          have h2 : (⌊y / s⌋ : ℝ) ≤ ((N : ℤ) : ℝ) := by push_cast; linarith only [h1, hN_ge]
          exact Int.cast_le.mp h2
      · have hcard : I.card = 2 * N + 1 := by
          dsimp [I]
          rw [Int.card_Icc]
          omega
        rw [hcard]
        push_cast
        linarith only [hN_lt]
    have h_col_ent : ∀ d : Fin N_D,
        (∑ o : Fin N_O, -(q o d * Real.log (q o d / q_D d))) / ell ≤
          q_D d * (Real.log C_fib / ell + 4 * u_t - 2 * b_D d - 2 * a_D d) := by
      intro d
      rcases eq_or_lt_of_le (hqD_nn d) with hqD0 | hqD_pos
      · have hqo0 : ∀ o, q o d = 0 := fun o =>
          le_antisymm
            (le_trans (Finset.single_le_sum (fun o' _ => hq_nn o' d) (Finset.mem_univ o)) hqD0.symm.le)
            (hq_nn o d)
        simp [hqo0, ← hqD0]
      · obtain ⟨hb0, hba, ha_max, hrD_lt, he_norm⟩ := hd_bounds d
        have ha_ut : a_D d ≤ u_t := le_trans ha_max (min_le_right _ _)
        have hb_ut : b_D d ≤ u_t := le_trans hba ha_ut
        let e := e_D d
        have he_sq : e 0 ^ 2 + e 1 ^ 2 = 1 := by
          have h1 := h_norm_sq2 e
          rw [he_norm, one_pow] at h1
          exact h1.symm
        let Φ_d : Fin N_O → (ℤ × ℤ) × (ℤ × ℤ) := fun o =>
          ((⌊inner ℝ (V_O o - V_D d) e / s_V⌋, ⌊inner ℝ (V_O o - V_D d) (perp2D e) / s_V⌋),
           (⌊inner ℝ (X_O o - X_D d) e / s_X⌋, ⌊inner ℝ (X_O o - X_D d) (perp2D e) / s_X⌋))
        let S_d : Finset (Fin N_O) := Finset.univ.filter (fun o => 0 < q o d)
        have h_fib_Nmult : ∀ k : (ℤ × ℤ) × (ℤ × ℤ),
            (S_d.filter (fun o => Φ_d o = k)).card ≤ cls.N_mult := by
          intro k
          let cV1 := ((k.1.1 : ℝ) + 1 / 2) * s_V
          let cV2 := ((k.1.2 : ℝ) + 1 / 2) * s_V
          let cX1 := ((k.2.1 : ℝ) + 1 / 2) * s_X
          let cX2 := ((k.2.2 : ℝ) + 1 / 2) * s_X
          let v₀ := V_D d + cV1 • e + cV2 • perp2D e
          let x₀ := X_D d + cX1 • e + cX2 • perp2D e
          have h_sub_pack : (S_d.filter (fun o => Φ_d o = k)) ⊆
              @Finset.filter (Fin N_O)
                (fun o => r_O o = r_D d ∧ ‖V_O o - v₀‖ ≤ ρ_obs ∧ ‖X_O o - x₀‖ ≤ σ_obs)
                (fun _ => Classical.propDecidable _) Finset.univ := by
            intro o ho
            rw [Finset.mem_filter] at ho
            rw [@Finset.mem_filter _ _ (fun _ => Classical.propDecidable _)]
            obtain ⟨hoS, hΦk⟩ := ho
            rw [Finset.mem_filter] at hoS
            have hq_od : 0 < q o d := hoS.2
            have hr_eq : r_O o = r_D d := (hq_supp o d hq_od).2.1
            have hk1 : ⌊inner ℝ (V_O o - V_D d) e / s_V⌋ = k.1.1 := congrArg (fun p => p.1.1) hΦk
            have hk2 : ⌊inner ℝ (V_O o - V_D d) (perp2D e) / s_V⌋ = k.1.2 := congrArg (fun p => p.1.2) hΦk
            have hk3 : ⌊inner ℝ (X_O o - X_D d) e / s_X⌋ = k.2.1 := congrArg (fun p => p.2.1) hΦk
            have hk4 : ⌊inner ℝ (X_O o - X_D d) (perp2D e) / s_X⌋ = k.2.2 := congrArg (fun p => p.2.2) hΦk
            have h_in_shift : ∀ (w z₀ : EuclideanSpace ℝ (Fin 2)) (c₁ c₂ : ℝ),
                inner ℝ (w - (z₀ + c₁ • e + c₂ • perp2D e)) e = inner ℝ (w - z₀) e - c₁ ∧
                inner ℝ (w - (z₀ + c₁ • e + c₂ • perp2D e)) (perp2D e) = inner ℝ (w - z₀) (perp2D e) - c₂ := by
              intro w z₀ c₁ c₂
              simp only [h_inner2, h_perp0, h_perp1, PiLp.sub_apply, PiLp.add_apply, PiLp.smul_apply, smul_eq_mul]
              constructor
              · calc (w 0 - (z₀ 0 + c₁ * e 0 + c₂ * -e 1)) * e 0 + (w 1 - (z₀ 1 + c₁ * e 1 + c₂ * e 0)) * e 1
                    = (w 0 - z₀ 0) * e 0 + (w 1 - z₀ 1) * e 1 - c₁ * (e 0 ^ 2 + e 1 ^ 2) := by ring
                  _ = (w 0 - z₀ 0) * e 0 + (w 1 - z₀ 1) * e 1 - c₁ := by rw [he_sq, mul_one]
              · calc (w 0 - (z₀ 0 + c₁ * e 0 + c₂ * -e 1)) * -e 1 + (w 1 - (z₀ 1 + c₁ * e 1 + c₂ * e 0)) * e 0
                    = (w 0 - z₀ 0) * -e 1 + (w 1 - z₀ 1) * e 0 - c₂ * (e 0 ^ 2 + e 1 ^ 2) := by ring
                  _ = (w 0 - z₀ 0) * -e 1 + (w 1 - z₀ 1) * e 0 - c₂ := by rw [he_sq, mul_one]
            have hv1 : |inner ℝ (V_O o - v₀) e| ≤ s_V / 2 := by
              rw [(h_in_shift (V_O o) (V_D d) cV1 cV2).1]
              dsimp [cV1]; rw [← hk1]; exact h_mid_abs _ s_V hs_V_pos
            have hv2 : |inner ℝ (V_O o - v₀) (perp2D e)| ≤ s_V / 2 := by
              rw [(h_in_shift (V_O o) (V_D d) cV1 cV2).2]
              dsimp [cV2]; rw [← hk2]; exact h_mid_abs _ s_V hs_V_pos
            have hx1 : |inner ℝ (X_O o - x₀) e| ≤ s_X / 2 := by
              rw [(h_in_shift (X_O o) (X_D d) cX1 cX2).1]
              dsimp [cX1]; rw [← hk3]; exact h_mid_abs _ s_X hs_X_pos
            have hx2 : |inner ℝ (X_O o - x₀) (perp2D e)| ≤ s_X / 2 := by
              rw [(h_in_shift (X_O o) (X_D d) cX1 cX2).2]
              dsimp [cX2]; rw [← hk4]; exact h_mid_abs _ s_X hs_X_pos
            have hv_norm : ‖V_O o - v₀‖ ≤ ρ_obs := by
              have hp := h_parseval e (V_O o - v₀) he_norm
              have hs1 : inner ℝ (V_O o - v₀) e ^ 2 ≤ (s_V / 2) ^ 2 := by
                rw [← sq_abs]; exact pow_le_pow_left₀ (abs_nonneg _) hv1 2
              have hs2 : inner ℝ (V_O o - v₀) (perp2D e) ^ 2 ≤ (s_V / 2) ^ 2 := by
                rw [← sq_abs]; exact pow_le_pow_left₀ (abs_nonneg _) hv2 2
              have hsV_sq_nn : 0 ≤ s_V ^ 2 := sq_nonneg s_V
              have hhalf_sq : (s_V / 2) ^ 2 + (s_V / 2) ^ 2 = s_V ^ 2 / 2 := by ring
              have hsq : ‖V_O o - v₀‖ ^ 2 ≤ ρ_obs ^ 2 := by
                change _ at hs1 hs2
                have hsum : ‖V_O o - v₀‖ ^ 2 ≤ s_V ^ 2 / 2 := by linarith only [hp, hs1, hs2, hhalf_sq]
                have hle2 : s_V ^ 2 / 2 ≤ ρ_obs ^ 2 := by change s_V ^ 2 / 2 ≤ s_V ^ 2; linarith only [hsV_sq_nn]
                linarith only [hsum, hle2]
              by_contra hlt
              push Not at hlt
              have hgt : ρ_obs ^ 2 < ‖V_O o - v₀‖ ^ 2 := pow_lt_pow_left₀ hlt hs_V_pos.le (by omega)
              linarith only [hsq, hgt]
            have hx_norm : ‖X_O o - x₀‖ ≤ σ_obs := by
              have hp := h_parseval e (X_O o - x₀) he_norm
              have hs1 : inner ℝ (X_O o - x₀) e ^ 2 ≤ (s_X / 2) ^ 2 := by
                rw [← sq_abs]; exact pow_le_pow_left₀ (abs_nonneg _) hx1 2
