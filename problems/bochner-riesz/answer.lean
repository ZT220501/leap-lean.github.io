        have h_rk_le : ρ₀ ^ k ≤ 1 := pow_le_one₀ hρ₀_pos.le hρ₀_le_one
        calc (lam_sys * ρ₀) * |iteratedDeriv m (f_vec P₀) t|
            ≤ (lam_sys * ρ₀) * (‖P₀‖ * (A ^ (m + 1) * ((m.factorial : ℝ) ^ 3)) * ρ₀ ^ m) :=
              mul_le_mul_of_nonneg_left h_bd hlam_ρ₀_pos.le
          _ = (lam_sys * ρ₀ ^ 2) * (ρ₀ ^ k * ‖P₀‖ * (A ^ (m + 1) * ((m.factorial : ℝ) ^ 3))) := by
              rw [h_pow]; ring
          _ = (ρ₀ ^ k * ‖P₀‖) * (A ^ (m + 1) * ((m.factorial : ℝ) ^ 3)) := by
              rw [hlam_ρ₀_sq, one_mul, mul_assoc]
          _ ≤ (1 * (B_sys + R_dom + 4)) * (A ^ (m + 1) * ((m.factorial : ℝ) ^ 3)) := by
              refine mul_le_mul_of_nonneg_right ?_ (by positivity)
              exact mul_le_mul h_rk_le hP₀_norm (norm_nonneg P₀) zero_le_one
          _ = (B_sys + R_dom + 4) * A ^ (m + 1) * ((m.factorial : ℝ) ^ 3) := by ring
      have h_term2 : |c * iteratedDeriv m (fun s : ℝ => s * f_vec e s) t| ≤
          4 * A ^ (m + 1) * ((m.factorial : ℝ) ^ 3) +
            (m : ℝ) * A ^ m * (((m - 1).factorial : ℝ) ^ 3) := by
        have h_id_eq : iteratedDeriv m (fun s : ℝ => s * f_vec e s) t =
            t * iteratedDeriv m (f_vec e) t + (m : ℝ) * iteratedDeriv k (f_vec e) t := by
          have h1 := h_iter_id_mul (f_vec e) hfe_cd k t
          rwa [hk_eq] at h1
        have hfe_m : |iteratedDeriv m (f_vec e) t| ≤ A ^ (m + 1) * ((m.factorial : ℝ) ^ 3) := by
          have h1 := hfe_bd m t
          have hr_le : ρ₀ ^ m ≤ 1 := pow_le_one₀ hρ₀_pos.le hρ₀_le_one
          rw [he, one_mul] at h1
          exact le_trans h1 (mul_le_of_le_one_right (by positivity) hr_le)
        have hfe_k : |iteratedDeriv k (f_vec e) t| ≤
            A ^ m * (((m - 1).factorial : ℝ) ^ 3) := by
          have h1 := hfe_bd k t
          have hr_le : ρ₀ ^ k ≤ 1 := pow_le_one₀ hρ₀_pos.le hρ₀_le_one
          rw [he, one_mul] at h1
          have h2 : |iteratedDeriv k (f_vec e) t| ≤ A ^ (k + 1) * ((k.factorial : ℝ) ^ 3) :=
            le_trans h1 (mul_le_of_le_one_right (by positivity) hr_le)
