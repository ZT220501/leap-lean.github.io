      have hi_le_φ : idx ⟨x.1, hQ x.1 x.2⟩ ≤ φ k :=
        le_trans hi_le_N (le_trans hk_N (hφ_ge k))
      exact ((h_st_spec (φ k)).2.2.2.1 (idx ⟨x.1, hQ x.1 x.2⟩) hi_le_φ).2.2 η hη0 hη1
    choose B_u B_c hB_spec using h_bad_ex
    let B_all : Finset (Fin (N_ω k)) := Q_fin.attach.biUnion (fun x => B_u x ∪ B_c x)
    let S_pos : Finset (Fin (N_ω k)) :=
      @Finset.filter (Fin (N_ω k)) (fun ω => 0 < π_seq k ω)
        (fun _ => Classical.propDecidable _) Finset.univ
    let E_good : Finset (Fin (N_ω k)) := S_pos \ B_all
    have h_law_k := h_law_seq k
    have h_sum_union_le : ∀ A B : Finset (Fin (N_ω k)),
        (∑ ω ∈ A ∪ B, π_seq k ω) ≤ (∑ ω ∈ A, π_seq k ω) + (∑ ω ∈ B, π_seq k ω) := by
      intro A B
      have h_eq := Finset.sum_union_inter (s₁ := A) (s₂ := B) (f := π_seq k)
      have h_nn : 0 ≤ ∑ ω ∈ A ∩ B, π_seq k ω := Finset.sum_nonneg (fun ω _ => h_law_k.1 ω)
      linarith
    have h_biUnion_le : ∀ s : Finset { L_l // L_l ∈ Q_fin },
        (∑ ω ∈ s.biUnion (fun x => B_u x ∪ B_c x), π_seq k ω) ≤ ∑ _x ∈ s, (4 * η) := by
      letI : DecidableEq { L_l // L_l ∈ Q_fin } := Classical.typeDecidableEq _
      intro s
      induction s using Finset.induction with
      | empty => simp
      | insert a s ha ih =>
        rw [Finset.biUnion_insert, Finset.sum_insert ha]
        have hu := h_sum_union_le (B_u a ∪ B_c a) (s.biUnion (fun x => B_u x ∪ B_c x))
        have hab := h_sum_union_le (B_u a) (B_c a)
        linarith [(hB_spec a).1, (hB_spec a).2.1, ih]
    have h_Spos_sum : ∑ ω ∈ S_pos, π_seq k ω = 1 := by
      rw [← h_law_k.2.1]
      dsimp only [S_pos]
      rw [Finset.sum_filter]
      refine Finset.sum_congr rfl (fun ω _ => ?_)
      by_cases hω : 0 < π_seq k ω
      · exact if_pos hω
      · rw [if_neg hω]
