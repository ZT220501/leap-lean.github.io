        16 * ((S_per_loc : ℝ) ^ 2) * m_site j o := by
      have hwin := hps.2.2.2.2.2.2.2.2.2
      have h4S_nn : (0 : ℝ) ≤ 4 * ((S_per_loc : ℝ) ^ 2) := by positivity
      calc generalPacketObsMass ε H_P t lam_sys m_t Φ₀ f (r_O o) (V_O o) (X_O o) (ψ_O o)
