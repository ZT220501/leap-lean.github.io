    have h_HO_0 : ∑ o : Fin N_O, -(p_cO o * Real.log (p_cO o)) ≤ Real.log (N_O : ℝ) :=
      h_card_ent_one (Finset.univ : Finset (Fin N_O)) p_cO (N_O : ℝ) (fun o _ => hp_cO_nn o)
