          have hX_in_ball : ∀ kx ∈ X_j, ‖gridPt2D σ_r kx - x₀‖ ≤ C_cov * R_tr * σ_r := by
            intro kx hkx
            obtain ⟨α, hα_Bj, hkx_eq⟩ := Finset.mem_image.mp hkx
            obtain ⟨hα_bdry, hj_eq⟩ := Finset.mem_filter.mp hα_Bj
            have hα_near : α ∈ S_near := (Finset.mem_sdiff.mp hα_bdry).1
            have hX_bd := (hS_in_near α hα_near).2
            have h_id : gridPt2D σ_r kx - x₀ =
