    exact ⟨χ₀, ψ, a, M, Φ, hχ₀_cont, hχ₀_supp, ha_smooth, ha_supp, ha_deriv, hΦ_props, ha_eval⟩
  obtain ⟨χ₀, ψ, a_pos, M, Φ, hχ₀_cont, hχ₀_supp, ha_pos_smooth, ha_pos_supp,
