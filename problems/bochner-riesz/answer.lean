        IsValidPacketEnv cls ε H_P L lam_sys Φ₀ ζ₀ f₁ ∧
        (∫ v, ‖f₁ v‖ ^ 2 = 1) ∧
        0 ≤ generalPacketRootScore ε H_P L cls.R_dom γ lam_sys Φ₀ f₁ ∧
        (∀ ν κ : ℝ,
          HasRootWidthGap ν κ ε H_P L cls.R_dom γ lam_sys Φ₀ f ↔
          HasRootWidthGap ν κ ε H_P L cls.R_dom γ lam_sys Φ₀ f₁) ∧
        (∀ (t : ℝ) (m_t N_O N_D : ℕ) (r_O : Fin N_O → ℕ)
          (V_O X_O : Fin N_O → EuclideanSpace ℝ (Fin 2))
          (ψ_O : Fin N_O → EuclideanSpace ℝ (Fin 2) → ℂ) (b_D a_D : Fin N_D → ℝ)
          (r_D : Fin N_D → ℕ) (e_D V_D X_D : Fin N_D → EuclideanSpace ℝ (Fin 2))
          (p : Fin N_O → Fin N_D → ℝ),
          (IsAdmissiblePacketLaw ε H_P L t cls.B_sys cls.R_win cls.N_mult cls.M_win
             lam_sys m_t Φ₀ f N_O N_D r_O V_O X_O ψ_O b_D a_D r_D e_D V_D X_D p ↔
           IsAdmissiblePacketLaw ε H_P L t cls.B_sys cls.R_win cls.N_mult cls.M_win
             lam_sys m_t Φ₀ f₁ N_O N_D r_O V_O X_O ψ_O b_D a_D r_D e_D V_D X_D p) ∧
          (IsAdmissiblePacketLaw ε H_P L t cls.B_sys cls.R_win cls.N_mult cls.M_win
             lam_sys m_t Φ₀ f N_O N_D r_O V_O X_O ψ_O b_D a_D r_D e_D V_D X_D p →
           generalPacketScore ε γ H_P t lam_sys m_t Φ₀ f₁ N_O N_D r_O V_O X_O ψ_O b_D a_D p -
             generalPacketRootScore ε H_P L cls.R_dom γ lam_sys Φ₀ f₁ =
           generalPacketScore ε γ H_P t lam_sys m_t Φ₀ f N_O N_D r_O V_O X_O ψ_O b_D a_D p -
             generalPacketRootScore ε H_P L cls.R_dom γ lam_sys Φ₀ f)) ∧
        (∀ (cls' : PacketBoundClass) (t h C_cell : ℝ) (d_dim : ℕ) (δ_def k_cred α_cred : ℝ),
          IsCutChainState γ cls' ε H_P L t h lam_sys C_cell d_dim Φ₀ f₁ δ_def k_cred α_cred ↔
          IsCutChainState γ cls' ε H_P L t h lam_sys C_cell d_dim Φ₀ f δ_def k_cred α_cred) := by
    intro cls ε H_P L lam_sys Φ₀ ζ₀ f henv
    obtain ⟨hε₀, hε₁, hHP₀, hHP_K, hL₀, hL_K, hlam_lo, hlam_hi,
      hphase, hf_meas, hf_supp, hf_l2, hf_pos⟩ := henv
    have hell_pos : 0 < Real.log (ε⁻¹) := by
      apply Real.log_pos
      rw [one_lt_inv₀ hε₀]
      linarith
    let ell := Real.log (ε⁻¹)
    let M_f := ∫ v : EuclideanSpace ℝ (Fin 2), ‖f v‖ ^ 2
    have hMf_pos : 0 < M_f := hf_pos
    let c : ℝ := (Real.sqrt M_f)⁻¹
    have hc_pos : 0 < c := inv_pos.mpr (Real.sqrt_pos.mpr hMf_pos)
    have hc_sq : c ^ 2 = M_f⁻¹ := by
      dsimp [c]
      rw [inv_pow, Real.sq_sqrt hMf_pos.le]
    let f₁ : EuclideanSpace ℝ (Fin 2) → ℂ := fun v => (c : ℂ) * f v
    have hf₁_meas : MeasureTheory.AEStronglyMeasurable f₁ MeasureTheory.volume :=
      hf_meas.const_mul (c : ℂ)
    have hf₁_supp : ∀ v : EuclideanSpace ℝ (Fin 2), cls.R_dom ≤ ‖v‖ → f₁ v = 0 := by
      intro v hv
      dsimp [f₁]
      rw [hf_supp v hv, mul_zero]
    have hf₁_l2 : MeasureTheory.MemLp f₁ 2 MeasureTheory.volume :=
      hf_l2.const_mul (c : ℂ)
    have hf₁_norm : ∫ v : EuclideanSpace ℝ (Fin 2), ‖f₁ v‖ ^ 2 = 1 := by
      have h_pt : (fun v : EuclideanSpace ℝ (Fin 2) => ‖f₁ v‖ ^ 2) =
          fun v => M_f⁻¹ * ‖f v‖ ^ 2 := by
        ext v
        dsimp [f₁]
        rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hc_pos, mul_pow, hc_sq]
      rw [h_pt, MeasureTheory.integral_const_mul]
      exact inv_mul_cancel₀ hMf_pos.ne'
    have hf₁_env : IsValidPacketEnv cls ε H_P L lam_sys Φ₀ ζ₀ f₁ :=
      ⟨hε₀, hε₁, hHP₀, hHP_K, hL₀, hL_K, hlam_lo, hlam_hi,
        hphase, hf₁_meas, hf₁_supp, hf₁_l2, by rw [hf₁_norm]; exact zero_lt_one⟩
    have h_int_of_l2 : ∀ g : EuclideanSpace ℝ (Fin 2) → ℂ,
        MeasureTheory.AEStronglyMeasurable g MeasureTheory.volume →
        (∀ v, cls.R_dom ≤ ‖v‖ → g v = 0) →
        MeasureTheory.MemLp g 2 MeasureTheory.volume →
        MeasureTheory.Integrable g MeasureTheory.volume := by
      intro g hg_meas hg_supp hg_l2
      let B := Metric.closedBall (0 : EuclideanSpace ℝ (Fin 2)) cls.R_dom
      have hB_meas : MeasurableSet B := measurableSet_closedBall
      have h_ind_int : MeasureTheory.Integrable (B.indicator (fun _ => (1 / 2 : ℝ)))
          MeasureTheory.volume :=
        (MeasureTheory.integrableOn_const (hs := MeasureTheory.measure_closedBall_lt_top.ne)).integrable_indicator hB_meas
      have h_sq_int : MeasureTheory.Integrable (fun v => (1 / 2 : ℝ) * ‖g v‖ ^ 2)
          MeasureTheory.volume :=
        ((MeasureTheory.memLp_two_iff_integrable_sq_norm hg_meas).mp hg_l2).const_mul (1 / 2 : ℝ)
      refine (h_sq_int.add h_ind_int).mono' hg_meas (Filter.Eventually.of_forall (fun v => ?_))
      dsimp only [Pi.add_apply]
      by_cases hv : v ∈ B
      · rw [Set.indicator_of_mem hv]
        have hsq : 0 ≤ (‖g v‖ - 1) ^ 2 := sq_nonneg _
        linarith
      · rw [Set.indicator_of_notMem hv]
        have h_out : cls.R_dom ≤ ‖v‖ := by
          rw [Metric.mem_closedBall, dist_zero_right] at hv
          linarith
        rw [hg_supp v h_out, norm_zero]
        positivity
    have h_zero_win : IsCanonicalRootWindow (fun _ => 0) := by
      refine ⟨fun k => contDiff_const, fun _ _ => rfl, fun k z => ?_⟩
      simp only [iteratedFDeriv_fun_zero, Pi.zero_apply, norm_zero]
      positivity
    let rootMassSet (g : EuclideanSpace ℝ (Fin 2) → ℂ) (o : (ℤ × ℤ) × (ℤ × ℤ)) : Set ℝ :=
      let ρ₀ := (Real.sqrt lam_sys)⁻¹
      let V := gridPt2D ρ₀ o.1
      let X := gridPt2D ρ₀ o.2
      { m : ℝ | ∃ ψ : EuclideanSpace ℝ (Fin 2) → ℂ,
        IsCanonicalRootWindow ψ ∧
        m = ‖(ρ₀⁻¹ : ℂ) * ∫ v : EuclideanSpace ℝ (Fin 2),
          g v * ψ (ρ₀⁻¹ • (v - V)) *
            Complex.exp (Complex.I * ((lam_sys * Φ₀ (1 / 2, X, v) : ℝ) : ℂ))‖ ^ 2 }
    have h_root_bdd : ∀ g : EuclideanSpace ℝ (Fin 2) → ℂ,
        MeasureTheory.Integrable g MeasureTheory.volume →
        ∃ M_sup : ℝ, 0 ≤ M_sup ∧ ∀ o : (ℤ × ℤ) × (ℤ × ℤ),
          BddAbove (rootMassSet g o) ∧
          canonicalRootMass lam_sys Φ₀ g o ≤ M_sup := by
      intro g hg_int
      let ρ₀ := (Real.sqrt lam_sys)⁻¹
      let I_g := ∫ v : EuclideanSpace ℝ (Fin 2), ‖g v‖
      have hIg_nn : 0 ≤ I_g := MeasureTheory.integral_nonneg (fun v => norm_nonneg _)
      let M_sup := (|ρ₀⁻¹| * (100 * I_g)) ^ 2
      refine ⟨M_sup, sq_nonneg _, fun o => ?_⟩
      have h_ub : ∀ m ∈ rootMassSet g o, m ≤ M_sup := by
        intro m ⟨ψ, hψ, hm⟩
        rw [hm]
        have h_int_bound : ‖∫ v : EuclideanSpace ℝ (Fin 2),
            g v * ψ (ρ₀⁻¹ • (v - gridPt2D ρ₀ o.1)) *
              Complex.exp (Complex.I * ((lam_sys * Φ₀ (1 / 2, gridPt2D ρ₀ o.2, v) : ℝ) : ℂ))‖ ≤
            100 * I_g := by
          calc ‖∫ v : EuclideanSpace ℝ (Fin 2),
                g v * ψ (ρ₀⁻¹ • (v - gridPt2D ρ₀ o.1)) *
                  Complex.exp (Complex.I * ((lam_sys * Φ₀ (1 / 2, gridPt2D ρ₀ o.2, v) : ℝ) : ℂ))‖
              ≤ ∫ v : EuclideanSpace ℝ (Fin 2),
                  ‖g v * ψ (ρ₀⁻¹ • (v - gridPt2D ρ₀ o.1)) *
                    Complex.exp (Complex.I * ((lam_sys * Φ₀ (1 / 2, gridPt2D ρ₀ o.2, v) : ℝ) : ℂ))‖ :=
                MeasureTheory.norm_integral_le_integral_norm _
            _ ≤ ∫ v : EuclideanSpace ℝ (Fin 2), 100 * ‖g v‖ := by
                refine MeasureTheory.integral_mono_of_nonneg
                  (Filter.Eventually.of_forall (fun _ => norm_nonneg _))
                  (hg_int.norm.const_mul 100)
                  (Filter.Eventually.of_forall (fun v => ?_))
                dsimp only
                rw [norm_mul, norm_mul, Complex.norm_exp_I_mul_ofReal, mul_one]
                have hψ0 := hψ.2.2 0 (ρ₀⁻¹ • (v - gridPt2D ρ₀ o.1))
                rw [norm_iteratedFDeriv_zero] at hψ0
                have hψ_le : ‖ψ (ρ₀⁻¹ • (v - gridPt2D ρ₀ o.1))‖ ≤ 100 := by
                  simpa using hψ0
                nlinarith [norm_nonneg (g v)]
            _ = 100 * I_g := MeasureTheory.integral_const_mul 100 _
        have h_prod : ‖(ρ₀⁻¹ : ℂ) * ∫ v : EuclideanSpace ℝ (Fin 2),
            g v * ψ (ρ₀⁻¹ • (v - gridPt2D ρ₀ o.1)) *
              Complex.exp (Complex.I * ((lam_sys * Φ₀ (1 / 2, gridPt2D ρ₀ o.2, v) : ℝ) : ℂ))‖ ≤
            |ρ₀⁻¹| * (100 * I_g) := by
          rw [norm_mul, norm_inv, Complex.norm_real, Real.norm_eq_abs, ← abs_inv]
          exact mul_le_mul_of_nonneg_left h_int_bound (abs_nonneg _)
        exact pow_le_pow_left₀ (norm_nonneg _) h_prod 2
      have h_bdd : BddAbove (rootMassSet g o) := ⟨M_sup, h_ub⟩
      have h_ne : (rootMassSet g o).Nonempty := ⟨_, ⟨fun _ => 0, h_zero_win, rfl⟩⟩
      exact ⟨h_bdd, csSup_le h_ne h_ub⟩
    have hf_int := h_int_of_l2 f hf_meas hf_supp hf_l2
    have hf₁_int := h_int_of_l2 f₁ hf₁_meas hf₁_supp hf₁_l2
    obtain ⟨M_sup_f, _, h_rf⟩ := h_root_bdd f hf_int
    obtain ⟨M_sup_f₁, _, h_rf₁⟩ := h_root_bdd f₁ hf₁_int
    have h_obs_scale : ∀ (t : ℝ) (m_t : ℕ) (r_idx : ℕ)
        (V_o X_o : EuclideanSpace ℝ (Fin 2)) (ψ_o : EuclideanSpace ℝ (Fin 2) → ℂ),
        generalPacketObsMass ε H_P t lam_sys m_t Φ₀ f₁ r_idx V_o X_o ψ_o =
        M_f⁻¹ * generalPacketObsMass ε H_P t lam_sys m_t Φ₀ f r_idx V_o X_o ψ_o := by
      intro t m_t r_idx V_o X_o ψ_o
      unfold generalPacketObsMass
      dsimp only [f₁]
      let ρ_obs : ℝ := ε ^ ((H_P - t) / 2)
      let C_box : ℝ := ((r_idx : ℝ) + 1 / 2) * ((2 : ℝ) ^ m_t)⁻¹
      have h_pull : (fun v : EuclideanSpace ℝ (Fin 2) =>
          ((c : ℂ) * f v) * ψ_o (ρ_obs⁻¹ • (v - V_o)) *
            Complex.exp (Complex.I * ((lam_sys * Φ₀ (C_box, X_o, v) : ℝ) : ℂ))) =
        fun v => (c : ℂ) * (f v * ψ_o (ρ_obs⁻¹ • (v - V_o)) *
            Complex.exp (Complex.I * ((lam_sys * Φ₀ (C_box, X_o, v) : ℝ) : ℂ))) := by
        ext v; ring
      have h_comm : ∀ z w : ℂ, z * ((c : ℂ) * w) = (c : ℂ) * (z * w) := fun z w => by ring
      change ‖(ρ_obs⁻¹ : ℂ) * ∫ v, ((c : ℂ) * f v) * ψ_o (ρ_obs⁻¹ • (v - V_o)) *
          Complex.exp (Complex.I * ((lam_sys * Φ₀ (C_box, X_o, v) : ℝ) : ℂ))‖ ^ 2 =
        M_f⁻¹ * ‖(ρ_obs⁻¹ : ℂ) * ∫ v, f v * ψ_o (ρ_obs⁻¹ • (v - V_o)) *
          Complex.exp (Complex.I * ((lam_sys * Φ₀ (C_box, X_o, v) : ℝ) : ℂ))‖ ^ 2
      rw [h_pull, MeasureTheory.integral_const_mul, h_comm,
        norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hc_pos, mul_pow, hc_sq]
    have h_root_scale : ∀ o : (ℤ × ℤ) × (ℤ × ℤ),
        canonicalRootMass lam_sys Φ₀ f₁ o = M_f⁻¹ * canonicalRootMass lam_sys Φ₀ f o := by
      intro o
      have h_scale_le : ∀ (g₁ g₂ : EuclideanSpace ℝ (Fin 2) → ℂ) (a : ℝ),
          0 < a → (∀ v, g₁ v = (a : ℂ) * g₂ v) →
          BddAbove (rootMassSet g₂ o) →
          canonicalRootMass lam_sys Φ₀ g₁ o ≤ a ^ 2 * canonicalRootMass lam_sys Φ₀ g₂ o := by
        intro g₁ g₂ a ha h_eq hbdd₂
        change sSup (rootMassSet g₁ o) ≤ a ^ 2 * sSup (rootMassSet g₂ o)
        refine csSup_le ⟨_, ⟨fun _ => 0, h_zero_win, rfl⟩⟩ ?_
        intro m ⟨ψ, hψ, hm⟩
        let ρ₀ := (Real.sqrt lam_sys)⁻¹
        have h_pull : (fun v : EuclideanSpace ℝ (Fin 2) =>
            g₁ v * ψ (ρ₀⁻¹ • (v - gridPt2D ρ₀ o.1)) *
              Complex.exp (Complex.I * ((lam_sys * Φ₀ (1 / 2, gridPt2D ρ₀ o.2, v) : ℝ) : ℂ))) =
          fun v => (a : ℂ) * (g₂ v * ψ (ρ₀⁻¹ • (v - gridPt2D ρ₀ o.1)) *
              Complex.exp (Complex.I * ((lam_sys * Φ₀ (1 / 2, gridPt2D ρ₀ o.2, v) : ℝ) : ℂ))) := by
          ext v; rw [h_eq v]; ring
        have h_comm : ∀ z w : ℂ, z * ((a : ℂ) * w) = (a : ℂ) * (z * w) := fun z w => by ring
        have hm_eq : m = a ^ 2 * ‖(ρ₀⁻¹ : ℂ) * ∫ v : EuclideanSpace ℝ (Fin 2),
            g₂ v * ψ (ρ₀⁻¹ • (v - gridPt2D ρ₀ o.1)) *
              Complex.exp (Complex.I * ((lam_sys * Φ₀ (1 / 2, gridPt2D ρ₀ o.2, v) : ℝ) : ℂ))‖ ^ 2 := by
          rw [hm, h_pull, MeasureTheory.integral_const_mul, h_comm,
            norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos ha, mul_pow]
        rw [hm_eq]
        exact mul_le_mul_of_nonneg_left (le_csSup hbdd₂ ⟨ψ, hψ, rfl⟩) (sq_nonneg a)
      have h1 := h_scale_le f₁ f c hc_pos (fun _ => rfl) (h_rf o).1
      have h2 := h_scale_le f f₁ c⁻¹ (inv_pos.mpr hc_pos)
        (fun v => by dsimp [f₁]; rw [← mul_assoc]; norm_cast; rw [inv_mul_cancel₀ hc_pos.ne', Complex.ofReal_one, one_mul])
        (h_rf₁ o).1
      rw [hc_sq] at h1
      have h2' : M_f⁻¹ * canonicalRootMass lam_sys Φ₀ f o ≤ canonicalRootMass lam_sys Φ₀ f₁ o := by
        have hc_inv_sq : (c⁻¹) ^ 2 = M_f := by
          rw [inv_pow, hc_sq, inv_inv]
        rw [hc_inv_sq] at h2
        exact (inv_mul_le_iff₀ hMf_pos).mpr (by linarith)
      exact le_antisymm h1 h2'
    have h_neg_mul_log_le : ∀ u : ℝ, 0 ≤ u → -(u * Real.log u) ≤ 1 := by
      intro u hu
      rcases eq_or_lt_of_le hu with rfl | hu_pos
      · simp
      · have h1 := Real.log_le_sub_one_of_pos (inv_pos.mpr hu_pos)
        rw [Real.log_inv] at h1
        have h2 := mul_le_mul_of_nonneg_left h1 hu_pos.le
        rw [mul_sub, mul_inv_cancel₀ hu_pos.ne', mul_one] at h2
        linarith
    let rootScoreSet (R'_dom : ℝ) (g : EuclideanSpace ℝ (Fin 2) → ℂ) : Set ℝ :=
      let O₀ := rootSiteFinset lam_sys R'_dom
      let ρ₀ := (Real.sqrt lam_sys)⁻¹
      { (3 / 2 : ℝ) * (Real.log (∫ v : EuclideanSpace ℝ (Fin 2), ‖g v‖ ^ 2) / ell) } ∪
        { s : ℝ | ∃ (N_D : ℕ)
            (b a : Fin N_D → ℝ)
            (e_dir V_c X_c : Fin N_D → EuclideanSpace ℝ (Fin 2))
            (p : ((ℤ × ℤ) × (ℤ × ℤ)) → Fin N_D → ℝ),
            (∀ d : Fin N_D, 0 ≤ b d ∧ b d ≤ a d ∧ a d ≤ min L (H_P / 2) ∧ ‖e_dir d‖ = 1) ∧
            (∀ o d, 0 ≤ p o d) ∧
            (∀ o d, o ∉ O₀ → p o d = 0) ∧
            (∑ o ∈ O₀, ∑ d : Fin N_D, p o d = 1) ∧
            (∀ o ∈ O₀, ∀ d : Fin N_D, 0 < p o d →
              0 < canonicalRootMass lam_sys Φ₀ g o ∧
              |inner ℝ (gridPt2D ρ₀ o.1 - V_c d) (e_dir d)| ≤ 10 * ε ^ (b d) ∧
              |inner ℝ (gridPt2D ρ₀ o.1 - V_c d) (perp2D (e_dir d))| ≤ 10 * ε ^ (a d) ∧
              |inner ℝ (gridPt2D ρ₀ o.2 - X_c d) (e_dir d)| ≤ 10 * ε ^ (b d) ∧
              |inner ℝ (gridPt2D ρ₀ o.2 - X_c d) (perp2D (e_dir d))| ≤ 10 * ε ^ (a d)) ∧
            (let p_O := fun o => ∑ d : Fin N_D, p o d
             let p_D := fun d => ∑ o ∈ O₀, p o d
             let H_O := (∑ o ∈ O₀, -(p_O o * Real.log (p_O o))) / ell
             let H_O_D := (∑ o ∈ O₀, ∑ d : Fin N_D,
               -(p o d * Real.log (p o d / p_D d))) / ell
             let E_mass := (∑ o ∈ O₀,
               p_O o * Real.log (canonicalRootMass lam_sys Φ₀ g o)) / ell
             let E_w := ∑ d : Fin N_D,
               p_D d * ((1 + γ) * b d + (1 - γ) * a d)
             s = H_O + (1 / 2 : ℝ) * H_O_D + (3 / 2 : ℝ) * E_mass + (1 / 2 : ℝ) * E_w) }
    have h_root_score_bdd : ∀ (R'_dom : ℝ) (g : EuclideanSpace ℝ (Fin 2) → ℂ) (M_sup : ℝ),
        (∀ o, canonicalRootMass lam_sys Φ₀ g o ≤ M_sup) →
        BddAbove (rootScoreSet R'_dom g) := by
      intro R'_dom g M_sup hM_sup
      let O₀ := rootSiteFinset lam_sys R'_dom
      let s_norm := (3 / 2 : ℝ) * (Real.log (∫ v : EuclideanSpace ℝ (Fin 2), ‖g v‖ ^ 2) / ell)
      let M₁ := max M_sup 1
      let W_pos := max 0 (min L (H_P / 2))
      let B_ub := max s_norm
        ((O₀.card : ℝ) / ell + (1 / 2 : ℝ) * ((O₀.card : ℝ) / ell) +
          (3 / 2 : ℝ) * (Real.log M₁ / ell) + (1 / 2 : ℝ) * (2 * W_pos))
      refine ⟨B_ub, ?_⟩
      rintro s (hs | ⟨N_D, b, a, e_dir, V_c, X_c, p, hba, hp_nn, hp_out, hp_sum, hp_supp, hs_eq⟩)
      · rw [Set.mem_singleton_iff] at hs
        rw [hs]
        exact le_max_left _ _
      · refine le_trans ?_ (le_max_right _ _)
        let p_O := fun o => ∑ d : Fin N_D, p o d
        let p_D := fun d => ∑ o ∈ O₀, p o d
        have hpO_nn : ∀ o, 0 ≤ p_O o := fun o => Finset.sum_nonneg (fun d _ => hp_nn o d)
        have hpD_nn : ∀ d, 0 ≤ p_D d := fun d => Finset.sum_nonneg (fun o _ => hp_nn o d)
        have hpD_sum : ∑ d : Fin N_D, p_D d = 1 := by
          dsimp [p_D]
          rw [Finset.sum_comm]
          exact hp_sum
        have hpO_sum : ∑ o ∈ O₀, p_O o = 1 := hp_sum
        have hHO_le : (∑ o ∈ O₀, -(p_O o * Real.log (p_O o))) / ell ≤ (O₀.card : ℝ) / ell := by
          refine div_le_div_of_nonneg_right ?_ hell_pos.le
          calc ∑ o ∈ O₀, -(p_O o * Real.log (p_O o))
              ≤ ∑ _ ∈ O₀, (1 : ℝ) := Finset.sum_le_sum (fun o _ => h_neg_mul_log_le (p_O o) (hpO_nn o))
            _ = (O₀.card : ℝ) := by simp
        have hHOD_le : (∑ o ∈ O₀, ∑ d : Fin N_D, -(p o d * Real.log (p o d / p_D d))) / ell ≤
            (O₀.card : ℝ) / ell := by
          refine div_le_div_of_nonneg_right ?_ hell_pos.le
          rw [Finset.sum_comm]
          calc ∑ d : Fin N_D, ∑ o ∈ O₀, -(p o d * Real.log (p o d / p_D d))
              ≤ ∑ d : Fin N_D, p_D d * (O₀.card : ℝ) := by
                refine Finset.sum_le_sum (fun d _ => ?_)
                by_cases hd0 : p_D d = 0
                · rw [hd0, zero_mul]
                  refine le_of_eq (Finset.sum_eq_zero (fun o _ => ?_))
                  simp
