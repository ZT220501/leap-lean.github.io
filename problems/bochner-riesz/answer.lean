    intro α Z ω hω
    have hπ_pos : 0 < π ω := (h_mem_pos ω).mp hω
    dsimp only [finProbAt]
    let d_inst := Classical.propDecidable
    have h_le : @ite ℝ (Z ω = Z ω) (d_inst _) (π ω) 0 ≤
        ∑ ω' : Fin N_ω, @ite ℝ (Z ω' = Z ω) (d_inst _) (π ω') 0 :=
      Finset.single_le_sum (f := fun ω' => @ite ℝ (Z ω' = Z ω) (d_inst _) (π ω') 0)
        (fun ω' _ => by split_ifs; exact h_law.1 ω'; exact le_rfl) (Finset.mem_univ ω)
