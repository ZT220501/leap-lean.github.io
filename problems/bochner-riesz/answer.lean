                    have hpY_eq : finProbAt2 (π_j_fn (J_fn ω)) (fun _ => ()) (G_loc (J_fn ω)) ω =
                        finProbAt2 π (fun _ => ()) Y ω / p_J_fn (J_fn ω) := by
                      classical
                      dsimp only [finProbAt2, π_j_fn, Y]
                      rw [Finset.sum_div]
                      refine Finset.sum_congr rfl (fun ω' _ => ?_)
                      by_cases hj' : J_fn ω' = J_fn ω
                      · by_cases hg : G_loc (J_fn ω) ω' = G_loc (J_fn ω) ω
                        · simp [hj', hg]
                        · simp [hj', hg]
                      · simp [hj']
                    have hpY_pos : 0 < finProbAt2 π (fun _ => ()) Y ω := by
                      dsimp only [finProbAt2]
                      letI := Classical.propDecidable
                      have hle : π ω ≤ ∑ ω' : Fin N_ω,
                          if ((fun _ : Fin N_ω => ()) ω' = (fun _ : Fin N_ω => ()) ω ∧ Y ω' = Y ω)
                          then π ω' else 0 := by
                        have hterm : π ω =
                            (if ((fun _ : Fin N_ω => ()) ω = (fun _ : Fin N_ω => ()) ω ∧ Y ω = Y ω)
                             then π ω else 0) := by simp
                        rw [hterm]
                        exact Finset.single_le_sum
                          (f := fun ω' =>
                            if ((fun _ : Fin N_ω => ()) ω' = (fun _ : Fin N_ω => ()) ω ∧ Y ω' = Y ω)
                            then π ω' else 0)
                          (fun ω' _ => by split_ifs <;> [exact hπ_nn ω'; exact le_rfl])
                          (Finset.mem_univ ω)
