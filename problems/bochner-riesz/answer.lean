    have h_step1 :
        ((1 / 2 : ℝ) * c_gap ^ 2) *
          (∫ i in (-K)..K, ∫ u in δ..(1 - δ), H_mix F (p_fn (i, u))) =
        ∫ i in (-K)..K, ∫ u in δ..(1 - δ), LHS_fn (i, u) := by
      rw [← intervalIntegral.integral_const_mul]
      refine intervalIntegral.integral_congr fun i hi => ?_
      rw [Set.uIcc_of_le hK_le] at hi
      rw [← intervalIntegral.integral_const_mul]
      refine intervalIntegral.integral_congr fun u hu => ?_
      rw [Set.uIcc_of_le hδ_le] at hu
      dsimp [LHS_fn]
      rw [hχi_one i hi, hχu_one u hu]
      ring
    have h_step2 :
        (∫ i in (-K)..K, ∫ u in δ..(1 - δ), LHS_fn (i, u)) ≤
        ∫ i in (-(K + 1))..(K + 1), ∫ u in (δ / 2)..(1 - δ / 2), LHS_fn (i, u) :=
      h_rect_mono LHS_fn (-(K + 1)) (-K) K (K + 1) (δ / 2) δ (1 - δ) (1 - δ / 2)
        (by linarith) hK_le (by linarith) (by linarith) hδ_le (by linarith) hLHS_cont
        (fun i _ u _ => mul_nonneg (mul_nonneg hc_gap_sq_pos.le
          (mul_nonneg (hχi_nn i) (hχu_nn u))) (h_Hmix_nn F (p_fn (i, u))))
    have h_step3 :
        (∫ i in (-(K + 1))..(K + 1), ∫ u in (δ / 2)..(1 - δ / 2), LHS_fn (i, u)) ≤
        ∫ i in (-(K + 1))..(K + 1), ∫ u in (δ / 2)..(1 - δ / 2), RHS_fn (i, u) := by
      have hcL : Continuous (fun i => ∫ u in (δ / 2)..(1 - δ / 2), LHS_fn (i, u)) :=
        intervalIntegral.continuous_parametric_intervalIntegral_of_continuous'
          (f := fun i u => LHS_fn (i, u)) hLHS_cont (δ / 2) (1 - δ / 2)
      have hcR : Continuous (fun i => ∫ u in (δ / 2)..(1 - δ / 2), RHS_fn (i, u)) :=
        intervalIntegral.continuous_parametric_intervalIntegral_of_continuous'
          (f := fun i u => RHS_fn (i, u)) hRHS_cont (δ / 2) (1 - δ / 2)
      refine intervalIntegral.integral_mono_on hK1_le (hcL.intervalIntegrable _ _)
