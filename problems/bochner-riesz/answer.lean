      have hPG_g_pos : 0 < P_G g := hPG_pos g hg_all
      have hPG_g_ne : P_G g ≠ 0 := ne_of_gt hPG_g_pos
      have h_le_each : ∀ t ∈ S_T,
          P_TDG t d g * ((P_D d * P_TG t g) / ((M_rnd : ℝ) * P_TDG t d g * P_G g)) ≤
            (P_D d * P_TG t g) / ((M_rnd : ℝ) * P_G g) := by
        intro t _
        by_cases h0 : P_TDG t d g = 0
