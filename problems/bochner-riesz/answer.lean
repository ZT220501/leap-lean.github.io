          (∑ d : Fin N_D, ∑ s : Fin M_split, -(q_D s d * Real.log (q_D s d / p_D d))) +
          ∑ s : Fin M_split, α s *
            (∑ o : Fin N_O, ∑ d : Fin N_D, -(p_cd s o d * Real.log (p_cd s o d / p_cd_D s d))) := by
        simp_rw [h_HOD_each, Finset.sum_add_distrib]
        refine congrArg₂ (· + ·) ?_ h2'
        rw [Finset.sum_comm]
        refine Finset.sum_congr rfl (fun d _ => ?_)
        rw [Finset.sum_comm]
        refine Finset.sum_congr rfl (fun s _ => ?_)
        dsimp [q_D]
        rw [Finset.sum_mul, ← Finset.sum_neg_distrib]
      have h3 : ∑ d : Fin N_D, ∑ s : Fin M_split, -(q_D s d * Real.log (q_D s d / p_D d)) ≤
          Real.log (M_split : ℝ) := by
        calc ∑ d : Fin N_D, ∑ s : Fin M_split, -(q_D s d * Real.log (q_D s d / p_D d))
            ≤ ∑ d : Fin N_D, p_D d * Real.log (M_split : ℝ) :=
              Finset.sum_le_sum (fun d _ =>
