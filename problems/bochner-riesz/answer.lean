        have h_d : Disjoint S_farX (U_in ∩ S_near) := Finset.disjoint_sdiff_inter U_in S_near
        have h_comm : U_in ∩ S_near = S_core := Finset.inter_comm U_in S_near
        rw [h_comm] at h_u h_d
        have h_sum_eq : (∑ α ∈ S_core, W α) = (∑ α ∈ U_in, W α) - (∑ α ∈ S_farX, W α) := by
          have h1 := Finset.sum_union h_d (f := W)
          rw [h_u] at h1
