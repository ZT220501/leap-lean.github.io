          calc m_ch * M_ret = M_ret * m_ch := mul_comm _ _
            _ ≤ m_ch0 := h_ch_le
            _ ≤ B_p0 * m_par0 := h_pm
            _ ≤ B_p0 * (δ⁻¹ * (M_ret * m_par)) := mul_le_mul_of_nonneg_left h_par0_le hBp0_nn
