        rw [Finset.sum_neg_distrib, ← Finset.sum_mul, ← hq_Q_eq q hq]
      have h_rhs2 : ∑ z ∈ Z_act, ∑ q ∈ F_set, -(π_ZQ z q * Real.log (π_RQ z.1 q / q_Q q)) ≤
          Real.log B_time := by
        rw [Finset.sum_comm]
        have h_fib : ∀ q ∈ F_set,
            ∑ z ∈ Z_act, -(π_ZQ z q * Real.log (π_RQ z.1 q / q_Q q)) =
              ∑ r ∈ R_set, -(π_RQ r q * Real.log (π_RQ r q / q_Q q)) := by
