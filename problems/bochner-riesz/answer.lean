                (A ^ (j + 1) * ((j.factorial : ℝ) ^ 3) * R_win) *
                  ((20 * a₀⁻¹) ^ (j + 1) * (σ_t ^ j * R_cut ^ (j + 1))) by ring]
            have step2 : (A ^ (j + 1) * ((j.factorial : ℝ) ^ 3) * R_win) *
                ((20 * a₀⁻¹) ^ (j + 1) * (σ_t ^ j * R_cut ^ (j + 1))) ≤
              (A ^ (j + 1) * (((N_tay.factorial : ℝ) ^ 3) ^ (j + 1)) * R_win ^ (j + 1)) *
                ((20 * a₀⁻¹) ^ (j + 1) * (B_sys * δ_small) ^ (j + 1)) := by
              refine mul_le_mul ?_ ?_ (by positivity) (by positivity)
              · exact mul_le_mul
                  (mul_le_mul_of_nonneg_left hfac_pow (by positivity))
                  hR_pow hR_pos.le (by positivity)
              · exact mul_le_mul_of_nonneg_left h_sc_j (by positivity)
            have hid2 : (A ^ (j + 1) * (((N_tay.factorial : ℝ) ^ 3) ^ (j + 1)) *
                R_win ^ (j + 1)) *
              ((20 * a₀⁻¹) ^ (j + 1) * (B_sys * δ_small) ^ (j + 1)) =
              (D_ray_2 * δ_small) ^ (j + 1) := by
              dsimp only [D_ray_2]
              rw [mul_pow, mul_pow, mul_pow, mul_pow, mul_pow, mul_pow]
              ring
            exact le_trans step1 (le_of_le_of_eq step2 hid2)
          have hD2_le : (D_ray_2 * δ_small) ^ (j + 1) ≤ D ^ (j + 1) :=
            pow_le_pow_left₀ (by dsimp only [D_ray_2]; positivity)
              (mul_le_mul_of_nonneg_right (le_max_right _ _) hδ_nn) (j + 1)
          exact le_trans h1 (le_trans h_lhs_le hD2_le)
      have h_fin := h_s4_2 Ψ_z hΨ_sm N_tay ξ s D hD_nn h_ray_bd
      calc ‖iteratedDeriv N_tay (fun s' : ℝ => G_z (s' • ξ)) s‖
          ≤ (N_tay.factorial : ℝ) * (D_ray * δ_small) ^ N_tay := h_fin
        _ = C_rem * δ_small ^ N_tay := by
            dsimp only [C_rem]
            rw [mul_pow, mul_assoc]

theorem microlocal_symbol_smoothness_and_taylor_fidelity (R_win : ℝ) (M_L N_tay : ℕ) (D_z_exp C_u_coeff : ℕ → ℝ) (C_rem : ℝ)
    (η_hat : ℝ → ℂ) (χ₁ : ℝ → ℝ)
    (hR_win : 2 ≤ R_win) (hML : 256 ≤ M_L) (hNtay : 2 ≤ N_tay)
    (hDz : ∀ k : ℕ, 1 ≤ D_z_exp k)
    (hCu : ∀ m : ℕ, 0 ≤ C_u_coeff m)
    (hCrem : 0 ≤ C_rem)
    (hχ₁_cont : Continuous χ₁)
    (hχ₁_01 : ∀ s : ℝ, 0 ≤ χ₁ s ∧ χ₁ s ≤ 1)
    (hχ₁_one : ∀ s : ℝ, |s| ≤ 1 → χ₁ s = 1)
    (hχ₁_zero : ∀ s : ℝ, 2 ≤ |s| → χ₁ s = 0)
    (hη_cont : Continuous η_hat)
    (hη_int : ∀ k : ℕ,
      MeasureTheory.Integrable (fun ξ : ℝ => |ξ| ^ k * ‖η_hat ξ‖) MeasureTheory.volume)
    (hη_in : ∀ z : EuclideanSpace ℝ (Fin 2),
      ‖z‖ ≤ ((17 : ℝ) / 2048) * (M_L : ℝ) →
      (∫ ξ : ℝ × ℝ,
        η_hat ξ.1 * η_hat ξ.2 *
          Complex.exp (Complex.I *
            ((2 * Real.pi * (ξ.1 * z 0 + ξ.2 * z 1) : ℝ) : ℂ)) = 1) ∧
      (∀ p q : ℕ, 1 ≤ p + q →
        ∫ ξ : ℝ × ℝ,
          ((ξ.1 ^ p * ξ.2 ^ q : ℝ) : ℂ) * η_hat ξ.1 * η_hat ξ.2 *
            Complex.exp (Complex.I *
              ((2 * Real.pi * (ξ.1 * z 0 + ξ.2 * z 1) : ℝ) : ℂ)) = 0))
    (hη_out : ∀ z : EuclideanSpace ℝ (Fin 2),
      ((30 : ℝ) / 2048) * (M_L : ℝ) ≤ ‖z‖ →
      ∀ p q : ℕ,
        ∫ ξ : ℝ × ℝ,
          ((ξ.1 ^ p * ξ.2 ^ q : ℝ) : ℂ) * η_hat ξ.1 * η_hat ξ.2 *
            Complex.exp (Complex.I *
              ((2 * Real.pi * (ξ.1 * z 0 + ξ.2 * z 1) : ℝ) : ℂ)) = 0) :
    ∃ (M_W : ℕ → ℝ) (C_W : ℝ),
      (∀ k : ℕ, 1 ≤ M_W k) ∧
      0 ≤ C_W ∧
      ∀ (r_cut δ_small : ℝ) (ΔΘ_o : (ℝ × ℝ) → EuclideanSpace ℝ (Fin 2) → ℝ),
        0 < r_cut → r_cut ≤ 1 → 0 ≤ δ_small →
        (∀ k : ℕ, ContDiff ℝ k (Function.uncurry ΔΘ_o)) →
        (∀ ξ : ℝ × ℝ,
          let h_ξ : EuclideanSpace ℝ (Fin 2) → ℂ := fun z =>
            Complex.exp (Complex.I * ((ΔΘ_o ξ z : ℝ) : ℂ))
          (∀ k : ℕ, ContDiff ℝ k h_ξ) ∧
          (∀ (k : ℕ) (z : EuclideanSpace ℝ (Fin 2)),
            ‖iteratedFDeriv ℝ k h_ξ z‖ ≤ D_z_exp k * (1 + |ξ.1| + |ξ.2|) ^ k)) →
        (∀ z : EuclideanSpace ℝ (Fin 2), ‖z‖ ≤ R_win →
          let G_z : ℝ × ℝ → ℂ := fun u =>
            Complex.exp (Complex.I *
              ((ΔΘ_o u z - 2 * Real.pi * (u.1 * z 0 + u.2 * z 1) : ℝ) : ℂ))
          G_z (0, 0) = 1 ∧
          (∀ k : ℕ, ContDiff ℝ k G_z) ∧
          (∀ m : ℕ, 1 ≤ m → m < N_tay →
            ∃ c_poly : (Fin m → Bool) → ℂ,
              (∀ b : Fin m → Bool, ‖c_poly b‖ ≤ C_u_coeff m) ∧
              (∀ ξ : ℝ × ℝ,
                ((m.factorial : ℝ)⁻¹) •
                  iteratedDeriv m (fun s : ℝ => G_z (s • ξ)) 0 =
                  ∑ b : Fin m → Bool,
                    c_poly b *
                      ((ξ.1 ^ (Finset.univ.filter (fun i => b i = true)).card *
                        ξ.2 ^ (Finset.univ.filter (fun i => b i = false)).card : ℝ) : ℂ))) ∧
          (∀ ξ : ℝ × ℝ, |ξ.1| ≤ 2 * r_cut⁻¹ → |ξ.2| ≤ 2 * r_cut⁻¹ →
            ∀ s ∈ Set.Icc (0 : ℝ) 1,
              ‖iteratedDeriv N_tay (fun s' : ℝ => G_z (s' • ξ)) s‖ ≤
                C_rem * δ_small ^ N_tay)) →
        let W_o : EuclideanSpace ℝ (Fin 2) → ℂ := fun z =>
          ∫ ξ : ℝ × ℝ,
            ((χ₁ (r_cut * ξ.1) * χ₁ (r_cut * ξ.2) : ℝ) : ℂ) *
              η_hat ξ.1 * η_hat ξ.2 *
              Complex.exp (Complex.I * ((ΔΘ_o ξ z : ℝ) : ℂ))
        (∀ k : ℕ, ContDiff ℝ k W_o) ∧
        (∀ (k : ℕ) (z : EuclideanSpace ℝ (Fin 2)),
          ‖iteratedFDeriv ℝ k W_o z‖ ≤ M_W k) ∧
        (∀ z : EuclideanSpace ℝ (Fin 2),
          ‖z‖ ≤ R_win → ‖z‖ ≤ ((17 : ℝ) / 2048) * (M_L : ℝ) →
          ‖W_o z - 1‖ ≤ C_W * (δ_small ^ N_tay + r_cut ^ N_tay)) ∧
        (∀ z : EuclideanSpace ℝ (Fin 2),
          ‖z‖ ≤ R_win → ((30 : ℝ) / 2048) * (M_L : ℝ) ≤ ‖z‖ →
          ‖W_o z‖ ≤ C_W * (δ_small ^ N_tay + r_cut ^ N_tay)) :=
by
  have _ := hR_win
  have _ := hML
  let w1 : ℕ → ℝ → ℝ := fun j s => |s| ^ j * ‖η_hat s‖
  have hw1_nn : ∀ (j : ℕ) (s : ℝ), 0 ≤ w1 j s :=
    fun j s => mul_nonneg (pow_nonneg (abs_nonneg s) j) (norm_nonneg (η_hat s))
  let I_mom : ℕ → ℝ := fun j => ∫ s : ℝ, w1 j s
  have hI_nn : ∀ j : ℕ, 0 ≤ I_mom j :=
    fun j => MeasureTheory.integral_nonneg (hw1_nn j)
  let E_tail : ℕ → ℕ → ℝ := fun p q =>
    I_mom (p + N_tay) * I_mom q + I_mom p * I_mom (q + N_tay)
  have hE_tail_nn : ∀ p q : ℕ, 0 ≤ E_tail p q := fun p q =>
    add_nonneg (mul_nonneg (hI_nn _) (hI_nn _)) (mul_nonneg (hI_nn _) (hI_nn _))
  let M_W : ℕ → ℝ := fun k =>
    max 1 (D_z_exp k * (3 : ℝ) ^ k * (I_mom 0 ^ 2 + 2 * I_mom k * I_mom 0))
  have hMW_ge1 : ∀ k : ℕ, 1 ≤ M_W k := fun k => le_max_left _ _
  let C_tay : ℝ := C_rem * I_mom 0 ^ 2
  have hCtay_nn : 0 ≤ C_tay := mul_nonneg hCrem (sq_nonneg _)
  let C_cut : ℝ := E_tail 0 0 +
    ∑ m ∈ Finset.Ico 1 N_tay,
      C_u_coeff m *
        ∑ b : Fin m → Bool,
          E_tail (Finset.univ.filter (fun i => b i = true)).card
                 (Finset.univ.filter (fun i => b i = false)).card
  have hCcut_nn : 0 ≤ C_cut := by
    refine add_nonneg (hE_tail_nn 0 0) (Finset.sum_nonneg (fun m _ => ?_))
    exact mul_nonneg (hCu m) (Finset.sum_nonneg (fun b _ => hE_tail_nn _ _))
  let C_W : ℝ := C_tay + C_cut
  have hCW_nn : 0 ≤ C_W := add_nonneg hCtay_nn hCcut_nn
  refine ⟨M_W, C_W, hMW_ge1, hCW_nn, ?_⟩
  intro r_cut δ_small ΔΘ_o hr_pos _hr_le1 hδ_nn hΔΘ_smooth hh_ξ hG_z W_o

  
  have h_pow3 : ∀ (k : ℕ) (a b : ℝ), 0 ≤ a → 0 ≤ b →
      (1 + a + b) ^ k ≤ (3 : ℝ) ^ k * (1 + a ^ k + b ^ k) := by
    intro k a b ha hb
    let M : ℝ := max 1 (max a b)
    have h1M : 1 ≤ M := le_max_left _ _
    have haM : a ≤ M := le_trans (le_max_left a b) (le_max_right 1 _)
    have hbM : b ≤ M := le_trans (le_max_right a b) (le_max_right 1 _)
    have hsum_le : 1 + a + b ≤ 3 * M := by linarith
    have hpow_le : (1 + a + b) ^ k ≤ (3 : ℝ) ^ k * M ^ k := by
      calc (1 + a + b) ^ k ≤ (3 * M) ^ k := pow_le_pow_left₀ (by linarith) hsum_le k
        _ = (3 : ℝ) ^ k * M ^ k := mul_pow 3 M k
    have hMk : M ^ k ≤ 1 + a ^ k + b ^ k := by
      have hak : 0 ≤ a ^ k := pow_nonneg ha k
      have hbk : 0 ≤ b ^ k := pow_nonneg hb k
      rcases max_choice 1 (max a b) with hM1 | hMab
      · change M = 1 at hM1
        rw [hM1, one_pow]
        linarith
      · change M = max a b at hMab
        rcases max_choice a b with hab1 | hab2
        · rw [hMab, hab1]; linarith
        · rw [hMab, hab2]; linarith
    exact le_trans hpow_le (mul_le_mul_of_nonneg_left hMk (pow_nonneg (by norm_num) k))

  
  let α : ℝ × ℝ → ℂ := fun ξ =>
    ((χ₁ (r_cut * ξ.1) * χ₁ (r_cut * ξ.2) : ℝ) : ℂ) * η_hat ξ.1 * η_hat ξ.2
  have hα_cont : Continuous α :=
    ((Complex.continuous_ofReal.comp
      ((hχ₁_cont.comp (continuous_const.mul continuous_fst)).mul
        (hχ₁_cont.comp (continuous_const.mul continuous_snd)))).mul
      (hη_cont.comp continuous_fst)).mul
      (hη_cont.comp continuous_snd)
  have hχ_prod_01 : ∀ ξ : ℝ × ℝ,
      0 ≤ χ₁ (r_cut * ξ.1) * χ₁ (r_cut * ξ.2) ∧
      χ₁ (r_cut * ξ.1) * χ₁ (r_cut * ξ.2) ≤ 1 := by
    intro ξ
    have h1 := hχ₁_01 (r_cut * ξ.1)
    have h2 := hχ₁_01 (r_cut * ξ.2)
    exact ⟨mul_nonneg h1.1 h2.1, by nlinarith [h1.1, h1.2, h2.1, h2.2]⟩
  have hα_bd : ∀ ξ : ℝ × ℝ, ‖α ξ‖ ≤ w1 0 ξ.1 * w1 0 ξ.2 := by
    intro ξ
    obtain ⟨h_nn, h_le1⟩ := hχ_prod_01 ξ
    have hχ_norm : ‖((χ₁ (r_cut * ξ.1) * χ₁ (r_cut * ξ.2) : ℝ) : ℂ)‖ ≤ 1 := by
      rw [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg h_nn]
      exact h_le1
    have hw0 : ∀ s : ℝ, w1 0 s = ‖η_hat s‖ := fun s => by dsimp [w1]; rw [pow_zero, one_mul]
    rw [hw0, hw0]
    calc ‖α ξ‖ = ‖((χ₁ (r_cut * ξ.1) * χ₁ (r_cut * ξ.2) : ℝ) : ℂ)‖ *
          ‖η_hat ξ.1‖ * ‖η_hat ξ.2‖ := by dsimp [α]; rw [norm_mul, norm_mul]
      _ ≤ 1 * ‖η_hat ξ.1‖ * ‖η_hat ξ.2‖ := by gcongr
      _ = ‖η_hat ξ.1‖ * ‖η_hat ξ.2‖ := by rw [one_mul]

  
  have hw_prod_int : ∀ a b : ℕ,
      MeasureTheory.Integrable (fun ξ : ℝ × ℝ => w1 a ξ.1 * w1 b ξ.2)
        MeasureTheory.volume :=
    fun a b => (hη_int a).mul_prod (hη_int b)
  have hw_prod_eq : ∀ a b : ℕ,
      (∫ ξ : ℝ × ℝ, w1 a ξ.1 * w1 b ξ.2) = I_mom a * I_mom b :=
    fun a b => MeasureTheory.integral_prod_mul (w1 a) (w1 b)
  let dom : ℕ → ℝ × ℝ → ℝ := fun k ξ =>
    D_z_exp k * (3 : ℝ) ^ k *
      (w1 0 ξ.1 * w1 0 ξ.2 + w1 k ξ.1 * w1 0 ξ.2 + w1 0 ξ.1 * w1 k ξ.2)
  have hdom_int : ∀ k : ℕ, MeasureTheory.Integrable (dom k) MeasureTheory.volume := by
    intro k
    exact (((hw_prod_int 0 0).add (hw_prod_int k 0)).add (hw_prod_int 0 k)).const_mul
      (D_z_exp k * (3 : ℝ) ^ k)
  have hdom_integral : ∀ k : ℕ,
      (∫ ξ : ℝ × ℝ, dom k ξ) =
        D_z_exp k * (3 : ℝ) ^ k * (I_mom 0 ^ 2 + 2 * I_mom k * I_mom 0) := by
    intro k
    have h_pair : MeasureTheory.Integrable
        (fun ξ : ℝ × ℝ => w1 0 ξ.1 * w1 0 ξ.2 + w1 k ξ.1 * w1 0 ξ.2)
        MeasureTheory.volume := (hw_prod_int 0 0).add (hw_prod_int k 0)
    dsimp only [dom]
    rw [MeasureTheory.integral_const_mul,
      MeasureTheory.integral_add h_pair (hw_prod_int 0 k),
      MeasureTheory.integral_add (hw_prod_int 0 0) (hw_prod_int k 0),
      hw_prod_eq 0 0, hw_prod_eq k 0, hw_prod_eq 0 k]
    ring

  let h_fn : (ℝ × ℝ) → EuclideanSpace ℝ (Fin 2) → ℂ := fun ξ z =>
    Complex.exp (Complex.I * ((ΔΘ_o ξ z : ℝ) : ℂ))
  have h_slice_dom : ∀ (k : ℕ) (ξ : ℝ × ℝ) (z : EuclideanSpace ℝ (Fin 2)),
      ‖α ξ • iteratedFDeriv ℝ k (h_fn ξ) z‖ ≤ dom k ξ := by
    intro k ξ z
    have hDz_nn : 0 ≤ D_z_exp k := le_trans zero_le_one (hDz k)
    have hd_bd : ‖iteratedFDeriv ℝ k (h_fn ξ) z‖ ≤
        D_z_exp k * ((3 : ℝ) ^ k * (1 + |ξ.1| ^ k + |ξ.2| ^ k)) := by
      refine le_trans ((hh_ξ ξ).2 k z) ?_
      exact mul_le_mul_of_nonneg_left
        (h_pow3 k |ξ.1| |ξ.2| (abs_nonneg _) (abs_nonneg _)) hDz_nn
    rw [norm_smul]
    calc ‖α ξ‖ * ‖iteratedFDeriv ℝ k (h_fn ξ) z‖
        ≤ (w1 0 ξ.1 * w1 0 ξ.2) *
            (D_z_exp k * ((3 : ℝ) ^ k * (1 + |ξ.1| ^ k + |ξ.2| ^ k))) :=
          mul_le_mul (hα_bd ξ) hd_bd (norm_nonneg _)
            (mul_nonneg (hw1_nn 0 ξ.1) (hw1_nn 0 ξ.2))
      _ = dom k ξ := by
          dsimp only [dom, w1]
          rw [pow_zero, pow_zero]
          ring

  
  let H_joint : (ℝ × ℝ) × EuclideanSpace ℝ (Fin 2) → ℂ := fun p =>
    Complex.exp (Complex.I * ((Function.uncurry ΔΘ_o p : ℝ) : ℂ))
  have hH_smooth : ∀ m : ℕ, ContDiff ℝ m H_joint := fun m =>
    Complex.contDiff_exp.comp
      (contDiff_const.mul (Complex.ofRealCLM.contDiff.comp (hΔΘ_smooth m)))
  have h_slice_cont : ∀ (m : ℕ) (z : EuclideanSpace ℝ (Fin 2)),
      Continuous (fun ξ : ℝ × ℝ => iteratedFDeriv ℝ m (h_fn ξ) z) := by
    intro m z
    let ι₂ : EuclideanSpace ℝ (Fin 2) →L[ℝ] (ℝ × ℝ) × EuclideanSpace ℝ (Fin 2) :=
      ContinuousLinearMap.inr ℝ (ℝ × ℝ) (EuclideanSpace ℝ (Fin 2))
    have h_eq : (fun ξ : ℝ × ℝ => iteratedFDeriv ℝ m (h_fn ξ) z) =
        fun ξ : ℝ × ℝ =>
          ContinuousMultilinearMap.compContinuousLinearMapL (fun _ : Fin m => ι₂)
            (iteratedFDeriv ℝ m H_joint (ξ, z)) := by
      ext ξ v
      have h_sh_sm : ContDiff ℝ m (fun p : (ℝ × ℝ) × EuclideanSpace ℝ (Fin 2) =>
          H_joint ((ξ, 0) + p)) :=
        (hH_smooth m).comp (contDiff_const.add contDiff_id)
      have hfun : h_fn ξ =
          (fun p : (ℝ × ℝ) × EuclideanSpace ℝ (Fin 2) => H_joint ((ξ, 0) + p)) ∘ ι₂ := by
        ext y
        simp [h_fn, H_joint, ι₂]
      rw [hfun, ι₂.iteratedFDeriv_comp_right h_sh_sm z le_rfl,
        iteratedFDeriv_comp_add_left]
      simp [ι₂]
    rw [h_eq]
    exact (ContinuousMultilinearMap.compContinuousLinearMapL (fun _ : Fin m => ι₂)).continuous.comp
      (((hH_smooth m).continuous_iteratedFDeriv le_rfl).comp
        (continuous_id.prodMk continuous_const))

  
  have h_smul_cont : ∀ (n : ℕ) (z : EuclideanSpace ℝ (Fin 2)),
      Continuous (fun ξ : ℝ × ℝ => α ξ • iteratedFDeriv ℝ n (h_fn ξ) z) :=
    fun n z => hα_cont.smul (h_slice_cont n z)
  let J : (m : ℕ) → EuclideanSpace ℝ (Fin 2) →
      ContinuousMultilinearMap ℝ (fun _ : Fin m => EuclideanSpace ℝ (Fin 2)) ℂ :=
    fun m z => ∫ ξ : ℝ × ℝ, α ξ • iteratedFDeriv ℝ m (h_fn ξ) z
  have hJ_int : ∀ (m : ℕ) (z : EuclideanSpace ℝ (Fin 2)),
      MeasureTheory.Integrable
        (fun ξ : ℝ × ℝ => α ξ • iteratedFDeriv ℝ m (h_fn ξ) z)
        MeasureTheory.volume := by
    intro m z
    exact (hdom_int m).mono'
      (h_smul_cont m z).aestronglyMeasurable
      (Filter.Eventually.of_forall (fun ξ => h_slice_dom m ξ z))
  have hJ_hasFDeriv : ∀ (m : ℕ) (z₀ : EuclideanSpace ℝ (Fin 2)),
      HasFDerivAt (J m)
        (continuousMultilinearCurryLeftEquiv ℝ
          (fun _ : Fin (m + 1) => EuclideanSpace ℝ (Fin 2)) ℂ (J (m + 1) z₀)) z₀ := by
    intro m z₀
    let L_m : ContinuousMultilinearMap ℝ (fun _ : Fin (m + 1) => EuclideanSpace ℝ (Fin 2)) ℂ ≃ₗᵢ[ℝ]
        (EuclideanSpace ℝ (Fin 2) →L[ℝ]
          ContinuousMultilinearMap ℝ (fun _ : Fin m => EuclideanSpace ℝ (Fin 2)) ℂ) :=
      continuousMultilinearCurryLeftEquiv ℝ
        (fun _ : Fin (m + 1) => EuclideanSpace ℝ (Fin 2)) ℂ
    have h_pt_deriv : ∀ (ξ : ℝ × ℝ) (z : EuclideanSpace ℝ (Fin 2)),
        HasFDerivAt (fun y => α ξ • iteratedFDeriv ℝ m (h_fn ξ) y)
          (L_m (α ξ • iteratedFDeriv ℝ (m + 1) (h_fn ξ) z)) z := by
      intro ξ z
      have hd : Differentiable ℝ (iteratedFDeriv ℝ m (h_fn ξ)) :=
        ((hh_ξ ξ).1 (m + 1)).differentiable_iteratedFDeriv
          (by exact_mod_cast Nat.lt_succ_self m)
      have hf := (hd z).hasFDerivAt.const_smul (α ξ)
      rw [fderiv_iteratedFDeriv] at hf
      convert hf using 1
      ext v u
      simp [L_m]
    have h1 : HasFDerivAt (J m)
        (∫ ξ : ℝ × ℝ, L_m (α ξ • iteratedFDeriv ℝ (m + 1) (h_fn ξ) z₀)) z₀ := by
      refine hasFDerivAt_integral_of_dominated_of_fderiv_le
        (s := Set.univ) Filter.univ_mem
        (Filter.Eventually.of_forall (fun z => (h_smul_cont m z).aestronglyMeasurable))
        (hJ_int m z₀)
        (L_m.continuous.comp_aestronglyMeasurable (h_smul_cont (m + 1) z₀).aestronglyMeasurable)
        (Filter.Eventually.of_forall (fun ξ z _ => ?_))
        (hdom_int (m + 1))
        (Filter.Eventually.of_forall (fun ξ z _ => h_pt_deriv ξ z))
      rw [L_m.norm_map]
      exact h_slice_dom (m + 1) ξ z
    have hcomm : (∫ ξ : ℝ × ℝ, L_m (α ξ • iteratedFDeriv ℝ (m + 1) (h_fn ξ) z₀)) =
        L_m (J (m + 1) z₀) :=
      LinearIsometry.integral_comp_comm
        (E := ContinuousMultilinearMap ℝ (fun _ : Fin (m + 1) => EuclideanSpace ℝ (Fin 2)) ℂ)
        (F := EuclideanSpace ℝ (Fin 2) →L[ℝ]
          ContinuousMultilinearMap ℝ (fun _ : Fin m => EuclideanSpace ℝ (Fin 2)) ℂ)
        (μ := MeasureTheory.volume) (𝕜 := ℝ)
        L_m.toLinearIsometry
        (fun ξ : ℝ × ℝ => α ξ • iteratedFDeriv ℝ (m + 1) (h_fn ξ) z₀)
    rwa [hcomm] at h1

  have hW_int : ∀ z : EuclideanSpace ℝ (Fin 2),
      MeasureTheory.Integrable (fun ξ : ℝ × ℝ => α ξ * h_fn ξ z) MeasureTheory.volume := by
    intro z
    have hcont : Continuous (fun ξ : ℝ × ℝ => α ξ * h_fn ξ z) :=
      hα_cont.mul (Complex.continuous_exp.comp
        (continuous_const.mul (Complex.continuous_ofReal.comp
          ((hΔΘ_smooth 0).continuous.comp (continuous_id.prodMk continuous_const)))))
    refine ((hη_int 0).mul_prod (hη_int 0)).mono' hcont.aestronglyMeasurable
      (Filter.Eventually.of_forall (fun ξ => ?_))
    rw [norm_mul, Complex.norm_exp_I_mul_ofReal, mul_one]
    exact hα_bd ξ
  have hW_iter : ∀ m : ℕ, iteratedFDeriv ℝ m W_o = J m := by
    intro m
    induction m with
    | zero =>
      ext z x
      let L₀ := (continuousMultilinearCurryFin0 ℝ (EuclideanSpace ℝ (Fin 2)) ℂ).symm
      have h1 : iteratedFDeriv ℝ 0 W_o z = L₀ (W_o z) := by
        rw [iteratedFDeriv_zero_eq_comp]
        rfl
      have h2 : (fun ξ : ℝ × ℝ => α ξ • iteratedFDeriv ℝ 0 (h_fn ξ) z) =
          fun ξ : ℝ × ℝ => L₀ (α ξ * h_fn ξ z) := by
        ext ξ y
        rw [iteratedFDeriv_zero_eq_comp]
        simp [L₀]
      have hW_eq : W_o z = ∫ ξ : ℝ × ℝ, α ξ * h_fn ξ z := rfl
      have hcomm : (∫ ξ : ℝ × ℝ, L₀ (α ξ * h_fn ξ z)) =
          L₀ (∫ ξ : ℝ × ℝ, α ξ * h_fn ξ z) :=
        L₀.toLinearIsometry.integral_comp_comm (fun ξ => α ξ * h_fn ξ z)
      have hJ0 : J 0 z = L₀ (W_o z) := by
        dsimp only [J]
        rw [h2, hcomm, ← hW_eq]
      rw [h1, hJ0]
    | succ m ih =>
      ext z v
      let L_m := continuousMultilinearCurryLeftEquiv ℝ
        (fun _ : Fin (m + 1) => EuclideanSpace ℝ (Fin 2)) ℂ
      have h1 : iteratedFDeriv ℝ (m + 1) W_o z =
          L_m.symm (fderiv ℝ (iteratedFDeriv ℝ m W_o) z) := by
        rw [iteratedFDeriv_succ_eq_comp_left]
        rfl
      rw [h1, ih, (hJ_hasFDeriv m z).fderiv, L_m.symm_apply_apply]
  have hJ_diff : ∀ m : ℕ, Differentiable ℝ (J m) :=
    fun m z => (hJ_hasFDeriv m z).differentiableAt
  have hW_smooth : ∀ k : ℕ, ContDiff ℝ k W_o := by
    intro k
    rw [contDiff_nat_iff_continuous_differentiable]
    refine ⟨fun m _ => ?_, fun m _ => ?_⟩
    · rw [hW_iter m]; exact (hJ_diff m).continuous
    · rw [hW_iter m]; exact hJ_diff m
  have hW_fderiv_bd : ∀ (k : ℕ) (z : EuclideanSpace ℝ (Fin 2)),
      ‖iteratedFDeriv ℝ k W_o z‖ ≤ M_W k := by
    intro k z
    rw [hW_iter k]
    calc ‖J k z‖
        ≤ ∫ ξ : ℝ × ℝ, ‖α ξ • iteratedFDeriv ℝ k (h_fn ξ) z‖ :=
          MeasureTheory.norm_integral_le_integral_norm _
      _ ≤ ∫ ξ : ℝ × ℝ, dom k ξ :=
          MeasureTheory.integral_mono (hJ_int k z).norm (hdom_int k)
            (fun ξ => h_slice_dom k ξ z)
      _ = D_z_exp k * (3 : ℝ) ^ k * (I_mom 0 ^ 2 + 2 * I_mom k * I_mom 0) :=
          hdom_integral k
      _ ≤ M_W k := le_max_right _ _

  
  have h_chi_diff : ∀ ξ : ℝ × ℝ,
      |χ₁ (r_cut * ξ.1) * χ₁ (r_cut * ξ.2) - 1| ≤
        r_cut ^ N_tay * (|ξ.1| ^ N_tay + |ξ.2| ^ N_tay) := by
    intro ξ
    have hr_ne : r_cut ≠ 0 := ne_of_gt hr_pos
    by_cases h_in : |ξ.1| ≤ r_cut⁻¹ ∧ |ξ.2| ≤ r_cut⁻¹
    · have h1 : |r_cut * ξ.1| ≤ 1 := by
        rw [abs_mul, abs_of_pos hr_pos]
        calc r_cut * |ξ.1| ≤ r_cut * r_cut⁻¹ :=
              mul_le_mul_of_nonneg_left h_in.1 hr_pos.le
          _ = 1 := mul_inv_cancel₀ hr_ne
      have h2 : |r_cut * ξ.2| ≤ 1 := by
        rw [abs_mul, abs_of_pos hr_pos]
        calc r_cut * |ξ.2| ≤ r_cut * r_cut⁻¹ :=
              mul_le_mul_of_nonneg_left h_in.2 hr_pos.le
          _ = 1 := mul_inv_cancel₀ hr_ne
      rw [hχ₁_one _ h1, hχ₁_one _ h2]
      norm_num
      exact mul_nonneg (pow_nonneg hr_pos.le N_tay)
        (add_nonneg (pow_nonneg (abs_nonneg _) N_tay) (pow_nonneg (abs_nonneg _) N_tay))
    · obtain ⟨_h_nn, h_le1⟩ := hχ_prod_01 ξ
      have habs_le1 : |χ₁ (r_cut * ξ.1) * χ₁ (r_cut * ξ.2) - 1| ≤ 1 := by
        rw [abs_sub_comm, abs_of_nonneg (sub_nonneg.mpr h_le1)]
        linarith [(hχ_prod_01 ξ).1]
      have h1_le_rhs : 1 ≤ r_cut ^ N_tay * (|ξ.1| ^ N_tay + |ξ.2| ^ N_tay) := by
        rw [not_and_or, not_le, not_le] at h_in
        rcases h_in with h1_gt | h2_gt
        · have hprod1 : 1 ≤ r_cut * |ξ.1| := by
            calc (1 : ℝ) = r_cut * r_cut⁻¹ := (mul_inv_cancel₀ hr_ne).symm
              _ ≤ r_cut * |ξ.1| := mul_le_mul_of_nonneg_left h1_gt.le hr_pos.le
          calc (1 : ℝ) ≤ (r_cut * |ξ.1|) ^ N_tay := one_le_pow₀ hprod1
            _ = r_cut ^ N_tay * |ξ.1| ^ N_tay := mul_pow _ _ _
            _ ≤ r_cut ^ N_tay * (|ξ.1| ^ N_tay + |ξ.2| ^ N_tay) :=
                mul_le_mul_of_nonneg_left
                  (le_add_of_nonneg_right (pow_nonneg (abs_nonneg _) N_tay))
                  (pow_nonneg hr_pos.le N_tay)
        · have hprod2 : 1 ≤ r_cut * |ξ.2| := by
            calc (1 : ℝ) = r_cut * r_cut⁻¹ := (mul_inv_cancel₀ hr_ne).symm
              _ ≤ r_cut * |ξ.2| := mul_le_mul_of_nonneg_left h2_gt.le hr_pos.le
          calc (1 : ℝ) ≤ (r_cut * |ξ.2|) ^ N_tay := one_le_pow₀ hprod2
            _ = r_cut ^ N_tay * |ξ.2| ^ N_tay := mul_pow _ _ _
            _ ≤ r_cut ^ N_tay * (|ξ.1| ^ N_tay + |ξ.2| ^ N_tay) :=
                mul_le_mul_of_nonneg_left
                  (le_add_of_nonneg_left (pow_nonneg (abs_nonneg _) N_tay))
                  (pow_nonneg hr_pos.le N_tay)
      exact le_trans habs_le1 h1_le_rhs

  
  have h_approx : ∀ (z : EuclideanSpace ℝ (Fin 2)) (_hz_win : ‖z‖ ≤ R_win) (val₀ : ℂ),
      (∫ ξ : ℝ × ℝ,
        ((ξ.1 ^ 0 * ξ.2 ^ 0 : ℝ) : ℂ) * η_hat ξ.1 * η_hat ξ.2 *
          Complex.exp (Complex.I *
            ((2 * Real.pi * (ξ.1 * z 0 + ξ.2 * z 1) : ℝ) : ℂ)) = val₀) →
      (∀ p q : ℕ, 1 ≤ p + q →
        ∫ ξ : ℝ × ℝ,
          ((ξ.1 ^ p * ξ.2 ^ q : ℝ) : ℂ) * η_hat ξ.1 * η_hat ξ.2 *
            Complex.exp (Complex.I *
              ((2 * Real.pi * (ξ.1 * z 0 + ξ.2 * z 1) : ℝ) : ℂ)) = 0) →
      ‖W_o z - val₀‖ ≤ C_W * (δ_small ^ N_tay + r_cut ^ N_tay) := by
    intro z hz_win val₀ h_int_00 h_int_pq
    let e_z : ℝ × ℝ → ℂ := fun ξ =>
      Complex.exp (Complex.I * ((2 * Real.pi * (ξ.1 * z 0 + ξ.2 * z 1) : ℝ) : ℂ))
    let μ_full : ℕ → ℕ → ℝ × ℝ → ℂ := fun p q ξ =>
      ((ξ.1 ^ p * ξ.2 ^ q : ℝ) : ℂ) * η_hat ξ.1 * η_hat ξ.2 * e_z ξ
    let μ_cut : ℕ → ℕ → ℝ × ℝ → ℂ := fun p q ξ =>
      ((χ₁ (r_cut * ξ.1) * χ₁ (r_cut * ξ.2) : ℝ) : ℂ) * μ_full p q ξ
    have hμ_full_norm : ∀ (p q : ℕ) (ξ : ℝ × ℝ),
        ‖μ_full p q ξ‖ = w1 p ξ.1 * w1 q ξ.2 := by
      intro p q ξ
      dsimp only [μ_full, e_z, w1]
      rw [norm_mul, norm_mul, norm_mul, Complex.norm_exp_I_mul_ofReal, mul_one,
        Complex.norm_real, Real.norm_eq_abs, abs_mul, abs_pow, abs_pow]
      ring
    have hμ_full_cont : ∀ p q : ℕ, Continuous (μ_full p q) := by
      intro p q
      dsimp only [μ_full, e_z]
      fun_prop
    have hμ_full_int : ∀ p q : ℕ, MeasureTheory.Integrable (μ_full p q) MeasureTheory.volume := by
      intro p q
      refine ((hη_int p).mul_prod (hη_int q)).mono' (hμ_full_cont p q).aestronglyMeasurable
        (Filter.Eventually.of_forall (fun ξ => ?_))
      rw [hμ_full_norm]
    have hμ_cut_int : ∀ p q : ℕ, MeasureTheory.Integrable (μ_cut p q) MeasureTheory.volume := by
      intro p q
      have hc : Continuous (μ_cut p q) :=
        (Complex.continuous_ofReal.comp
          ((hχ₁_cont.comp (continuous_const.mul continuous_fst)).mul
            (hχ₁_cont.comp (continuous_const.mul continuous_snd)))).mul
          (hμ_full_cont p q)
      refine ((hη_int p).mul_prod (hη_int q)).mono' hc.aestronglyMeasurable
        (Filter.Eventually.of_forall (fun ξ => ?_))
      obtain ⟨h_nn, h_le1⟩ := hχ_prod_01 ξ
      dsimp only [μ_cut]
      rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg h_nn, hμ_full_norm]
      exact mul_le_of_le_one_left (mul_nonneg (hw1_nn p ξ.1) (hw1_nn q ξ.2)) h_le1
    have hμ_tail : ∀ p q : ℕ,
        ‖(∫ ξ : ℝ × ℝ, μ_cut p q ξ) - (∫ ξ : ℝ × ℝ, μ_full p q ξ)‖ ≤
          r_cut ^ N_tay * E_tail p q := by
      intro p q
      let maj : ℝ × ℝ → ℝ := fun ξ =>
        r_cut ^ N_tay * (w1 (p + N_tay) ξ.1 * w1 q ξ.2 + w1 p ξ.1 * w1 (q + N_tay) ξ.2)
      have hmaj_int : MeasureTheory.Integrable maj MeasureTheory.volume :=
        ((hw_prod_int (p + N_tay) q).add (hw_prod_int p (q + N_tay))).const_mul (r_cut ^ N_tay)
      have hmaj_eq : (∫ ξ : ℝ × ℝ, maj ξ) = r_cut ^ N_tay * E_tail p q := by
        dsimp only [maj, E_tail]
        rw [MeasureTheory.integral_const_mul,
          MeasureTheory.integral_add (hw_prod_int (p + N_tay) q) (hw_prod_int p (q + N_tay)),
          hw_prod_eq (p + N_tay) q, hw_prod_eq p (q + N_tay)]
      have hpt : ∀ ξ : ℝ × ℝ, ‖μ_cut p q ξ - μ_full p q ξ‖ ≤ maj ξ := by
        intro ξ
        have hsub : μ_cut p q ξ - μ_full p q ξ =
            ((χ₁ (r_cut * ξ.1) * χ₁ (r_cut * ξ.2) - 1 : ℝ) : ℂ) * μ_full p q ξ := by
          dsimp only [μ_cut]
          push_cast
          ring
        rw [hsub, norm_mul, Complex.norm_real, Real.norm_eq_abs, hμ_full_norm]
        calc |χ₁ (r_cut * ξ.1) * χ₁ (r_cut * ξ.2) - 1| * (w1 p ξ.1 * w1 q ξ.2)
            ≤ (r_cut ^ N_tay * (|ξ.1| ^ N_tay + |ξ.2| ^ N_tay)) *
                (w1 p ξ.1 * w1 q ξ.2) :=
              mul_le_mul_of_nonneg_right (h_chi_diff ξ)
                (mul_nonneg (hw1_nn p ξ.1) (hw1_nn q ξ.2))
          _ = maj ξ := by
              dsimp only [maj, w1]
              rw [pow_add |ξ.1| p N_tay, pow_add |ξ.2| q N_tay]
              ring
      rw [← MeasureTheory.integral_sub (hμ_cut_int p q) (hμ_full_int p q)]
      calc ‖∫ ξ : ℝ × ℝ, (μ_cut p q ξ - μ_full p q ξ)‖
          ≤ ∫ ξ : ℝ × ℝ, ‖μ_cut p q ξ - μ_full p q ξ‖ :=
            MeasureTheory.norm_integral_le_integral_norm _
        _ ≤ ∫ ξ : ℝ × ℝ, maj ξ :=
            MeasureTheory.integral_mono ((hμ_cut_int p q).sub (hμ_full_int p q)).norm hmaj_int hpt
        _ = r_cut ^ N_tay * E_tail p q := hmaj_eq

    
    let G_z : ℝ × ℝ → ℂ := fun u =>
      Complex.exp (Complex.I *
        ((ΔΘ_o u z - 2 * Real.pi * (u.1 * z 0 + u.2 * z 1) : ℝ) : ℂ))
    obtain ⟨hG0, hG_sm, hG_poly, hG_rem⟩ := hG_z z hz_win
    let c_coeff : (m : ℕ) → (Fin m → Bool) → ℂ := fun m =>
      if hm : 1 ≤ m ∧ m < N_tay then Classical.choose (hG_poly m hm.1 hm.2) else fun _ => 0
    have hc_spec : ∀ m : ℕ, 1 ≤ m → m < N_tay →
        (∀ b : Fin m → Bool, ‖c_coeff m b‖ ≤ C_u_coeff m) ∧
        (∀ ξ : ℝ × ℝ,
          ((m.factorial : ℝ)⁻¹) • iteratedDeriv m (fun s : ℝ => G_z (s • ξ)) 0 =
            ∑ b : Fin m → Bool,
              c_coeff m b *
                ((ξ.1 ^ (Finset.univ.filter (fun i => b i = true)).card *
                  ξ.2 ^ (Finset.univ.filter (fun i => b i = false)).card : ℝ) : ℂ)) := by
      intro m hm1 hm2
      have h_eq : c_coeff m = Classical.choose (hG_poly m hm1 hm2) := by
        simp [c_coeff, hm1, hm2]
      rw [h_eq]
      exact Classical.choose_spec (hG_poly m hm1 hm2)
    let P_z : ℝ × ℝ → ℂ := fun ξ =>
      (1 : ℂ) + ∑ m ∈ Finset.Ico 1 N_tay,
        ∑ b : Fin m → Bool,
          c_coeff m b *
            ((ξ.1 ^ (Finset.univ.filter (fun i => b i = true)).card *
              ξ.2 ^ (Finset.univ.filter (fun i => b i = false)).card : ℝ) : ℂ)
    have h_tay_box : ∀ ξ : ℝ × ℝ, |ξ.1| ≤ 2 * r_cut⁻¹ → |ξ.2| ≤ 2 * r_cut⁻¹ →
        ‖G_z ξ - P_z ξ‖ ≤ C_rem * δ_small ^ N_tay := by
      intro ξ hξ1 hξ2
      let F : ℝ → ℂ := fun s => G_z (s • ξ)
      have hF_sm : ∀ k : ℕ, ContDiff ℝ k F := fun k =>
        (hG_sm k).comp (contDiff_id.smul contDiff_const)
      have hF0 : F 0 = 1 := by
        dsimp only [F]; rw [zero_smul]; exact hG0
      have hF1 : F 1 = G_z ξ := by
        dsimp only [F]; rw [one_smul]
      let n₀ : ℕ := N_tay - 1
      have hn₀ : n₀ + 1 = N_tay := Nat.sub_add_cancel (by omega)
      let E_rem : ℝ := C_rem * δ_small ^ N_tay
      have hE_nn : 0 ≤ E_rem := mul_nonneg hCrem (pow_nonneg hδ_nn N_tay)
      have hu : UniqueDiffOn ℝ (Set.Icc (0 : ℝ) 1) := uniqueDiffOn_Icc zero_lt_one
      have h_idw : ∀ (k : ℕ), ∀ y ∈ Set.Icc (0 : ℝ) 1,
          iteratedDerivWithin k F (Set.Icc 0 1) y = iteratedDeriv k F y :=
        fun k y hy => iteratedDerivWithin_eq_iteratedDeriv hu (hF_sm k).contDiffAt hy
      have h_on : ContDiffOn ℝ (n₀ + 1) F (Set.Icc 0 1) := by
        exact_mod_cast (hF_sm (n₀ + 1)).contDiffOn
      have h_tay := taylor_mean_remainder_bound (a := (0 : ℝ)) (b := 1) (C := E_rem) (x := 1)
        (n := n₀) zero_le_one h_on ⟨zero_le_one, le_rfl⟩
        (fun y hy => by
          rw [h_idw (n₀ + 1) y hy, hn₀]
          exact hG_rem ξ hξ1 hξ2 y hy)
      have h_rhs : E_rem * (1 - (0 : ℝ)) ^ (n₀ + 1) / (n₀.factorial : ℝ) ≤ E_rem := by
        rw [sub_zero, one_pow, mul_one]
        exact div_le_self hE_nn (by exact_mod_cast Nat.factorial_pos n₀)
      have h_eval : taylorWithinEval F n₀ (Set.Icc 0 1) 0 1 = P_z ξ := by
        rw [taylor_within_apply, hn₀]
        have h0_mem : (0 : ℝ) ∈ Set.Icc (0 : ℝ) 1 := ⟨le_rfl, zero_le_one⟩
        have h_sum_eq : (∑ k ∈ Finset.range N_tay,
            ((k.factorial : ℝ)⁻¹ * (1 - (0 : ℝ)) ^ k) •
              iteratedDerivWithin k F (Set.Icc 0 1) 0) =
            ∑ k ∈ Finset.Ico 0 N_tay, ((k.factorial : ℝ)⁻¹) • iteratedDeriv k F 0 := by
          rw [Nat.Ico_zero_eq_range]
          refine Finset.sum_congr rfl (fun k _ => ?_)
          rw [sub_zero, one_pow, mul_one, h_idw k 0 h0_mem]
        rw [h_sum_eq, Finset.sum_eq_sum_Ico_succ_bot (by omega : 0 < N_tay)]
        have h0_term : (((0 : ℕ).factorial : ℝ)⁻¹) • iteratedDeriv 0 F 0 = (1 : ℂ) := by
          simp [hF0]
        rw [h0_term]
        dsimp only [P_z]
        congr 1
        refine Finset.sum_congr rfl (fun m hm => ?_)
        obtain ⟨hm1, hm2⟩ := Finset.mem_Ico.mp hm
        exact (hc_spec m hm1 hm2).2 ξ
      rw [← hF1, ← h_eval]
      exact h_tay.trans h_rhs

    
    let S_cut : ℂ := (∫ ξ : ℝ × ℝ, μ_cut 0 0 ξ) +
      ∑ m ∈ Finset.Ico 1 N_tay,
        ∑ b : Fin m → Bool,
          c_coeff m b *
            ∫ ξ : ℝ × ℝ,
              μ_cut (Finset.univ.filter (fun i => b i = true)).card
                    (Finset.univ.filter (fun i => b i = false)).card ξ
    have hP_exp : (fun ξ : ℝ × ℝ => α ξ * P_z ξ * e_z ξ) =
        fun ξ : ℝ × ℝ => μ_cut 0 0 ξ +
          ∑ m ∈ Finset.Ico 1 N_tay,
            ∑ b : Fin m → Bool,
              c_coeff m b *
                μ_cut (Finset.univ.filter (fun i => b i = true)).card
                      (Finset.univ.filter (fun i => b i = false)).card ξ := by
      ext ξ
      dsimp only [α, P_z, μ_cut, μ_full]
      rw [pow_zero, pow_zero, mul_one]
      push_cast
      rw [mul_add, add_mul, Finset.mul_sum, Finset.sum_mul]
      congr 1
      · ring
      · refine Finset.sum_congr rfl (fun m _ => ?_)
        rw [Finset.mul_sum, Finset.sum_mul]
        refine Finset.sum_congr rfl (fun b _ => ?_)
        ring
    have hP_int : MeasureTheory.Integrable
        (fun ξ : ℝ × ℝ => α ξ * P_z ξ * e_z ξ) MeasureTheory.volume := by
      rw [hP_exp]
      refine (hμ_cut_int 0 0).add (MeasureTheory.integrable_finsetSum _ (fun m _ => ?_))
      exact MeasureTheory.integrable_finsetSum _ (fun b _ => (hμ_cut_int _ _).const_mul _)
    have hP_integral : (∫ ξ : ℝ × ℝ, α ξ * P_z ξ * e_z ξ) = S_cut := by
      rw [hP_exp]
      have h_sum_int : MeasureTheory.Integrable
          (fun ξ : ℝ × ℝ => ∑ m ∈ Finset.Ico 1 N_tay, ∑ b : Fin m → Bool,
            c_coeff m b *
              μ_cut (Finset.univ.filter (fun i => b i = true)).card
                    (Finset.univ.filter (fun i => b i = false)).card ξ)
          MeasureTheory.volume :=
        MeasureTheory.integrable_finsetSum _ (fun m _ =>
          MeasureTheory.integrable_finsetSum _ (fun b _ => (hμ_cut_int _ _).const_mul _))
      rw [MeasureTheory.integral_add (hμ_cut_int 0 0) h_sum_int,
        MeasureTheory.integral_finsetSum _ (fun m _ =>
          MeasureTheory.integrable_finsetSum _ (fun b _ => (hμ_cut_int _ _).const_mul _))]
      dsimp only [S_cut]
      congr 1
      refine Finset.sum_congr rfl (fun m _ => ?_)
      rw [MeasureTheory.integral_finsetSum _ (fun b _ => (hμ_cut_int _ _).const_mul _)]
      refine Finset.sum_congr rfl (fun b _ => ?_)
      exact MeasureTheory.integral_const_mul _ _

    
    have h_tay_err : ‖W_o z - S_cut‖ ≤ C_tay * δ_small ^ N_tay := by
      have hW_eq : W_o z = ∫ ξ : ℝ × ℝ, α ξ * h_fn ξ z := rfl
      rw [hW_eq, ← hP_integral, ← MeasureTheory.integral_sub (hW_int z) hP_int]
      let maj_tay : ℝ × ℝ → ℝ := fun ξ => (C_rem * δ_small ^ N_tay) * (w1 0 ξ.1 * w1 0 ξ.2)
      have hmaj_int : MeasureTheory.Integrable maj_tay MeasureTheory.volume :=
        ((hη_int 0).mul_prod (hη_int 0)).const_mul (C_rem * δ_small ^ N_tay)
      have hpt : ∀ ξ : ℝ × ℝ, ‖α ξ * h_fn ξ z - α ξ * P_z ξ * e_z ξ‖ ≤ maj_tay ξ := by
        intro ξ
        have hh_fac : h_fn ξ z = G_z ξ * e_z ξ := by
          dsimp only [h_fn, G_z, e_z]
          rw [← Complex.exp_add]
          congr 1
          push_cast
          ring
        have hdiff : α ξ * h_fn ξ z - α ξ * P_z ξ * e_z ξ =
            α ξ * (G_z ξ - P_z ξ) * e_z ξ := by
          rw [hh_fac]; ring
        rw [hdiff]
        by_cases hα0 : α ξ = 0
        · rw [hα0, zero_mul, zero_mul, norm_zero]
          exact mul_nonneg (mul_nonneg hCrem (pow_nonneg hδ_nn N_tay))
            (mul_nonneg (hw1_nn 0 ξ.1) (hw1_nn 0 ξ.2))
        · have hχ1_ne : χ₁ (r_cut * ξ.1) ≠ 0 := by
            intro h0; apply hα0; dsimp [α]; simp [h0]
          have hχ2_ne : χ₁ (r_cut * ξ.2) ≠ 0 := by
            intro h0; apply hα0; dsimp [α]; simp [h0]
          have h1_lt : |r_cut * ξ.1| < 2 := by
            by_contra hge; exact hχ1_ne (hχ₁_zero _ (not_lt.mp hge))
          have h2_lt : |r_cut * ξ.2| < 2 := by
            by_contra hge; exact hχ2_ne (hχ₁_zero _ (not_lt.mp hge))
          have hξ1_le : |ξ.1| ≤ 2 * r_cut⁻¹ := by
            rw [abs_mul, abs_of_pos hr_pos] at h1_lt
            have hm := mul_le_mul_of_nonneg_left h1_lt.le (inv_nonneg.mpr hr_pos.le)
            rwa [← mul_assoc, inv_mul_cancel₀ (ne_of_gt hr_pos), one_mul, mul_comm] at hm
          have hξ2_le : |ξ.2| ≤ 2 * r_cut⁻¹ := by
            rw [abs_mul, abs_of_pos hr_pos] at h2_lt
            have hm := mul_le_mul_of_nonneg_left h2_lt.le (inv_nonneg.mpr hr_pos.le)
            rwa [← mul_assoc, inv_mul_cancel₀ (ne_of_gt hr_pos), one_mul, mul_comm] at hm
          rw [norm_mul, norm_mul, Complex.norm_exp_I_mul_ofReal, mul_one]
          calc ‖α ξ‖ * ‖G_z ξ - P_z ξ‖
              ≤ (w1 0 ξ.1 * w1 0 ξ.2) * (C_rem * δ_small ^ N_tay) :=
                mul_le_mul (hα_bd ξ) (h_tay_box ξ hξ1_le hξ2_le)
                  (norm_nonneg _) (mul_nonneg (hw1_nn 0 ξ.1) (hw1_nn 0 ξ.2))
            _ = maj_tay ξ := by dsimp only [maj_tay]; ring
      calc ‖∫ ξ : ℝ × ℝ, (α ξ * h_fn ξ z - α ξ * P_z ξ * e_z ξ)‖
          ≤ ∫ ξ : ℝ × ℝ, ‖α ξ * h_fn ξ z - α ξ * P_z ξ * e_z ξ‖ :=
            MeasureTheory.norm_integral_le_integral_norm _
        _ ≤ ∫ ξ : ℝ × ℝ, maj_tay ξ :=
            MeasureTheory.integral_mono ((hW_int z).sub hP_int).norm hmaj_int hpt
        _ = C_tay * δ_small ^ N_tay := by
            dsimp only [maj_tay, C_tay]
            rw [MeasureTheory.integral_const_mul, hw_prod_eq 0 0]
            ring

    
    have h_card_sum : ∀ (m : ℕ) (b : Fin m → Bool),
        (Finset.univ.filter (fun i => b i = true)).card +
          (Finset.univ.filter (fun i => b i = false)).card = m := by
      intro m b
      have h_eq : (Finset.univ.filter (fun i : Fin m => b i = false)) =
          Finset.univ.filter (fun i : Fin m => ¬ (b i = true)) := by
        ext i; simp
      rw [h_eq, Finset.card_filter_add_card_filter_not, Finset.card_univ, Fintype.card_fin]
    have h_cut_err : ‖S_cut - val₀‖ ≤ C_cut * r_cut ^ N_tay := by
      have h_sub_eq : S_cut - val₀ =
          ((∫ ξ : ℝ × ℝ, μ_cut 0 0 ξ) - (∫ ξ : ℝ × ℝ, μ_full 0 0 ξ)) +
            ∑ m ∈ Finset.Ico 1 N_tay,
              ∑ b : Fin m → Bool,
                c_coeff m b *
                  ((∫ ξ : ℝ × ℝ,
                      μ_cut (Finset.univ.filter (fun i => b i = true)).card
                            (Finset.univ.filter (fun i => b i = false)).card ξ) -
                   (∫ ξ : ℝ × ℝ,
                      μ_full (Finset.univ.filter (fun i => b i = true)).card
                             (Finset.univ.filter (fun i => b i = false)).card ξ)) := by
        dsimp only [S_cut]
        have h00' : (∫ ξ : ℝ × ℝ, μ_full 0 0 ξ) = val₀ := h_int_00
        rw [h00']
        have h_sum_eq : (∑ m ∈ Finset.Ico 1 N_tay,
            ∑ b : Fin m → Bool,
              c_coeff m b *
                ((∫ ξ : ℝ × ℝ,
                    μ_cut (Finset.univ.filter (fun i => b i = true)).card
                          (Finset.univ.filter (fun i => b i = false)).card ξ) -
                 (∫ ξ : ℝ × ℝ,
                    μ_full (Finset.univ.filter (fun i => b i = true)).card
                           (Finset.univ.filter (fun i => b i = false)).card ξ))) =
            ∑ m ∈ Finset.Ico 1 N_tay,
              ∑ b : Fin m → Bool,
                c_coeff m b *
                  ∫ ξ : ℝ × ℝ,
                    μ_cut (Finset.univ.filter (fun i => b i = true)).card
                          (Finset.univ.filter (fun i => b i = false)).card ξ := by
          refine Finset.sum_congr rfl (fun m hm => ?_)
          obtain ⟨hm1, _⟩ := Finset.mem_Ico.mp hm
          refine Finset.sum_congr rfl (fun b _ => ?_)
          have hpq : 1 ≤ (Finset.univ.filter (fun i => b i = true)).card +
              (Finset.univ.filter (fun i => b i = false)).card := by
            rw [h_card_sum m b]; exact hm1
          have h0 : (∫ ξ : ℝ × ℝ,
              μ_full (Finset.univ.filter (fun i => b i = true)).card
                     (Finset.univ.filter (fun i => b i = false)).card ξ) = 0 :=
            h_int_pq _ _ hpq
          rw [h0, sub_zero]
        rw [h_sum_eq]
        ring
      rw [h_sub_eq]
      have h_sum_bd : ‖∑ m ∈ Finset.Ico 1 N_tay,
            ∑ b : Fin m → Bool,
              c_coeff m b *
                ((∫ ξ : ℝ × ℝ,
                    μ_cut (Finset.univ.filter (fun i => b i = true)).card
                          (Finset.univ.filter (fun i => b i = false)).card ξ) -
                 (∫ ξ : ℝ × ℝ,
                    μ_full (Finset.univ.filter (fun i => b i = true)).card
                           (Finset.univ.filter (fun i => b i = false)).card ξ))‖ ≤
          ∑ m ∈ Finset.Ico 1 N_tay,
            (C_u_coeff m *
              ∑ b : Fin m → Bool,
                E_tail (Finset.univ.filter (fun i => b i = true)).card
                       (Finset.univ.filter (fun i => b i = false)).card) *
              r_cut ^ N_tay := by
        refine le_trans (norm_sum_le _ _) (Finset.sum_le_sum (fun m hm => ?_))
        obtain ⟨hm1, hm2⟩ := Finset.mem_Ico.mp hm
        refine le_trans (norm_sum_le _ _) ?_
        calc ∑ b : Fin m → Bool,
              ‖c_coeff m b *
                ((∫ ξ : ℝ × ℝ,
                    μ_cut (Finset.univ.filter (fun i => b i = true)).card
                          (Finset.univ.filter (fun i => b i = false)).card ξ) -
                 (∫ ξ : ℝ × ℝ,
                    μ_full (Finset.univ.filter (fun i => b i = true)).card
                           (Finset.univ.filter (fun i => b i = false)).card ξ))‖
            ≤ ∑ b : Fin m → Bool,
                C_u_coeff m *
                  (r_cut ^ N_tay *
                    E_tail (Finset.univ.filter (fun i => b i = true)).card
                           (Finset.univ.filter (fun i => b i = false)).card) := by
              refine Finset.sum_le_sum (fun b _ => ?_)
              rw [norm_mul]
              exact mul_le_mul ((hc_spec m hm1 hm2).1 b) (hμ_tail _ _)
                (norm_nonneg _) (hCu m)
          _ = (C_u_coeff m *
                ∑ b : Fin m → Bool,
                  E_tail (Finset.univ.filter (fun i => b i = true)).card
                         (Finset.univ.filter (fun i => b i = false)).card) *
                r_cut ^ N_tay := by
              rw [Finset.mul_sum, Finset.sum_mul]
              refine Finset.sum_congr rfl (fun b _ => ?_)
              ring
      calc ‖((∫ ξ : ℝ × ℝ, μ_cut 0 0 ξ) - (∫ ξ : ℝ × ℝ, μ_full 0 0 ξ)) +
              ∑ m ∈ Finset.Ico 1 N_tay,
                ∑ b : Fin m → Bool,
                  c_coeff m b *
                    ((∫ ξ : ℝ × ℝ,
                        μ_cut (Finset.univ.filter (fun i => b i = true)).card
                              (Finset.univ.filter (fun i => b i = false)).card ξ) -
                     (∫ ξ : ℝ × ℝ,
                        μ_full (Finset.univ.filter (fun i => b i = true)).card
                               (Finset.univ.filter (fun i => b i = false)).card ξ))‖
          ≤ ‖(∫ ξ : ℝ × ℝ, μ_cut 0 0 ξ) - (∫ ξ : ℝ × ℝ, μ_full 0 0 ξ)‖ +
              ‖∑ m ∈ Finset.Ico 1 N_tay,
                ∑ b : Fin m → Bool,
                  c_coeff m b *
                    ((∫ ξ : ℝ × ℝ,
                        μ_cut (Finset.univ.filter (fun i => b i = true)).card
                              (Finset.univ.filter (fun i => b i = false)).card ξ) -
                     (∫ ξ : ℝ × ℝ,
                        μ_full (Finset.univ.filter (fun i => b i = true)).card
                               (Finset.univ.filter (fun i => b i = false)).card ξ))‖ :=
            norm_add_le _ _
        _ ≤ r_cut ^ N_tay * E_tail 0 0 +
              ∑ m ∈ Finset.Ico 1 N_tay,
                (C_u_coeff m *
                  ∑ b : Fin m → Bool,
                    E_tail (Finset.univ.filter (fun i => b i = true)).card
                           (Finset.univ.filter (fun i => b i = false)).card) *
                  r_cut ^ N_tay :=
            add_le_add (hμ_tail 0 0) h_sum_bd
        _ = C_cut * r_cut ^ N_tay := by
            dsimp only [C_cut]
            rw [add_mul, Finset.sum_mul]
            ring

    
    have h_tri : ‖W_o z - val₀‖ ≤ ‖W_o z - S_cut‖ + ‖S_cut - val₀‖ := by
      have heq : W_o z - val₀ = (W_o z - S_cut) + (S_cut - val₀) := by ring
      rw [heq]
      exact norm_add_le _ _
    have hδ_pow_nn : 0 ≤ δ_small ^ N_tay := pow_nonneg hδ_nn N_tay
    have hr_pow_nn : 0 ≤ r_cut ^ N_tay := pow_nonneg hr_pos.le N_tay
    dsimp only [C_W]
    nlinarith [h_tri, h_tay_err, h_cut_err, hCtay_nn, hCcut_nn, hδ_pow_nn, hr_pow_nn]

  refine ⟨hW_smooth, hW_fderiv_bd, ?_, ?_⟩
  · intro z hz_win hz_in
    refine h_approx z hz_win 1 ?_ (hη_in z hz_in).2
    have h0 : (fun ξ : ℝ × ℝ =>
        ((ξ.1 ^ 0 * ξ.2 ^ 0 : ℝ) : ℂ) * η_hat ξ.1 * η_hat ξ.2 *
          Complex.exp (Complex.I *
            ((2 * Real.pi * (ξ.1 * z 0 + ξ.2 * z 1) : ℝ) : ℂ))) =
        fun ξ : ℝ × ℝ =>
          η_hat ξ.1 * η_hat ξ.2 *
            Complex.exp (Complex.I *
              ((2 * Real.pi * (ξ.1 * z 0 + ξ.2 * z 1) : ℝ) : ℂ)) := by
      ext ξ; simp
    rw [h0]
    exact (hη_in z hz_in).1
  · intro z hz_win hz_out
    have h_res := h_approx z hz_win 0 (hη_out z hz_out 0 0) (fun p q _ => hη_out z hz_out p q)
    rwa [sub_zero] at h_res

theorem fubini_pairing_transfer_and_l2_window_error (Φ₀ : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → ℝ)
    (hΦ₀_cont : Continuous Φ₀)
    (lam_sys ρ_t C_t R_win R_supp_in R_in M_0 E_err : ℝ)
    (hρ_t : 0 < ρ_t) (hR_win : 0 < R_win)
    (hM_0 : 0 ≤ M_0) (hE_err : 0 ≤ E_err)
    (V_o X_o : EuclideanSpace ℝ (Fin 2))
    (ψ_o W_o χ_ann : EuclideanSpace ℝ (Fin 2) → ℂ)
    (hψ_cont : Continuous ψ_o) (hW_cont : Continuous W_o) (hχ_cont : Continuous χ_ann)
    (hψ_supp : ∀ z : EuclideanSpace ℝ (Fin 2), R_win ≤ ‖z‖ → ψ_o z = 0)
    (hψ_bd : ∀ z : EuclideanSpace ℝ (Fin 2), ‖ψ_o z‖ ≤ M_0)
    (hχ_one : ∀ z : EuclideanSpace ℝ (Fin 2), ‖z‖ ≤ R_in → χ_ann z = 1)
    (hχ_sub_bd : ∀ z : EuclideanSpace ℝ (Fin 2), ‖(1 : ℂ) - χ_ann z‖ ≤ 1)
    (hW_in : ∀ z : EuclideanSpace ℝ (Fin 2),
      ‖z‖ ≤ R_win → ‖z‖ ≤ R_supp_in → ‖W_o z - 1‖ ≤ E_err)
    (hW_out : ∀ z : EuclideanSpace ℝ (Fin 2),
      ‖z‖ ≤ R_win → R_in ≤ ‖z‖ → ‖W_o z‖ ≤ E_err)
    (α_wt : ℝ × ℝ → ℂ) (x_of : ℝ × ℝ → EuclideanSpace ℝ (Fin 2))
    (hα_cont : Continuous α_wt)
    (hα_int : MeasureTheory.Integrable α_wt MeasureTheory.volume)
    (hx_cont : Continuous x_of)
    (hW_rep : ∀ z : EuclideanSpace ℝ (Fin 2),
      W_o z = ∫ ξ : ℝ × ℝ,
        α_wt ξ * Complex.exp (Complex.I *
          ((lam_sys * (Φ₀ (C_t, x_of ξ, V_o + ρ_t • z) -
            Φ₀ (C_t, X_o, V_o + ρ_t • z) -
            Φ₀ (C_t, x_of ξ, V_o) +
            Φ₀ (C_t, X_o, V_o)) : ℝ) : ℂ)))
    (H_all H_in : EuclideanSpace ℝ (Fin 2) → ℂ)
    (hHall_meas : MeasureTheory.AEStronglyMeasurable H_all MeasureTheory.volume)
    (hHall_l2 : MeasureTheory.MemLp H_all 2 MeasureTheory.volume)
    (hHin_meas : MeasureTheory.AEStronglyMeasurable H_in MeasureTheory.volume)
    (hHin_l2 : MeasureTheory.MemLp H_in 2 MeasureTheory.volume)
    (hHin_supp : ∀ v : EuclideanSpace ℝ (Fin 2), R_supp_in * ρ_t ≤ ‖v - V_o‖ → H_in v = 0)
    (h_pair_eq : ∀ ξ : ℝ × ℝ, α_wt ξ ≠ 0 →
      ∫ v : EuclideanSpace ℝ (Fin 2),
        H_all v * ψ_o (ρ_t⁻¹ • (v - V_o)) *
          Complex.exp (Complex.I * ((lam_sys * Φ₀ (C_t, x_of ξ, v) : ℝ) : ℂ)) =
      ∫ v : EuclideanSpace ℝ (Fin 2),
        H_in v * ψ_o (ρ_t⁻¹ • (v - V_o)) *
          Complex.exp (Complex.I * ((lam_sys * Φ₀ (C_t, x_of ξ, v) : ℝ) : ℂ))) :
    let ψ_loc : EuclideanSpace ℝ (Fin 2) → ℂ := fun z => χ_ann z * W_o z * ψ_o z
    ‖((ρ_t⁻¹ : ℂ) * ∫ v : EuclideanSpace ℝ (Fin 2),
        H_in v * ψ_o (ρ_t⁻¹ • (v - V_o)) *
          Complex.exp (Complex.I * ((lam_sys * Φ₀ (C_t, X_o, v) : ℝ) : ℂ))) -
     ((ρ_t⁻¹ : ℂ) * ∫ v : EuclideanSpace ℝ (Fin 2),
        H_all v * ψ_loc (ρ_t⁻¹ • (v - V_o)) *
          Complex.exp (Complex.I * ((lam_sys * Φ₀ (C_t, X_o, v) : ℝ) : ℂ)))‖ ≤
      (Real.sqrt Real.pi * R_win * M_0 * E_err) *
        (Real.sqrt (∫ v, ‖H_in v‖ ^ 2) + Real.sqrt (∫ v, ‖H_all v‖ ^ 2)) :=
by
  intro ψ_loc
  let z_of : EuclideanSpace ℝ (Fin 2) → EuclideanSpace ℝ (Fin 2) := fun v => ρ_t⁻¹ • (v - V_o)
  let e_X : EuclideanSpace ℝ (Fin 2) → ℂ :=
    fun v => Complex.exp (Complex.I * ((lam_sys * Φ₀ (C_t, X_o, v) : ℝ) : ℂ))
  have hρ_inv_pos : 0 < ρ_t⁻¹ := inv_pos.mpr hρ_t
  have hρ_ne : ρ_t ≠ 0 := hρ_t.ne'
  have hz_cont : Continuous z_of :=
    (continuous_const : Continuous (fun _ : EuclideanSpace ℝ (Fin 2) => ρ_t⁻¹)).smul
      (continuous_id.sub continuous_const)
  have heX_cont : Continuous e_X :=
    Complex.continuous_exp.comp
      (continuous_const.mul
        (Complex.continuous_ofReal.comp
          (continuous_const.mul
            (hΦ₀_cont.comp (continuous_const.prodMk (continuous_const.prodMk continuous_id))))))
  have heX_norm : ∀ v : EuclideanSpace ℝ (Fin 2), ‖e_X v‖ = 1 :=
    fun v => Complex.norm_exp_I_mul_ofReal _
  have hz_inv : ∀ v : EuclideanSpace ℝ (Fin 2), V_o + ρ_t • z_of v = v := by
    intro v
    dsimp only [z_of]
    rw [smul_smul, mul_inv_cancel₀ hρ_ne, one_smul, add_sub_cancel]
  have hz_norm : ∀ v : EuclideanSpace ℝ (Fin 2), ‖z_of v‖ = ρ_t⁻¹ * ‖v - V_o‖ := by
    intro v
    dsimp only [z_of]
    rw [norm_smul, Real.norm_of_nonneg hρ_inv_pos.le]
  have hz_le_of_le : ∀ {R : ℝ} {v : EuclideanSpace ℝ (Fin 2)},
      ‖v - V_o‖ ≤ R * ρ_t → ‖z_of v‖ ≤ R := by
    intro R v hv
    rw [hz_norm v]
    calc ρ_t⁻¹ * ‖v - V_o‖
        ≤ ρ_t⁻¹ * (R * ρ_t) := mul_le_mul_of_nonneg_left hv hρ_inv_pos.le
      _ = R * (ρ_t⁻¹ * ρ_t) := by ring
      _ = R := by rw [inv_mul_cancel₀ hρ_ne, mul_one]
  have hψ_z_supp : ∀ v : EuclideanSpace ℝ (Fin 2),
      R_win * ρ_t < ‖v - V_o‖ → ψ_o (z_of v) = 0 := by
    intro v hv
    apply hψ_supp
    by_contra hlt
    have hle : ‖z_of v‖ ≤ R_win := le_of_not_ge hlt
    rw [hz_norm v] at hle
    have hv_le : ‖v - V_o‖ ≤ R_win * ρ_t := by
      calc ‖v - V_o‖ = ρ_t * (ρ_t⁻¹ * ‖v - V_o‖) := by
            rw [← mul_assoc, mul_inv_cancel₀ hρ_ne, one_mul]
        _ ≤ ρ_t * R_win := mul_le_mul_of_nonneg_left hle hρ_t.le
        _ = R_win * ρ_t := mul_comm _ _
    exact hv.not_ge hv_le

  let B_W : ℝ := ∫ ξ : ℝ × ℝ, ‖α_wt ξ‖
  have hBW_nn : 0 ≤ B_W := MeasureTheory.integral_nonneg (fun ξ => norm_nonneg (α_wt ξ))
  have hW_bd_glob : ∀ z : EuclideanSpace ℝ (Fin 2), ‖W_o z‖ ≤ B_W := by
    intro z
    rw [hW_rep z]
    refine le_trans (MeasureTheory.norm_integral_le_integral_norm _) (le_of_eq ?_)
    dsimp only [B_W]
    congr 1
    ext ξ
    rw [norm_mul, Complex.norm_exp_I_mul_ofReal, mul_one]
  have hχ_bd_glob : ∀ z : EuclideanSpace ℝ (Fin 2), ‖χ_ann z‖ ≤ 2 := by
    intro z
    have heq : χ_ann z = (1 : ℂ) - ((1 : ℂ) - χ_ann z) := (sub_sub_cancel 1 (χ_ann z)).symm
    rw [heq]
    calc ‖(1 : ℂ) - ((1 : ℂ) - χ_ann z)‖
        ≤ ‖(1 : ℂ)‖ + ‖(1 : ℂ) - χ_ann z‖ := norm_sub_le _ _
      _ ≤ 1 + 1 := by
          rw [norm_one]
          exact add_le_add le_rfl (hχ_sub_bd z)
      _ = 2 := by norm_num

  
  have h_l2_ball : ∀ (K : ℝ), 0 ≤ K →
      ∀ (H F : EuclideanSpace ℝ (Fin 2) → ℂ),
        MeasureTheory.MemLp H 2 MeasureTheory.volume →
        MeasureTheory.AEStronglyMeasurable F MeasureTheory.volume →
        (∀ v : EuclideanSpace ℝ (Fin 2), R_win * ρ_t < ‖v - V_o‖ → F v = 0) →
        (∀ v : EuclideanSpace ℝ (Fin 2), ‖F v‖ ≤ K * ‖H v‖) →
        MeasureTheory.Integrable F MeasureTheory.volume ∧
        ‖(ρ_t⁻¹ : ℂ) * ∫ v : EuclideanSpace ℝ (Fin 2), F v‖ ≤
          (Real.sqrt Real.pi * R_win * K) * Real.sqrt (∫ v, ‖H v‖ ^ 2) := by
    intro K hK H F hH_l2 hF_meas hF_supp hF_bd
    let R : ℝ := R_win * ρ_t
    have hR_pos : 0 < R := mul_pos hR_win hρ_t
    let B_o : Set (EuclideanSpace ℝ (Fin 2)) := Metric.closedBall V_o R
    have hBo_meas : MeasurableSet B_o := measurableSet_closedBall
    have hBo_ne_top : MeasureTheory.volume B_o ≠ ⊤ := MeasureTheory.measure_closedBall_lt_top.ne
    let ind_K : EuclideanSpace ℝ (Fin 2) → ℝ := B_o.indicator (fun _ => K)
    have h_ind_l2 : MeasureTheory.MemLp ind_K 2 MeasureTheory.volume :=
      MeasureTheory.memLp_indicator_const 2 hBo_meas K (Or.inr hBo_ne_top)
    have hH_norm_l2 : MeasureTheory.MemLp (fun v => ‖H v‖) 2 MeasureTheory.volume := hH_l2.norm
    have h_dom_int : MeasureTheory.Integrable (fun v => ind_K v * ‖H v‖) MeasureTheory.volume := by
      simpa only [Pi.mul_def] using h_ind_l2.integrable_mul hH_norm_l2
    have h_dom : ∀ v : EuclideanSpace ℝ (Fin 2), ‖F v‖ ≤ ind_K v * ‖H v‖ := by
      intro v
      by_cases hv : v ∈ B_o
      · dsimp only [ind_K]
        rw [Set.indicator_of_mem hv]
        exact hF_bd v
      · dsimp only [ind_K]
        rw [Set.indicator_of_notMem hv, zero_mul]
        have hv_out : R < ‖v - V_o‖ := by
          rw [Metric.mem_closedBall, dist_eq_norm] at hv
          exact lt_of_not_ge hv
        rw [hF_supp v hv_out, norm_zero]
    have hF_int : MeasureTheory.Integrable F MeasureTheory.volume :=
      h_dom_int.mono' hF_meas (Filter.Eventually.of_forall h_dom)
    refine ⟨hF_int, ?_⟩
    have h_ind_nn : ∀ v : EuclideanSpace ℝ (Fin 2), 0 ≤ ind_K v :=
      fun v => Set.indicator_nonneg (fun _ _ => hK) v
    have h_ind_l2' : MeasureTheory.MemLp ind_K (ENNReal.ofReal (2 : ℝ)) MeasureTheory.volume := by
      rwa [ENNReal.ofReal_ofNat]
    have hH_norm_l2' :
        MeasureTheory.MemLp (fun v => ‖H v‖) (ENNReal.ofReal (2 : ℝ)) MeasureTheory.volume := by
      rwa [ENNReal.ofReal_ofNat]
    have h_holder := MeasureTheory.integral_mul_le_Lp_mul_Lq_of_nonneg
      Real.HolderConjugate.two_two
      (Filter.Eventually.of_forall h_ind_nn)
      (Filter.Eventually.of_forall (fun v => norm_nonneg (H v)))
      h_ind_l2' hH_norm_l2'
    simp_rw [Real.rpow_two, ← Real.sqrt_eq_rpow] at h_holder
    have h_ind_sq : (∫ v : EuclideanSpace ℝ (Fin 2), ind_K v ^ 2) =
        (Real.sqrt Real.pi * R_win * ρ_t * K) ^ 2 := by
      have h_fn : (fun v => ind_K v ^ 2) = B_o.indicator (fun _ => K ^ 2) := by
        ext v
        by_cases hv : v ∈ B_o <;> simp [ind_K, hv]
      have h_vol : (MeasureTheory.volume B_o).toReal = R ^ 2 * Real.pi := by
        rw [EuclideanSpace.volume_closedBall_fin_two V_o R,
          ← ENNReal.ofReal_pow hR_pos.le 2,
          ← ENNReal.ofReal_mul (sq_nonneg R),
          ENNReal.toReal_ofReal (mul_nonneg (sq_nonneg R) Real.pi_pos.le)]
      rw [h_fn, MeasureTheory.integral_indicator_const (K ^ 2) hBo_meas,
        MeasureTheory.measureReal_def, smul_eq_mul, h_vol]
      calc R ^ 2 * Real.pi * K ^ 2
          = R ^ 2 * (Real.sqrt Real.pi ^ 2) * K ^ 2 := by
            rw [Real.sq_sqrt Real.pi_pos.le]
        _ = (Real.sqrt Real.pi * R_win * ρ_t * K) ^ 2 := by
            dsimp only [R]
            ring
    have h_pref_nn : 0 ≤ Real.sqrt Real.pi * R_win * ρ_t * K :=
      mul_nonneg (mul_nonneg (mul_nonneg (Real.sqrt_nonneg _) hR_win.le) hρ_t.le) hK
    have h_sqrt_ind :
        Real.sqrt (∫ v : EuclideanSpace ℝ (Fin 2), ind_K v ^ 2) =
          Real.sqrt Real.pi * R_win * ρ_t * K := by
      rw [h_ind_sq, Real.sqrt_sq h_pref_nn]
    have h_int_bd : ‖∫ v : EuclideanSpace ℝ (Fin 2), F v‖ ≤
        (Real.sqrt Real.pi * R_win * ρ_t * K) * Real.sqrt (∫ v, ‖H v‖ ^ 2) := by
      calc ‖∫ v : EuclideanSpace ℝ (Fin 2), F v‖
          ≤ ∫ v : EuclideanSpace ℝ (Fin 2), ‖F v‖ :=
            MeasureTheory.norm_integral_le_integral_norm F
        _ ≤ ∫ v : EuclideanSpace ℝ (Fin 2), ind_K v * ‖H v‖ :=
            MeasureTheory.integral_mono_of_nonneg
              (Filter.Eventually.of_forall (fun v => norm_nonneg (F v)))
              h_dom_int (Filter.Eventually.of_forall h_dom)
        _ ≤ Real.sqrt (∫ v, ind_K v ^ 2) * Real.sqrt (∫ v, ‖H v‖ ^ 2) := h_holder
        _ = (Real.sqrt Real.pi * R_win * ρ_t * K) * Real.sqrt (∫ v, ‖H v‖ ^ 2) := by
            rw [h_sqrt_ind]
    rw [norm_mul, norm_inv, Complex.norm_real, Real.norm_of_nonneg hρ_t.le]
    calc ρ_t⁻¹ * ‖∫ v : EuclideanSpace ℝ (Fin 2), F v‖
        ≤ ρ_t⁻¹ * ((Real.sqrt Real.pi * R_win * ρ_t * K) * Real.sqrt (∫ v, ‖H v‖ ^ 2)) :=
          mul_le_mul_of_nonneg_left h_int_bd hρ_inv_pos.le
      _ = (Real.sqrt Real.pi * R_win * K) * (ρ_t⁻¹ * ρ_t) * Real.sqrt (∫ v, ‖H v‖ ^ 2) := by ring
      _ = (Real.sqrt Real.pi * R_win * K) * Real.sqrt (∫ v, ‖H v‖ ^ 2) := by
          rw [inv_mul_cancel₀ hρ_ne, mul_one]

  
  have h_fub_single : ∀ (H : EuclideanSpace ℝ (Fin 2) → ℂ),
      MeasureTheory.Integrable (fun v => H v * ψ_o (z_of v)) MeasureTheory.volume →
      ∫ v : EuclideanSpace ℝ (Fin 2), H v * (W_o (z_of v) * ψ_o (z_of v)) * e_X v =
        ∫ ξ : ℝ × ℝ,
          (α_wt ξ * Complex.exp (Complex.I *
            ((lam_sys * (-Φ₀ (C_t, x_of ξ, V_o) + Φ₀ (C_t, X_o, V_o)) : ℝ) : ℂ))) *
          (∫ v : EuclideanSpace ℝ (Fin 2),
            H v * ψ_o (z_of v) *
              Complex.exp (Complex.I * ((lam_sys * Φ₀ (C_t, x_of ξ, v) : ℝ) : ℂ))) := by
    intro H hK_int
    let K_H : EuclideanSpace ℝ (Fin 2) → ℂ := fun v => H v * ψ_o (z_of v)
    let M_mod : (ℝ × ℝ) × EuclideanSpace ℝ (Fin 2) → ℂ := fun p =>
      α_wt p.1 * Complex.exp (Complex.I *
        ((lam_sys * (Φ₀ (C_t, x_of p.1, p.2) - Φ₀ (C_t, x_of p.1, V_o) +
          Φ₀ (C_t, X_o, V_o)) : ℝ) : ℂ))
    let f_H : (ℝ × ℝ) → EuclideanSpace ℝ (Fin 2) → ℂ := fun ξ v => M_mod (ξ, v) * K_H v
    have hM_cont : Continuous M_mod := by
      have h1 : Continuous (fun p : (ℝ × ℝ) × EuclideanSpace ℝ (Fin 2) =>
          Φ₀ (C_t, x_of p.1, p.2)) :=
        hΦ₀_cont.comp (continuous_const.prodMk ((hx_cont.comp continuous_fst).prodMk continuous_snd))
      have h2 : Continuous (fun p : (ℝ × ℝ) × EuclideanSpace ℝ (Fin 2) =>
          Φ₀ (C_t, x_of p.1, V_o)) :=
        hΦ₀_cont.comp (continuous_const.prodMk ((hx_cont.comp continuous_fst).prodMk continuous_const))
      exact (hα_cont.comp continuous_fst).mul
        (Complex.continuous_exp.comp
          (continuous_const.mul
            (Complex.continuous_ofReal.comp
              (continuous_const.mul ((h1.sub h2).add continuous_const)))))
    have hf_meas : MeasureTheory.AEStronglyMeasurable (Function.uncurry f_H)
        (MeasureTheory.volume.prod MeasureTheory.volume) :=
      hM_cont.aestronglyMeasurable.mul hK_int.aestronglyMeasurable.comp_snd
    have hf_dom_int : MeasureTheory.Integrable
        (fun p : (ℝ × ℝ) × EuclideanSpace ℝ (Fin 2) => ‖α_wt p.1‖ * ‖K_H p.2‖)
        (MeasureTheory.volume.prod MeasureTheory.volume) :=
      hα_int.norm.mul_prod hK_int.norm
    have hf_int : MeasureTheory.Integrable (Function.uncurry f_H)
        (MeasureTheory.volume.prod MeasureTheory.volume) := by
      refine hf_dom_int.mono' hf_meas (Filter.Eventually.of_forall (fun p => ?_))
      change ‖M_mod p * K_H p.2‖ ≤ ‖α_wt p.1‖ * ‖K_H p.2‖
      dsimp only [M_mod]
      rw [norm_mul, norm_mul, Complex.norm_exp_I_mul_ofReal, mul_one]
    have h_inner_ξ : ∀ v : EuclideanSpace ℝ (Fin 2),
        (∫ ξ : ℝ × ℝ, f_H ξ v) = H v * (W_o (z_of v) * ψ_o (z_of v)) * e_X v := by
      intro v
      have h_integrand : (fun ξ : ℝ × ℝ => f_H ξ v) = fun ξ =>
          (K_H v * e_X v) * (α_wt ξ * Complex.exp (Complex.I *
            ((lam_sys * (Φ₀ (C_t, x_of ξ, V_o + ρ_t • z_of v) -
              Φ₀ (C_t, X_o, V_o + ρ_t • z_of v) -
              Φ₀ (C_t, x_of ξ, V_o) +
              Φ₀ (C_t, X_o, V_o)) : ℝ) : ℂ))) := by
        ext ξ
        dsimp only [f_H, M_mod, K_H, e_X]
        have h_phase_eq :
            Complex.I * ((lam_sys * (Φ₀ (C_t, x_of ξ, v) - Φ₀ (C_t, x_of ξ, V_o) +
              Φ₀ (C_t, X_o, V_o)) : ℝ) : ℂ) =
            Complex.I * ((lam_sys * (Φ₀ (C_t, x_of ξ, V_o + ρ_t • z_of v) -
              Φ₀ (C_t, X_o, V_o + ρ_t • z_of v) -
              Φ₀ (C_t, x_of ξ, V_o) +
              Φ₀ (C_t, X_o, V_o)) : ℝ) : ℂ) +
            Complex.I * ((lam_sys * Φ₀ (C_t, X_o, v) : ℝ) : ℂ) := by
          rw [hz_inv v]
          push_cast
          ring
        rw [h_phase_eq, Complex.exp_add]
        ring
      rw [h_integrand, MeasureTheory.integral_const_mul, ← hW_rep (z_of v)]
      dsimp only [K_H]
      ring
    have h_inner_v : ∀ ξ : ℝ × ℝ,
        (∫ v : EuclideanSpace ℝ (Fin 2), f_H ξ v) =
          (α_wt ξ * Complex.exp (Complex.I *
            ((lam_sys * (-Φ₀ (C_t, x_of ξ, V_o) + Φ₀ (C_t, X_o, V_o)) : ℝ) : ℂ))) *
          (∫ v : EuclideanSpace ℝ (Fin 2),
            H v * ψ_o (z_of v) *
              Complex.exp (Complex.I * ((lam_sys * Φ₀ (C_t, x_of ξ, v) : ℝ) : ℂ))) := by
      intro ξ
      have h_integrand : (fun v : EuclideanSpace ℝ (Fin 2) => f_H ξ v) = fun v =>
          (α_wt ξ * Complex.exp (Complex.I *
            ((lam_sys * (-Φ₀ (C_t, x_of ξ, V_o) + Φ₀ (C_t, X_o, V_o)) : ℝ) : ℂ))) *
          (H v * ψ_o (z_of v) *
            Complex.exp (Complex.I * ((lam_sys * Φ₀ (C_t, x_of ξ, v) : ℝ) : ℂ))) := by
        ext v
        dsimp only [f_H, M_mod, K_H]
        have h_phase_eq :
            Complex.I * ((lam_sys * (Φ₀ (C_t, x_of ξ, v) - Φ₀ (C_t, x_of ξ, V_o) +
              Φ₀ (C_t, X_o, V_o)) : ℝ) : ℂ) =
            Complex.I * ((lam_sys * (-Φ₀ (C_t, x_of ξ, V_o) + Φ₀ (C_t, X_o, V_o)) : ℝ) : ℂ) +
            Complex.I * ((lam_sys * Φ₀ (C_t, x_of ξ, v) : ℝ) : ℂ) := by
          push_cast
          ring
        rw [h_phase_eq, Complex.exp_add]
        ring
      rw [h_integrand, MeasureTheory.integral_const_mul]
    calc ∫ v : EuclideanSpace ℝ (Fin 2), H v * (W_o (z_of v) * ψ_o (z_of v)) * e_X v
        = ∫ v : EuclideanSpace ℝ (Fin 2), ∫ ξ : ℝ × ℝ, f_H ξ v := by
          simp_rw [h_inner_ξ]
      _ = ∫ ξ : ℝ × ℝ, ∫ v : EuclideanSpace ℝ (Fin 2), f_H ξ v :=
          (MeasureTheory.integral_integral_swap hf_int).symm
      _ = ∫ ξ : ℝ × ℝ,
            (α_wt ξ * Complex.exp (Complex.I *
              ((lam_sys * (-Φ₀ (C_t, x_of ξ, V_o) + Φ₀ (C_t, X_o, V_o)) : ℝ) : ℂ))) *
            (∫ v : EuclideanSpace ℝ (Fin 2),
              H v * ψ_o (z_of v) *
                Complex.exp (Complex.I * ((lam_sys * Φ₀ (C_t, x_of ξ, v) : ℝ) : ℂ))) := by
          simp_rw [h_inner_v]

  have hψ_z_meas : MeasureTheory.AEStronglyMeasurable (fun v => ψ_o (z_of v)) MeasureTheory.volume :=
    (hψ_cont.comp hz_cont).aestronglyMeasurable
  have hW_z_meas : MeasureTheory.AEStronglyMeasurable (fun v => W_o (z_of v)) MeasureTheory.volume :=
    (hW_cont.comp hz_cont).aestronglyMeasurable
  have hχ_z_meas :
      MeasureTheory.AEStronglyMeasurable (fun v => χ_ann (z_of v)) MeasureTheory.volume :=
    (hχ_cont.comp hz_cont).aestronglyMeasurable
  have heX_meas : MeasureTheory.AEStronglyMeasurable e_X MeasureTheory.volume :=
    heX_cont.aestronglyMeasurable

  have hHall_ψ_int :
      MeasureTheory.Integrable (fun v => H_all v * ψ_o (z_of v)) MeasureTheory.volume :=
    (h_l2_ball M_0 hM_0 H_all (fun v => H_all v * ψ_o (z_of v)) hHall_l2
      (hHall_meas.mul hψ_z_meas)
      (fun v hv => by rw [hψ_z_supp v hv, mul_zero])
      (fun v => by
        rw [norm_mul, mul_comm M_0 ‖H_all v‖]
        exact mul_le_mul_of_nonneg_left (hψ_bd (z_of v)) (norm_nonneg (H_all v)))).1

  have hHin_ψ_int :
      MeasureTheory.Integrable (fun v => H_in v * ψ_o (z_of v)) MeasureTheory.volume :=
    (h_l2_ball M_0 hM_0 H_in (fun v => H_in v * ψ_o (z_of v)) hHin_l2
      (hHin_meas.mul hψ_z_meas)
      (fun v hv => by rw [hψ_z_supp v hv, mul_zero])
      (fun v => by
        rw [norm_mul, mul_comm M_0 ‖H_in v‖]
        exact mul_le_mul_of_nonneg_left (hψ_bd (z_of v)) (norm_nonneg (H_in v)))).1

  have h_fub_eq :
      (∫ v : EuclideanSpace ℝ (Fin 2), H_all v * (W_o (z_of v) * ψ_o (z_of v)) * e_X v) =
      (∫ v : EuclideanSpace ℝ (Fin 2), H_in v * (W_o (z_of v) * ψ_o (z_of v)) * e_X v) := by
    rw [h_fub_single H_all hHall_ψ_int, h_fub_single H_in hHin_ψ_int]
    congr 1
    ext ξ
    by_cases hα : α_wt ξ = 0
    · simp [hα]
    · dsimp only [z_of]
      rw [h_pair_eq ξ hα]

  
  let F_in_o : EuclideanSpace ℝ (Fin 2) → ℂ := fun v => H_in v * ψ_o (z_of v) * e_X v
  let F_in_W : EuclideanSpace ℝ (Fin 2) → ℂ :=
    fun v => H_in v * (W_o (z_of v) * ψ_o (z_of v)) * e_X v
  let F_all_W : EuclideanSpace ℝ (Fin 2) → ℂ :=
    fun v => H_all v * (W_o (z_of v) * ψ_o (z_of v)) * e_X v
  let F_all_loc : EuclideanSpace ℝ (Fin 2) → ℂ := fun v => H_all v * ψ_loc (z_of v) * e_X v

  have hInt_in_o : MeasureTheory.Integrable F_in_o MeasureTheory.volume :=
    (h_l2_ball M_0 hM_0 H_in F_in_o hHin_l2
      ((hHin_meas.mul hψ_z_meas).mul heX_meas)
      (fun v hv => by dsimp only [F_in_o]; rw [hψ_z_supp v hv, mul_zero, zero_mul])
      (fun v => by
        dsimp only [F_in_o]
        rw [norm_mul, norm_mul, heX_norm v, mul_one, mul_comm M_0 ‖H_in v‖]
        exact mul_le_mul_of_nonneg_left (hψ_bd (z_of v)) (norm_nonneg (H_in v)))).1

  have hInt_in_W : MeasureTheory.Integrable F_in_W MeasureTheory.volume :=
    (h_l2_ball (B_W * M_0) (mul_nonneg hBW_nn hM_0) H_in F_in_W hHin_l2
      ((hHin_meas.mul (hW_z_meas.mul hψ_z_meas)).mul heX_meas)
      (fun v hv => by dsimp only [F_in_W]; rw [hψ_z_supp v hv, mul_zero, mul_zero, zero_mul])
      (fun v => by
        dsimp only [F_in_W]
        rw [norm_mul, norm_mul, norm_mul, heX_norm v, mul_one, mul_comm (B_W * M_0) ‖H_in v‖]
        exact mul_le_mul_of_nonneg_left
          (mul_le_mul (hW_bd_glob (z_of v)) (hψ_bd (z_of v)) (norm_nonneg _) hBW_nn)
          (norm_nonneg (H_in v)))).1

  have hInt_all_W : MeasureTheory.Integrable F_all_W MeasureTheory.volume :=
    (h_l2_ball (B_W * M_0) (mul_nonneg hBW_nn hM_0) H_all F_all_W hHall_l2
      ((hHall_meas.mul (hW_z_meas.mul hψ_z_meas)).mul heX_meas)
      (fun v hv => by dsimp only [F_all_W]; rw [hψ_z_supp v hv, mul_zero, mul_zero, zero_mul])
      (fun v => by
        dsimp only [F_all_W]
        rw [norm_mul, norm_mul, norm_mul, heX_norm v, mul_one, mul_comm (B_W * M_0) ‖H_all v‖]
        exact mul_le_mul_of_nonneg_left
          (mul_le_mul (hW_bd_glob (z_of v)) (hψ_bd (z_of v)) (norm_nonneg _) hBW_nn)
          (norm_nonneg (H_all v)))).1

  have hInt_all_loc : MeasureTheory.Integrable F_all_loc MeasureTheory.volume :=
    (h_l2_ball (2 * B_W * M_0) (mul_nonneg (mul_nonneg (by norm_num) hBW_nn) hM_0)
      H_all F_all_loc hHall_l2
      ((hHall_meas.mul ((hχ_z_meas.mul hW_z_meas).mul hψ_z_meas)).mul heX_meas)
      (fun v hv => by dsimp only [F_all_loc, ψ_loc]; rw [hψ_z_supp v hv, mul_zero, mul_zero, zero_mul])
      (fun v => by
        dsimp only [F_all_loc, ψ_loc]
        rw [norm_mul, norm_mul, norm_mul, norm_mul, heX_norm v, mul_one,
          mul_comm (2 * B_W * M_0) ‖H_all v‖]
        refine mul_le_mul_of_nonneg_left ?_ (norm_nonneg (H_all v))
        exact mul_le_mul
          (mul_le_mul (hχ_bd_glob (z_of v)) (hW_bd_glob (z_of v)) (norm_nonneg _) (by norm_num))
          (hψ_bd (z_of v)) (norm_nonneg _) (mul_nonneg (by norm_num) hBW_nn))).1

  let F_err1 : EuclideanSpace ℝ (Fin 2) → ℂ := fun v => F_in_o v - F_in_W v
  let F_err2 : EuclideanSpace ℝ (Fin 2) → ℂ := fun v => F_all_W v - F_all_loc v
  have hME_nn : 0 ≤ M_0 * E_err := mul_nonneg hM_0 hE_err

  have h_err1_bd : ‖(ρ_t⁻¹ : ℂ) * ∫ v : EuclideanSpace ℝ (Fin 2), F_err1 v‖ ≤
      (Real.sqrt Real.pi * R_win * (M_0 * E_err)) * Real.sqrt (∫ v, ‖H_in v‖ ^ 2) := by
    refine (h_l2_ball (M_0 * E_err) hME_nn H_in F_err1 hHin_l2
      (hInt_in_o.aestronglyMeasurable.sub hInt_in_W.aestronglyMeasurable) ?_ ?_).2
    · intro v hv
      dsimp only [F_err1, F_in_o, F_in_W]
      rw [hψ_z_supp v hv]
      ring
    · intro v
      have h_factor : F_err1 v = H_in v * (((1 : ℂ) - W_o (z_of v)) * ψ_o (z_of v)) * e_X v := by
        dsimp only [F_err1, F_in_o, F_in_W]
        ring
      rw [h_factor]
      by_cases hv_win : R_win * ρ_t < ‖v - V_o‖
      · rw [hψ_z_supp v hv_win, mul_zero, mul_zero, zero_mul, norm_zero]
        exact mul_nonneg hME_nn (norm_nonneg (H_in v))
      · by_cases hv_supp : R_supp_in * ρ_t ≤ ‖v - V_o‖
        · simp [hHin_supp v hv_supp]
        · have hz_win : ‖z_of v‖ ≤ R_win := hz_le_of_le (not_lt.mp hv_win)
          have hz_supp : ‖z_of v‖ ≤ R_supp_in := hz_le_of_le (lt_of_not_ge hv_supp).le
          have hW1 : ‖(1 : ℂ) - W_o (z_of v)‖ ≤ E_err := by
            rw [norm_sub_rev]
            exact hW_in (z_of v) hz_win hz_supp
          rw [norm_mul, norm_mul, norm_mul, heX_norm v, mul_one]
          calc ‖H_in v‖ * (‖(1 : ℂ) - W_o (z_of v)‖ * ‖ψ_o (z_of v)‖)
              ≤ ‖H_in v‖ * (E_err * M_0) :=
                mul_le_mul_of_nonneg_left
                  (mul_le_mul hW1 (hψ_bd (z_of v)) (norm_nonneg _) hE_err)
                  (norm_nonneg (H_in v))
            _ = (M_0 * E_err) * ‖H_in v‖ := by ring

  have h_err2_bd : ‖(ρ_t⁻¹ : ℂ) * ∫ v : EuclideanSpace ℝ (Fin 2), F_err2 v‖ ≤
      (Real.sqrt Real.pi * R_win * (M_0 * E_err)) * Real.sqrt (∫ v, ‖H_all v‖ ^ 2) := by
    refine (h_l2_ball (M_0 * E_err) hME_nn H_all F_err2 hHall_l2
      (hInt_all_W.aestronglyMeasurable.sub hInt_all_loc.aestronglyMeasurable) ?_ ?_).2
    · intro v hv
      dsimp only [F_err2, F_all_W, F_all_loc, ψ_loc]
      rw [hψ_z_supp v hv]
      ring
    · intro v
      have h_factor :
          F_err2 v = H_all v * (((1 : ℂ) - χ_ann (z_of v)) * W_o (z_of v) * ψ_o (z_of v)) * e_X v := by
        dsimp only [F_err2, F_all_W, F_all_loc, ψ_loc]
        ring
      rw [h_factor]
      by_cases hv_win : R_win * ρ_t < ‖v - V_o‖
      · rw [hψ_z_supp v hv_win, mul_zero, mul_zero, zero_mul, norm_zero]
        exact mul_nonneg hME_nn (norm_nonneg (H_all v))
      · by_cases hz_in : ‖z_of v‖ ≤ R_in
        · rw [hχ_one (z_of v) hz_in, sub_self, zero_mul, zero_mul, mul_zero, zero_mul, norm_zero]
          exact mul_nonneg hME_nn (norm_nonneg (H_all v))
        · have hz_win : ‖z_of v‖ ≤ R_win := hz_le_of_le (not_lt.mp hv_win)
          have hz_out : R_in ≤ ‖z_of v‖ := (lt_of_not_ge hz_in).le
          have hχW : ‖(1 : ℂ) - χ_ann (z_of v)‖ * ‖W_o (z_of v)‖ ≤ E_err := by
            calc ‖(1 : ℂ) - χ_ann (z_of v)‖ * ‖W_o (z_of v)‖
                ≤ 1 * E_err :=
                  mul_le_mul (hχ_sub_bd (z_of v)) (hW_out (z_of v) hz_win hz_out)
                    (norm_nonneg _) zero_le_one
              _ = E_err := one_mul E_err
          rw [norm_mul, norm_mul, norm_mul, norm_mul, heX_norm v, mul_one]
          calc ‖H_all v‖ * (‖(1 : ℂ) - χ_ann (z_of v)‖ * ‖W_o (z_of v)‖ * ‖ψ_o (z_of v)‖)
              ≤ ‖H_all v‖ * (E_err * M_0) :=
                mul_le_mul_of_nonneg_left
                  (mul_le_mul hχW (hψ_bd (z_of v)) (norm_nonneg _) hE_err)
                  (norm_nonneg (H_all v))
            _ = (M_0 * E_err) * ‖H_all v‖ := by ring

  
  have h_sub1 : (∫ v : EuclideanSpace ℝ (Fin 2), F_err1 v) =
      (∫ v, F_in_o v) - (∫ v, F_in_W v) :=
    MeasureTheory.integral_sub hInt_in_o hInt_in_W
  have h_sub2 : (∫ v : EuclideanSpace ℝ (Fin 2), F_err2 v) =
      (∫ v, F_all_W v) - (∫ v, F_all_loc v) :=
    MeasureTheory.integral_sub hInt_all_W hInt_all_loc
  have h_telescope :
      ((ρ_t⁻¹ : ℂ) * ∫ v, F_in_o v) - ((ρ_t⁻¹ : ℂ) * ∫ v, F_all_loc v) =
      ((ρ_t⁻¹ : ℂ) * ∫ v, F_err1 v) + ((ρ_t⁻¹ : ℂ) * ∫ v, F_err2 v) := by
    rw [h_sub1, h_sub2, h_fub_eq]
    ring
  change ‖((ρ_t⁻¹ : ℂ) * ∫ v, F_in_o v) - ((ρ_t⁻¹ : ℂ) * ∫ v, F_all_loc v)‖ ≤ _
  rw [h_telescope]
  calc ‖((ρ_t⁻¹ : ℂ) * ∫ v, F_err1 v) + ((ρ_t⁻¹ : ℂ) * ∫ v, F_err2 v)‖
      ≤ ‖(ρ_t⁻¹ : ℂ) * ∫ v, F_err1 v‖ + ‖(ρ_t⁻¹ : ℂ) * ∫ v, F_err2 v‖ := norm_add_le _ _
    _ ≤ (Real.sqrt Real.pi * R_win * (M_0 * E_err)) * Real.sqrt (∫ v, ‖H_in v‖ ^ 2) +
          (Real.sqrt Real.pi * R_win * (M_0 * E_err)) * Real.sqrt (∫ v, ‖H_all v‖ ^ 2) :=
        add_le_add h_err1_bd h_err2_bd
    _ = (Real.sqrt Real.pi * R_win * M_0 * E_err) *
          (Real.sqrt (∫ v, ‖H_in v‖ ^ 2) + Real.sqrt (∫ v, ‖H_all v‖ ^ 2)) := by ring

theorem microlocal_buffer_window_localization (a₀ a₁ A B_sys R_win h θ : ℝ) (M_L N_tay : ℕ) (M_win : ℕ → ℝ)
    (ha₀ : 0 < a₀) (ha₁ : a₀ ≤ a₁) (hA : 1 ≤ A)
    (hB_sys : 2 ≤ B_sys) (hR_win : 2 ≤ R_win)
    (hh : 0 < h) (hθ : 0 < θ) (hθ_le : θ ≤ h / 64)
    (hML : 256 ≤ M_L) (hNtay : 2 ≤ N_tay) :
    ∃ (M_win_loc : ℕ → ℝ) (C_loc ε_loc : ℝ),
      (∀ k : ℕ, 1 ≤ M_win_loc k) ∧ 0 ≤ C_loc ∧ 0 < ε_loc ∧ ε_loc < 1 / 2 ∧
      ∀ (Φ₀ : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → ℝ)
        (ζ₀ : EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → EuclideanSpace ℝ (Fin 2)),
        IsNormalizedPosDefPhase a₀ a₁ A Φ₀ ζ₀ →
      ∀ (ε lam_sys ρ_t C_t : ℝ) (V_o X_o : EuclideanSpace ℝ (Fin 2))
        (ψ_o : EuclideanSpace ℝ (Fin 2) → ℂ),
        0 < ε → ε < ε_loc →
        0 < lam_sys → 0 < ρ_t → ρ_t ≤ ε ^ ((3 / 2 : ℝ) * h) →
        (lam_sys * ρ_t)⁻¹ ≤ B_sys * ε ^ (2 * h) →
        C_t ∈ Set.Icc (0 : ℝ) 1 →
        (∀ k : ℕ, ContDiff ℝ k ψ_o) →
        (∀ z : EuclideanSpace ℝ (Fin 2), R_win ≤ ‖z‖ → ψ_o z = 0) →
        (∀ (k : ℕ) (z : EuclideanSpace ℝ (Fin 2)), ‖iteratedFDeriv ℝ k ψ_o z‖ ≤ M_win k) →
        ∃ ψ_loc : EuclideanSpace ℝ (Fin 2) → ℂ,
          (∀ k : ℕ, ContDiff ℝ k ψ_loc) ∧
          (∀ z : EuclideanSpace ℝ (Fin 2), R_win ≤ ‖z‖ → ψ_loc z = 0) ∧
          (∀ z : EuclideanSpace ℝ (Fin 2), ((31 : ℝ) / 2048) * (M_L : ℝ) ≤ ‖z‖ → ψ_loc z = 0) ∧
          (∀ (k : ℕ) (z : EuclideanSpace ℝ (Fin 2)), ‖iteratedFDeriv ℝ k ψ_loc z‖ ≤ M_win_loc k) ∧
          (∀ (H_all H_in : EuclideanSpace ℝ (Fin 2) → ℂ),
            MeasureTheory.AEStronglyMeasurable H_all MeasureTheory.volume →
            MeasureTheory.MemLp H_all 2 MeasureTheory.volume →
            MeasureTheory.AEStronglyMeasurable H_in MeasureTheory.volume →
            MeasureTheory.MemLp H_in 2 MeasureTheory.volume →
            (∀ v : EuclideanSpace ℝ (Fin 2),
              ((17 : ℝ) / 2048) * (M_L : ℝ) * ρ_t ≤ ‖v - V_o‖ → H_in v = 0) →
            (∀ x : EuclideanSpace ℝ (Fin 2),
              ‖x - X_o‖ ≤ 20 * a₀⁻¹ * (ε ^ (-θ)) * (lam_sys * ρ_t)⁻¹ →
              ∫ v : EuclideanSpace ℝ (Fin 2),
                H_all v * ψ_o (ρ_t⁻¹ • (v - V_o)) *
                  Complex.exp (Complex.I * ((lam_sys * Φ₀ (C_t, x, v) : ℝ) : ℂ)) =
              ∫ v : EuclideanSpace ℝ (Fin 2),
                H_in v * ψ_o (ρ_t⁻¹ • (v - V_o)) *
                  Complex.exp (Complex.I * ((lam_sys * Φ₀ (C_t, x, v) : ℝ) : ℂ))) →
            ‖((ρ_t⁻¹ : ℂ) * ∫ v : EuclideanSpace ℝ (Fin 2),
                H_in v * ψ_o (ρ_t⁻¹ • (v - V_o)) *
                  Complex.exp (Complex.I * ((lam_sys * Φ₀ (C_t, X_o, v) : ℝ) : ℂ))) -
             ((ρ_t⁻¹ : ℂ) * ∫ v : EuclideanSpace ℝ (Fin 2),
                H_all v * ψ_loc (ρ_t⁻¹ • (v - V_o)) *
                  Complex.exp (Complex.I * ((lam_sys * Φ₀ (C_t, X_o, v) : ℝ) : ℂ)))‖ ≤
              C_loc * ε ^ ((N_tay : ℝ) * θ) *
                (Real.sqrt (∫ v, ‖H_in v‖ ^ 2) + Real.sqrt (∫ v, ‖H_all v‖ ^ 2))) :=
by
  obtain ⟨η_hat, χ₁, χ_ann, M_ann,
    hM_ann_ge1, hχ₁_cont, hχ₁_01, hχ₁_one, hχ₁_zero,
    hχ_ann_smooth, hχ_ann_one, hχ_ann_zero, hχ_ann_bd, hχ_ann_deriv,
    hη_cont, hη_int, hη_in, hη_out⟩ :=
    flat_top_fourier_bump_and_annular_cutoff M_L hML
  obtain ⟨D_z_exp, C_u_coeff, C_rem, hDz_ge1, hCu_nn, hCrem_nn, h_cramer⟩ :=
    cramer_jacobian_and_double_diff_phase_calculus a₀ a₁ A B_sys R_win N_tay
      ha₀ ha₁ hA hB_sys hR_win hNtay
  obtain ⟨M_W, C_W, hMW_ge1, hCW_nn, h_symbol⟩ :=
    microlocal_symbol_smoothness_and_taylor_fidelity R_win M_L N_tay D_z_exp C_u_coeff C_rem
      η_hat χ₁ hR_win hML hNtay hDz_ge1 hCu_nn hCrem_nn
      hχ₁_cont hχ₁_01 hχ₁_one hχ₁_zero hη_cont hη_int hη_in hη_out
  let W_win : ℕ → ℝ := fun k => max (M_win k) 1
  have hW_win_ge1 : ∀ k : ℕ, 1 ≤ W_win k := fun k => le_max_right _ _
  have hW_win_nn : ∀ k : ℕ, 0 ≤ W_win k := fun k => le_trans zero_le_one (hW_win_ge1 k)
  have hM_ann_nn : ∀ k : ℕ, 0 ≤ M_ann k := fun k => le_trans zero_le_one (hM_ann_ge1 k)
  have hMW_nn : ∀ k : ℕ, 0 ≤ M_W k := fun k => le_trans zero_le_one (hMW_ge1 k)
  let M_ann_W : ℕ → ℝ := fun n =>
    ∑ i ∈ Finset.range (n + 1), (n.choose i : ℝ) * M_ann i * M_W (n - i)
  have hM_ann_W_nn : ∀ n : ℕ, 0 ≤ M_ann_W n := fun n =>
    Finset.sum_nonneg (fun i _ =>
      mul_nonneg (mul_nonneg (Nat.cast_nonneg _) (hM_ann_nn i)) (hMW_nn (n - i)))
  have hM_ann_W_zero_ge1 : 1 ≤ M_ann_W 0 := by
    dsimp only [M_ann_W]
    rw [Finset.range_one, Finset.sum_singleton, Nat.choose_self, Nat.cast_one, one_mul, Nat.sub_self]
    nlinarith [hM_ann_ge1 0, hMW_ge1 0]
  let M_win_loc : ℕ → ℝ := fun k =>
    ∑ n ∈ Finset.range (k + 1), (k.choose n : ℝ) * M_ann_W n * W_win (k - n)
  have hM_win_loc_ge1 : ∀ k : ℕ, 1 ≤ M_win_loc k := by
    intro k
    have h0_mem : 0 ∈ Finset.range (k + 1) := Finset.mem_range.mpr (Nat.succ_pos k)
    have h0_le : (k.choose 0 : ℝ) * M_ann_W 0 * W_win (k - 0) ≤ M_win_loc k :=
      Finset.single_le_sum
        (fun n _ => mul_nonneg (mul_nonneg (Nat.cast_nonneg _) (hM_ann_W_nn n)) (hW_win_nn (k - n)))
        h0_mem
    rw [Nat.choose_zero_right, Nat.cast_one, one_mul, Nat.sub_zero] at h0_le
    have h1 : 1 ≤ M_ann_W 0 * W_win k := by nlinarith [hM_ann_W_zero_ge1, hW_win_ge1 k]
    exact le_trans h1 h0_le
  let C_loc : ℝ := 2 * Real.sqrt Real.pi * R_win * W_win 0 * C_W
  have hR_win_pos : 0 < R_win := by linarith
  have hC_loc_nn : 0 ≤ C_loc :=
    mul_nonneg
      (mul_nonneg
        (mul_nonneg (mul_nonneg (by norm_num) (Real.sqrt_nonneg _)) hR_win_pos.le)
        (hW_win_nn 0))
      hCW_nn
  refine ⟨M_win_loc, C_loc, 1 / 4, hM_win_loc_ge1, hC_loc_nn, by norm_num, by norm_num, ?_⟩
  intro Φ₀ ζ₀ h_phase ε lam_sys ρ_t C_t V_o X_o ψ_o
    hε_pos hε_lt hlam_pos hρ_pos hρ_le hσ_le hCt hψ_smooth hψ_supp hψ_deriv
  have hε_le1 : ε ≤ 1 := by linarith
  have hB_sys_nn : 0 ≤ B_sys := by linarith
  have hB_sys_ge1 : 1 ≤ B_sys := by linarith
  have hρ_le1 : ρ_t ≤ 1 := by
    calc ρ_t ≤ ε ^ ((3 / 2 : ℝ) * h) := hρ_le
      _ ≤ ε ^ (0 : ℝ) := Real.rpow_le_rpow_of_exponent_ge hε_pos hε_le1 (by positivity)
      _ = 1 := Real.rpow_zero ε
  have hσ_le_B : (lam_sys * ρ_t)⁻¹ ≤ B_sys := by
    have h1 : ε ^ (2 * h) ≤ 1 := by
      calc ε ^ (2 * h) ≤ ε ^ (0 : ℝ) :=
            Real.rpow_le_rpow_of_exponent_ge hε_pos hε_le1 (by positivity)
        _ = 1 := Real.rpow_zero ε
    calc (lam_sys * ρ_t)⁻¹ ≤ B_sys * ε ^ (2 * h) := hσ_le
      _ ≤ B_sys * 1 := mul_le_mul_of_nonneg_left h1 hB_sys_nn
      _ = B_sys := mul_one B_sys
  obtain ⟨y_map, hy_map_bd, hΔΘ_smooth, hh_ξ_props, hG_z_props⟩ :=
    h_cramer Φ₀ ζ₀ h_phase lam_sys ρ_t C_t V_o X_o
      hlam_pos hρ_pos hρ_le1 hσ_le_B hCt
  let σ_t : ℝ := (lam_sys * ρ_t)⁻¹
  have hσ_pos : 0 < σ_t := inv_pos.mpr (mul_pos hlam_pos hρ_pos)
  let ΔΘ_o : (ℝ × ℝ) → EuclideanSpace ℝ (Fin 2) → ℝ := fun u z =>
    lam_sys * (Φ₀ (C_t, X_o + σ_t • y_map u, V_o + ρ_t • z) -
      Φ₀ (C_t, X_o, V_o + ρ_t • z) -
      Φ₀ (C_t, X_o + σ_t • y_map u, V_o) +
      Φ₀ (C_t, X_o, V_o))
  let r_cut : ℝ := ε ^ θ
  let R_cut : ℝ := r_cut⁻¹
  let δ_small : ℝ := ε ^ (h / 2)
  have hr_cut_pos : 0 < r_cut := Real.rpow_pos_of_pos hε_pos θ
  have hr_cut_le1 : r_cut ≤ 1 := by
    calc ε ^ θ ≤ ε ^ (0 : ℝ) := Real.rpow_le_rpow_of_exponent_ge hε_pos hε_le1 hθ.le
      _ = 1 := Real.rpow_zero ε
  have hR_cut_eq : R_cut = ε ^ (-θ) := (Real.rpow_neg hε_pos.le θ).symm
  have hR_cut_ge1 : 1 ≤ R_cut := by
    rw [hR_cut_eq]
    calc (1 : ℝ) = ε ^ (0 : ℝ) := (Real.rpow_zero ε).symm
      _ ≤ ε ^ (-θ) := Real.rpow_le_rpow_of_exponent_ge hε_pos hε_le1 (by linarith)
  have hR_cut_nn : 0 ≤ R_cut := le_trans zero_le_one hR_cut_ge1
  have hδ_nn : 0 ≤ δ_small := Real.rpow_nonneg hε_pos.le (h / 2)
  have h_scale1 : ρ_t * R_cut ≤ δ_small := by
    rw [hR_cut_eq]
    calc ρ_t * ε ^ (-θ)
        ≤ ε ^ ((3 / 2 : ℝ) * h) * ε ^ (-θ) :=
          mul_le_mul_of_nonneg_right hρ_le (Real.rpow_nonneg hε_pos.le (-θ))
      _ = ε ^ ((3 / 2 : ℝ) * h + -θ) := (Real.rpow_add hε_pos _ _).symm
      _ ≤ ε ^ (h / 2) :=
          Real.rpow_le_rpow_of_exponent_ge hε_pos hε_le1 (by linarith)
  have h_scale2 : σ_t * R_cut ^ 2 ≤ B_sys * δ_small := by
    have hR2 : R_cut ^ 2 = ε ^ (-2 * θ) := by
      rw [hR_cut_eq, ← Real.rpow_natCast (ε ^ (-θ)) 2, ← Real.rpow_mul hε_pos.le]
      congr 1; push_cast; ring
    rw [hR2]
    calc σ_t * ε ^ (-2 * θ)
        ≤ (B_sys * ε ^ (2 * h)) * ε ^ (-2 * θ) :=
          mul_le_mul_of_nonneg_right hσ_le (Real.rpow_nonneg hε_pos.le _)
      _ = B_sys * (ε ^ (2 * h) * ε ^ (-2 * θ)) := mul_assoc _ _ _
      _ = B_sys * ε ^ (2 * h + -2 * θ) := by rw [← Real.rpow_add hε_pos]
      _ ≤ B_sys * ε ^ (h / 2) :=
          mul_le_mul_of_nonneg_left
            (Real.rpow_le_rpow_of_exponent_ge hε_pos hε_le1 (by linarith))
            hB_sys_nn
  have h_scale3 : ∀ i : ℕ, 2 ≤ i → i ≤ N_tay →
      σ_t ^ (i - 1) * R_cut ^ i ≤ (B_sys * δ_small) ^ i := by
    intro i hi2 _
    have hi_ge2 : (2 : ℝ) ≤ (i : ℝ) := by exact_mod_cast hi2
    have hi_sub : ((i - 1 : ℕ) : ℝ) = (i : ℝ) - 1 := by
      rw [Nat.cast_sub (by omega), Nat.cast_one]
    have hσ_pow : σ_t ^ (i - 1) ≤ B_sys ^ i * ε ^ (2 * h * ((i : ℝ) - 1)) := by
      have h1 : σ_t ^ (i - 1) ≤ (B_sys * ε ^ (2 * h)) ^ (i - 1) :=
        pow_le_pow_left₀ hσ_pos.le hσ_le (i - 1)
      have h2 : (B_sys * ε ^ (2 * h)) ^ (i - 1) =
          B_sys ^ (i - 1) * ε ^ (2 * h * ((i : ℝ) - 1)) := by
        rw [mul_pow, ← Real.rpow_natCast (ε ^ (2 * h)) (i - 1),
          ← Real.rpow_mul hε_pos.le, hi_sub]
      have h3 : B_sys ^ (i - 1) ≤ B_sys ^ i :=
        pow_le_pow_right₀ hB_sys_ge1 (by omega)
      rw [h2] at h1
      exact le_trans h1 (mul_le_mul_of_nonneg_right h3 (Real.rpow_nonneg hε_pos.le _))
    have hR_pow : R_cut ^ i = ε ^ (-θ * (i : ℝ)) := by
      rw [hR_cut_eq, ← Real.rpow_natCast (ε ^ (-θ)) i, ← Real.rpow_mul hε_pos.le]
    have hexp_ge : (h / 2) * (i : ℝ) ≤ 2 * h * ((i : ℝ) - 1) + -θ * (i : ℝ) := by
      nlinarith [hi_ge2, hh, hθ_le]
    calc σ_t ^ (i - 1) * R_cut ^ i
        ≤ (B_sys ^ i * ε ^ (2 * h * ((i : ℝ) - 1))) * ε ^ (-θ * (i : ℝ)) := by
          rw [hR_pow]
          exact mul_le_mul_of_nonneg_right hσ_pow (Real.rpow_nonneg hε_pos.le _)
      _ = B_sys ^ i * (ε ^ (2 * h * ((i : ℝ) - 1)) * ε ^ (-θ * (i : ℝ))) := mul_assoc _ _ _
      _ = B_sys ^ i * ε ^ (2 * h * ((i : ℝ) - 1) + -θ * (i : ℝ)) := by
          rw [← Real.rpow_add hε_pos]
      _ ≤ B_sys ^ i * ε ^ ((h / 2) * (i : ℝ)) :=
          mul_le_mul_of_nonneg_left
            (Real.rpow_le_rpow_of_exponent_ge hε_pos hε_le1 hexp_ge)
            (pow_nonneg hB_sys_nn i)
      _ = (B_sys * δ_small) ^ i := by
          dsimp only [δ_small]
          rw [mul_pow, ← Real.rpow_natCast (ε ^ (h / 2)) i, ← Real.rpow_mul hε_pos.le]
  obtain ⟨hW_smooth, hW_deriv, hW_in, hW_out⟩ :=
    h_symbol r_cut δ_small ΔΘ_o hr_cut_pos hr_cut_le1 hδ_nn
      hΔΘ_smooth hh_ξ_props
      (fun z hz =>
        let ⟨hG0, hG_sm, hG_poly, hG_rem⟩ := hG_z_props z hz
        ⟨hG0, hG_sm, hG_poly,
         hG_rem R_cut δ_small hR_cut_ge1 hδ_nn h_scale1 h_scale2 h_scale3⟩)
  let W_o : EuclideanSpace ℝ (Fin 2) → ℂ := fun z =>
    ∫ ξ : ℝ × ℝ,
      ((χ₁ (r_cut * ξ.1) * χ₁ (r_cut * ξ.2) : ℝ) : ℂ) *
        η_hat ξ.1 * η_hat ξ.2 *
        Complex.exp (Complex.I * ((ΔΘ_o ξ z : ℝ) : ℂ))
  let ψ_loc : EuclideanSpace ℝ (Fin 2) → ℂ := fun z => χ_ann z * W_o z * ψ_o z
  have h_annW_deriv : ∀ (n : ℕ) (z : EuclideanSpace ℝ (Fin 2)),
      ‖iteratedFDeriv ℝ n (fun y => χ_ann y * W_o y) z‖ ≤ M_ann_W n := by
    intro n z
    refine le_trans (norm_iteratedFDeriv_mul_le (hχ_ann_smooth n) (hW_smooth n) z le_rfl) ?_
    refine Finset.sum_le_sum (fun i _ => ?_)
    exact mul_le_mul
      (mul_le_mul_of_nonneg_left (hχ_ann_deriv i z) (Nat.cast_nonneg _))
      (hW_deriv (n - i) z)
      (norm_nonneg _)
      (mul_nonneg (Nat.cast_nonneg _) (hM_ann_nn i))
  have hψ_loc_deriv : ∀ (k : ℕ) (z : EuclideanSpace ℝ (Fin 2)),
      ‖iteratedFDeriv ℝ k ψ_loc z‖ ≤ M_win_loc k := by
    intro k z
    refine le_trans
      (norm_iteratedFDeriv_mul_le ((hχ_ann_smooth k).mul (hW_smooth k)) (hψ_smooth k) z le_rfl) ?_
    refine Finset.sum_le_sum (fun n _ => ?_)
    exact mul_le_mul
      (mul_le_mul_of_nonneg_left (h_annW_deriv n z) (Nat.cast_nonneg _))
      (le_trans (hψ_deriv (k - n) z) (le_max_left _ _))
      (norm_nonneg _)
      (mul_nonneg (Nat.cast_nonneg _) (hM_ann_W_nn n))
  refine ⟨ψ_loc,
    fun k => ((hχ_ann_smooth k).mul (hW_smooth k)).mul (hψ_smooth k),
    fun z hz => by dsimp only [ψ_loc]; rw [hψ_supp z hz, mul_zero],
    fun z hz => by dsimp only [ψ_loc]; rw [hχ_ann_zero z hz, zero_mul, zero_mul],
    hψ_loc_deriv,
    ?_⟩
  intro H_all H_in hHall_meas hHall_l2 hHin_meas hHin_l2 hHin_supp h_pair_eq_x
  have hψ_bd : ∀ z : EuclideanSpace ℝ (Fin 2), ‖ψ_o z‖ ≤ W_win 0 := by
    intro z
    calc ‖ψ_o z‖ = ‖iteratedFDeriv ℝ 0 ψ_o z‖ := (norm_iteratedFDeriv_zero).symm
      _ ≤ M_win 0 := hψ_deriv 0 z
      _ ≤ W_win 0 := le_max_left _ _
  let α_wt : ℝ × ℝ → ℂ := fun ξ =>
    ((χ₁ (r_cut * ξ.1) * χ₁ (r_cut * ξ.2) : ℝ) : ℂ) * η_hat ξ.1 * η_hat ξ.2
  have hα_cont : Continuous α_wt :=
    ((Complex.continuous_ofReal.comp
      ((hχ₁_cont.comp (continuous_const.mul continuous_fst)).mul
        (hχ₁_cont.comp (continuous_const.mul continuous_snd)))).mul
      (hη_cont.comp continuous_fst)).mul
      (hη_cont.comp continuous_snd)
  have hη0_int : MeasureTheory.Integrable (fun s : ℝ => ‖η_hat s‖) MeasureTheory.volume := by
    simpa using hη_int 0
  have hα_dom_int : MeasureTheory.Integrable
      (fun ξ : ℝ × ℝ => ‖η_hat ξ.1‖ * ‖η_hat ξ.2‖) MeasureTheory.volume :=
    hη0_int.mul_prod hη0_int
  have hα_int : MeasureTheory.Integrable α_wt MeasureTheory.volume := by
    refine hα_dom_int.mono' hα_cont.aestronglyMeasurable (Filter.Eventually.of_forall (fun ξ => ?_))
    have h1 := hχ₁_01 (r_cut * ξ.1)
    have h2 := hχ₁_01 (r_cut * ξ.2)
    have hprod_nn : 0 ≤ χ₁ (r_cut * ξ.1) * χ₁ (r_cut * ξ.2) := mul_nonneg h1.1 h2.1
    have hprod_le1 : χ₁ (r_cut * ξ.1) * χ₁ (r_cut * ξ.2) ≤ 1 := by
      nlinarith [h1.1, h1.2, h2.1, h2.2]
    have hχ_norm : ‖((χ₁ (r_cut * ξ.1) * χ₁ (r_cut * ξ.2) : ℝ) : ℂ)‖ ≤ 1 := by
      rw [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hprod_nn]
      exact hprod_le1
    calc ‖α_wt ξ‖
        = ‖((χ₁ (r_cut * ξ.1) * χ₁ (r_cut * ξ.2) : ℝ) : ℂ)‖ *
            ‖η_hat ξ.1‖ * ‖η_hat ξ.2‖ := by
          dsimp only [α_wt]
          rw [norm_mul, norm_mul]
      _ ≤ 1 * ‖η_hat ξ.1‖ * ‖η_hat ξ.2‖ := by
          gcongr
      _ = ‖η_hat ξ.1‖ * ‖η_hat ξ.2‖ := by rw [one_mul]
  let x_of : ℝ × ℝ → EuclideanSpace ℝ (Fin 2) := fun ξ => X_o + σ_t • y_map ξ
  have hx_cont : Continuous x_of :=
    (continuous_const : Continuous (fun _ : ℝ × ℝ => X_o)).add
      ((continuous_const : Continuous (fun _ : ℝ × ℝ => σ_t)).smul y_map.continuous)
  have h_pair_ξ : ∀ ξ : ℝ × ℝ, α_wt ξ ≠ 0 →
      ∫ v : EuclideanSpace ℝ (Fin 2),
        H_all v * ψ_o (ρ_t⁻¹ • (v - V_o)) *
          Complex.exp (Complex.I * ((lam_sys * Φ₀ (C_t, x_of ξ, v) : ℝ) : ℂ)) =
      ∫ v : EuclideanSpace ℝ (Fin 2),
        H_in v * ψ_o (ρ_t⁻¹ • (v - V_o)) *
          Complex.exp (Complex.I * ((lam_sys * Φ₀ (C_t, x_of ξ, v) : ℝ) : ℂ)) := by
    intro ξ hα_ne
    have hχ1_ne : χ₁ (r_cut * ξ.1) ≠ 0 := by
      intro h0
      apply hα_ne
      dsimp only [α_wt]
      simp [h0]
    have hχ2_ne : χ₁ (r_cut * ξ.2) ≠ 0 := by
      intro h0
      apply hα_ne
      dsimp only [α_wt]
      simp [h0]
    have hξ1_lt : |r_cut * ξ.1| < 2 := by
      by_contra hge
      exact hχ1_ne (hχ₁_zero _ (not_lt.mp hge))
    have hξ2_lt : |r_cut * ξ.2| < 2 := by
      by_contra hge
      exact hχ2_ne (hχ₁_zero _ (not_lt.mp hge))
    have hξ1_le : |ξ.1| ≤ 2 * R_cut := by
      rw [abs_mul, abs_of_pos hr_cut_pos] at hξ1_lt
      dsimp only [R_cut]
      calc |ξ.1| = r_cut⁻¹ * (r_cut * |ξ.1|) := by
            rw [← mul_assoc, inv_mul_cancel₀ hr_cut_pos.ne', one_mul]
        _ ≤ r_cut⁻¹ * 2 :=
            mul_le_mul_of_nonneg_left hξ1_lt.le (inv_nonneg.mpr hr_cut_pos.le)
        _ = 2 * r_cut⁻¹ := mul_comm _ _
    have hξ2_le : |ξ.2| ≤ 2 * R_cut := by
      rw [abs_mul, abs_of_pos hr_cut_pos] at hξ2_lt
      dsimp only [R_cut]
      calc |ξ.2| = r_cut⁻¹ * (r_cut * |ξ.2|) := by
            rw [← mul_assoc, inv_mul_cancel₀ hr_cut_pos.ne', one_mul]
        _ ≤ r_cut⁻¹ * 2 :=
            mul_le_mul_of_nonneg_left hξ2_lt.le (inv_nonneg.mpr hr_cut_pos.le)
        _ = 2 * r_cut⁻¹ := mul_comm _ _
    have hy_bd : ‖y_map ξ‖ ≤ 20 * a₀⁻¹ * (ε ^ (-θ)) := by
      rw [← hR_cut_eq]
      exact hy_map_bd R_cut ξ hR_cut_nn hξ1_le hξ2_le
    have hx_dist : ‖x_of ξ - X_o‖ ≤ 20 * a₀⁻¹ * (ε ^ (-θ)) * (lam_sys * ρ_t)⁻¹ := by
      have hsub : x_of ξ - X_o = σ_t • y_map ξ := add_sub_cancel_left X_o (σ_t • y_map ξ)
      rw [hsub, norm_smul, Real.norm_of_nonneg hσ_pos.le]
      dsimp only [σ_t]
      calc (lam_sys * ρ_t)⁻¹ * ‖y_map ξ‖
          ≤ (lam_sys * ρ_t)⁻¹ * (20 * a₀⁻¹ * (ε ^ (-θ))) :=
            mul_le_mul_of_nonneg_left hy_bd (inv_nonneg.mpr (mul_pos hlam_pos hρ_pos).le)
        _ = 20 * a₀⁻¹ * (ε ^ (-θ)) * (lam_sys * ρ_t)⁻¹ := mul_comm _ _
    exact h_pair_eq_x (x_of ξ) hx_dist
  let E_err : ℝ := C_W * (δ_small ^ N_tay + r_cut ^ N_tay)
  have hE_err_nn : 0 ≤ E_err :=
    mul_nonneg hCW_nn (add_nonneg (pow_nonneg hδ_nn _) (pow_nonneg hr_cut_pos.le _))
  have h_fub := fubini_pairing_transfer_and_l2_window_error
    Φ₀ (h_phase.1 0).continuous
    lam_sys ρ_t C_t R_win (((17 : ℝ) / 2048) * (M_L : ℝ)) (((30 : ℝ) / 2048) * (M_L : ℝ))
    (W_win 0) E_err
    hρ_pos hR_win_pos (hW_win_nn 0) hE_err_nn
    V_o X_o ψ_o W_o χ_ann
    (hψ_smooth 0).continuous (hW_smooth 0).continuous (hχ_ann_smooth 0).continuous
    hψ_supp hψ_bd hχ_ann_one (fun z => (hχ_ann_bd z).2)
    hW_in hW_out
    α_wt x_of hα_cont hα_int hx_cont
    (fun _ => rfl)
    H_all H_in hHall_meas hHall_l2 hHin_meas hHin_l2 hHin_supp h_pair_ξ
  have hE_err_le : E_err ≤ 2 * C_W * ε ^ ((N_tay : ℝ) * θ) := by
    have hr_pow : r_cut ^ N_tay = ε ^ ((N_tay : ℝ) * θ) := by
      dsimp only [r_cut]
      rw [← Real.rpow_natCast (ε ^ θ) N_tay, ← Real.rpow_mul hε_pos.le, mul_comm]
    have hδ_pow : δ_small ^ N_tay ≤ ε ^ ((N_tay : ℝ) * θ) := by
      dsimp only [δ_small]
      rw [← Real.rpow_natCast (ε ^ (h / 2)) N_tay, ← Real.rpow_mul hε_pos.le]
      have hexp : (N_tay : ℝ) * θ ≤ (h / 2) * (N_tay : ℝ) := by
        have hN_nn : (0 : ℝ) ≤ (N_tay : ℝ) := Nat.cast_nonneg N_tay
        nlinarith [hθ_le, hh, hN_nn]
      exact Real.rpow_le_rpow_of_exponent_ge hε_pos hε_le1 hexp
    dsimp only [E_err]
    calc C_W * (δ_small ^ N_tay + r_cut ^ N_tay)
        ≤ C_W * (ε ^ ((N_tay : ℝ) * θ) + ε ^ ((N_tay : ℝ) * θ)) := by
          rw [hr_pow]
          exact mul_le_mul_of_nonneg_left (add_le_add hδ_pow le_rfl) hCW_nn
      _ = 2 * C_W * ε ^ ((N_tay : ℝ) * θ) := by ring
  refine le_trans h_fub ?_
  have hH_sum_nn :
      0 ≤ Real.sqrt (∫ v, ‖H_in v‖ ^ 2) + Real.sqrt (∫ v, ‖H_all v‖ ^ 2) :=
    add_nonneg (Real.sqrt_nonneg _) (Real.sqrt_nonneg _)
  refine mul_le_mul_of_nonneg_right ?_ hH_sum_nn
  have h_pref_nn : 0 ≤ Real.sqrt Real.pi * R_win * W_win 0 :=
    mul_nonneg (mul_nonneg (Real.sqrt_nonneg _) hR_win_pos.le) (hW_win_nn 0)
  calc Real.sqrt Real.pi * R_win * W_win 0 * E_err
      ≤ Real.sqrt Real.pi * R_win * W_win 0 * (2 * C_W * ε ^ ((N_tay : ℝ) * θ)) :=
        mul_le_mul_of_nonneg_left hE_err_le h_pref_nn
    _ = C_loc * ε ^ ((N_tay : ℝ) * θ) := by
        dsimp only [C_loc]
        ring

theorem far_position_single_atom_obs_decay (a₀ a₁ A B_sys R_win : ℝ) (M_ord : ℕ) (M_atom_bd M_win_bd : ℕ → ℝ)
    (ha₀ : 0 < a₀) (ha₁ : a₀ ≤ a₁) (hA : 1 ≤ A)
    (hB_sys : 2 ≤ B_sys) (hR_win : 2 ≤ R_win) (hM_ord : 2 ≤ M_ord)
    (h_ibp_gen : ∀ (M : ℕ) (R : ℝ), 0 < R → ∀ (B D : ℕ → ℝ),
      ∃ C_ibp : ℝ, 0 ≤ C_ibp ∧
        ∀ (L_osc : ℝ), 0 < L_osc →
        ∀ (θ_fn : ℝ → ℝ), (∀ k : ℕ, ContDiff ℝ k θ_fn) →
          (∀ s : ℝ, |s| ≤ R + 2 → L_osc ≤ deriv θ_fn s) →
          (∀ m : ℕ, 1 ≤ m → m ≤ M → ∀ s : ℝ, |s| ≤ R + 2 →
            |iteratedDeriv m (deriv θ_fn) s| ≤ L_osc * D m) →
        ∀ (u_fn : ℝ → ℂ), (∀ k : ℕ, ContDiff ℝ k u_fn) →
          (∀ s : ℝ, R ≤ |s| → u_fn s = 0) →
          (∀ k : ℕ, k ≤ M → ∀ s : ℝ, ‖iteratedDeriv k u_fn s‖ ≤ B k) →
          ‖∫ s : ℝ, u_fn s * Complex.exp (Complex.I * (θ_fn s : ℂ))‖ ≤ C_ibp / L_osc ^ M) :
    ∃ (B_X C_far : ℝ),
      2 ≤ B_X ∧ 0 ≤ C_far ∧
      ∀ (Φ₀ : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → ℝ)
        (ζ₀ : EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → EuclideanSpace ℝ (Fin 2)),
        IsNormalizedPosDefPhase a₀ a₁ A Φ₀ ζ₀ →
      ∀ (lam_sys ρ_r ρ_t s_c C_r C_t : ℝ)
        (V_at X_at V_o X_o : EuclideanSpace ℝ (Fin 2))
        (ψ_at ψ_loc : EuclideanSpace ℝ (Fin 2) → ℂ),
        0 < lam_sys → 0 < ρ_r → ρ_r ≤ ρ_t → ρ_t ≤ 1 → 0 < s_c →
        lam_sys * ρ_r ^ 2 * s_c ≤ 2 * B_sys →
        C_r ∈ Set.Icc (0 : ℝ) 1 → C_t ∈ Set.Icc (0 : ℝ) 1 → |C_t - C_r| ≤ s_c / 2 →
        (∀ k : ℕ, ContDiff ℝ k ψ_at) →
        (∀ z : EuclideanSpace ℝ (Fin 2), 4 ≤ ‖z‖ → ψ_at z = 0) →
        (∀ (k : ℕ) (z : EuclideanSpace ℝ (Fin 2)), ‖iteratedFDeriv ℝ k ψ_at z‖ ≤ M_atom_bd k) →
        (∀ k : ℕ, ContDiff ℝ k ψ_loc) →
        (∀ z : EuclideanSpace ℝ (Fin 2), R_win ≤ ‖z‖ → ψ_loc z = 0) →
        (∀ (k : ℕ) (z : EuclideanSpace ℝ (Fin 2)), ‖iteratedFDeriv ℝ k ψ_loc z‖ ≤ M_win_bd k) →
        ∀ R_tr : ℝ, B_X ≤ R_tr →
          R_tr * (lam_sys * ρ_r)⁻¹ ≤ ‖X_o - X_at - (C_t - C_r) • V_at‖ →
          ‖(ρ_t⁻¹ : ℂ) * ∫ v : EuclideanSpace ℝ (Fin 2),
            (((ρ_r⁻¹ : ℂ) * star (ψ_at (ρ_r⁻¹ • (v - V_at))) *
              Complex.exp (-(Complex.I * ((lam_sys * Φ₀ (C_r, X_at, v) : ℝ) : ℂ)))) *
             ψ_loc (ρ_t⁻¹ • (v - V_o)) *
             Complex.exp (Complex.I * ((lam_sys * Φ₀ (C_t, X_o, v) : ℝ) : ℂ)))‖ ≤
            C_far * R_tr ^ (-(M_ord : ℝ)) :=
by
  let W₁ : ℕ → ℝ := fun i => max (M_atom_bd i) 1
  let W₂ : ℕ → ℝ := fun j => max (M_win_bd j) 1
  let B_amp : ℕ → ℝ := fun k =>
    ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * W₁ i * W₂ (k - i)
  let D_phase : ℕ → ℝ := fun m =>
    (2 / a₀ + 10 * B_sys) * A ^ (m + 1) * ((m.factorial : ℝ) ^ 3) +
      B_sys * (m : ℝ) * A ^ m * (((m - 1).factorial : ℝ) ^ 3)

  
  have h_s1_slice :
      ∀ (lam_sys ρ_r ρ_t C_r C_t : ℝ)
        (Φ₀ : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → ℝ)
        (V_at X_at V_o X_o e : EuclideanSpace ℝ (Fin 2))
        (ψ_at ψ_loc : EuclideanSpace ℝ (Fin 2) → ℂ)
        (M_sl : ℝ),
        0 < ρ_r → ρ_r ≤ ρ_t → Continuous Φ₀ →
        Continuous ψ_at →
        (∀ z : EuclideanSpace ℝ (Fin 2), 4 ≤ ‖z‖ → ψ_at z = 0) →
        Continuous ψ_loc →
        ‖e‖ = 1 → 0 ≤ M_sl →
        (∀ y₁ ∈ Set.Icc (-4 : ℝ) 4,
          ‖∫ s : ℝ,
            (star (ψ_at (s • e + y₁ • perp2D e)) *
              ψ_loc (ρ_t⁻¹ • (V_at - V_o) + (ρ_r / ρ_t) • (s • e + y₁ • perp2D e))) *
            Complex.exp (Complex.I *
              ((lam_sys * (Φ₀ (C_t, X_o, V_at + ρ_r • (s • e + y₁ • perp2D e)) -
                Φ₀ (C_r, X_at, V_at + ρ_r • (s • e + y₁ • perp2D e))) : ℝ) : ℂ))‖ ≤ M_sl) →
        ‖(ρ_t⁻¹ : ℂ) * ∫ v : EuclideanSpace ℝ (Fin 2),
          (((ρ_r⁻¹ : ℂ) * star (ψ_at (ρ_r⁻¹ • (v - V_at))) *
            Complex.exp (-(Complex.I * ((lam_sys * Φ₀ (C_r, X_at, v) : ℝ) : ℂ)))) *
           ψ_loc (ρ_t⁻¹ • (v - V_o)) *
           Complex.exp (Complex.I * ((lam_sys * Φ₀ (C_t, X_o, v) : ℝ) : ℂ)))‖ ≤
          8 * M_sl := by
    clear ha₀ ha₁ hA hB_sys hR_win hM_ord h_ibp_gen W₁ W₂ B_amp D_phase M_atom_bd M_win_bd
    intro lam_sys ρ_r ρ_t C_r C_t Φ₀ V_at X_at V_o X_o e ψ_at ψ_loc M_sl
      hρ_r hρ_le hΦ_cont hψ_at_cont hψ_at_supp hψ_loc_cont he hM_sl h_slice
    have hρ_t : 0 < ρ_t := lt_of_lt_of_le hρ_r hρ_le
    have hρ_r_ne : ρ_r ≠ 0 := ne_of_gt hρ_r
    have hρ_t_ne : ρ_t ≠ 0 := ne_of_gt hρ_t
    have hr_sc_nn : 0 ≤ ρ_r / ρ_t := div_nonneg hρ_r.le hρ_t.le
    have hr_sc_le : ρ_r / ρ_t ≤ 1 := div_le_one_of_le₀ hρ_le hρ_t.le
    have he_sq : (e 0) ^ 2 + (e 1) ^ 2 = 1 := by
      have h := PiLp.norm_sq_eq_of_L2 (fun _ : Fin 2 => ℝ) e
      rw [he, one_pow, Fin.sum_univ_two] at h
      simpa [Real.norm_eq_abs, sq_abs] using h.symm
    let R_e : EuclideanSpace ℝ (Fin 2) ≃ₗᵢ[ℝ] EuclideanSpace ℝ (Fin 2) :=
      { toFun := fun u => (u 0) • e + (u 1) • perp2D e
        map_add' := fun u v => by
          ext i; fin_cases i <;> simp [perp2D] <;> ring
        map_smul' := fun c u => by
          ext i; fin_cases i <;> simp [perp2D] <;> ring
        invFun := fun z => WithLp.toLp 2 (fun i : Fin 2 =>
          if i = 0 then z 0 * e 0 + z 1 * e 1 else -(z 0 * e 1) + z 1 * e 0)
        left_inv := fun u => by
          ext i; fin_cases i <;> simp [perp2D]
          · linear_combination (u 0) * he_sq
          · linear_combination (u 1) * he_sq
        right_inv := fun z => by
          ext i; fin_cases i <;> simp [perp2D]
          · linear_combination (z 0) * he_sq
          · linear_combination (z 1) * he_sq
        norm_map' := fun u => by
          have h1 := PiLp.norm_sq_eq_of_L2 (fun _ : Fin 2 => ℝ) ((u 0) • e + (u 1) • perp2D e)
          have h2 := PiLp.norm_sq_eq_of_L2 (fun _ : Fin 2 => ℝ) u
          rw [Fin.sum_univ_two] at h1 h2
          have hsq : ‖(u 0) • e + (u 1) • perp2D e‖ ^ 2 = ‖u‖ ^ 2 := by
            rw [h1, h2]
            simp only [PiLp.add_apply, PiLp.smul_apply, smul_eq_mul, perp2D,
              Real.norm_eq_abs, sq_abs]
            norm_num
            linear_combination ((u 0) ^ 2 + (u 1) ^ 2) * he_sq
          exact (sq_eq_sq₀ (norm_nonneg _) (norm_nonneg _)).mp hsq }
    have h_rot_norm_sq : ∀ s y₁ : ℝ, ‖s • e + y₁ • perp2D e‖ ^ 2 = s ^ 2 + y₁ ^ 2 := by
      intro s y₁
      have h1 := PiLp.norm_sq_eq_of_L2 (fun _ : Fin 2 => ℝ) (s • e + y₁ • perp2D e)
      rw [Fin.sum_univ_two] at h1
      rw [h1]
      simp only [PiLp.add_apply, PiLp.smul_apply, smul_eq_mul, perp2D,
        Real.norm_eq_abs, sq_abs]
      norm_num
      linear_combination (s ^ 2 + y₁ ^ 2) * he_sq
    let G_z : EuclideanSpace ℝ (Fin 2) → ℂ := fun z =>
      (star (ψ_at z) * ψ_loc (ρ_t⁻¹ • (V_at - V_o) + (ρ_r / ρ_t) • z)) *
        Complex.exp (Complex.I *
          ((lam_sys * (Φ₀ (C_t, X_o, V_at + ρ_r • z) -
            Φ₀ (C_r, X_at, V_at + ρ_r • z)) : ℝ) : ℂ))
    have h_haar :
        (ρ_t⁻¹ : ℂ) * ∫ v : EuclideanSpace ℝ (Fin 2),
          (((ρ_r⁻¹ : ℂ) * star (ψ_at (ρ_r⁻¹ • (v - V_at))) *
            Complex.exp (-(Complex.I * ((lam_sys * Φ₀ (C_r, X_at, v) : ℝ) : ℂ)))) *
           ψ_loc (ρ_t⁻¹ • (v - V_o)) *
           Complex.exp (Complex.I * ((lam_sys * Φ₀ (C_t, X_o, v) : ℝ) : ℂ))) =
        ((ρ_r / ρ_t : ℝ) : ℂ) * ∫ z : EuclideanSpace ℝ (Fin 2), G_z z := by
      let F₀ : EuclideanSpace ℝ (Fin 2) → ℂ := fun v =>
        (star (ψ_at (ρ_r⁻¹ • (v - V_at))) * ψ_loc (ρ_t⁻¹ • (v - V_o))) *
          Complex.exp (Complex.I *
            ((lam_sys * (Φ₀ (C_t, X_o, v) - Φ₀ (C_r, X_at, v)) : ℝ) : ℂ))
      have h_pt : (fun v : EuclideanSpace ℝ (Fin 2) =>
          (((ρ_r⁻¹ : ℂ) * star (ψ_at (ρ_r⁻¹ • (v - V_at))) *
            Complex.exp (-(Complex.I * ((lam_sys * Φ₀ (C_r, X_at, v) : ℝ) : ℂ)))) *
           ψ_loc (ρ_t⁻¹ • (v - V_o)) *
           Complex.exp (Complex.I * ((lam_sys * Φ₀ (C_t, X_o, v) : ℝ) : ℂ)))) =
          (fun v => (ρ_r⁻¹ : ℂ) * F₀ v) := by
        ext v
        dsimp only [F₀]
        have hexp :
            Complex.exp (-(Complex.I * ((lam_sys * Φ₀ (C_r, X_at, v) : ℝ) : ℂ))) *
              Complex.exp (Complex.I * ((lam_sys * Φ₀ (C_t, X_o, v) : ℝ) : ℂ)) =
            Complex.exp (Complex.I *
              ((lam_sys * (Φ₀ (C_t, X_o, v) - Φ₀ (C_r, X_at, v)) : ℝ) : ℂ)) := by
          rw [← Complex.exp_add]
          congr 1
          push_cast
          ring
        calc (((ρ_r⁻¹ : ℂ) * star (ψ_at (ρ_r⁻¹ • (v - V_at))) *
              Complex.exp (-(Complex.I * ((lam_sys * Φ₀ (C_r, X_at, v) : ℝ) : ℂ)))) *
             ψ_loc (ρ_t⁻¹ • (v - V_o)) *
             Complex.exp (Complex.I * ((lam_sys * Φ₀ (C_t, X_o, v) : ℝ) : ℂ)))
            = (ρ_r⁻¹ : ℂ) * ((star (ψ_at (ρ_r⁻¹ • (v - V_at))) * ψ_loc (ρ_t⁻¹ • (v - V_o))) *
                (Complex.exp (-(Complex.I * ((lam_sys * Φ₀ (C_r, X_at, v) : ℝ) : ℂ))) *
                  Complex.exp (Complex.I * ((lam_sys * Φ₀ (C_t, X_o, v) : ℝ) : ℂ)))) := by ring
          _ = (ρ_r⁻¹ : ℂ) * ((star (ψ_at (ρ_r⁻¹ • (v - V_at))) * ψ_loc (ρ_t⁻¹ • (v - V_o))) *
                Complex.exp (Complex.I *
                  ((lam_sys * (Φ₀ (C_t, X_o, v) - Φ₀ (C_r, X_at, v)) : ℝ) : ℂ))) := by rw [hexp]
      rw [h_pt, MeasureTheory.integral_const_mul,
        ← MeasureTheory.integral_add_right_eq_self F₀ V_at]
      have h_shift : (fun u : EuclideanSpace ℝ (Fin 2) => F₀ (u + V_at)) =
          (fun u => G_z (ρ_r⁻¹ • u)) := by
        ext u
        dsimp only [F₀, G_z]
        have hu2 : u + V_at = V_at + ρ_r • (ρ_r⁻¹ • u) := by
          rw [smul_inv_smul₀ hρ_r_ne, add_comm]
        have hu3 : ρ_t⁻¹ • (u + V_at - V_o) =
            ρ_t⁻¹ • (V_at - V_o) + (ρ_r / ρ_t) • (ρ_r⁻¹ • u) := by
          have hsub : u + V_at - V_o = (V_at - V_o) + ρ_r • (ρ_r⁻¹ • u) := by
            rw [smul_inv_smul₀ hρ_r_ne]; abel
          rw [hsub, smul_add, smul_smul]
