    he3_step_mp.comp (he2_mp.comp he1_mp)
  have he3_symm_mp : MeasureTheory.MeasurePreserving e3.symm
      (MeasureTheory.volume.prod MeasureTheory.volume) MeasureTheory.volume :=
    he3_mp.symm e3
  have he3_symm_apply : ∀ (t : ℝ) (v : EuclideanSpace ℝ (Fin 2)),
      e3.symm (t, v) = sliceEmbed v t := by
    intro t v
    ext i
    fin_cases i <;> rfl

  let U0 : Set (EuclideanSpace ℝ (Fin 3)) :=
    { u : EuclideanSpace ℝ (Fin 3) |
      u 0 ∈ Set.Ioo (-1 / 8) (9 / 8) ∧
      u 1 ∈ Set.Ioo (-1 / 8) (9 / 8) ∧
      u 2 ∈ Set.Ioo (1 / 6) 2 }
  let V_cx : Set (ℝ × EuclideanSpace ℝ (Fin 2)) :=
    { cx : ℝ × EuclideanSpace ℝ (Fin 2) |
      cx.1 ∈ Set.Ioo (1 / 32) (23 / 32) ∧
      (pseudoconformalPt cx.1 cx.2) 0 ∈ Set.Ioo (-1 / 8) (9 / 8) ∧
      (pseudoconformalPt cx.1 cx.2) 1 ∈ Set.Ioo (-1 / 8) (9 / 8) }
  let Ψ3 : EuclideanSpace ℝ (Fin 3) → EuclideanSpace ℝ (Fin 3) := fun q =>
    L3_toLp ![8 * (1 / 4 + 8 * q 2)⁻¹ * q 0, 8 * (1 / 4 + 8 * q 2)⁻¹ * q 1, (1 / 4 + 8 * q 2)⁻¹]
  let V3 : Set (EuclideanSpace ℝ (Fin 3)) :=
    { p : EuclideanSpace ℝ (Fin 3) |
      p 2 ∈ Set.Ioo (1 / 32) (23 / 32) ∧
      (Ψ3 p) 0 ∈ Set.Ioo (-1 / 8) (9 / 8) ∧
      (Ψ3 p) 1 ∈ Set.Ioo (-1 / 8) (9 / 8) }

  have hU0_meas : MeasurableSet U0 := by
    have hc0 : Continuous (fun u : EuclideanSpace ℝ (Fin 3) => u 0) :=
      PiLp.continuous_apply 2 _ 0
    have hc1 : Continuous (fun u : EuclideanSpace ℝ (Fin 3) => u 1) :=
      PiLp.continuous_apply 2 _ 1
    have hc2 : Continuous (fun u : EuclideanSpace ℝ (Fin 3) => u 2) :=
      PiLp.continuous_apply 2 _ 2
    exact (measurableSet_Ioo.preimage hc0.measurable).inter
      ((measurableSet_Ioo.preimage hc1.measurable).inter
        (measurableSet_Ioo.preimage hc2.measurable))

  have hV3_meas : MeasurableSet V3 := by
    have hm0 : Measurable (fun p : EuclideanSpace ℝ (Fin 3) => p 0) :=
      (PiLp.continuous_apply 2 _ 0).measurable
    have hm1 : Measurable (fun p : EuclideanSpace ℝ (Fin 3) => p 1) :=
      (PiLp.continuous_apply 2 _ 1).measurable
    have hm2 : Measurable (fun p : EuclideanSpace ℝ (Fin 3) => p 2) :=
      (PiLp.continuous_apply 2 _ 2).measurable
    have hmsinv : Measurable (fun p : EuclideanSpace ℝ (Fin 3) => (1 / 4 + 8 * p 2)⁻¹) :=
      (measurable_const.add (measurable_const.mul hm2)).inv
    have hg0 : Measurable (fun p : EuclideanSpace ℝ (Fin 3) => (Ψ3 p) 0) :=
      (measurable_const.mul hmsinv).mul hm0
    have hg1 : Measurable (fun p : EuclideanSpace ℝ (Fin 3) => (Ψ3 p) 1) :=
      (measurable_const.mul hmsinv).mul hm1
    exact (measurableSet_Ioo.preimage hm2).inter
      ((measurableSet_Ioo.preimage hg0).inter (measurableSet_Ioo.preimage hg1))

  have h_jac : ∀ H : EuclideanSpace ℝ (Fin 3) → ENNReal,
      ∫⁻ u in U0, H u ∂MeasureTheory.volume ≤
        8192 * ∫⁻ cx in V_cx, H (pseudoconformalPt cx.1 cx.2) ∂MeasureTheory.volume := by
    intro H
    let Φ3 : EuclideanSpace ℝ (Fin 3) → EuclideanSpace ℝ (Fin 3) := fun u =>
      L3_toLp ![(1 / 8) * (u 2)⁻¹ * u 0, (1 / 8) * (u 2)⁻¹ * u 1, (1 / 8) * ((u 2)⁻¹ - 1 / 4)]
    have h_left_inv : ∀ p ∈ V3, Φ3 (Ψ3 p) = p := by
      intro p hp
      have hs_pos : 0 < 1 / 4 + 8 * p 2 := by linarith [hp.1.1]
      have hs_ne : 1 / 4 + 8 * p 2 ≠ 0 := ne_of_gt hs_pos
      have hs_ne' : 1 + 8 * 4 * p 2 ≠ 0 := by linarith [hp.1.1]
      ext i
      fin_cases i
      · change (1 / 8) * ((1 / 4 + 8 * p 2)⁻¹)⁻¹ * (8 * (1 / 4 + 8 * p 2)⁻¹ * p 0) = p 0
        rw [inv_inv]; field_simp
      · change (1 / 8) * ((1 / 4 + 8 * p 2)⁻¹)⁻¹ * (8 * (1 / 4 + 8 * p 2)⁻¹ * p 1) = p 1
        rw [inv_inv]; field_simp
      · change (1 / 8) * (((1 / 4 + 8 * p 2)⁻¹)⁻¹ - 1 / 4) = p 2
        rw [inv_inv]; ring
    have hΨ3_inj : Set.InjOn Ψ3 V3 := by
      intro p1 hp1 p2 hp2 heq
      rw [← h_left_inv p1 hp1, ← h_left_inv p2 hp2, heq]
    have hΨ3_image : Ψ3 '' V3 = U0 := by
      ext u
      constructor
      · rintro ⟨p, hp, rfl⟩
        have hs_gt : 1 / 2 < 1 / 4 + 8 * p 2 := by linarith [hp.1.1]
        have hs_lt : 1 / 4 + 8 * p 2 < 6 := by linarith [hp.1.2]
        have hs_pos : 0 < 1 / 4 + 8 * p 2 := by linarith
        refine ⟨hp.2.1, hp.2.2, ?_, ?_⟩
        · change 1 / 6 < (1 / 4 + 8 * p 2)⁻¹
          rw [one_div, inv_lt_inv₀ (by norm_num) hs_pos]
          exact hs_lt
        · change (1 / 4 + 8 * p 2)⁻¹ < 2
          rw [inv_lt_comm₀ hs_pos (by norm_num)]
          linarith
      · intro hu
        let p := Φ3 u
        have hu2_pos : 0 < u 2 := by linarith [hu.2.2.1]
        have hu2_ne : u 2 ≠ 0 := ne_of_gt hu2_pos
        have hu2_inv_gt : 1 / 2 < (u 2)⁻¹ := by
          rw [one_div, inv_lt_inv₀ (by norm_num) hu2_pos]
          exact hu.2.2.2
        have hu2_inv_lt : (u 2)⁻¹ < 6 := by
          rw [inv_lt_comm₀ hu2_pos (by norm_num)]
          linarith [hu.2.2.1]
        have hΨ3_p : Ψ3 p = u := by
          have hs_eq : 1 / 4 + 8 * p 2 = (u 2)⁻¹ := by
            change 1 / 4 + 8 * ((1 / 8) * ((u 2)⁻¹ - 1 / 4)) = (u 2)⁻¹
            ring
          ext i
          fin_cases i
          · change 8 * (1 / 4 + 8 * p 2)⁻¹ * ((1 / 8) * (u 2)⁻¹ * u 0) = u 0
            rw [hs_eq, inv_inv]
            field_simp
          · change 8 * (1 / 4 + 8 * p 2)⁻¹ * ((1 / 8) * (u 2)⁻¹ * u 1) = u 1
            rw [hs_eq, inv_inv]
            field_simp
          · change (1 / 4 + 8 * p 2)⁻¹ = u 2
            rw [hs_eq, inv_inv]
        have hp_mem : p ∈ V3 := by
          refine ⟨⟨?_, ?_⟩, ?_, ?_⟩
          · change 1 / 32 < (1 / 8) * ((u 2)⁻¹ - 1 / 4)
            linarith
          · change (1 / 8) * ((u 2)⁻¹ - 1 / 4) < 23 / 32
            linarith
          · rw [hΨ3_p]; exact hu.1
          · rw [hΨ3_p]; exact hu.2.1
        exact ⟨p, hp_mem, hΨ3_p⟩
    let π3 : Fin 3 → (EuclideanSpace ℝ (Fin 3) →L[ℝ] ℝ) :=
      fun i => PiLp.proj 2 (fun _ : Fin 3 => ℝ) i
    let d_vec : EuclideanSpace ℝ (Fin 3) → Fin 3 → (EuclideanSpace ℝ (Fin 3) →L[ℝ] ℝ) :=
      fun p =>
        let s := 1 / 4 + 8 * p 2
        ![(8 * s⁻¹) • π3 0 +
            (p 0) • ((8 : ℝ) • (-(s ^ 2)⁻¹ • ((0 : EuclideanSpace ℝ (Fin 3) →L[ℝ] ℝ) + (8 : ℝ) • π3 2))),
          (8 * s⁻¹) • π3 1 +
            (p 1) • ((8 : ℝ) • (-(s ^ 2)⁻¹ • ((0 : EuclideanSpace ℝ (Fin 3) →L[ℝ] ℝ) + (8 : ℝ) • π3 2))),
          -(s ^ 2)⁻¹ • ((0 : EuclideanSpace ℝ (Fin 3) →L[ℝ] ℝ) + (8 : ℝ) • π3 2)]
    let f' : EuclideanSpace ℝ (Fin 3) → (EuclideanSpace ℝ (Fin 3) →L[ℝ] EuclideanSpace ℝ (Fin 3)) :=
      fun p => L3_toLp.toContinuousLinearMap.comp (ContinuousLinearMap.pi (d_vec p))
    have hΨ3_fd : ∀ p ∈ V3, HasFDerivWithinAt Ψ3 (f' p) V3 p := by
      intro p hp
      have hs_gt : 1 / 2 < 1 / 4 + 8 * p 2 := by linarith [hp.1.1]
      have hs_ne : 1 / 4 + 8 * p 2 ≠ 0 := by linarith
      have hs_fd : HasFDerivAt (fun q : EuclideanSpace ℝ (Fin 3) => 1 / 4 + 8 * q 2)
          ((0 : EuclideanSpace ℝ (Fin 3) →L[ℝ] ℝ) + (8 : ℝ) • π3 2) p :=
        (hasFDerivAt_const (1 / 4 : ℝ) p).add (((π3 2).hasFDerivAt).const_smul (8 : ℝ))
      have hsinv_fd : HasFDerivAt (fun q : EuclideanSpace ℝ (Fin 3) => (1 / 4 + 8 * q 2)⁻¹)
          (-((1 / 4 + 8 * p 2) ^ 2)⁻¹ • ((0 : EuclideanSpace ℝ (Fin 3) →L[ℝ] ℝ) + (8 : ℝ) • π3 2)) p :=
        (hasDerivAt_inv hs_ne).comp_hasFDerivAt p hs_fd
      have h8sinv_fd := hsinv_fd.const_smul (8 : ℝ)
      have hd0 := h8sinv_fd.mul (π3 0).hasFDerivAt
      have hd1 := h8sinv_fd.mul (π3 1).hasFDerivAt
      have h_pi : HasFDerivAt
          (fun q : EuclideanSpace ℝ (Fin 3) =>
            ![8 * (1 / 4 + 8 * q 2)⁻¹ * q 0, 8 * (1 / 4 + 8 * q 2)⁻¹ * q 1, (1 / 4 + 8 * q 2)⁻¹])
          (ContinuousLinearMap.pi (d_vec p)) p := by
        rw [hasFDerivAt_pi]
        intro i
        fin_cases i
        · exact hd0
        · exact hd1
        · exact hsinv_fd
      exact (L3_toLp.hasFDerivAt.comp p h_pi).hasFDerivWithinAt
    have hdet_le : ∀ p ∈ V3, |(f' p).det| ≤ 8192 := by
      intro p hp
      let s : ℝ := 1 / 4 + 8 * p 2
      have hs_gt : 1 / 2 < s := by dsimp [s]; linarith [hp.1.1]
      have hs_pos : 0 < s := by linarith
      let b := (EuclideanSpace.basisFun (Fin 3) ℝ).toBasis
      rw [show (f' p).det = LinearMap.det (f' p).toLinearMap from rfl,
        ← LinearMap.det_toMatrix b (f' p).toLinearMap, Matrix.det_fin_three]
      have hb_apply : ∀ (i j : Fin 3),
          (LinearMap.toMatrix b b (f' p).toLinearMap) i j = (f' p (b j)) i := by
        intro i j
        simp [LinearMap.toMatrix_apply, b, EuclideanSpace.basisFun_repr]
      simp only [hb_apply, f', L3_toLp, d_vec, π3, b, ContinuousLinearMap.comp_apply,
        ContinuousLinearEquiv.coe_coe, PiLp.continuousLinearEquiv_symm_apply,
        ContinuousLinearMap.pi_apply, add_apply, smul_apply, zero_apply,
        PiLp.proj_apply, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two,
        smul_eq_mul]
      norm_num
      change 8 * |s|⁻¹ * (8 * |s|⁻¹) * ((s ^ 2)⁻¹ * 8) ≤ 8192
      rw [abs_of_pos hs_pos]
      have h_alg : 8 * s⁻¹ * (8 * s⁻¹) * ((s ^ 2)⁻¹ * 8) = 512 * (s⁻¹) ^ 4 := by
        field_simp
        ring
      rw [h_alg]
      have hsinv_nn : 0 ≤ s⁻¹ := inv_nonneg.mpr hs_pos.le
      have hsinv_lt : s⁻¹ < 2 := by
        rw [inv_lt_comm₀ hs_pos (by norm_num)]
        linarith
      have hpow : (s⁻¹) ^ 4 ≤ 2 ^ 4 := pow_le_pow_left₀ hsinv_nn hsinv_lt.le 4
      linarith
    rw [← hΨ3_image,
      MeasureTheory.lintegral_image_eq_lintegral_abs_det_fderiv_mul
        MeasureTheory.volume hV3_meas hΨ3_fd hΨ3_inj H]
    have h_le_8192 : ∫⁻ p in V3, ENNReal.ofReal |(f' p).det| * H (Ψ3 p) ∂MeasureTheory.volume ≤
        8192 * ∫⁻ p in V3, H (Ψ3 p) ∂MeasureTheory.volume := by
      rw [← MeasureTheory.lintegral_const_mul' 8192 _ (by norm_num)]
      refine MeasureTheory.setLIntegral_mono' hV3_meas (fun p hp => ?_)
      refine mul_le_mul_of_nonneg_right ?_ zero_le
      calc ENNReal.ofReal |(f' p).det|
          ≤ ENNReal.ofReal 8192 := ENNReal.ofReal_le_ofReal (hdet_le p hp)
        _ = 8192 := by norm_num
    have h_comp_pt : ∀ cx : ℝ × EuclideanSpace ℝ (Fin 2),
        Ψ3 (e3.symm cx) = pseudoconformalPt cx.1 cx.2 := by
      intro cx
      rw [show cx = (cx.1, cx.2) from rfl, he3_symm_apply]
      ext i
      fin_cases i <;> rfl
    have h_preimage : e3.symm ⁻¹' V3 = V_cx := by
      ext cx
      simp only [Set.mem_preimage, V3, V_cx]
      rw [show cx = (cx.1, cx.2) from rfl, he3_symm_apply]
      rfl
    have h_mp_eq := he3_symm_mp.setLIntegral_comp_preimage_emb e3.symm.measurableEmbedding
      (fun p => H (Ψ3 p)) V3
    rw [h_preimage] at h_mp_eq
    simp only [h_comp_pt] at h_mp_eq
    change ∫⁻ p in V3, ENNReal.ofReal |(f' p).det| * H (Ψ3 p) ∂MeasureTheory.volume ≤
      8192 * ∫⁻ cx in V_cx, H (pseudoconformalPt cx.1 cx.2)
        ∂(MeasureTheory.volume.prod MeasureTheory.volume)
    rw [h_mp_eq]
    exact h_le_8192

  
  
  
  let distPhaseSliceOp : (EuclideanSpace ℝ (Fin 2) → ℂ) → EuclideanSpace ℝ (Fin 3) → ℂ :=
    fun f u =>
      ∫ v : EuclideanSpace ℝ (Fin 2),
        Complex.exp (2 * Real.pi * Complex.I * ((σ * lam * ‖u - sliceEmbed v 0‖ : ℝ) : ℂ)) *
          a_dir (u - sliceEmbed v 0) * f v

  have h_slice_u0 : ∀ (f : EuclideanSpace ℝ (Fin 2) → ℂ),
      Continuous f →
      (∀ v : EuclideanSpace ℝ (Fin 2), 6 ≤ ‖v‖ → f v = 0) →
      ∫⁻ u in U0, ‖distPhaseSliceOp f u‖ₑ ^ (3 : ℝ) ∂MeasureTheory.volume ≤
        8192 * (ENNReal.ofReal (C_2d ^ 3) *
          ∫⁻ v : EuclideanSpace ℝ (Fin 2), ‖f v‖ₑ ^ (3 : ℝ) ∂MeasureTheory.volume) := by
    intro f hf_cont hf_supp
    have h_pt_eq : ∀ cx ∈ V_cx,
        distPhaseSliceOp f (pseudoconformalPt cx.1 cx.2) =
          oscIntegralOp2D lam Φ B_a f cx := by
      intro cx hcx
      rcases cx with ⟨c, x⟩
      have hc_icc : c ∈ Set.Icc (1 / 32 : ℝ) (23 / 32) := ⟨hcx.1.1.le, hcx.1.2.le⟩
      let s : ℝ := 1 / 4 + 8 * c
      have hs_bounds : 1 / 2 < s ∧ s < 6 := by
        dsimp [s]; constructor <;> linarith [hcx.1.1, hcx.1.2]
      have hs_pos : 0 < s := by linarith [hs_bounds.1]
      have hs_ne : s ≠ 0 := ne_of_gt hs_pos
      let u := pseudoconformalPt c x
      have hu0 : u 0 ∈ Set.Ioo (-1 / 8 : ℝ) (9 / 8) := hcx.2.1
      have hu1 : u 1 ∈ Set.Ioo (-1 / 8 : ℝ) (9 / 8) := hcx.2.2
      have hx0_eq : x 0 = (s / 8) * u 0 := by
        change x 0 = (s / 8) * (8 * s⁻¹ * x 0); field_simp
      have hx1_eq : x 1 = (s / 8) * u 1 := by
        change x 1 = (s / 8) * (8 * s⁻¹ * x 1); field_simp
      have hx_le_2 : ‖x‖ ≤ 2 := by
        have hu0_sq : (u 0) ^ 2 < (9 / 8) ^ 2 := by nlinarith [hu0.1, hu0.2]
        have hu1_sq : (u 1) ^ 2 < (9 / 8) ^ 2 := by nlinarith [hu1.1, hu1.2]
        have hs_sq : (s / 8) ^ 2 ≤ (6 / 8) ^ 2 := by nlinarith [hs_pos, hs_bounds.2]
        have hx_sq : ‖x‖ ^ 2 ≤ 4 := by
          rw [h_norm2_sq x, hx0_eq, hx1_eq]
          have h_f : ((s / 8) * u 0) ^ 2 + ((s / 8) * u 1) ^ 2 =
              (s / 8) ^ 2 * ((u 0) ^ 2 + (u 1) ^ 2) := by ring
          rw [h_f]
          have : 0 ≤ (u 0) ^ 2 + (u 1) ^ 2 := by positivity
          nlinarith
        nlinarith [norm_nonneg x]
      dsimp [distPhaseSliceOp, oscIntegralOp2D]
      refine MeasureTheory.integral_congr_ae (Filter.Eventually.of_forall (fun v => ?_))
      dsimp only
      have hB_v : B_a (c, x, v) = a_dir (u - sliceEmbed v 0) :=
        hB_eq c x v hc_icc hu0 hu1
      by_cases hv : ‖v‖ ≤ 5
      · have hΦ_v := hΦ_eq c x v hc_icc hx_le_2 hv
        have h_dist_eq : ‖u - sliceEmbed v 0‖ =
            s⁻¹ * Real.sqrt (1 + ‖(8 : ℝ) • x - s • v‖ ^ 2) := by
          have h_sq : ‖u - sliceEmbed v 0‖ ^ 2 =
              (s⁻¹) ^ 2 * (1 + ‖(8 : ℝ) • x - s • v‖ ^ 2) := by
            rw [h_norm3_sq (u - sliceEmbed v 0), h_norm2_sq ((8 : ℝ) • x - s • v)]
            have hd0 : (u - sliceEmbed v 0) 0 = 8 * s⁻¹ * x 0 - v 0 := rfl
            have hd1 : (u - sliceEmbed v 0) 1 = 8 * s⁻¹ * x 1 - v 1 := rfl
            have hd2 : (u - sliceEmbed v 0) 2 = s⁻¹ - 0 := rfl
            have hv0 : ((8 : ℝ) • x - s • v) 0 = 8 * x 0 - s * v 0 := by simp
            have hv1 : ((8 : ℝ) • x - s • v) 1 = 8 * x 1 - s * v 1 := by simp
            rw [hd0, hd1, hd2, hv0, hv1]
            field_simp
            ring
          calc ‖u - sliceEmbed v 0‖
              = Real.sqrt (‖u - sliceEmbed v 0‖ ^ 2) := (Real.sqrt_sq (norm_nonneg _)).symm
            _ = Real.sqrt ((s⁻¹) ^ 2 * (1 + ‖(8 : ℝ) • x - s • v‖ ^ 2)) := by rw [h_sq]
            _ = Real.sqrt ((s⁻¹) ^ 2) * Real.sqrt (1 + ‖(8 : ℝ) • x - s • v‖ ^ 2) :=
                Real.sqrt_mul (sq_nonneg _) _
            _ = s⁻¹ * Real.sqrt (1 + ‖(8 : ℝ) • x - s • v‖ ^ 2) := by
                rw [Real.sqrt_sq (inv_nonneg.mpr hs_pos.le)]
        have h_exp_arg :
            2 * (Real.pi : ℂ) * Complex.I * ((σ * lam * ‖u - sliceEmbed v 0‖ : ℝ) : ℂ) =
              Complex.I * ((lam * Φ (c, x, v) : ℝ) : ℂ) := by
          rw [hΦ_v, show 1 / 4 + 8 * c = s from rfl, h_dist_eq]
          push_cast
          ring
        change Complex.exp (2 * (Real.pi : ℂ) * Complex.I *
            ((σ * lam * ‖u - sliceEmbed v 0‖ : ℝ) : ℂ)) *
            a_dir (u - sliceEmbed v 0) * f v =
          Complex.exp (Complex.I * ((lam * Φ (c, x, v) : ℝ) : ℂ)) * B_a (c, x, v) * f v
        rw [h_exp_arg, hB_v]
      · push Not at hv
        have hB0 : B_a (c, x, v) = 0 := hB_supp c x v (Or.inr (Or.inr hv.le))
        have ha0 : a_dir (u - sliceEmbed v 0) = 0 := by rw [← hB_v, hB0]
        change Complex.exp (2 * (Real.pi : ℂ) * Complex.I *
            ((σ * lam * ‖u - sliceEmbed v 0‖ : ℝ) : ℂ)) *
            a_dir (u - sliceEmbed v 0) * f v =
          Complex.exp (Complex.I * ((lam * Φ (c, x, v) : ℝ) : ℂ)) * B_a (c, x, v) * f v
        rw [hB0, ha0]
        ring

    have hf_cs : HasCompactSupport f := by
      refine HasCompactSupport.of_support_subset_isCompact
        (isCompact_closedBall (0 : EuclideanSpace ℝ (Fin 2)) 6) (fun v hv => ?_)
      rw [mem_closedBall_zero_iff]
      by_contra h_gt
      push Not at h_gt
      exact hv (hf_supp v h_gt.le)
    have hf_int : MeasureTheory.Integrable f MeasureTheory.volume :=
      hf_cont.integrable_of_hasCompactSupport hf_cs
    have hf_memLp : MeasureTheory.MemLp f 3 MeasureTheory.volume :=
      hf_cont.memLp_of_hasCompactSupport hf_cs

    have h_osc_cont : Continuous (oscIntegralOp2D lam Φ B_a f) := by
      let MB0 : ℝ := M_B 0
      have hΦ_c : Continuous Φ := (hΦ_smooth 0).continuous
      have hB_c : Continuous B_a := (hB_smooth 0).continuous
      refine MeasureTheory.continuous_of_dominated (bound := fun v => MB0 * ‖f v‖) ?_ ?_ ?_ ?_
      · intro cx
        have hc : Continuous (fun v : EuclideanSpace ℝ (Fin 2) =>
            Complex.exp (Complex.I * ((lam * Φ (cx.1, cx.2, v) : ℝ) : ℂ)) *
              B_a (cx.1, cx.2, v) * f v) := by
          have h1 : Continuous (fun v => Φ (cx.1, cx.2, v)) :=
            hΦ_c.comp (continuous_const.prodMk (continuous_const.prodMk continuous_id))
          have h2 : Continuous (fun v => B_a (cx.1, cx.2, v)) :=
            hB_c.comp (continuous_const.prodMk (continuous_const.prodMk continuous_id))
          exact ((Complex.continuous_exp.comp
            (continuous_const.mul (Complex.continuous_ofReal.comp (continuous_const.mul h1)))).mul
            h2).mul hf_cont
        exact hc.aestronglyMeasurable
      · intro cx
