    have hmul := (div_lt_iff₀ hδ).mp hlog_lt
    linarith

  have h_mr_sc_bounds : ∀ {ε r : ℝ} {m_r : ℕ},
      0 < ε → ε < 1 / 2 → 0 < r →
      m_r = Nat.floor (r * Real.log (ε⁻¹) / Real.log 2) →
      ε ^ r ≤ ((2 : ℝ) ^ m_r)⁻¹ ∧ ((2 : ℝ) ^ m_r)⁻¹ ≤ 2 * ε ^ r := by
    intro ε r m_r hε₀ hε₁ hr hm_r
    have hell : 0 < Real.log (ε⁻¹) := h_ell_pos hε₀ hε₁
    have hlog2 : 0 < Real.log 2 := Real.log_pos (by norm_num)
    have hq_nn : 0 ≤ r * Real.log (ε⁻¹) / Real.log 2 := by positivity
    have hfl1 : (m_r : ℝ) ≤ r * Real.log (ε⁻¹) / Real.log 2 := by
      rw [hm_r]; exact Nat.floor_le hq_nn
    have hfl2 : r * Real.log (ε⁻¹) / Real.log 2 ≤ (m_r : ℝ) + 1 := by
      rw [hm_r]; exact (Nat.lt_floor_add_one _).le
    have hm1 : (m_r : ℝ) * Real.log 2 ≤ r * Real.log (ε⁻¹) := (le_div_iff₀ hlog2).mp hfl1
    have hm2 : r * Real.log (ε⁻¹) ≤ ((m_r : ℝ) + 1) * Real.log 2 := (div_le_iff₀ hlog2).mp hfl2
    have h_eps_r : ε ^ r = Real.exp (-(r * Real.log (ε⁻¹))) := by
      rw [Real.rpow_def_of_pos hε₀ r, Real.log_inv]
      congr 1; ring
    have h_sc : ((2 : ℝ) ^ m_r)⁻¹ = Real.exp (-((m_r : ℝ) * Real.log 2)) := by
      rw [← Real.rpow_natCast (2 : ℝ) m_r, Real.rpow_def_of_pos (by norm_num : (0 : ℝ) < 2) (m_r : ℝ),
        ← Real.exp_neg]
      congr 1; ring
    have h_2eps_r : 2 * ε ^ r = Real.exp (Real.log 2 - r * Real.log (ε⁻¹)) := by
      have h2 : (2 : ℝ) = Real.exp (Real.log 2) := (Real.exp_log (by norm_num)).symm
      rw [sub_eq_add_neg]
      conv_lhs => rw [h2, h_eps_r, ← Real.exp_add]
    rw [h_2eps_r, h_eps_r, h_sc]
    exact ⟨Real.exp_le_exp.mpr (by linarith), Real.exp_le_exp.mpr (by linarith)⟩

  have h_entropy_ub : ∀ {N : ℕ} (q : Fin N → ℝ) {ell : ℝ},
      1 ≤ N → 0 < ell → (∀ i, 0 ≤ q i) → (∑ i : Fin N, q i = 1) →
      (∑ i : Fin N, -(q i * Real.log (q i))) / ell ≤ Real.log (N : ℝ) / ell := by
    intro N q ell hN hell hq_nn hq_sum
    refine div_le_div_of_nonneg_right ?_ hell.le
    have hN_pos : (0 : ℝ) < (N : ℝ) := by exact_mod_cast (Nat.lt_of_lt_of_le Nat.zero_lt_one hN)
    have h_pt : ∀ i : Fin N,
        -(q i * Real.log (q i)) ≤ q i * Real.log (N : ℝ) + ((N : ℝ)⁻¹ - q i) := by
      intro i
      by_cases h0 : q i = 0
      · simp [h0]
      · have hqi : 0 < q i := lt_of_le_of_ne (hq_nn i) (Ne.symm h0)
        have hlog := Real.log_le_sub_one_of_pos (div_pos (inv_pos.mpr hN_pos) hqi)
        rw [Real.log_div (inv_ne_zero hN_pos.ne') hqi.ne', Real.log_inv] at hlog
        have hmul := mul_le_mul_of_nonneg_left hlog hqi.le
        have hcancel : q i * ((N : ℝ)⁻¹ / q i - 1) = (N : ℝ)⁻¹ - q i := by
          field_simp [hqi.ne']
        rw [hcancel] at hmul
        nlinarith
    calc ∑ i : Fin N, -(q i * Real.log (q i))
        ≤ ∑ i : Fin N, (q i * Real.log (N : ℝ) + ((N : ℝ)⁻¹ - q i)) :=
          Finset.sum_le_sum (fun i _ => h_pt i)
      _ = (∑ i : Fin N, q i) * Real.log (N : ℝ) +
            ((∑ _i : Fin N, (N : ℝ)⁻¹) - ∑ i : Fin N, q i) := by
          rw [Finset.sum_add_distrib, ← Finset.sum_mul, Finset.sum_sub_distrib]
      _ = Real.log (N : ℝ) := by
          have hconst : (∑ _i : Fin N, (N : ℝ)⁻¹) = 1 := by
            rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul,
              mul_inv_cancel₀ hN_pos.ne']
          rw [hq_sum, hconst]; ring

