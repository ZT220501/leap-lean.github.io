            add_nonneg (Finset.sum_nonneg (fun _ _ => abs_nonneg _)) (abs_nonneg _)))))
        (fun k => (h_each_k k).2) h_rhs_lim
    let r_cone_k : ℝ := min (δ_M m / 8) (h_m * c_gap / (8 * C_cone))
