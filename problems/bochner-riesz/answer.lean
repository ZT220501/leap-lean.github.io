  have hb_le_ut : b_star ≤ (H_P - t) / 2 := by dsimp only [u] at hu_nn; linarith only [hu_nn]
  have hut_ge_32h : (3 / 2 : ℝ) * h ≤ (H_P - t) / 2 := by
