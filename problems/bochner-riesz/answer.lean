      have h_nn := h_ent_nonneg (ε_seq k) (π_seq k)
        (fun ω => (T_seq k ω, dyadicTimeBin (ε_seq k) v (c_seq k ω)))
        (fun ω => dyadicRealBin (ε_seq k) (m * v) (R_seq k ω))
        (hε_bounds k).1 (hε_bounds k).2 (h_law_seq k).1
      have h_ub := h_orient_coarse_one (π_seq k) (T_seq k) (V_seq k) (A_seq k)
        (c_seq k) (R_seq k) (hε_bounds k).1 (hε_bounds k).2 huD.1.1.le huv (h_law_seq k)
      rw [Real.dist_eq, sub_zero, abs_of_nonneg h_nn]
      linarith

theorem countable_row_obs_homogenization (γ m : ℝ) (hγ₀ : 0 < γ) (hγ₁ : γ < 1) (hm : 0 < m)
    (b : ℝ → ℝ)
    (rpath : RowFrameDyadicPath γ m b)
    (h_row_ub : ∀ u ∈ Set.Ioo (0 : ℝ) 1, ∀ δ : ℝ, 0 < δ →
      ∃ ε₀ : ℝ, 0 < ε₀ ∧
        ∀ (ε : ℝ) (N_ω N_T : ℕ)
          (π : Fin N_ω → ℝ) (T_idx : Fin N_ω → Fin N_T)
          (V_part A_part : Fin N_T → EuclideanSpace ℝ (Fin 2))
          (c_s R_s : Fin N_ω → ℝ),
          0 < ε → ε < ε₀ →
          (∀ ω, 0 ≤ π ω) → (∑ ω : Fin N_ω, π ω = 1) →
          (∀ tid, ‖V_part tid‖ ≤ 1 ∧ ‖A_part tid‖ ≤ 1) →
          (∀ ω, 0 < π ω → c_s ω ∈ Set.Icc (0 : ℝ) 1 ∧ |R_s ω| ≤ 1) →
          rowObsScore ε γ m u (b u) π T_idx V_part A_part c_s R_s ≤
            classicalRootSupremum ε (1 + m) γ N_ω N_T π T_idx V_part A_part +
              (classicalGrowthRate γ + δ) * u) :
    ∃ (ε_seq : ℕ → ℝ)
      (N_ω N_T : ℕ → ℕ)
      (π_seq : ∀ k, Fin (N_ω k) → ℝ)
      (T_seq : ∀ k, Fin (N_ω k) → Fin (N_T k))
      (V_seq A_seq : ∀ k, Fin (N_T k) → EuclideanSpace ℝ (Fin 2))
      (c_seq R_seq : ∀ k, Fin (N_ω k) → ℝ)
      (τ : ℝ)
      (S : ℝ → ℝ)
      (H_uncond H_condT : List (ℚ × ℚ × ℚ × ℚ × ℚ) → ℝ),
      (0 ≤ τ ∧ τ ≤ 2 * (1 + m)) ∧
      (∀ u₁ u₂ : ℝ, u₁ ≤ u₂ → 0 ≤ S u₂ - S u₁ ∧ S u₂ - S u₁ ≤ u₂ - u₁) ∧
      S 0 = 0 ∧
      (∀ k, 0 < ε_seq k ∧ ε_seq k < 1 / 2) ∧
      Filter.Tendsto ε_seq Filter.atTop (nhds 0) ∧
      (∀ k, (∀ ω, 0 ≤ π_seq k ω) ∧ (∑ ω : Fin (N_ω k), π_seq k ω = 1) ∧
        (∀ tid, ‖V_seq k tid‖ ≤ 1 ∧ ‖A_seq k tid‖ ≤ 1) ∧
        (∀ ω, 0 < π_seq k ω → c_seq k ω ∈ Set.Icc (0 : ℝ) 1 ∧ |R_seq k ω| ≤ 1)) ∧
      (∀ (Q_fin : Finset (List (ℚ × ℚ × ℚ × ℚ × ℚ))) (δ : ℝ),
        (∀ L_list ∈ Q_fin, ∀ q ∈ L_list, (q.2.2.2.2 : ℝ) ∈ Set.Ioo (0 : ℝ) 1) →
        0 < δ →
        ∃ K₀ : ℕ, ∀ k : ℕ, K₀ ≤ k →
          ∃ E_good : Finset (Fin (N_ω k)),
            1 - δ ≤ (∑ ω ∈ E_good, π_seq k ω) ∧
            ∀ ω ∈ E_good, ∀ L_list ∈ Q_fin,
              let obs := fun ω' : Fin (N_ω k) =>
                L_list.map (fun q => rowObs6 (ε_seq k) m
                  (V_seq k (T_seq k ω')) (A_seq k (T_seq k ω')) (c_seq k ω') (R_seq k ω')
                  (q.1, q.2.1, q.2.2.1, q.2.2.2.1, q.2.2.2.2))
              |condSurprise (ε_seq k) (π_seq k) (fun _ => ()) obs ω - H_uncond L_list| ≤ δ ∧
              |condSurprise (ε_seq k) (π_seq k) (T_seq k) obs ω - H_condT L_list| ≤ δ) ∧
      (∀ q : ℚ × ℚ × ℚ × ℚ × ℚ, (q.2.2.2.2 : ℝ) ∈ Set.Ioo (0 : ℝ) 1 →
        Filter.Tendsto (fun k =>
          finMutualInfo (ε_seq k) (π_seq k) (T_seq k)
            (fun ω => rowObs6 (ε_seq k) m
              (V_seq k (T_seq k ω)) (A_seq k (T_seq k ω)) (c_seq k ω) (R_seq k ω)
              (q.1, q.2.1, q.2.2.1, q.2.2.2.1, q.2.2.2.2)))
          Filter.atTop (nhds (H_uncond [q] - H_condT [q]))) ∧
      Filter.Tendsto (fun k =>
        classicalRootSupremum (ε_seq k) (1 + m) γ (N_ω k) (N_T k) (π_seq k) (T_seq k)
          (V_seq k) (A_seq k)) Filter.atTop (nhds τ) ∧
      (∀ v ∈ Set.Ioo (0 : ℝ) 1,
        Filter.Tendsto (fun k =>
          finCondEntropy (ε_seq k) (π_seq k) (T_seq k)
            (fun ω => dyadicTimeBin (ε_seq k) v (c_seq k ω)))
          Filter.atTop (nhds (S v))) ∧
      (∀ v ∈ Set.Ioo (0 : ℝ) 1,
        Filter.Tendsto (fun k =>
          finCondEntropy (ε_seq k) (π_seq k)
            (fun ω => (T_seq k ω, dyadicTimeBin (ε_seq k) v (c_seq k ω)))
            (fun ω => dyadicRealBin (ε_seq k) (m * v) (R_seq k ω)))
          Filter.atTop (nhds 0)) ∧
      (∀ u ∈ Set.Ioo (0 : ℝ) 1, IsPosDyadicUnit u →
        Filter.Tendsto (fun k =>
          rowObsScore (ε_seq k) γ m u (b u) (π_seq k) (T_seq k) (V_seq k) (A_seq k)
            (c_seq k) (R_seq k) -
          classicalRootSupremum (ε_seq k) (1 + m) γ (N_ω k) (N_T k) (π_seq k) (T_seq k)
            (V_seq k) (A_seq k))
