    let F_VL : Fin n → ℝ × ℝ → ℝ :=
      fun j iu => fderiv ℝ (fderiv ℝ F) (p_fn iu) (coneBasisV n) (coneBasisL n j)
    let D_i : Fin n → ℝ × ℝ → ℝ := fun j iu => ∑ k : Fin n, F_LL k j iu
    let D_u : Fin n → ℝ × ℝ → ℝ := fun j iu =>
