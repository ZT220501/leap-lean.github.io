            ∑ i : Fin N_P, if |Z₁_hat i - z₀ 1| < r then ν_P i else 0 := by
        have hp := h_sum_partition_pred Finset.univ S_Z1 bZ₁ (fun _ => True)
          (fun k_Z => |z_of_k k_Z - z₀ 1| < r) ν_P (fun i _ => hZ1_mem i)
        simp only [true_and] at hp
