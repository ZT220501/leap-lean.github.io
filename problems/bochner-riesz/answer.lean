      have h1 : ρ₂ ^ (-p1_star + 2 * ζ₂) * c_lhs2 ≤
          (C_inv * (1936 * K_max / c_ret2) ^ 2) * ρ₂ ^ E_rhs2 := by
        have heq : c_lhs2 * ρ₂ ^ (-p1_star + 2 * ζ₂) = ρ₂ ^ (-p1_star + 2 * ζ₂) * c_lhs2 := by ring
        linarith only [h_inv_bad, heq]
      have h2 := (le_div_iff₀ hc_lhs2_pos).mpr h1
      convert h2 using 1; dsimp [C_inv_rat, c_lhs2]; ring
    have h_pow2_small : ρ₂ ^ ζ₂ < C_inv_rat⁻¹ := by
      have heq : ρ₂ ^ ζ₂ = ε ^ (ζ₂ * r * l) := by
        dsimp [ρ₂]; rw [← Real.rpow_mul hε_pos.le]; congr 1; ring
      rw [heq]
      refine h_exp_small C_inv_rat⁻¹ (ζ₂ * r * l) (inv_pos.mpr hC_inv_rat_pos) (by positivity) ?_
      rw [one_div, inv_inv]
      exact le_trans (le_max_right _ _) (le_trans (le_max_right _ _)
        (le_trans (le_max_right _ _) (le_trans (le_max_left _ _)
          (le_trans (le_max_right _ _) (le_max_right _ _)))))
    have h_lt2 := lt_of_le_of_lt h_div2
      (h_absorb_const ρ₂ C_inv_rat ζ₂ E_rhs2 hρ₂_pos hC_inv_rat_pos h_pow2_small)
    have h_exp2 := h_rpow_le_iff ρ₂ (-p1_star + 2 * ζ₂) (E_rhs2 - ζ₂) hρ₂_pos hρ₂_lt1 h_lt2.le
    have hη_rl2 : 4 * (η₀ / (r * l)) ≤ e₂ / 1000 := by
      have h1 : η₀ / (r * l) ≤ e₂ / 10000 := by
        rw [div_le_iff₀ (mul_pos hr_pos hl_pos)]
        have heq : (e₂ / 10000) * (r * l) = e₂ * r * l / 10000 := by ring
        linarith only [hη₀_le_e₂rl, heq]
      linarith only [h1, he₂_pos]
    dsimp [E_rhs2, ζ₂] at h_exp2
    have h_assoc2 : 2 * η₀ / (r * l) = 2 * (η₀ / (r * l)) := mul_div_assoc 2 η₀ (r * l)
    linarith only [h_exp2, h_assoc2, hp1_hi, ha₀_le_Δ, hκ₂_le, hη_rl2, he₂_le_Δ, hΔ_pos]

  have h_sum_entB : (2 * s - (5 / 8) * Δ_star) * l ≤
      ∑ m ∈ Finset.range R,
        finCondEntropy ε π_strip (fun ω => (B_obs ω, F_at (a + (m : ℝ) * r * l) ω))
          (F_at (a + ((m + 1 : ℕ) : ℝ) * r * l)) := by
    have h_nn_m : ∀ m ∈ Finset.range R,
        0 ≤ finCondEntropy ε π_strip (fun ω => (B_obs ω, F_at (a + (m : ℝ) * r * l) ω))
          (F_at (a + ((m + 1 : ℕ) : ℝ) * r * l)) := fun m _ =>
      h_ent_nn ε π_strip _ _ hε_pos hε_lt_half hπ_s_nn
    by_cases h2s : 0 ≤ 2 * s - Δ_star / 2
    · have h_good_sub : Good_R ⊆ Finset.range R :=
        @Finset.filter_subset _ _ (fun _ => Classical.propDecidable _) _
      have h_card_rl : (1 - Δ_star / 16) * l ≤ (Good_R.card : ℝ) * (r * l) := by
        have hRr : ((R : ℝ) - 2 / θ_R) * r = 1 - (2 / θ_R) * r := by
          rw [sub_mul, mul_inv_cancel₀ hR_pos.ne']
        have h1 : 1 - Δ_star / 16 ≤ ((R : ℝ) - 2 / θ_R) * r := by
          linarith only [hRr, h_badR_frac]
        have h2 := mul_le_mul_of_nonneg_right hGood_R_card (mul_pos hr_pos hl_pos).le
        have h3 : ((R : ℝ) - 2 / θ_R) * (r * l) = (((R : ℝ) - 2 / θ_R) * r) * l := by ring
        exact le_trans (mul_le_mul_of_nonneg_right h1 hl_pos.le) (h3 ▸ h2)
      have h_prod_lb : (2 * s - (5 / 8) * Δ_star) * l ≤
          (2 * s - Δ_star / 2) * ((Good_R.card : ℝ) * (r * l)) := by
        have h1 := mul_le_mul_of_nonneg_left h_card_rl h2s
        have h2 : (2 * s - Δ_star / 2) * (Δ_star / 16) ≤ 2 * (Δ_star / 16) :=
          mul_le_mul_of_nonneg_right (by linarith only [hs₁, hΔ_pos]) (by linarith only [hΔ_pos])
        have h_alg : (2 * s - Δ_star / 2) * ((1 - Δ_star / 16) * l) =
            ((2 * s - Δ_star / 2) - (2 * s - Δ_star / 2) * (Δ_star / 16)) * l := by ring
        have h_base : 2 * s - (5 / 8) * Δ_star ≤
            (2 * s - Δ_star / 2) - (2 * s - Δ_star / 2) * (Δ_star / 16) := by
          linarith only [h2]
        exact le_trans (mul_le_mul_of_nonneg_right h_base hl_pos.le) (h_alg ▸ h1)
      calc (2 * s - (5 / 8) * Δ_star) * l
          ≤ (Good_R.card : ℝ) * ((2 * s - Δ_star / 2) * (r * l)) := by
              have : (2 * s - Δ_star / 2) * ((Good_R.card : ℝ) * (r * l)) =
                  (Good_R.card : ℝ) * ((2 * s - Δ_star / 2) * (r * l)) := by ring
              linarith only [h_prod_lb, this]
        _ = ∑ _m ∈ Good_R, (2 * s - Δ_star / 2) * (r * l) := by
              simp [Finset.sum_const, nsmul_eq_mul]
        _ ≤ ∑ m ∈ Good_R,
              finCondEntropy ε π_strip (fun ω => (B_obs ω, F_at (a + (m : ℝ) * r * l) ω))
                (F_at (a + ((m + 1 : ℕ) : ℝ) * r * l)) := Finset.sum_le_sum h_goodR_step
        _ ≤ ∑ m ∈ Finset.range R,
              finCondEntropy ε π_strip (fun ω => (B_obs ω, F_at (a + (m : ℝ) * r * l) ω))
                (F_at (a + ((m + 1 : ℕ) : ℝ) * r * l)) :=
            Finset.sum_le_sum_of_subset_of_nonneg h_good_sub (fun m hm _ => h_nn_m m hm)
    · have hneg : (2 * s - (5 / 8) * Δ_star) * l ≤ 0 :=
        mul_nonpos_of_nonpos_of_nonneg (by linarith only [h2s, hΔ_pos]) hl_pos.le
      exact le_trans hneg (Finset.sum_nonneg h_nn_m)

  have hH_O1_given_B : (2 * s - (3 / 4) * Δ_star) * l ≤ finCondEntropy ε π_strip B_obs O₁ := by
    let fF : ℕ → ℝ := fun m => finCondEntropy ε π_strip B_obs (F_at (a + (m : ℝ) * r * l))
    have h_step : ∀ m ∈ Finset.range R,
        finCondEntropy ε π_strip (fun ω => (B_obs ω, F_at (a + (m : ℝ) * r * l) ω))
          (F_at (a + ((m + 1 : ℕ) : ℝ) * r * l)) ≤
        (fF (m + 1) - fF m) + Real.log C_amb / ell := by
      intro m hm
      have hmR : (m + 1 : ℕ) ≤ R := Finset.mem_range.mp hm
      have hu1 : a ≤ a + (m : ℝ) * r * l := by
        have : 0 ≤ (m : ℝ) * r * l :=
          mul_nonneg (mul_nonneg (Nat.cast_nonneg m) hr_pos.le) hl_pos.le
        linarith only [this]
      have hu12 : a + (m : ℝ) * r * l ≤ a + ((m + 1 : ℕ) : ℝ) * r * l := by
        have hle : (m : ℝ) * r * l ≤ ((m + 1 : ℕ) : ℝ) * r * l :=
          mul_le_mul_of_nonneg_right
            (mul_le_mul_of_nonneg_right (by exact_mod_cast Nat.le_succ m) hr_pos.le) hl_pos.le
        linarith only [hle]
      have hu2 : a + ((m + 1 : ℕ) : ℝ) * r * l ≤ 1 := by
        have hmr : ((m + 1 : ℕ) : ℝ) ≤ (R : ℝ) := by exact_mod_cast hmR
        have h1 : ((m + 1 : ℕ) : ℝ) * r ≤ 1 := by
          calc ((m + 1 : ℕ) : ℝ) * r ≤ (R : ℝ) * r := mul_le_mul_of_nonneg_right hmr hr_pos.le
            _ = 1 := mul_inv_cancel₀ hR_pos.ne'
        have h2 : ((m + 1 : ℕ) * r) * l ≤ l := by
          calc ((m + 1 : ℕ) * r) * l ≤ 1 * l := mul_le_mul_of_nonneg_right h1 hl_pos.le
            _ = l := one_mul l
        dsimp [a]; linarith only [h2]
      have hcomm := h_ent_comm ε π_strip B_obs (F_at (a + (m : ℝ) * r * l))
        (F_at (a + ((m + 1 : ℕ) : ℝ) * r * l)) hε_pos hε_lt_half hπ_s_nn hπ_s_sum
      have hc := h_Fc_ent (a + (m : ℝ) * r * l) (a + ((m + 1 : ℕ) : ℝ) * r * l) hu1 hu12 hu2
      dsimp [fF]; linarith only [hcomm, hc]
    have h_tel : ∑ m ∈ Finset.range R, ((fF (m + 1) - fF m) + Real.log C_amb / ell) =
        (fF R - fF 0) + (R : ℝ) * (Real.log C_amb / ell) := by
      rw [Finset.sum_add_distrib, Finset.sum_range_sub, Finset.sum_const, Finset.card_range,
        nsmul_eq_mul]
    have hf0_nn : 0 ≤ fF 0 :=
      h_ent_nn ε π_strip B_obs (F_at (a + (0 : ℕ) * r * l)) hε_pos hε_lt_half hπ_s_nn
    have hfR_eq : fF R = finCondEntropy ε π_strip B_obs (F_at 1) := by
      dsimp [fF]
      have : a + (R : ℝ) * r * l = 1 := by
        dsimp [a]; rw [mul_inv_cancel₀ hR_pos.ne', one_mul]; ring
      rw [this]
    have h_F1_given_BO1 : finCondEntropy ε π_strip (fun ω => (B_obs ω, O₁ ω)) (F_at 1) ≤
        Real.log C_amb / ell := by
      refine hs2_card ε C_amb π_strip (fun ω => (B_obs ω, O₁ ω)) (F_at 1)
        hε_pos hε_lt_half hC_amb_ge hπ_s_nn hπ_s_sum (fun ω₀ _ => ?_)
      obtain ⟨S_F1, hSF1_c, hSF1_m⟩ := (hS_F01_cov ω₀).2
      refine ⟨S_F1, hSF1_c, fun ω _ heq => ?_⟩
      obtain ⟨hb, ho⟩ := Prod.ext_iff.mp heq
      exact hSF1_m ω ho hb
    have h_comm_O1_F1 := h_ent_comm ε π_strip B_obs O₁ (F_at 1) hε_pos hε_lt_half hπ_s_nn hπ_s_sum
    have h_O1_given_BF1_nn : 0 ≤ finCondEntropy ε π_strip (fun ω => (B_obs ω, F_at 1 ω)) O₁ :=
      h_ent_nn ε π_strip (fun ω => (B_obs ω, F_at 1 ω)) O₁ hε_pos hε_lt_half hπ_s_nn
    have h_errD_ell : ((R : ℝ) + 1) * (Real.log C_amb / ell) ≤ (Δ_star / 8) * l := by
      have hL : ((R : ℝ) + 1) * Real.log C_amb / ((Δ_star / 8) * l) ≤ L_big :=
        le_trans (le_max_left _ _) (le_trans (le_max_right _ _)
          (le_trans (le_max_right _ _) (le_max_right _ _)))
      have h1 := (div_le_iff₀ (mul_pos (by linarith only [hΔ_pos]) hl_pos)).mp
        (le_trans hL hell_gt_L.le)
      rw [← mul_div_assoc, div_le_iff₀ hell_pos]
      linarith only [h1, mul_comm ell ((Δ_star / 8) * l)]
    have h_sum_le := Finset.sum_le_sum h_step
    rw [h_tel, hfR_eq] at h_sum_le
    have h_alg : (R : ℝ) * (Real.log C_amb / ell) + Real.log C_amb / ell =
        ((R : ℝ) + 1) * (Real.log C_amb / ell) := by ring
    have h_alg2 : (2 * s - (5 / 8) * Δ_star) * l - (Δ_star / 8) * l =
        (2 * s - (3 / 4) * Δ_star) * l := by ring
    linarith only [h_sum_entB, h_sum_le, hf0_nn, h_comm_O1_F1, h_O1_given_BF1_nn,
      h_F1_given_BO1, h_errD_ell, h_alg, h_alg2]

