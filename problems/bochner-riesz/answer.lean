    have hq_pos : 0 < q := by
      by_contra hq_le
      have hq0 : q = 0 := le_antisymm (le_of_not_gt hq_le) (by dsimp only [q]; positivity)
      have h1 : p * q - r ^ 2 ≤ 0 := by rw [hq0, mul_zero, zero_sub]; exact neg_nonpos.mpr (sq_nonneg r)
