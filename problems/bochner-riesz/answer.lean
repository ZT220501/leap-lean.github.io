    exact Real.log_pos (by linarith)
  have h_tlevel_zero : ∀ ε : ℝ, dyadicTimeLevel ε 0 = 0 := by
    intro ε
    unfold dyadicTimeLevel
    rw [neg_zero, Real.rpow_zero, Nat.ceil_one, Nat.clog_one_right]
  have h_tlevel_mono : ∀ {ε u₁ u₂ : ℝ}, 0 < ε → ε < 1 / 2 → u₁ ≤ u₂ →
