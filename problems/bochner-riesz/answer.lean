    have h_box0_sub : ∀ k ∈ box_0, k ∈ box_R := by
      intro k hk
      obtain ⟨hk_lo, hk_hi⟩ := Finset.mem_Icc.mp hk
      have h_ceil_le : ⌈B_iso⌉₊ ≤ ⌈B_iso / ε⌉₊ := by
