    exact lt_of_lt_of_le hπ_pos h_le
  have h_mi_expand : ∀ {β : Type} (Y : Fin N_ω → β),
      ell * finMutualInfo ε π T_idx Y =
        ∑ ω ∈ Ω_pos, π ω *
          (Real.log (finProbAt2 π T_idx Y ω) - Real.log (finProbAt π T_idx ω) -
            Real.log (finProbAt π Y ω)) := by
    intro β Y
    dsimp only [finMutualInfo, finCondEntropy]
    rw [h_sum_pos, h_sum_pos, ← Finset.sum_sub_distrib, Finset.mul_sum]
    refine Finset.sum_congr rfl (fun ω hω => ?_)
