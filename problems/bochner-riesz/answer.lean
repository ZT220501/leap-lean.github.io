            have h_lin : 2 * (C_cov * R_tr) + 3 ≤ 3 * (C_cov * R_tr) := by linarith only [h4]
            have h_nn : 0 ≤ 2 * (C_cov * R_tr) + 3 := by linarith only [h4]
