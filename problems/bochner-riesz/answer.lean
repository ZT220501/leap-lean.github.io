        rw [mul_one] at h1
        have h2 := (h1.const_add x₀).sub_const (c_end • v_seg τ)
        simpa [p_seg, x_line] using h2
      have hζ_diff : DifferentiableAt ℝ (fun p' => ζ₀ (v_seg τ, p')) (p_seg (y, τ)) := by
        have hcd : ContDiff ℝ (1 : ℕ) (fun p' => ζ₀ (v_seg τ, p')) :=
          (hζ_cd 1).comp (contDiff_const.prodMk contDiff_id)
        exact (hcd.differentiable (by simp)).differentiableAt
