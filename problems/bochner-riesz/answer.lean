                   (Int.floor (c_q q 1 / σ_loc + 2 * B_sys ^ 2))
      let Fib_Z2 := fun q => I_Z0 q ×ˢ I_Z1 q
      let Box_Z2 := F_Q_d.biUnion (fun q => (Fib_Z2 q).image (fun k => (q, k)))
      have hsub_Z2 : S_ad.image Z_of ⊆ Box_Z2 := by
        intro z hz
        rcases Finset.mem_image.mp hz with ⟨o, ho, rfl⟩
        have hq_mem : Q_of o ∈ F_Q_d := hQ_mem o ho
        rcases Finset.mem_filter.mp ho with ⟨_, _, he_bd, hperp_bd, _, _⟩
        have hexp_b : b_D d + t = (H_P + t) / 2 := by linarith only [hbD_eq]
        have hexp_a : a_D d + t = (H_P + t) / 2 := by linarith only [haD_eq]
        rw [hexp_b] at he_bd
        rw [hexp_a] at hperp_bd
        have hXO_norm : ‖X_O o - X_D d‖ ≤ 2 * (B_sys * ε ^ ((H_P + t) / 2)) :=
          h_norm_le_of_perp2D (X_O o - X_D d) (e_D d) (B_sys * ε ^ ((H_P + t) / 2)) heD
            (mul_nonneg hBsys_pos.le (Real.rpow_nonneg hε_pos.le _)) he_bd hperp_bd
        set q := Q_of o
        set X_Q := gridPt2D s_loc q.2.2
        have hvec_eq : (X'_fn o - X_Q) - c_q q = s_x⁻¹ • (X_O o - X_D d) := by
          have h1 : (X'_fn o - X_Q) - c_q q = X'_fn o - X'_d := by
            dsimp only [c_q, X_Q]
            abel
          rw [h1, hX'_diff o ho]
        have hscaled_norm : σ_loc⁻¹ * ‖(X'_fn o - X_Q) - c_q q‖ ≤ 2 * B_sys ^ 2 := by
          rw [hvec_eq, norm_smul, Real.norm_of_nonneg (inv_nonneg.mpr hs_x_pos.le)]
          calc σ_loc⁻¹ * (s_x⁻¹ * ‖X_O o - X_D d‖)
              = (s_x⁻¹ * σ_loc⁻¹) * ‖X_O o - X_D d‖ := by ring
            _ ≤ (B_sys * ε ^ (-(H_P + t) / 2)) * (2 * (B_sys * ε ^ ((H_P + t) / 2))) :=
                mul_le_mul hsx_σloc_inv hXO_norm (norm_nonneg _)
                  (mul_nonneg hBsys_pos.le (Real.rpow_nonneg hε_pos.le _))
            _ = 2 * B_sys ^ 2 * (ε ^ (-(H_P + t) / 2) * ε ^ ((H_P + t) / 2)) := by ring
            _ = 2 * B_sys ^ 2 := by
                rw [← Real.rpow_add hε_pos]
                have hz0 : -(H_P + t) / 2 + (H_P + t) / 2 = 0 := by ring
                rw [hz0, Real.rpow_zero, mul_one]
        have hcoord_div : ∀ i : Fin 2,
            |((X'_fn o - X_Q) i - (0 : EuclideanSpace ℝ (Fin 2)) i) / σ_loc - c_q q i / σ_loc| ≤
              2 * B_sys ^ 2 := by
          intro i
          have hz_i : (0 : EuclideanSpace ℝ (Fin 2)) i = 0 := rfl
          have hsub_i : ((X'_fn o - X_Q) - c_q q) i = (X'_fn o - X_Q) i - c_q q i := rfl
