    have h_ell_pos : ∀ ε : ℝ, 0 < ε → ε < 1 / 2 → 0 < Real.log (ε⁻¹) := by
      intro ε hε0 hε1
      rw [Real.log_inv]
      linarith [Real.log_neg hε0 (lt_trans hε1 (by norm_num))]
    let rootSet := fun (ε L : ℝ) {N_ω N_T : ℕ} (π : Fin N_ω → ℝ) (T_idx : Fin N_ω → Fin N_T)
        (V_part A_part : Fin N_T → EuclideanSpace ℝ (Fin 2)) =>
      let p_T : Fin N_T → ℝ := fun tid => ∑ ω : Fin N_ω, if T_idx ω = tid then π ω else 0
      let ell := Real.log (ε⁻¹)
      { s : ℝ | ∃ (N_D : ℕ)
          (b_D a_D : Fin N_D → ℝ)
          (e_D V_D A_D : Fin N_D → EuclideanSpace ℝ (Fin 2))
          (q : Fin N_T → Fin N_D → ℝ),
          (∀ d : Fin N_D, 0 ≤ b_D d ∧ b_D d ≤ a_D d ∧ a_D d ≤ L ∧ ‖e_D d‖ = 1) ∧
          (∀ tid d, 0 ≤ q tid d) ∧
          (∀ tid : Fin N_T, ∑ d : Fin N_D, q tid d = p_T tid) ∧
          (∀ tid : Fin N_T, ∀ d : Fin N_D, 0 < q tid d →
            |inner ℝ (V_part tid - V_D d) (e_D d)| ≤ 10 * ε ^ (b_D d) ∧
            |inner ℝ (V_part tid - V_D d) (perp2D (e_D d))| ≤ 10 * ε ^ (a_D d) ∧
            |inner ℝ (A_part tid - A_D d) (e_D d)| ≤ 10 * ε ^ (b_D d) ∧
            |inner ℝ (A_part tid - A_D d) (perp2D (e_D d))| ≤ 10 * ε ^ (a_D d)) ∧
          (let q_D := fun d => ∑ tid : Fin N_T, q tid d
           let I_TD := (∑ tid : Fin N_T, ∑ d : Fin N_D,
             q tid d * Real.log (q tid d / (p_T tid * q_D d))) / ell
           let E_w := ∑ d : Fin N_D, q_D d * ((1 + γ) * b_D d + (1 - γ) * a_D d)
           s = E_w - I_TD) }
    have h_root_ne_bdd : ∀ (ε L : ℝ) {N_ω N_T : ℕ}
        (π : Fin N_ω → ℝ) (T_idx : Fin N_ω → Fin N_T)
        (V_part A_part : Fin N_T → EuclideanSpace ℝ (Fin 2)),
        0 < ε → ε < 1 / 2 → 0 ≤ L →
        (∀ ω, 0 ≤ π ω) → (∑ ω : Fin N_ω, π ω = 1) →
        (∀ tid, ‖V_part tid‖ ≤ 1 ∧ ‖A_part tid‖ ≤ 1) →
        (rootSet ε L π T_idx V_part A_part).Nonempty ∧
        BddAbove (rootSet ε L π T_idx V_part A_part) := by
      intro ε L N_ω N_T π T_idx V_part A_part hε0 hε1 hL hπ_nn hπ_sum hVA
      have hell := h_ell_pos ε hε0 hε1
      let p_T : Fin N_T → ℝ := fun tid => ∑ ω : Fin N_ω, if T_idx ω = tid then π ω else 0
      have hpT_nn : ∀ tid, 0 ≤ p_T tid := fun tid =>
        Finset.sum_nonneg (fun ω _ => by split_ifs <;> [exact hπ_nn ω; exact le_rfl])
      have hpT_sum : ∑ tid : Fin N_T, p_T tid = 1 := by
        dsimp [p_T]
        rw [Finset.sum_comm]
        have h_eq : (∑ ω : Fin N_ω, ∑ tid : Fin N_T, if T_idx ω = tid then π ω else 0) =
            ∑ ω : Fin N_ω, π ω := by
          refine Finset.sum_congr rfl (fun ω _ => ?_)
          rw [Finset.sum_ite_eq Finset.univ (T_idx ω) (fun _ => π ω)]
          simp
        rw [h_eq, hπ_sum]
      refine ⟨?_, ⟨2 * L, ?_⟩⟩
      · let e₀ : EuclideanSpace ℝ (Fin 2) := WithLp.toLp 2 ![1, 0]
        have he₀_norm : ‖e₀‖ = 1 := by
          rw [PiLp.norm_eq_of_L2, Fin.sum_univ_two]
          simp [e₀]
        have he₀_perp_norm : ‖perp2D e₀‖ = 1 := by
          rw [PiLp.norm_eq_of_L2, Fin.sum_univ_two]
          simp [perp2D, e₀]
        refine ⟨_, ⟨1, fun _ => 0, fun _ => 0, fun _ => e₀, fun _ => 0, fun _ => 0,
          fun tid _ => p_T tid,
          fun _ => ⟨le_rfl, le_rfl, hL, he₀_norm⟩,
          fun tid _ => hpT_nn tid,
          fun tid => Fin.sum_univ_one _,
          fun tid _ _ => ?_, rfl⟩⟩
        rw [sub_zero, sub_zero, Real.rpow_zero]
        refine ⟨?_, ?_, ?_, ?_⟩
        · exact le_trans (abs_real_inner_le_norm _ _) (by rw [he₀_norm]; linarith [(hVA tid).1])
        · exact le_trans (abs_real_inner_le_norm _ _) (by rw [he₀_perp_norm]; linarith [(hVA tid).1])
        · exact le_trans (abs_real_inner_le_norm _ _) (by rw [he₀_norm]; linarith [(hVA tid).2])
        · exact le_trans (abs_real_inner_le_norm _ _) (by rw [he₀_perp_norm]; linarith [(hVA tid).2])
      · rintro s ⟨N_D, b_D, a_D, e_D, V_D, A_D, q, h_adm, hq_nn, hq_pT, _, hs_eq⟩
        set q_D : Fin N_D → ℝ := fun d => ∑ tid : Fin N_T, q tid d
        have hqD_nn : ∀ d, 0 ≤ q_D d := fun d => Finset.sum_nonneg (fun tid _ => hq_nn tid d)
        have hqD_sum : ∑ d : Fin N_D, q_D d = 1 := by
          dsimp [q_D]
          rw [Finset.sum_comm]
          simp_rw [hq_pT]
          exact hpT_sum
        have h_kl_pt : ∀ (tid : Fin N_T) (d : Fin N_D),
            q tid d - p_T tid * q_D d ≤ q tid d * Real.log (q tid d / (p_T tid * q_D d)) := by
          intro tid d
          by_cases hq_pos : 0 < q tid d
          · have hpT_pos : 0 < p_T tid := by
              have h_le : q tid d ≤ ∑ d' : Fin N_D, q tid d' :=
                Finset.single_le_sum (fun d' _ => hq_nn tid d') (Finset.mem_univ d)
              rw [hq_pT tid] at h_le
              exact lt_of_lt_of_le hq_pos h_le
            have hqD_pos : 0 < q_D d := by
              have h_le : q tid d ≤ ∑ tid' : Fin N_T, q tid' d :=
                Finset.single_le_sum (fun tid' _ => hq_nn tid' d) (Finset.mem_univ tid)
              exact lt_of_lt_of_le hq_pos h_le
            set r := (p_T tid * q_D d) / q tid d
            have hr_pos : 0 < r := div_pos (mul_pos hpT_pos hqD_pos) hq_pos
            have h_inv : q tid d / (p_T tid * q_D d) = r⁻¹ := by dsimp [r]; rw [inv_div]
            rw [h_inv, Real.log_inv]
            have h_log := Real.log_le_sub_one_of_pos hr_pos
            have h_mul := mul_le_mul_of_nonneg_left (by linarith : 1 - r ≤ -Real.log r) hq_pos.le
            have h_lhs : q tid d * (1 - r) = q tid d - p_T tid * q_D d := by
              dsimp [r]; field_simp [ne_of_gt hq_pos]
            rwa [h_lhs] at h_mul
          · have hq0 : q tid d = 0 := le_antisymm (le_of_not_gt hq_pos) (hq_nn tid d)
            rw [hq0, zero_sub, zero_mul, neg_nonpos]
            exact mul_nonneg (hpT_nn tid) (hqD_nn d)
        have h_ITD_nn : 0 ≤ (∑ tid : Fin N_T, ∑ d : Fin N_D,
            q tid d * Real.log (q tid d / (p_T tid * q_D d))) / Real.log (ε⁻¹) := by
          refine div_nonneg ?_ hell.le
          have h_sum_lb : ∑ tid : Fin N_T, ∑ d : Fin N_D, (q tid d - p_T tid * q_D d) = 0 := by
            refine Finset.sum_eq_zero (fun tid _ => ?_)
            rw [Finset.sum_sub_distrib, ← Finset.mul_sum, hq_pT tid, hqD_sum, mul_one, sub_self]
          rw [← h_sum_lb]
          exact Finset.sum_le_sum (fun tid _ => Finset.sum_le_sum (fun d _ => h_kl_pt tid d))
        have h_Ew_le : ∑ d : Fin N_D, q_D d * ((1 + γ) * b_D d + (1 - γ) * a_D d) ≤ 2 * L := by
          have h_each : ∀ d ∈ (Finset.univ : Finset (Fin N_D)),
              q_D d * ((1 + γ) * b_D d + (1 - γ) * a_D d) ≤ q_D d * (2 * L) := by
            intro d _
            obtain ⟨hb0, hba, haL, _⟩ := h_adm d
            refine mul_le_mul_of_nonneg_left ?_ (hqD_nn d)
            nlinarith
          calc ∑ d : Fin N_D, q_D d * ((1 + γ) * b_D d + (1 - γ) * a_D d)
              ≤ ∑ d : Fin N_D, q_D d * (2 * L) := Finset.sum_le_sum h_each
            _ = (∑ d : Fin N_D, q_D d) * (2 * L) := (Finset.sum_mul _ _ _).symm
            _ = 2 * L := by rw [hqD_sum, one_mul]
        rw [hs_eq]
        linarith
    refine ⟨?_, ?_⟩
    · intro ε L N_ω N_T π T_idx V_part A_part E hε0 hε1 hL hπ_nn hπ_sum hVA hmE0 hmE1
      have hell := h_ell_pos ε hε0 hε1
      set m_E := ∑ ω ∈ E, π ω
      set Ec := Finset.univ \ E
      have hmEc_eq : ∑ ω ∈ Ec, π ω = 1 - m_E := by
        have h_sd := Finset.sum_sdiff (Finset.subset_univ E) (f := π)
        linarith
      have hmEc_pos : 0 < 1 - m_E := by linarith
      set π_E := restrictLaw π E
      set π_Ec := restrictLaw π Ec
      set Z : Fin N_ω → Bool := fun ω => decide (ω ∈ E)
      have hπE_law : (∀ ω, 0 ≤ π_E ω) ∧ (∑ ω : Fin N_ω, π_E ω = 1) := by
        refine ⟨fun ω => ?_, ?_⟩
        · dsimp [π_E, restrictLaw]; split_ifs <;> [exact div_nonneg (hπ_nn ω) hmE0.le; exact le_rfl]
        · dsimp [π_E, restrictLaw]
          rw [Finset.sum_ite_mem, Finset.univ_inter, ← Finset.sum_div, div_self (ne_of_gt hmE0)]
      have hπEc_law : (∀ ω, 0 ≤ π_Ec ω) ∧ (∑ ω : Fin N_ω, π_Ec ω = 1) := by
        refine ⟨fun ω => ?_, ?_⟩
        · dsimp [π_Ec, restrictLaw]; split_ifs <;> [exact div_nonneg (hπ_nn ω) (by rw [hmEc_eq]; exact hmEc_pos.le); exact le_rfl]
        · dsimp [π_Ec, restrictLaw]
          have hmEc_ne : (∑ ω ∈ Ec, π ω) ≠ 0 := by rw [hmEc_eq]; exact ne_of_gt hmEc_pos
          rw [Finset.sum_ite_mem, Finset.univ_inter, ← Finset.sum_div, div_self hmEc_ne]
      obtain ⟨hS_ne, hS_bdd⟩ := h_root_ne_bdd ε L π T_idx V_part A_part hε0 hε1 hL hπ_nn hπ_sum hVA
      obtain ⟨hSE_ne, _⟩ := h_root_ne_bdd ε L π_E T_idx V_part A_part hε0 hε1 hL hπE_law.1 hπE_law.2 hVA
      obtain ⟨hSEc_ne, _⟩ := h_root_ne_bdd ε L π_Ec T_idx V_part A_part hε0 hε1 hL hπEc_law.1 hπEc_law.2 hVA
      let p_T : Fin N_T → ℝ := fun tid => ∑ ω : Fin N_ω, if T_idx ω = tid then π ω else 0
      let p_TE : Fin N_T → ℝ := fun tid => ∑ ω : Fin N_ω, if T_idx ω = tid then π_E ω else 0
      let p_TEc : Fin N_T → ℝ := fun tid => ∑ ω : Fin N_ω, if T_idx ω = tid then π_Ec ω else 0
      let p_T1 : Fin N_T → ℝ := fun tid => ∑ ω ∈ E, if T_idx ω = tid then π ω else 0
      let p_T0 : Fin N_T → ℝ := fun tid => ∑ ω ∈ Ec, if T_idx ω = tid then π ω else 0
      have hp_T1_eq : ∀ tid, m_E * p_TE tid = p_T1 tid := by
        intro tid
        dsimp [p_TE, p_T1, π_E, restrictLaw]
        have h1 : (∑ ω : Fin N_ω, if T_idx ω = tid then (if ω ∈ E then π ω / m_E else 0) else 0) =
            (∑ ω ∈ E, if T_idx ω = tid then π ω else 0) / m_E := by
          calc _ = ∑ ω : Fin N_ω, if ω ∈ E then (if T_idx ω = tid then π ω / m_E else 0) else 0 :=
                Finset.sum_congr rfl (fun ω _ => by split_ifs <;> rfl)
            _ = ∑ ω ∈ E, (if T_idx ω = tid then π ω else 0) / m_E := by
                rw [Finset.sum_ite_mem, Finset.univ_inter]
                exact Finset.sum_congr rfl (fun ω _ => by split_ifs <;> simp)
            _ = _ := (Finset.sum_div _ _ _).symm
        rw [h1, mul_div_cancel₀ _ (ne_of_gt hmE0)]
      have hp_T0_eq : ∀ tid, (1 - m_E) * p_TEc tid = p_T0 tid := by
        intro tid
        dsimp [p_TEc, p_T0, π_Ec, restrictLaw]
        have h1 : (∑ ω : Fin N_ω, if T_idx ω = tid then (if ω ∈ Ec then π ω / ∑ x ∈ Ec, π x else 0) else 0) =
            (∑ ω ∈ Ec, if T_idx ω = tid then π ω else 0) / (∑ x ∈ Ec, π x) := by
          calc _ = ∑ ω : Fin N_ω, if ω ∈ Ec then (if T_idx ω = tid then π ω / ∑ x ∈ Ec, π x else 0) else 0 :=
                Finset.sum_congr rfl (fun ω _ => by split_ifs <;> rfl)
            _ = ∑ ω ∈ Ec, (if T_idx ω = tid then π ω else 0) / (∑ x ∈ Ec, π x) := by
                rw [Finset.sum_ite_mem, Finset.univ_inter]
                exact Finset.sum_congr rfl (fun ω _ => by split_ifs <;> simp)
            _ = _ := (Finset.sum_div _ _ _).symm
        rw [h1, hmEc_eq, mul_div_cancel₀ _ (ne_of_gt hmEc_pos)]
      have hp_T_split : ∀ tid, p_T1 tid + p_T0 tid = p_T tid := by
        intro tid
        dsimp [p_T1, p_T0, p_T]
        rw [add_comm, Finset.sum_sdiff (Finset.subset_univ E)]
      have h_mut_Z : finMutualInfo ε π T_idx Z =
          (∑ tid : Fin N_T, (p_T1 tid * Real.log (p_T1 tid / (p_T tid * m_E)) +
            p_T0 tid * Real.log (p_T0 tid / (p_T tid * (1 - m_E))))) / Real.log (ε⁻¹) := by
        unfold finMutualInfo finCondEntropy
        rw [← Finset.sum_sub_distrib, ← Finset.sum_sdiff (Finset.subset_univ E)]
        have h_on_S : ∀ (S : Finset (Fin N_ω)) (z : Bool) (mS : ℝ) (p_Tz : Fin N_T → ℝ),
            (∀ ω', ω' ∈ S ↔ Z ω' = z) →
            (∑ ω' ∈ S, π ω') = mS → 0 < mS →
            (∀ tid, p_Tz tid = ∑ ω' ∈ S, if T_idx ω' = tid then π ω' else 0) →
            (∀ tid, p_Tz tid ≤ p_T tid) →
            (∑ ω ∈ S, (π ω * condSurprise ε π (fun _ => ()) Z ω -
              π ω * condSurprise ε π T_idx Z ω)) =
            (∑ tid : Fin N_T, p_Tz tid * Real.log (p_Tz tid / (p_T tid * mS))) / Real.log (ε⁻¹) := by
          intro S z mS p_Tz hS_iff hmS_eq hmS_pos hpTz_def hpTz_le
          have h_pt : ∀ ω ∈ S,
              π ω * condSurprise ε π (fun _ => ()) Z ω - π ω * condSurprise ε π T_idx Z ω =
              π ω * (Real.log (p_Tz (T_idx ω) / (p_T (T_idx ω) * mS)) / Real.log (ε⁻¹)) := by
            intro ω hω
            by_cases hω_pos : 0 < π ω
            · have hz : Z ω = z := (hS_iff ω).mp hω
              have hp_u1 : finProbAt π (fun _ => ()) ω = 1 := by
                unfold finProbAt; simp [hπ_sum]
              have hp_u2 : finProbAt2 π (fun _ => ()) Z ω = mS := by
                unfold finProbAt2
                rw [← hmS_eq, ← Finset.sum_sdiff (Finset.subset_univ S)]
                have h_out : ∑ ω' ∈ Finset.univ \ S,
                    @ite ℝ ((fun _ : Fin N_ω => ()) ω' = () ∧ Z ω' = Z ω) (Classical.propDecidable _) (π ω') 0 = 0 := by
                  refine Finset.sum_eq_zero (fun ω' hω' => ?_)
                  have hnot : ω' ∉ S := (Finset.mem_sdiff.mp hω').2
                  have hne : Z ω' ≠ z := fun h => hnot ((hS_iff ω').mpr h)
                  simp [hz, hne]
                dsimp only
                rw [h_out, zero_add]
                refine Finset.sum_congr rfl (fun ω' hω' => ?_)
                have hz' : Z ω' = z := (hS_iff ω').mp hω'
                simp [hz, hz']
              have hp_t1 : finProbAt π T_idx ω = p_T (T_idx ω) := by
                unfold finProbAt; dsimp [p_T]
                exact Finset.sum_congr rfl (fun ω' _ => by by_cases h : T_idx ω' = T_idx ω <;> simp [h])
              have hp_t2 : finProbAt2 π T_idx Z ω = p_Tz (T_idx ω) := by
                unfold finProbAt2
                rw [hpTz_def (T_idx ω), ← Finset.sum_sdiff (Finset.subset_univ S)]
                have h_out : ∑ ω' ∈ Finset.univ \ S,
                    @ite ℝ (T_idx ω' = T_idx ω ∧ Z ω' = Z ω) (Classical.propDecidable _) (π ω') 0 = 0 := by
                  refine Finset.sum_eq_zero (fun ω' hω' => ?_)
                  have hnot : ω' ∉ S := (Finset.mem_sdiff.mp hω').2
                  have hne : Z ω' ≠ z := fun h => hnot ((hS_iff ω').mpr h)
                  simp [hz, hne]
                rw [h_out, zero_add]
                refine Finset.sum_congr rfl (fun ω' hω' => ?_)
                have hz' : Z ω' = z := (hS_iff ω').mp hω'
                by_cases hT : T_idx ω' = T_idx ω <;> simp [hz, hz', hT]
              have hpTz_pos : 0 < p_Tz (T_idx ω) := by
                rw [hpTz_def (T_idx ω)]
                have h_le := Finset.single_le_sum (f := fun ω' => if T_idx ω' = T_idx ω then π ω' else 0)
                  (fun ω' _ => by split_ifs <;> [exact hπ_nn ω'; exact le_rfl]) hω
                simp only [↓reduceIte] at h_le
                exact lt_of_lt_of_le hω_pos h_le
              have hpT_pos : 0 < p_T (T_idx ω) := lt_of_lt_of_le hpTz_pos (hpTz_le (T_idx ω))
              unfold condSurprise
              rw [hp_u1, hp_u2, hp_t1, hp_t2, div_one]
              have h_div : (p_Tz (T_idx ω) / p_T (T_idx ω)) / mS =
                  p_Tz (T_idx ω) / (p_T (T_idx ω) * mS) := div_div _ _ _
              rw [← h_div, Real.log_div (ne_of_gt (div_pos hpTz_pos hpT_pos)) (ne_of_gt hmS_pos)]
              ring
            · have h0 : π ω = 0 := le_antisymm (le_of_not_gt hω_pos) (hπ_nn ω)
              simp [h0]
          rw [Finset.sum_congr rfl h_pt]
          have h_fib : (∑ tid : Fin N_T, p_Tz tid * Real.log (p_Tz tid / (p_T tid * mS))) / Real.log (ε⁻¹) =
              ∑ tid : Fin N_T, (p_Tz tid * (Real.log (p_Tz tid / (p_T tid * mS)) / Real.log (ε⁻¹))) := by
            rw [Finset.sum_div]
            exact Finset.sum_congr rfl (fun _ _ => mul_div_assoc _ _ _)
          rw [h_fib]
          have h_lhs_fib : ∀ ω ∈ S,
              π ω * (Real.log (p_Tz (T_idx ω) / (p_T (T_idx ω) * mS)) / Real.log (ε⁻¹)) =
              ∑ tid : Fin N_T, if T_idx ω = tid then
                π ω * (Real.log (p_Tz tid / (p_T tid * mS)) / Real.log (ε⁻¹)) else 0 := by
            intro ω _
            rw [Finset.sum_ite_eq Finset.univ (T_idx ω)]
            simp
          rw [Finset.sum_congr rfl h_lhs_fib, Finset.sum_comm]
          refine Finset.sum_congr rfl (fun tid _ => ?_)
          set c_tid := Real.log (p_Tz tid / (p_T tid * mS)) / Real.log (ε⁻¹)
          change (∑ ω ∈ S, if T_idx ω = tid then π ω * c_tid else 0) = p_Tz tid * c_tid
          rw [hpTz_def tid, Finset.sum_mul]
          exact Finset.sum_congr rfl (fun ω _ => by by_cases h : T_idx ω = tid <;> simp [h])
        have h1 := h_on_S E true m_E p_T1 (fun ω' => by simp [Z]) rfl hmE0 (fun _ => rfl)
          (fun tid => by
            have h0_nn : 0 ≤ p_T0 tid := Finset.sum_nonneg (fun ω _ => by split_ifs <;> [exact hπ_nn ω; exact le_rfl])
            linarith [hp_T_split tid])
        have h0 := h_on_S Ec false (1 - m_E) p_T0 (fun ω' => by simp [Ec, Z]) hmEc_eq hmEc_pos (fun _ => rfl)
          (fun tid => by
            have h1_nn : 0 ≤ p_T1 tid := Finset.sum_nonneg (fun ω _ => by split_ifs <;> [exact hπ_nn ω; exact le_rfl])
            linarith [hp_T_split tid])
        rw [h0, h1, ← add_div, ← Finset.sum_add_distrib]
        refine congr_arg (· / Real.log (ε⁻¹)) (Finset.sum_congr rfl (fun tid _ => add_comm _ _))
      have h_pair : ∀ s₁ ∈ rootSet ε L π_E T_idx V_part A_part,
          ∀ s₀ ∈ rootSet ε L π_Ec T_idx V_part A_part,
            m_E * s₁ + (1 - m_E) * s₀ ≤
              classicalRootSupremum ε L γ N_ω N_T π T_idx V_part A_part +
                finMutualInfo ε π T_idx Z := by
        rintro s₁ ⟨N₁, b₁, a₁, e₁, V₁, A₁, q₁, hadm₁, hqnn₁, hqp₁, hcap₁, hs₁_eq⟩
               s₀ ⟨N₀, b₀, a₀, e₀, V₀, A₀, q₀, hadm₀, hqnn₀, hqp₀, hcap₀, hs₀_eq⟩
        let σ : Fin (N₁ + N₀) ≃ Fin N₁ ⊕ Fin N₀ := finSumFinEquiv.symm
        let b_D : Fin (N₁ + N₀) → ℝ := fun d => Sum.elim b₁ b₀ (σ d)
        let a_D : Fin (N₁ + N₀) → ℝ := fun d => Sum.elim a₁ a₀ (σ d)
        let e_D : Fin (N₁ + N₀) → EuclideanSpace ℝ (Fin 2) := fun d => Sum.elim e₁ e₀ (σ d)
        let V_D : Fin (N₁ + N₀) → EuclideanSpace ℝ (Fin 2) := fun d => Sum.elim V₁ V₀ (σ d)
        let A_D : Fin (N₁ + N₀) → EuclideanSpace ℝ (Fin 2) := fun d => Sum.elim A₁ A₀ (σ d)
        let q : Fin N_T → Fin (N₁ + N₀) → ℝ := fun tid d =>
          Sum.elim (fun d₁ => m_E * q₁ tid d₁) (fun d₀ => (1 - m_E) * q₀ tid d₀) (σ d)
        have h_adm : ∀ d : Fin (N₁ + N₀), 0 ≤ b_D d ∧ b_D d ≤ a_D d ∧ a_D d ≤ L ∧ ‖e_D d‖ = 1 := by
          intro d
          dsimp [b_D, a_D, e_D]
          cases σ d with
          | inl d₁ => exact hadm₁ d₁
          | inr d₀ => exact hadm₀ d₀
        have hq_nn : ∀ tid d, 0 ≤ q tid d := by
          intro tid d
          dsimp [q]
          cases σ d with
          | inl d₁ => exact mul_nonneg hmE0.le (hqnn₁ tid d₁)
          | inr d₀ => exact mul_nonneg hmEc_pos.le (hqnn₀ tid d₀)
        have hq_sum : ∀ tid : Fin N_T, ∑ d : Fin (N₁ + N₀), q tid d = p_T tid := by
          intro tid
          dsimp [q]
          rw [Equiv.sum_comp σ, Fintype.sum_sum_type]
          simp only [Sum.elim_inl, Sum.elim_inr, ← Finset.mul_sum]
          change m_E * (∑ d₁, q₁ tid d₁) + (1 - m_E) * (∑ d₀, q₀ tid d₀) = p_T tid
          rw [hqp₁ tid, hqp₀ tid, hp_T1_eq tid, hp_T0_eq tid, hp_T_split tid]
        have h_cap : ∀ tid : Fin N_T, ∀ d : Fin (N₁ + N₀), 0 < q tid d →
            |inner ℝ (V_part tid - V_D d) (e_D d)| ≤ 10 * ε ^ (b_D d) ∧
            |inner ℝ (V_part tid - V_D d) (perp2D (e_D d))| ≤ 10 * ε ^ (a_D d) ∧
            |inner ℝ (A_part tid - A_D d) (e_D d)| ≤ 10 * ε ^ (b_D d) ∧
            |inner ℝ (A_part tid - A_D d) (perp2D (e_D d))| ≤ 10 * ε ^ (a_D d) := by
          intro tid d hq_pos
          dsimp [q, b_D, a_D, e_D, V_D, A_D] at hq_pos ⊢
          cases hσ : σ d with
          | inl d₁ =>
            rw [hσ] at hq_pos; dsimp at hq_pos ⊢
            exact hcap₁ tid d₁ (pos_of_mul_pos_right hq_pos hmE0.le)
          | inr d₀ =>
            rw [hσ] at hq_pos; dsimp at hq_pos ⊢
            exact hcap₀ tid d₀ (pos_of_mul_pos_right hq_pos hmEc_pos.le)
        let q_D : Fin (N₁ + N₀) → ℝ := fun d => ∑ tid : Fin N_T, q tid d
        let q₁_D : Fin N₁ → ℝ := fun d₁ => ∑ tid : Fin N_T, q₁ tid d₁
        let q₀_D : Fin N₀ → ℝ := fun d₀ => ∑ tid : Fin N_T, q₀ tid d₀
        have hqD_inl : ∀ d₁ : Fin N₁, q_D (σ.symm (Sum.inl d₁)) = m_E * q₁_D d₁ := by
          intro d₁; dsimp [q_D, q, q₁_D]; simp [← Finset.mul_sum]
        have hqD_inr : ∀ d₀ : Fin N₀, q_D (σ.symm (Sum.inr d₀)) = (1 - m_E) * q₀_D d₀ := by
          intro d₀; dsimp [q_D, q, q₀_D]; simp [← Finset.mul_sum]
        have h_Ew_eq : (∑ d : Fin (N₁ + N₀), q_D d * ((1 + γ) * b_D d + (1 - γ) * a_D d)) =
            m_E * (∑ d₁ : Fin N₁, q₁_D d₁ * ((1 + γ) * b₁ d₁ + (1 - γ) * a₁ d₁)) +
            (1 - m_E) * (∑ d₀ : Fin N₀, q₀_D d₀ * ((1 + γ) * b₀ d₀ + (1 - γ) * a₀ d₀)) := by
          rw [← Equiv.sum_comp σ.symm, Fintype.sum_sum_type]
          simp only [hqD_inl, hqD_inr, b_D, a_D, Equiv.apply_symm_apply, Sum.elim_inl, Sum.elim_inr,
            mul_assoc, ← Finset.mul_sum]
        have h_ITD_branch : ∀ {N_k : ℕ} (mS : ℝ) (p_TS p_Tz : Fin N_T → ℝ)
            (qk : Fin N_T → Fin N_k → ℝ) (qk_D : Fin N_k → ℝ),
            0 < mS →
            (∀ tid d_k, 0 ≤ qk tid d_k) →
            (∀ tid, ∑ d_k, qk tid d_k = p_TS tid) →
            (∀ d_k, qk_D d_k = ∑ tid, qk tid d_k) →
            (∀ tid, mS * p_TS tid = p_Tz tid) →
            (∀ tid, p_Tz tid ≤ p_T tid) →
            ∀ tid : Fin N_T,
              (∑ d_k : Fin N_k, (mS * qk tid d_k) *
                Real.log ((mS * qk tid d_k) / (p_T tid * (mS * qk_D d_k)))) =
              mS * (∑ d_k : Fin N_k, qk tid d_k * Real.log (qk tid d_k / (p_TS tid * qk_D d_k))) +
                p_Tz tid * Real.log (p_Tz tid / (p_T tid * mS)) := by
          intro N_k mS p_TS p_Tz qk qk_D hmS_pos hqk_nn hqk_pTS hqk_D_def hpTz_mS hpTz_le tid
          have h_term : ∀ d_k : Fin N_k,
              (mS * qk tid d_k) * Real.log ((mS * qk tid d_k) / (p_T tid * (mS * qk_D d_k))) =
              mS * (qk tid d_k * Real.log (qk tid d_k / (p_TS tid * qk_D d_k))) +
                (mS * qk tid d_k) * Real.log (p_Tz tid / (p_T tid * mS)) := by
            intro d_k
            by_cases hqk_pos : 0 < qk tid d_k
            · have hpTS_pos : 0 < p_TS tid := by
                rw [← hqk_pTS tid]
                exact lt_of_lt_of_le hqk_pos
                  (Finset.single_le_sum (fun d' _ => hqk_nn tid d') (Finset.mem_univ d_k))
              have hqkD_pos : 0 < qk_D d_k := by
                rw [hqk_D_def d_k]
                exact lt_of_lt_of_le hqk_pos
                  (Finset.single_le_sum (fun tid' _ => hqk_nn tid' d_k) (Finset.mem_univ tid))
              have hpTz_pos : 0 < p_Tz tid := by rw [← hpTz_mS tid]; exact mul_pos hmS_pos hpTS_pos
              have hpT_pos : 0 < p_T tid := lt_of_lt_of_le hpTz_pos (hpTz_le tid)
              have h_prod : (mS * qk tid d_k) / (p_T tid * (mS * qk_D d_k)) =
                  (qk tid d_k / (p_TS tid * qk_D d_k)) * (p_Tz tid / (p_T tid * mS)) := by
                rw [← hpTz_mS tid]
                field_simp [ne_of_gt hmS_pos, ne_of_gt hpTS_pos, ne_of_gt hqkD_pos, ne_of_gt hpT_pos]
              rw [h_prod, Real.log_mul (ne_of_gt (div_pos hqk_pos (mul_pos hpTS_pos hqkD_pos)))
                (ne_of_gt (div_pos hpTz_pos (mul_pos hpT_pos hmS_pos)))]
              ring
            · have h0 : qk tid d_k = 0 := le_antisymm (le_of_not_gt hqk_pos) (hqk_nn tid d_k)
              simp [h0]
          simp_rw [h_term]
          rw [Finset.sum_add_distrib, ← Finset.mul_sum, ← Finset.sum_mul, ← Finset.mul_sum,
            hqk_pTS tid, hpTz_mS tid]
        have h_ITD_eq : (∑ tid : Fin N_T, ∑ d : Fin (N₁ + N₀),
            q tid d * Real.log (q tid d / (p_T tid * q_D d))) / Real.log (ε⁻¹) =
            m_E * ((∑ tid : Fin N_T, ∑ d₁ : Fin N₁,
              q₁ tid d₁ * Real.log (q₁ tid d₁ / (p_TE tid * q₁_D d₁))) / Real.log (ε⁻¹)) +
            (1 - m_E) * ((∑ tid : Fin N_T, ∑ d₀ : Fin N₀,
              q₀ tid d₀ * Real.log (q₀ tid d₀ / (p_TEc tid * q₀_D d₀))) / Real.log (ε⁻¹)) +
            finMutualInfo ε π T_idx Z := by
          rw [h_mut_Z]
          have h_tid : ∀ tid : Fin N_T,
              (∑ d : Fin (N₁ + N₀), q tid d * Real.log (q tid d / (p_T tid * q_D d))) =
              m_E * (∑ d₁ : Fin N₁, q₁ tid d₁ * Real.log (q₁ tid d₁ / (p_TE tid * q₁_D d₁))) +
              (1 - m_E) * (∑ d₀ : Fin N₀, q₀ tid d₀ * Real.log (q₀ tid d₀ / (p_TEc tid * q₀_D d₀))) +
              (p_T1 tid * Real.log (p_T1 tid / (p_T tid * m_E)) +
                p_T0 tid * Real.log (p_T0 tid / (p_T tid * (1 - m_E)))) := by
            intro tid
            rw [← Equiv.sum_comp σ.symm, Fintype.sum_sum_type]
            simp only [hqD_inl, hqD_inr, q, Equiv.apply_symm_apply, Sum.elim_inl, Sum.elim_inr]
            have hb1 := h_ITD_branch m_E p_TE p_T1 q₁ q₁_D hmE0 hqnn₁ hqp₁ (fun _ => rfl) hp_T1_eq
              (fun tid' => by
                have h0_nn : 0 ≤ p_T0 tid' := Finset.sum_nonneg (fun ω _ => by split_ifs <;> [exact hπ_nn ω; exact le_rfl])
                linarith [hp_T_split tid']) tid
            have hb0 := h_ITD_branch (1 - m_E) p_TEc p_T0 q₀ q₀_D hmEc_pos hqnn₀ hqp₀ (fun _ => rfl) hp_T0_eq
              (fun tid' => by
                have h1_nn : 0 ≤ p_T1 tid' := Finset.sum_nonneg (fun ω _ => by split_ifs <;> [exact hπ_nn ω; exact le_rfl])
                linarith [hp_T_split tid']) tid
            rw [hb1, hb0]
            ring
          simp_rw [h_tid, Finset.sum_add_distrib, ← Finset.mul_sum]
          ring
        let s_glued := (∑ d : Fin (N₁ + N₀), q_D d * ((1 + γ) * b_D d + (1 - γ) * a_D d)) -
          (∑ tid : Fin N_T, ∑ d : Fin (N₁ + N₀),
            q tid d * Real.log (q tid d / (p_T tid * q_D d))) / Real.log (ε⁻¹)
        have hs_mem : s_glued ∈ rootSet ε L π T_idx V_part A_part :=
          ⟨N₁ + N₀, b_D, a_D, e_D, V_D, A_D, q, h_adm, hq_nn, hq_sum, h_cap, rfl⟩
        have hs_le_sup : s_glued ≤ classicalRootSupremum ε L γ N_ω N_T π T_idx V_part A_part :=
          le_csSup hS_bdd hs_mem
        change s₁ = (∑ d₁, q₁_D d₁ * ((1 + γ) * b₁ d₁ + (1 - γ) * a₁ d₁)) -
          (∑ tid, ∑ d₁, q₁ tid d₁ * Real.log (q₁ tid d₁ / (p_TE tid * q₁_D d₁))) / Real.log (ε⁻¹) at hs₁_eq
        change s₀ = (∑ d₀, q₀_D d₀ * ((1 + γ) * b₀ d₀ + (1 - γ) * a₀ d₀)) -
          (∑ tid, ∑ d₀, q₀ tid d₀ * Real.log (q₀ tid d₀ / (p_TEc tid * q₀_D d₀))) / Real.log (ε⁻¹) at hs₀_eq
        dsimp [s_glued] at hs_le_sup
        rw [h_Ew_eq, h_ITD_eq] at hs_le_sup
        have h_lin : m_E * s₁ + (1 - m_E) * s₀ - finMutualInfo ε π T_idx Z =
            (m_E * (∑ d₁, q₁_D d₁ * ((1 + γ) * b₁ d₁ + (1 - γ) * a₁ d₁)) +
             (1 - m_E) * (∑ d₀, q₀_D d₀ * ((1 + γ) * b₀ d₀ + (1 - γ) * a₀ d₀))) -
            (m_E * ((∑ tid, ∑ d₁, q₁ tid d₁ * Real.log (q₁ tid d₁ / (p_TE tid * q₁_D d₁))) / Real.log (ε⁻¹)) +
             (1 - m_E) * ((∑ tid, ∑ d₀, q₀ tid d₀ * Real.log (q₀ tid d₀ / (p_TEc tid * q₀_D d₀))) / Real.log (ε⁻¹)) +
             finMutualInfo ε π T_idx Z) := by
          rw [hs₁_eq, hs₀_eq]; ring
        linarith [hs_le_sup, h_lin]
      let RHS := classicalRootSupremum ε L γ N_ω N_T π T_idx V_part A_part + finMutualInfo ε π T_idx Z
      have h_step1 : ∀ s₀ ∈ rootSet ε L π_Ec T_idx V_part A_part,
          m_E * classicalRootSupremum ε L γ N_ω N_T π_E T_idx V_part A_part + (1 - m_E) * s₀ ≤ RHS := by
        intro s₀ hs₀
        have h_div : classicalRootSupremum ε L γ N_ω N_T π_E T_idx V_part A_part ≤
            (RHS - (1 - m_E) * s₀) / m_E := by
          refine csSup_le hSE_ne (fun s₁ hs₁ => ?_)
          rw [le_div_iff₀ hmE0, mul_comm s₁ m_E]
          linarith [h_pair s₁ hs₁ s₀ hs₀]
        have h_mul := (le_div_iff₀ hmE0).mp h_div
        linarith
      have h_step2 : classicalRootSupremum ε L γ N_ω N_T π_Ec T_idx V_part A_part ≤
          (RHS - m_E * classicalRootSupremum ε L γ N_ω N_T π_E T_idx V_part A_part) / (1 - m_E) := by
        refine csSup_le hSEc_ne (fun s₀ hs₀ => ?_)
        rw [le_div_iff₀ hmEc_pos, mul_comm s₀ (1 - m_E)]
        linarith [h_step1 s₀ hs₀]
      have h_mul2 := (le_div_iff₀ hmEc_pos).mp h_step2
      linarith
    · intro ε L₁ L₂ N_ω N_T π T_idx V_part A_part hε0 hε1 hL₁ hL₁₂ hπ_nn hπ_sum hVA
      have hL₂ : 0 ≤ L₂ := le_trans hL₁ hL₁₂
      obtain ⟨hS₁_ne, hS₁_bdd⟩ := h_root_ne_bdd ε L₁ π T_idx V_part A_part hε0 hε1 hL₁ hπ_nn hπ_sum hVA
      obtain ⟨hS₂_ne, hS₂_bdd⟩ := h_root_ne_bdd ε L₂ π T_idx V_part A_part hε0 hε1 hL₂ hπ_nn hπ_sum hVA
      have hε_le1 : ε ≤ 1 := le_trans hε1.le (by norm_num)
      refine ⟨?_, ?_⟩
      · refine sub_nonneg.mpr (csSup_le hS₁_ne (fun s ⟨N_D, b_D, a_D, e_D, V_D, A_D, q, hadm, h1, h2, h3, hs⟩ => ?_))
        refine le_csSup hS₂_bdd ⟨N_D, b_D, a_D, e_D, V_D, A_D, q, ?_, h1, h2, h3, hs⟩
        intro d
        obtain ⟨hb0, hba, haL₁, he⟩ := hadm d
        exact ⟨hb0, hba, le_trans haL₁ hL₁₂, he⟩
      · have h_ub : classicalRootSupremum ε L₂ γ N_ω N_T π T_idx V_part A_part ≤
            classicalRootSupremum ε L₁ γ N_ω N_T π T_idx V_part A_part + 2 * (L₂ - L₁) := by
          refine csSup_le hS₂_ne ?_
          rintro s ⟨N_D, b_D, a_D, e_D, V_D, A_D, q, hadm, hq_nn, hq_pT, hcap, hs_eq⟩
          let b'_D : Fin N_D → ℝ := fun d => min (b_D d) L₁
          let a'_D : Fin N_D → ℝ := fun d => min (a_D d) L₁
          have hadm' : ∀ d : Fin N_D, 0 ≤ b'_D d ∧ b'_D d ≤ a'_D d ∧ a'_D d ≤ L₁ ∧ ‖e_D d‖ = 1 := by
            intro d
            obtain ⟨hb0, hba, _, he⟩ := hadm d
            exact ⟨le_min hb0 hL₁, min_le_min_right L₁ hba, min_le_right _ _, he⟩
          have hcap' : ∀ tid : Fin N_T, ∀ d : Fin N_D, 0 < q tid d →
              |inner ℝ (V_part tid - V_D d) (e_D d)| ≤ 10 * ε ^ (b'_D d) ∧
              |inner ℝ (V_part tid - V_D d) (perp2D (e_D d))| ≤ 10 * ε ^ (a'_D d) ∧
              |inner ℝ (A_part tid - A_D d) (e_D d)| ≤ 10 * ε ^ (b'_D d) ∧
              |inner ℝ (A_part tid - A_D d) (perp2D (e_D d))| ≤ 10 * ε ^ (a'_D d) := by
            intro tid d hq_pos
            obtain ⟨hc1, hc2, hc3, hc4⟩ := hcap tid d hq_pos
            have hb_pow : ε ^ (b_D d) ≤ ε ^ (b'_D d) :=
              Real.rpow_le_rpow_of_exponent_ge hε0 hε_le1 (min_le_left _ _)
            have ha_pow : ε ^ (a_D d) ≤ ε ^ (a'_D d) :=
              Real.rpow_le_rpow_of_exponent_ge hε0 hε_le1 (min_le_left _ _)
            exact ⟨by linarith, by linarith, by linarith, by linarith⟩
          let p_T : Fin N_T → ℝ := fun tid => ∑ ω : Fin N_ω, if T_idx ω = tid then π ω else 0
          let q_D : Fin N_D → ℝ := fun d => ∑ tid : Fin N_T, q tid d
          have hqD_nn : ∀ d, 0 ≤ q_D d := fun d => Finset.sum_nonneg (fun tid _ => hq_nn tid d)
          have hqD_sum : ∑ d : Fin N_D, q_D d = 1 := by
            change ∑ d : Fin N_D, ∑ tid : Fin N_T, q tid d = 1
            rw [Finset.sum_comm]
            simp_rw [hq_pT]
            change ∑ tid : Fin N_T, ∑ ω : Fin N_ω, (if T_idx ω = tid then π ω else 0) = 1
            rw [Finset.sum_comm]
            have h_eq : (∑ ω : Fin N_ω, ∑ tid : Fin N_T, if T_idx ω = tid then π ω else 0) = ∑ ω, π ω :=
              Finset.sum_congr rfl (fun ω _ => by rw [Finset.sum_ite_eq Finset.univ (T_idx ω)]; simp)
            rw [h_eq, hπ_sum]
          let I_TD := (∑ tid : Fin N_T, ∑ d : Fin N_D, q tid d * Real.log (q tid d / (p_T tid * q_D d))) / Real.log (ε⁻¹)
          let E'_w := ∑ d : Fin N_D, q_D d * ((1 + γ) * b'_D d + (1 - γ) * a'_D d)
          have hs'_le : E'_w - I_TD ≤ classicalRootSupremum ε L₁ γ N_ω N_T π T_idx V_part A_part :=
            le_csSup hS₁_bdd ⟨N_D, b'_D, a'_D, e_D, V_D, A_D, q, hadm', hq_nn, hq_pT, hcap', rfl⟩
          have h_diff_w : (∑ d : Fin N_D, q_D d * ((1 + γ) * b_D d + (1 - γ) * a_D d)) - E'_w ≤
              2 * (L₂ - L₁) := by
            dsimp [E'_w]
            rw [← Finset.sum_sub_distrib]
            have h_each : ∀ d ∈ (Finset.univ : Finset (Fin N_D)),
                q_D d * ((1 + γ) * b_D d + (1 - γ) * a_D d) -
                q_D d * ((1 + γ) * b'_D d + (1 - γ) * a'_D d) ≤ q_D d * (2 * (L₂ - L₁)) := by
              intro d _
              obtain ⟨hb0, hba, haL₂, _⟩ := hadm d
              have hbd : b_D d - b'_D d ≤ L₂ - L₁ := by
                dsimp [b'_D]
                rcases le_total (b_D d) L₁ with h | h
                · rw [min_eq_left h]; linarith
                · rw [min_eq_right h]; linarith
              have had : a_D d - a'_D d ≤ L₂ - L₁ := by
                dsimp [a'_D]
                rcases le_total (a_D d) L₁ with h | h
                · rw [min_eq_left h]; linarith
                · rw [min_eq_right h]; linarith
              have h_comb : ((1 + γ) * b_D d + (1 - γ) * a_D d) -
                  ((1 + γ) * b'_D d + (1 - γ) * a'_D d) ≤ 2 * (L₂ - L₁) := by nlinarith
              calc q_D d * ((1 + γ) * b_D d + (1 - γ) * a_D d) -
                     q_D d * ((1 + γ) * b'_D d + (1 - γ) * a'_D d)
                  = q_D d * (((1 + γ) * b_D d + (1 - γ) * a_D d) -
                      ((1 + γ) * b'_D d + (1 - γ) * a'_D d)) := (mul_sub _ _ _).symm
                _ ≤ q_D d * (2 * (L₂ - L₁)) := mul_le_mul_of_nonneg_left h_comb (hqD_nn d)
            calc _ ≤ ∑ d : Fin N_D, q_D d * (2 * (L₂ - L₁)) := Finset.sum_le_sum h_each
              _ = (∑ d : Fin N_D, q_D d) * (2 * (L₂ - L₁)) := (Finset.sum_mul _ _ _).symm
              _ = 2 * (L₂ - L₁) := by rw [hqD_sum, one_mul]
          rw [hs_eq]
          linarith
        linarith
  have h_dyad_time_pow : ∀ (ε' v : ℝ), 0 < ε' → ε' < 1 / 2 → 0 ≤ v →
      ε' ^ (-v) ≤ (2 : ℝ) ^ (dyadicTimeLevel ε' v) ∧
      (2 : ℝ) ^ (dyadicTimeLevel ε' v) ≤ 4 * ε' ^ (-v) := by
    intro ε' v hε'0 hε'1 hv
    have hε'_le1 : ε' ≤ 1 := le_trans hε'1.le (by norm_num)
    set X := ε' ^ (-v)
    have hX_ge1 : 1 ≤ X := by
      calc (1 : ℝ) = ε' ^ (0 : ℝ) := (Real.rpow_zero ε').symm
        _ ≤ ε' ^ (-v) := Real.rpow_le_rpow_of_exponent_ge hε'0 hε'_le1 (neg_nonpos.mpr hv)
    set m := dyadicTimeLevel ε' v
    have h_lb : X ≤ (2 : ℝ) ^ m := by
      have h1 : X ≤ (⌈X⌉₊ : ℝ) := Nat.le_ceil X
      have h2_nat : ⌈X⌉₊ ≤ 2 ^ m := Nat.le_pow_clog (by decide) ⌈X⌉₊
      have h2 : (⌈X⌉₊ : ℝ) ≤ (2 : ℝ) ^ m := by exact_mod_cast h2_nat
      exact le_trans h1 h2
    refine ⟨h_lb, ?_⟩
    by_cases h_ceil : ⌈X⌉₊ ≤ 1
