        rw [div_le_iff₀ hM_ret_pos]
        have h_eq1 : 8 * (blk.π_seq l i b / lam_o) * lam_t * M_ret =
            (blk.π_seq l i b / lam_hat b) * (8 * (M_ret * lam_t)) / m_S := by
          rw [hlam_hat_b]
          field_simp [hlam_o_pos.ne', hm_S_pos.ne']
        have h_ge_hat : lam_hat b ≤ 8 * (M_ret * lam_t) := by linarith
        have h_mul_nn : 0 ≤ blk.π_seq l i b / lam_hat b :=
          div_nonneg (blk.hπ_nn l i b) hlam_hat_pos.le
        calc blk.π_seq l i b / m_S
            = ((blk.π_seq l i b / lam_hat b) * lam_hat b) / m_S := by
              rw [div_mul_cancel₀ _ hlam_hat_pos.ne']
          _ ≤ ((blk.π_seq l i b / lam_hat b) * (8 * (M_ret * lam_t))) / m_S :=
              div_le_div_of_nonneg_right
                (mul_le_mul_of_nonneg_left h_ge_hat h_mul_nn) hm_S_pos.le
          _ = 8 * (blk.π_seq l i b / lam_o) * lam_t * M_ret := h_eq1.symm
      exact le_trans h_step1 h_step2
    
    have hlam_t_le : ∀ b : Fin NΘ,
        (∑ i, π_tilde i b) ≤ if in_S b then (2 / m_S) * lam_orig b else 0 := by
      intro b
      have h_pt : ∀ i : Fin NP, π_tilde i b ≤ 2 * π_hat i b := by
        intro i; dsimp [π_tilde]
        split_ifs
        · rw [div_le_iff₀ hM_ret_pos]
          nlinarith [hπ_hat_nn i b, hM_ret_half]
        · exact mul_nonneg zero_le_two (hπ_hat_nn i b)
      calc (∑ i, π_tilde i b) ≤ ∑ i, 2 * π_hat i b := Finset.sum_le_sum (fun i _ => h_pt i)
        _ = 2 * lam_hat b := (Finset.mul_sum _ _ _).symm
        _ = if in_S b then (2 / m_S) * lam_orig b else 0 := by
            rw [hlam_hat_eq b]
            split_ifs
            · ring
            · simp
    
    have h_mS_inv : 2 / m_S ≤ 2 * ρ_tilde ^ (-(δ_strip / t)) := by
      rw [div_le_iff₀ hm_S_pos]
      have h_prod : ρ_tilde ^ (-(δ_strip / t)) * m_S ≥
          ρ_tilde ^ (-(δ_strip / t)) * ρ_tilde ^ (δ_strip / t) :=
        mul_le_mul_of_nonneg_left hm_S_lb.le (Real.rpow_nonneg hρ_t_pos.le _)
      have h_one : ρ_tilde ^ (-(δ_strip / t)) * ρ_tilde ^ (δ_strip / t) = 1 := by
        rw [← Real.rpow_add hρ_t_pos, neg_add_cancel, Real.rpow_zero]
      linarith
    have h_4_to_η : 4 * ρ_tilde ^ (-η_target / 2) ≤ ρ_tilde ^ (-η_target) := by
      calc 4 * ρ_tilde ^ (-η_target / 2)
          = (4 * ρ_tilde ^ (η_target / 2)) * ρ_tilde ^ (-η_target) := by
            rw [mul_assoc, ← Real.rpow_add hρ_t_pos]
            congr 2; ring
        _ ≤ 1 * ρ_tilde ^ (-η_target) :=
            mul_le_mul_of_nonneg_right h4_ηt (Real.rpow_nonneg hρ_t_pos.le _)
        _ = ρ_tilde ^ (-η_target) := one_mul _
    have h_ball1 : ∀ (a₀ r : ℝ), ρ_tilde ≤ r → r ≤ 1 →
        (∑ b : Fin NΘ,
          if |τ_fn b - a₀| < r then (∑ i, π_tilde i b) else 0) ≤
          ρ_tilde ^ (-η_target) * r ^ s := by
      intro a₀ r hr₀ hr₁
      have hr_pos : 0 < r := lt_of_lt_of_le hρ_t_pos hr₀
      have h_step1 : (∑ b : Fin NΘ, if |τ_fn b - a₀| < r then (∑ i, π_tilde i b) else 0) ≤
          (2 / m_S) * (∑ b : Fin NΘ, if in_S b ∧ |τ_fn b - a₀| < r then lam_orig b else 0) := by
        rw [Finset.mul_sum]
        refine Finset.sum_le_sum (fun b _ => ?_)
        by_cases hτ : |τ_fn b - a₀| < r
        · rw [if_pos hτ]
          refine le_trans (hlam_t_le b) ?_
          by_cases hbS : in_S b
          · have hboth : in_S b ∧ |τ_fn b - a₀| < r := ⟨hbS, hτ⟩
            rw [if_pos hbS, if_pos hboth]
          · have hnb : ¬ (in_S b ∧ |τ_fn b - a₀| < r) := fun h => hbS h.1
            rw [if_neg hbS, if_neg hnb, mul_zero]
        · have hnb : ¬ (in_S b ∧ |τ_fn b - a₀| < r) := fun h => hτ h.2
          rw [if_neg hτ, if_neg hnb, mul_zero]
      have h_exp_ge : -η_target / 2 ≤ -(δ_strip / t) + -(κ_l / t) := by
        linarith [hδ_le_η8, hκ_le_η8, hη_t]
      calc (∑ b : Fin NΘ, if |τ_fn b - a₀| < r then (∑ i, π_tilde i b) else 0)
          ≤ (2 / m_S) * (2 * ρ_l ^ (-κ_l) * r ^ s) :=
            le_trans h_step1
              (mul_le_mul_of_nonneg_left (h_τ_strip_ball a₀ r hr₀ hr₁)
                (div_nonneg zero_le_two hm_S_pos.le))
        _ ≤ (2 * ρ_tilde ^ (-(δ_strip / t))) * (2 * ρ_tilde ^ (-(κ_l / t)) * r ^ s) := by
            rw [← hρ_neg_κ_eq]
            exact mul_le_mul_of_nonneg_right h_mS_inv
              (mul_nonneg (mul_nonneg zero_le_two (Real.rpow_nonneg hρ₀.le _))
                (Real.rpow_nonneg hr_pos.le _))
        _ = 4 * (ρ_tilde ^ (-(δ_strip / t)) * ρ_tilde ^ (-(κ_l / t))) * r ^ s := by ring
        _ = 4 * ρ_tilde ^ (-(δ_strip / t) + -(κ_l / t)) * r ^ s := by
            rw [← Real.rpow_add hρ_t_pos]
        _ ≤ 4 * ρ_tilde ^ (-η_target / 2) * r ^ s := by
            refine mul_le_mul_of_nonneg_right ?_ (Real.rpow_nonneg hr_pos.le _)
            exact mul_le_mul_of_nonneg_left
              (Real.rpow_le_rpow_of_exponent_ge hρ_t_pos hρ_t_lt_one.le h_exp_ge) (by norm_num)
        _ ≤ ρ_tilde ^ (-η_target) * r ^ s :=
            mul_le_mul_of_nonneg_right h_4_to_η (Real.rpow_nonneg hr_pos.le _)
    have h_ball2 : ∀ (a₀ r : ℝ), ρ_tilde ≤ r → r ≤ 1 →
        (∑ b : Fin NΘ,
          if |flip_fn b - a₀| < r then (∑ i, π_tilde i b) else 0) ≤
          ρ_tilde ^ (-η_target) * r ^ s := by
      intro a₀ r hr₀ hr₁
      have hr_pos : 0 < r := lt_of_lt_of_le hρ_t_pos hr₀
      have h_step1 : (∑ b : Fin NΘ, if |flip_fn b - a₀| < r then (∑ i, π_tilde i b) else 0) ≤
          (2 / m_S) * (∑ b : Fin NΘ, if in_S b ∧ |flip_fn b - a₀| < r then lam_orig b else 0) := by
        rw [Finset.mul_sum]
        refine Finset.sum_le_sum (fun b _ => ?_)
        by_cases hf : |flip_fn b - a₀| < r
        · rw [if_pos hf]
          refine le_trans (hlam_t_le b) ?_
          by_cases hbS : in_S b
          · have hboth : in_S b ∧ |flip_fn b - a₀| < r := ⟨hbS, hf⟩
            rw [if_pos hbS, if_pos hboth]
          · have hnb : ¬ (in_S b ∧ |flip_fn b - a₀| < r) := fun h => hbS h.1
            rw [if_neg hbS, if_neg hnb, mul_zero]
        · have hnb : ¬ (in_S b ∧ |flip_fn b - a₀| < r) := fun h => hf h.2
          rw [if_neg hf, if_neg hnb, mul_zero]
      have h_2sηd : 2 * s * η_d ≤ η_target / 4 := by
        have h1 : s * η_d ≤ 1 * η_d := mul_le_mul_of_nonneg_right hs₁ hη_d_pos.le
        linarith
      have h_exp_ge : -η_target / 2 ≤ -(δ_strip / t) + -(κ_l / t) + -2 * s * η_d := by
        linarith [hδ_le_η8, hκ_le_η8, h_2sηd]
      calc (∑ b : Fin NΘ, if |flip_fn b - a₀| < r then (∑ i, π_tilde i b) else 0)
          ≤ (2 / m_S) * (2 * ρ_l ^ (-κ_l) * ρ_tilde ^ (-2 * s * η_d) * r ^ s) :=
            le_trans h_step1
              (mul_le_mul_of_nonneg_left (h_flip_strip_ball a₀ r hr₀ hr₁)
                (div_nonneg zero_le_two hm_S_pos.le))
        _ ≤ (2 * ρ_tilde ^ (-(δ_strip / t))) *
              (2 * ρ_tilde ^ (-(κ_l / t)) * ρ_tilde ^ (-2 * s * η_d) * r ^ s) := by
            rw [← hρ_neg_κ_eq]
            exact mul_le_mul_of_nonneg_right h_mS_inv
              (mul_nonneg
                (mul_nonneg (mul_nonneg zero_le_two (Real.rpow_nonneg hρ₀.le _))
                  (Real.rpow_nonneg hρ_t_pos.le _))
                (Real.rpow_nonneg hr_pos.le _))
        _ = 4 * (ρ_tilde ^ (-(δ_strip / t)) * ρ_tilde ^ (-(κ_l / t)) * ρ_tilde ^ (-2 * s * η_d)) *
              r ^ s := by ring
        _ = 4 * ρ_tilde ^ (-(δ_strip / t) + -(κ_l / t) + -2 * s * η_d) * r ^ s := by
            rw [← Real.rpow_add hρ_t_pos, ← Real.rpow_add hρ_t_pos]
        _ ≤ 4 * ρ_tilde ^ (-η_target / 2) * r ^ s := by
            refine mul_le_mul_of_nonneg_right ?_ (Real.rpow_nonneg hr_pos.le _)
            exact mul_le_mul_of_nonneg_left
              (Real.rpow_le_rpow_of_exponent_ge hρ_t_pos hρ_t_lt_one.le h_exp_ge) (by norm_num)
        _ ≤ ρ_tilde ^ (-η_target) * r ^ s :=
            mul_le_mul_of_nonneg_right h_4_to_η (Real.rpow_nonneg hr_pos.le _)
    refine ⟨l, e_n, c₀, π_tilde, hρ_t_pos, hρ_le_tilde, hρ_t_lt_one, hev1,
      hκ_le_η8, hρ_neg_κ_eq, he_n, hπ_t_nn, hπ_t_sum, hπ_t_supp,
      hπ_t_pair, hπ_t_fiber, h_ball1, h_ball2⟩
  
  rcases ha with ⟨ha0_nn, ha0_le1, ha1_nn, ha1_le2, ha2_nn, ha2_le1⟩
  constructor
  · 
    rintro ⟨ha0_pos, ha2_lt1⟩
    by_contra h_not
    push_neg at h_not
    let χ₁ : ℝ := min 1 (min (a_pt 0 + a_pt 2) ((a_pt 0 + a_pt 2 + s) / 2))
    have hχ₁_gt : a_pt 2 < χ₁ :=
      lt_min ha2_lt1 (lt_min (by linarith) (by linarith))
    let α₁ : ℝ := (χ₁ - a_pt 2) / 2
    have hα₁_pos : 0 < α₁ := by dsimp [α₁]; linarith
    obtain ⟨η₁, ρ₁₁, hη₁_pos, hρ₁₁_pos, _, h_slice3⟩ :=
      strip_three_replica_rotated_slice_bound s (a_pt 0) (a_pt 2) α₁
        hs₀ hs₁ ha0_pos ha0_le1 ha2_nn ha2_lt1 hα₁_pos h_core h_proj
    let η_t1 : ℝ := min η₁ (α₁ / 4)
    have hη_t1_pos : 0 < η_t1 := lt_min hη₁_pos (by linarith)
    have hη_t1_le_η₁ : η_t1 ≤ η₁ := min_le_left _ _
    have hη_t1_le_α : η_t1 ≤ α₁ / 4 := min_le_right _ _
    obtain ⟨l, e_n, c₀, π_tilde, hρ_t_pos, hρ_le_tilde, hρ_t_lt_one, hρ_t_lt_ρ₁,
        hκ_le_η8, hρ_neg_κ_eq, he_n, hπ_t_nn, hπ_t_sum, hπ_t_supp,
        hπ_t_pair, hπ_t_fiber, h_ball1, h_ball2⟩ :=
      h_stage η_t1 ρ₁₁ hη_t1_pos hρ₁₁_pos
    let ρ_l := blk.ρ_seq l
    let ρ_tilde := ρ_l ^ t
    let κ_l := blk.κ_seq l
    have hκ_le_η8' : κ_l / t ≤ η_t1 / 8 := hκ_le_η8
    have h_κ_to_η₁ : ρ_l ^ (-κ_l) ≤ ρ_tilde ^ (-η₁) := by
      rw [hρ_neg_κ_eq]
      exact Real.rpow_le_rpow_of_exponent_ge hρ_t_pos hρ_t_lt_one.le
        (by linarith [hκ_le_η8', hη_t1_le_η₁, hη_t1_pos])
    have h_t_to_η₁ : ρ_tilde ^ (-η_t1) ≤ ρ_tilde ^ (-η₁) :=
      Real.rpow_le_rpow_of_exponent_ge hρ_t_pos hρ_t_lt_one.le (by linarith)
    have h_b1_η₁ : ∀ (a₀ r : ℝ), ρ_tilde ≤ r → r ≤ 1 →
        (∑ b : Fin (blk.N_Θ l),
          if |(blk.θ_seq l b).1 * (perp2D e_n 0) + (blk.θ_seq l b).2 * (perp2D e_n 1) - a₀| < r
          then (∑ i, π_tilde i b) else 0) ≤ ρ_tilde ^ (-η₁) * r ^ s := by
      intro a₀ r hr₀ hr₁
      have hr_pos : 0 < r := lt_of_lt_of_le hρ_t_pos hr₀
      exact le_trans (h_ball1 a₀ r hr₀ hr₁)
        (mul_le_mul_of_nonneg_right h_t_to_η₁ (Real.rpow_nonneg hr_pos.le _))
    have h_b2_η₁ : ∀ (a₀ r : ℝ), ρ_tilde ≤ r → r ≤ 1 →
        (∑ b : Fin (blk.N_Θ l),
          if |(blk.θ_seq l b).1 * (perp2D e_n 1) + (blk.θ_seq l b).2 * (perp2D e_n 0) - a₀| < r
          then (∑ i, π_tilde i b) else 0) ≤ ρ_tilde ^ (-η₁) * r ^ s := by
      intro a₀ r hr₀ hr₁
      have hr_pos : 0 < r := lt_of_lt_of_le hρ_t_pos hr₀
      exact le_trans (h_ball2 a₀ r hr₀ hr₁)
        (mul_le_mul_of_nonneg_right h_t_to_η₁ (Real.rpow_nonneg hr_pos.le _))
    have h_res := h_slice3 (blk.N_P l) (blk.N_Θ l) ρ_l ρ_tilde κ_l e_n c₀
      (blk.π_seq l) π_tilde (blk.P_seq l) (blk.θ_seq l)
      (blk.hρ_bounds l).1 (blk.hρ_bounds l).2 hρ_le_tilde hρ_t_lt_ρ₁ (blk.hκ_pos l)
      h_κ_to_η₁ he_n (blk.hP_dom l) (blk.hθ_dom l) (blk.hπ_nn l)
      (fun b hlam kX kU kZ => by
        convert blk.h_coord_prod l b hlam kX kU kZ using 2)
      (fun b z₀ r hlam hr₀ hr₁ => by
        convert blk.h_X_ball l b z₀ r hlam hr₀ hr₁ using 2)
      (fun b z₀ r hlam hr₀ hr₁ => by
        convert blk.h_Z_ball l b z₀ r hlam hr₀ hr₁ using 2)
      (fun b hlam => blk.h_Z_cov l b ρ_tilde hlam hρ_le_tilde hρ_t_lt_one.le)
      hπ_t_nn hπ_t_sum hπ_t_supp hπ_t_pair hπ_t_fiber
      (fun a₀ r hr₀ hr₁ => by
        refine le_trans ?_ (h_b1_η₁ a₀ r hr₀ hr₁)
