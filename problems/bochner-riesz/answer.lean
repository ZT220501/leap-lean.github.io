        _ ≤ (S_kc kt d₂).card * 4356 :=
            Finset.sum_le_card_nsmul _ _ 4356 (fun kc _ => h_box_le kt kc)
        _ ≤ 3 * 4356 := Nat.mul_le_mul_right 4356 h3
        _ = 13068 := by norm_num
