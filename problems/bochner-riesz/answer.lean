        rw [habs]
        exact mul_le_mul_of_nonneg_right (hq_ge_gap j) (by linarith)
      have h_core :
          ((1 / 2 : ℝ) * c_gap ^ 2) * H_mix F (p_fn (i, u)) ≤
          ∑ j : Fin n, q j * (-D_u j (i, u) + c j * D_i j (i, u)) := by
        dsimp [H_mix, F_LL, F_VL] at h_ll_le h_vl_le ⊢
        linarith [h_id, h_ll_le, h_vl_le]
