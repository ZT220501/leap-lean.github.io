        (d_dim = 2 → b_D d = (H_P - t) / 2 ∧ a_D d = (H_P - t) / 2) ∧
        |inner ℝ (V_O o - V_D d) (e_D d)| ≤ cls.B_sys * ε ^ (b_D d) ∧
        |inner ℝ (V_O o - V_D d) (perp2D (e_D d))| ≤ cls.B_sys * ε ^ (a_D d) ∧
        |inner ℝ (X_O o - X_D d) (e_D d)| ≤ cls.B_sys * ε ^ (b_D d + t) ∧
        |inner ℝ (X_O o - X_D d) (perp2D (e_D d))| ≤ cls.B_sys * ε ^ (a_D d + t) ∧
        ‖gridPt2D ρ_r ((menu j).o_at α).1 - V_O o‖ ≤
          (2 * (M_L : ℝ) + 4) * ε ^ ((H_P - t) / 2) ∧
        ‖(gridPt2D σ_r ((menu j).o_at α).2 +
            (((r_O o : ℝ) + 1 / 2) * ((2 : ℝ) ^ m_t)⁻¹ -
              (((menu j).loc_idx.1 : ℝ) + 1 / 2) * s_c) •
              gridPt2D ρ_r ((menu j).o_at α).1) - X_O o‖ ≤
          (8 * C_cov * cls.B_sys + 16) * (ε ^ (-θ)) * s_x * ε ^ (u + h)) := by
    intro j hπj
    refine ⟨(hmenu_all j).1, ?_, ?_, ?_⟩
    · intro o d α
      dsimp only [q_cand]
      split_ifs
      · exact div_nonneg (div_nonneg (hq_nn o d) hπj.le) (Nat.cast_nonneg _)
      · exact le_rfl
    · have h_inner : ∀ o : Fin N_O, ∀ d : Fin N_D,
          (∑ α : Fin (N_ret_of j), q_cand j o d α) =
            if win_of o = j then q o d / π_q j else 0 := by
        intro o d
        by_cases hw : win_of o = j
        · by_cases hq0 : q o d = 0
          · rw [if_pos hw, hq0, zero_div]
            refine Finset.sum_eq_zero (fun α _ => ?_)
            dsimp only [q_cand]
            rw [hq0, zero_div, zero_div]
            split_ifs <;> rfl
          · have hq_pos : 0 < q o d := lt_of_le_of_ne (hq_nn o d) (Ne.symm hq0)
            have hne_T : (T_cand j (Q_of j o)).Nonempty := by
              have h1 := (h_act_geom o d hq_pos).2.2.2.2.2.2.1
              rwa [hw] at h1
            have hcard_pos : (0 : ℝ) < ((T_cand j (Q_of j o)).card : ℝ) := by
              exact_mod_cast Finset.card_pos.mpr hne_T
            have hsum_α : (∑ α : Fin (N_ret_of j), q_cand j o d α) =
                ∑ α ∈ T_cand j (Q_of j o), (q o d / π_q j) / ((T_cand j (Q_of j o)).card : ℝ) := by
              have h_ite : ∀ α : Fin (N_ret_of j),
                  q_cand j o d α =
                    if α ∈ T_cand j (Q_of j o) then
                      (q o d / π_q j) / ((T_cand j (Q_of j o)).card : ℝ)
                    else 0 := by
                intro α
                dsimp only [q_cand]
                by_cases hα : α ∈ T_cand j (Q_of j o)
                · rw [if_pos ⟨hw, hπj, hα⟩, if_pos hα]
                · rw [if_neg (fun h => hα h.2.2), if_neg hα]
              rw [Finset.sum_congr rfl (fun α _ => h_ite α), ← Finset.sum_filter,
                Finset.filter_mem_eq_inter, Finset.univ_inter]
            rw [hsum_α, Finset.sum_const, nsmul_eq_mul, mul_div_cancel₀ _ hcard_pos.ne', if_pos hw]
        · rw [if_neg hw]
          refine Finset.sum_eq_zero (fun α _ => ?_)
          dsimp only [q_cand]
          exact if_neg (fun h => hw h.1)
      rw [Finset.sum_congr rfl (fun o _ => Finset.sum_congr rfl (fun d _ => h_inner o d))]
      have h_sum_d : ∀ o : Fin N_O,
          (∑ d : Fin N_D, if win_of o = j then q o d / π_q j else 0) =
            if win_of o = j then (∑ d : Fin N_D, q o d) / π_q j else 0 := by
        intro o
        by_cases hw : win_of o = j
        · rw [if_pos hw, Finset.sum_div]
          exact Finset.sum_congr rfl (fun _ _ => if_pos hw)
        · rw [if_neg hw]
          exact Finset.sum_eq_zero (fun _ _ => if_neg hw)
      rw [Finset.sum_congr rfl (fun o _ => h_sum_d o), ← Finset.sum_filter, ← Finset.sum_div]
      exact div_self hπj.ne'
    · intro o d α hqc_pos
      dsimp only [q_cand] at hqc_pos
      by_cases hcond : win_of o = j ∧ 0 < π_q j ∧ α ∈ T_cand j (Q_of j o)
      · rw [if_pos hcond] at hqc_pos
        obtain ⟨hw_o, _, hα_mem⟩ := hcond
        subst hw_o
        have hq_od : 0 < q o d := by
          by_contra hle
          have h0 : q o d = 0 := le_antisymm (le_of_not_gt hle) (hq_nn o d)
          rw [h0, zero_div, zero_div] at hqc_pos
          exact lt_irrefl 0 hqc_pos
        have hp_od := (hsupp_q o d hq_od).1
        have hps := hp_supp o d hp_od
        have hqa := hq_act o d hq_od
        have hag := h_act_geom o d hq_od
        have had := hadm_d d
        have h_α_bd := hag.2.2.2.2.2.2.2 α hα_mem
        exact ⟨(hadm_site o).1, hqa.2.1, hps.1.symm, had.1, hps.2.2.1, had.2.1,
          le_trans had.2.2.1 (min_le_right _ _), had.2.2.2.2,
          hps.2.2.2.1, hps.2.2.2.2.1, hps.2.2.2.2.2.1,
          hqa.2.2.1, hqa.2.2.2.1, hqa.2.2.2.2.1, hqa.2.2.2.2.2,
          h_α_bd.1, h_α_bd.2⟩
      · rw [if_neg hcond] at hqc_pos
        exact False.elim (lt_irrefl 0 hqc_pos)

  have h_mid_7 :=
    h_s7 ε H_P L t b_star lam_sys m_r m_t N_O N_D N_J Φ₀
      r_O V_O X_O b_D a_D r_D e_D V_D X_D N_ret_of menu π_q q_cand
      hε₀ hε_lt_cl hr_pos ht_le1 ht_L ht_HP hHP_K hL_K
      hb_star_nn hu_ge hu_plus_h_Lr hd2_bstar hm_r_eq hmr_le_mt
      hlam_lo hlam_hi hmt1 hmt2 hπ_q_nn hπ_q_sum h_qcand_props

  let q_T := fun j α => ∑ o, ∑ d, q_cand j o d α
  let q_TD := fun j α d => ∑ o, q_cand j o d α
  let q_D := fun j d => ∑ o, ∑ α, q_cand j o d α
  let q_TR := fun j α (rl : Fin (2 ^ (m_t - m_r))) =>
    ∑ o ∈ Finset.univ.filter (fun o => r_O o % 2 ^ (m_t - m_r) = rl.1),
      ∑ d, q_cand j o d α

  have h_qT_ent : ∀ j : Fin N_J, 0 < π_q j →
      (∑ α : Fin (N_ret_of j), -(q_T j α * Real.log (q_T j α))) / ell ≤
        Real.log (N_ret_of j : ℝ) / ell := by
    intro j hπj
    obtain ⟨_, hqc_nn, hqc_sum, _⟩ := h_qcand_props j hπj
    refine h_entropy_ub (q_T j) (h_menu_proxy j).1 hell_pos
      (fun α => Finset.sum_nonneg (fun o _ => Finset.sum_nonneg (fun d _ => hqc_nn o d α))) ?_
    dsimp only [q_T]
    rw [Finset.sum_comm]
    have hcomm2 : (∑ o : Fin N_O, ∑ α : Fin (N_ret_of j), ∑ d : Fin N_D, q_cand j o d α) =
        ∑ o : Fin N_O, ∑ d : Fin N_D, ∑ α : Fin (N_ret_of j), q_cand j o d α :=
      Finset.sum_congr rfl (fun _ _ => Finset.sum_comm)
    rw [hcomm2]
    exact hqc_sum

  have h_sum_split :
      (∑ j : Fin N_J, if 0 < π_q j then π_q j * (
        (∑ α, -(q_T j α * Real.log (q_T j α))) / ell +
        (3 / 2 : ℝ) * (Real.log (menu j).m_bin / ell) +
        (1 / 2 : ℝ) * (
          (∑ d, q_D j d * pktWeight γ (b_D d - b_star) (a_D d - b_star)) +
          (∑ α, ∑ d, -(q_TD j α d * Real.log (q_TD j α d / q_D j d))) / ell +
          2 * ((∑ α, ∑ rl : Fin (2 ^ (m_t - m_r)),
            -(q_TR j α rl * Real.log (q_TR j α rl / q_T j α))) / ell) +
          k_out - (d_dim : ℝ) * h))
       else 0) ≤
      (∑ j : Fin N_J, π_q j * (Real.log (N_ret_of j : ℝ) / ell +
        (3 / 2 : ℝ) * (Real.log (menu j).m_bin / ell))) +
      (1 / 2 : ℝ) * (∑ j : Fin N_J, if 0 < π_q j then π_q j * (
        (∑ d, q_D j d * pktWeight γ (b_D d - b_star) (a_D d - b_star)) +
        (∑ α, ∑ d, -(q_TD j α d * Real.log (q_TD j α d / q_D j d))) / ell +
        2 * ((∑ α, ∑ rl : Fin (2 ^ (m_t - m_r)),
          -(q_TR j α rl * Real.log (q_TR j α rl / q_T j α))) / ell))
       else 0) +
      (1 / 2 : ℝ) * (k_out - (d_dim : ℝ) * h) := by
    have h_kout_sum : (∑ j : Fin N_J, if 0 < π_q j then π_q j * ((1 / 2 : ℝ) * (k_out - (d_dim : ℝ) * h)) else 0) =
        (1 / 2 : ℝ) * (k_out - (d_dim : ℝ) * h) := by
      have h1 : ∀ j : Fin N_J,
          (if 0 < π_q j then π_q j * ((1 / 2 : ℝ) * (k_out - (d_dim : ℝ) * h)) else 0) =
            π_q j * ((1 / 2 : ℝ) * (k_out - (d_dim : ℝ) * h)) := by
        intro j
        by_cases h0 : π_q j = 0
        · rw [h0, if_neg (lt_irrefl 0), zero_mul]
        · rw [if_pos (lt_of_le_of_ne (hπ_q_nn j) (Ne.symm h0))]
      rw [Finset.sum_congr rfl (fun j _ => h1 j), ← Finset.sum_mul, hπ_q_sum, one_mul]
    rw [← h_kout_sum, Finset.mul_sum, ← Finset.sum_add_distrib, ← Finset.sum_add_distrib]
    refine Finset.sum_le_sum (fun j _ => ?_)
    by_cases h0 : π_q j = 0
    · simp (config := { decide := false }) only [h0, lt_self_iff_false, ↓reduceIte,
        zero_mul, mul_zero, add_zero, le_refl]
    · have hpos : 0 < π_q j := lt_of_le_of_ne (hπ_q_nn j) (Ne.symm h0)
      simp (config := { decide := false }) only [hpos, ↓reduceIte]
      have hent := mul_le_mul_of_nonneg_left (h_qT_ent j hpos) hpos.le
      have hring_j :
          π_q j * ((∑ α, -(q_T j α * Real.log (q_T j α))) / ell +
            (3 / 2 : ℝ) * (Real.log (menu j).m_bin / ell) +
            (1 / 2 : ℝ) * ((∑ d, q_D j d * pktWeight γ (b_D d - b_star) (a_D d - b_star)) +
              (∑ α, ∑ d, -(q_TD j α d * Real.log (q_TD j α d / q_D j d))) / ell +
              2 * ((∑ α, ∑ rl : Fin (2 ^ (m_t - m_r)),
                -(q_TR j α rl * Real.log (q_TR j α rl / q_T j α))) / ell) +
              k_out - (d_dim : ℝ) * h)) =
          π_q j * ((∑ α, -(q_T j α * Real.log (q_T j α))) / ell) +
          π_q j * ((3 / 2 : ℝ) * (Real.log (menu j).m_bin / ell)) +
          (1 / 2 : ℝ) * (π_q j * ((∑ d, q_D j d * pktWeight γ (b_D d - b_star) (a_D d - b_star)) +
            (∑ α, ∑ d, -(q_TD j α d * Real.log (q_TD j α d / q_D j d))) / ell +
            2 * ((∑ α, ∑ rl : Fin (2 ^ (m_t - m_r)),
              -(q_TR j α rl * Real.log (q_TR j α rl / q_T j α))) / ell))) +
          π_q j * ((1 / 2 : ℝ) * (k_out - (d_dim : ℝ) * h)) := by ring
      have hring_r :
          π_q j * (Real.log (N_ret_of j : ℝ) / ell +
            (3 / 2 : ℝ) * (Real.log (menu j).m_bin / ell)) =
          π_q j * (Real.log (N_ret_of j : ℝ) / ell) +
          π_q j * ((3 / 2 : ℝ) * (Real.log (menu j).m_bin / ell)) := by ring
      linarith only [hent, hring_j, hring_r]

  have h_proxy_eq :
      (∑ j : Fin N_J, π_q j * (Real.log (N_ret_of j : ℝ) / ell +
        (3 / 2 : ℝ) * (Real.log (menu j).m_bin / ell))) +
      (1 / 2 : ℝ) * (∑ j : Fin N_J, π_q j * (menu j).g_bin) =
      ∑ j : Fin N_J, π_q j * subclassProxyA ε (menu j) := by
    rw [Finset.mul_sum, ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    dsimp only [subclassProxyA, ell]
    ring

  have h_log_err : C_ent_info / ell + (1 / 2 : ℝ) * (C_cl_info / ell) +
      (1 / 2 : ℝ) * (C_ent_info / ell) = A_log / ell := by
    dsimp only [A_log]; ring

  let F_T_fn : ∀ j : Fin N_J, ℕ → Fin (N_ret_of j) → ℕ × (ℤ × ℤ) × (ℤ × ℤ) :=
    fun j r_loc α =>
      let V_J := gridPt2D s_v (menu j).loc_idx.2.1
      let X_J := gridPt2D s_x (menu j).loc_idx.2.2
      let V'_α := s_v⁻¹ • (gridPt2D ρ_r ((menu j).o_at α).1 - V_J)
      let X'_α := s_x⁻¹ • (gridPt2D σ_r ((menu j).o_at α).2 - X_J)
      let c_end := ((r_loc : ℝ) + 1 / 2) * ((2 : ℝ) ^ (m_t - m_r))⁻¹
      (r_loc,
       roundShift2D (ε ^ (u - h)) 0 V'_α,
       roundShift2D (ε ^ (u + h)) 0 (X'_α + (c_end - 1 / 2) • V'_α))
  let π_FTJ := fun j (ft : ℕ × (ℤ × ℤ) × (ℤ × ℤ)) =>
    ∑ o, ∑ d, ∑ α ∈ Finset.univ.filter (fun α => F_T_fn j (r_O o % 2 ^ (m_t - m_r)) α = ft),
      π_q j * q_cand j o d α
  let π_TFTJ := fun j ft α =>
    ∑ o, ∑ d, if F_T_fn j (r_O o % 2 ^ (m_t - m_r)) α = ft then π_q j * q_cand j o d α else 0
  let π_DFTJ := fun j ft d =>
    ∑ o, ∑ α ∈ Finset.univ.filter (fun α => F_T_fn j (r_O o % 2 ^ (m_t - m_r)) α = ft),
      π_q j * q_cand j o d α
  let π_TDFTJ := fun j ft α d =>
    ∑ o, if F_T_fn j (r_O o % 2 ^ (m_t - m_r)) α = ft then π_q j * q_cand j o d α else 0
  let S_FT : Fin N_J → Finset (ℕ × (ℤ × ℤ) × (ℤ × ℤ)) := fun j =>
    (Finset.univ ×ˢ Finset.univ).image (fun oα : Fin N_O × Fin (N_ret_of j) =>
      F_T_fn j (r_O oα.1 % 2 ^ (m_t - m_r)) oα.2)
  let I_TD_FTJ : ℝ :=
    (∑ j : Fin N_J, ∑ ft ∈ S_FT j, ∑ α : Fin (N_ret_of j), ∑ d : Fin N_D,
      if 0 < π_FTJ j ft then
        π_TDFTJ j ft α d * Real.log ((π_TDFTJ j ft α d * π_FTJ j ft) /
          (π_TFTJ j ft α * π_DFTJ j ft d))
      else 0) / ell

  have h_A' : generalPacketScore ε γ H_P t lam_sys m_t Φ₀ f N_O N_D r_O V_O X_O ψ_O b_D a_D q ≤
      H_Jq + b_star +
      (∑ j : Fin N_J, if 0 < π_q j then π_q j * (
        (∑ α, -(q_T j α * Real.log (q_T j α))) / ell +
        (3 / 2 : ℝ) * (Real.log (menu j).m_bin / ell) +
        (1 / 2 : ℝ) * (
          (∑ d, q_D j d * pktWeight γ (b_D d - b_star) (a_D d - b_star)) +
          (∑ α, ∑ d, -(q_TD j α d * Real.log (q_TD j α d / q_D j d))) / ell +
          2 * ((∑ α, ∑ rl : Fin (2 ^ (m_t - m_r)),
            -(q_TR j α rl * Real.log (q_TR j α rl / q_T j α))) / ell) +
          k_out - (d_dim : ℝ) * h))
       else 0) +
      4 * θ + 2 * ξ + (1 / 2 : ℝ) * ζ_sh +
      (7 / 2 : ℝ) * (Real.log (S_per_loc : ℝ) / ell) + C_ent_info / ell :=
    le_of_le_of_eq h_sc_A (by congr)

  have h_B' : H_in - 6 * θ - ζ_sh - (Real.log (S_per_loc : ℝ) / ell) - C_ent_info / ell ≤
      I_TD_FTJ :=
    le_of_le_of_eq h_info_B (by congr)

  have h_7' :
      (∑ j : Fin N_J, if 0 < π_q j then π_q j * (
        (∑ d, q_D j d * pktWeight γ (b_D d - b_star) (a_D d - b_star)) +
        (∑ α, ∑ d, -(q_TD j α d * Real.log (q_TD j α d / q_D j d))) / ell +
        2 * ((∑ α, ∑ rl : Fin (2 ^ (m_t - m_r)),
          -(q_TR j α rl * Real.log (q_TR j α rl / q_T j α))) / ell))
       else 0) ≤
      (∑ j : Fin N_J, π_q j * (menu j).g_bin) +
      ((d_dim : ℝ) + 2 * γ) * h - I_TD_FTJ +
      2 * θ + 4 * ζ_sh + 2 * ξ + e_rep / 32 + C_cl_info / ell :=
    le_of_eq_of_le (by congr) (le_of_le_of_eq h_mid_7 (by congr))

  have h_Brq_def : B_rq = H_Jq + b_star + ∑ j : Fin N_J, π_q j * subclassProxyA ε (menu j) := rfl

  linarith only [h_A', h_B', h_7', h_sum_split, h_proxy_eq, h_Brq_def, h_log_err,
    hA_log_le, hθ_erep, h64_err, hlog_S_loc, he_rep]

theorem finite_entropy_cut_and_credit_repayment (γ : ℝ) (hγ₀ : 0 < γ) (hγ₁ : γ < 1)
    (h_cl : ClassicalLineGrowthBound γ)
    (h_gt : γ / 2 < quantumPacketRate γ)
    (hβ_pos : 0 < quantumPacketRate γ) (hβ_le : quantumPacketRate γ ≤ 1)
    (M_atom : ℝ → ℝ → ℝ → ℝ → ℝ → ℕ → ℝ)
    (h_resc : LocalPhaseRescalingValid)
    (h_mod : UniformPacketGrowthModulus γ (quantumPacketRate γ))
    (h_cut : PacketCutDecompositionValid M_atom)
    (h_coh : CoherentStripMassBoundValid) :
    ∃ (C_star C_cell : ℝ), 2 ≤ C_star ∧ 2 ≤ C_cell ∧
      (∀ (ν κ t₀ h α_cap δ_out : ℝ),
        0 < ν → 0 < κ → 0 < t₀ → t₀ ≤ min (ν / 2) (1 / 8) →
        0 < h → h ≤ t₀ / 4 → C_star * h < γ * (ν / 4) → 0 < α_cap → 0 < δ_out →
        ∃ Δ_in : ℝ, 0 < Δ_in ∧
          ∀ cls : PacketBoundClass,
            ∃ ε_init : ℝ, 0 < ε_init ∧ ε_init < 1 / 2 ∧
              ∀ (ε H_P L lam_sys : ℝ) (m_init : ℕ)
                (Φ₀ : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → ℝ)
                (ζ₀ : EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → EuclideanSpace ℝ (Fin 2))
                (f : EuclideanSpace ℝ (Fin 2) → ℂ)
                (N_O N_D : ℕ) (r_O : Fin N_O → ℕ) (V_O X_O : Fin N_O → EuclideanSpace ℝ (Fin 2))
                (ψ_O : Fin N_O → EuclideanSpace ℝ (Fin 2) → ℂ) (b_D a_D : Fin N_D → ℝ)
                (r_D : Fin N_D → ℕ) (e_D V_D X_D : Fin N_D → EuclideanSpace ℝ (Fin 2))
                (p : Fin N_O → Fin N_D → ℝ),
                ε < ε_init → 1 ≤ H_P → 1 ≤ L →
                IsValidPacketEnv cls ε H_P L lam_sys Φ₀ ζ₀ f →
                cls.B_sys⁻¹ * ε ^ (1 : ℝ) ≤ ((2 : ℝ) ^ m_init)⁻¹ →
                ((2 : ℝ) ^ m_init)⁻¹ ≤ cls.B_sys * ε ^ (1 : ℝ) →
                IsAdmissiblePacketLaw ε H_P L 1 cls.B_sys cls.R_win cls.N_mult cls.M_win
                  lam_sys m_init Φ₀ f N_O N_D r_O V_O X_O ψ_O b_D a_D r_D e_D V_D X_D p →
                generalPacketRootScore ε H_P L cls.R_dom γ lam_sys Φ₀ f +
                  quantumPacketRate γ - Δ_in ≤
                  generalPacketScore ε γ H_P 1 lam_sys m_init Φ₀ f
                    N_O N_D r_O V_O X_O ψ_O b_D a_D p →
                HasRootWidthGap ν κ ε H_P L cls.R_dom γ lam_sys Φ₀ f →
                IsCutChainState γ (nextPacketClass M_atom cls) ε H_P L t₀ h lam_sys
                  C_cell 1 Φ₀ f δ_out 0 α_cap) ∧
      (∀ (ν κ t h ε_err δ_out : ℝ),
        0 < ν → 0 < κ → 0 < h → 2 * h < t → t ≤ min (ν / 2) (1 / 8) →
        C_star * h < γ * (ν / 4) → 0 < ε_err → ε_err ≤ 1 → 0 < δ_out →
        let α_cap := (ε_err * h) / (8 * C_star)
        ∃ δ_in : ℝ, 0 < δ_in ∧
          ∀ cls : PacketBoundClass,
            ∃ ε_step : ℝ, 0 < ε_step ∧ ε_step < 1 / 2 ∧
              ∀ (ε H_P L lam_sys : ℝ)
                (Φ₀ : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → ℝ)
                (ζ₀ : EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → EuclideanSpace ℝ (Fin 2))
                (f : EuclideanSpace ℝ (Fin 2) → ℂ) (k_f : ℝ),
                ε < ε_step → 1 ≤ H_P → 1 ≤ L →
                IsValidPacketEnv cls ε H_P L lam_sys Φ₀ ζ₀ f →
                HasRootWidthGap ν κ ε H_P L cls.R_dom γ lam_sys Φ₀ f →
                0 ≤ k_f → k_f ≤ (1 + ε_err) * h →
                IsCutChainState γ cls ε H_P L t h lam_sys C_cell 1 Φ₀ f δ_in k_f α_cap →
                ∃ k_next : ℝ,
                  0 ≤ k_next ∧ k_next ≤ (1 + ε_err) * h ∧
                  k_f + (4 * quantumPacketRate γ - 2 * γ - ε_err) * h ≤ k_next ∧
                  IsCutChainState γ (nextPacketClass M_atom cls) ε H_P L (t - 2 * h) h lam_sys
                    C_cell 1 Φ₀ f δ_out k_next α_cap) ∧
      (∀ (h α_cap δ_out : ℝ),
        0 < h → h ≤ 1 / 32 → 0 < α_cap → 0 < δ_out →
        ∃ (ν_init κ_init : ℝ), 0 < ν_init ∧ 0 < κ_init ∧
          ∀ τ_no : ℝ, 0 < τ_no →
            ∃ Δ_in : ℝ, 0 < Δ_in ∧
              ∀ cls : PacketBoundClass,
                ∃ ε_init : ℝ, 0 < ε_init ∧ ε_init < 1 / 2 ∧
                  ∀ (ε H_P L lam_sys : ℝ) (m_init : ℕ)
                    (Φ₀ : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → ℝ)
                    (ζ₀ : EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → EuclideanSpace ℝ (Fin 2))
                    (f : EuclideanSpace ℝ (Fin 2) → ℂ)
                    (N_O N_D : ℕ) (r_O : Fin N_O → ℕ) (V_O X_O : Fin N_O → EuclideanSpace ℝ (Fin 2))
                    (ψ_O : Fin N_O → EuclideanSpace ℝ (Fin 2) → ℂ) (b_D a_D : Fin N_D → ℝ)
                    (r_D : Fin N_D → ℕ) (e_D V_D X_D : Fin N_D → EuclideanSpace ℝ (Fin 2))
                    (p : Fin N_O → Fin N_D → ℝ),
                    ε < ε_init → 1 ≤ H_P → 1 ≤ L →
                    IsValidPacketEnv cls ε H_P L lam_sys Φ₀ ζ₀ f →
                    LocalNonForcedAtScale γ (localRescaledClass cls (7 / 8))
                      (7 / 8) ν_init κ_init τ_no ε →
                    cls.B_sys⁻¹ * ε ^ (1 : ℝ) ≤ ((2 : ℝ) ^ m_init)⁻¹ →
                    ((2 : ℝ) ^ m_init)⁻¹ ≤ cls.B_sys * ε ^ (1 : ℝ) →
                    IsAdmissiblePacketLaw ε H_P L 1 cls.B_sys cls.R_win cls.N_mult cls.M_win
                      lam_sys m_init Φ₀ f N_O N_D r_O V_O X_O ψ_O b_D a_D r_D e_D V_D X_D p →
                    generalPacketRootScore ε H_P L cls.R_dom γ lam_sys Φ₀ f +
                      quantumPacketRate γ - Δ_in ≤
                      generalPacketScore ε γ H_P 1 lam_sys m_init Φ₀ f
                        N_O N_D r_O V_O X_O ψ_O b_D a_D p →
                    (H_P - 1) / 2 - 1 / 16 ≤ L - 1 ∧
                    IsCutChainState γ (nextPacketClass M_atom cls) ε H_P L (1 / 8) h lam_sys
                      C_cell 2 Φ₀ f δ_out 0 α_cap) ∧
      (∀ (t h ε_err δ_out : ℝ),
        0 < h → 2 * h < t → t ≤ 1 / 8 → 0 < ε_err → ε_err ≤ 1 → 0 < δ_out →
        let α_cap := (ε_err * h) / (8 * C_star)
        ∃ (ν_loc κ_loc : ℝ), 0 < ν_loc ∧ 0 < κ_loc ∧
          ∀ τ_no : ℝ, 0 < τ_no →
            ∃ δ_in : ℝ, 0 < δ_in ∧
              ∀ cls : PacketBoundClass,
                ∃ ε_step : ℝ, 0 < ε_step ∧ ε_step < 1 / 2 ∧
                  ∀ (ε H_P L lam_sys : ℝ)
                    (Φ₀ : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → ℝ)
                    (ζ₀ : EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → EuclideanSpace ℝ (Fin 2))
                    (f : EuclideanSpace ℝ (Fin 2) → ℂ) (k_f : ℝ),
                    ε < ε_step → 1 ≤ H_P → 1 ≤ L → (H_P - 1) / 2 - 1 / 16 ≤ L - 1 →
                    IsValidPacketEnv cls ε H_P L lam_sys Φ₀ ζ₀ f →
                    LocalNonForcedAtScale γ (localRescaledClass cls (2 * h))
                      (2 * h) ν_loc κ_loc τ_no ε →
                    0 ≤ k_f → k_f ≤ (2 + ε_err) * h →
                    IsCutChainState γ cls ε H_P L t h lam_sys C_cell 2 Φ₀ f δ_in k_f α_cap →
                    ∃ k_next : ℝ,
                      0 ≤ k_next ∧ k_next ≤ (2 + ε_err) * h ∧
                      k_f + (4 * quantumPacketRate γ - 2 * γ - ε_err) * h ≤ k_next ∧
                      IsCutChainState γ (nextPacketClass M_atom cls) ε H_P L (t - 2 * h) h lam_sys
                        C_cell 2 Φ₀ f δ_out k_next α_cap) :=
by
  letI := Classical.propDecidable
  obtain ⟨_, h_s1_norm, h_s1_prep, h_s1_buf, h_s1_pred⟩ :=
    endpoint_norm_prep_and_normal_prediction γ hγ₀ hγ₁ h_mod
  have h_s2 := greedy_cap_menu_and_packet_composition γ hγ₀ hγ₁ hβ_pos hβ_le
    M_atom h_resc h_mod h_cut
  obtain ⟨h_s4_slk, h_s4_al⟩ :=
    single_localizer_slack_and_alignment_exclusion γ hγ₀ hγ₁ hβ_pos
      M_atom h_cl h_resc h_coh
  have h_s5 := candidate_coherence_and_credit_repayment γ hγ₀ hγ₁
    M_atom h_cl h_resc h_coh

  let u_vec : EuclideanSpace ℝ (Fin 2) := PiLp.single 2 (0 : Fin 2) (1 : ℝ)
  have hu_vec : ‖u_vec‖ = 1 := by
    dsimp [u_vec]
    rw [PiLp.norm_single, norm_one]
  let n_dummy : (ℕ × (ℤ × ℤ) × (ℤ × ℤ)) → EuclideanSpace ℝ (Fin 2) := fun _ => u_vec
  have hn_dummy : ∀ p_c, ‖n_dummy p_c‖ = 1 := fun _ => hu_vec

  have h_ell_pos : ∀ {ε : ℝ}, 0 < ε → ε < 1 / 2 → 0 < Real.log (ε⁻¹) := by
    intro ε hε₀ hε₁
    apply Real.log_pos
    rw [one_lt_inv₀ hε₀]
    linarith

  have h_floor_step : ∀ {ε r : ℝ}, 0 < ε → ε < 1 / 2 → 0 < r →
      let m_r := Nat.floor (r * Real.log (ε⁻¹) / Real.log 2)
      ε ^ r ≤ ((2 : ℝ) ^ m_r)⁻¹ ∧ ((2 : ℝ) ^ m_r)⁻¹ ≤ 2 * ε ^ r := by
    intro ε r hε₀ hε₁ hr m_r
    have hell : 0 < Real.log (ε⁻¹) := h_ell_pos hε₀ hε₁
    have hlog2 : 0 < Real.log 2 := Real.log_pos (by norm_num)
    let x : ℝ := r * Real.log (ε⁻¹) / Real.log 2
    have hx_nn : 0 ≤ x := div_nonneg (mul_nonneg hr.le hell.le) hlog2.le
    have h2x : (2 : ℝ) ^ x = (ε ^ r)⁻¹ := by
      rw [Real.rpow_def_of_pos (by norm_num : (0 : ℝ) < 2)]
      have hmul : Real.log 2 * x = Real.log (ε⁻¹) * r := by
        dsimp only [x]
        rw [mul_div_cancel₀ _ hlog2.ne', mul_comm]
      rw [hmul, ← Real.rpow_def_of_pos (inv_pos.mpr hε₀), Real.inv_rpow hε₀.le]
    have hfl_le : (m_r : ℝ) ≤ x := Nat.floor_le hx_nn
    have hlt_fl : x < (m_r : ℝ) + 1 := Nat.lt_floor_add_one x
    have hpow_mr : ((2 : ℝ) ^ m_r : ℝ) = (2 : ℝ) ^ (m_r : ℝ) := (Real.rpow_natCast 2 m_r).symm
    have hεr_pos : 0 < ε ^ r := Real.rpow_pos_of_pos hε₀ r
    have h2mr_pos : (0 : ℝ) < (2 : ℝ) ^ m_r := by positivity
    constructor
    · have h1 : ((2 : ℝ) ^ m_r : ℝ) ≤ (ε ^ r)⁻¹ := by
        rw [hpow_mr, ← h2x]
        exact Real.rpow_le_rpow_of_exponent_le (by norm_num) hfl_le
      exact (le_inv_comm₀ hεr_pos h2mr_pos).mpr h1
    · have h2 : (ε ^ r)⁻¹ < 2 * ((2 : ℝ) ^ m_r : ℝ) := by
        calc (ε ^ r)⁻¹ = (2 : ℝ) ^ x := h2x.symm
          _ < (2 : ℝ) ^ ((m_r : ℝ) + 1) := Real.rpow_lt_rpow_of_exponent_lt (by norm_num) hlt_fl
          _ = (2 : ℝ) ^ (m_r : ℝ) * (2 : ℝ) ^ (1 : ℝ) := Real.rpow_add (by norm_num) _ _
          _ = 2 * ((2 : ℝ) ^ m_r : ℝ) := by rw [Real.rpow_one, ← hpow_mr]; ring
      have h3 : (2 * ((2 : ℝ) ^ m_r : ℝ))⁻¹ ≤ ε ^ r := by
        have hlt := (inv_lt_inv₀ (by positivity) (inv_pos.mpr hεr_pos)).mpr h2
        rw [inv_inv] at hlt
        exact hlt.le
      calc ((2 : ℝ) ^ m_r)⁻¹ = 2 * (2 * ((2 : ℝ) ^ m_r : ℝ))⁻¹ := by
            rw [mul_inv, ← mul_assoc, mul_inv_cancel₀ two_ne_zero, one_mul]
        _ ≤ 2 * ε ^ r := mul_le_mul_of_nonneg_left h3 (by norm_num)

  have h_mr_le_mt_floor : ∀ {ε r t : ℝ}, 0 < ε → ε < 1 / 2 → r ≤ t →
      Nat.floor (r * Real.log (ε⁻¹) / Real.log 2) ≤
        Nat.floor (t * Real.log (ε⁻¹) / Real.log 2) := by
    intro ε r t hε₀ hε₁ hrt
    have hell : 0 ≤ Real.log (ε⁻¹) := (h_ell_pos hε₀ hε₁).le
    have hlog2 : 0 ≤ (Real.log 2)⁻¹ := inv_nonneg.mpr (Real.log_pos (by norm_num)).le
    apply Nat.floor_mono
    simp only [div_eq_mul_inv]
    exact mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right hrt hell) hlog2

  have h_mr_le_mt_bound : ∀ {ε r t d B : ℝ} {m_t : ℕ},
      0 < ε → ε < 1 / 2 → 0 < r → 0 < d → d ≤ t - r → 1 ≤ B →
      ε < ((2 * B)⁻¹) ^ (d⁻¹) → ((2 : ℝ) ^ m_t)⁻¹ ≤ B * ε ^ t →
      Nat.floor (r * Real.log (ε⁻¹) / Real.log 2) ≤ m_t := by
    intro ε r t d B m_t hε₀ hε₁ hr hd hdrt hB hε_lt hmt
    let m_r := Nat.floor (r * Real.log (ε⁻¹) / Real.log 2)
    have hfl := (h_floor_step hε₀ hε₁ hr).1
    have h2B_pos : 0 < (2 * B)⁻¹ := by positivity
    have h_ed : ε ^ d < (2 * B)⁻¹ := by
      have h1 := Real.rpow_lt_rpow hε₀.le hε_lt hd
      rwa [← Real.rpow_mul h2B_pos.le, inv_mul_cancel₀ hd.ne', Real.rpow_one] at h1
    have h_etr : ε ^ (t - r) ≤ ε ^ d :=
      Real.rpow_le_rpow_of_exponent_ge hε₀ (by linarith) hdrt
    have h_εr_pos : 0 < ε ^ r := Real.rpow_pos_of_pos hε₀ r
    have h_Bt : B * ε ^ t < ε ^ r := by
      have ht_eq : ε ^ t = ε ^ (t - r) * ε ^ r := by rw [← Real.rpow_add hε₀]; ring_nf
      rw [ht_eq]
      have h_prod : B * ε ^ (t - r) < 1 / 2 := by
        have hle : B * ε ^ (t - r) ≤ B * ε ^ d := mul_le_mul_of_nonneg_left h_etr (by linarith)
        have hlt : B * ε ^ d < B * (2 * B)⁻¹ := mul_lt_mul_of_pos_left h_ed (by linarith)
        have heq : B * (2 * B)⁻¹ = 1 / 2 := by
          have hB0 : B ≠ 0 := by linarith
          rw [mul_inv, mul_comm (2 : ℝ)⁻¹, ← mul_assoc, mul_inv_cancel₀ hB0, one_mul]
          norm_num
        linarith
      nlinarith
    have h_pow_lt : ((2 : ℝ) ^ m_t)⁻¹ < ((2 : ℝ) ^ m_r)⁻¹ :=
      lt_of_le_of_lt hmt (lt_of_lt_of_le h_Bt hfl)
    have h2mr : ((2 : ℝ) ^ m_r : ℝ) < ((2 : ℝ) ^ m_t : ℝ) :=
      (inv_lt_inv₀ (by positivity) (by positivity)).mp h_pow_lt
    by_contra hnot
    have hge : m_t ≤ m_r := (Nat.lt_of_not_le hnot).le
    have hle_pow : ((2 : ℝ) ^ m_t : ℝ) ≤ ((2 : ℝ) ^ m_r : ℝ) := by
      exact_mod_cast Nat.pow_le_pow_right Nat.zero_lt_two hge
    linarith

  have h_log_div_ell : ∀ {ε A δ : ℝ}, 0 < ε → ε < 1 / 2 → 0 < δ →
      ε < (Real.exp ((A + 1) / δ))⁻¹ → A / Real.log (ε⁻¹) ≤ δ := by
    intro ε A δ hε₀ hε₁ hδ hε_lt
    have hell : 0 < Real.log (ε⁻¹) := h_ell_pos hε₀ hε₁
    have hexp_pos : 0 < Real.exp ((A + 1) / δ) := Real.exp_pos _
    have h_inv : Real.exp ((A + 1) / δ) < ε⁻¹ := (lt_inv_comm₀ hε₀ hexp_pos).mp hε_lt
    have h_log : (A + 1) / δ < Real.log (ε⁻¹) := by
      have h1 := Real.log_lt_log hexp_pos h_inv
      rwa [Real.log_exp] at h1
    rw [div_le_iff₀ hell]
    have h2 := (div_lt_iff₀ hδ).mp h_log
    linarith

  have h_rpow_le_half : ∀ {ε ζ : ℝ}, 0 < ε → 0 < ζ →
      ε < (1 / 2 : ℝ) ^ (ζ⁻¹) → ε ^ ζ ≤ 1 / 2 := by
    intro ε ζ hε₀ hζ hε_lt
    have h1 := Real.rpow_lt_rpow hε₀.le hε_lt hζ
    rw [← Real.rpow_mul (by norm_num : (0 : ℝ) ≤ 1 / 2), inv_mul_cancel₀ hζ.ne',
      Real.rpow_one] at h1
    exact h1.le

  have h_win_floor : ∀ {ε A₀ m_sub : ℝ} {S : ℕ},
      0 < ε → ε < 1 / 4 → 1 ≤ S →
      Real.log (S : ℝ) / Real.log (ε⁻¹) ≤ 1 / 2 →
      ε ^ A₀ ≤ 4 * ((S : ℝ) ^ 2) * m_sub →
      ε ^ (A₀ + 2) ≤ m_sub := by
    intro ε A₀ m_sub S hε₀ hε₁ hS hlogS hm
    have hell : 0 < Real.log (ε⁻¹) := h_ell_pos hε₀ (by linarith)
    have hS_pos : (0 : ℝ) < (S : ℝ) := by exact_mod_cast (Nat.lt_of_lt_of_le Nat.zero_lt_one hS)
    have h_le1 : Real.log (S : ℝ) ≤ Real.log ((ε⁻¹) ^ ((1 : ℝ) / 2)) := by
      rw [Real.log_rpow (inv_pos.mpr hε₀)]
      have h1 := (div_le_iff₀ hell).mp hlogS
      linarith
    have hS_le : (S : ℝ) ≤ (ε⁻¹) ^ ((1 : ℝ) / 2) :=
      (Real.log_le_log_iff hS_pos (Real.rpow_pos_of_pos (inv_pos.mpr hε₀) _)).mp h_le1
    have hS_sq : (S : ℝ) ^ 2 ≤ ε⁻¹ := by
      have hsq : ((S : ℝ) ^ 2) = (S : ℝ) * (S : ℝ) := sq _
      have h_rpow_sq : (ε⁻¹) ^ ((1 : ℝ) / 2) * (ε⁻¹) ^ ((1 : ℝ) / 2) = ε⁻¹ := by
        rw [← Real.rpow_add (inv_pos.mpr hε₀)]; norm_num
      rw [hsq, ← h_rpow_sq]
      exact mul_le_mul hS_le hS_le hS_pos.le (Real.rpow_nonneg (inv_pos.mpr hε₀).le _)
    have h4_le : (4 : ℝ) ≤ ε⁻¹ := by rw [le_inv_comm₀ (by norm_num) hε₀]; linarith
    have h_prod : 4 * ((S : ℝ) ^ 2) ≤ (ε⁻¹) ^ 2 := by
      calc 4 * ((S : ℝ) ^ 2) ≤ ε⁻¹ * ε⁻¹ :=
            mul_le_mul h4_le hS_sq (sq_nonneg _) (inv_pos.mpr hε₀).le
        _ = (ε⁻¹) ^ 2 := (sq _).symm
    have hm_nn : 0 ≤ m_sub := by
      have hA_pos : 0 < ε ^ A₀ := Real.rpow_pos_of_pos hε₀ A₀
      have h4S_pos : 0 < 4 * ((S : ℝ) ^ 2) := by positivity
      nlinarith
    have h_step : ε ^ A₀ ≤ (ε⁻¹) ^ 2 * m_sub :=
      le_trans hm (mul_le_mul_of_nonneg_right h_prod hm_nn)
    calc ε ^ (A₀ + 2) = ε ^ A₀ * ε ^ (2 : ℝ) := Real.rpow_add hε₀ A₀ 2
      _ = ε ^ A₀ * (ε ^ 2) := by rw [Real.rpow_two]
      _ ≤ ((ε⁻¹) ^ 2 * m_sub) * (ε ^ 2) := mul_le_mul_of_nonneg_right h_step (sq_nonneg _)
      _ = m_sub := by
        rw [inv_pow, mul_comm ((ε ^ 2)⁻¹) m_sub, mul_assoc,
          inv_mul_cancel₀ (pow_ne_zero 2 hε₀.ne'), mul_one]

  have h_pi_sum : ∀ {N_O N_D N_J : ℕ} (p : Fin N_O → Fin N_D → ℝ)
      (win_of : Fin N_O → Fin N_J),
      (∀ o d, 0 ≤ p o d) → (∑ o : Fin N_O, ∑ d : Fin N_D, p o d = 1) →
      let π_J := fun j : Fin N_J =>
        ∑ o ∈ Finset.univ.filter (fun o => win_of o = j), ∑ d : Fin N_D, p o d
      (∀ j, 0 ≤ π_J j) ∧ (∑ j : Fin N_J, π_J j = 1) ∧
      (∀ (Q : Fin N_J → Prop),
        (∑ o : Fin N_O, ∑ d : Fin N_D, if Q (win_of o) then p o d else 0) =
        ∑ j : Fin N_J, if Q j then π_J j else 0) := by
    intro N_O N_D N_J p win_of hp_nn hp_sum π_J
    refine ⟨?_, ?_, ?_⟩
    · intro j
      exact Finset.sum_nonneg (fun o _ => Finset.sum_nonneg (fun d _ => hp_nn o d))
    · dsimp [π_J]
      rw [Finset.sum_fiberwise Finset.univ win_of (fun o => ∑ d : Fin N_D, p o d)]
      exact hp_sum
    · intro Q
      have h1 : ∀ o : Fin N_O,
          (∑ d : Fin N_D, if Q (win_of o) then p o d else 0) =
          if Q (win_of o) then (∑ d : Fin N_D, p o d) else 0 := by
        intro o; split_ifs <;> simp
      simp_rw [h1]
      rw [← Finset.sum_fiberwise Finset.univ win_of
        (fun o => if Q (win_of o) then (∑ d : Fin N_D, p o d) else 0)]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      by_cases hQ : Q j
      · simp only [hQ, ↓reduceIte]
        refine Finset.sum_congr rfl (fun o ho => ?_)
        rw [Finset.mem_filter] at ho
        simp [ho.2, hQ]
      · simp only [hQ, ↓reduceIte]
        refine Finset.sum_eq_zero (fun o ho => ?_)
        rw [Finset.mem_filter] at ho
        simp [ho.2, hQ]

  have h_markov_compl : ∀ {N_J : ℕ} (π_J cost : Fin N_J → ℝ) (Q : Fin N_J → Prop)
      {B_tot thr : ℝ},
      (∀ j, 0 ≤ π_J j) → (∑ j : Fin N_J, π_J j = 1) →
      (∀ j, 0 < π_J j → 0 ≤ cost j) →
      (∑ j : Fin N_J, π_J j * cost j ≤ B_tot) →
      0 < thr → (∀ j, 0 < π_J j → ¬ Q j → thr ≤ cost j) →
      1 - B_tot / thr ≤ ∑ j : Fin N_J, if Q j then π_J j else 0 := by
    intro N_J π_J cost Q B_tot thr hπ_nn hπ_sum hcost_nn hcost_sum hthr hbad
    have h_bad_bound : thr * (∑ j : Fin N_J, if ¬ Q j then π_J j else 0) ≤ B_tot := by
      rw [Finset.mul_sum]
      refine le_trans ?_ hcost_sum
      refine Finset.sum_le_sum (fun j _ => ?_)
      by_cases hπ0 : π_J j = 0
      · simp [hπ0]
      · have hπ_pos : 0 < π_J j := lt_of_le_of_ne (hπ_nn j) (Ne.symm hπ0)
        by_cases hQj : Q j
        · simp only [hQj, not_true_eq_false, ↓reduceIte, mul_zero]
          exact mul_nonneg hπ_pos.le (hcost_nn j hπ_pos)
        · simp only [hQj, not_false_eq_true, ↓reduceIte]
          have h1 := mul_le_mul_of_nonneg_left (hbad j hπ_pos hQj) hπ_pos.le
          linarith
    have h_div : (∑ j : Fin N_J, if ¬ Q j then π_J j else 0) ≤ B_tot / thr := by
      rw [le_div_iff₀ hthr]; linarith
    have h_split : (∑ j : Fin N_J, if Q j then π_J j else 0) +
        (∑ j : Fin N_J, if ¬ Q j then π_J j else 0) = 1 := by
      rw [← Finset.sum_add_distrib, ← hπ_sum]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      by_cases hQj : Q j <;> simp [hQj]
    linarith

  have h_exists_active : ∀ {N_O N_D : ℕ} (p : Fin N_O → Fin N_D → ℝ),
      (∀ o d, 0 ≤ p o d) → (∑ o : Fin N_O, ∑ d : Fin N_D, p o d = 1) →
      1 ≤ N_O ∧ ∃ (o : Fin N_O) (d : Fin N_D), 0 < p o d := by
    intro N_O N_D p hp_nn hp_sum
    have hex : ∃ (o : Fin N_O) (d : Fin N_D), 0 < p o d := by
      by_contra hall
      push Not at hall
      have hzero : ∑ o : Fin N_O, ∑ d : Fin N_D, p o d = 0 := by
        refine Finset.sum_eq_zero (fun o _ => Finset.sum_eq_zero (fun d _ => ?_))
        exact le_antisymm (hall o d) (hp_nn o d)
      linarith
    rcases hex with ⟨o₀, d₀, hpos⟩
    exact ⟨Nat.succ_le_of_lt o₀.pos, o₀, d₀, hpos⟩

  have h_cond_adm : ∀ {ε H_P L t B_sys R_win : ℝ} {N_mult : ℕ} {M_win : ℕ → ℝ}
      {lam_sys : ℝ} {m_t : ℕ}
      {Φ₀ : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → ℝ}
      {f : EuclideanSpace ℝ (Fin 2) → ℂ}
      {N_O N_D N_J : ℕ}
      {r_O : Fin N_O → ℕ} {V_O X_O : Fin N_O → EuclideanSpace ℝ (Fin 2)}
      {ψ_O : Fin N_O → EuclideanSpace ℝ (Fin 2) → ℂ} {b_D a_D : Fin N_D → ℝ}
      {r_D : Fin N_D → ℕ} {e_D V_D X_D : Fin N_D → EuclideanSpace ℝ (Fin 2)}
      {p : Fin N_O → Fin N_D → ℝ} (win_of : Fin N_O → Fin N_J) (j : Fin N_J),
      IsAdmissiblePacketLaw ε H_P L t B_sys R_win N_mult M_win lam_sys m_t Φ₀ f
        N_O N_D r_O V_O X_O ψ_O b_D a_D r_D e_D V_D X_D p →
      let π_J := ∑ o ∈ Finset.univ.filter (fun o => win_of o = j), ∑ d : Fin N_D, p o d
      0 < π_J →
      let p_c := fun o d => if win_of o = j ∧ 0 < π_J then p o d / π_J else 0
      IsAdmissiblePacketLaw ε H_P L t B_sys R_win N_mult M_win lam_sys m_t Φ₀ f
        N_O N_D r_O V_O X_O ψ_O b_D a_D r_D e_D V_D X_D p_c ∧
      (∀ o d, 0 < p_c o d → win_of o = j ∧ 0 < p o d) := by
    intro ε H_P L t B_sys R_win N_mult M_win lam_sys m_t Φ₀ f N_O N_D N_J
      r_O V_O X_O ψ_O b_D a_D r_D e_D V_D X_D p win_of j hadm π_J hπ_pos p_c
    obtain ⟨h1, h2, h3, h4, h5, h6, h7, _, h9⟩ := hadm
    have hsupp : ∀ o d, 0 < p_c o d → win_of o = j ∧ 0 < p o d := by
      intro o d hpc
      dsimp [p_c] at hpc
      by_cases hw : win_of o = j
      · simp only [hw, hπ_pos, and_self, ↓reduceIte] at hpc
        exact ⟨hw, (div_pos_iff_of_pos_right hπ_pos).mp hpc⟩
      · simp [hw] at hpc
    refine ⟨⟨h1, h2, h3, h4, h5, h6, ?_, ?_, ?_⟩, hsupp⟩
    · intro o d
      dsimp [p_c]
      split_ifs
      · exact div_nonneg (h7 o d) hπ_pos.le
      · exact le_rfl
    · have hsum_eq : (∑ o : Fin N_O, ∑ d : Fin N_D, p_c o d) =
          (∑ o ∈ Finset.univ.filter (fun o => win_of o = j), ∑ d : Fin N_D, p o d) / π_J := by
        rw [Finset.sum_div]
        have h_flt : (∑ o ∈ Finset.univ.filter (fun o => win_of o = j),
            (∑ d : Fin N_D, p o d) / π_J) =
          ∑ o : Fin N_O, if win_of o = j then (∑ d : Fin N_D, p o d) / π_J else 0 := by
          rw [Finset.sum_filter]
        rw [h_flt]
        refine Finset.sum_congr rfl (fun o _ => ?_)
        by_cases hw : win_of o = j
        · simp [p_c, hw, hπ_pos, Finset.sum_div]
        · simp [p_c, hw]
      rw [hsum_eq]
      exact div_self hπ_pos.ne'
    · intro o d hpc
      exact h9 o d (hsupp o d hpc).2

  have h_credit_mono : ∀ {ε H_P t h C_c : ℝ} {d_dim N_O N_D : ℕ}
      {r_O : Fin N_O → ℕ} {V_O X_O : Fin N_O → EuclideanSpace ℝ (Fin 2)}
      {e_D : Fin N_D → EuclideanSpace ℝ (Fin 2)} {p : Fin N_O → Fin N_D → ℝ}
      {k_f α₁ α₂ : ℝ},
      0 < ε → ε < 1 / 2 → (∀ o d, 0 ≤ p o d) → α₁ ≤ α₂ →
      HasIncomingCredit ε H_P t h C_c d_dim N_O N_D r_O V_O X_O e_D p k_f α₁ →
      HasIncomingCredit ε H_P t h C_c d_dim N_O N_D r_O V_O X_O e_D p k_f α₂ := by
    intro ε H_P t h C_c d_dim N_O N_D r_O V_O X_O e_D p k_f α₁ α₂ hε₀ hε₁ hp_nn hle hcred
    rcases hcred with hk0 | ⟨hk_pos, L_g, τ_V, τ_X, P_f, n_f, W_f, hL1, hL2, hnf, hgeom, hal, hprob⟩
    · exact Or.inl hk0
    · refine Or.inr ⟨hk_pos, L_g, τ_V, τ_X, P_f, n_f, W_f, hL1, hL2, hnf, hgeom, hal, ?_⟩
      intro p_c w
      have hrpow : ε ^ (k_f - α₁) ≤ ε ^ (k_f - α₂) :=
        Real.rpow_le_rpow_of_exponent_ge hε₀ (by linarith only [hε₁]) (by linarith only [hle])
      have hsum_nn : 0 ≤ ∑ o ∈ Finset.univ.filter (fun o => P_f o = p_c), ∑ d : Fin N_D, p o d :=
        Finset.sum_nonneg (fun o _ => Finset.sum_nonneg (fun d _ => hp_nn o d))
      exact le_trans (hprob p_c w) (mul_le_mul_of_nonneg_right hrpow hsum_nn)

  have h_site_geom : ∀ {ε H_P L t B_sys R_win : ℝ} {N_mult : ℕ} {M_win : ℕ → ℝ}
      {lam_sys A₀ : ℝ} {m_t : ℕ}
      {Φ₀ : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → ℝ}
      {f : EuclideanSpace ℝ (Fin 2) → ℂ}
      {N_O N_D : ℕ}
      {r_O : Fin N_O → ℕ} {V_O X_O : Fin N_O → EuclideanSpace ℝ (Fin 2)}
      {ψ_O : Fin N_O → EuclideanSpace ℝ (Fin 2) → ℂ} {b_D a_D : Fin N_D → ℝ}
      {r_D : Fin N_D → ℕ} {e_D V_D X_D : Fin N_D → EuclideanSpace ℝ (Fin 2)}
      {p : Fin N_O → Fin N_D → ℝ},
      IsAdmissiblePacketLaw ε H_P L t B_sys R_win N_mult M_win lam_sys m_t Φ₀ f
        N_O N_D r_O V_O X_O ψ_O b_D a_D r_D e_D V_D X_D p →
      (∀ o : Fin N_O, ε ^ A₀ ≤ generalPacketObsMass ε H_P t lam_sys m_t Φ₀ f
        (r_O o) (V_O o) (X_O o) (ψ_O o)) →
      (∀ o : Fin N_O, r_O o < 2 ^ m_t ∧ ‖V_O o‖ ≤ B_sys ∧ ‖X_O o‖ ≤ B_sys ∧
        (∀ k : ℕ, ContDiff ℝ k (ψ_O o)) ∧
        (∀ z, R_win ≤ ‖z‖ → ψ_O o z = 0) ∧
        (∀ k z, ‖iteratedFDeriv ℝ k (ψ_O o) z‖ ≤ M_win k) ∧
        ε ^ A₀ ≤ generalPacketObsMass ε H_P t lam_sys m_t Φ₀ f
          (r_O o) (V_O o) (X_O o) (ψ_O o)) ∧
      (∀ (r_i : ℕ) (v₀ x₀ : EuclideanSpace ℝ (Fin 2)),
        ((Finset.univ.filter (fun o : Fin N_O =>
          r_O o = r_i ∧ ‖V_O o - v₀‖ ≤ ε ^ ((H_P - t) / 2) ∧
            ‖X_O o - x₀‖ ≤ (lam_sys * ε ^ ((H_P - t) / 2))⁻¹)).card : ℝ) ≤
          (N_mult : ℝ)) := by
    intro ε H_P L t B_sys R_win N_mult M_win lam_sys A₀ m_t Φ₀ f N_O N_D
      r_O V_O X_O ψ_O b_D a_D r_D e_D V_D X_D p hadm hfl
    obtain ⟨h1, h2, h3, h4, h5, _⟩ := hadm
    refine ⟨fun o => ⟨(h1 o).1, (h1 o).2.1, (h1 o).2.2, h2 o, h3 o, h4 o, hfl o⟩,
