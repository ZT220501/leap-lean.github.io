        exact Finset.mem_Icc.mpr ⟨by exact_mod_cast hlo, by exact_mod_cast hhi⟩
      dsimp only [S_kang]
      rcases hs_mem with rfl | rfl | rfl
      · exact Finset.mem_union_left _ (Finset.mem_union_left _ h_in_s)
      · exact Finset.mem_union_left _ (Finset.mem_union_right _ h_in_s)
      · exact Finset.mem_union_right _ h_in_s
    · 
      rintro ⟨hGstd_eq, hkr_eq⟩
      dsimp only [stdApertureObs] at hGstd_eq
      rw [h_ab_mu, h_au_1m] at hGstd_eq
      simp only [Prod.mk.injEq] at hGstd_eq
      obtain ⟨hkc_eq, hkang_eq, hVp_eq, hVperp_eq, hPp_eq, hPperp_eq⟩ := hGstd_eq
      have hCu_eq : dyadicTimeMid ε u c₂ = C_u1 := by
