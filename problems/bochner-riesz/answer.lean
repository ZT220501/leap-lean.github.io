          calc μ_child a * lam b
              ≤ (4 * M_keep * (∑ b', q a b')) * (4 * M_keep * (∑ a', q a' b)) :=
                mul_le_mul hμA_le hμB_le (hlam_nn b) (by positivity)
            _ = (16 * M_keep * (∑ b', q a b') * (∑ a', q a' b)) * M_keep := by ring
            _ ≤ (16 * M_keep * (∑ b', q a b') * (∑ a', q a' b)) * 1 :=
