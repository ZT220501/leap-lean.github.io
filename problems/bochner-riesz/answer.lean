      exact h_sum_fib bin_D (fun d => p_D d * w_D d) _
    have hT2_eq : (∑ b : Fin S_bins, if 0 < π_b b then π_b b * T2 (p_b b) else 0) = T2 p := by
      have h_b : ∀ b : Fin S_bins,
          (if 0 < π_b b then π_b b * T2 (p_b b) else 0) =
            ∑ d ∈ Finset.univ.filter (fun d => bin_D d = b),
              ∑ o : Fin N_O, -(p o d * Real.log (p o d / p_D d)) := by
        intro b
        by_cases hπ : 0 < π_b b
        · simp only [hπ, ↓reduceIte, T2]
          rw [Finset.sum_filter, Finset.sum_comm, Finset.mul_sum]
          refine Finset.sum_congr rfl (fun d _ => ?_)
          by_cases hbd : bin_D d = b
          · simp only [hbd, ↓reduceIte]
            rw [Finset.mul_sum]
            refine Finset.sum_congr rfl (fun o _ => ?_)
            change π_b b * -(p_b b o d * Real.log (p_b b o d / pb_D b d)) = _
            have hpbd_eq : pb_D b d = p_D d / π_b b := by
