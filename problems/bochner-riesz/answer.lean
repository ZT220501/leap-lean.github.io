      have hδ_pos : 0 < δ := lt_of_lt_of_le hε₀ hδ_ge
      let k₀ : ℤ := ⌊x₀ / δ⌋
      let I_s : Finset ℤ := {k₀ - 19, k₀, k₀ + 19}
      have h_card : I_s.card ≤ 3 := by
        dsimp [I_s]
        calc (insert (k₀ - 19) (insert k₀ ({k₀ + 19} : Finset ℤ))).card
