    have h_qB2_sum : (∑ b₁, ∑ b₂, (1 / 2 : ℝ) * (q_B b₁ * q_B b₂)) = 1 / 2 := by
      have h_in : ∀ b₁, (∑ b₂, (1 / 2 : ℝ) * (q_B b₁ * q_B b₂)) = (1 / 2 : ℝ) * q_B b₁ := by
        intro b₁
        rw [← Finset.mul_sum, ← Finset.mul_sum, hqB_sum, mul_one]
      simp_rw [h_in, ← Finset.mul_sum]
      rw [hqB_sum, mul_one]
    have h_exists_pair : ∃ b₁ b₂ : Fin N_B,
        (1 / 2 : ℝ) * (q_B b₁ * q_B b₂) <
