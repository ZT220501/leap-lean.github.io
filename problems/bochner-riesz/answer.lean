        calc ‖z₂‖ ^ 2
            ≤ (∑ _ ∈ S₂, (1 : ℝ) ^ 2) * ∑ α ∈ S₂, (‖c_at α‖ * ‖P_fn (g_at α)‖) ^ 2 :=
              le_trans h_sq1 h_sq2
          _ = (S₂.card : ℝ) * ∑ α ∈ S₂, ‖c_at α‖ ^ 2 * ‖P_fn (g_at α)‖ ^ 2 := by
              simp [mul_pow]
          _ = ∑ α ∈ S₂, ‖c_at α‖ ^ 2 * (S₂.card : ℝ) *
                generalPacketObsMass ε H_P t lam_sys m_t Φ₀ (g_at α) r_idx V_o X_o ψ_o := by
              rw [Finset.mul_sum]
              refine Finset.sum_congr rfl (fun α _ => ?_)
              rw [hP_mass (g_at α)]
              ring
