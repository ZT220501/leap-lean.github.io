                        Finset.sum_congr rfl (fun ω' hω' => by
                          rw [if_pos ((Finset.mem_filter.mp hω').2.trans hTω.symm)])
                    _ = ∑ ω' : Fin N_ω,
                          @ite ℝ (T_idx ω' = T_idx ω) (Classical.propDecidable _) (π' ω') 0 := by
                        refine Finset.sum_subset (Finset.subset_univ _) (fun ω' _ h_not => ?_)
                        by_cases h1 : T_idx ω' = T_idx ω
                        · rw [if_pos h1]
                          have hnp : ¬ 0 < π' ω' := fun hp => h_not (Finset.mem_filter.mpr
                            ⟨Finset.mem_filter.mpr ⟨Finset.mem_univ ω', hp⟩, h1.trans hTω⟩)
                          exact le_antisymm (not_lt.mp hnp) (hπ'_nn ω')
                        · rw [if_neg h1]
                have h_p_eq : ∀ ω ∈ F'_tid, finProbAt π T_idx ω =
                    ∑ ω' : Fin N_ω, if T_idx ω' = tid then π ω' else 0 := by
                  intro ω hω
                  have hTω : T_idx ω = tid := (Finset.mem_filter.mp hω).2
                  unfold finProbAt
                  refine Finset.sum_congr rfl (fun ω' _ => ?_)
                  by_cases h1 : T_idx ω' = tid
                  · rw [if_pos (h1.trans hTω.symm), if_pos h1]
                  · rw [if_neg (fun h => h1 (h.trans hTω)), if_neg h1]
                have h_eq : ∑ ω ∈ F'_tid, π' ω * (finProbAt π T_idx ω / finProbAt π' T_idx ω) =
                    ∑ ω' : Fin N_ω, if T_idx ω' = tid then π ω' else 0 := by
                  calc ∑ ω ∈ F'_tid, π' ω * (finProbAt π T_idx ω / finProbAt π' T_idx ω)
                      = ∑ ω ∈ F'_tid, π' ω *
                          ((∑ ω' : Fin N_ω, if T_idx ω' = tid then π ω' else 0) /
                            (∑ ω' ∈ F'_tid, π' ω')) :=
                        Finset.sum_congr rfl (fun ω hω => by rw [h_p_eq ω hω, h_p'_eq ω hω])
                    _ = (∑ ω ∈ F'_tid, π' ω) *
                          ((∑ ω' : Fin N_ω, if T_idx ω' = tid then π ω' else 0) /
                            (∑ ω' ∈ F'_tid, π' ω')) := (Finset.sum_mul _ _ _).symm
                    _ = ∑ ω' : Fin N_ω, if T_idx ω' = tid then π ω' else 0 :=
                        mul_div_cancel₀ _ hp'_tid_pos.ne'
                exact h_eq.le
            _ ≤ ∑ tid : Fin N_T, (∑ ω' : Fin N_ω, if T_idx ω' = tid then π ω' else 0) :=
                Finset.sum_le_univ_sum_of_nonneg (fun tid =>
                  Finset.sum_nonneg (fun ω' _ => by split_ifs <;> [exact hπ_nn ω'; exact le_rfl]))
            _ = ∑ ω' : Fin N_ω, ∑ tid : Fin N_T, (if T_idx ω' = tid then π ω' else 0) :=
                Finset.sum_comm
            _ = ∑ ω' : Fin N_ω, π ω' :=
                Finset.sum_congr rfl (fun ω' _ => by simp [Finset.sum_ite_eq])
            _ = 1 := hπ_sum
        have h_sum_lb := Finset.sum_le_sum h_pt_lb
        have h_lhs_expand :
            ∑ ω ∈ F'_pos, π' ω * (d i * Real.log (ε⁻¹) - Real.log (8 * (J_k : ℝ)) +
                (1 - finProbAt π T_idx ω / finProbAt π' T_idx ω)) =
              (d i * Real.log (ε⁻¹) - Real.log (8 * (J_k : ℝ))) + 1 -
                ∑ ω ∈ F'_pos, π' ω * (finProbAt π T_idx ω / finProbAt π' T_idx ω) := by
          have h1 : ∀ ω ∈ F'_pos,
              π' ω * (d i * Real.log (ε⁻¹) - Real.log (8 * (J_k : ℝ)) +
                (1 - finProbAt π T_idx ω / finProbAt π' T_idx ω)) =
              π' ω * (d i * Real.log (ε⁻¹) - Real.log (8 * (J_k : ℝ)) + 1) -
                π' ω * (finProbAt π T_idx ω / finProbAt π' T_idx ω) := fun ω _ => by ring
          rw [Finset.sum_congr rfl h1, Finset.sum_sub_distrib, ← Finset.sum_mul, h_sum_F', one_mul]
        linarith
      let Bad1 : Fin N_ω → Prop := fun ω => finProbAt π' T_idx ω < η_bad * finProbAt π T_idx ω
      let Bad2 : Fin N_ω → Prop := fun ω =>
        finProbAt2 π' T_idx (Y i) ω < (η_bad * ε ^ (d i + a)) * finProbAt π' T_idx ω
      have h_bad1_sum : (∑ ω : Fin N_ω, @ite ℝ (Bad1 ω) (Classical.dec _) (π' ω) 0) ≤ η_bad := by
        let p'_T : Fin N_T → ℝ := fun tid => ∑ ω' : Fin N_ω, if T_idx ω' = tid then π' ω' else 0
        let p_T : Fin N_T → ℝ := fun tid => ∑ ω' : Fin N_ω, if T_idx ω' = tid then π ω' else 0
        have h_eq_tid : ∀ ω : Fin N_ω,
            finProbAt π' T_idx ω = p'_T (T_idx ω) ∧ finProbAt π T_idx ω = p_T (T_idx ω) := by
          intro ω
          unfold finProbAt
          exact ⟨Finset.sum_congr rfl (fun ω' _ => by
              by_cases h1 : T_idx ω' = T_idx ω <;> simp [h1]),
            Finset.sum_congr rfl (fun ω' _ => by
              by_cases h1 : T_idx ω' = T_idx ω <;> simp [h1])⟩
        calc (∑ ω : Fin N_ω, @ite ℝ (Bad1 ω) (Classical.dec _) (π' ω) 0)
            = ∑ ω : Fin N_ω,
                if p'_T (T_idx ω) < η_bad * p_T (T_idx ω) then π' ω else 0 := by
              refine Finset.sum_congr rfl (fun ω _ => ?_)
              have h_iff : Bad1 ω ↔ p'_T (T_idx ω) < η_bad * p_T (T_idx ω) := by
                dsimp [Bad1]
                rw [(h_eq_tid ω).1, (h_eq_tid ω).2]
              by_cases h : p'_T (T_idx ω) < η_bad * p_T (T_idx ω)
              · rw [if_pos (h_iff.mpr h), if_pos h]
              · rw [if_neg (mt h_iff.mp h), if_neg h]
          _ = ∑ ω : Fin N_ω, ∑ tid : Fin N_T,
                if T_idx ω = tid then
                  (if p'_T tid < η_bad * p_T tid then π' ω else 0)
                else 0 := by
              refine Finset.sum_congr rfl (fun ω _ => ?_)
              symm
              simp [Finset.sum_ite_eq]
          _ = ∑ tid : Fin N_T, ∑ ω : Fin N_ω,
                if T_idx ω = tid then
                  (if p'_T tid < η_bad * p_T tid then π' ω else 0)
                else 0 := Finset.sum_comm
          _ = ∑ tid : Fin N_T, if p'_T tid < η_bad * p_T tid then p'_T tid else 0 := by
              refine Finset.sum_congr rfl (fun tid _ => ?_)
              by_cases h : p'_T tid < η_bad * p_T tid
              · simp only [h, ↓reduceIte]
                rfl
              · simp [h]
          _ ≤ ∑ tid : Fin N_T, η_bad * p_T tid := by
              refine Finset.sum_le_sum (fun tid _ => ?_)
              split_ifs with h
              · exact h.le
              · exact mul_nonneg hη_bad_pos.le
                  (Finset.sum_nonneg (fun ω' _ => by split_ifs <;> [exact hπ_nn ω'; exact le_rfl]))
          _ = η_bad * ∑ tid : Fin N_T, p_T tid := (Finset.mul_sum _ _ _).symm
          _ = η_bad * 1 := by
              congr 1
              dsimp [p_T]
              rw [Finset.sum_comm]
              calc ∑ ω' : Fin N_ω, ∑ tid : Fin N_T, (if T_idx ω' = tid then π ω' else 0)
                  = ∑ ω' : Fin N_ω, π ω' :=
                    Finset.sum_congr rfl (fun ω' _ => by simp [Finset.sum_ite_eq])
                _ = 1 := hπ_sum
          _ = η_bad := mul_one _
      have h_bad2_sum : (∑ ω : Fin N_ω, if Bad2 ω then π' ω else 0) ≤ η_bad := by
        have h_raw := (h_univ_fib ε hε₀ hε_half π' T_idx (Y i) F_act (ε ^ (-(d i + a)))
          hπ'_nn hπ'_sum (by positivity) h_mem_Fact h_card_Fact).2
          (η_bad * ε ^ (d i + a)) (by positivity)
        have h_prod : ε ^ (-(d i + a)) * (η_bad * ε ^ (d i + a)) = η_bad := by
          calc ε ^ (-(d i + a)) * (η_bad * ε ^ (d i + a))
              = η_bad * (ε ^ (-(d i + a)) * ε ^ (d i + a)) := by ring
            _ = η_bad * ε ^ (-(d i + a) + (d i + a)) := by rw [← Real.rpow_add hε₀]
            _ = η_bad := by simp
        rwa [h_prod] at h_raw
      have h_pt_tail : ∀ ω : Fin N_ω,
          (if η_hom < |condSurprise ε π' T_idx (Y i) ω - s_mesh i| then π' ω else 0) ≤
            (@ite ℝ (Bad1 ω) (Classical.dec _) (π' ω) 0) + (if Bad2 ω then π' ω else 0) := by
        intro ω
        by_cases hω' : 0 < π' ω
        · by_cases hb1 : Bad1 ω
          · rw [if_pos hb1]
            have h2_nn : 0 ≤ (if Bad2 ω then π' ω else 0) := by
              split_ifs <;> [exact hω'.le; exact le_rfl]
            split_ifs <;> linarith
          · by_cases hb2 : Bad2 ω
            · rw [if_neg hb1, if_pos hb2, zero_add]
              split_ifs <;> [exact le_rfl; exact hω'.le]
            · rw [if_neg hb1, if_neg hb2, add_zero]
              have h_not_gt : ¬ η_hom < |condSurprise ε π' T_idx (Y i) ω - s_mesh i| := by
                refine not_lt.mpr ?_
                obtain ⟨hp'2, _, hp'1, _⟩ :=
                  (h_prob_pos ε hε₀ hε_half π' T_idx (Y i) hπ'_nn hπ'_sum).1 ω hω'
                have hω_pos : 0 < π ω := (hπ'_cube ω hω').1
                obtain ⟨_, _, hp1, _⟩ :=
                  (h_prob_pos ε hε₀ hε_half π T_idx (Y i) hπ_nn hπ_sum).1 ω hω_pos
                have hp'_ge : η_bad * finProbAt π T_idx ω ≤ finProbAt π' T_idx ω :=
                  not_lt.mp hb1
                have hp'2_ge : (η_bad * ε ^ (d i + a)) * finProbAt π' T_idx ω ≤
                    finProbAt2 π' T_idx (Y i) ω := not_lt.mp hb2
                have h_inv_log : Real.log ε = -Real.log (ε⁻¹) := by rw [Real.log_inv, neg_neg]
                have hS'_ub : condSurprise ε π' T_idx (Y i) ω ≤
                    d i + a + Real.log (8 * (J_k : ℝ) / η_bad) / Real.log (ε⁻¹) := by
                  have h_div_ge : η_bad * ε ^ (d i + a) ≤
                      finProbAt2 π' T_idx (Y i) ω / finProbAt π' T_idx ω :=
                    (le_div_iff₀ hp'1).mpr hp'2_ge
                  have h_log_ge := Real.log_le_log (by positivity) h_div_ge
                  rw [Real.log_mul hη_bad_pos.ne' (by positivity),
                    Real.log_rpow hε₀, h_inv_log] at h_log_ge
                  have h_inv_le_8Jk : Real.log (η_bad⁻¹) ≤ Real.log (8 * (J_k : ℝ) / η_bad) := by
                    refine Real.log_le_log (by positivity) ?_
                    rw [inv_eq_one_div]
                    exact div_le_div_of_nonneg_right h8Jk_gt1.le hη_bad_pos.le
                  rw [Real.log_inv] at h_inv_le_8Jk
                  unfold condSurprise
                  rw [div_le_iff₀ h_ell_pos, add_mul, div_mul_cancel₀ _ h_ell_pos.ne']
                  linarith
                have hS'_lb : d i - Real.log (8 * (J_k : ℝ) / η_bad) / Real.log (ε⁻¹) ≤
                    condSurprise ε π' T_idx (Y i) ω := by
                  have hp2_hi := ((hπ'_cube ω hω').2 i).2.2.2
                  have hp1_ub : finProbAt π T_idx ω ≤ finProbAt π' T_idx ω / η_bad :=
                    (le_div_iff₀' hη_bad_pos).mpr hp'_ge
                  have hp'2_ub : finProbAt2 π' T_idx (Y i) ω ≤
                      (ε ^ (d i) * (8 * (J_k : ℝ) / η_bad)) * finProbAt π' T_idx ω := by
                    calc finProbAt2 π' T_idx (Y i) ω
                        ≤ finProbAt2 π T_idx (Y i) ω / m_z := hp'2_le ω
                      _ ≤ (ε ^ (d i) * finProbAt π T_idx ω) / m_z :=
                          div_le_div_of_nonneg_right hp2_hi hm_z_pos.le
                      _ = (ε ^ (d i) * m_z⁻¹) * finProbAt π T_idx ω := by ring
                      _ ≤ (ε ^ (d i) * (8 * (J_k : ℝ))) * (finProbAt π' T_idx ω / η_bad) := by
                          refine mul_le_mul ?_ hp1_ub hp1.le (by positivity)
                          exact mul_le_mul_of_nonneg_left hm_z_inv_le (by positivity)
                      _ = (ε ^ (d i) * (8 * (J_k : ℝ) / η_bad)) * finProbAt π' T_idx ω := by ring
                  have h_div_le : finProbAt2 π' T_idx (Y i) ω / finProbAt π' T_idx ω ≤
                      ε ^ (d i) * (8 * (J_k : ℝ) / η_bad) :=
                    (div_le_iff₀ hp'1).mpr hp'2_ub
                  have h_log_le := Real.log_le_log (div_pos hp'2 hp'1) h_div_le
                  rw [Real.log_mul (by positivity) (by positivity),
                    Real.log_rpow hε₀, h_inv_log] at h_log_le
                  unfold condSurprise
                  rw [le_div_iff₀ h_ell_pos, sub_mul, div_mul_cancel₀ _ h_ell_pos.ne']
                  linarith
                have h_cap_s := hH'_cap1 i
                have h_abs_s := abs_le.mp h_cap_s
                have h_L_sum :
                    Real.log (8 * (J_k : ℝ) / η_bad) / Real.log (ε⁻¹) +
                      Real.log (8 * (J_k : ℝ)) / Real.log (ε⁻¹) +
                      Real.log 4 / Real.log (ε⁻¹) < a := by
                  have h_lt : Real.log (8 * (J_k : ℝ) / η_bad) +
                      Real.log (8 * (J_k : ℝ)) + Real.log 4 < L_const := by
                    dsimp [L_const]
                    linarith
                  have h_div := div_lt_div_of_pos_right h_lt h_ell_pos
                  rw [add_div, add_div] at h_div
                  exact lt_trans h_div hL_div_lt_a
                rw [abs_le]
                have ha_def : 3 * a = η₀ / 2 := by dsimp [a]; ring
                constructor <;> linarith [hH'_ub, hH'_lb, h_abs_s.1, h_abs_s.2, hη₀_pos, hη₀_le]
              rw [if_neg h_not_gt]
        · have h0 : π' ω = 0 := le_antisymm (not_lt.mp hω') (hπ'_nn ω)
          simp [h0]
      calc (∑ ω : Fin N_ω,
            if η_hom < |condSurprise ε π' T_idx (Y i) ω - s_mesh i| then π' ω else 0)
          ≤ ∑ ω : Fin N_ω,
              ((@ite ℝ (Bad1 ω) (Classical.dec _) (π' ω) 0) + (if Bad2 ω then π' ω else 0)) :=
            Finset.sum_le_sum (fun ω _ => h_pt_tail ω)
        _ = (∑ ω : Fin N_ω, @ite ℝ (Bad1 ω) (Classical.dec _) (π' ω) 0) +
              (∑ ω : Fin N_ω, if Bad2 ω then π' ω else 0) := Finset.sum_add_distrib
        _ ≤ η_bad + η_bad := add_le_add h_bad1_sum h_bad2_sum
        _ = η₀ / 2 := by dsimp [η_bad]; ring
        _ ≤ η_hom := by linarith

  have h_frame_2d : ∀ e : EuclideanSpace ℝ (Fin 2), ‖e‖ = 1 →
      ‖perp2D e‖ = 1 ∧
      inner ℝ e e = 1 ∧
      inner ℝ (perp2D e) (perp2D e) = 1 ∧
      inner ℝ (perp2D e) e = 0 ∧
      inner ℝ e (perp2D e) = 0 := by
    intro e he
    have he_sq : ‖e‖ ^ 2 = 1 := by rw [he]; norm_num
    have h_perp_sq : ‖perp2D e‖ ^ 2 = 1 := by
      rw [PiLp.norm_sq_eq_of_L2] at he_sq ⊢
      rw [Fin.sum_univ_two] at he_sq ⊢
      dsimp [perp2D]
      simp only [Real.norm_eq_abs, sq_abs] at he_sq ⊢
      linarith
    have h_perp_norm : ‖perp2D e‖ = 1 := by
      nlinarith [norm_nonneg (perp2D e)]
    have hee : inner ℝ e e = 1 := by
      rw [real_inner_self_eq_norm_sq, he]
      norm_num
    have hpp : inner ℝ (perp2D e) (perp2D e) = 1 := by
      rw [real_inner_self_eq_norm_sq, h_perp_norm]
      norm_num
    have hpe : inner ℝ (perp2D e) e = 0 := by
      rw [PiLp.inner_apply, Fin.sum_univ_two]
      dsimp [perp2D]
      simp only [RCLike.inner_apply, conj_trivial]
      ring
    have hep : inner ℝ e (perp2D e) = 0 := by
      rw [real_inner_comm, hpe]
    exact ⟨h_perp_norm, hee, hpp, hpe, hep⟩

  have h_ang_norm : ∀ (ε e : ℝ) (k_ang : ℤ), ‖angUnitVec ε e k_ang‖ = 1 := by
    intro ε e k_ang
    have h_sq : ‖angUnitVec ε e k_ang‖ ^ 2 = 1 := by
      unfold angUnitVec
      rw [PiLp.norm_sq_eq_of_L2, Fin.sum_univ_two]
      simp only [WithLp.ofLp_toLp, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons,
        Real.norm_eq_abs, sq_abs]
      exact Real.cos_sq_add_sin_sq _
    nlinarith [norm_nonneg (angUnitVec ε e k_ang)]

  have h_s1_lb : ∀ (u_min η : ℝ), 0 < u_min → u_min ≤ 1 → 0 < η →
      ∃ ε₀ : ℝ, 0 < ε₀ ∧ ε₀ < 1 / 2 ∧
        ∀ (ε u b a : ℝ) {N_ω N_T : ℕ} (π : Fin N_ω → ℝ) (T_idx : Fin N_ω → Fin N_T)
          (V_part A_part : Fin N_T → EuclideanSpace ℝ (Fin 2)) (c_s θ_s : Fin N_ω → ℝ),
          0 < ε → ε < ε₀ → u_min ≤ u → u ≤ 1 →
          0 ≤ b → b ≤ a → a + u ≤ 1 + m →
          IsUnitBallTimeLaw π V_part A_part c_s →
          -η ≤ stdApertureDeficit ε γ (1 + m) u b a π T_idx V_part A_part c_s θ_s := by
    intro u_min η hu_min0 hu_min1 hη
    have h_ne : (ValidClassicalGrowthRates γ).Nonempty := ⟨2, h_two⟩
    have h_lt_inf : sInf (ValidClassicalGrowthRates γ) < classicalGrowthRate γ + η / 2 := by
      change classicalGrowthRate γ < classicalGrowthRate γ + η / 2
      linarith
    obtain ⟨b₀, hb₀_mem, hb₀_lt⟩ := exists_lt_of_csInf_lt h_ne h_lt_inf
    obtain ⟨ε₀, hε₀_pos, hε₀_lt, h_est⟩ :=
      hb₀_mem.2.2 4 (1 + m) u_min (η / 2) (by norm_num) (by linarith)
        hu_min0 (by linarith) (half_pos hη)
    refine ⟨ε₀, hε₀_pos, hε₀_lt, ?_⟩
    intro ε u b a N_ω N_T π T_idx V_part A_part c_s θ_s
      hε₀ hε_lt hu_ge hu_le1 hb0 hba hau h_law
    have hε_half : ε < 1 / 2 := lt_trans hε_lt hε₀_lt
    have hu_pos : 0 < u := lt_of_lt_of_le hu_min0 hu_ge
    obtain ⟨h_log2_lt, h_ell_pos, h_pow_fn⟩ := h_dyad_pow ε hε₀ hε_half
    have h_pow_u := h_pow_fn u hu_pos.le
    let m_u := dyadicTimeLevel ε u
    let Δ_time : ℝ := ((2 : ℝ) ^ m_u)⁻¹
    have hΔ_lo : (4 : ℝ)⁻¹ * ε ^ u ≤ Δ_time := by
      have h_pos_pow : (0 : ℝ) < (2 : ℝ) ^ m_u := by positivity
      have h_pos_rpow : (0 : ℝ) < ε ^ (-u) := by positivity
      have h1 : (4 * ε ^ (-u))⁻¹ ≤ ((2 : ℝ) ^ m_u)⁻¹ :=
        inv_anti₀ h_pos_pow h_pow_u.2.le
      have h2 : (4 * ε ^ (-u))⁻¹ = (4 : ℝ)⁻¹ * ε ^ u := by
        rw [mul_inv, Real.rpow_neg hε₀.le, inv_inv]
      rwa [h2] at h1
    have hΔ_hi : Δ_time ≤ 4 * ε ^ u := by
      have h1 : ((2 : ℝ) ^ m_u)⁻¹ ≤ (ε ^ (-u))⁻¹ :=
        inv_anti₀ (by positivity) h_pow_u.1
      rw [Real.rpow_neg hε₀.le, inv_inv] at h1
      linarith [show 0 < ε ^ u by positivity]
    let G_obs : Fin N_ω → ℤ × ℤ × ℤ × ℤ × ℤ × ℤ := fun ω =>
      stdApertureObs ε u b a (V_part (T_idx ω)) (A_part (T_idx ω)) (c_s ω) (θ_s ω)
    let S_G : Finset (ℤ × ℤ × ℤ × ℤ × ℤ × ℤ) := Finset.univ.image G_obs
    let N_G : ℕ := S_G.card
    let ι : S_G ≃ Fin N_G := S_G.equivFin
    let G_idx : Fin N_ω → Fin N_G :=
      fun ω => ι ⟨G_obs ω, Finset.mem_image_of_mem G_obs (Finset.mem_univ ω)⟩
    have hG_iff : ∀ ω' ω : Fin N_ω, G_idx ω' = G_idx ω ↔ G_obs ω' = G_obs ω := by
      intro ω' ω
      dsimp [G_idx]
      rw [ι.apply_eq_iff_eq, Subtype.mk.injEq]
    let k_time : Fin N_ω → ℤ := fun ω => dyadicTimeBin ε u (c_s ω)
    let tup : Fin N_G → ℤ × ℤ × ℤ × ℤ × ℤ × ℤ := fun g => (ι.symm g).1
    have htup_G : ∀ ω : Fin N_ω, tup (G_idx ω) = G_obs ω := by
      intro ω
      dsimp [tup, G_idx]
      rw [Equiv.symm_apply_apply]
    let b_G : Fin N_G → ℝ := fun _ => b
    let a_G : Fin N_G → ℝ := fun _ => a
    let k_G : Fin N_G → ℤ := fun g => (tup g).1
    let e_G : Fin N_G → EuclideanSpace ℝ (Fin 2) :=
      fun g => angUnitVec ε (a - b) (tup g).2.1
    let midStep : ℝ → ℤ → ℝ := fun L₀ j => ((j : ℝ) + 1 / 2) * dyadicRealStep ε L₀
    let V_G : Fin N_G → EuclideanSpace ℝ (Fin 2) := fun g =>
      midStep b (tup g).2.2.1 • e_G g +
        midStep a (tup g).2.2.2.1 • perp2D (e_G g)
    let X_G : Fin N_G → EuclideanSpace ℝ (Fin 2) := fun g =>
      midStep (b + u) (tup g).2.2.2.2.1 • e_G g +
        midStep (a + u) (tup g).2.2.2.2.2 • perp2D (e_G g)
    have h_mid_err : ∀ (L₀ y : ℝ),
        |y - midStep L₀ (dyadicRealBin ε L₀ y)| ≤ 4 * ε ^ L₀ := by
      intro L₀ y
