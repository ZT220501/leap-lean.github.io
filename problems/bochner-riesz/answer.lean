        ∑ ω : Fin M_ω,
          -(Q ω * Real.log (finProbAt2 Q T_idx k_time ω / finProbAt Q T_idx ω)) := by
        have h_step1 : ∀ tid : Fin M_T, ∀ k : ℤ,
            -(p_TC tid k * Real.log (p_TC tid k / p_T tid)) =
            ∑ ω : Fin M_ω, if T_idx ω = tid ∧ k_time ω = k then
              -(Q ω * Real.log (finProbAt2 Q T_idx k_time ω / finProbAt Q T_idx ω)) else 0 := by
          intro tid k
          have h_exp : p_TC tid k * Real.log (p_TC tid k / p_T tid) =
              ∑ ω : Fin M_ω, (if T_idx ω = tid ∧ k_time ω = k then Q ω else 0) *
                Real.log (p_TC tid k / p_T tid) := by
            dsimp [p_TC]
            rw [Finset.sum_mul]
          rw [h_exp, ← Finset.sum_neg_distrib]
          refine Finset.sum_congr rfl (fun ω _ => ?_)
          split_ifs with h_eq
          · rcases h_eq with ⟨rfl, rfl⟩
            have hp2_eq : p_TC (T_idx ω) (k_time ω) = finProbAt2 Q T_idx k_time ω := by
              unfold finProbAt2
              dsimp [p_TC]
              refine Finset.sum_congr rfl (fun ω' _ => ?_)
              classical simp
            have hp1_eq : p_T (T_idx ω) = finProbAt Q T_idx ω := by
              unfold finProbAt
              dsimp [p_T]
              refine Finset.sum_congr rfl (fun ω' _ => ?_)
              classical simp
