  have hFib₁_card : ∀ d₁, (Fib₁ d₁).card ≤ ⌊4 * e⌋₊ + 2 := by
    intro d₁
    calc (Fib₁ d₁).card
        ≤ (Finset.range (M_mesh + 2)).card := Finset.card_image_le
