          have hpcD_pos : 0 < p_cD d := by
            rw [← hp_ZD_sum_z d]
            exact lt_of_lt_of_le hpZD_pos (Finset.single_le_sum (fun z' _ => hp_ZD_nn z' d) hz)
          have hqlaw_ge : W z q d ≤ q_law q d := by
            dsimp [q_law]; rw [if_pos hq]
            exact Finset.single_le_sum (fun z' _ => hW_nn z' q d) hz
          have hqlaw_pos : 0 < q_law q d := lt_of_lt_of_le hW_pos hqlaw_ge
          have h_rat : (p_ZD z d / p_cD d) / ((T_cell z.2).card : ℝ) =
