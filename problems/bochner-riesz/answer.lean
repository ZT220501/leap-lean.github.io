          ∑ ω' : Fin N_ω, if X ω' = X ω ∧ Y ω' = Y ω then Q ω' else 0 := by
        refine Finset.sum_congr rfl (fun ω' _ => ?_)
        by_cases h : X ω' = X ω ∧ Y ω' = Y ω <;> simp [h]
