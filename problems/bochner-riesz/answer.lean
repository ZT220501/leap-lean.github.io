        (∀ ω, 0 ≤ π ω) → (∑ ω : Fin N_ω, π ω = 1) →
        (∀ x : α, (∃ ω : Fin N_ω, 0 < π ω ∧ X ω = x) →
          ∃ S_x : Finset β, (S_x.card : ℝ) ≤ M ∧
            ∀ ω : Fin N_ω, 0 < π ω → X ω = x → Y ω ∈ S_x) →
        finCondEntropy ε π X Y ≤ Real.log M / Real.log (ε⁻¹) := by
    intro ε M hε₀ hε₁ hM N_ω α β π X Y hπ_nn hπ_sum h_fib
    have hell_pos : 0 < Real.log (ε⁻¹) := (h_ell_pos ε hε₀ hε₁).2
    have hell_ne : Real.log (ε⁻¹) ≠ 0 := hell_pos.ne'
