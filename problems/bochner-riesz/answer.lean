        ∀ (Ψ : ℝ × ℝ → ℝ) (R_strip : Set (ℝ × ℝ)),
          R_strip = Set.Icc (-(B_cell + 1) * σ) ((B_cell + 1) * σ) ×ˢ
            Set.Icc (-(2 * B_cell * s)) (2 * B_cell * s) →
          (∀ p ∈ R_strip, 0 ≤ Ψ p) →
          MeasureTheory.Integrable Ψ (MeasureTheory.volume.restrict R_strip) →
          (∀ o ∈ S_Z, ∀ p : ℝ × ℝ,
            ‖(x_Z + p.1 • n_P + p.2 • perp2D n_P) - X_O o‖ ≤ σ → a o ≤ Ψ p) →
          ∑ o ∈ S_Z, a o ≤
            (((2 * ⌈B_cell⌉₊ + 1) ^ 2 * N_mult : ℕ) : ℝ) *
              (σ⁻¹ ^ 2 * ∫ p in R_strip, Ψ p) := by
    intro B_cell ρ σ s N_mult N_obs hB hρ hσ _hs hσ_le V_P x_Z n_P hn_P V_O X_O S_Z
      hV_O h_pack hS_Z a _ha_nn Ψ R_strip hR_strip hΨ_nn hΨ_int h_pt
    let τ_P : EuclideanSpace ℝ (Fin 2) := perp2D n_P
    have hn_sq : (n_P.ofLp 0) ^ 2 + (n_P.ofLp 1) ^ 2 = 1 := by
      have h1 : ‖n_P‖ ^ 2 = 1 := by rw [hn_P]; norm_num
      rw [EuclideanSpace.norm_sq_eq, Fin.sum_univ_two, Real.norm_eq_abs, Real.norm_eq_abs,
        sq_abs, sq_abs] at h1
      exact h1
    have h_decomp : ∀ u : EuclideanSpace ℝ (Fin 2),
        u = inner ℝ u n_P • n_P + inner ℝ u τ_P • τ_P := by
      intro u
      ext i
      fin_cases i
      · simp [EuclideanSpace.inner_eq_star_dotProduct, dotProduct, Fin.sum_univ_two,
          τ_P, perp2D]
        linear_combination -u.ofLp 0 * hn_sq
      · simp [EuclideanSpace.inner_eq_star_dotProduct, dotProduct, Fin.sum_univ_two,
          τ_P, perp2D]
        linear_combination -u.ofLp 1 * hn_sq
    have h_pyth : ∀ t₁ t₂ : ℝ, ‖t₁ • n_P + t₂ • τ_P‖ ^ 2 = t₁ ^ 2 + t₂ ^ 2 := by
      intro t₁ t₂
      rw [EuclideanSpace.norm_sq_eq, Fin.sum_univ_two]
      simp [τ_P, perp2D, Real.norm_eq_abs, sq_abs]
      linear_combination (t₁ ^ 2 + t₂ ^ 2) * hn_sq
    let t_n : Fin N_obs → ℝ := fun o => inner ℝ (X_O o - x_Z) n_P
    let t_τ : Fin N_obs → ℝ := fun o => inner ℝ (X_O o - x_Z) τ_P
    let R_o : Fin N_obs → Set (ℝ × ℝ) := fun o =>
      Set.Icc (t_n o - σ / 2) (t_n o + σ / 2) ×ˢ Set.Icc (t_τ o - σ / 2) (t_τ o + σ / 2)
    have hR_meas : MeasurableSet R_strip := by
      rw [hR_strip]
      exact isClosed_Icc.measurableSet.prod isClosed_Icc.measurableSet
    have hRo_meas : ∀ o, MeasurableSet (R_o o) := fun _ =>
      isClosed_Icc.measurableSet.prod isClosed_Icc.measurableSet
    have hRo_vol : ∀ o, MeasureTheory.volume (R_o o) = ENNReal.ofReal (σ ^ 2) := by
      intro o
