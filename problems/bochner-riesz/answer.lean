            ‖K (x - y)‖ₑ * ‖f y‖ₑ ^ (3 : ℝ) ∂MeasureTheory.volume := by
      have h_v_pow : (fun y : EuclideanSpace ℝ (Fin 3) => v y ^ (3 : ℝ)) =
          (fun y => ‖K (x - y)‖ₑ * ‖f y‖ₑ ^ (3 : ℝ)) := by
        ext y
        simp only [v]
        rw [ENNReal.mul_rpow_of_nonneg _ _ (by norm_num : (0 : ℝ) ≤ 3), ← ENNReal.rpow_mul]
        have h_exp : (1 / 3 : ℝ) * (3 : ℝ) = 1 := by norm_num
