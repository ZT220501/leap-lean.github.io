        |φ₁ - φ₂| * |inner ℝ w (stdApUVec2D φ₂)| + |inner ℝ w (perp2D (stdApUVec2D φ₂))| := by
    have h_cos : Real.cos φ₁ = Real.cos (φ₁ - φ₂) * Real.cos φ₂ - Real.sin (φ₁ - φ₂) * Real.sin φ₂ := by
