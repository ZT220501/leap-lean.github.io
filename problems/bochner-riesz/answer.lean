        let x_loc_hat := ((2 * ε ^ b_star)⁻¹) • (xhat_fn g - a_j - (cm_fn g) • v_j)
        let cl1 := dyadicRealBin ε 0 (inner ℝ v_loc_hat (ed_fn g))
        let cl2 := dyadicRealBin ε (a_star - b_star) (inner ℝ v_loc_hat (perp2D (ed_fn g)))
        let cl3 := dyadicRealBin ε (0 + t) (inner ℝ x_loc_hat (ed_fn g))
        let cl4 := dyadicRealBin ε ((a_star - b_star) + t) (inner ℝ x_loc_hat (perp2D (ed_fn g)))
        ({g.1} : Finset ℤ) ×ˢ
          (({g.2.1} : Finset ℤ) ×ˢ
            ((Finset.Icc (cl1 - 1) (cl1 + 1)) ×ˢ
              ((Finset.Icc (cl2 - 1) (cl2 + 1)) ×ˢ
                ((Finset.Icc (cl3 - 1) (cl3 + 1)) ×ˢ (Finset.Icc (cl4 - 1) (cl4 + 1))))))
    let F_amb : (ℤ × ℤ × ℤ × ℤ × ℤ × ℤ) →
        Finset ((ℤ × ℤ × ℤ × ℤ) × (ℤ × ℤ × ℤ × ℤ × ℤ × ℤ)) :=
      fun g => (F_j g).biUnion (fun j => (F_loc g j).image (fun g_loc => (j, g_loc)))
    have h_icc1 : ∀ c : ℤ, (Finset.Icc (c - 1) (c + 1)).card = 3 := by
      intro c; simp only [Int.card_Icc]; omega
    have h_icc2 : ∀ c : ℤ, (Finset.Icc (c - 2) (c + 2)).card = 5 := by
      intro c; simp only [Int.card_Icc]; omega
    have h_icc3 : ∀ c : ℤ, (Finset.Icc (c - 3) (c + 3)).card = 7 := by
      intro c; simp only [Int.card_Icc]; omega
    have h_card_j : ∀ g, (F_j g).card = 1225 := by
      intro g
      dsimp only [F_j]
      simp only [Finset.card_product, h_icc2, h_icc3]
    have h_card_loc : ∀ g j, (F_loc g j).card = 81 := by
      intro g j
