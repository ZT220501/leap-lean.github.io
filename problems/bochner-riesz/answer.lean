            Finset.sum_le_sum (fun b _ => by linarith [h_le2 b])
        _ = (16 * ρ ^ (-κ - ω) * μ_child a) * ∑ b, lam b := (Finset.mul_sum _ _ _).symm
        _ = 16 * ρ ^ (-κ - ω) * μ_child a := by rw [hlam_sum, mul_one]
