              split_ifs
              · refine le_trans ?_ (le_trans (h_prod1 kX_star n_star lk.1 lk.2) ?_)
                · refine le_of_eq (h_ite_congr Finset.univ _ _ ν_P (fun i _ => ?_))
                  dsimp [g_LZ]
                  constructor
                  · rintro ⟨⟨hN, hX⟩, hlk⟩
