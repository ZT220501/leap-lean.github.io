      have hCZ1_nn : 0 ≤ C_Z1 * ε ^ (-ζ_sh) :=
        mul_nonneg (by dsimp [C_Z1]; nlinarith [hB_sys]) (Real.rpow_nonneg hε_pos.le _)
      calc ((S_ad.image Z_of).card : ℝ)
          ≤ ∑ q ∈ F_Q_d, (((Fib_Z1 q).image (fun k => (q, k))).card : ℝ) := hcard_real
        _ ≤ ∑ _q ∈ F_Q_d, (C_Z1 * ε ^ (-ζ_sh)) := Finset.sum_le_sum (fun q _ => hfib_card q)
        _ = (F_Q_d.card : ℝ) * (C_Z1 * ε ^ (-ζ_sh)) := by rw [Finset.sum_const, nsmul_eq_mul]
