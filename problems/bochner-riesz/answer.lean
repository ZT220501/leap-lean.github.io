        congr_fun (@iteratedFDeriv_succ_eq_comp_left ℝ _ E _ _ E _ _ I_K m) z
      have h_ih_fn : iteratedFDeriv ℝ m I_K = fun y : E => ∫ τ in (0 : ℝ)..1, D_K m τ y :=
        funext ih
