  · intro ε_seq N_ω N_T π_seq T_seq V_seq A_seq c_seq R_seq S_dyad
      hε_bounds hε_tendsto h_law_seq h_dyad_time h_dyad_orient
    let D : Set ℝ := { q : ℝ | q ∈ Set.Ioo (0 : ℝ) 1 ∧ IsPosDyadicUnit q }
    have h_err_lim : Filter.Tendsto
        (fun k => Real.log 2 / Real.log ((ε_seq k)⁻¹)) Filter.atTop (nhds 0) := by
