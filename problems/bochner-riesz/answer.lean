      rw [h_eq_part]
    
    have hvol_pos : 0 < δ_box ^ (n + 1) := pow_pos hδ (n + 1)
    have h0_mem : (0 : ℝ) ∈ Set.uIcc (0 : ℝ) Δ := Set.left_mem_uIcc
    have hΔ_mem : Δ ∈ Set.uIcc (0 : ℝ) Δ := Set.right_mem_uIcc
