            have ht_sq : 100 ^ 2 < t ^ 2 := by rw [← sq_abs t]; nlinarith
            nlinarith [sq_nonneg y₁]
          have h_norm : 100 ≤ ‖t • w₀ + y₁ • perp2D w₀‖ := by
            nlinarith [norm_nonneg (t • w₀ + y₁ • perp2D w₀)]
          have h0 : ψ₁ (t • w₀ + y₁ • perp2D w₀) = 0 := hψ₁.2.1 _ h_norm
          simp [F_t, h0]
        change ‖∫ t : ℝ, F_t t‖ ≤ 2000000
        rw [← MeasureTheory.setIntegral_eq_integral_of_forall_compl_eq_zero hF_out]
        have h_meas_lt : MeasureTheory.volume (Set.Icc (-100 : ℝ) 100) < ⊤ := by
          rw [Real.volume_Icc]; exact ENNReal.ofReal_lt_top
        have hF_pt : ∀ t ∈ Set.Icc (-100 : ℝ) 100, ‖F_t t‖ ≤ 10000 := by
          intro t _ht
          dsimp only [F_t]
          rw [norm_mul, norm_mul, norm_star, Complex.norm_exp_I_mul_ofReal, mul_one]
          have hb1 : ‖ψ₁ (t • w₀ + y₁ • perp2D w₀)‖ ≤ 100 := by
            have h0 := hψ₁.2.2 0 (t • w₀ + y₁ • perp2D w₀)
            rw [norm_iteratedFDeriv_zero] at h0
            norm_num at h0
            exact h0
          have hb2 : ‖ψ₂ (t • w₀ + y₁ • perp2D w₀ - δ_V)‖ ≤ 100 := by
            have h0 := hψ₂.2.2 0 (t • w₀ + y₁ • perp2D w₀ - δ_V)
            rw [norm_iteratedFDeriv_zero] at h0
            norm_num at h0
            exact h0
          nlinarith [norm_nonneg (ψ₁ (t • w₀ + y₁ • perp2D w₀)),
            norm_nonneg (ψ₂ (t • w₀ + y₁ • perp2D w₀ - δ_V))]
        have h_est := MeasureTheory.norm_setIntegral_le_of_norm_le_const h_meas_lt hF_pt
        have h_vol_real : MeasureTheory.volume.real (Set.Icc (-100 : ℝ) 100) = 200 := by
          rw [MeasureTheory.Measure.real_def, Real.volume_Icc]; norm_num
        rw [h_vol_real] at h_est
        linarith
    exact ⟨h_disj, h_triv, h_slice⟩

  have h_window_bounds :
      ∃ B_win : ℕ → ℝ,
        ∀ (ψ₁ ψ₂ : EuclideanSpace ℝ (Fin 2) → ℂ),
          IsCanonicalRootWindow ψ₁ →
          IsCanonicalRootWindow ψ₂ →
        ∀ (w δ_V : EuclideanSpace ℝ (Fin 2)), ‖w‖ = 1 →
        ∀ (y₁ : ℝ),
          let u : ℝ → ℂ := fun t =>
            star (ψ₁ (t • w + y₁ • perp2D w)) * ψ₂ (t • w + y₁ • perp2D w - δ_V)
          (∀ k : ℕ, ContDiff ℝ k u) ∧
          (∀ t : ℝ, 100 ≤ |t| → u t = 0) ∧
          (∀ k : ℕ, k ≤ 4 → ∀ t : ℝ, ‖iteratedDeriv k u t‖ ≤ B_win k) := by
    let W : ℕ → ℝ := fun j => (100 : ℝ) ^ (j + 1) * ((j.factorial : ℝ) ^ 10)
    let B_win : ℕ → ℝ := fun k =>
      ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * W i * W (k - i)
    refine ⟨B_win, ?_⟩
    intro ψ₁ ψ₂ hψ₁ hψ₂ w δ_V hw y₁
    dsimp only
    let L_w : ℝ →L[ℝ] EuclideanSpace ℝ (Fin 2) :=
      ContinuousLinearMap.smulRight (1 : ℝ →L[ℝ] ℝ) w
    have hLw_apply : ∀ t : ℝ, L_w t = t • w := fun t => by simp [L_w]
    have hLw_norm : ‖L_w‖ ≤ 1 := by
      refine ContinuousLinearMap.opNorm_le_bound _ zero_le_one (fun t => ?_)
      rw [hLw_apply, norm_smul, hw, mul_one, one_mul, Real.norm_eq_abs]
    have h_single : ∀ (ψ : EuclideanSpace ℝ (Fin 2) → ℂ), IsCanonicalRootWindow ψ →
        ∀ (z₀ : EuclideanSpace ℝ (Fin 2)),
          (∀ k : ℕ, ContDiff ℝ k (fun t : ℝ => ψ (t • w + z₀))) ∧
          (∀ (j : ℕ) (t : ℝ), ‖iteratedFDeriv ℝ j (fun s : ℝ => ψ (s • w + z₀)) t‖ ≤ W j) := by
      intro ψ hψ z₀
      have h_eq : (fun s : ℝ => ψ (s • w + z₀)) = (fun z => ψ (z + z₀)) ∘ ⇑L_w := by
        ext s; simp [hLw_apply]
      refine ⟨fun k => ?_, fun j t => ?_⟩
      · rw [h_eq]
        exact ((hψ.1 k).comp (contDiff_id.add contDiff_const)).comp L_w.contDiff
      · rw [h_eq]
        have h_shift_cd : ContDiff ℝ j (fun z => ψ (z + z₀)) :=
          (hψ.1 j).comp (contDiff_id.add contDiff_const)
        rw [L_w.iteratedFDeriv_comp_right h_shift_cd t le_rfl, iteratedFDeriv_comp_add_right]
        have h_le1 := ContinuousMultilinearMap.norm_compContinuousLinearMap_le
          (iteratedFDeriv ℝ j ψ (L_w t + z₀)) (fun _ : Fin j => L_w)
        have h_prod_le : (∏ _ : Fin j, ‖L_w‖) ≤ 1 := by
          rw [Finset.prod_const, Finset.card_fin]
          exact pow_le_one₀ (norm_nonneg L_w) hLw_norm
        calc ‖(iteratedFDeriv ℝ j ψ (L_w t + z₀)).compContinuousLinearMap (fun _ => L_w)‖
            ≤ ‖iteratedFDeriv ℝ j ψ (L_w t + z₀)‖ * ∏ _ : Fin j, ‖L_w‖ := h_le1
          _ ≤ W j * 1 := mul_le_mul (hψ.2.2 j (L_w t + z₀)) h_prod_le
              (Finset.prod_nonneg (fun _ _ => norm_nonneg L_w)) (by positivity)
          _ = W j := mul_one _
    let z₁ : EuclideanSpace ℝ (Fin 2) := y₁ • perp2D w
    let z₂ : EuclideanSpace ℝ (Fin 2) := y₁ • perp2D w - δ_V
    obtain ⟨h1_cd, h1_bd⟩ := h_single ψ₁ hψ₁ z₁
    obtain ⟨h2_cd, h2_bd⟩ := h_single ψ₂ hψ₂ z₂
    let f₁ : ℝ → ℂ := fun t => star (ψ₁ (t • w + z₁))
    let f₂ : ℝ → ℂ := fun t => ψ₂ (t • w + z₂)
    have hf₁_eq : f₁ = ⇑Complex.conjLIE ∘ (fun t : ℝ => ψ₁ (t • w + z₁)) := rfl
    have hf₁_cd : ∀ k : ℕ, ContDiff ℝ k f₁ := fun k => by
      rw [hf₁_eq]
      exact Complex.conjLIE.contDiff.comp (h1_cd k)
    have hf₁_bd : ∀ (j : ℕ) (t : ℝ), ‖iteratedFDeriv ℝ j f₁ t‖ ≤ W j := by
      intro j t
      rw [hf₁_eq, Complex.conjLIE.norm_iteratedFDeriv_comp_left]
      exact h1_bd j t
    have hu_eq : (fun t : ℝ =>
          star (ψ₁ (t • w + y₁ • perp2D w)) * ψ₂ (t • w + y₁ • perp2D w - δ_V)) =
        fun t => f₁ t * f₂ t := by
      ext t
      dsimp only [f₁, f₂, z₁, z₂]
      rw [add_sub_assoc]
    refine ⟨fun k => ?_, ?_, ?_⟩
    · rw [hu_eq]
      exact (hf₁_cd k).mul (h2_cd k)
    · intro t ht
      have hw_sq : (w 0) ^ 2 + (w 1) ^ 2 = 1 := by
        have h1 : ‖w‖ ^ 2 = 1 := by rw [hw]; norm_num
        rw [PiLp.norm_sq_eq_of_L2, Fin.sum_univ_two] at h1
        simpa [Real.norm_eq_abs, sq_abs] using h1
      have h_norm_sq : 100 ^ 2 ≤ ‖t • w + y₁ • perp2D w‖ ^ 2 := by
        have h_eq : ‖t • w + y₁ • perp2D w‖ ^ 2 = t ^ 2 + y₁ ^ 2 := by
          rw [PiLp.norm_sq_eq_of_L2, Fin.sum_univ_two]
          simp only [PiLp.add_apply, PiLp.smul_apply, smul_eq_mul, perp2D,
            Real.norm_eq_abs, sq_abs]
          dsimp
          linear_combination (t ^ 2 + y₁ ^ 2) * hw_sq
        rw [h_eq]
        have ht_sq : 100 ^ 2 ≤ t ^ 2 := by rw [← sq_abs t]; nlinarith
        nlinarith [sq_nonneg y₁]
      have h_norm : 100 ≤ ‖t • w + y₁ • perp2D w‖ := by
        nlinarith [norm_nonneg (t • w + y₁ • perp2D w)]
      have h0 : ψ₁ (t • w + y₁ • perp2D w) = 0 := hψ₁.2.1 _ h_norm
      simp [h0]
    · intro k _hk t
      rw [← norm_iteratedFDeriv_eq_norm_iteratedDeriv, hu_eq]
      have h_mul := norm_iteratedFDeriv_mul_le (hf₁_cd k) (h2_cd k) t (le_rfl : (k : WithTop ℕ∞) ≤ k)
      refine le_trans h_mul (Finset.sum_le_sum (fun i _hi => ?_))
      have h_choose_nn : (0 : ℝ) ≤ (k.choose i : ℝ) := Nat.cast_nonneg _
      have hWi_nn : 0 ≤ W i := by positivity
      calc (k.choose i : ℝ) * ‖iteratedFDeriv ℝ i f₁ t‖ * ‖iteratedFDeriv ℝ (k - i) f₂ t‖
          = (k.choose i : ℝ) * (‖iteratedFDeriv ℝ i f₁ t‖ * ‖iteratedFDeriv ℝ (k - i) f₂ t‖) :=
            mul_assoc _ _ _
        _ ≤ (k.choose i : ℝ) * (W i * W (k - i)) := by
            refine mul_le_mul_of_nonneg_left ?_ h_choose_nn
            exact mul_le_mul (hf₁_bd i t) (h2_bd (k - i) t) (norm_nonneg _) hWi_nn
        _ = (k.choose i : ℝ) * W i * W (k - i) := (mul_assoc _ _ _).symm

  have h_phase_bounds :
      ∃ D_phase : ℕ → ℝ,
        ∀ (lam : ℝ), 2 ≤ lam →
        ∀ (Φ₀ : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → ℝ)
          (ζ₀ : EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → EuclideanSpace ℝ (Fin 2)),
          IsNormalizedPosDefPhase a₀ a₁ A Φ₀ ζ₀ →
        ∀ (V₀ X₁ X₂ w : EuclideanSpace ℝ (Fin 2)), ‖w‖ = 1 →
        ∀ (K : ℝ), 0 < K →
          X₂ - X₁ = ((Real.sqrt lam)⁻¹ * K) • w →
          let ρ₀ := (Real.sqrt lam)⁻¹
          let θ : ℝ → ℝ := fun t =>
            lam * (Φ₀ (1 / 2, X₂, V₀ + ρ₀ • (t • w)) - Φ₀ (1 / 2, X₁, V₀ + ρ₀ • (t • w)))
          (∀ k : ℕ, ContDiff ℝ k θ) ∧
          (∀ t : ℝ, a₀ * K ≤ deriv θ t) ∧
          (∀ j : ℕ, 1 ≤ j → j ≤ 4 → ∀ t : ℝ, |iteratedDeriv j (deriv θ) t| ≤ (a₀ * K) * D_phase j) := by
    let D_phase : ℕ → ℝ := fun j => a₀⁻¹ * A ^ (j + 1) * ((j.factorial : ℝ) ^ 3)
    refine ⟨D_phase, ?_⟩
    intro lam hlam Φ₀ ζ₀ h_phase V₀ X₁ X₂ w hw K hK_pos hX_diff
    dsimp only
    let ρ₀ : ℝ := (Real.sqrt lam)⁻¹
    have hlam_pos : 0 < lam := by linarith
    have hsqrt_pos : 0 < Real.sqrt lam := Real.sqrt_pos.mpr hlam_pos
    have hsqrt_ge_one : 1 ≤ Real.sqrt lam := by
      rw [← Real.sqrt_one]
      exact Real.sqrt_le_sqrt (by linarith)
    have hρ₀_pos : 0 < ρ₀ := inv_pos.mpr hsqrt_pos
    have hρ₀_le_one : ρ₀ ≤ 1 := inv_le_one_of_one_le₀ hsqrt_ge_one
    have hlam_ρ₀_sq : lam * ρ₀ ^ 2 = 1 := by
      dsimp [ρ₀]
      rw [inv_pow, Real.sq_sqrt hlam_pos.le, mul_inv_cancel₀ hlam_pos.ne']
    let v_line : ℝ → EuclideanSpace ℝ (Fin 2) := fun t => V₀ + ρ₀ • (t • w)
    have hv_cd : ∀ k : ℕ, ContDiff ℝ k v_line := fun k => by
      have hcV : ContDiff ℝ k (fun _ : ℝ => V₀) := contDiff_const
      have hcρ : ContDiff ℝ k (fun _ : ℝ => ρ₀) := contDiff_const
      have hcw : ContDiff ℝ k (fun _ : ℝ => w) := contDiff_const
      exact hcV.add (hcρ.smul (contDiff_id.smul hcw))
    have hv_deriv : ∀ t : ℝ, HasDerivAt v_line (ρ₀ • w) t := by
      intro t
      have h1 : HasDerivAt (fun s : ℝ => s • w) ((1 : ℝ) • w) t :=
        (hasDerivAt_id t).smul_const w
      rw [one_smul] at h1
      simpa [v_line] using (h1.const_smul ρ₀).const_add V₀
    let θ : ℝ → ℝ := fun t =>
      lam * (Φ₀ (1 / 2, X₂, v_line t) - Φ₀ (1 / 2, X₁, v_line t))
    have hθ_cd : ∀ k : ℕ, ContDiff ℝ k θ := fun k => by
      have hclam : ContDiff ℝ k (fun _ : ℝ => lam) := contDiff_const
      refine hclam.mul ?_
      refine ((h_phase.1 k).comp
        (contDiff_const.prodMk (contDiff_const.prodMk (hv_cd k)))).sub
        ((h_phase.1 k).comp
          (contDiff_const.prodMk (contDiff_const.prodMk (hv_cd k))))
    let p_seg : ℝ × ℝ → EuclideanSpace ℝ (Fin 2) := fun p =>
      X₁ - (1 / 2 : ℝ) • v_line p.1 + p.2 • (X₂ - X₁)
    let G : ℝ × ℝ → ℝ := fun p =>
      (lam * ρ₀) * inner ℝ (ζ₀ (v_line p.1, p_seg p)) w
    have hG_cd : ∀ k : ℕ, ContDiff ℝ k G := fun k => by
      have hv1 : ContDiff ℝ k (fun p : ℝ × ℝ => v_line p.1) := (hv_cd k).comp contDiff_fst
      have hcX1 : ContDiff ℝ k (fun _ : ℝ × ℝ => X₁) := contDiff_const
      have hchalf : ContDiff ℝ k (fun _ : ℝ × ℝ => (1 / 2 : ℝ)) := contDiff_const
      have hcXdiff : ContDiff ℝ k (fun _ : ℝ × ℝ => X₂ - X₁) := contDiff_const
      have hp_cd : ContDiff ℝ k p_seg :=
        (hcX1.sub (hchalf.smul hv1)).add (contDiff_snd.smul hcXdiff)
      have hζ_comp : ContDiff ℝ k (fun p : ℝ × ℝ => ζ₀ (v_line p.1, p_seg p)) :=
        (h_phase.2.1 k).comp (hv1.prodMk hp_cd)
      have h_Gc : ContDiff ℝ k (fun _ : ℝ × ℝ => lam * ρ₀) := contDiff_const
      have hG_eq : G = fun p => (lam * ρ₀) *
          (InnerProductSpace.toDual ℝ (EuclideanSpace ℝ (Fin 2)) w)
            (ζ₀ (v_line p.1, p_seg p)) := by
        ext p
        dsimp only [G]
        rw [InnerProductSpace.toDual_apply_apply, real_inner_comm]
      rw [hG_eq]
      exact h_Gc.mul
        ((InnerProductSpace.toDual ℝ (EuclideanSpace ℝ (Fin 2)) w).contDiff.comp hζ_comp)
    have hθ_deriv_eq : ∀ t : ℝ, deriv θ t = G (t, 1) - G (t, 0) := by
      intro t
      have hc_mem : (1 / 2 : ℝ) ∈ Set.Icc (0 : ℝ) 1 := by constructor <;> norm_num
      have h_phi_deriv : ∀ X : EuclideanSpace ℝ (Fin 2),
          HasDerivAt (fun s => Φ₀ (1 / 2, X, v_line s))
            (ρ₀ * inner ℝ (ζ₀ (v_line t, X - (1 / 2 : ℝ) • v_line t)) w) t := by
        intro X
        have h_diff : DifferentiableAt ℝ (fun v' => Φ₀ (1 / 2, X, v')) (v_line t) := by
          have hcd : ContDiff ℝ (1 : ℕ) (fun v' => Φ₀ (1 / 2, X, v')) :=
            (h_phase.1 1).comp (contDiff_const.prodMk (contDiff_const.prodMk contDiff_id))
          exact (hcd.differentiable (by simp)).differentiableAt
        have h_comp := h_diff.hasFDerivAt.comp_hasDerivAt t (hv_deriv t)
        have h_grad := h_phase.2.2.2.2.2.1 (1 / 2) hc_mem X (v_line t) (ρ₀ • w)
        rw [inner_smul_right] at h_grad
        rwa [h_grad] at h_comp
      have h_sub : HasDerivAt θ
          (lam * (ρ₀ * inner ℝ (ζ₀ (v_line t, X₂ - (1 / 2 : ℝ) • v_line t)) w -
            ρ₀ * inner ℝ (ζ₀ (v_line t, X₁ - (1 / 2 : ℝ) • v_line t)) w)) t :=
        ((h_phi_deriv X₂).sub (h_phi_deriv X₁)).const_mul lam
      rw [h_sub.deriv]
      dsimp only [G, p_seg]
      have hp1 : X₁ - (1 / 2 : ℝ) • v_line t + (1 : ℝ) • (X₂ - X₁) =
          X₂ - (1 / 2 : ℝ) • v_line t := by rw [one_smul]; abel
      have hp0 : X₁ - (1 / 2 : ℝ) • v_line t + (0 : ℝ) • (X₂ - X₁) =
          X₁ - (1 / 2 : ℝ) • v_line t := by simp
      rw [hp1, hp0]
      ring
    let M : EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) →
        (EuclideanSpace ℝ (Fin 2) →L[ℝ] EuclideanSpace ℝ (Fin 2)) :=
      fun q => fderiv ℝ (fun p' => ζ₀ (q.1, p')) q.2
    let H : ℝ × ℝ → ℝ := fun p =>
      K * inner ℝ (M (v_line p.1, p_seg p) w) w
    have hG_tau_deriv : ∀ (t τ : ℝ), HasDerivAt (fun τ' => G (t, τ')) (H (t, τ)) τ := by
      intro t τ
      have hp_deriv : HasDerivAt (fun τ' : ℝ => p_seg (t, τ')) (X₂ - X₁) τ := by
        have h1 : HasDerivAt (fun τ' : ℝ => τ' • (X₂ - X₁)) ((1 : ℝ) • (X₂ - X₁)) τ :=
          (hasDerivAt_id τ).smul_const (X₂ - X₁)
        rw [one_smul] at h1
        exact h1.const_add (X₁ - (1 / 2 : ℝ) • v_line t)
      have hζ_diff : DifferentiableAt ℝ (fun p' => ζ₀ (v_line t, p')) (p_seg (t, τ)) := by
        have hcd : ContDiff ℝ (1 : ℕ) (fun p' => ζ₀ (v_line t, p')) :=
          (h_phase.2.1 1).comp (contDiff_const.prodMk contDiff_id)
        exact (hcd.differentiable (by simp)).differentiableAt
      have h_comp1 := hζ_diff.hasFDerivAt.comp_hasDerivAt τ hp_deriv
      let dual_w := InnerProductSpace.toDual ℝ (EuclideanSpace ℝ (Fin 2)) w
      have h_comp2 := (dual_w.hasFDerivAt.comp_hasDerivAt τ h_comp1).const_mul (lam * ρ₀)
      have h_fun_eq : (fun y : ℝ => (lam * ρ₀) *
          (⇑dual_w ∘ (fun p' => ζ₀ (v_line t, p')) ∘ fun τ' => p_seg (t, τ')) y) =
          fun τ' => G (t, τ') := by
        ext τ'
        dsimp only [G, dual_w, Function.comp_apply]
        rw [InnerProductSpace.toDual_apply_apply, real_inner_comm]
      rw [h_fun_eq] at h_comp2
      have h_val_eq : (lam * ρ₀) * dual_w (M (v_line t, p_seg (t, τ)) (X₂ - X₁)) = H (t, τ) := by
        dsimp only [dual_w, H]
        rw [InnerProductSpace.toDual_apply_apply, real_inner_comm, hX_diff]
        change (lam * ρ₀) * inner ℝ ((M (v_line t, p_seg (t, τ))) ((ρ₀ * K) • w)) w = _
        rw [ContinuousLinearMap.map_smul, real_inner_smul_left]
        calc (lam * ρ₀) * ((ρ₀ * K) * inner ℝ (M (v_line t, p_seg (t, τ)) w) w)
            = (lam * ρ₀ ^ 2) * (K * inner ℝ (M (v_line t, p_seg (t, τ)) w) w) := by ring
          _ = K * inner ℝ (M (v_line t, p_seg (t, τ)) w) w := by rw [hlam_ρ₀_sq, one_mul]
      rwa [h_val_eq] at h_comp2
    have hθ_lower : ∀ t : ℝ, a₀ * K ≤ deriv θ t := by
      intro t
      let φ : ℝ → ℝ := fun τ => (a₀ * K) * τ - G (t, τ)
      have hφ_deriv : ∀ τ : ℝ, HasDerivAt φ (a₀ * K - H (t, τ)) τ := fun τ => by
        have h1 : HasDerivAt (fun τ' : ℝ => (a₀ * K) * τ') ((a₀ * K) * 1) τ :=
          (hasDerivAt_id τ).const_mul (a₀ * K)
        rw [mul_one] at h1
        exact h1.sub (hG_tau_deriv t τ)
      have hφ_diff : Differentiable ℝ φ := fun τ => (hφ_deriv τ).differentiableAt
      have hφ_nonpos : ∀ τ : ℝ, deriv φ τ ≤ 0 := by
        intro τ
        rw [(hφ_deriv τ).deriv]
        have h_pd := (h_phase.2.2.2.2.2.2.2.1 (v_line t) (p_seg (t, τ)) w).1
        rw [hw, one_pow, mul_one] at h_pd
        have hH_ge : a₀ * K ≤ H (t, τ) := by
          dsimp only [H]
          nlinarith
        linarith
      have h_anti := antitone_of_deriv_nonpos hφ_diff hφ_nonpos (zero_le_one : (0 : ℝ) ≤ 1)
      dsimp only [φ] at h_anti
      rw [hθ_deriv_eq t]
      linarith
    have h_clairaut : ∀ (F : ℝ × ℝ → ℝ), (∀ k : ℕ, ContDiff ℝ k F) →
        let F₁ : ℝ × ℝ → ℝ := fun p => deriv (fun s => F (s, p.2)) p.1
        (∀ k : ℕ, ContDiff ℝ k F₁) ∧
        ∀ (t τ : ℝ), HasDerivAt (fun u => F₁ (t, u))
          (deriv (fun s => deriv (fun u => F (s, u)) τ) t) τ := by
      intro F hF
      dsimp only
      let F₁ : ℝ × ℝ → ℝ := fun p => deriv (fun s => F (s, p.2)) p.1
      have h_part1 : ∀ p : ℝ × ℝ, F₁ p = fderiv ℝ F p (1, 0) := by
        intro p
        have h_line : HasDerivAt (fun s : ℝ => (s, p.2)) (1, 0) p.1 :=
          (hasDerivAt_id p.1).prodMk (hasDerivAt_const p.1 p.2)
        have h_diff : DifferentiableAt ℝ F p := ((hF 1).differentiable (by simp)).differentiableAt
        exact (h_diff.hasFDerivAt.comp_hasDerivAt p.1 h_line).deriv
