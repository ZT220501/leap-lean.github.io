            if k_time ω = k then
              -(Q ω * Real.log (finProbAt2 Q T_idx k_time ω / finProbAt Q T_idx ω)) else 0 := by
          intro k
          have : ∀ tid : Fin M_T,
              (if T_idx ω = tid ∧ k_time ω = k then
                -(Q ω * Real.log (finProbAt2 Q T_idx k_time ω / finProbAt Q T_idx ω)) else 0) =
              if tid = T_idx ω then
                (if k_time ω = k then
                  -(Q ω * Real.log (finProbAt2 Q T_idx k_time ω / finProbAt Q T_idx ω)) else 0)
