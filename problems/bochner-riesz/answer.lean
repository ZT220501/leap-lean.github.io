            (∑ b₂, ν_in i b₂) ≤
              16 * ρ ^ (-κ - ω) * (blk.π_seq l i b₁ / (∑ i', blk.π_seq l i' b₁))) ∧
          (∀ (z₀ r : ℝ), ρ ≤ r → r ≤ 1 →
            letI := Classical.propDecidable
            let e_dir := flip2D (dirVec (paramVec blk l b₁ - paramVec blk l b₀))
            (∑ b₂ : Fin (blk.N_Θ l),
              if |inner ℝ e_dir (paramVec blk l b₂) - z₀| < r
