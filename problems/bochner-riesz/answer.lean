            have htid_eq : T_idx ω_t = T_idx ω₀ := (Finset.mem_filter.mp hω_t_u).2
            have ht1 := (h_time_u 1 h1_in_U ω_t (hπ_s_pos_iff ω_t hω_t_pos).2.1).1
