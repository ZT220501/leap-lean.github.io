      · rw [if_neg hc]
        refine mul_nonneg (mul_nonneg (by positivity) ?_) (hlam_nn b)
        split_ifs; exact div_nonneg (hlam_nn a) hm_par_pos.le; exact le_rfl
    have hGj_dom_Pi : ∀ a b,
        G_j a b ≤ 8 * ρ ^ (-ω) * m_par⁻¹ *
          (if C_fn a = p_par ∧ H_dir a b then Pi_sym a b else 0) := by
      intro a b; dsimp [G_j]
      by_cases hc : C_fn a = p_par ∧ Sep a b
      · rw [if_pos hc, div_eq_mul_inv]
        calc R a b * (m_good p_par)⁻¹
            ≤ (ρ ^ (-ω) * (if H_dir a b then Pi_sym a b else 0)) * (8 * m_par⁻¹) :=
              mul_le_mul (hR_dom_Pi a b) hm_good_inv_le (inv_nonneg.mpr hm_good_pos.le)
                (mul_nonneg (by positivity) (by split_ifs; exact hPi_nn a b; exact le_rfl))
