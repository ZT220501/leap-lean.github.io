      exact Real.rpow_le_rpow_of_exponent_ge hε₀ hε_le1
        (by linarith only [hu_min, hu_ge, hh, hθ_le_h64])
    have hsv_pos : 0 < s_v := Real.rpow_pos_of_pos hε₀ b_star
    have hsc_pos : 0 < s_c := by dsimp only [s_c]; positivity
    have hsx_pos : 0 < s_x := mul_pos hsc_pos hsv_pos
    have h1_le_θ : 1 ≤ ε ^ (-θ) := by
      calc (1 : ℝ) = ε ^ (0 : ℝ) := (Real.rpow_zero ε).symm
        _ ≤ ε ^ (-θ) := Real.rpow_le_rpow_of_exponent_ge hε₀ hε_le1 (by linarith only [hθ_pos])
    have h1_le_ζ : 1 ≤ ε ^ (-ζ_sh) := by
