      have hk₀_bds : -((⌈B_iso / ε⌉₊ : ℤ) + 1) ≤ k₀ ∧ k₀ ≤ (⌈B_iso / ε⌉₊ : ℤ) := by
        obtain ⟨hx_lo, hx_hi⟩ := abs_le.mp hx₀
        have h_div_ub : B_iso / δ ≤ (⌈B_iso / ε⌉₊ : ℝ) := by
          refine le_trans ?_ (Nat.le_ceil (B_iso / ε))
          exact div_le_div_of_nonneg_left (by linarith) hε₀ hδ_ge
        have h_xdiv_hi : x₀ / δ ≤ (⌈B_iso / ε⌉₊ : ℝ) :=
          le_trans (div_le_div_of_nonneg_right hx_hi hδ_pos.le) h_div_ub
        have h_xdiv_lo : -(⌈B_iso / ε⌉₊ : ℝ) ≤ x₀ / δ := by
          have h1 : -B_iso / δ ≤ x₀ / δ := div_le_div_of_nonneg_right hx_lo hδ_pos.le
          have h2 : -B_iso / δ = -(B_iso / δ) := neg_div δ B_iso
          linarith
        constructor
        · refine Int.le_floor.mpr ?_
          push_cast
          linarith
        · have hfl : ((k₀ : ℤ) : ℝ) ≤ x₀ / δ := Int.floor_le _
          have hle : ((k₀ : ℤ) : ℝ) ≤ ((⌈B_iso / ε⌉₊ : ℤ) : ℝ) := by
            push_cast
            linarith
          exact_mod_cast hle
      have h_in_R : ∀ k ∈ I_s, k ∈ box_R := by
        intro k hk
