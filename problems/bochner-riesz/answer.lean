            (hs := (hW_compact δ_box).measure_lt_top.ne)).mono'
            h_aesm_w.restrict (Filter.Eventually.of_forall fun w => ?_)
          rw [Real.norm_of_nonneg (MeasureTheory.integral_nonneg fun _ => abs_nonneg _)]
