            ρ₀_at⁻¹ • (v - gridPt2D ρ₀_at j)) :=
          (continuous_const (y := ρ₀_at⁻¹)).smul
            (continuous_id.sub (continuous_const (y := gridPt2D ρ₀_at j)))
        have hc_pou : Continuous (fun v : E =>
            (pktPou2D (ρ₀_at⁻¹ • (v - gridPt2D ρ₀_at j)) : ℂ)) :=
          Complex.continuous_ofReal.comp ((h_pou_smooth 0).continuous.comp hc_aff)
