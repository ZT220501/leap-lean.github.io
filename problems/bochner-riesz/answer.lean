      have h_lhs : ∑ z ∈ Z_act, ∑ d : Fin N_D, ∑ q ∈ F_set,
            -(W z q d * Real.log ((p_ZD z d / p_cD d) / ((T_cell z.2).card : ℝ))) =
          (∑ z ∈ Z_act, ∑ d : Fin N_D, -(p_ZD z d * Real.log (p_ZD z d / p_cD d))) +
            (∑ z ∈ Z_act, p_Z z * Real.log ((T_cell z.2).card : ℝ)) := by
        have h_zd : ∀ z ∈ Z_act, ∀ d : Fin N_D,
            ∑ q ∈ F_set, -(W z q d * Real.log ((p_ZD z d / p_cD d) / ((T_cell z.2).card : ℝ))) =
              -(p_ZD z d * Real.log (p_ZD z d / p_cD d)) +
                p_ZD z d * Real.log ((T_cell z.2).card : ℝ) := by
          intro z hz d
          have hTcard_pos := (hZ_act_props z hz).2.2.2.1
          rw [Finset.sum_neg_distrib, ← Finset.sum_mul, hW_sum_q z hz d]
          by_cases hp0 : p_ZD z d = 0
          · simp [hp0]
