          _ = -(q_O s o * (Real.log (α s) + Real.log (p_cd_O s o))) := by rw [hlog_split]
          _ = -(q_O s o * Real.log (α s)) + α s * (-(p_cd_O s o * Real.log (p_cd_O s o))) := by
              rw [hmul_eq]
              ring
    have h_HO_sum : ∑ o : Fin N_O, -(p_O o * Real.log (p_O o)) ≤
        Real.log (M_split : ℝ) +
          ∑ s : Fin M_split, α s * (∑ o : Fin N_O, -(p_cd_O s o * Real.log (p_cd_O s o))) := by
      have h1 : ∑ o : Fin N_O, -(p_O o * Real.log (p_O o)) =
          ∑ s : Fin M_split, ∑ o : Fin N_O, -(q_O s o * Real.log (p_O o)) := by
        rw [Finset.sum_comm]
        refine Finset.sum_congr rfl (fun o _ => ?_)
        rw [Finset.sum_neg_distrib, ← Finset.sum_mul, hqO_sum_s o]
      rw [h1]
      have h2 : ∑ s : Fin M_split, ∑ o : Fin N_O, -(q_O s o * Real.log (p_O o)) ≤
          (∑ s : Fin M_split, -(α s * Real.log (α s))) +
            ∑ s : Fin M_split, α s * (∑ o : Fin N_O, -(p_cd_O s o * Real.log (p_cd_O s o))) := by
        calc ∑ s : Fin M_split, ∑ o : Fin N_O, -(q_O s o * Real.log (p_O o))
            ≤ ∑ s : Fin M_split, ∑ o : Fin N_O,
                (-(q_O s o * Real.log (α s)) + α s * (-(p_cd_O s o * Real.log (p_cd_O s o)))) :=
              Finset.sum_le_sum (fun s _ => Finset.sum_le_sum (fun o _ => h_HO_each s o))
          _ = (∑ s : Fin M_split, -(α s * Real.log (α s))) +
                ∑ s : Fin M_split, α s * (∑ o : Fin N_O, -(p_cd_O s o * Real.log (p_cd_O s o))) := by
              rw [← Finset.sum_add_distrib]
              refine Finset.sum_congr rfl (fun s _ => ?_)
              rw [Finset.sum_add_distrib, ← Finset.mul_sum]
              congr 1
              dsimp [α]
              rw [Finset.sum_mul, ← Finset.sum_neg_distrib]
      have h3 : ∑ s : Fin M_split, -(α s * Real.log (α s)) ≤ Real.log (M_split : ℝ) :=
        h_card_ent_one (Finset.univ : Finset (Fin M_split)) α (M_split : ℝ)
          (fun s _ => hα_nn s) hα_sum (lt_of_lt_of_le zero_lt_one hM_split_real) (by simp)
      linarith only [h2, h3]
    
    have h_HOD_each : ∀ s o d,
        -(q s o d * Real.log (p o d / p_D d)) =
          -(q s o d * Real.log (q_D s d / p_D d)) +
            α s * (-(p_cd s o d * Real.log (p_cd s o d / p_cd_D s d))) := by
      intro s o d
      by_cases hq0 : q s o d = 0
      · dsimp [p_cd]
        rw [hq0]
        by_cases h0 : α s = 0 <;> simp [h0]
      · have hq_pos : 0 < q s o d := lt_of_le_of_ne (hq_nn s o d) (Ne.symm hq0)
        have hq_eq_p : q s o d = p o d := by
          dsimp [q] at hq0 ⊢
          split_ifs at hq0 ⊢ with hbin
          · rfl
          · exact False.elim (hq0 rfl)
        have hqD_ge : q s o d ≤ q_D s d :=
          Finset.single_le_sum (fun o' _ => hq_nn s o' d) (Finset.mem_univ o)
        have hqD_pos : 0 < q_D s d := lt_of_lt_of_le hq_pos hqD_ge
        have hpD_ge : q_D s d ≤ p_D d := by
          rw [← hqD_sum_s d]
          exact Finset.single_le_sum (fun s' _ => hqD_nn s' d) (Finset.mem_univ s)
        have hpD_pos : 0 < p_D d := lt_of_lt_of_le hqD_pos hpD_ge
        have hα_ge : q_D s d ≤ α s := by
          have hα_D : α s = ∑ d' : Fin N_D, q_D s d' := by dsimp [α, q_D]; exact Finset.sum_comm
          rw [hα_D]
          exact Finset.single_le_sum (fun d' _ => hqD_nn s d') (Finset.mem_univ d)
        have hα_pos : 0 < α s := lt_of_lt_of_le hqD_pos hα_ge
        have hpcd_eq : p_cd s o d = q s o d / α s := by dsimp [p_cd]; rw [if_neg hα_pos.ne']
        have hpcdD_eq : p_cd_D s d = q_D s d / α s := by rw [hp_cd_D_eq, if_neg hα_pos.ne']
        have hpcd_pos : 0 < p_cd s o d := by rw [hpcd_eq]; exact div_pos hq_pos hα_pos
        have hpcdD_pos : 0 < p_cd_D s d := by rw [hpcdD_eq]; exact div_pos hqD_pos hα_pos
        have h_ratio : p o d / p_D d =
            (q_D s d / p_D d) * (p_cd s o d / p_cd_D s d) := by
          rw [← hq_eq_p, hpcd_eq, hpcdD_eq]
          field_simp [hqD_pos.ne', hpD_pos.ne', hα_pos.ne']
        have hlog_split : Real.log (p o d / p_D d) =
            Real.log (q_D s d / p_D d) + Real.log (p_cd s o d / p_cd_D s d) := by
          rw [h_ratio]
          exact Real.log_mul (div_pos hqD_pos hpD_pos).ne' (div_pos hpcd_pos hpcdD_pos).ne'
        have hq_mul : q s o d = α s * p_cd s o d := by
          rw [hpcd_eq, mul_div_cancel₀ _ hα_pos.ne']
        rw [hlog_split]
        conv_lhs => rw [hq_mul]
        conv_rhs => enter [1, 1, 1]; rw [hq_mul]
