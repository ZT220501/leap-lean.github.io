    have hlog := Real.log_le_log hσ_min_pos hσ_le
    dsimp only [p_raw, q_raw]
    exact div_le_div_of_nonneg_right (by linarith) hell_pos.le
  have hpq_sum : p_raw + q_raw = 2 * b_t + d + η * (B + A) := by
    have hlog := congrArg Real.log hσ_prod
