        have hZ_eq : Z_of o =
            (q, (Int.floor (inner ℝ (X'_fn o - X_Q) (n_buf q.1) / σ_loc), 0)) := by
          dsimp only [Z_of]
          rw [if_pos hd1]
        rw [hZ_eq]
        refine Finset.mem_biUnion.mpr ⟨q, hq_mem, ?_⟩
        refine Finset.mem_image.mpr
          ⟨(Int.floor (inner ℝ (X'_fn o - X_Q) (n_buf q.1) / σ_loc), 0), ?_, rfl⟩
        exact Finset.mem_image.mpr
          ⟨Int.floor (inner ℝ (X'_fn o - X_Q) (n_buf q.1) / σ_loc), hfloor_mem, rfl⟩
      have hfib_card : ∀ q, (((Fib_Z1 q).image (fun k => (q, k))).card : ℝ) ≤
          C_Z1 * ε ^ (-ζ_sh) := by
        intro q
        have hc_nat : ((Fib_Z1 q).image (fun k => (q, k))).card ≤
            (Finset.Icc (Int.floor (μ_q q - R_Z1)) (Int.floor (μ_q q + R_Z1))).card :=
          le_trans Finset.card_image_le Finset.card_image_le
        have hc_real : (((Fib_Z1 q).image (fun k => (q, k))).card : ℝ) ≤
            ((Finset.Icc (Int.floor (μ_q q - R_Z1)) (Int.floor (μ_q q + R_Z1))).card : ℝ) := by
          exact_mod_cast hc_nat
        have hw : (μ_q q + R_Z1) - (μ_q q - R_Z1) ≤ 2 * R_Z1 := by linarith
        have h_icc := h_card_Icc_floor (by linarith only [hRZ1_nn]) hw
        have h_rz : 2 * R_Z1 + 2 ≤ C_Z1 * ε ^ (-ζ_sh) := by
          dsimp only [R_Z1, C_Z1]
          nlinarith [hB_sys, h1_ζ]
        exact le_trans hc_real (le_trans h_icc h_rz)
      have hcard_bi : (S_ad.image Z_of).card ≤
          ∑ q ∈ F_Q_d, ((Fib_Z1 q).image (fun k => (q, k))).card :=
        le_trans (Finset.card_le_card hsub_Z1) Finset.card_biUnion_le
      have hcard_real : ((S_ad.image Z_of).card : ℝ) ≤
          ∑ q ∈ F_Q_d, (((Fib_Z1 q).image (fun k => (q, k))).card : ℝ) := by
