    have hc_nn : 0 ≤ c_s ω := hc_bds.1
    have h_fl_nn : (0 : ℤ) ≤ ⌊c_s ω * (2 : ℝ) ^ m₁⌋ :=
      Int.floor_nonneg.mpr (mul_nonneg hc_nn (by positivity))
    have h_pow_cast : ((2 ^ m₁ : ℕ) : ℤ) = (2 : ℤ) ^ m₁ := by push_cast; rfl
    have h_cap_nn : (0 : ℤ) ≤ (2 : ℤ) ^ m₁ - 1 := by
      rw [← h_pow_cast]
      omega
    have h_kt_nn : (0 : ℤ) ≤ k_t ω := le_min h_fl_nn h_cap_nn
    have h_kt_lt : k_t ω < ((2 ^ m₁ : ℕ) : ℤ) := by
      have h_le : k_t ω ≤ (2 : ℤ) ^ m₁ - 1 := min_le_right _ _
      rw [← h_pow_cast] at h_le
      omega
    exact Finset.mem_Ico.mpr ⟨h_kt_nn, h_kt_lt⟩
  have h_time_ent : finCondEntropy ε π T_idx k_t ≤ 1 + Real.log 2 / ell := by
    have h_fib := h_cond_ent_fib T_idx k_t (fun _ => S_time) (2 ^ m₁) hm₁_pow_pos
      (fun _ => hS_time_card) hk_t_mem
    have h2_lt_inv : (2 : ℝ) < ε⁻¹ := by
      nlinarith [mul_inv_cancel₀ hε₀.ne', h1_lt_inv]
    have h_rpow : ε ^ (-1 : ℝ) = ε⁻¹ := Real.rpow_neg_one ε
    have h_ceil_gt1 : 1 < ⌈ε ^ (-1 : ℝ)⌉₊ := by
      rw [Nat.lt_ceil]
      push_cast
      rw [h_rpow]
      linarith
    have hm₁_pos : 0 < m₁ := Nat.clog_pos (by norm_num) h_ceil_gt1
    have h_pred_lt : 2 ^ (m₁ - 1) < ⌈ε ^ (-1 : ℝ)⌉₊ :=
      Nat.pow_pred_clog_lt_self (by norm_num) h_ceil_gt1
    have h_pred_le : 2 ^ (m₁ - 1) + 1 ≤ ⌈ε ^ (-1 : ℝ)⌉₊ := Nat.succ_le_of_lt h_pred_lt
    have h_pred_real : ((2 ^ (m₁ - 1) : ℕ) : ℝ) + 1 ≤ (⌈ε ^ (-1 : ℝ)⌉₊ : ℝ) := by
      exact_mod_cast h_pred_le
    have h_ceil_ub : (⌈ε ^ (-1 : ℝ)⌉₊ : ℝ) < ε ^ (-1 : ℝ) + 1 :=
      Nat.ceil_lt_add_one (by rw [h_rpow]; positivity)
    have h_pow_pred_lt : ((2 ^ (m₁ - 1) : ℕ) : ℝ) < ε⁻¹ := by
