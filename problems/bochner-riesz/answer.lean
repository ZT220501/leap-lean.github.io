                    have h_surp : condSurprise ε (π_j_fn (J_fn ω)) (fun _ => ()) (G_loc (J_fn ω)) ω =
                        condSurprise ε π (fun _ => ()) Y ω + Real.log (p_J_fn (J_fn ω)) / ell := by
                      dsimp only [condSurprise]
                      change -(Real.log (finProbAt2 (π_j_fn (J_fn ω)) (fun _ => ()) (G_loc (J_fn ω)) ω /
                          finProbAt (π_j_fn (J_fn ω)) (fun _ => ()) ω)) / ell =
                        -(Real.log (finProbAt2 π (fun _ => ()) Y ω /
                          finProbAt π (fun _ => ()) ω)) / ell + Real.log (p_J_fn (J_fn ω)) / ell
                      rw [hpj_unit, h_prob_unit_π ω, div_one, div_one, hpY_eq,
                        Real.log_div hpY_pos.ne' hpj_pos.ne']
                      ring
                    rw [h_surp, mul_add]
            _ = finCondEntropy ε π (fun _ => ()) Y +
                  ∑ ω : Fin N_ω, π ω * (Real.log (p_J_fn (J_fn ω)) / ell) := by
                  rw [Finset.sum_add_distrib]
                  rfl
            _ = finCondEntropy ε π (fun _ => ()) Y +
                  ∑ j ∈ S_J, (p_J_fn j * Real.log (p_J_fn j)) / ell := by
