      refine Finset.mem_Icc.mpr ⟨?_, ?_⟩ <;> { dsimp [R₀, R_max] at hk_lo hk_hi ⊢; omega }

    let S₀ : Finset MenuType :=
      ((box_0.attach ×ˢ box_0.attach) ×ˢ (box_0.attach ×ˢ box_0.attach)).image
