    have he1 : ‖e_G g‖ = 1 := (hG_adm g).2.2.2
    have hVo := h_ortho (e_G g) (V_part tid - V_G g)
      ((((s.1.1).1 : ℝ) - (K_sub : ℝ)) * (10 * ε ^ (b_G g)))
      ((((s.1.2).1 : ℝ) - (K_sub : ℝ)) * (10 * ε ^ (a_G g))) he1
    have hAo := h_ortho (e_G g) (A_part tid - A_G g)
      ((((s.2.1).1 : ℝ) - (K_sub : ℝ)) * (10 * ε ^ (b_G g)))
      ((((s.2.2).1 : ℝ) - (K_sub : ℝ)) * (10 * ε ^ (a_G g))) he1
    change |inner ℝ (V_part tid - V_D d) (e_G g)| ≤ 10 * ε ^ (b_G g) ∧
      |inner ℝ (V_part tid - V_D d) (perp2D (e_G g))| ≤ 10 * ε ^ (a_G g) ∧
      |inner ℝ (A_part tid - A_D d) (e_G g)| ≤ 10 * ε ^ (b_G g) ∧
      |inner ℝ (A_part tid - A_D d) (perp2D (e_G g))| ≤ 10 * ε ^ (a_G g)
    have hVD_sub : V_part tid - V_D d = (V_part tid - V_G g) -
        (((((s.1.1).1 : ℝ) - (K_sub : ℝ)) * (10 * ε ^ (b_G g))) • e_G g +
         ((((s.1.2).1 : ℝ) - (K_sub : ℝ)) * (10 * ε ^ (a_G g))) • perp2D (e_G g)) :=
      sub_add_eq_sub_sub _ _ _
    have hAD_sub : A_part tid - A_D d = (A_part tid - A_G g) -
        (((((s.2.1).1 : ℝ) - (K_sub : ℝ)) * (10 * ε ^ (b_G g))) • e_G g +
         ((((s.2.2).1 : ℝ) - (K_sub : ℝ)) * (10 * ε ^ (a_G g))) • perp2D (e_G g)) :=
      sub_add_eq_sub_sub _ _ _
    rw [hVD_sub, hAD_sub, hVo.1, hVo.2, hAo.1, hAo.2]
    have hs11 : s.1.1 = idx1D (inner ℝ (V_part tid - V_G g) (e_G g)) (10 * ε ^ (b_G g)) := by
      rw [hs_eq]
    have hs12 : s.1.2 = idx1D (inner ℝ (V_part tid - V_G g) (perp2D (e_G g))) (10 * ε ^ (a_G g)) := by
      rw [hs_eq]
    have hs21 : s.2.1 = idx1D (inner ℝ (A_part tid - A_G g) (e_G g)) (10 * ε ^ (b_G g)) := by
      rw [hs_eq]
    have hs22 : s.2.2 = idx1D (inner ℝ (A_part tid - A_G g) (perp2D (e_G g))) (10 * ε ^ (a_G g)) := by
      rw [hs_eq]
    rw [hs11, hs12, hs21, hs22]
    exact ⟨h_idx1D _ _ hv_e2, h_idx1D _ _ hv_p2, h_idx1D _ _ ha_e2, h_idx1D _ _ ha_p2⟩
  have hqD_nn : ∀ d, 0 ≤ q_D d := fun d => Finset.sum_nonneg (fun tid _ => hq_nn tid d)
  have hqD_fiber_sum : ∀ g : Fin N_G, ∑ s : Box4, q_D (e_idx (g, s)) = p_G g := by
    intro g
    dsimp [q_D]
    rw [Finset.sum_comm]
    simp_rw [hq_apply]
    have h_in : ∀ tid : Fin N_T,
        (∑ s : Box4, if s = s_box tid g then p_TG tid g else 0) = p_TG tid g := by
      intro tid
      simp [Finset.sum_ite_eq']
    simp_rw [h_in]
    exact hpTG_col g
  have hEw_eq : E_w_D = E_w_G := by
    dsimp [E_w_D, E_w_G]
    rw [← e_idx.sum_comp, Fintype.sum_prod_type]
    refine Finset.sum_congr rfl (fun g _ => ?_)
    have hb_eq : ∀ s : Box4, b_D (e_idx (g, s)) = b_G g := by
      intro s; dsimp [b_D]; rw [e_idx.symm_apply_apply]
    have ha_eq : ∀ s : Box4, a_D (e_idx (g, s)) = a_G g := by
      intro s; dsimp [a_D]; rw [e_idx.symm_apply_apply]
    simp_rw [hb_eq, ha_eq, ← Finset.sum_mul, hqD_fiber_sum g]
  have hI_diff : I_TD - I_TG ≤ Real.log (M_sub : ℝ) / ell := by
    have h_pt : ∀ (tid : Fin N_T) (g : Fin N_G) (s : Box4),
        q tid (e_idx (g, s)) *
          Real.log (q tid (e_idx (g, s)) / (p_T tid * q_D (e_idx (g, s)))) -
        q tid (e_idx (g, s)) * Real.log (p_TG tid g / (p_T tid * p_G g)) =
        -(q tid (e_idx (g, s)) * Real.log (q_D (e_idx (g, s)) / p_G g)) := by
      intro tid g s
      by_cases hq0 : q tid (e_idx (g, s)) = 0
      · rw [hq0]
        ring
      · have hq_pos : 0 < q tid (e_idx (g, s)) :=
          lt_of_le_of_ne (hq_nn tid (e_idx (g, s))) (Ne.symm hq0)
        have hs_eq : s = s_box tid g := by
          rw [hq_apply] at hq0
          by_contra hne
          rw [if_neg hne] at hq0
          exact hq0 rfl
        have hq_val : q tid (e_idx (g, s)) = p_TG tid g := by
          rw [hq_apply, if_pos hs_eq]
        have hpTG_pos : 0 < p_TG tid g := hq_val ▸ hq_pos
        have hpT_pos : 0 < p_T tid := by
          refine lt_of_lt_of_le hpTG_pos ?_
          rw [← hpTG_row tid]
          exact Finset.single_le_sum (fun g' _ => hpTG_nn tid g') (Finset.mem_univ g)
        have hpG_pos : 0 < p_G g := by
          refine lt_of_lt_of_le hpTG_pos ?_
          rw [← hpTG_col g]
          exact Finset.single_le_sum (fun tid' _ => hpTG_nn tid' g) (Finset.mem_univ tid)
        have hqD_pos : 0 < q_D (e_idx (g, s)) := by
          refine lt_of_lt_of_le hq_pos ?_
          exact Finset.single_le_sum (fun tid' _ => hq_nn tid' (e_idx (g, s)))
            (Finset.mem_univ tid)
        rw [hq_val,
          Real.log_div (ne_of_gt hpTG_pos) (ne_of_gt (mul_pos hpT_pos hqD_pos)),
          Real.log_mul (ne_of_gt hpT_pos) (ne_of_gt hqD_pos),
          Real.log_div (ne_of_gt hpTG_pos) (ne_of_gt (mul_pos hpT_pos hpG_pos)),
          Real.log_mul (ne_of_gt hpT_pos) (ne_of_gt hpG_pos),
          Real.log_div (ne_of_gt hqD_pos) (ne_of_gt hpG_pos)]
        ring
    have h_num_eq :
        (∑ tid : Fin N_T, ∑ d : Fin N_D,
          q tid d * Real.log (q tid d / (p_T tid * q_D d))) -
        (∑ tid : Fin N_T, ∑ g : Fin N_G,
          p_TG tid g * Real.log (p_TG tid g / (p_T tid * p_G g))) =
        ∑ g : Fin N_G, ∑ s : Box4,
          -(q_D (e_idx (g, s)) * Real.log (q_D (e_idx (g, s)) / p_G g)) := by
      rw [← Finset.sum_sub_distrib]
      have h_tid : ∀ tid : Fin N_T,
          (∑ d : Fin N_D, q tid d * Real.log (q tid d / (p_T tid * q_D d))) -
          (∑ g : Fin N_G, p_TG tid g * Real.log (p_TG tid g / (p_T tid * p_G g))) =
          ∑ g : Fin N_G, ∑ s : Box4,
            -(q tid (e_idx (g, s)) * Real.log (q_D (e_idx (g, s)) / p_G g)) := by
        intro tid
        rw [← e_idx.sum_comp, Fintype.sum_prod_type, ← Finset.sum_sub_distrib]
        refine Finset.sum_congr rfl (fun g _ => ?_)
        have hpTG_expand : p_TG tid g * Real.log (p_TG tid g / (p_T tid * p_G g)) =
            ∑ s : Box4, q tid (e_idx (g, s)) * Real.log (p_TG tid g / (p_T tid * p_G g)) := by
          rw [← Finset.sum_mul]
          congr 1
          simp [hq_apply, Finset.sum_ite_eq']
        rw [hpTG_expand, ← Finset.sum_sub_distrib]
        exact Finset.sum_congr rfl (fun s _ => h_pt tid g s)
      simp_rw [h_tid]
      rw [Finset.sum_comm]
      refine Finset.sum_congr rfl (fun g _ => ?_)
      rw [Finset.sum_comm]
      refine Finset.sum_congr rfl (fun s _ => ?_)
      rw [Finset.sum_neg_distrib, ← Finset.sum_mul]
    have h_num_le :
        ∑ g : Fin N_G, ∑ s : Box4,
          -(q_D (e_idx (g, s)) * Real.log (q_D (e_idx (g, s)) / p_G g)) ≤
        Real.log (M_sub : ℝ) := by
      have h_card_pos : 0 < (Finset.univ : Finset Box4).card := by
        rw [hBox4_card]
        exact hM_sub_pos
      calc ∑ g : Fin N_G, ∑ s : Box4,
            -(q_D (e_idx (g, s)) * Real.log (q_D (e_idx (g, s)) / p_G g))
          ≤ ∑ g : Fin N_G, p_G g * Real.log ((Finset.univ : Finset Box4).card : ℝ) :=
            Finset.sum_le_sum (fun g _ =>
              h_ent_card Finset.univ (fun s => q_D (e_idx (g, s))) (p_G g)
                h_card_pos (fun s _ => hqD_nn (e_idx (g, s))) (hqD_fiber_sum g))
        _ = (∑ g : Fin N_G, p_G g) * Real.log (M_sub : ℝ) := by
            rw [hBox4_card, ← Finset.sum_mul]
        _ = Real.log (M_sub : ℝ) := by rw [hpG_sum, one_mul]
    dsimp [I_TD, I_TG]
    rw [← sub_div, h_num_eq]
    exact div_le_div_of_nonneg_right h_num_le hell_pos.le
  have hs_mem : s_comp ∈ S_root :=
    ⟨N_D, b_D, a_D, e_D, V_D, A_D, q, hd_adm, hq_nn, hq_row, hq_geom, rfl⟩
  have hs_le_sup : s_comp ≤ classicalRootSupremum ε L γ N_ω N_T π T_idx V_part A_part := by
    rw [h_root_eq]
    exact le_csSup h_bdd hs_mem
  rw [h_score_eq]
  have h_comb_div :
      Real.log (M_sub : ℝ) / ell + 2 * (Real.log (3 * B_cl) / ell) =
        (2 * Real.log (3 * B_cl) + Real.log (M_sub : ℝ)) / ell := by
    rw [add_div]
    ring
  dsimp [s_comp] at hs_le_sup
  linarith [hs_le_sup, hEw_eq, hI_diff, hS_t_bound, h_comb_div, h_err_budget]

theorem std_aperture_score_and_root_calculus (γ : ℝ) (hγ₀ : 0 < γ) (hγ₁ : γ < 1) :
    ((2 : ℝ) ∈ ValidClassicalGrowthRates γ →
      ∀ (E_cap δ : ℝ), 0 ≤ E_cap → 0 < δ →
        ∃ ε_univ : ℝ, 0 < ε_univ ∧ ε_univ < 1 / 2 ∧
          ∀ (ε e : ℝ), 0 < ε → ε < ε_univ → 0 ≤ e → e ≤ E_cap →
          ∀ {N_ω N_T : ℕ} (π : Fin N_ω → ℝ) (T_idx : Fin N_ω → Fin N_T)
            (V_part A_part : Fin N_T → EuclideanSpace ℝ (Fin 2))
            (c_s θ_s : Fin N_ω → ℝ),
            IsUnitBallStdLaw π V_part A_part c_s θ_s →
            stdApertureScore ε γ 1 0 e π T_idx V_part A_part c_s θ_s ≤
              classicalRootSupremum ε (1 + e) γ N_ω N_T π T_idx V_part A_part +
                classicalGrowthRate γ + δ) ∧
    (∀ (ε e : ℝ), 0 < ε → ε < 1 / 2 → 0 ≤ e →
      ∀ {N_ω N_T : ℕ} (π : Fin N_ω → ℝ) (T_idx : Fin N_ω → Fin N_T)
        (V_part A_part : Fin N_T → EuclideanSpace ℝ (Fin 2))
        (c_s θ_s : Fin N_ω → ℝ) (ev : Fin N_ω → Bool),
        IsUnitBallStdLaw π V_part A_part c_s θ_s →
        let p_E : ℝ := ∑ ω : Fin N_ω, if ev ω then π ω else 0
        0 < p_E →
        let π_E : Fin N_ω → ℝ := fun ω => if ev ω then π ω / p_E else 0
        IsUnitBallStdLaw π_E V_part A_part c_s θ_s ∧
        (∀ ω : Fin N_ω, 0 < π_E ω → ev ω = true) ∧
        (p_E = 1 ∧
           stdApertureScore ε γ 1 0 e π_E T_idx V_part A_part c_s θ_s -
             classicalRootSupremum ε (1 + e) γ N_ω N_T π_E T_idx V_part A_part =
           stdApertureScore ε γ 1 0 e π T_idx V_part A_part c_s θ_s -
             classicalRootSupremum ε (1 + e) γ N_ω N_T π T_idx V_part A_part ∨
         p_E < 1 ∧
           let π_Ec : Fin N_ω → ℝ := fun ω => if ev ω then 0 else π ω / (1 - p_E)
           IsUnitBallStdLaw π_Ec V_part A_part c_s θ_s ∧
           (stdApertureScore ε γ 1 0 e π T_idx V_part A_part c_s θ_s -
             classicalRootSupremum ε (1 + e) γ N_ω N_T π T_idx V_part A_part) -
             (3 * Real.log 2) / Real.log (ε⁻¹) ≤
             p_E * (stdApertureScore ε γ 1 0 e π_E T_idx V_part A_part c_s θ_s -
               classicalRootSupremum ε (1 + e) γ N_ω N_T π_E T_idx V_part A_part) +
             (1 - p_E) * (stdApertureScore ε γ 1 0 e π_Ec T_idx V_part A_part c_s θ_s -
               classicalRootSupremum ε (1 + e) γ N_ω N_T π_Ec T_idx V_part A_part))) ∧
    (∀ (ε e₁ e₂ : ℝ), 0 < ε → ε < 1 / 2 → 0 ≤ e₁ → 0 ≤ e₂ →
      ∀ {N_ω N_T : ℕ} (π : Fin N_ω → ℝ) (T_idx : Fin N_ω → Fin N_T)
        (V_part A_part : Fin N_T → EuclideanSpace ℝ (Fin 2))
        (c_s θ_s : Fin N_ω → ℝ),
        IsUnitBallStdLaw π V_part A_part c_s θ_s →
        (stdApertureScore ε γ 1 0 e₁ π T_idx V_part A_part c_s θ_s -
          classicalRootSupremum ε (1 + e₁) γ N_ω N_T π T_idx V_part A_part) -
          5 * |e₂ - e₁| - 12 / Real.log (ε⁻¹) ≤
          stdApertureScore ε γ 1 0 e₂ π T_idx V_part A_part c_s θ_s -
            classicalRootSupremum ε (1 + e₂) γ N_ω N_T π T_idx V_part A_part) :=
by
  classical
  have h_ite_iff : ∀ {P Q : Prop} {instP : Decidable P} {instQ : Decidable Q} (a b : ℝ),
      (P ↔ Q) → @ite ℝ P instP a b = @ite ℝ Q instQ a b := by
    intro P Q instP instQ a b hPQ
    by_cases hQ : Q
    · rw [@if_pos _ instP (hPQ.mpr hQ), @if_pos _ instQ hQ]
    · rw [@if_neg _ instP (mt hPQ.mp hQ), @if_neg _ instQ hQ]
  
  have h_fin2 : ∀ i : Fin 2, i = 0 ∨ i = 1 := by
    intro ⟨v, hv⟩
    rcases v with _ | ⟨_ | v⟩
    · left; rfl
    · right; rfl
    · omega
  have h_inner_2D : ∀ x y : EuclideanSpace ℝ (Fin 2),
      inner ℝ x y = x 0 * y 0 + x 1 * y 1 := by
    intro x y
    rw [PiLp.inner_apply, Fin.sum_univ_two]
    simp only [RCLike.inner_apply, conj_trivial]
    ring
  have h_norm_sq_2D : ∀ x : EuclideanSpace ℝ (Fin 2),
      ‖x‖ ^ 2 = x 0 ^ 2 + x 1 ^ 2 := by
    intro x
    rw [PiLp.norm_sq_eq_of_L2, Fin.sum_univ_two]
    simp [Real.norm_eq_abs, sq_abs]
  have h_perp_coord : ∀ e : EuclideanSpace ℝ (Fin 2),
      (perp2D e) 0 = -(e 1) ∧ (perp2D e) 1 = e 0 := by
    intro e
    unfold perp2D
    simp
  have h_orthonorm : ∀ e : EuclideanSpace ℝ (Fin 2), ‖e‖ = 1 →
      ‖perp2D e‖ = 1 ∧
      inner ℝ e e = 1 ∧
      inner ℝ (perp2D e) (perp2D e) = 1 ∧
      inner ℝ e (perp2D e) = 0 ∧
      inner ℝ (perp2D e) e = 0 ∧
      (∀ w : EuclideanSpace ℝ (Fin 2),
        w = (inner ℝ w e) • e + (inner ℝ w (perp2D e)) • perp2D e) ∧
      (∀ α β : ℝ,
        inner ℝ (α • e + β • perp2D e) e = α ∧
        inner ℝ (α • e + β • perp2D e) (perp2D e) = β) := by
    intro e he
    have he_sq : e 0 ^ 2 + e 1 ^ 2 = 1 := by
      rw [← h_norm_sq_2D e, he]
      norm_num
    obtain ⟨hp0, hp1⟩ := h_perp_coord e
    have h_pnorm_sq : ‖perp2D e‖ ^ 2 = 1 := by
      rw [h_norm_sq_2D, hp0, hp1]
      linarith
    have h_pnorm : ‖perp2D e‖ = 1 := by
      nlinarith [norm_nonneg (perp2D e)]
    have hee : inner ℝ e e = 1 := by
      rw [h_inner_2D]
      linarith
    have hpp : inner ℝ (perp2D e) (perp2D e) = 1 := by
      rw [h_inner_2D, hp0, hp1]
      linarith
    have hep : inner ℝ e (perp2D e) = 0 := by
      rw [h_inner_2D, hp0, hp1]
      ring
    have hpe : inner ℝ (perp2D e) e = 0 := by
      rw [h_inner_2D, hp0, hp1]
      ring
    refine ⟨h_pnorm, hee, hpp, hep, hpe, ?_, ?_⟩
    · intro w
      ext i
      rcases h_fin2 i with rfl | rfl
      · simp only [PiLp.add_apply, PiLp.smul_apply, smul_eq_mul, h_inner_2D, hp0, hp1]
        linear_combination -(w 0) * he_sq
      · simp only [PiLp.add_apply, PiLp.smul_apply, smul_eq_mul, h_inner_2D, hp0, hp1]
        linear_combination -(w 1) * he_sq
    · intro α β
      constructor
      · rw [inner_add_left, inner_smul_left, inner_smul_left, hee, hpe]
        simp
      · rw [inner_add_left, inner_smul_left, inner_smul_left, hep, hpp]
        simp
  have h_angUnit_norm : ∀ (ε e : ℝ) (k : ℤ), ‖angUnitVec ε e k‖ = 1 := by
    intro ε e k
    have hsq : ‖angUnitVec ε e k‖ ^ 2 = 1 := by
      rw [h_norm_sq_2D]
      unfold angUnitVec
      simp [Real.cos_sq_add_sin_sq]
    nlinarith [norm_nonneg (angUnitVec ε e k)]
  have h_angUnit_rot : ∀ (ε e₁ e₂ : ℝ) (k₁ k₂ : ℤ),
      let φ₁ := ((k₁ : ℝ) + 1 / 2) * Real.pi * ((2 : ℝ) ^ (dyadicTimeLevel ε e₁))⁻¹
      let φ₂ := ((k₂ : ℝ) + 1 / 2) * Real.pi * ((2 : ℝ) ^ (dyadicTimeLevel ε e₂))⁻¹
      let u₁ := angUnitVec ε e₁ k₁
      let u₂ := angUnitVec ε e₂ k₂
      |inner ℝ u₁ u₂| ≤ 1 ∧
      |inner ℝ (perp2D u₁) (perp2D u₂)| ≤ 1 ∧
      |inner ℝ u₁ (perp2D u₂)| ≤ |φ₂ - φ₁| ∧
      |inner ℝ (perp2D u₁) u₂| ≤ |φ₂ - φ₁| := by
    intro ε e₁ e₂ k₁ k₂ φ₁ φ₂ u₁ u₂
    have hu₁ : ‖u₁‖ = 1 := h_angUnit_norm ε e₁ k₁
    have hu₂ : ‖u₂‖ = 1 := h_angUnit_norm ε e₂ k₂
    have hpu₁ : ‖perp2D u₁‖ = 1 := (h_orthonorm u₁ hu₁).1
    have hpu₂ : ‖perp2D u₂‖ = 1 := (h_orthonorm u₂ hu₂).1
    refine ⟨?_, ?_, ?_, ?_⟩
    · exact (abs_real_inner_le_norm u₁ u₂).trans (by rw [hu₁, hu₂, mul_one])
    · exact (abs_real_inner_le_norm (perp2D u₁) (perp2D u₂)).trans (by rw [hpu₁, hpu₂, mul_one])
    · have h_eq : inner ℝ u₁ (perp2D u₂) = Real.sin (φ₁ - φ₂) := by
        rw [h_inner_2D, (h_perp_coord u₂).1, (h_perp_coord u₂).2, Real.sin_sub]
        dsimp only [u₁, u₂, angUnitVec, φ₁, φ₂]
        simp only [Matrix.cons_val_zero, Matrix.cons_val_one]
        ring
      rw [h_eq, abs_sub_comm φ₂ φ₁]
      exact Real.abs_sin_le_abs
    · have h_eq : inner ℝ (perp2D u₁) u₂ = Real.sin (φ₂ - φ₁) := by
        rw [h_inner_2D, (h_perp_coord u₁).1, (h_perp_coord u₁).2, Real.sin_sub]
        dsimp only [u₁, u₂, angUnitVec, φ₁, φ₂]
        simp only [Matrix.cons_val_zero, Matrix.cons_val_one]
        ring
      rw [h_eq]
      exact Real.abs_sin_le_abs

  
  have h_log2_pos : 0 < Real.log 2 := Real.log_pos (by norm_num)
  have h_log2_le1 : Real.log 2 ≤ 1 := by
    linarith [Real.log_le_sub_one_of_pos (by norm_num : (0 : ℝ) < 2)]
  have h_ell_pos : ∀ ε : ℝ, 0 < ε → ε < 1 / 2 →
      Real.log 2 < Real.log (ε⁻¹) ∧ 0 < Real.log (ε⁻¹) := by
    intro ε hε₀ hε₁
    have h2 : (2 : ℝ) < ε⁻¹ := by
      rw [inv_eq_one_div, lt_div_iff₀ hε₀]
      linarith
    have hlt : Real.log 2 < Real.log (ε⁻¹) := Real.log_lt_log (by norm_num) h2
    exact ⟨hlt, lt_trans h_log2_pos hlt⟩
  have h_dyadicTimeLevel : ∀ (ε u : ℝ), 0 < ε → ε < 1 / 2 → 0 ≤ u →
      ε ^ (-u) ≤ (2 : ℝ) ^ (dyadicTimeLevel ε u) ∧
      (2 : ℝ) ^ (dyadicTimeLevel ε u) < 2 * ε ^ (-u) ∧
      ((2 : ℝ) ^ (dyadicTimeLevel ε u))⁻¹ ≤ ε ^ u := by
    intro ε u hε₀ hε₁ hu
    have hε_le1 : ε ≤ 1 := by linarith
    have h1_le : (1 : ℝ) ≤ ε ^ (-u) := by
      simpa using Real.rpow_le_rpow_of_exponent_ge hε₀ hε_le1 (neg_nonpos.mpr hu)
