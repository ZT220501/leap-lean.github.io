        let i_x := idx ⟨x.1, hQ x.1 x.2⟩
        let obs_x := fun ω : Fin (N_ω k) =>
          (enumL i_x).1.map (fun q => rowObs6 (ε_seq k) m
            (V_seq k (T_seq k ω)) (A_seq k (T_seq k ω)) (c_seq k ω) (R_seq k ω)
            (q.1, q.2.1, q.2.2.1, q.2.2.2.1, q.2.2.2.2))
        ∃ B_u B_c : Finset (Fin (N_ω k)),
          (∑ ω ∈ B_u, π_seq k ω) ≤ 2 * η ∧
          (∑ ω ∈ B_c, π_seq k ω) ≤ 2 * η ∧
          ∀ ω : Fin (N_ω k), 0 < π_seq k ω →
            (ω ∉ B_u →
              |condSurprise (ε_seq k) (π_seq k) (fun _ => ()) obs_x ω -
                (d_u_st (φ k) i_x).1| ≤
                1 / ((φ k : ℝ) + 1) + Real.log (1 / η) / Real.log ((ε_seq k)⁻¹)) ∧
            (ω ∉ B_c →
              |condSurprise (ε_seq k) (π_seq k) (T_seq k) obs_x ω -
                (d_c_st (φ k) i_x).1| ≤
                1 / ((φ k : ℝ) + 1) + Real.log (1 / η) / Real.log ((ε_seq k)⁻¹)) := by
      intro x
      have hi_le_N : idx ⟨x.1, hQ x.1 x.2⟩ ≤ N_idx :=
        Finset.le_sup (f := fun y : { L_l // L_l ∈ Q_fin } => idx ⟨y.1, hQ y.1 y.2⟩)
