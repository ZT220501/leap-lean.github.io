    linarith
  obtain ⟨b₀_rate, hb₀_mem, hb₀_lt⟩ := exists_lt_of_csInf_lt h_ne_cl h_inf_lt
  obtain ⟨ε₁, hε₁_pos, hε₁_lt, h_cl_est⟩ :=
    hb₀_mem.2.2 4 (1 + m) u δ_cl h_1_le_4 (by linarith) hu₀ (by linarith) hδ

  have h_s4 : ∀ (ε : ℝ), 0 < ε → ε < ε₁ →
      ∀ {N_ω N_T : ℕ} {β : Type} [DecidableEq β]
        (π : Fin N_ω → ℝ) (T_idx : Fin N_ω → Fin N_T)
        (V_part A_part : Fin N_T → EuclideanSpace ℝ (Fin 2))
        (c_s : Fin N_ω → ℝ)
        (G_obs : Fin N_ω → β)
        (b_obs a_obs : Fin N_ω → ℝ)
        (e_obs : Fin N_ω → EuclideanSpace ℝ (Fin 2)),
        IsUnitBallTimeLaw π V_part A_part c_s →
        (∀ ω, 0 < π ω →
          0 ≤ b_obs ω ∧ b_obs ω ≤ a_obs ω ∧ a_obs ω + u ≤ 1 + m ∧ ‖e_obs ω‖ = 1) →
        (∀ ω₁ ω₂, 0 < π ω₁ → 0 < π ω₂ → G_obs ω₁ = G_obs ω₂ →
          dyadicTimeBin ε u (c_s ω₁) = dyadicTimeBin ε u (c_s ω₂) ∧
          b_obs ω₁ = b_obs ω₂ ∧ a_obs ω₁ = a_obs ω₂) →
        (∀ ω ω₀, 0 < π ω → 0 < π ω₀ → G_obs ω = G_obs ω₀ →
          |inner ℝ (V_part (T_idx ω) - V_part (T_idx ω₀)) (e_obs ω₀)| ≤
            4 * ε ^ (b_obs ω₀) ∧
          |inner ℝ (V_part (T_idx ω) - V_part (T_idx ω₀)) (perp2D (e_obs ω₀))| ≤
            4 * ε ^ (a_obs ω₀) ∧
          |inner ℝ ((A_part (T_idx ω) + dyadicTimeMid ε u (c_s ω) • V_part (T_idx ω)) -
              (A_part (T_idx ω₀) + dyadicTimeMid ε u (c_s ω₀) • V_part (T_idx ω₀)))
              (e_obs ω₀)| ≤ 4 * ε ^ (b_obs ω₀ + u) ∧
          |inner ℝ ((A_part (T_idx ω) + dyadicTimeMid ε u (c_s ω) • V_part (T_idx ω)) -
              (A_part (T_idx ω₀) + dyadicTimeMid ε u (c_s ω₀) • V_part (T_idx ω₀)))
              (perp2D (e_obs ω₀))| ≤ 4 * ε ^ (a_obs ω₀ + u)) →
        (∑ ω : Fin N_ω, π ω * ((1 + γ) * b_obs ω + (1 - γ) * a_obs ω)) -
          finMutualInfo ε π T_idx G_obs +
          2 * finCondEntropy ε π T_idx (fun ω => dyadicTimeBin ε u (c_s ω)) ≤
          classicalRootSupremum ε (1 + m) γ N_ω N_T π T_idx V_part A_part +
            (classicalGrowthRate γ + 2 * δ_cl) * u := by
    intro ε hε₀ hε_lt₁ N_ω N_T β _ π T_idx V_part A_part c_s G_obs b_obs a_obs e_obs
      h_law h_adm_obs h_const_obs h_tube_obs
    have hε_half : ε < 1 / 2 := lt_trans hε_lt₁ hε₁_lt
    let m_u := dyadicTimeLevel ε u
    let Δ_time : ℝ := ((2 : ℝ) ^ m_u)⁻¹
    let k_time : Fin N_ω → ℤ := fun ω => dyadicTimeBin ε u (c_s ω)
    have h_du := h_dyad_time ε u hε₀ hε_half hu₀.le
