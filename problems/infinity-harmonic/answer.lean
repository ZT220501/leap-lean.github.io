        div_nonneg h_poly_nonneg (by positivity)
      linarith
    have hr_hat_ne : r_hat ≠ 0 := ne_of_gt hr_pos
    have he_norm : ‖e_hat‖ = 1 := by
      simp [e_hat, norm_smul, inv_mul_cancel₀ hr_hat_ne, r_hat]
    have he_inner : inner ℝ e_hat e_hat = 1 := by
      rw [real_inner_self_eq_norm_sq, he_norm, one_pow]
    have hw_perp_orth : inner ℝ e_hat w_perp = 0 := by
      rw [show w_perp = w - s • e_hat from rfl, inner_sub_right, inner_smul_right, he_inner, mul_one]
      exact sub_self s
    have hw_decomp : w = s • e_hat + w_perp := by
      simp [w_perp]
    have hw_hat_eq : w_hat = r_hat • e_hat := by
      simp [e_hat, smul_smul, mul_inv_cancel₀ hr_hat_ne]
    have hw_sq_pyth : ‖w‖ ^ 2 = s ^ 2 + ‖w_perp‖ ^ 2 := by
      calc ‖w‖ ^ 2 = ‖s • e_hat + w_perp‖ ^ 2 := by rw [← hw_decomp]
