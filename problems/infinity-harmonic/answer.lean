    intro w₁ hw₁ w₂ hw₂
    have h1 := (h_shift_cont_lip z_hat p₀ hz_hat).2 w₁ hw₁ w₂ hw₂
    have h_eq : u₃ w₁ - u₃ w₂ = -2 * ((U (z_hat + w₁) - U z_hat - inner ℝ p₀ w₁) -
        (U (z_hat + w₂) - U z_hat - inner ℝ p₀ w₂)) := by
      dsimp only [u₃]; ring
    rw [h_eq, abs_mul, abs_of_neg (by norm_num : (-2 : ℝ) < 0), neg_neg]
    have hM_ge : 2 * (L + ‖p₀‖) ≤ M := by
      dsimp only [M]
      have : 0 ≤ ‖p₁‖ := norm_nonneg _
      have : 0 ≤ ‖p₂‖ := norm_nonneg _
      linarith
    nlinarith [norm_nonneg (w₁ - w₂)]
  obtain ⟨h_le₁, h_attain₁, h_conv₁⟩ := h_sup_spec lam hlam_pos u₁ hu₁_cont
  obtain ⟨h_le₂, h_attain₂, h_conv₂⟩ := h_sup_spec lam hlam_pos u₂ hu₂_cont
  obtain ⟨h_le₃, h_attain₃, h_conv₃⟩ := h_sup_spec lam hlam_pos u₃ hu₃_cont
  have h_sum_le : ∀ ξ₁ ∈ Metric.closedBall (0 : E) (ρ / 2),
      ∀ ξ₂ ∈ Metric.closedBall (0 : E) (ρ / 2),
        ∀ ξ₃ ∈ Metric.closedBall (0 : E) (ρ / 2),
          u_hat₁ ξ₁ + u_hat₂ ξ₂ + u_hat₃ ξ₃ ≤
            threePointQuadForm e_hat (α / 2) (2 * β) (2 * γ) (2 * K) ξ₁ ξ₂ ξ₃ := by
    intro ξ₁ _hξ₁ ξ₂ _hξ₂ ξ₃ _hξ₃
    obtain ⟨w₁, hw₁, hw₁_eq⟩ := h_attain₁ ξ₁
    obtain ⟨w₂, hw₂, hw₂_eq⟩ := h_attain₂ ξ₂
    obtain ⟨w₃, hw₃, hw₃_eq⟩ := h_attain₃ ξ₃
    have h_up := h_upper w₁ hw₁ w₂ hw₂ w₃ hw₃
    have h_qi := h_quad_ineq w₁ w₂ w₃ ξ₁ ξ₂ ξ₃ lam hlam_ge1
    dsimp only [u_hat₁, u_hat₂, u_hat₃]
    rw [hw₁_eq, hw₂_eq, hw₃_eq]
    dsimp only [u₁, u₂, u₃]
    linarith
  have h0_mem_ρ : (0 : E) ∈ Metric.closedBall (0 : E) ρ := by
    rw [Metric.mem_closedBall, dist_self]; linarith
  have h0_mem_half : (0 : E) ∈ Metric.closedBall (0 : E) (ρ / 2) := by
    rw [Metric.mem_closedBall, dist_self]; linarith
  have hu₁0_ge : 0 ≤ u_hat₁ 0 := by
    have h := h_le₁ 0 0 h0_mem_ρ
    dsimp only [u₁, u_hat₁] at h ⊢
    simp only [add_zero, sub_self, inner_zero_right, norm_zero, sq, mul_zero] at h
    exact h
  have hu₂0_ge : 0 ≤ u_hat₂ 0 := by
    have h := h_le₂ 0 0 h0_mem_ρ
    dsimp only [u₂, u_hat₂] at h ⊢
    simp only [add_zero, sub_self, inner_zero_right, norm_zero, sq, mul_zero] at h
    exact h
  have hu₃0_ge : 0 ≤ u_hat₃ 0 := by
    have h := h_le₃ 0 0 h0_mem_ρ
    dsimp only [u₃, u_hat₃] at h ⊢
    simp only [add_zero, sub_self, inner_zero_right, norm_zero, sq, mul_zero] at h
    exact h
  have h_sum0 : u_hat₁ 0 + u_hat₂ 0 + u_hat₃ 0 ≤ 0 := by
    have h := h_sum_le 0 h0_mem_half 0 h0_mem_half 0 h0_mem_half
    have hq0 : threePointQuadForm e_hat (α / 2) (2 * β) (2 * γ) (2 * K) 0 0 0 = 0 := by
      unfold threePointQuadForm
      simp
    linarith
  have hu₁0 : u_hat₁ 0 = 0 := by linarith
  have hu₂0 : u_hat₂ 0 = 0 := by linarith
  have hu₃0 : u_hat₃ 0 = 0 := by linarith
  have h_sub_pos : ∀ (v_hat p : E) (u u_hat : E → ℝ),
      v_hat ∈ Metric.ball (0 : E) (3 / 4) →
      (∀ w : E, u w = U (v_hat + w) - U v_hat - inner ℝ p w) →
      (∀ w₁ ∈ Metric.closedBall (0 : E) ρ, ∀ w₂ ∈ Metric.closedBall (0 : E) ρ,
        |u w₁ - u w₂| ≤ M * ‖w₁ - w₂‖) →
      (∀ ξ : E, ∀ w ∈ Metric.closedBall (0 : E) ρ,
        u w - (lam / 2) * ‖w - ξ‖ ^ 2 ≤ u_hat ξ) →
      (∀ ξ : E, ∃ w₀ ∈ Metric.closedBall (0 : E) ρ,
        u_hat ξ = u w₀ - (lam / 2) * ‖w₀ - ξ‖ ^ 2) →
      HasQuadraticSubsolutionTest u_hat p (ρ / 2) := by
    intro v_hat p u u_hat hv_hat hu_def hu_lip h_le h_attain ξ₀ hξ₀ q X hX_symm ⟨δ_test, hδ_pos, h_touch⟩
    obtain ⟨w₀, r₁, hr₁_pos, hw_ball, hw_touch⟩ :=
      h_transfer M lam δ_test hlam_pos hδ_pos hlam_ge2 u u_hat ξ₀ q X hu_lip h_le h_attain hξ₀ h_touch
    let Z₀ : E := v_hat + w₀
    let V : Set E := Metric.ball Z₀ r₁
    let ϕ : E → ℝ := quadTestFunc (U Z₀) (p + q) Z₀ X
    have hV_sub_w : ∀ Y ∈ V, Y - v_hat ∈ Metric.ball w₀ r₁ := by
      intro Y hY
      rw [Metric.mem_ball, dist_eq_norm] at hY ⊢
      have h_eq : (Y - v_hat) - w₀ = Y - Z₀ := by
        dsimp only [Z₀]; abel
      rwa [h_eq]
    have hV_sub : V ⊆ Metric.ball (0 : E) 1 := by
      intro Y hY
      have hw_in : Y - v_hat ∈ Metric.ball (0 : E) ρ := hw_ball (Y - v_hat) (hV_sub_w Y hY)
      have hw_cb : Y - v_hat ∈ Metric.closedBall (0 : E) ρ := Metric.ball_subset_closedBall hw_in
      have hY_eq : v_hat + (Y - v_hat) = Y := add_sub_cancel v_hat Y
      rw [← hY_eq]
      exact h_ball_in v_hat hv_hat (Y - v_hat) hw_cb
    have hZ₀_in_V : Z₀ ∈ V := Metric.mem_ball_self hr₁_pos
    have hZ₀_in : Z₀ ∈ Metric.ball (0 : E) 1 := hV_sub hZ₀_in_V
    obtain ⟨hϕ_cd, hϕ_lap⟩ := h_quad (U Z₀) (p + q) Z₀ X hX_symm
    have hϕ_Z₀ : ϕ Z₀ = U Z₀ := by
      dsimp only [ϕ, quadTestFunc]
      simp
    have hϕ_ge : ∀ Y ∈ V, U Y ≤ ϕ Y := by
      intro Y hY
      let w : E := Y - v_hat
      have hw_in : w ∈ Metric.ball w₀ r₁ := hV_sub_w Y hY
      have ht := hw_touch w hw_in
      rw [hu_def w, hu_def w₀] at ht
      have hY_eq : v_hat + w = Y := add_sub_cancel v_hat Y
      have hw_sub : w - w₀ = Y - Z₀ := by dsimp only [w, Z₀]; abel
      rw [hY_eq, hw_sub] at ht
      have h_inner : inner ℝ (p + q) (Y - Z₀) =
          inner ℝ p w - inner ℝ p w₀ + inner ℝ q (Y - Z₀) := by
        rw [inner_add_left, ← hw_sub, inner_sub_right]
      dsimp only [ϕ, quadTestFunc, Z₀]
      linarith
    have h_visc := hU_har.2.1 Z₀ hZ₀_in ϕ V Metric.isOpen_ball hZ₀_in_V hV_sub
      hϕ_cd.contDiffOn hϕ_Z₀ hϕ_ge
    rwa [hϕ_lap] at h_visc
  have hsub₁ : HasQuadraticSubsolutionTest u_hat₁ p₁ (ρ / 2) :=
    h_sub_pos x_hat p₁ u₁ u_hat₁ hx_hat (fun _ => rfl) hu₁_lip h_le₁ h_attain₁
  have hsub₂ : HasQuadraticSubsolutionTest u_hat₂ p₂ (ρ / 2) :=
    h_sub_pos y_hat p₂ u₂ u_hat₂ hy_hat (fun _ => rfl) hu₂_lip h_le₂ h_attain₂
  have hsub₃ : HasQuadraticSubsolutionTest u_hat₃ (-(2 : ℝ) • p₀) (ρ / 2) := by
    intro ξ₀ hξ₀ q X hX_symm ⟨δ_test, hδ_pos, h_touch⟩
    obtain ⟨w₀, r₁, hr₁_pos, hw_ball, hw_touch⟩ :=
      h_transfer M lam δ_test hlam_pos hδ_pos hlam_ge2 u₃ u_hat₃ ξ₀ q X hu₃_lip h_le₃ h_attain₃ hξ₀ h_touch
    let Z₀ : E := z_hat + w₀
    let V : Set E := Metric.ball Z₀ r₁
    let b₃ : E := p₀ - (1 / 2 : ℝ) • q
    let X₃ : E →L[ℝ] E := -(1 / 2 : ℝ) • X
    let ψ : E → ℝ := quadTestFunc (U Z₀) b₃ Z₀ X₃
    have hV_sub_w : ∀ Y ∈ V, Y - z_hat ∈ Metric.ball w₀ r₁ := by
      intro Y hY
      rw [Metric.mem_ball, dist_eq_norm] at hY ⊢
      have h_eq : (Y - z_hat) - w₀ = Y - Z₀ := by
        dsimp only [Z₀]; abel
      rwa [h_eq]
    have hV_sub : V ⊆ Metric.ball (0 : E) 1 := by
      intro Y hY
      have hw_in : Y - z_hat ∈ Metric.ball (0 : E) ρ := hw_ball (Y - z_hat) (hV_sub_w Y hY)
      have hw_cb : Y - z_hat ∈ Metric.closedBall (0 : E) ρ := Metric.ball_subset_closedBall hw_in
      have hY_eq : z_hat + (Y - z_hat) = Y := add_sub_cancel z_hat Y
      rw [← hY_eq]
      exact h_ball_in z_hat hz_hat (Y - z_hat) hw_cb
    have hZ₀_in_V : Z₀ ∈ V := Metric.mem_ball_self hr₁_pos
    have hZ₀_in : Z₀ ∈ Metric.ball (0 : E) 1 := hV_sub hZ₀_in_V
    have hX₃_symm : ∀ v w : E, inner ℝ (X₃ v) w = inner ℝ v (X₃ w) := by
      intro v w
      dsimp only [X₃]
      simp only [smul_apply, inner_smul_left, inner_smul_right, RCLike.conj_to_real, hX_symm v w]
    obtain ⟨hψ_cd, hψ_lap⟩ := h_quad (U Z₀) b₃ Z₀ X₃ hX₃_symm
    have hψ_Z₀ : ψ Z₀ = U Z₀ := by
      dsimp only [ψ, quadTestFunc]
      simp
    have hψ_le : ∀ Y ∈ V, ψ Y ≤ U Y := by
      intro Y hY
      let w : E := Y - z_hat
      have hw_in : w ∈ Metric.ball w₀ r₁ := hV_sub_w Y hY
      have ht := hw_touch w hw_in
      dsimp only [u₃] at ht
      have hY_eq : z_hat + w = Y := add_sub_cancel z_hat Y
      have hw_sub : w - w₀ = Y - Z₀ := by dsimp only [w, Z₀]; abel
      rw [hY_eq, hw_sub] at ht
      have h_b₃ : inner ℝ b₃ (Y - Z₀) = inner ℝ p₀ w - inner ℝ p₀ w₀ - (1 / 2 : ℝ) * inner ℝ q (Y - Z₀) := by
        dsimp only [b₃]
        rw [inner_sub_left, inner_smul_left, RCLike.conj_to_real, ← hw_sub, inner_sub_right]
      have h_X₃ : inner ℝ (X₃ (Y - Z₀)) (Y - Z₀) = -(1 / 2 : ℝ) * inner ℝ (X (Y - Z₀)) (Y - Z₀) := by
        dsimp only [X₃]
        simp only [smul_apply, inner_smul_left, RCLike.conj_to_real]
      dsimp only [ψ, quadTestFunc, Z₀]
      rw [h_b₃, h_X₃]
      linarith
    have h_visc := hU_har.2.2 Z₀ hZ₀_in ψ V Metric.isOpen_ball hZ₀_in_V hV_sub
      hψ_cd.contDiffOn hψ_Z₀ hψ_le
    rw [hψ_lap] at h_visc
    have hb₃_eq : b₃ = -(1 / 2 : ℝ) • (-(2 : ℝ) • p₀ + q) := by
      dsimp only [b₃]
      rw [smul_add, smul_smul]
      ext i
      simp only [PiLp.sub_apply, PiLp.smul_apply, PiLp.add_apply, smul_eq_mul]
      ring
    have h_quad_eq : inner ℝ (X₃ b₃) b₃ =
        -(1 / 8 : ℝ) * inner ℝ (X (-(2 : ℝ) • p₀ + q)) (-(2 : ℝ) • p₀ + q) := by
      rw [hb₃_eq]
      dsimp only [X₃]
      simp only [map_neg, map_smul, smul_apply, inner_smul_left, inner_smul_right, RCLike.conj_to_real]
      ring
    linarith
  exact ⟨lam, u_hat₁, u_hat₂, u_hat₃, hlam_pos, hu₁0, hu₂0, hu₃0,
    h_conv₁, h_conv₂, h_conv₃, hsub₁, hsub₂, hsub₃, h_sum_le⟩

theorem convex_proximal_map_and_ae_differentiable (d : ℕ)
    (ψ : EuclideanSpace ℝ (Fin (d + 1)) → ℝ)
    (hψ : ConvexOn ℝ Set.univ ψ) :
    ∃ (J : EuclideanSpace ℝ (Fin (d + 1)) → EuclideanSpace ℝ (Fin (d + 1)))
      (N : Set (EuclideanSpace ℝ (Fin (d + 1)))),
      IsProximalMapFor ψ J ∧
      MeasureTheory.volume N = 0 ∧
      ∀ x : EuclideanSpace ℝ (Fin (d + 1)), x ∉ N →
        ∀ y : EuclideanSpace ℝ (Fin (d + 1)), J y = x → DifferentiableAt ℝ J y :=
by
  let E := EuclideanSpace ℝ (Fin (d + 1))
  have hcont : Continuous ψ := continuousOn_univ.mp (hψ.continuousOn isOpen_univ)
  have hsub : ∀ x : E, ∃ g : E, ∀ w : E, inner ℝ g (w - x) ≤ ψ w - ψ x := by
    intro x
    let U : Set (E × ℝ) := {p | ψ p.1 < p.2}
    have hU_open : IsOpen U := isOpen_lt (hcont.comp continuous_fst) continuous_snd
    have hU_conv : Convex ℝ U := by
      intro p₁ hp₁ p₂ hp₂ a b ha hb hab
      simp only [U, Set.mem_setOf_eq, Prod.fst_add, Prod.smul_fst, Prod.snd_add, Prod.smul_snd,
        smul_eq_mul] at hp₁ hp₂ ⊢
      have h_conv := hψ.2 (Set.mem_univ p₁.1) (Set.mem_univ p₂.1) ha hb hab
      simp only [smul_eq_mul] at h_conv
      rcases eq_or_lt_of_le ha with rfl | ha_pos
      · have hb1 : b = 1 := by linarith
        subst hb1
        linarith
      · have h1 : a * ψ p₁.1 < a * p₁.2 := mul_lt_mul_of_pos_left hp₁ ha_pos
        have h2 : b * ψ p₂.1 ≤ b * p₂.2 := mul_le_mul_of_nonneg_left (le_of_lt hp₂) hb
        linarith
    have hx_not_mem : (x, ψ x) ∉ U := by simp [U]
    obtain ⟨f, hf⟩ := geometric_hahn_banach_point_open hU_conv hU_open hx_not_mem
    have hf_decomp : ∀ (w : E) (t : ℝ), f (w, t) = f (w, 0) + t * f (0, 1) := by
      intro w t
      have h_eq : (w, t) = (w, (0 : ℝ)) + t • ((0 : E), (1 : ℝ)) := by ext <;> simp
      rw [h_eq, map_add, map_smul, smul_eq_mul]
    let c : ℝ := f (0, 1)
    have hc_pos : 0 < c := by
      have h_mem : (x, ψ x + 1) ∈ U := by
        simp only [U, Set.mem_setOf_eq]
        linarith
      have h_lt := hf (x, ψ x + 1) h_mem
      rw [hf_decomp x (ψ x), hf_decomp x (ψ x + 1)] at h_lt
      dsimp [c]
      linarith
    have h_ineq : ∀ w : E, -c⁻¹ * f (w - x, 0) ≤ ψ w - ψ x := by
      intro w
      have h_le : f (x, 0) + ψ x * c ≤ f (w, 0) + ψ w * c := by
        apply le_of_forall_pos_lt_add
        intro ε hε
        have h_mem : (w, ψ w + ε / c) ∈ U := by
          simp only [U, Set.mem_setOf_eq]
          have : 0 < ε / c := div_pos hε hc_pos
          linarith
        have h_lt := hf (w, ψ w + ε / c) h_mem
        rw [hf_decomp x (ψ x), hf_decomp w (ψ w + ε / c)] at h_lt
        change f (x, 0) + ψ x * c < f (w, 0) + (ψ w + ε / c) * c at h_lt
        have h_cancel : (ψ w + ε / c) * c = ψ w * c + ε := by
          have hc_ne : c ≠ 0 := ne_of_gt hc_pos
          field_simp
        linarith
      have h_sub : f (x - w, 0) = f (x, 0) - f (w, 0) := by
        have : (x - w, (0 : ℝ)) = (x, (0 : ℝ)) - (w, (0 : ℝ)) := by ext <;> simp
        rw [this, map_sub]
      have h_neg : f (w - x, 0) = -f (x - w, 0) := by
        have : (w - x, (0 : ℝ)) = -(x - w, (0 : ℝ)) := by ext <;> simp
        rw [this, map_neg]
      have h_bound : -f (w - x, 0) ≤ (ψ w - ψ x) * c := by linarith
      have h_div : -f (w - x, 0) / c ≤ ψ w - ψ x := (div_le_iff₀ hc_pos).mpr h_bound
      have h_lhs : -f (w - x, 0) / c = -c⁻¹ * f (w - x, 0) := by ring
      linarith
    let ℓ : E →L[ℝ] ℝ := (-c⁻¹) • (f.comp (ContinuousLinearMap.inl ℝ E ℝ))
    let g : E := (InnerProductSpace.toDual ℝ E).symm ℓ
    refine ⟨g, fun w => ?_⟩
    have h_dual : inner ℝ g (w - x) = ℓ (w - x) :=
      InnerProductSpace.toDual_symm_apply
    rw [h_dual]
    change (-c⁻¹) * f (w - x, 0) ≤ ψ w - ψ x
    exact h_ineq w
  obtain ⟨g₀, hg₀⟩ := hsub 0
  have hg₀' : ∀ ξ : E, ψ 0 + inner ℝ g₀ ξ ≤ ψ ξ := by
    intro ξ
    have h := hg₀ ξ
    rw [sub_zero] at h
    linarith
  let Φ : E → E → ℝ := fun y ξ => ψ ξ + (1 / 2 : ℝ) * ‖ξ - y‖ ^ 2
  have hΦ_cont : ∀ y : E, Continuous (Φ y) := by
    intro y
    refine hcont.add ?_
    exact continuous_const.mul (((continuous_id.sub continuous_const).norm).pow 2)
  have h_min_ex : ∀ y : E, ∃ z : E, ∀ w : E, Φ y z ≤ Φ y w := by
    intro y
    let y₀ : E := y - g₀
    let R : ℝ := 2 * ‖y₀‖ + 1
    have hR_nonneg : 0 ≤ R := by positivity
    have h_comp : IsCompact (Metric.closedBall (0 : E) R) := isCompact_closedBall (0 : E) R
    have h_ne : (Metric.closedBall (0 : E) R).Nonempty := Metric.nonempty_closedBall.mpr hR_nonneg
    obtain ⟨z, hz_mem, hz_min⟩ := h_comp.exists_isMinOn h_ne (hΦ_cont y).continuousOn
    rw [isMinOn_iff] at hz_min
    have h0_mem : (0 : E) ∈ Metric.closedBall (0 : E) R := Metric.mem_closedBall_self hR_nonneg
    have hz_le_0 : Φ y z ≤ Φ y 0 := hz_min 0 h0_mem
    refine ⟨z, fun w => ?_⟩
    by_cases hw : w ∈ Metric.closedBall (0 : E) R
    · exact hz_min w hw
    · have hw_gt : R < ‖w‖ := by
        simpa [Metric.mem_closedBall, dist_zero_right] using hw
      have h_tri : ‖w‖ ≤ ‖y₀‖ + ‖w - y₀‖ := norm_le_insert' w y₀
      have hw_y₀ : ‖y₀‖ + 1 < ‖w - y₀‖ := by
        dsimp [R] at hw_gt
        linarith
      have h_sq_gt : ‖y₀‖ ^ 2 < ‖w - y₀‖ ^ 2 := by
        have hy₀_nn : 0 ≤ ‖y₀‖ := norm_nonneg y₀
        nlinarith
      have h_id : (1 / 2 : ℝ) * ‖w - y‖ ^ 2 + inner ℝ g₀ w =
          (1 / 2 : ℝ) * ‖w - y₀‖ ^ 2 + (1 / 2 : ℝ) * ‖y‖ ^ 2 - (1 / 2 : ℝ) * ‖y₀‖ ^ 2 := by
        have h1 : ‖w - y‖ ^ 2 = ‖w‖ ^ 2 - 2 * inner ℝ w y + ‖y‖ ^ 2 := norm_sub_sq_real w y
        have h2 : ‖w - y₀‖ ^ 2 = ‖w‖ ^ 2 - 2 * inner ℝ w y₀ + ‖y₀‖ ^ 2 := norm_sub_sq_real w y₀
        have h3 : inner ℝ w y₀ = inner ℝ w y - inner ℝ g₀ w := by
          dsimp [y₀]
          rw [inner_sub_right, real_inner_comm g₀ w]
        linarith
      have hΦ0 : Φ y 0 = ψ 0 + (1 / 2 : ℝ) * ‖y‖ ^ 2 := by
        dsimp [Φ]
        rw [zero_sub, norm_neg]
      have hΦw : Φ y w = ψ w + (1 / 2 : ℝ) * ‖w - y‖ ^ 2 := rfl
      have hg₀_w := hg₀' w
      linarith
  choose J hJ_min using h_min_ex
  have hJ_var : ∀ y w : E, inner ℝ (y - J y) (w - J y) ≤ ψ w - ψ (J y) := by
    intro y w
    let z := J y
    change inner ℝ (y - z) (w - z) ≤ ψ w - ψ z
    apply le_of_forall_pos_lt_add
    intro ε hε
    let t : ℝ := min (1 / 2) (ε / (‖w - z‖ ^ 2 + 1))
    have ht_pos : 0 < t := by positivity
    have ht_le_half : t ≤ 1 / 2 := min_le_left _ _
    have ht_le_eps : t ≤ ε / (‖w - z‖ ^ 2 + 1) := min_le_right _ _
    have h1mt_nonneg : 0 ≤ 1 - t := by linarith
    have ht_nonneg : 0 ≤ t := le_of_lt ht_pos
    let ξ_t : E := (1 - t) • z + t • w
    have h_conv := hψ.2 (Set.mem_univ z) (Set.mem_univ w) h1mt_nonneg ht_nonneg (by ring)
    change ψ ξ_t ≤ (1 - t) * ψ z + t * ψ w at h_conv
    have hξ_sub : ξ_t - y = (z - y) + t • (w - z) := by
      dsimp [ξ_t]
      module
    have h_norm_sq : ‖ξ_t - y‖ ^ 2 =
        ‖z - y‖ ^ 2 - 2 * t * inner ℝ (y - z) (w - z) + t ^ 2 * ‖w - z‖ ^ 2 := by
      rw [hξ_sub, norm_add_sq_real, inner_smul_right, norm_smul, Real.norm_eq_abs,
        abs_of_pos ht_pos, mul_pow]
      have h_in : inner ℝ (z - y) (w - z) = -inner ℝ (y - z) (w - z) := by
        rw [← neg_sub y z, inner_neg_left]
      rw [h_in]
      ring
    have h_min_t : Φ y z ≤ Φ y ξ_t := hJ_min y ξ_t
    dsimp [Φ] at h_min_t
    change ψ z + (1 / 2 : ℝ) * ‖z - y‖ ^ 2 ≤ ψ ξ_t + (1 / 2 : ℝ) * ‖ξ_t - y‖ ^ 2 at h_min_t
    rw [h_norm_sq] at h_min_t
    have h_t_ineq : t * inner ℝ (y - z) (w - z) ≤
        t * (ψ w - ψ z + (t / 2) * ‖w - z‖ ^ 2) := by
      linarith
    have h_div : inner ℝ (y - z) (w - z) ≤ ψ w - ψ z + (t / 2) * ‖w - z‖ ^ 2 :=
      le_of_mul_le_mul_left h_t_ineq ht_pos
    have h_err_lt : (t / 2) * ‖w - z‖ ^ 2 < ε := by
      have h_mul := mul_le_mul_of_nonneg_left ht_le_eps (by positivity : 0 ≤ ‖w - z‖ ^ 2 + 1)
      have h_eq : (‖w - z‖ ^ 2 + 1) * (ε / (‖w - z‖ ^ 2 + 1)) = ε :=
        mul_div_cancel₀ ε (by positivity)
      have h_nonneg : 0 ≤ t * ‖w - z‖ ^ 2 := by positivity
      nlinarith
    linarith
  have hJ_lip : LipschitzWith 1 J := by
    apply LipschitzWith.of_dist_le_mul
    intro y₁ y₂
    rw [NNReal.coe_one, one_mul, dist_eq_norm, dist_eq_norm]
    have h1 := hJ_var y₁ (J y₂)
    have h2 := hJ_var y₂ (J y₁)
    have h_in : inner ℝ (J y₁ - J y₂) (J y₁ - J y₂) ≤ inner ℝ (y₁ - y₂) (J y₁ - J y₂) := by
      have ha : inner ℝ (y₁ - J y₁) (J y₂ - J y₁) =
          -inner ℝ (y₁ - J y₁) (J y₁ - J y₂) := by
        rw [← neg_sub (J y₁) (J y₂), inner_neg_right]
      have hb : inner ℝ ((y₁ - J y₁) - (y₂ - J y₂)) (J y₁ - J y₂) =
          inner ℝ (y₁ - J y₁) (J y₁ - J y₂) - inner ℝ (y₂ - J y₂) (J y₁ - J y₂) :=
        inner_sub_left _ _ _
      have hc : (y₁ - J y₁) - (y₂ - J y₂) = (y₁ - y₂) - (J y₁ - J y₂) := by abel
      rw [hc] at hb
      have hd : inner ℝ ((y₁ - y₂) - (J y₁ - J y₂)) (J y₁ - J y₂) =
          inner ℝ (y₁ - y₂) (J y₁ - J y₂) - inner ℝ (J y₁ - J y₂) (J y₁ - J y₂) :=
        inner_sub_left _ _ _
      linarith
    rw [real_inner_self_eq_norm_sq] at h_in
    have h_cs := real_inner_le_norm (y₁ - y₂) (J y₁ - J y₂)
    have h_sq_le : ‖J y₁ - J y₂‖ ^ 2 ≤ ‖y₁ - y₂‖ * ‖J y₁ - J y₂‖ := le_trans h_in h_cs
    by_contra h_lt
    push_neg at h_lt
    nlinarith [norm_nonneg (J y₁ - J y₂), norm_nonneg (y₁ - y₂)]
  have hJ_surj : ∀ x : E, ∃ y : E, J y = x := by
    intro x
    obtain ⟨g, hg⟩ := hsub x
    let y : E := x + g
    refine ⟨y, ?_⟩
    have h1 := hg (J y)
    have h2 := hJ_var y x
    have hy_sub : y - x = g := add_sub_cancel_left x g
    have h_norm_sq : ‖x - J y‖ ^ 2 ≤ 0 := by
      have ha : inner ℝ g (J y - x) = -inner ℝ (y - x) (x - J y) := by
        rw [hy_sub, ← neg_sub x (J y), inner_neg_right]
      have hb : inner ℝ (y - J y) (x - J y) - inner ℝ (y - x) (x - J y) =
          inner ℝ ((y - J y) - (y - x)) (x - J y) :=
        (inner_sub_left _ _ _).symm
      have hc : (y - J y) - (y - x) = x - J y := by abel
      rw [hc, real_inner_self_eq_norm_sq] at hb
      linarith
    have h_zero : ‖x - J y‖ = 0 := by
      nlinarith [norm_nonneg (x - J y)]
    exact (sub_eq_zero.mp (norm_eq_zero.mp h_zero)).symm
  let μ : MeasureTheory.Measure E := MeasureTheory.volume
  let S_bad : Set E := {y : E | ¬ DifferentiableAt ℝ J y}
  let N : Set E := J '' S_bad
  have hS_null : μ S_bad = 0 := by
    have h_ae : ∀ᵐ y ∂μ, DifferentiableAt ℝ J y := hJ_lip.ae_differentiableAt
    rwa [MeasureTheory.ae_iff] at h_ae
  have hN_null : μ N = 0 := by
    letI : SMul ℝ (Set E) := Set.smulSet
    let A : E →L[ℝ] E := 0
    let m : NNReal := ⟨|A.det| + 1, by positivity⟩
    have hm_coe : (m : ℝ) = |A.det| + 1 := rfl
    have hm_gt : ENNReal.ofReal |A.det| < (m : ENNReal) := by
      rw [← ENNReal.ofReal_coe_nnreal, hm_coe]
      exact (ENNReal.ofReal_lt_ofReal_iff (by positivity)).mpr (by linarith)
    have h_ev := MeasureTheory.addHaar_image_le_mul_of_det_lt μ A hm_gt
    have h_ev_pos : ∀ᶠ δ : NNReal in nhdsWithin 0 (Set.Ioi 0),
        (δ ∈ Set.Ioi (0 : NNReal)) ∧
        ∀ (s : Set E) (f : E → E), ApproximatesLinearOn f A s δ → μ (f '' s) ≤ m * μ s :=
      eventually_mem_nhdsWithin.and h_ev
    haveI : (nhdsWithin (0 : NNReal) (Set.Ioi 0)).NeBot := nhdsWithin_Ioi_neBot le_rfl
    obtain ⟨δ, hδ_pos, hδ_bound⟩ := h_ev_pos.exists
    let g_map : E → E := fun y => (δ : ℝ) • J y
    have h_approx : ApproximatesLinearOn g_map A S_bad δ := by
      rw [ApproximatesLinearOn.approximatesLinearOn_iff_lipschitzOnWith]
      apply LipschitzOnWith.of_dist_le_mul
      intro y₁ _ y₂ _
      simp only [Pi.sub_apply, A, ContinuousLinearMap.zero_apply, sub_zero, g_map]
      rw [dist_eq_norm, ← smul_sub, norm_smul, Real.norm_eq_abs,
        abs_of_nonneg (NNReal.coe_nonneg δ)]
      have h_lip_y := hJ_lip.dist_le_mul y₁ y₂
      rw [NNReal.coe_one, one_mul, dist_eq_norm] at h_lip_y
      exact mul_le_mul_of_nonneg_left h_lip_y (NNReal.coe_nonneg δ)
    have hg_null : μ (g_map '' S_bad) = 0 := by
      have h_le := hδ_bound S_bad g_map h_approx
      rw [hS_null, mul_zero] at h_le
      exact le_antisymm h_le zero_le
    have hg_img : g_map '' S_bad = (δ : ℝ) • N := by
      dsimp [g_map, N]
      rw [← Set.image_smul, Set.image_image]
    rw [hg_img, MeasureTheory.Measure.addHaar_smul] at hg_null
    have h_pow_pos : (0 : ℝ) < |(δ : ℝ) ^ (Module.finrank ℝ E)| := by
      have hδ_real_pos : (0 : ℝ) < (δ : ℝ) := hδ_pos
      positivity
    have h_ofReal_ne : ENNReal.ofReal |(δ : ℝ) ^ (Module.finrank ℝ E)| ≠ 0 := by
      rw [Ne, ENNReal.ofReal_eq_zero]
      linarith
    rcases mul_eq_zero.mp hg_null with h_abs | hN_zero
    · exact False.elim (h_ofReal_ne h_abs)
    · exact hN_zero
  refine ⟨J, N, ⟨hJ_lip, hJ_var, hJ_surj⟩, hN_null, ?_⟩
  intro x hx y hy
  by_contra h_ndiff
  exact hx ⟨y, h_ndiff, hy⟩

theorem second_order_taylor_of_proximal_differentiable (d : ℕ) (lam : ℝ) (hlam : 0 < lam)
    (u : EuclideanSpace ℝ (Fin (d + 1)) → ℝ)
    (J : EuclideanSpace ℝ (Fin (d + 1)) → EuclideanSpace ℝ (Fin (d + 1)))
    (hconv : ConvexOn ℝ Set.univ (fun ξ => u ξ + (lam / 2) * ‖ξ‖ ^ 2))
    (hJ : IsProximalMapFor (fun ξ => u ξ + (lam / 2) * ‖ξ‖ ^ 2) J)
    (ξ₀ q₀ : EuclideanSpace ℝ (Fin (d + 1))) (M₀ δ₀ : ℝ)
    (hM₀ : 0 < M₀) (hδ₀ : 0 < δ₀)
    (hub : ∀ ξ ∈ Metric.ball ξ₀ δ₀,
      u ξ ≤ u ξ₀ + inner ℝ q₀ (ξ - ξ₀) + M₀ * ‖ξ - ξ₀‖ ^ 2)
    (hdiff : ∀ y : EuclideanSpace ℝ (Fin (d + 1)), J y = ξ₀ → DifferentiableAt ℝ J y) :
    ∃ X : EuclideanSpace ℝ (Fin (d + 1)) →L[ℝ] EuclideanSpace ℝ (Fin (d + 1)),
      (∀ v w, inner ℝ (X v) w = inner ℝ v (X w)) ∧
      ∀ κ : ℝ, 0 < κ →
        ∃ δ_test : ℝ, 0 < δ_test ∧
          ∀ ξ ∈ Metric.ball ξ₀ δ_test,
            |u ξ - u ξ₀ - inner ℝ q₀ (ξ - ξ₀) -
              (1 / 2 : ℝ) * inner ℝ (X (ξ - ξ₀)) (ξ - ξ₀)| ≤ (κ / 2) * ‖ξ - ξ₀‖ ^ 2 :=
by
  let ψ : EuclideanSpace ℝ (Fin (d + 1)) → ℝ := fun ξ => u ξ + (lam / 2) * ‖ξ‖ ^ 2
  let g₀ : EuclideanSpace ℝ (Fin (d + 1)) := q₀ + lam • ξ₀
  let M₁ : ℝ := M₀ + lam / 2
  have hM₁ : 0 < M₁ := by positivity
  have hψ_shift : ∀ ξ : EuclideanSpace ℝ (Fin (d + 1)),
      ψ ξ - ψ ξ₀ - inner ℝ g₀ (ξ - ξ₀) =
        (u ξ - u ξ₀ - inner ℝ q₀ (ξ - ξ₀)) + (lam / 2) * ‖ξ - ξ₀‖ ^ 2 := by
    intro ξ
    have h_norm : ‖ξ‖ ^ 2 = ‖ξ₀‖ ^ 2 + 2 * inner ℝ ξ₀ (ξ - ξ₀) + ‖ξ - ξ₀‖ ^ 2 := by
      have h_eq : ξ = ξ₀ + (ξ - ξ₀) := by abel
      conv_lhs => rw [h_eq]
      exact norm_add_sq_real ξ₀ (ξ - ξ₀)
    have h_inner : inner ℝ g₀ (ξ - ξ₀) = inner ℝ q₀ (ξ - ξ₀) + lam * inner ℝ ξ₀ (ξ - ξ₀) := by
      dsimp [g₀]
      rw [inner_add_left, inner_smul_left, RCLike.conj_to_real]
    dsimp [ψ]
    rw [h_norm, h_inner]
    ring
  have hψ_ub : ∀ ξ ∈ Metric.ball ξ₀ δ₀,
      ψ ξ ≤ ψ ξ₀ + inner ℝ g₀ (ξ - ξ₀) + M₁ * ‖ξ - ξ₀‖ ^ 2 := by
    intro ξ hξ
    have hu := hub ξ hξ
    have h_sh := hψ_shift ξ
    dsimp [M₁]
    linarith
  have h_sub : ∀ ξ : EuclideanSpace ℝ (Fin (d + 1)), inner ℝ g₀ (ξ - ξ₀) ≤ ψ ξ - ψ ξ₀ := by
    intro ξ
    by_contra h_lt
    push_neg at h_lt
    let h := ξ - ξ₀
    let Δ := inner ℝ g₀ h - (ψ ξ - ψ ξ₀)
    have hΔ_pos : 0 < Δ := by dsimp [Δ, h]; linarith
    have hh_ne : h ≠ 0 := by
      intro hh0
      have hξ_eq : ξ = ξ₀ := sub_eq_zero.mp hh0
      subst hξ_eq
      simp [h, Δ] at hΔ_pos
    have hh_pos : 0 < ‖h‖ := norm_pos_iff.mpr hh_ne
    let t : ℝ := min (δ₀ / (2 * ‖h‖)) (Δ / (2 * M₁ * ‖h‖ ^ 2))
    have ht_pos : 0 < t := by positivity
    have ht_le1 : t ≤ δ₀ / (2 * ‖h‖) := min_le_left _ _
    have ht_le2 : t ≤ Δ / (2 * M₁ * ‖h‖ ^ 2) := min_le_right _ _
    have ht_norm : t * ‖h‖ ≤ δ₀ / 2 := by
      have := (le_div_iff₀ (by positivity : 0 < 2 * ‖h‖)).mp ht_le1
      linarith
    have ht_Δ : t * (2 * M₁ * ‖h‖ ^ 2) ≤ Δ :=
      (le_div_iff₀ (by positivity : 0 < 2 * M₁ * ‖h‖ ^ 2)).mp ht_le2
    let w := ξ₀ - t • h
    have hw_sub : w - ξ₀ = -(t • h) := by dsimp [w]; abel
    have hw_ball : w ∈ Metric.ball ξ₀ δ₀ := by
      rw [Metric.mem_ball, dist_eq_norm, hw_sub, norm_neg, norm_smul,
        Real.norm_eq_abs, abs_of_pos ht_pos]
      linarith
    have hψ_w := hψ_ub w hw_ball
    have h_inner_w : inner ℝ g₀ (w - ξ₀) = -t * inner ℝ g₀ h := by
      rw [hw_sub, inner_neg_right, inner_smul_right]
      ring
    have h_norm_w : ‖w - ξ₀‖ ^ 2 = t ^ 2 * ‖h‖ ^ 2 := by
      rw [hw_sub, norm_neg, norm_smul, Real.norm_eq_abs, mul_pow, sq_abs]
    rw [h_inner_w, h_norm_w] at hψ_w
    let a : ℝ := t / (1 + t)
    let b : ℝ := 1 / (1 + t)
    have h1t_pos : 0 < 1 + t := by linarith
    have ha_nonneg : 0 ≤ a := by positivity
    have hb_nonneg : 0 ≤ b := by positivity
    have hab : a + b = 1 := by
      dsimp [a, b]
      rw [← add_div, add_comm t 1, div_self (ne_of_gt h1t_pos)]
    have h_comb : a • ξ + b • w = ξ₀ := by
      have hξ_eq : ξ = ξ₀ + h := by dsimp [h]; abel
      rw [hξ_eq]
      dsimp [w]
      have h_ab_t : a - b * t = 0 := by
        dsimp [a, b]
        ring
      calc a • (ξ₀ + h) + b • (ξ₀ - t • h)
        _ = (a + b) • ξ₀ + (a - b * t) • h := by module
        _ = (1 : ℝ) • ξ₀ + (0 : ℝ) • h := by rw [hab, h_ab_t]
        _ = ξ₀ := by simp
    have h_conv_ineq := hconv.2 (Set.mem_univ ξ) (Set.mem_univ w) ha_nonneg hb_nonneg hab
    rw [h_comb] at h_conv_ineq
    have h_mul := mul_le_mul_of_nonneg_left h_conv_ineq (le_of_lt h1t_pos)
    have h_rhs : (1 + t) * (a • ψ ξ + b • ψ w) = t * ψ ξ + ψ w := by
      dsimp [a, b]
      change (1 + t) * (t / (1 + t) * ψ ξ + 1 / (1 + t) * ψ w) = t * ψ ξ + ψ w
      have h_ne : 1 + t ≠ 0 := ne_of_gt h1t_pos
      field_simp
    rw [h_rhs] at h_mul
    change (1 + t) * ψ ξ₀ ≤ t * ψ ξ + ψ w at h_mul
    have h_tΔ : t * Δ ≤ t * (M₁ * ‖h‖ ^ 2 * t) := by
      dsimp [Δ]
      nlinarith
    have h_Δ_le : Δ ≤ M₁ * ‖h‖ ^ 2 * t := le_of_mul_le_mul_left h_tΔ ht_pos
    nlinarith
  have hJ_y0 : J (ξ₀ + g₀) = ξ₀ := by
    let y₀ := ξ₀ + g₀
    let z₀ := J y₀
    have h1 : inner ℝ (y₀ - z₀) (ξ₀ - z₀) ≤ ψ ξ₀ - ψ z₀ := hJ.2.1 y₀ ξ₀
    have h2 : inner ℝ g₀ (z₀ - ξ₀) ≤ ψ z₀ - ψ ξ₀ := h_sub z₀
    have h_sum : inner ℝ (y₀ - z₀) (ξ₀ - z₀) + inner ℝ g₀ (z₀ - ξ₀) ≤ 0 := by linarith
    have h_alg : inner ℝ (y₀ - z₀) (ξ₀ - z₀) + inner ℝ g₀ (z₀ - ξ₀) = ‖ξ₀ - z₀‖ ^ 2 := by
      have hy₀ : y₀ - z₀ = (ξ₀ - z₀) + g₀ := by dsimp [y₀]; abel
      have hz₀ : z₀ - ξ₀ = -(ξ₀ - z₀) := by abel
      rw [hy₀, hz₀, inner_add_left, inner_neg_right, real_inner_self_eq_norm_sq]
      ring
    rw [h_alg] at h_sum
    have h_norm_zero : ‖ξ₀ - z₀‖ = 0 := by
      have h_nonneg : 0 ≤ ‖ξ₀ - z₀‖ ^ 2 := sq_nonneg _
      have h_sq_zero : ‖ξ₀ - z₀‖ ^ 2 = 0 := le_antisymm h_sum h_nonneg
      exact sq_eq_zero_iff.mp h_sq_zero
    exact (sub_eq_zero.mp (norm_eq_zero.mp h_norm_zero)).symm
  have h_rev_lip : ∀ y : EuclideanSpace ℝ (Fin (d + 1)),
      J y ∈ Metric.ball ξ₀ (δ₀ / 2) →
      ‖y - (ξ₀ + g₀)‖ ≤ (1 + 4 * M₁) * ‖J y - ξ₀‖ := by
    intro y hy
    let z := J y
    let v := (y - z) - g₀
    have hz_lt : ‖z - ξ₀‖ < δ₀ / 2 := by simpa [z, Metric.mem_ball, dist_eq_norm] using hy
    have hv_le : ‖v‖ ≤ 4 * M₁ * ‖z - ξ₀‖ := by
      by_contra h_gt
      push_neg at h_gt
      have hv_pos : 0 < ‖v‖ := by
        have : 0 ≤ 4 * M₁ * ‖z - ξ₀‖ := by positivity
        linarith
      let s : ℝ := min (δ₀ / 2) (‖v‖ / (4 * M₁))
      have hs_pos : 0 < s := by positivity
      have hs_le1 : s ≤ δ₀ / 2 := min_le_left _ _
      have hs_le2 : s ≤ ‖v‖ / (4 * M₁) := min_le_right _ _
      have hs_4M1 : 4 * M₁ * s ≤ ‖v‖ := by
        have := (le_div_iff₀ (by positivity : 0 < 4 * M₁)).mp hs_le2
        linarith
      have hz_lt_s : ‖z - ξ₀‖ < s := by
        rw [lt_min_iff]
        refine ⟨hz_lt, ?_⟩
        rw [lt_div_iff₀ (by positivity : 0 < 4 * M₁)]
        linarith
      let t : ℝ := s / ‖v‖
      have ht_pos : 0 < t := by positivity
      have htv : ‖t • v‖ = s := by
        rw [norm_smul, Real.norm_eq_abs, abs_of_pos ht_pos]
        exact div_mul_cancel₀ s (ne_of_gt hv_pos)
      let w := z + t • v
      have hw_sub : w - ξ₀ = (z - ξ₀) + t • v := by dsimp [w]; abel
      have hw_norm_lt_δ₀ : ‖w - ξ₀‖ < δ₀ := by
        have h_tri := norm_add_le (z - ξ₀) (t • v)
        rw [← hw_sub, htv] at h_tri
        linarith
      have hw_norm_lt_2s : ‖w - ξ₀‖ < 2 * s := by
        have h_tri := norm_add_le (z - ξ₀) (t • v)
        rw [← hw_sub, htv] at h_tri
        linarith
      have hw_ball : w ∈ Metric.ball ξ₀ δ₀ := by
        simpa [Metric.mem_ball, dist_eq_norm] using hw_norm_lt_δ₀
      have h1 : inner ℝ (y - z) (w - z) ≤ ψ w - ψ z := hJ.2.1 y w
      have h2 : inner ℝ g₀ (z - ξ₀) ≤ ψ z - ψ ξ₀ := h_sub z
      have h3 : ψ w ≤ ψ ξ₀ + inner ℝ g₀ (w - ξ₀) + M₁ * ‖w - ξ₀‖ ^ 2 := hψ_ub w hw_ball
      have hwz : w - z = t • v := by dsimp [w]; abel
      have hg0_diff : inner ℝ g₀ (w - ξ₀) - inner ℝ g₀ (z - ξ₀) = inner ℝ g₀ (t • v) := by
        rw [← inner_sub_right, hw_sub, add_sub_cancel_left]
      have hv_inner : inner ℝ v (t • v) ≤ M₁ * ‖w - ξ₀‖ ^ 2 := by
        have : inner ℝ v (t • v) = inner ℝ (y - z) (w - z) - inner ℝ g₀ (t • v) := by
          dsimp [v]
          rw [hwz, inner_sub_left]
        linarith
      have hv_inner_eq : inner ℝ v (t • v) = s * ‖v‖ := by
        rw [inner_smul_right, real_inner_self_eq_norm_sq]
        dsimp [t]
        have h_ne : ‖v‖ ≠ 0 := ne_of_gt hv_pos
        field_simp
      have hw_sq_lt : M₁ * ‖w - ξ₀‖ ^ 2 < M₁ * (2 * s) ^ 2 := by
        have h_sq : ‖w - ξ₀‖ ^ 2 < (2 * s) ^ 2 :=
          sq_lt_sq.mpr (by rw [abs_of_nonneg (norm_nonneg _), abs_of_pos (by positivity)]; exact hw_norm_lt_2s)
        exact mul_lt_mul_of_pos_left h_sq hM₁
      nlinarith
    have hy_eq : y - (ξ₀ + g₀) = (z - ξ₀) + v := by dsimp [v, z]; abel
    have h_tri : ‖y - (ξ₀ + g₀)‖ ≤ ‖z - ξ₀‖ + ‖v‖ := by
      rw [hy_eq]
      exact norm_add_le _ _
    linarith
  have hdiff_y0 : DifferentiableAt ℝ J (ξ₀ + g₀) := hdiff (ξ₀ + g₀) hJ_y0
  let y₀ := ξ₀ + g₀
  let C : ℝ := 1 + 4 * M₁
  have hC_pos : 0 < C := by positivity
  let L := fderiv ℝ J y₀
  have hfderiv : HasFDerivAt J L y₀ := hdiff_y0.hasFDerivAt
  have h_inj : Function.Injective L.toLinearMap := by
    intro u₁ u₂ hu
    let v := u₁ - u₂
    have hv : L v = 0 := by
      change L.toLinearMap (u₁ - u₂) = 0
      rw [map_sub, hu, sub_self]
    have hv_zero : v = 0 := by
      by_contra hv_ne
      have hv_pos : 0 < ‖v‖ := norm_pos_iff.mpr hv_ne
      have hc_pos : 0 < 1 / (2 * C) := by positivity
      obtain ⟨r₀, hr₀_pos, hr₀⟩ :=
        Metric.eventually_nhds_iff.mp (hfderiv.isLittleO.bound hc_pos)
      let t : ℝ := min (r₀ / 2) (δ₀ / 4) / ‖v‖
      have ht_pos : 0 < t := by positivity
      let y := y₀ + t • v
      have hy_sub : y - y₀ = t • v := by dsimp [y]; abel
      have hy_norm : ‖y - y₀‖ = min (r₀ / 2) (δ₀ / 4) := by
        rw [hy_sub, norm_smul, Real.norm_eq_abs, abs_of_pos ht_pos]
        exact div_mul_cancel₀ _ (ne_of_gt hv_pos)
      have hy_pos : 0 < ‖y - y₀‖ := by rw [hy_norm]; positivity
      have hy_lt_r₀ : dist y y₀ < r₀ := by
        rw [dist_eq_norm, hy_norm]
        linarith [min_le_left (r₀ / 2) (δ₀ / 4)]
      have hy_lt_δ₀ : ‖y - y₀‖ < δ₀ / 2 := by
        rw [hy_norm]
        linarith [min_le_right (r₀ / 2) (δ₀ / 4)]
      have hJ_lip : ‖J y - ξ₀‖ ≤ ‖y - y₀‖ := by
        have h1 := lipschitzWith_iff_norm_sub_le.mp hJ.1 y y₀
        simpa [y₀, hJ_y0] using h1
      have hJy_ball : J y ∈ Metric.ball ξ₀ (δ₀ / 2) := by
        rw [Metric.mem_ball, dist_eq_norm]
        linarith
      have h_rev := h_rev_lip y hJy_ball
      have h_little := hr₀ hy_lt_r₀
      have hL_yy0 : L (y - y₀) = 0 := by
        rw [hy_sub, map_smul, hv, smul_zero]
      rw [hJ_y0, hL_yy0, sub_zero] at h_little
      have h_comb : ‖y - y₀‖ ≤ C * ((1 / (2 * C)) * ‖y - y₀‖) :=
        le_trans h_rev (mul_le_mul_of_nonneg_left h_little (le_of_lt hC_pos))
      have h_half : C * ((1 / (2 * C)) * ‖y - y₀‖) = (1 / 2 : ℝ) * ‖y - y₀‖ := by
        have : C ≠ 0 := ne_of_gt hC_pos
        field_simp
      linarith
    exact sub_eq_zero.mp hv_zero
  have h_surj : Function.Surjective L.toLinearMap :=
    LinearMap.injective_iff_surjective.mp h_inj
  let L_equiv : EuclideanSpace ℝ (Fin (d + 1)) ≃ₗ[ℝ] EuclideanSpace ℝ (Fin (d + 1)) :=
    LinearEquiv.ofBijective L.toLinearMap ⟨h_inj, h_surj⟩
  let L_inv : EuclideanSpace ℝ (Fin (d + 1)) →L[ℝ] EuclideanSpace ℝ (Fin (d + 1)) :=
    L_equiv.symm.toLinearMap.toContinuousLinearMap
  have hL_left : ∀ u : EuclideanSpace ℝ (Fin (d + 1)), L_inv (L u) = u := by
    intro u
    exact L_equiv.symm_apply_apply u
  let Y : EuclideanSpace ℝ (Fin (d + 1)) → EuclideanSpace ℝ (Fin (d + 1)) :=
    fun z => Classical.choose (hJ.2.2 z)
  have hJY : ∀ z : EuclideanSpace ℝ (Fin (d + 1)), J (Y z) = z :=
    fun z => Classical.choose_spec (hJ.2.2 z)
  let G : EuclideanSpace ℝ (Fin (d + 1)) → EuclideanSpace ℝ (Fin (d + 1)) :=
    fun z => Y z - z
  let H : EuclideanSpace ℝ (Fin (d + 1)) →L[ℝ] EuclideanSpace ℝ (Fin (d + 1)) :=
    L_inv - ContinuousLinearMap.id ℝ (EuclideanSpace ℝ (Fin (d + 1)))
  have hG_sub : ∀ z w : EuclideanSpace ℝ (Fin (d + 1)),
      inner ℝ (G z) (w - z) ≤ ψ w - ψ z := by
    intro z w
    have h := hJ.2.1 (Y z) w
    simpa [G, hJY z] using h
  have hG_exp : ∀ ε : ℝ, 0 < ε →
      ∃ δ₁ : ℝ, 0 < δ₁ ∧
        ∀ z ∈ Metric.ball ξ₀ δ₁,
          ‖G z - g₀ - H (z - ξ₀)‖ ≤ ε * ‖z - ξ₀‖ := by
    intro ε hε
    let c : ℝ := ε / ((‖L_inv‖ + 1) * C)
    have hc_pos : 0 < c := by positivity
    obtain ⟨r₁, hr₁_pos, hr₁⟩ :=
      Metric.eventually_nhds_iff.mp (hfderiv.isLittleO.bound hc_pos)
    let δ₁ : ℝ := min (δ₀ / 2) (r₁ / C)
    have hδ₁_pos : 0 < δ₁ := by positivity
    refine ⟨δ₁, hδ₁_pos, ?_⟩
    intro z hz
    have hz_lt1 : ‖z - ξ₀‖ < δ₀ / 2 := by
      have : ‖z - ξ₀‖ < δ₁ := by simpa [Metric.mem_ball, dist_eq_norm] using hz
      linarith [min_le_left (δ₀ / 2) (r₁ / C)]
    have hz_lt2 : ‖z - ξ₀‖ < r₁ / C := by
      have : ‖z - ξ₀‖ < δ₁ := by simpa [Metric.mem_ball, dist_eq_norm] using hz
      linarith [min_le_right (δ₀ / 2) (r₁ / C)]
    have hJYz_ball : J (Y z) ∈ Metric.ball ξ₀ (δ₀ / 2) := by
      rw [hJY z, Metric.mem_ball, dist_eq_norm]
      exact hz_lt1
    have hYz_rev : ‖Y z - y₀‖ ≤ C * ‖z - ξ₀‖ := by
      have h := h_rev_lip (Y z) hJYz_ball
      simpa [y₀, C, hJY z] using h
    have hYz_lt_r₁ : dist (Y z) y₀ < r₁ := by
      rw [dist_eq_norm]
      have h_lt : ‖z - ξ₀‖ * C < r₁ := (lt_div_iff₀ hC_pos).mp hz_lt2
      linarith
    have h_little := hr₁ hYz_lt_r₁
    have h_id : G z - g₀ - H (z - ξ₀) = -L_inv (J (Y z) - J y₀ - L (Y z - y₀)) := by
      dsimp [G, H, y₀]
      rw [ContinuousLinearMap.sub_apply, ContinuousLinearMap.id_apply, hJY z, hJ_y0,
        L_inv.map_sub (z - ξ₀) (L (Y z - (ξ₀ + g₀))), hL_left (Y z - (ξ₀ + g₀))]
      abel
    rw [h_id, norm_neg]
    have h_op : ‖L_inv (J (Y z) - J y₀ - L (Y z - y₀))‖ ≤
        ‖L_inv‖ * ‖J (Y z) - J y₀ - L (Y z - y₀)‖ :=
      ContinuousLinearMap.le_opNorm L_inv _
    have h_step1 : ‖L_inv‖ * ‖J (Y z) - J y₀ - L (Y z - y₀)‖ ≤ ‖L_inv‖ * (c * ‖Y z - y₀‖) :=
      mul_le_mul_of_nonneg_left h_little (norm_nonneg L_inv)
    have h_step2 : ‖L_inv‖ * (c * ‖Y z - y₀‖) ≤ (‖L_inv‖ + 1) * (c * (C * ‖z - ξ₀‖)) := by
      have h1 : ‖L_inv‖ ≤ ‖L_inv‖ + 1 := by linarith
      have h2 : c * ‖Y z - y₀‖ ≤ c * (C * ‖z - ξ₀‖) :=
        mul_le_mul_of_nonneg_left hYz_rev (le_of_lt hc_pos)
      exact mul_le_mul h1 h2 (by positivity) (by positivity)
    have h_step3 : (‖L_inv‖ + 1) * (c * (C * ‖z - ξ₀‖)) = ε * ‖z - ξ₀‖ := by
      dsimp [c]
      have h_ne1 : ‖L_inv‖ + 1 ≠ 0 := by positivity
      have h_ne2 : C ≠ 0 := ne_of_gt hC_pos
      field_simp
    linarith
  have h_taylor_ψ : ∀ κ : ℝ, 0 < κ →
      ∃ δ_test : ℝ, 0 < δ_test ∧
        ∀ ξ ∈ Metric.ball ξ₀ δ_test,
          |ψ ξ - ψ ξ₀ - inner ℝ g₀ (ξ - ξ₀) -
            (1 / 2 : ℝ) * inner ℝ (H (ξ - ξ₀)) (ξ - ξ₀)| ≤ (κ / 2) * ‖ξ - ξ₀‖ ^ 2 := by
    intro κ hκ
    obtain ⟨N, hN_gt⟩ := exists_nat_gt (max 1 (2 * ‖H‖ / κ))
    have hN_gt1 : (1 : ℝ) < (N : ℝ) := lt_of_le_of_lt (le_max_left _ _) hN_gt
    have hN_pos : (0 : ℝ) < (N : ℝ) := by linarith
    have hN_ne : (N : ℝ) ≠ 0 := ne_of_gt hN_pos
    have hH_N : ‖H‖ / (2 * (N : ℝ)) ≤ κ / 4 := by
      have h_lt : 2 * ‖H‖ / κ < (N : ℝ) := lt_of_le_of_lt (le_max_right _ _) hN_gt
      have h_mul : 2 * ‖H‖ < (N : ℝ) * κ := (div_lt_iff₀ hκ).mp h_lt
      rw [div_le_iff₀ (by positivity : 0 < 2 * (N : ℝ))]
      linarith
    obtain ⟨δ₁, hδ₁_pos, hδ₁⟩ := hG_exp (κ / 4) (by positivity)
    refine ⟨δ₁, hδ₁_pos, ?_⟩
    intro ξ hξ
    let h := ξ - ξ₀
    have hh_lt : ‖h‖ < δ₁ := by simpa [h, Metric.mem_ball, dist_eq_norm] using hξ
    let z : ℕ → EuclideanSpace ℝ (Fin (d + 1)) :=
      fun k => ξ₀ + ((k : ℝ) / (N : ℝ)) • h
    let R : ℕ → EuclideanSpace ℝ (Fin (d + 1)) :=
      fun k => G (z k) - g₀ - H (z k - ξ₀)
    have hz0 : z 0 = ξ₀ := by simp [z]
    have hzN : z N = ξ := by
      dsimp [z, h]
      rw [div_self hN_ne, one_smul, add_sub_cancel]
    have hzk_sub : ∀ k : ℕ, z k - ξ₀ = ((k : ℝ) / (N : ℝ)) • h := by
      intro k; dsimp [z]; abel
    have hzk_step : ∀ k : ℕ, z (k + 1) - z k = (1 / (N : ℝ)) • h := by
      intro k
      dsimp [z]
      have h_alg : (((k + 1 : ℕ) : ℝ) / (N : ℝ)) - ((k : ℝ) / (N : ℝ)) = 1 / (N : ℝ) := by
        push_cast
        ring
      rw [← h_alg, sub_smul]
      abel
    have hRk_bound : ∀ k : ℕ, k ≤ N →
        |inner ℝ (R k) ((1 / (N : ℝ)) • h)| ≤ (κ / (4 * (N : ℝ))) * ‖h‖ ^ 2 := by
      intro k hk
      have hk_nonneg : 0 ≤ (k : ℝ) / (N : ℝ) := by positivity
      have hk_le1 : (k : ℝ) / (N : ℝ) ≤ 1 := by
        rw [div_le_one hN_pos]
        exact_mod_cast hk
      have hzk_norm : ‖z k - ξ₀‖ ≤ ‖h‖ := by
        rw [hzk_sub k, norm_smul, Real.norm_eq_abs, abs_of_nonneg hk_nonneg]
        nlinarith [norm_nonneg h]
      have hzk_ball : z k ∈ Metric.ball ξ₀ δ₁ := by
        rw [Metric.mem_ball, dist_eq_norm]
        linarith
      have hRk_norm : ‖R k‖ ≤ (κ / 4) * ‖h‖ :=
        le_trans (hδ₁ (z k) hzk_ball) (mul_le_mul_of_nonneg_left hzk_norm (by positivity))
      have h_cs := abs_real_inner_le_norm (R k) ((1 / (N : ℝ)) • h)
      have h_step_norm : ‖(1 / (N : ℝ)) • h‖ = (1 / (N : ℝ)) * ‖h‖ := by
        rw [norm_smul, Real.norm_eq_abs, abs_of_pos (by positivity)]
      rw [h_step_norm] at h_cs
      have h_mul := mul_le_mul_of_nonneg_right hRk_norm (by positivity : 0 ≤ (1 / (N : ℝ)) * ‖h‖)
      have h_eq : ((κ / 4) * ‖h‖) * ((1 / (N : ℝ)) * ‖h‖) = (κ / (4 * (N : ℝ))) * ‖h‖ ^ 2 := by ring
      linarith
    have hG_inner : ∀ k : ℕ,
        inner ℝ (G (z k)) ((1 / (N : ℝ)) • h) =
          (1 / (N : ℝ)) * inner ℝ g₀ h +
          ((k : ℝ) / (N : ℝ) ^ 2) * inner ℝ (H h) h +
          inner ℝ (R k) ((1 / (N : ℝ)) • h) := by
      intro k
      have hG_eq : G (z k) = g₀ + H (z k - ξ₀) + R k := by dsimp [R]; abel
      rw [hG_eq, hzk_sub k, map_smul, inner_add_left, inner_add_left,
        inner_smul_right, inner_smul_right, inner_smul_left, RCLike.conj_to_real]
      ring
    have h_step_low : ∀ k ∈ Finset.range N,
        (1 / (N : ℝ)) * inner ℝ g₀ h + ((k : ℝ) / (N : ℝ) ^ 2) * inner ℝ (H h) h -
          (κ / (4 * (N : ℝ))) * ‖h‖ ^ 2 ≤ ψ (z (k + 1)) - ψ (z k) := by
      intro k hk
      have hk_le : k ≤ N := le_of_lt (Finset.mem_range.mp hk)
      have h_sub := hG_sub (z k) (z (k + 1))
      rw [hzk_step k, hG_inner k] at h_sub
      have h_rem := (abs_le.mp (hRk_bound k hk_le)).1
      linarith
    have h_step_high : ∀ k ∈ Finset.range N,
        ψ (z (k + 1)) - ψ (z k) ≤
          (1 / (N : ℝ)) * inner ℝ g₀ h + (((k + 1 : ℕ) : ℝ) / (N : ℝ) ^ 2) * inner ℝ (H h) h +
            (κ / (4 * (N : ℝ))) * ‖h‖ ^ 2 := by
      intro k hk
      have hk1_le : k + 1 ≤ N := Finset.mem_range.mp hk
      have h_sub := hG_sub (z (k + 1)) (z k)
      have h_neg : z k - z (k + 1) = -((1 / (N : ℝ)) • h) := by
        rw [← hzk_step k]; abel
      rw [h_neg, inner_neg_right, hG_inner (k + 1)] at h_sub
      have h_rem := (abs_le.mp (hRk_bound (k + 1) hk1_le)).2
      linarith
    have h_tele : ∑ k ∈ Finset.range N, (ψ (z (k + 1)) - ψ (z k)) = ψ ξ - ψ ξ₀ := by
      rw [Finset.sum_range_sub (fun k => ψ (z k)) N, hzN, hz0]
    have h_sum_k : ∀ n : ℕ,
        ∑ k ∈ Finset.range n,
          ((1 / (N : ℝ)) * inner ℝ g₀ h + ((k : ℝ) / (N : ℝ) ^ 2) * inner ℝ (H h) h -
            (κ / (4 * (N : ℝ))) * ‖h‖ ^ 2) =
        ((n : ℝ) / (N : ℝ)) * inner ℝ g₀ h +
          ((n : ℝ) * ((n : ℝ) - 1) / (2 * (N : ℝ) ^ 2)) * inner ℝ (H h) h -
          ((n : ℝ) * κ / (4 * (N : ℝ))) * ‖h‖ ^ 2 := by
      intro n
      induction n with
      | zero => simp
      | succ n ih =>
        rw [Finset.sum_range_succ, ih]
        push_cast
        ring
    have h_sum_k1 : ∀ n : ℕ,
        ∑ k ∈ Finset.range n,
          ((1 / (N : ℝ)) * inner ℝ g₀ h + (((k + 1 : ℕ) : ℝ) / (N : ℝ) ^ 2) * inner ℝ (H h) h +
            (κ / (4 * (N : ℝ))) * ‖h‖ ^ 2) =
        ((n : ℝ) / (N : ℝ)) * inner ℝ g₀ h +
          ((n : ℝ) * ((n : ℝ) + 1) / (2 * (N : ℝ) ^ 2)) * inner ℝ (H h) h +
          ((n : ℝ) * κ / (4 * (N : ℝ))) * ‖h‖ ^ 2 := by
      intro n
      induction n with
      | zero => simp
      | succ n ih =>
        rw [Finset.sum_range_succ, ih]
        push_cast
        ring
    have h_sum_low := Finset.sum_le_sum h_step_low
    rw [h_tele, h_sum_k N] at h_sum_low
    have h_sum_high := Finset.sum_le_sum h_step_high
    rw [h_tele, h_sum_k1 N] at h_sum_high
    have h_Hh_bound : |inner ℝ (H h) h| ≤ ‖H‖ * ‖h‖ ^ 2 := by
      have h1 := abs_real_inner_le_norm (H h) h
      have h2 : ‖H h‖ * ‖h‖ ≤ (‖H‖ * ‖h‖) * ‖h‖ :=
        mul_le_mul_of_nonneg_right (ContinuousLinearMap.le_opNorm H h) (norm_nonneg h)
      have h3 : (‖H‖ * ‖h‖) * ‖h‖ = ‖H‖ * ‖h‖ ^ 2 := by ring
      linarith
    have h_Hh_div : |inner ℝ (H h) h| / (2 * (N : ℝ)) ≤ (κ / 4) * ‖h‖ ^ 2 := by
      have h1 : |inner ℝ (H h) h| / (2 * (N : ℝ)) ≤ (‖H‖ / (2 * (N : ℝ))) * ‖h‖ ^ 2 := by
        rw [div_mul_eq_mul_div]
        exact div_le_div_of_nonneg_right h_Hh_bound (by positivity)
      have h2 : (‖H‖ / (2 * (N : ℝ))) * ‖h‖ ^ 2 ≤ (κ / 4) * ‖h‖ ^ 2 :=
        mul_le_mul_of_nonneg_right hH_N (sq_nonneg ‖h‖)
      linarith
    have h_alg_low :
        ((N : ℝ) / (N : ℝ)) * inner ℝ g₀ h +
          ((N : ℝ) * ((N : ℝ) - 1) / (2 * (N : ℝ) ^ 2)) * inner ℝ (H h) h -
          ((N : ℝ) * κ / (4 * (N : ℝ))) * ‖h‖ ^ 2 =
        inner ℝ g₀ h + (1 / 2 : ℝ) * inner ℝ (H h) h -
          inner ℝ (H h) h / (2 * (N : ℝ)) - (κ / 4) * ‖h‖ ^ 2 := by
      field_simp
      ring
    have h_alg_high :
        ((N : ℝ) / (N : ℝ)) * inner ℝ g₀ h +
          ((N : ℝ) * ((N : ℝ) + 1) / (2 * (N : ℝ) ^ 2)) * inner ℝ (H h) h +
          ((N : ℝ) * κ / (4 * (N : ℝ))) * ‖h‖ ^ 2 =
        inner ℝ g₀ h + (1 / 2 : ℝ) * inner ℝ (H h) h +
          inner ℝ (H h) h / (2 * (N : ℝ)) + (κ / 4) * ‖h‖ ^ 2 := by
      field_simp
      ring
    rw [h_alg_low] at h_sum_low
    rw [h_alg_high] at h_sum_high
    have h_abs_div : |inner ℝ (H h) h / (2 * (N : ℝ))| ≤ (κ / 4) * ‖h‖ ^ 2 := by
      rw [abs_div, abs_of_pos (by positivity : 0 < 2 * (N : ℝ))]
      exact h_Hh_div
    have h_div_bounds := abs_le.mp h_abs_div
    rw [abs_le]
    dsimp [h] at h_sum_low h_sum_high h_div_bounds
    constructor <;> linarith
  let I_op : EuclideanSpace ℝ (Fin (d + 1)) →L[ℝ] EuclideanSpace ℝ (Fin (d + 1)) :=
    ContinuousLinearMap.id ℝ (EuclideanSpace ℝ (Fin (d + 1)))
  let X : EuclideanSpace ℝ (Fin (d + 1)) →L[ℝ] EuclideanSpace ℝ (Fin (d + 1)) :=
    (1 / 2 : ℝ) • (H + ContinuousLinearMap.adjoint H) - lam • I_op
  refine ⟨X, ?_, ?_⟩
  · intro v w
    dsimp [X, I_op]
    simp only [ContinuousLinearMap.sub_apply, ContinuousLinearMap.smul_apply,
      ContinuousLinearMap.add_apply, ContinuousLinearMap.id_apply,
      inner_sub_left, inner_sub_right, inner_smul_left, inner_smul_right,
      inner_add_left, inner_add_right, RCLike.conj_to_real]
    have h1 : inner ℝ (ContinuousLinearMap.adjoint H v) w = inner ℝ v (H w) :=
      ContinuousLinearMap.adjoint_inner_left H w v
    have h2 : inner ℝ v (ContinuousLinearMap.adjoint H w) = inner ℝ (H v) w :=
      ContinuousLinearMap.adjoint_inner_right H v w
    linarith
  · intro κ hκ
    obtain ⟨δ_test, hδ_test_pos, hδ_test⟩ := h_taylor_ψ κ hκ
    refine ⟨δ_test, hδ_test_pos, ?_⟩
    intro ξ hξ
    have h_t := hδ_test ξ hξ
    have h_sh := hψ_shift ξ
    have h_X_quad : ∀ h : EuclideanSpace ℝ (Fin (d + 1)),
        (1 / 2 : ℝ) * inner ℝ (X h) h =
          (1 / 2 : ℝ) * inner ℝ (H h) h - (lam / 2) * ‖h‖ ^ 2 := by
      intro h
      dsimp [X, I_op]
      simp only [ContinuousLinearMap.sub_apply, ContinuousLinearMap.smul_apply,
        ContinuousLinearMap.add_apply, ContinuousLinearMap.id_apply,
        inner_sub_left, inner_smul_left, inner_add_left, RCLike.conj_to_real,
        real_inner_self_eq_norm_sq]
      have h_adj : inner ℝ (ContinuousLinearMap.adjoint H h) h = inner ℝ (H h) h := by
        rw [ContinuousLinearMap.adjoint_inner_left, real_inner_comm]
      linarith
    have h_X_ξ := h_X_quad (ξ - ξ₀)
    have h_eq : u ξ - u ξ₀ - inner ℝ q₀ (ξ - ξ₀) -
        (1 / 2 : ℝ) * inner ℝ (X (ξ - ξ₀)) (ξ - ξ₀) =
        ψ ξ - ψ ξ₀ - inner ℝ g₀ (ξ - ξ₀) -
        (1 / 2 : ℝ) * inner ℝ (H (ξ - ξ₀)) (ξ - ξ₀) := by
      linarith
    rwa [h_eq]

theorem threePointQuadForm_taylor_and_grad_bounds (d : ℕ)
    (e_hat : EuclideanSpace ℝ (Fin (d + 1)))
    (α' β' γ' K : ℝ)
    (hα' : 0 < α') (hβ' : 0 < β') (hγ' : 0 < γ') (hK : 0 < K) :
    let C_Q : ℝ := 2 * α' * ‖e_hat‖ ^ 2 + 2 * β' * (1 + ‖e_hat‖ ^ 2) ^ 2 + 2 * γ' + K
    0 < C_Q ∧
    (∀ x₁ x₂ x₃ h₁ h₂ h₃ : EuclideanSpace ℝ (Fin (d + 1)),
      threePointQuadForm e_hat α' β' γ' K (x₁ + h₁) (x₂ + h₂) (x₃ + h₃) -
        threePointQuadForm e_hat α' β' γ' K x₁ x₂ x₃ =
        inner ℝ (threePointQuadGrad₁ e_hat α' β' γ' K x₁ x₂ x₃) h₁ +
        inner ℝ (threePointQuadGrad₂ e_hat α' β' γ' K x₁ x₂ x₃) h₂ +
        inner ℝ (threePointQuadGrad₃ γ' K x₁ x₂ x₃) h₃ +
        threePointQuadForm e_hat α' β' γ' K h₁ h₂ h₃) ∧
    (∀ h₁ h₂ h₃ : EuclideanSpace ℝ (Fin (d + 1)),
      |threePointQuadForm e_hat α' β' γ' K h₁ h₂ h₃| ≤
        C_Q * (‖h₁‖ ^ 2 + ‖h₂‖ ^ 2 + ‖h₃‖ ^ 2)) ∧
    (∀ x₁ x₂ x₃ y₁ y₂ y₃ : EuclideanSpace ℝ (Fin (d + 1)),
      ‖threePointQuadGrad₁ e_hat α' β' γ' K x₁ x₂ x₃ -
        threePointQuadGrad₁ e_hat α' β' γ' K y₁ y₂ y₃‖ ≤
