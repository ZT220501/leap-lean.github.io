  have h_proj_diff : projSpace (n_hat - e_b) = (‖P‖⁻¹) • P_x := by
    rw [h_projSpace_sub, h_n_hat_eq, h_projSpace_smul]
    dsimp [e_b, P_x]
    rw [h_projSpace_mk, sub_zero]
