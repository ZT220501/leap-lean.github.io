        2 * (‖y - x_s s‖ ^ 2 * ε_s s) * (t₀ - 4 * ε_s s) := by ring
      have h_prod_nonneg : 0 ≤ (‖y - x_s s‖ ^ 2 * ε_s s) * (t₀ - 4 * ε_s s) :=
        mul_nonneg (by positivity) (by linarith)
      linarith
    have h_cstar : C_star ≤ ‖y - x_s s‖ ^ 2 / (4 * ε_s s) := by
      rw [le_div_iff₀ (by positivity)]
      linarith
    linarith
  have h_minus_s : v z_star - δ ≤ quadEnvelopeMinus d (ε_s s) v (mkSpaceTime (x_s s) t₀) := by
    apply le_csInf
    · exact ⟨_, ⟨x_s s, Set.mem_univ (x_s s), rfl⟩⟩
    · rintro b ⟨y, -, rfl⟩
      rw [h_projSpace, h_projTime]
      by_cases hy : 4 * C_star * ε_s s ≤ ‖y - x_s s‖ ^ 2
      · have hv_b := h_growth_shift y (t₀ - ε_s s) (by linarith) (by linarith)
        have hv_lb : -(C_base + (1 / t₀) * ‖y - x_s s‖ ^ 2) ≤ v (mkSpaceTime y (t₀ - ε_s s)) :=
          (abs_le.mp hv_b).1
        have h_pen_dom := h_pen_dom_far y hy
        have hv_star_le : v z_star ≤ |v z_star| := le_abs_self (v z_star)
        have hW_abs_nonneg : 0 ≤ |W z_star| := abs_nonneg (W z_star)
        dsimp [C_star] at h_pen_dom
        linarith
      · push_neg at hy
        have hy_sq_ρ : ‖y - x_s s‖ ^ 2 < (ρ / 2) ^ 2 := lt_of_lt_of_le hy hε_s_thresh
        have hy_ρ_half : ‖y - x_s s‖ ≤ ρ / 2 := by
          nlinarith [norm_nonneg (y - x_s s)]
        have hy_ρ : ‖y - x_star‖ ≤ ρ := by
          have h_tri : ‖y - x_star‖ ≤ ‖y - x_s s‖ + ‖x_s s - x_star‖ :=
            norm_sub_le_norm_sub_add_norm_sub y (x_s s) x_star
          linarith
        have h_dist : dist (y, t₀ - ε_s s) (x_star, t₀) < ρ₁ := by
          rw [Prod.dist_eq, max_lt_iff, dist_eq_norm, Real.dist_eq]
          have h_sub : t₀ - ε_s s - t₀ = -ε_s s := by ring
          rw [h_sub, abs_neg, abs_of_pos hε_pos]
          have hy_1 : ‖y - x_star‖ ≤ ρ₁ / 2 :=
            le_trans hy_ρ (le_trans (min_le_right _ _) (min_le_left _ _))
          have hε_1 : ε_s s ≤ ρ₁ / 2 :=
            le_trans hε_s_ρ (le_trans (min_le_right _ _) (min_le_left _ _))
          constructor <;> linarith
        have hv_close := hρ₁ h_dist
        rw [Real.dist_eq] at hv_close
        have hv_lb : v z_star - δ < v (mkSpaceTime y (t₀ - ε_s s)) := by
          linarith [(abs_lt.mp hv_close).1]
        have h_pen_nonneg : 0 ≤ ‖y - x_s s‖ ^ 2 / (2 * ε_s s) :=
          div_nonneg (sq_nonneg _) (by linarith)
        linarith
  have h_plus_s : quadEnvelopePlus d (ε_s s) W (mkSpaceTime (x_s s) t₀) ≤ W z_star + δ := by
    apply csSup_le
    · exact ⟨_, ⟨x_s s, Set.mem_univ (x_s s), rfl⟩⟩
    · rintro b ⟨y, -, rfl⟩
      rw [h_projSpace, h_projTime]
      by_cases hy : 4 * C_star * ε_s s ≤ ‖y - x_s s‖ ^ 2
      · have hW_le_v : W (mkSpaceTime y (t₀ + ε_s s)) ≤ v (mkSpaceTime y (t₀ + ε_s s)) :=
          (hW_sand y (t₀ + ε_s s) (by linarith)).2
        have hv_b := h_growth_shift y (t₀ + ε_s s) (by linarith) (by linarith)
        have hv_ub : v (mkSpaceTime y (t₀ + ε_s s)) ≤ C_base + (1 / t₀) * ‖y - x_s s‖ ^ 2 :=
          (abs_le.mp hv_b).2
        have h_pen_dom := h_pen_dom_far y hy
        have hW_star_ge : -|W z_star| ≤ W z_star := neg_abs_le (W z_star)
        have hv_abs_nonneg : 0 ≤ |v z_star| := abs_nonneg (v z_star)
        dsimp [C_star] at h_pen_dom
        linarith
      · push_neg at hy
        have hy_sq_ρ : ‖y - x_s s‖ ^ 2 < (ρ / 2) ^ 2 := lt_of_lt_of_le hy hε_s_thresh
        have hy_ρ_half : ‖y - x_s s‖ ≤ ρ / 2 := by
          nlinarith [norm_nonneg (y - x_s s)]
        have hy_ρ : ‖y - x_star‖ ≤ ρ := by
          have h_tri : ‖y - x_star‖ ≤ ‖y - x_s s‖ + ‖x_s s - x_star‖ :=
            norm_sub_le_norm_sub_add_norm_sub y (x_s s) x_star
          linarith
        have hy_W : ‖y - x_star‖ ≤ ρ_W := le_trans hy_ρ (min_le_right _ _)
        have hε_W : ε_s s ≤ ρ_W := le_trans hε_s_ρ (min_le_right _ _)
        have hW_ub := h_usc y (ε_s s) hy_W hε_pos hε_t₀ hε_W
        have h_pen_nonneg : 0 ≤ ‖y - x_s s‖ ^ 2 / (2 * ε_s s) :=
          div_nonneg (sq_nonneg _) (by linarith)
        linarith
  have h_j_lb : L_low ≤ driftFunctional d κ (ε_s s) v (mkSpaceTime (x_s s) t₀) := (h_seq s).2.2
  dsimp [driftFunctional] at h_j_lb
  have h_two_ε_pos : 0 < 2 * ε_s s := by positivity
  have h_mul_lb : 2 * ε_s s * L_low ≤
      quadEnvelopePlus d (ε_s s) W (mkSpaceTime (x_s s) t₀) -
        quadEnvelopeMinus d (ε_s s) v (mkSpaceTime (x_s s) t₀) := by
    have h1 := (le_div_iff₀ h_two_ε_pos).mp h_j_lb
    linarith
  dsimp [W, z_star, δ] at h_minus_s h_plus_s h_drift_s h_mul_lb
  linarith

theorem localized_contact_scale_of_prelimit_block (d : ℕ) (C₁ κ : ℝ) (hC₁ : 0 ≤ C₁)
    (v : EuclideanSpace ℝ (Fin (d + 1)) → ℝ) (hv_cont : Continuous v)
    (R K L₀ D₀ : ℝ) (M_blk N_seq : ℕ → ℕ) (ε_seq : ℕ → ℝ)
    (x_term : ℕ → EuclideanSpace ℝ (Fin d))
    (x_mk p_mk : ℕ → ℕ → EuclideanSpace ℝ (Fin d))
    (a_mk : ℕ → ℕ → ℝ)
    (h_pre : HasPrelimitWalkContacts d C₁ κ v R K L₀ D₀ M_blk N_seq ε_seq x_term x_mk p_mk a_mk)
    (h_contact : ∀ (j : ℕ) (x_star : EuclideanSpace ℝ (Fin d))
      (x_s : ℕ → EuclideanSpace ℝ (Fin d)) (ε_s : ℕ → ℝ),
      1 ≤ j →
      let δ_j : ℝ := (1 / 2 : ℝ) ^ j
      Filter.Tendsto x_s Filter.atTop (nhds x_star) →
      Filter.Tendsto ε_s Filter.atTop (nhds 0) →
      (∀ s : ℕ, 0 < ε_s s ∧ ε_s s ≤ δ_j / 4 ∧
        L₀ - D₀ * (2 : ℝ) ^ j ≤ driftFunctional d κ (ε_s s) v (mkSpaceTime (x_s s) δ_j)) →
      shiftedBarycentricEnvelope d κ v (mkSpaceTime x_star δ_j) = v (mkSpaceTime x_star δ_j))
    (x_end : EuclideanSpace ℝ (Fin d)) (φ₀ : ℕ → ℕ)
    (hφ₀_mono : StrictMono φ₀)
    (hx_end : Filter.Tendsto (fun r => x_term (φ₀ r)) Filter.atTop (nhds x_end))
    (h : ℕ) (hh : 1 ≤ h) :
    ∃ (j : ℕ) (x p : EuclideanSpace ℝ (Fin d)) (a : ℝ),
      h ≤ j ∧
      let r_j : ℝ := (1 / 2 : ℝ) ^ j
      shiftedBarycentricEnvelope d κ v (mkSpaceTime x r_j) = v (mkSpaceTime x r_j) ∧
      IsFitAt d C₁ v x r_j r_j p a ∧
      ‖x_end - x + r_j • p‖ ≤ K * r_j :=
by
  have h_mk_norm_le : ∀ (y : EuclideanSpace ℝ (Fin d)) (s : ℝ),
      ‖mkSpaceTime y s‖ ≤ ‖y‖ + |s| := by
    intro y s
    have hsq_eq : ‖mkSpaceTime y s‖ ^ 2 = ‖y‖ ^ 2 + |s| ^ 2 := by
      rw [PiLp.norm_sq_eq_of_L2, PiLp.norm_sq_eq_of_L2, Fin.sum_univ_castSucc]
      simp [mkSpaceTime]
    have hsq : ‖mkSpaceTime y s‖ ^ 2 ≤ (‖y‖ + |s|) ^ 2 := by
      rw [hsq_eq]
      nlinarith [norm_nonneg y, abs_nonneg s]
    nlinarith [norm_nonneg (mkSpaceTime y s), norm_nonneg y, abs_nonneg s]
  have h_mk_sub_norm : ∀ (y₁ y₂ : EuclideanSpace ℝ (Fin d)) (τ : ℝ),
      ‖mkSpaceTime y₁ τ - mkSpaceTime y₂ τ‖ = ‖y₁ - y₂‖ := by
    intro y₁ y₂ τ
    have hsq : ‖mkSpaceTime y₁ τ - mkSpaceTime y₂ τ‖ ^ 2 = ‖y₁ - y₂‖ ^ 2 := by
      rw [PiLp.norm_sq_eq_of_L2, PiLp.norm_sq_eq_of_L2, Fin.sum_univ_castSucc]
      simp [mkSpaceTime]
    nlinarith [norm_nonneg (mkSpaceTime y₁ τ - mkSpaceTime y₂ τ), norm_nonneg (y₁ - y₂)]
  have h_tendsto_v_mk : ∀ (y_s : ℕ → EuclideanSpace ℝ (Fin d))
      (y₀ : EuclideanSpace ℝ (Fin d)) (τ : ℝ),
      Filter.Tendsto y_s Filter.atTop (nhds y₀) →
      Filter.Tendsto (fun s => v (mkSpaceTime (y_s s) τ)) Filter.atTop
        (nhds (v (mkSpaceTime y₀ τ))) := by
    intro y_s y₀ τ hy
    have h_mk : Filter.Tendsto (fun s => mkSpaceTime (y_s s) τ) Filter.atTop
        (nhds (mkSpaceTime y₀ τ)) := by
      rw [tendsto_iff_norm_sub_tendsto_zero] at hy ⊢
      simpa [h_mk_sub_norm] using hy
    exact (hv_cont.tendsto (mkSpaceTime y₀ τ)).comp h_mk
  have h_fit_tendsto : ∀ (t r : ℝ) (x p : EuclideanSpace ℝ (Fin d)) (a : ℝ)
      (x_s p_s : ℕ → EuclideanSpace ℝ (Fin d)) (a_s : ℕ → ℝ),
      Filter.Tendsto x_s Filter.atTop (nhds x) →
      Filter.Tendsto p_s Filter.atTop (nhds p) →
      Filter.Tendsto a_s Filter.atTop (nhds a) →
      (∀ s : ℕ, IsFitAt d C₁ v (x_s s) t r (p_s s) (a_s s)) →
      IsFitAt d C₁ v x t r p a := by
    intro t r x p a x_s p_s a_s hx hp ha hfit h_inc ℓ hℓ h_box
    let h_s : ℕ → EuclideanSpace ℝ (Fin d) := fun s => h_inc + ℓ • (p_s s - p)
    have hh_box : ∀ s : ℕ, ‖h_s s - ℓ • p_s s‖ ≤ r := by
      intro s
      have h_eq : h_s s - ℓ • p_s s = h_inc - ℓ • p := by
        dsimp [h_s]
        rw [smul_sub]
        abel
      rw [h_eq]
      exact h_box
    have h_ineq : ∀ s : ℕ,
        |v (mkSpaceTime (x_s s + h_s s) (t + ℓ)) - v (mkSpaceTime (x_s s) t) -
          inner ℝ (p_s s) (h_s s) - (a_s s - ‖p_s s‖ ^ 2 / 2) * ℓ| ≤ C₁ * r :=
      fun s => hfit s (h_s s) ℓ hℓ (hh_box s)
    have hh_lim : Filter.Tendsto h_s Filter.atTop (nhds h_inc) := by
      have h1 : Filter.Tendsto (fun s => p_s s - p) Filter.atTop (nhds (p - p)) :=
        hp.sub tendsto_const_nhds
      rw [sub_self] at h1
      have h2 : Filter.Tendsto (fun s => ℓ • (p_s s - p)) Filter.atTop
          (nhds (ℓ • (0 : EuclideanSpace ℝ (Fin d)))) :=
        tendsto_const_nhds.smul h1
      rw [smul_zero] at h2
      have h3 : Filter.Tendsto h_s Filter.atTop (nhds (h_inc + 0)) :=
        tendsto_const_nhds.add h2
      rwa [add_zero] at h3
    have hv1 : Filter.Tendsto (fun s => v (mkSpaceTime (x_s s + h_s s) (t + ℓ))) Filter.atTop
        (nhds (v (mkSpaceTime (x + h_inc) (t + ℓ)))) :=
      h_tendsto_v_mk (fun s => x_s s + h_s s) (x + h_inc) (t + ℓ) (hx.add hh_lim)
    have hv2 : Filter.Tendsto (fun s => v (mkSpaceTime (x_s s) t)) Filter.atTop
        (nhds (v (mkSpaceTime x t))) :=
      h_tendsto_v_mk x_s x t hx
    have h_inner : Filter.Tendsto (fun s => inner ℝ (p_s s) (h_s s)) Filter.atTop
        (nhds (inner ℝ p h_inc)) :=
      hp.inner hh_lim
    have h_time : Filter.Tendsto (fun s => (a_s s - ‖p_s s‖ ^ 2 / 2) * ℓ) Filter.atTop
        (nhds ((a - ‖p‖ ^ 2 / 2) * ℓ)) :=
      (ha.sub ((hp.norm.pow 2).div_const 2)).mul tendsto_const_nhds
    have h_lhs : Filter.Tendsto
        (fun s => |v (mkSpaceTime (x_s s + h_s s) (t + ℓ)) - v (mkSpaceTime (x_s s) t) -
          inner ℝ (p_s s) (h_s s) - (a_s s - ‖p_s s‖ ^ 2 / 2) * ℓ|)
        Filter.atTop
        (nhds |v (mkSpaceTime (x + h_inc) (t + ℓ)) - v (mkSpaceTime x t) -
          inner ℝ p h_inc - (a - ‖p‖ ^ 2 / 2) * ℓ|) :=
      (((hv1.sub hv2).sub h_inner).sub h_time).abs
    exact le_of_tendsto h_lhs (Filter.Eventually.of_forall h_ineq)
  have h_fit_bounds : ∀ (B_x t r : ℝ), 0 < r →
      ∃ (P_r A_r : ℝ), 0 ≤ P_r ∧ 0 ≤ A_r ∧
        ∀ (x p : EuclideanSpace ℝ (Fin d)) (a : ℝ),
          ‖x‖ ≤ B_x → IsFitAt d C₁ v x t r p a → ‖p‖ ≤ P_r ∧ |a| ≤ A_r := by
    intro B_x t r hr
    have h_bdd_v : ∀ ρ : ℝ, ∃ M_ρ : ℝ, 0 ≤ M_ρ ∧
        ∀ (y : EuclideanSpace ℝ (Fin d)) (s : ℝ),
          ‖y‖ + |s| ≤ ρ → |v (mkSpaceTime y s)| ≤ M_ρ := by
      intro ρ
      have h_comp : IsCompact (Metric.closedBall (0 : EuclideanSpace ℝ (Fin (d + 1))) ρ) :=
        ProperSpace.isCompact_closedBall 0 ρ
      obtain ⟨M', hM'⟩ := h_comp.bddAbove_image hv_cont.abs.continuousOn
      refine ⟨max M' 0, le_max_right M' 0, fun y s hys => ?_⟩
      have h_mem : mkSpaceTime y s ∈ Metric.closedBall (0 : EuclideanSpace ℝ (Fin (d + 1))) ρ := by
        rw [Metric.mem_closedBall, dist_zero_right]
        exact (h_mk_norm_le y s).trans hys
      exact (hM' ⟨mkSpaceTime y s, h_mem, rfl⟩).trans (le_max_left M' 0)
    let ρ₁ : ℝ := B_x + r + |t|
    obtain ⟨M₁, hM₁_nonneg, hM₁⟩ := h_bdd_v ρ₁
    let P_r : ℝ := 2 * M₁ / r + C₁
    have hP_r_nonneg : 0 ≤ P_r := by positivity
    let ρ₂ : ℝ := B_x + r * P_r + |t| + r
    obtain ⟨M₂, hM₂_nonneg, hM₂⟩ := h_bdd_v ρ₂
    let A_r : ℝ := 2 * M₂ / r + C₁ + P_r ^ 2 / 2
    have hA_r_nonneg : 0 ≤ A_r := by positivity
    refine ⟨P_r, A_r, hP_r_nonneg, hA_r_nonneg, fun x p a hx hfit => ?_⟩
    have hp_le : ‖p‖ ≤ P_r := by
      by_cases hp0 : ‖p‖ = 0
      · linarith
      · have hp_pos : 0 < ‖p‖ := lt_of_le_of_ne (norm_nonneg p) (Ne.symm hp0)
        let h_inc : EuclideanSpace ℝ (Fin d) := (r / ‖p‖) • p
        have hh_norm : ‖h_inc‖ = r := by
          dsimp [h_inc]
          rw [norm_smul, Real.norm_of_nonneg (by positivity), div_mul_cancel₀ r hp0]
        have hℓ0 : |(0 : ℝ)| ≤ r := by simp [le_of_lt hr]
        have hh_box : ‖h_inc - (0 : ℝ) • p‖ ≤ r := by simp [hh_norm]
        have h_eval := hfit h_inc 0 hℓ0 hh_box
        have h_inner : inner ℝ p h_inc = r * ‖p‖ := by
          dsimp [h_inc]
          rw [real_inner_smul_right, real_inner_self_eq_norm_sq]
          field_simp
        have hv1 : |v (mkSpaceTime (x + h_inc) t)| ≤ M₁ := by
          apply hM₁
          have h_tri : ‖x + h_inc‖ ≤ ‖x‖ + ‖h_inc‖ := norm_add_le x h_inc
          rw [hh_norm] at h_tri
          dsimp [ρ₁]
          linarith
        have hv2 : |v (mkSpaceTime x t)| ≤ M₁ := by
          apply hM₁
          dsimp [ρ₁]
          linarith
        rw [add_zero, h_inner, mul_zero, sub_zero] at h_eval
        have h1 := (abs_le.mp h_eval).1
        have h2 := (abs_le.mp hv1).2
        have h3 := (abs_le.mp hv2).1
        have h_mul : ‖p‖ * r ≤ P_r * r := by
          have hPr : P_r * r = 2 * M₁ + C₁ * r := by
            dsimp [P_r]
            have hr_ne : r ≠ 0 := ne_of_gt hr
            field_simp
          linarith
        exact le_of_mul_le_mul_right h_mul hr
    have ha_le : |a| ≤ A_r := by
      let h_inc : EuclideanSpace ℝ (Fin d) := r • p
      have hℓr : |r| ≤ r := by rw [abs_of_pos hr]
      have hh_box : ‖h_inc - r • p‖ ≤ r := by
        dsimp [h_inc]
        rw [sub_self, norm_zero]
        exact le_of_lt hr
      have h_eval := hfit h_inc r hℓr hh_box
      have h_inner : inner ℝ p h_inc = r * ‖p‖ ^ 2 := by
        dsimp [h_inc]
        rw [real_inner_smul_right, real_inner_self_eq_norm_sq]
      have hv1 : |v (mkSpaceTime (x + h_inc) (t + r))| ≤ M₂ := by
        apply hM₂
        have h_tri : ‖x + h_inc‖ ≤ ‖x‖ + ‖h_inc‖ := norm_add_le x h_inc
        have hh_norm : ‖h_inc‖ ≤ r * P_r := by
          dsimp [h_inc]
          rw [norm_smul, Real.norm_of_nonneg (le_of_lt hr)]
