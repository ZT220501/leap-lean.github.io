  have h_Px_bound : ‖P_x‖ ≤ Real.sqrt 32 * (L + 1) * B * Real.sqrt lam := by
    have h1 : ‖P‖ * ‖n_hat - e_b‖ ≤ (L + 1) * (B * Real.sqrt (32 * lam)) :=
      mul_le_mul hP_upper h_dir_hat (norm_nonneg _) (by linarith)
    rw [h_sqrt32_mul] at h1
    linarith
  have h_inner_n_eb : inner ℝ n_hat e_b = (‖P‖⁻¹) * P_t := by
    dsimp [e_b]
    rw [h_inner_split n_hat (mkSpaceTime 0 1), h_projSpace_mk, h_projTime_mk,
