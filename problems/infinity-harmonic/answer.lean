  have h_P_eq_cN : ‖P‖ = c * N := by
    rw [← h_P_hat_norm, ← h_cQ, norm_smul, Real.norm_of_nonneg (le_of_lt hc_pos)]
  have hA_le_N : A ≤ N := by
    have h1 : |projTime Q| ≤ N := h_abs_projTime_le Q
    dsimp [Q] at h1
    rw [h_projTime_mk, abs_of_pos hA_pos] at h1
    exact h1
  have hN_pos : 0 < N := by linarith
  have hN_ne : N ≠ 0 := ne_of_gt hN_pos
  have hN_le_32A : N ≤ (3 / 2) * A := by
    have h1 : N ≤ ‖Real.sqrt lam • p'‖ + |A| := h_norm_mk_le (Real.sqrt lam • p') A
    rw [norm_smul, Real.norm_of_nonneg (le_of_lt hsqrt_pos), abs_of_pos hA_pos] at h1
    linarith
  have h_n_hat_Q : n_hat = N⁻¹ • Q := by
    rw [h_n_hat_eq, ← h_cQ, h_P_eq_cN, smul_smul]
