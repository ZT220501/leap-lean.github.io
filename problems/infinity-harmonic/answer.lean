          rw [hs_n_eq]
          dsimp [ε']
          have h4 : 4 * ε ≤ z.2 := by linarith
          have := mul_le_mul_of_nonneg_left h4 (inv_nonneg.mpr (le_of_lt hδ_j_pos))
          linarith
        have hs_lt8 : fittedRelTime d R j z_mk z < 8 := by
          rw [hs_n_eq]
          have hz_lt8' : z.2 < 8 * δ_j := hz_lt8
          have := mul_lt_mul_of_pos_left hz_lt8' (inv_pos.mpr hδ_j_pos)
          have h_cancel : δ_j⁻¹ * (8 * δ_j) = 8 := by
            rw [mul_comm (8 : ℝ) δ_j, ← mul_assoc, inv_mul_cancel₀ (ne_of_gt hδ_j_pos), one_mul]
          linarith
        have h_vel : ‖Q_zero z.1 z.2 ε - p_sel j z_mk.1‖ ≤
            M_vel + C_vel * |Real.log (fittedRelTime d R j z_mk z)| := by
          have hK2 : (2 : ℝ) ≤ K := by linarith
          have hε_r : ε ≤ δ_j := by linarith
          have hε_t : ε < z.2 := by linarith
          have hz_lt8' : z.2 < 8 * δ_j := hz_lt8
          have ht_Kr : z.2 ≤ K * δ_j := by nlinarith
          have hx_Kr : ‖z.1 - z_mk.1 - (z.2 - δ_j) • p_sel j z_mk.1‖ ≤ K * δ_j := by
            have hy_norm : δ_j⁻¹ * ‖z.1 - z_mk.1 - (z.2 - δ_j) • p_sel j z_mk.1‖ < K := by
              have hy' := hy_ltK
              dsimp [fittedRelPos] at hy'
              have h_mk_t' : z_mk.2 = δ_j := h_mk_t
              rw [h_mk_t', norm_smul, Real.norm_of_nonneg (inv_nonneg.mpr (le_of_lt hδ_j_pos))] at hy'
              exact hy'
            have h_mul := mul_lt_mul_of_pos_left hy_norm hδ_j_pos
            rw [← mul_assoc, mul_inv_cancel₀ (ne_of_gt hδ_j_pos), one_mul] at h_mul
            linarith
          have h_q := hQ_vel δ_j z_mk.1 (p_sel j z_mk.1) (a_sel j z_mk.1) hδ_j_pos
            (hp_sel j z_mk.1) K ε z.1 z.2 hK2 hε_pos hε_r hε_t ht_Kr hx_Kr
          have h_div : z.2 / δ_j = fittedRelTime d R j z_mk z := by
            rw [hs_n_eq, div_eq_inv_mul]
          rw [h_div] at h_q
          dsimp [M_vel]
          linarith
        exact ⟨h_y_step, h_s_step, h_4eps, hs_lt8, h_vel⟩
      · intro h_inact
        cases h_mk_act : isWalkActive d δ_j R (stoppedWalk d Q_plus Q_minus ε δ_j R h ω n)
        · have hz_mk_next : stoppedWalk d Q_plus Q_minus ε δ_j R h ω (n + 1) =
              stoppedWalk d Q_plus Q_minus ε δ_j R h ω n := by
            dsimp only [stoppedWalk]
            rw [h_mk_act]
            rfl
          have hz_next : postMarkWalk d Q_plus Q_minus p_sel ε δ_N R j K h ω (n + 1) =
              postMarkWalk d Q_plus Q_minus p_sel ε δ_N R j K h ω n := by
            dsimp only [postMarkWalk]
            change (if (isWalkActive d δ_j R (stoppedWalk d Q_plus Q_minus ε δ_j R h ω n) ||
                isPostMarkActive d p_sel δ_N R j K
                  (stoppedWalk d Q_plus Q_minus ε δ_j R h ω n)
                  (postMarkWalk d Q_plus Q_minus p_sel ε δ_N R j K h ω n)) then _ else _) = _
            rw [h_mk_act, h_inact]
            rfl
          rw [hz_mk_next, hz_next]
          exact ⟨rfl, rfl⟩
        · have hn_eq := h_pre_couple n ω h_mk_act
          have hn1_eq : postMarkWalk d Q_plus Q_minus p_sel ε δ_N R j K h ω (n + 1) =
              stoppedWalk d Q_plus Q_minus ε δ_j R h ω (n + 1) := by
            dsimp only [postMarkWalk, stoppedWalk]
            change (if (isWalkActive d δ_j R (stoppedWalk d Q_plus Q_minus ε δ_j R h ω n) ||
                isPostMarkActive d p_sel δ_N R j K
                  (stoppedWalk d Q_plus Q_minus ε δ_j R h ω n)
                  (postMarkWalk d Q_plus Q_minus p_sel ε δ_N R j K h ω n)) then _ else _) = _
            rw [h_mk_act, Bool.true_or, hn_eq]
          rw [hn_eq, hn1_eq, h_diag_pos, h_diag_pos, h_diag_time, h_diag_time]
          exact ⟨rfl, rfl⟩
    have hε'_le : ε' ≤ 1 / 4 := by
      dsimp [ε']
      have h4 : ε ≤ δ_j / 4 := by linarith
      have := mul_le_mul_of_nonneg_left h4 (inv_nonneg.mpr (le_of_lt hδ_j_pos))
      have h_cancel : δ_j⁻¹ * (δ_j / 4) = 1 / 4 := by
        rw [div_eq_mul_inv, ← mul_assoc, inv_mul_cancel₀ (ne_of_gt hδ_j_pos), one_mul, one_div]
      linarith
    have h_time_bdd : ∀ (n : ℕ) (ω : Fin h → Bool),
        0 < fittedRelTime d R j
          (stoppedWalk d Q_plus Q_minus ε δ_j R h ω n)
          (postMarkWalk d Q_plus Q_minus p_sel ε δ_N R j K h ω n) ∧
        fittedRelTime d R j
          (stoppedWalk d Q_plus Q_minus ε δ_j R h ω n)
          (postMarkWalk d Q_plus Q_minus p_sel ε δ_N R j K h ω n) ≤ 9 := by
      intro n
      induction n with
      | zero =>
        intro ω
        rw [(h_init ω).2]
        norm_num
      | succ n ih =>
        intro ω
        obtain ⟨ih_pos, ih_le⟩ := ih ω
        obtain ⟨h_act_branch, h_inact_branch⟩ := h_step_all n ω
        cases h_act : isPostMarkActive d p_sel δ_N R j K
            (stoppedWalk d Q_plus Q_minus ε δ_j R h ω n)
            (postMarkWalk d Q_plus Q_minus p_sel ε δ_N R j K h ω n)
        · obtain ⟨_, hs_eq⟩ := h_inact_branch h_act
          rw [hs_eq]
          exact ⟨ih_pos, ih_le⟩
        · obtain ⟨_, hs_eq, h4eps, hs_lt8, _⟩ := h_act_branch h_act
          rw [hs_eq]
          split_ifs
          · constructor <;> linarith
          · constructor <;> linarith
    refine ⟨h_init, ?_, fun ω => h_time_bdd h ω⟩
    intro n _ ω
    obtain ⟨h_act_branch, h_inact_branch⟩ := h_step_all n ω
    refine ⟨fun h_act => ?_, h_inact_branch⟩
    obtain ⟨hy, hs, h4, _, hvel⟩ := h_act_branch h_act
    exact ⟨hy, hs, h4, hvel⟩
  obtain ⟨h_init, h_step, h_s_bdd⟩ := h_s3
  let z_mk_fn : ℕ → (Fin h → Bool) → EuclideanSpace ℝ (Fin d) × ℝ :=
    fun n ω => stoppedWalk d Q_plus Q_minus ε δ_j R h ω n
  let z_fn : ℕ → (Fin h → Bool) → EuclideanSpace ℝ (Fin d) × ℝ :=
    fun n ω => postMarkWalk d Q_plus Q_minus p_sel ε δ_N R j K h ω n
  let y_fn : ℕ → (Fin h → Bool) → EuclideanSpace ℝ (Fin d) :=
    fun n ω => fittedRelPos d p_sel j (z_mk_fn n ω) (z_fn n ω)
  let s_fn : ℕ → (Fin h → Bool) → ℝ :=
    fun n ω => fittedRelTime d R j (z_mk_fn n ω) (z_fn n ω)
  let act_fn : ℕ → (Fin h → Bool) → Bool :=
    fun n ω => isPostMarkActive d p_sel δ_N R j K (z_mk_fn n ω) (z_fn n ω)
  let q_plus_fn : ℕ → (Fin h → Bool) → EuclideanSpace ℝ (Fin d) :=
    fun n ω => Q_plus (z_fn n ω).1 (z_fn n ω).2 ε - p_sel j (z_mk_fn n ω).1
  let q_minus_fn : ℕ → (Fin h → Bool) → EuclideanSpace ℝ (Fin d) :=
    fun n ω => Q_minus (z_fn n ω).1 (z_fn n ω).2 ε - p_sel j (z_mk_fn n ω).1
  let q_zero_fn : ℕ → (Fin h → Bool) → EuclideanSpace ℝ (Fin d) :=
    fun n ω => Q_zero (z_fn n ω).1 (z_fn n ω).2 ε - p_sel j (z_mk_fn n ω).1
  have h_flip_all : ∀ k n, k ≤ n → n < h → ∀ ω,
      y_fn k (flipBit h n ω) = y_fn k ω ∧
      s_fn k (flipBit h n ω) = s_fn k ω ∧
      act_fn k (flipBit h n ω) = act_fn k ω ∧
      q_zero_fn k (flipBit h n ω) = q_zero_fn k ω := by
    intro k n hkn hnh ω
    obtain ⟨h1, h2⟩ := h_flip k n hkn hnh ω
    dsimp only [y_fn, s_fn, act_fn, q_zero_fn, z_mk_fn, z_fn]
    rw [h1, h2]
    exact ⟨rfl, rfl, rfl, rfl⟩
  have h_trav := h_travel h ε' 9 M_vel C_vel B₀ y_fn s_fn act_fn q_plus_fn q_minus_fn q_zero_fn
    hε'_pos (by norm_num) hM_vel_nonneg (le_of_lt hC_vel) (le_of_lt hB₀)
    h_init h_flip_all h_step h_s_bdd h_disc
  have hs_exp_le : uniformExp h (fun ω => s_fn h ω) ≤ 1 := le_of_eq h_trav.1
  have hy_exp_le : uniformExp h (fun ω => ‖y_fn h ω‖) ≤ K / 8 :=
    le_trans h_trav.2.2 hK_bound
  let G : (Fin h → Bool) → Prop :=
    isGoodReachedWalk d κ v Q_plus Q_minus R L₀ D₀ (fun k => (1 / 2 : ℝ) ^ (m_walk k)) h_walk N
  let E_loc : (Fin h → Bool) → Prop :=
    fun ω =>
      let z_term := stoppedWalk d Q_plus Q_minus ε δ_N R h ω h
      let z_mk := stoppedWalk d Q_plus Q_minus ε δ_j R h ω h
      ‖z_term.1 - z_mk.1 - (δ_N - δ_j) • p_sel j z_mk.1‖ ≤ K * δ_j
  let s_end : (Fin h → Bool) → ℝ := fun ω => s_fn h ω
  let y_end : (Fin h → Bool) → ℝ := fun ω => ‖y_fn h ω‖
  have h_imp : ∀ ω, G ω → s_end ω < 8 → y_end ω < K → E_loc ω :=
    fun ω hG hs_lt8 hy_ltK =>
      h_term_loc ω hG.1 (hG.2.2.2 j hj1 hjN).1 hs_lt8 hy_ltK
  classical
  have hK_inv_nonneg : 0 ≤ K⁻¹ := inv_nonneg.mpr (le_of_lt hK_pos)
  have h_pt : ∀ ω : Fin h → Bool,
      (if G ω then (1 : ℝ) else 0) - (1 / 8 : ℝ) * s_end ω - K⁻¹ * y_end ω ≤
        (if G ω ∧ E_loc ω then (1 : ℝ) else 0) := by
    intro ω
    have hs0 : 0 ≤ s_end ω := le_of_lt (h_s_bdd ω).1
    have hy0 : 0 ≤ y_end ω := norm_nonneg _
    have hy_term_nonneg : 0 ≤ K⁻¹ * y_end ω := mul_nonneg hK_inv_nonneg hy0
    by_cases hG : G ω
    · by_cases hE : E_loc ω
      · simp only [hG, hE, and_self, ↓reduceIte]
        linarith
      · simp only [hG, hE, and_false, ↓reduceIte]
        by_cases hs8 : s_end ω < 8
        · have hyK : K ≤ y_end ω := by
            by_contra h_lt
            push_neg at h_lt
            exact hE (h_imp ω hG hs8 h_lt)
          have h_ky : 1 ≤ K⁻¹ * y_end ω := by
            calc (1 : ℝ) = K⁻¹ * K := (inv_mul_cancel₀ (ne_of_gt hK_pos)).symm
              _ ≤ K⁻¹ * y_end ω := mul_le_mul_of_nonneg_left hyK hK_inv_nonneg
          linarith
        · push_neg at hs8
          linarith
    · simp only [hG, false_and, ↓reduceIte]
      linarith
  have h_sum := Finset.sum_le_sum (s := Finset.univ) (fun ω _ => h_pt ω)
  simp only [Finset.sum_sub_distrib, ← Finset.mul_sum] at h_sum
  have h2_pos : (0 : ℝ) < (2 : ℝ) ^ h := by positivity
  have h_div := div_le_div_of_nonneg_right h_sum (le_of_lt h2_pos)
  have h_lhs :
      ((∑ x, if G x then (1 : ℝ) else 0) - 1 / 8 * ∑ x, s_end x - K⁻¹ * ∑ x, y_end x) / 2 ^ h =
        uniformProb h G - (1 / 8 : ℝ) * uniformExp h s_end - K⁻¹ * uniformExp h y_end := by
    dsimp [uniformProb, uniformExp]
    ring
  have h_rhs :
      (∑ x, if G x ∧ E_loc x then (1 : ℝ) else 0) / (2 : ℝ) ^ h =
        uniformProb h (fun ω => G ω ∧ E_loc ω) := by
    dsimp [uniformProb, uniformExp]
    congr 2
    ext x
    by_cases hGE : G x ∧ E_loc x <;> simp [hGE]
  rw [h_lhs, h_rhs] at h_div
  have h_y_bound : K⁻¹ * uniformExp h y_end ≤ 1 / 8 := by
    calc K⁻¹ * uniformExp h y_end ≤ K⁻¹ * (K / 8) :=
          mul_le_mul_of_nonneg_left hy_exp_le hK_inv_nonneg
      _ = (K⁻¹ * K) / 8 := by ring
      _ = 1 / 8 := by rw [inv_mul_cancel₀ (ne_of_gt hK_pos)]
  linarith

theorem nested_block_event_extraction (h_walk : ℕ → ℕ)
    (G : ∀ N : ℕ, (Fin (h_walk N) → Bool) → Prop)
    (E : ∀ N : ℕ, ℕ → (Fin (h_walk N) → Bool) → Prop)
    (h_prob : ∀ N : ℕ, 1 ≤ N → ∀ j : ℕ, 1 ≤ j → j ≤ N →
      uniformProb (h_walk N) (fun ω => G N ω ∧ E N j ω) ≥ 3 / 8) :
    ∃ (M_blk N_seq : ℕ → ℕ) (ω_seq : ∀ m : ℕ, Fin (h_walk (N_seq m)) → Bool),
      StrictMono N_seq ∧
      (∀ m : ℕ, m + 1 ≤ N_seq m) ∧
      (∀ h : ℕ, h ≤ M_blk h) ∧
      ∀ m : ℕ,
        G (N_seq m) (ω_seq m) ∧
        ∀ h : ℕ, 1 ≤ h → h ≤ m →
          ∃ j : ℕ, h ≤ j ∧ j ≤ M_blk h ∧ j ≤ N_seq m ∧ E (N_seq m) j (ω_seq m) :=
by
  classical
  have h_prob_nonneg : ∀ (h₀ : ℕ) (P : (Fin h₀ → Bool) → Prop), 0 ≤ uniformProb h₀ P := by
    intro h₀ P
    dsimp [uniformProb, uniformExp]
    apply div_nonneg
    · apply Finset.sum_nonneg
      intro ω _
      split_ifs <;> norm_num
    · positivity
  have h_prob_le_one : ∀ (h₀ : ℕ) (P : (Fin h₀ → Bool) → Prop), uniformProb h₀ P ≤ 1 := by
    intro h₀ P
    dsimp [uniformProb, uniformExp]
    apply div_le_one_of_le₀
    · calc (∑ ω : Fin h₀ → Bool, @ite ℝ (P ω) (Classical.propDecidable (P ω)) 1 0)
        _ ≤ ∑ _ω : Fin h₀ → Bool, (1 : ℝ) := by
          apply Finset.sum_le_sum
          intro ω _
          split_ifs <;> norm_num
        _ = (2 : ℝ) ^ h₀ := by
          simp [Finset.sum_const, Finset.card_univ, Fintype.card_fun, Fintype.card_bool, Fintype.card_fin]
    · positivity
  have h_prob_mono : ∀ (h₀ : ℕ) (P Q : (Fin h₀ → Bool) → Prop),
      (∀ ω, P ω → Q ω) → uniformProb h₀ P ≤ uniformProb h₀ Q := by
    intro h₀ P Q hPQ
    dsimp [uniformProb, uniformExp]
    apply div_le_div_of_nonneg_right
    · apply Finset.sum_le_sum
      intro ω _
      split_ifs with hP hQ
      · norm_num
      · exact absurd (hPQ ω hP) hQ
      · norm_num
      · norm_num
    · positivity
  let B : ∀ N : ℕ, ℕ → ℕ → (Fin (h_walk N) → Bool) → Prop :=
    fun N h M ω => G N ω ∧ ∃ j : ℕ, h ≤ j ∧ j ≤ M ∧ E N j ω
  let p : ℕ → (ℕ × ℕ) → ℝ :=
    fun N i => uniformProb (h_walk N) (B N i.1 i.2)
  have hp_mem : ∀ N : ℕ, p N ∈ { x : (ℕ × ℕ) → ℝ | ∀ i : ℕ × ℕ, x i ∈ Set.Icc (0 : ℝ) 1 } := by
    intro N i
    exact ⟨h_prob_nonneg _ _, h_prob_le_one _ _⟩
  have hp_mono : ∀ (N h M₁ M₂ : ℕ), M₁ ≤ M₂ → p N (h, M₁) ≤ p N (h, M₂) := by
    intro N h M₁ M₂ hM
    apply h_prob_mono
    rintro ω ⟨hG, j, hj1, hj2, hE⟩
    exact ⟨hG, j, hj1, le_trans hj2 hM, hE⟩
  have hp_lb : ∀ (N h M : ℕ), 1 ≤ h → h ≤ M → h ≤ N → 3 / 8 ≤ p N (h, M) := by
    intro N h M hh1 hhM hhN
    have hN1 : 1 ≤ N := le_trans hh1 hhN
    have h1 : 3 / 8 ≤ uniformProb (h_walk N) (fun ω => G N ω ∧ E N h ω) :=
      h_prob N hN1 h hh1 hhN
    have h2 : uniformProb (h_walk N) (fun ω => G N ω ∧ E N h ω) ≤ p N (h, M) := by
      apply h_prob_mono
      rintro ω ⟨hG, hE⟩
      exact ⟨hG, h, le_rfl, hhM, hE⟩
    exact le_trans h1 h2
  have hK_compact : IsCompact { x : (ℕ × ℕ) → ℝ | ∀ i : ℕ × ℕ, x i ∈ Set.Icc (0 : ℝ) 1 } :=
    isCompact_pi_infinite (fun _ : ℕ × ℕ => isCompact_Icc)
  obtain ⟨p_lim, hp_lim_mem, φ, hφ_mono, hφ_tend⟩ := hK_compact.tendsto_subseq hp_mem
  have hp_tend : ∀ h M : ℕ, Filter.Tendsto (fun k => p (φ k) (h, M)) Filter.atTop (nhds (p_lim (h, M))) := by
    intro h M
    exact (tendsto_pi_nhds.mp hφ_tend) (h, M)
  have hp_lim_nonneg : ∀ h M : ℕ, 0 ≤ p_lim (h, M) := fun h M => (hp_lim_mem (h, M)).1
  have hp_lim_le_one : ∀ h M : ℕ, p_lim (h, M) ≤ 1 := fun h M => (hp_lim_mem (h, M)).2
  have hp_lim_mono : ∀ (h M₁ M₂ : ℕ), M₁ ≤ M₂ → p_lim (h, M₁) ≤ p_lim (h, M₂) := by
    intro h M₁ M₂ hM
    exact le_of_tendsto_of_tendsto (hp_tend h M₁) (hp_tend h M₂)
      (Filter.Eventually.of_forall (fun k => hp_mono (φ k) h M₁ M₂ hM))
  have hp_lim_lb : ∀ (h M : ℕ), 1 ≤ h → h ≤ M → 3 / 8 ≤ p_lim (h, M) := by
    intro h M hh1 hhM
    apply ge_of_tendsto (hp_tend h M)
    rw [Filter.eventually_atTop]
    refine ⟨h, fun k hk => ?_⟩
    exact hp_lb (φ k) h M hh1 hhM (le_trans hk (hφ_mono.id_le k))
  have h_stab : ∀ h : ℕ, ∃ M₀ : ℕ, h ≤ M₀ ∧ ∀ M : ℕ, M₀ ≤ M →
      p_lim (h, M) - p_lim (h, M₀) ≤ (1 / 2 : ℝ) ^ (h + 3) := by
    intro h
    by_contra! h_no
    let ε : ℝ := (1 / 2 : ℝ) ^ (h + 3)
    have hε_pos : 0 < ε := by positivity
    have h_next : ∀ m₀ : ℕ, ∃ M : ℕ, p_lim (h, m₀) + ε < p_lim (h, M) := by
      intro m₀
      obtain ⟨M, _, hM_gt⟩ := h_no (max m₀ h) (le_max_right m₀ h)
      have hm₀ : p_lim (h, m₀) ≤ p_lim (h, max m₀ h) := hp_lim_mono h m₀ (max m₀ h) (le_max_left m₀ h)
      exact ⟨M, by linarith⟩
    choose step h_step using h_next
    let a : ℕ → ℕ := fun r => Nat.recOn r h (fun _ prev => step prev)
    have ha_bound : ∀ r : ℕ, p_lim (h, h) + (r : ℝ) * ε ≤ p_lim (h, a r) := by
      intro r
      induction r with
      | zero =>
        change p_lim (h, h) + ((0 : ℕ) : ℝ) * ε ≤ p_lim (h, h)
        simp
      | succ r ih =>
        have h_s : p_lim (h, a r) + ε < p_lim (h, a (r + 1)) := h_step (a r)
        push_cast
        linarith
    obtain ⟨r, hr⟩ := exists_nat_gt (1 / ε)
    have hr_ε : 1 < (r : ℝ) * ε := (div_lt_iff₀ hε_pos).mp hr
    have h1 := ha_bound r
    have h2 := hp_lim_nonneg h h
    have h3 := hp_lim_le_one h (a r)
    linarith
  choose M_blk hM_blk_ge hM_blk_tail using h_stab
  have h_subadd : ∀ (N m M_star : ℕ),
      m + 1 ≤ M_star →
      (∀ r ∈ Finset.range (m + 1), M_blk (r + 1) ≤ M_star) →
      p N (m + 1, M_star) -
        ∑ r ∈ Finset.range (m + 1), (p N (r + 1, M_star) - p N (r + 1, M_blk (r + 1))) ≤
        uniformProb (h_walk N) (fun ω =>
          G N ω ∧ ∀ h : ℕ, 1 ≤ h → h ≤ m + 1 →
            ∃ j : ℕ, h ≤ j ∧ j ≤ M_blk h ∧ E N j ω) := by
    intro N m M_star hM_star_ge hM_star_blk
    let P_int : (Fin (h_walk N) → Bool) → Prop := fun ω =>
      G N ω ∧ ∀ h : ℕ, 1 ≤ h → h ≤ m + 1 → ∃ j : ℕ, h ≤ j ∧ j ≤ M_blk h ∧ E N j ω
    let ind : ((Fin (h_walk N) → Bool) → Prop) → (Fin (h_walk N) → Bool) → ℝ :=
      fun Q ω => @ite ℝ (Q ω) (Classical.propDecidable (Q ω)) 1 0
    let D : ℕ → (Fin (h_walk N) → Bool) → ℝ :=
      fun r ω => ind (B N (r + 1) M_star) ω - ind (B N (r + 1) (M_blk (r + 1))) ω
    have hD_nonneg : ∀ (ω : Fin (h_walk N) → Bool) (r : ℕ),
        r ∈ Finset.range (m + 1) → 0 ≤ D r ω := by
      intro ω r hr
      have h_le : M_blk (r + 1) ≤ M_star := hM_star_blk r hr
      by_cases h2 : B N (r + 1) (M_blk (r + 1)) ω
      · rcases h2 with ⟨hG, j, hj1, hj2, hE⟩
        have h1 : B N (r + 1) M_star ω := ⟨hG, j, hj1, le_trans hj2 h_le, hE⟩
        have h2' : B N (r + 1) (M_blk (r + 1)) ω := ⟨hG, j, hj1, hj2, hE⟩
        dsimp [D, ind]
        rw [if_pos h1, if_pos h2']
        norm_num
      · dsimp [D, ind]
        rw [if_neg h2, sub_zero]
        split_ifs <;> norm_num
    have h_pt : ∀ ω : Fin (h_walk N) → Bool,
        ind (B N (m + 1) M_star) ω - ∑ r ∈ Finset.range (m + 1), D r ω ≤ ind P_int ω := by
      intro ω
      have h_sum_nonneg : 0 ≤ ∑ r ∈ Finset.range (m + 1), D r ω :=
        Finset.sum_nonneg (fun r hr => hD_nonneg ω r hr)
      have hI_nonneg : 0 ≤ ind P_int ω := by dsimp [ind]; split_ifs <;> norm_num
      by_cases hB0 : B N (m + 1) M_star ω
      · have hU0 : ind (B N (m + 1) M_star) ω = 1 := if_pos hB0
        by_cases hP : P_int ω
        · have hI : ind P_int ω = 1 := if_pos hP
          linarith
        · have hI : ind P_int ω = 0 := if_neg hP
          rcases hB0 with ⟨hG, j_star, hj_star1, hj_star2, hE_star⟩
          have h_not_all : ¬ ∀ h : ℕ, 1 ≤ h → h ≤ m + 1 →
              ∃ j : ℕ, h ≤ j ∧ j ≤ M_blk h ∧ E N j ω :=
            fun hall => hP ⟨hG, hall⟩
          push_neg at h_not_all
          rcases h_not_all with ⟨h₀, hh₀1, hh₀2, h_no_j⟩
          let r₀ : ℕ := h₀ - 1
          have hr₀_eq : r₀ + 1 = h₀ := by omega
          have hr₀_mem : r₀ ∈ Finset.range (m + 1) := Finset.mem_range.mpr (by omega)
          have hB_star : B N (r₀ + 1) M_star ω :=
            ⟨hG, j_star, by omega, hj_star2, hE_star⟩
          have hB_blk : ¬ B N (r₀ + 1) (M_blk (r₀ + 1)) ω := by
            rintro ⟨_, j, hj1, hj2, hE⟩
            rw [hr₀_eq] at hj1 hj2
            exact h_no_j j hj1 hj2 hE
          have hDr₀ : D r₀ ω = 1 := by
            dsimp [D, ind]
            rw [if_pos hB_star, if_neg hB_blk]
            ring
          have h_single : D r₀ ω ≤ ∑ r ∈ Finset.range (m + 1), D r ω :=
            Finset.single_le_sum (fun r hr => hD_nonneg ω r hr) hr₀_mem
          linarith
      · have hU0 : ind (B N (m + 1) M_star) ω = 0 := if_neg hB0
        linarith
    have h_sum_le : (∑ ω : Fin (h_walk N) → Bool,
        (ind (B N (m + 1) M_star) ω - ∑ r ∈ Finset.range (m + 1), D r ω)) ≤
        ∑ ω : Fin (h_walk N) → Bool, ind P_int ω :=
      Finset.sum_le_sum (fun ω _ => h_pt ω)
    have h_div_le := div_le_div_of_nonneg_right h_sum_le (by positivity : (0 : ℝ) ≤ (2 : ℝ) ^ (h_walk N))
    have h_lhs_eq : (∑ ω : Fin (h_walk N) → Bool,
        (ind (B N (m + 1) M_star) ω - ∑ r ∈ Finset.range (m + 1), D r ω)) / (2 : ℝ) ^ (h_walk N) =
        p N (m + 1, M_star) -
          ∑ r ∈ Finset.range (m + 1), (p N (r + 1, M_star) - p N (r + 1, M_blk (r + 1))) := by
      dsimp [p, uniformProb, uniformExp, D, ind]
      rw [Finset.sum_sub_distrib, sub_div, Finset.sum_comm]
      congr 1
      rw [Finset.sum_div]
      apply Finset.sum_congr rfl
      intro r _
      rw [Finset.sum_sub_distrib, sub_div]
    rw [← h_lhs_eq]
    exact h_div_le
  have h_geom : ∀ k : ℕ,
      ∑ r ∈ Finset.range k, (1 / 2 : ℝ) ^ (r + 4) = 1 / 8 - (1 / 2 : ℝ) ^ (k + 3) := by
    intro k
    induction k with
    | zero =>
      simp
      norm_num
    | succ k ih =>
      rw [Finset.sum_range_succ, ih]
      ring
  have h_ex : ∀ (m B_min : ℕ), ∃ N : ℕ, B_min ≤ N ∧
      ∃ ω : Fin (h_walk N) → Bool,
        G N ω ∧
        ∀ h : ℕ, 1 ≤ h → h ≤ m →
          ∃ j : ℕ, h ≤ j ∧ j ≤ M_blk h ∧ j ≤ N ∧ E N j ω := by
    intro m B_min
    let M_star : ℕ := max (m + 1) ((Finset.range (m + 1)).sup (fun r => M_blk (r + 1)))
    have hM_star_ge : m + 1 ≤ M_star := le_max_left _ _
    have hM_star_blk : ∀ r ∈ Finset.range (m + 1), M_blk (r + 1) ≤ M_star := by
      intro r hr
      exact le_trans (Finset.le_sup (f := fun r => M_blk (r + 1)) hr) (le_max_right _ _)
    let F_m : ℕ → ℝ := fun k =>
      p (φ k) (m + 1, M_star) -
        ∑ r ∈ Finset.range (m + 1), (p (φ k) (r + 1, M_star) - p (φ k) (r + 1, M_blk (r + 1)))
    let L_m : ℝ :=
      p_lim (m + 1, M_star) -
        ∑ r ∈ Finset.range (m + 1), (p_lim (r + 1, M_star) - p_lim (r + 1, M_blk (r + 1)))
    have hF_tend : Filter.Tendsto F_m Filter.atTop (nhds L_m) := by
      apply Filter.Tendsto.sub (hp_tend (m + 1) M_star)
      apply tendsto_finset_sum
      intro r _
      exact Filter.Tendsto.sub (hp_tend (r + 1) M_star) (hp_tend (r + 1) (M_blk (r + 1)))
    have hL_pos : 0 < L_m := by
      have h_base : 3 / 8 ≤ p_lim (m + 1, M_star) := hp_lim_lb (m + 1) M_star (by omega) hM_star_ge
      have h_sum : ∑ r ∈ Finset.range (m + 1),
          (p_lim (r + 1, M_star) - p_lim (r + 1, M_blk (r + 1))) ≤ 1 / 8 := by
        calc ∑ r ∈ Finset.range (m + 1), (p_lim (r + 1, M_star) - p_lim (r + 1, M_blk (r + 1)))
          _ ≤ ∑ r ∈ Finset.range (m + 1), (1 / 2 : ℝ) ^ (r + 4) := by
            apply Finset.sum_le_sum
            intro r hr
            have h_t := hM_blk_tail (r + 1) M_star (hM_star_blk r hr)
            simpa [Nat.add_assoc] using h_t
          _ = 1 / 8 - (1 / 2 : ℝ) ^ (m + 1 + 3) := h_geom (m + 1)
          _ ≤ 1 / 8 := by
            have : (0 : ℝ) ≤ (1 / 2 : ℝ) ^ (m + 1 + 3) := by positivity
            linarith
      dsimp [L_m]
      linarith
    have hF_ev : ∀ᶠ k in Filter.atTop, 0 < F_m k :=
      hF_tend.eventually (lt_mem_nhds hL_pos)
    rw [Filter.eventually_atTop] at hF_ev
    rcases hF_ev with ⟨K₀, hK₀⟩
    let k := max K₀ (max B_min M_star)
    let N := φ k
    have hk_K₀ : K₀ ≤ k := le_max_left _ _
    have hk_BM : max B_min M_star ≤ k := le_max_right _ _
    have hN_ge_k : k ≤ N := hφ_mono.id_le k
    have hB_le_N : B_min ≤ N := le_trans (le_trans (le_max_left _ _) hk_BM) hN_ge_k
    have hM_le_N : M_star ≤ N := le_trans (le_trans (le_max_right _ _) hk_BM) hN_ge_k
    have h_prob_pos : 0 < uniformProb (h_walk N) (fun ω =>
        G N ω ∧ ∀ h : ℕ, 1 ≤ h → h ≤ m + 1 →
          ∃ j : ℕ, h ≤ j ∧ j ≤ M_blk h ∧ E N j ω) :=
      lt_of_lt_of_le (hK₀ k hk_K₀) (h_subadd N m M_star hM_star_ge hM_star_blk)
    have h_ex_ω : ∃ ω : Fin (h_walk N) → Bool,
        G N ω ∧ ∀ h : ℕ, 1 ≤ h → h ≤ m + 1 →
          ∃ j : ℕ, h ≤ j ∧ j ≤ M_blk h ∧ E N j ω := by
      by_contra h_none
      have h_none' := not_exists.mp h_none
      have h_zero : uniformProb (h_walk N) (fun ω =>
          G N ω ∧ ∀ h : ℕ, 1 ≤ h → h ≤ m + 1 →
            ∃ j : ℕ, h ≤ j ∧ j ≤ M_blk h ∧ E N j ω) = 0 := by
        dsimp [uniformProb, uniformExp]
        rw [Finset.sum_eq_zero]
        · ring
        · intro ω _
          exact if_neg (h_none' ω)
      linarith
    rcases h_ex_ω with ⟨ω, hG_ω, h_all_ω⟩
    refine ⟨N, hB_le_N, ω, hG_ω, ?_⟩
    intro h hh1 hhm
    obtain ⟨j, hj1, hj2, hE_j⟩ := h_all_ω h hh1 (by omega)
    have hr_mem : h - 1 ∈ Finset.range (m + 1) := Finset.mem_range.mpr (by omega)
    have hM_blk_h : M_blk h ≤ M_star := by
      have h_eq : h - 1 + 1 = h := by omega
      simpa [h_eq] using hM_star_blk (h - 1) hr_mem
    exact ⟨j, hj1, hj2, le_trans hj2 (le_trans hM_blk_h hM_le_N), hE_j⟩
  choose nextN h_nextN_ge h_nextN_ω using h_ex
  let N_seq : ℕ → ℕ := fun m =>
    Nat.recOn m (nextN 0 1) (fun m₀ prev => nextN (m₀ + 1) (max (prev + 1) (m₀ + 2)))
  have hN_mono : StrictMono N_seq := by
    apply strictMono_nat_of_lt_succ
    intro m
    have h_ge := h_nextN_ge (m + 1) (max (N_seq m + 1) (m + 2))
    have h_max : N_seq m + 1 ≤ max (N_seq m + 1) (m + 2) := le_max_left _ _
    change N_seq m < nextN (m + 1) (max (N_seq m + 1) (m + 2))
    omega
  have hN_ge : ∀ m : ℕ, m + 1 ≤ N_seq m := by
    intro m
    cases m with
    | zero =>
      change 1 ≤ nextN 0 1
      exact h_nextN_ge 0 1
    | succ m₀ =>
      have h_ge := h_nextN_ge (m₀ + 1) (max (N_seq m₀ + 1) (m₀ + 2))
      have h_max : m₀ + 2 ≤ max (N_seq m₀ + 1) (m₀ + 2) := le_max_right _ _
      change m₀ + 1 + 1 ≤ nextN (m₀ + 1) (max (N_seq m₀ + 1) (m₀ + 2))
      omega
  have h_ω_all : ∀ m : ℕ, ∃ ω : Fin (h_walk (N_seq m)) → Bool,
      G (N_seq m) ω ∧
      ∀ h : ℕ, 1 ≤ h → h ≤ m →
        ∃ j : ℕ, h ≤ j ∧ j ≤ M_blk h ∧ j ≤ N_seq m ∧ E (N_seq m) j ω := by
    intro m
    cases m with
    | zero =>
      exact h_nextN_ω 0 1
    | succ m₀ =>
      exact h_nextN_ω (m₀ + 1) (max (N_seq m₀ + 1) (m₀ + 2))
  choose ω_seq hω_seq using h_ω_all
  exact ⟨M_blk, N_seq, ω_seq, hN_mono, hN_ge, hM_blk_ge, hω_seq⟩

theorem stopped_walk_prelimit_localization (d : ℕ) (hd : 3 ≤ d) (C₁ : ℝ) (hC₁ : 1 ≤ C₁)
    (κ H_star : ℝ) (hκ : 0 < κ) (v : EuclideanSpace ℝ (Fin (d + 1)) → ℝ)
    (hv_class : InLimitingClassA d C₁ v)
    (hv_cent : IsCenteredAt d C₁ v 0 1)
    (hJ_start : Filter.Tendsto (fun ℓ => driftFunctional d κ ℓ v (mkSpaceTime 0 1))
      (nhdsWithin 0 (Set.Ioi 0)) (nhds H_star))
    (Q_plus Q_minus Q_zero : EuclideanSpace ℝ (Fin d) → ℝ → ℝ → EuclideanSpace ℝ (Fin d))
    (hQ_drift : ∀ (x : EuclideanSpace ℝ (Fin d)) (t ε : ℝ), 0 < ε → ε < t →
      (driftFunctional d κ ε v (mkSpaceTime (x + ε • Q_plus x t ε) (t + ε)) +
        driftFunctional d κ ε v (mkSpaceTime (x - ε • Q_minus x t ε) (t - ε))) / 2 -
        driftFunctional d κ ε v (mkSpaceTime x t) ≥
          (1 / (16 * (1 + Real.log 2))) *
            (‖Q_plus x t ε - Q_zero x t ε‖ ^ 2 + ‖Q_minus x t ε - Q_zero x t ε‖ ^ 2))
    (hQ_step : ∀ (R T : ℝ), 2 ≤ R → 2 ≤ T →
      ∃ ε₀ : ℝ, 0 < ε₀ ∧
        ∀ (ε : ℝ) (x : EuclideanSpace ℝ (Fin d)) (t : ℝ),
          0 < ε → ε ≤ ε₀ → ‖x‖ ≤ R → ε < t → t ≤ T →
          ‖ε • Q_plus x t ε‖ ≤ 1 ∧ ‖ε • Q_minus x t ε‖ ≤ 1)
    (C_vel C_ub : ℝ) (hC_vel : 0 < C_vel) (hC_ub : 0 < C_ub)
    (hQ_vel : ∀ (r : ℝ) (x₀ : EuclideanSpace ℝ (Fin d)) (p₀ : EuclideanSpace ℝ (Fin d)) (a₀ : ℝ),
      0 < r → IsFitAt d C₁ v x₀ r r p₀ a₀ →
      ∀ (K ε : ℝ) (x : EuclideanSpace ℝ (Fin d)) (t : ℝ),
        2 ≤ K → 0 < ε → ε ≤ r → ε < t → t ≤ K * r →
        ‖x - x₀ - (t - r) • p₀‖ ≤ K * r →
        ‖Q_zero x t ε - p₀‖ ≤ C_vel * (1 + Real.log K + |Real.log (t / r)|))
    (hJ_ub : ∀ (B ε : ℝ) (x : EuclideanSpace ℝ (Fin d)) (t : ℝ),
      2 ≤ B → 0 < ε → ε ≤ B → ‖x‖ ≤ B → ε < t → t ≤ B →
      driftFunctional d κ ε v (mkSpaceTime x t) ≤ C_ub * (1 + Real.log B) ^ 4) :
    ∃ (R K L₀ D₀ : ℝ) (M_blk N_seq : ℕ → ℕ) (ε_seq : ℕ → ℝ)
      (x_term : ℕ → EuclideanSpace ℝ (Fin d))
      (x_mk p_mk : ℕ → ℕ → EuclideanSpace ℝ (Fin d))
      (a_mk : ℕ → ℕ → ℝ),
      HasPrelimitWalkContacts d C₁ κ v R K L₀ D₀ M_blk N_seq ε_seq x_term x_mk p_mk a_mk :=
by
  have h_psi : HasPsiPotentialBounds := psiPotential_bounds
  have h_travel : HasPredictableTravelBound d := predictable_walk_travel_bound d h_psi
  obtain ⟨R, L₀, D₀, B₀, m_walk, h_walk, h_orig⟩ :=
    original_walk_reach_and_good_drift d hd C₁ hC₁ κ H_star hκ v hv_cent hJ_start
      Q_plus Q_minus Q_zero hQ_drift hQ_step C_vel C_ub hC_vel hC_ub hQ_vel hJ_ub h_psi h_travel
  have h_fit_ex : ∀ (j : ℕ) (x : EuclideanSpace ℝ (Fin d)),
      ∃ (p : EuclideanSpace ℝ (Fin d)) (a : ℝ),
        IsFitAt d C₁ v x ((1 / 2 : ℝ) ^ j) ((1 / 2 : ℝ) ^ j) p a := by
    intro j x
    exact hv_class.2.2.2 x ((1 / 2 : ℝ) ^ j) ((1 / 2 : ℝ) ^ j) (by positivity)
  choose p_sel a_sel hp_sel using h_fit_ex
  obtain ⟨K, hK_pos, h_loc⟩ :=
    fitted_frame_mark_localization d hd C₁ hC₁ κ hκ v Q_plus Q_minus Q_zero C_vel hC_vel hQ_vel
      h_travel p_sel a_sel hp_sel R L₀ D₀ B₀ m_walk h_walk h_orig
  let ε_walk : ℕ → ℝ := fun N => (1 / 2 : ℝ) ^ (m_walk N)
  let G : ∀ N : ℕ, (Fin (h_walk N) → Bool) → Prop :=
    fun N ω => isGoodReachedWalk d κ v Q_plus Q_minus R L₀ D₀ ε_walk h_walk N ω
  let E : ∀ N : ℕ, ℕ → (Fin (h_walk N) → Bool) → Prop :=
    fun N j ω =>
      let h := h_walk N
      let δ_N := (1 / 2 : ℝ) ^ N
      let δ_j := (1 / 2 : ℝ) ^ j
      let z_term := stoppedWalk d Q_plus Q_minus (ε_walk N) δ_N R h ω h
      let z_mk := stoppedWalk d Q_plus Q_minus (ε_walk N) δ_j R h ω h
      ‖z_term.1 - z_mk.1 - (δ_N - δ_j) • p_sel j z_mk.1‖ ≤ K * δ_j
  obtain ⟨M_blk, N_seq, ω_seq, hN_mono, hN_ge, hM_blk, h_ext⟩ :=
    nested_block_event_extraction h_walk G E h_loc
  let ε_seq : ℕ → ℝ := fun m => ε_walk (N_seq m)
  let x_term : ℕ → EuclideanSpace ℝ (Fin d) := fun m =>
    (stoppedWalk d Q_plus Q_minus (ε_seq m) ((1 / 2 : ℝ) ^ (N_seq m)) R
      (h_walk (N_seq m)) (ω_seq m) (h_walk (N_seq m))).1
  let x_mk : ℕ → ℕ → EuclideanSpace ℝ (Fin d) := fun m j =>
    (stoppedWalk d Q_plus Q_minus (ε_seq m) ((1 / 2 : ℝ) ^ j) R
      (h_walk (N_seq m)) (ω_seq m) (h_walk (N_seq m))).1
  let p_mk : ℕ → ℕ → EuclideanSpace ℝ (Fin d) := fun m j => p_sel j (x_mk m j)
  let a_mk : ℕ → ℕ → ℝ := fun m j => a_sel j (x_mk m j)
  refine ⟨R, K, L₀, D₀, M_blk, N_seq, ε_seq, x_term, x_mk, p_mk, a_mk, ?_⟩
  refine ⟨by linarith [h_orig.1], hK_pos, h_orig.2.1, hN_mono, hM_blk, fun m => ?_⟩
  have hN_pos : 1 ≤ N_seq m := by have := hN_ge m; omega
  have h_orig_m := h_orig.2.2.2 (N_seq m) hN_pos
  have hG_m := (h_ext m).1
  refine ⟨h_orig_m.2.1, h_orig_m.2.2.1, hG_m.2.1, hG_m.2.2.1, ?_, ?_⟩
  · intro j hj1 hjN
    have hG_mj := hG_m.2.2.2 j hj1 hjN
    exact ⟨hG_mj.2.1, hp_sel j (x_mk m j), hG_mj.2.2⟩
  · intro h hh1 hhm
    exact (h_ext m).2 h hh1 hhm

theorem terminal_slope_lower_bound_of_prelimit_drift (d : ℕ) (κ : ℝ) (hκ : 0 < κ)
    (v : EuclideanSpace ℝ (Fin (d + 1)) → ℝ) (hv_cont : Continuous v)
    (hv_jensen : HasHorizontalJensenBound d κ v)
    (h_growth : ∀ (t₁ t₂ ε : ℝ), 0 < ε → ∃ M : ℝ, ∀ (y : EuclideanSpace ℝ (Fin d)) (s : ℝ),
      t₁ ≤ s → s ≤ t₂ → |v (mkSpaceTime y s)| ≤ M + ε * ‖y‖ ^ 2)
    (h_comp : ∀ (x y : EuclideanSpace ℝ (Fin d)) (t ℓ : ℝ), 0 < ℓ →
      v (mkSpaceTime y (t + ℓ)) - v (mkSpaceTime x t) - ‖y - x‖ ^ 2 / (2 * ℓ) ≤
        ℓ * slopePlus d ℓ v (mkSpaceTime x t) ∧
      v (mkSpaceTime x t) - v (mkSpaceTime y (t - ℓ)) - ‖y - x‖ ^ 2 / (2 * ℓ) ≤
        ℓ * slopeMinus d ℓ v (mkSpaceTime x t))
    (h_attain : ∀ (x : EuclideanSpace ℝ (Fin d)) (t ℓ : ℝ), 0 < ℓ →
      (∃ y_plus : EuclideanSpace ℝ (Fin d),
        v (mkSpaceTime y_plus (t + ℓ)) - v (mkSpaceTime x t) - ‖y_plus - x‖ ^ 2 / (2 * ℓ) =
          ℓ * slopePlus d ℓ v (mkSpaceTime x t)) ∧
      (∃ y_minus : EuclideanSpace ℝ (Fin d),
        v (mkSpaceTime x t) - v (mkSpaceTime y_minus (t - ℓ)) - ‖y_minus - x‖ ^ 2 / (2 * ℓ) =
          ℓ * slopeMinus d ℓ v (mkSpaceTime x t)))
    (h_mono : ∀ (x : EuclideanSpace ℝ (Fin d)) (t ℓ₁ ℓ₂ : ℝ), 0 < ℓ₁ → ℓ₁ ≤ ℓ₂ →
      slopePlus d ℓ₁ v (mkSpaceTime x t) ≤ slopePlus d ℓ₂ v (mkSpaceTime x t) ∧
      slopeMinus d ℓ₁ v (mkSpaceTime x t) ≤ slopeMinus d ℓ₂ v (mkSpaceTime x t))
    (R L₀ : ℝ) (x_end : EuclideanSpace ℝ (Fin d))
    (x_r : ℕ → EuclideanSpace ℝ (Fin d)) (τ_r ε_r : ℕ → ℝ)
    (hx_lim : Filter.Tendsto x_r Filter.atTop (nhds x_end))
    (hτ_lim : Filter.Tendsto τ_r Filter.atTop (nhds 0))
    (h_seq : ∀ r : ℕ,
      0 < τ_r r ∧ τ_r r ≤ 1 ∧ 0 < ε_r r ∧ ε_r r ≤ τ_r r / 4 ∧
      ‖x_r r‖ ≤ R + 1 ∧ L₀ ≤ driftFunctional d κ (ε_r r) v (mkSpaceTime (x_r r) (τ_r r))) :
    ∃ L_end : ℝ, ∀ ℓ : ℝ, 0 < ℓ → L_end ≤ slopePlus d ℓ v (mkSpaceTime x_end 0) :=
by
  have h_projSpace : ∀ (x : EuclideanSpace ℝ (Fin d)) (t : ℝ), projSpace (mkSpaceTime x t) = x := by
    intro x t
    ext i
    simp [projSpace, mkSpaceTime]
  have h_projTime : ∀ (x : EuclideanSpace ℝ (Fin d)) (t : ℝ), projTime (mkSpaceTime x t) = t := by
    intro x t
    simp [projTime, mkSpaceTime]
  have h_mk_cont : Continuous (fun p : EuclideanSpace ℝ (Fin d) × ℝ => mkSpaceTime p.1 p.2) := by
    unfold mkSpaceTime
    apply (ContinuousLinearEquiv.continuous _).comp
    rw [continuous_pi_iff]
    intro j
    refine Fin.lastCases ?_ ?_ j
    · simp only [Fin.snoc_last]
      exact continuous_snd
    · intro i
      simp only [Fin.snoc_castSucc]
      exact ((continuous_apply i).comp (EuclideanSpace.equiv (Fin d) ℝ).continuous).comp continuous_fst
  have hv_seq_lim : Filter.Tendsto (fun r => v (mkSpaceTime (x_r r) (τ_r r)))
      Filter.atTop (nhds (v (mkSpaceTime x_end 0))) :=
    ((hv_cont.comp h_mk_cont).tendsto (x_end, 0)).comp (hx_lim.prodMk_nhds hτ_lim)
  have norm_sq_le_two_sub_add : ∀ (x y : EuclideanSpace ℝ (Fin d)),
      ‖y‖ ^ 2 ≤ 2 * ‖y - x‖ ^ 2 + 2 * ‖x‖ ^ 2 := by
    intro x y
    have h_tri : ‖y‖ ≤ ‖y - x‖ + ‖x‖ := by
      simpa [sub_add_cancel] using norm_add_le (y - x) x
    have h_sq : ‖y‖ ^ 2 ≤ (‖y - x‖ + ‖x‖) ^ 2 :=
      pow_le_pow_left₀ (norm_nonneg y) h_tri 2
    have h_amgm : 0 ≤ (‖y - x‖ - ‖x‖) ^ 2 := sq_nonneg (‖y - x‖ - ‖x‖)
    linarith
  have norm_sq_sub_le_of_sq_le : ∀ (y x₁ x₂ : EuclideanSpace ℝ (Fin d)) (B : ℝ),
      ‖y - x₁‖ ^ 2 ≤ B →
      ‖y - x₂‖ ^ 2 - ‖y - x₁‖ ^ 2 ≤ (B + 1) * ‖x₁ - x₂‖ + ‖x₁ - x₂‖ ^ 2 := by
    intro y x₁ x₂ B hB
    have h_tri : ‖y - x₂‖ ≤ ‖y - x₁‖ + ‖x₁ - x₂‖ := by
      simpa [sub_add_sub_cancel] using norm_add_le (y - x₁) (x₁ - x₂)
    have h_sq : ‖y - x₂‖ ^ 2 ≤ (‖y - x₁‖ + ‖x₁ - x₂‖) ^ 2 :=
      pow_le_pow_left₀ (norm_nonneg (y - x₂)) h_tri 2
    have h_lin : 2 * ‖y - x₁‖ ≤ B + 1 := by
      have h_sq1 : 0 ≤ (‖y - x₁‖ - 1) ^ 2 := sq_nonneg (‖y - x₁‖ - 1)
      linarith
    have h_mul : (2 * ‖y - x₁‖) * ‖x₁ - x₂‖ ≤ (B + 1) * ‖x₁ - x₂‖ :=
      mul_le_mul_of_nonneg_right h_lin (norm_nonneg (x₁ - x₂))
    linarith
  have h_bary_mem : ∀ (x : EuclideanSpace ℝ (Fin d)) (t : ℝ),
      v (mkSpaceTime x t) ∈
        { val : ℝ | ∃ (N : ℕ) (θ : Fin N → ℝ) (y : Fin N → EuclideanSpace ℝ (Fin d)),
          (∀ i, 0 < θ i) ∧ (∑ i, θ i = 1) ∧ (∑ i, θ i • y i = projSpace (mkSpaceTime x t)) ∧
          val = (∑ i, θ i * v (mkSpaceTime (y i) (projTime (mkSpaceTime x t)))) -
            (∑ i, θ i * ‖y i - projSpace (mkSpaceTime x t)‖ ^ 2) / (2 * t) } := by
    intro x t
    refine ⟨1, fun _ => 1, fun _ => x, fun _ => zero_lt_one, by simp, ?_, ?_⟩
    · simp [h_projSpace]
    · simp [h_projSpace, h_projTime]
  have h_bary_ub : ∀ (x : EuclideanSpace ℝ (Fin d)) (t : ℝ), 0 < t →
      ∀ val ∈
        { val : ℝ | ∃ (N : ℕ) (θ : Fin N → ℝ) (y : Fin N → EuclideanSpace ℝ (Fin d)),
          (∀ i, 0 < θ i) ∧ (∑ i, θ i = 1) ∧ (∑ i, θ i • y i = projSpace (mkSpaceTime x t)) ∧
          val = (∑ i, θ i * v (mkSpaceTime (y i) (projTime (mkSpaceTime x t)))) -
            (∑ i, θ i * ‖y i - projSpace (mkSpaceTime x t)‖ ^ 2) / (2 * t) },
        val ≤ v (mkSpaceTime x t) + κ ^ 2 * t / 2 := by
    intro x t ht val hval
    rcases hval with ⟨N, θ, y, hθ_pos, hθ_sum, hy_mean, rfl⟩
    rw [h_projSpace] at hy_mean ⊢
    rw [h_projTime]
    have hj := hv_jensen t N θ y hθ_pos hθ_sum
    dsimp only at hj
    rw [hy_mean] at hj
    set V : ℝ := ∑ i, θ i * ‖y i - x‖ ^ 2
    set r : ℝ := Real.sqrt V
    have hV_nonneg : 0 ≤ V := by
      apply Finset.sum_nonneg
      intro i _
      exact mul_nonneg (le_of_lt (hθ_pos i)) (sq_nonneg _)
    have hr_sq : r ^ 2 = V := Real.sq_sqrt hV_nonneg
    have h_sq_nonneg : 0 ≤ (r - κ * t) ^ 2 / (2 * t) :=
      div_nonneg (sq_nonneg _) (by linarith)
    have h_id : κ * r - V / (2 * t) = κ ^ 2 * t / 2 - (r - κ * t) ^ 2 / (2 * t) := by
      rw [← hr_sq]
      have ht_ne : t ≠ 0 := ne_of_gt ht
      field_simp [ht_ne]
      ring
    linarith
  have hW_le_v : ∀ (x : EuclideanSpace ℝ (Fin d)) (t : ℝ), 0 < t →
      shiftedBarycentricEnvelope d κ v (mkSpaceTime x t) ≤ v (mkSpaceTime x t) := by
    intro x t ht
    unfold shiftedBarycentricEnvelope
    rw [h_projTime]
    have h_ub : barycentricEnvelope d t v (mkSpaceTime x t) ≤
        v (mkSpaceTime x t) + κ ^ 2 * t / 2 :=
      csSup_le ⟨v (mkSpaceTime x t), h_bary_mem x t⟩ (h_bary_ub x t ht)
    linarith
  have h_drift_ub : ∀ r : ℕ,
      2 * L₀ ≤ slopePlus d (ε_r r) v (mkSpaceTime (x_r r) (τ_r r)) +
        slopeMinus d (ε_r r) v (mkSpaceTime (x_r r) (τ_r r)) := by
    intro r
    obtain ⟨hτ_pos, _, hε_pos, _, _, h_drift⟩ := h_seq r
    set x := x_r r
    set τ := τ_r r
    set ε := ε_r r
    set z_r := mkSpaceTime x τ
    have hQ_ub : ∀ b ∈ (fun y' : EuclideanSpace ℝ (Fin d) =>
        shiftedBarycentricEnvelope d κ v (mkSpaceTime y' (projTime z_r + ε)) -
          ‖y' - projSpace z_r‖ ^ 2 / (2 * ε)) '' Set.univ,
        b ≤ v z_r + ε * slopePlus d ε v z_r := by
      rintro b ⟨y', -, rfl⟩
      rw [h_projSpace, h_projTime]
      have hW_le : shiftedBarycentricEnvelope d κ v (mkSpaceTime y' (τ + ε)) ≤
          v (mkSpaceTime y' (τ + ε)) :=
        hW_le_v y' (τ + ε) (by linarith)
      have hv_le := (h_comp x y' τ ε hε_pos).1
      linarith
    have h_sup_le : quadEnvelopePlus d ε (shiftedBarycentricEnvelope d κ v) z_r ≤
        v z_r + ε * slopePlus d ε v z_r := by
      apply csSup_le
      · exact ⟨_, ⟨x, Set.mem_univ x, rfl⟩⟩
      · exact hQ_ub
    have h_drift_mul : 2 * ε * L₀ ≤
        quadEnvelopePlus d ε (shiftedBarycentricEnvelope d κ v) z_r -
          quadEnvelopeMinus d ε v z_r := by
      have h2ε : (0 : ℝ) < 2 * ε := by positivity
      have h_le := (le_div_iff₀ h2ε).mp h_drift
      linarith
    have h_minus_mul : ε * slopeMinus d ε v z_r = v z_r - quadEnvelopeMinus d ε v z_r := by
      unfold slopeMinus
      exact mul_div_cancel₀ _ (ne_of_gt hε_pos)
    have h_sum_mul : ε * (2 * L₀) ≤ ε * (slopePlus d ε v z_r + slopeMinus d ε v z_r) := by
      linarith
    exact le_of_mul_le_mul_left h_sum_mul hε_pos
  obtain ⟨M₀, hM₀⟩ := h_growth (-1) 1 (1 / 4) (by norm_num)
  let M_back : ℝ := 2 * M₀ + (3 / 4 : ℝ) * (R + 1) ^ 2
  let L_end : ℝ := 2 * L₀ - M_back
  have h_slope_r : ∀ r : ℕ,
      L_end ≤ slopePlus d (ε_r r) v (mkSpaceTime (x_r r) (τ_r r)) := by
    intro r
    obtain ⟨hτ_pos, hτ_le, hε_pos, hε_le, hx_le, _⟩ := h_seq r
    set x := x_r r
    set τ := τ_r r
    set ε := ε_r r
    set z_r := mkSpaceTime x τ
    have h_mono_minus : slopeMinus d ε v z_r ≤ slopeMinus d 1 v z_r :=
      (h_mono x τ ε 1 hε_pos (by linarith)).2
    obtain ⟨y_minus, hy_minus⟩ := (h_attain x τ 1 zero_lt_one).2
    have hv_x : v (mkSpaceTime x τ) ≤ M₀ + (1 / 4 : ℝ) * ‖x‖ ^ 2 :=
      (abs_le.mp (hM₀ x τ (by linarith) (by linarith))).2
    have hv_ym : -v (mkSpaceTime y_minus (τ - 1)) ≤ M₀ + (1 / 4 : ℝ) * ‖y_minus‖ ^ 2 := by
      have h_abs := (abs_le.mp (hM₀ y_minus (τ - 1) (by linarith) (by linarith))).1
      linarith
    have hym_sq : ‖y_minus‖ ^ 2 ≤ 2 * ‖y_minus - x‖ ^ 2 + 2 * ‖x‖ ^ 2 :=
      norm_sq_le_two_sub_add x y_minus
    have hx_sq : ‖x‖ ^ 2 ≤ (R + 1) ^ 2 :=
      pow_le_pow_left₀ (norm_nonneg x) hx_le 2
    have h_minus_ub : slopeMinus d ε v z_r ≤ M_back := by
      dsimp [M_back]
      linarith
    have h_two := h_drift_ub r
    dsimp [L_end]
    linarith
  refine ⟨L_end, fun ℓ hℓ => ?_⟩
  obtain ⟨M_ℓ, hM_ℓ⟩ := h_growth ℓ ℓ (1 / (8 * ℓ)) (by positivity)
  let B_ℓ : ℝ := 8 * ℓ * max M_ℓ 0 + (3 / 2 : ℝ) * (R + 1) ^ 2
  let R_err : ℕ → ℝ := fun r =>
    τ_r r * L_end + (v (mkSpaceTime x_end 0) - v (mkSpaceTime (x_r r) (τ_r r))) +
      ((B_ℓ + 1) * ‖x_r r - x_end‖ + ‖x_r r - x_end‖ ^ 2) / (2 * ℓ)
  have h_step_r : ∀ r : ℕ, τ_r r < ℓ / 2 →
      ℓ * L_end ≤ ℓ * slopePlus d ℓ v (mkSpaceTime x_end 0) + R_err r := by
    intro r hτ_lt
    obtain ⟨hτ_pos, _, hε_pos, hε_le, hx_le, _⟩ := h_seq r
    set x := x_r r
    set τ := τ_r r
    set ε := ε_r r
    set z_r := mkSpaceTime x τ
    let h_r : ℝ := ℓ - τ
    have hh_r_pos : 0 < h_r := by dsimp [h_r]; linarith
    have hh_r_le : h_r ≤ ℓ := by dsimp [h_r]; linarith
    have hε_le_hr : ε ≤ h_r := by dsimp [h_r]; linarith
    have hτ_add_hr : τ + h_r = ℓ := by dsimp [h_r]; ring
    have h_slope_hr : L_end ≤ slopePlus d h_r v z_r :=
      le_trans (h_slope_r r) ((h_mono x τ ε h_r hε_pos hε_le_hr).1)
    have h_mul_hr : (ℓ - τ) * L_end ≤ h_r * slopePlus d h_r v z_r := by
      have h_le := mul_le_mul_of_nonneg_left h_slope_hr (le_of_lt hh_r_pos)
      dsimp [h_r] at h_le ⊢
      linarith
    obtain ⟨y_plus, hy_plus⟩ := (h_attain x τ h_r hh_r_pos).1
    rw [hτ_add_hr] at hy_plus
    have h_stat : v (mkSpaceTime x ℓ) - v z_r ≤ h_r * slopePlus d h_r v z_r := by
      have h_c := (h_comp x x τ h_r hh_r_pos).1
      rw [hτ_add_hr] at h_c
      simp only [sub_self, norm_zero, ne_eq, OfNat.ofNat_ne_zero, not_false_eq_true,
        zero_pow, zero_div, sub_zero] at h_c
      exact h_c
    have h_pen_le : ‖y_plus - x‖ ^ 2 / (2 * ℓ) ≤ ‖y_plus - x‖ ^ 2 / (2 * h_r) :=
      div_le_div_of_nonneg_left (sq_nonneg ‖y_plus - x‖) (by positivity) (by linarith)
    have h_diff_le : ‖y_plus - x‖ ^ 2 / (2 * ℓ) ≤
        v (mkSpaceTime y_plus ℓ) - v (mkSpaceTime x ℓ) := by
      linarith
    have hv_yp : v (mkSpaceTime y_plus ℓ) ≤ M_ℓ + (1 / (8 * ℓ)) * ‖y_plus‖ ^ 2 :=
      (abs_le.mp (hM_ℓ y_plus ℓ le_rfl le_rfl)).2
    have hv_xℓ : -v (mkSpaceTime x ℓ) ≤ M_ℓ + (1 / (8 * ℓ)) * ‖x‖ ^ 2 := by
      have h_abs := (abs_le.mp (hM_ℓ x ℓ le_rfl le_rfl)).1
      linarith
    have hyp_sq : ‖y_plus‖ ^ 2 ≤ 2 * ‖y_plus - x‖ ^ 2 + 2 * ‖x‖ ^ 2 :=
      norm_sq_le_two_sub_add x y_plus
    have hx_sq : ‖x‖ ^ 2 ≤ (R + 1) ^ 2 :=
      pow_le_pow_left₀ (norm_nonneg x) hx_le 2
    have h_one_8ℓ_pos : (0 : ℝ) ≤ 1 / (8 * ℓ) := by positivity
    have h_yp_bound : (1 / (8 * ℓ)) * ‖y_plus‖ ^ 2 ≤
        2 * (‖y_plus - x‖ ^ 2 / (8 * ℓ)) + 2 * ((1 / (8 * ℓ)) * (R + 1) ^ 2) := by
      have h1 := mul_le_mul_of_nonneg_left hyp_sq h_one_8ℓ_pos
      have h2 := mul_le_mul_of_nonneg_left hx_sq h_one_8ℓ_pos
      have h3 : (1 / (8 * ℓ)) * (2 * ‖y_plus - x‖ ^ 2 + 2 * ‖x‖ ^ 2) =
          2 * (‖y_plus - x‖ ^ 2 / (8 * ℓ)) + 2 * ((1 / (8 * ℓ)) * ‖x‖ ^ 2) := by ring
      linarith
    have h_xℓ_bound : (1 / (8 * ℓ)) * ‖x‖ ^ 2 ≤ (1 / (8 * ℓ)) * (R + 1) ^ 2 :=
      mul_le_mul_of_nonneg_left hx_sq h_one_8ℓ_pos
    have h_div_rel : ‖y_plus - x‖ ^ 2 / (2 * ℓ) = 4 * (‖y_plus - x‖ ^ 2 / (8 * ℓ)) := by ring
    have hM_max : M_ℓ ≤ max M_ℓ 0 := le_max_left M_ℓ 0
    have h_div_4ℓ : ‖y_plus - x‖ ^ 2 / (8 * ℓ) ≤
        max M_ℓ 0 + (3 / 2 : ℝ) * ((1 / (8 * ℓ)) * (R + 1) ^ 2) := by
      linarith
    have h_disp_bound : ‖y_plus - x‖ ^ 2 ≤ B_ℓ := by
      have h8ℓ_pos : (0 : ℝ) < 8 * ℓ := by positivity
      have h_mul8 := (div_le_iff₀ h8ℓ_pos).mp h_div_4ℓ
      have h_id8 : (max M_ℓ 0 + (3 / 2 : ℝ) * ((1 / (8 * ℓ)) * (R + 1) ^ 2)) * (8 * ℓ) = B_ℓ := by
        dsimp [B_ℓ]
        have hℓ_ne : ℓ ≠ 0 := ne_of_gt hℓ
        field_simp [hℓ_ne]
      linarith
    have h_quad_diff : ‖y_plus - x_end‖ ^ 2 / (2 * ℓ) - ‖y_plus - x‖ ^ 2 / (2 * ℓ) ≤
        ((B_ℓ + 1) * ‖x - x_end‖ + ‖x - x_end‖ ^ 2) / (2 * ℓ) := by
      have h_sub := norm_sq_sub_le_of_sq_le y_plus x x_end B_ℓ h_disp_bound
      have h_div := div_le_div_of_nonneg_right h_sub (by positivity : (0 : ℝ) ≤ 2 * ℓ)
      have h_sub_div : (‖y_plus - x_end‖ ^ 2 - ‖y_plus - x‖ ^ 2) / (2 * ℓ) =
          ‖y_plus - x_end‖ ^ 2 / (2 * ℓ) - ‖y_plus - x‖ ^ 2 / (2 * ℓ) := sub_div _ _ _
      linarith
    have h_comp_end : v (mkSpaceTime y_plus ℓ) - v (mkSpaceTime x_end 0) -
        ‖y_plus - x_end‖ ^ 2 / (2 * ℓ) ≤ ℓ * slopePlus d ℓ v (mkSpaceTime x_end 0) := by
      have hc := (h_comp x_end y_plus 0 ℓ hℓ).1
      rw [zero_add] at hc
      exact hc
    dsimp [R_err]
    linarith
  have h_norm_lim : Filter.Tendsto (fun r => ‖x_r r - x_end‖) Filter.atTop (nhds 0) :=
    tendsto_iff_norm_sub_tendsto_zero.mp hx_lim
  have hR_err_lim : Filter.Tendsto R_err Filter.atTop (nhds 0) := by
    have h1 : Filter.Tendsto (fun r => τ_r r * L_end) Filter.atTop (nhds (0 * L_end)) :=
      hτ_lim.mul_const L_end
    have h2 : Filter.Tendsto (fun r => v (mkSpaceTime x_end 0) - v (mkSpaceTime (x_r r) (τ_r r)))
        Filter.atTop (nhds (v (mkSpaceTime x_end 0) - v (mkSpaceTime x_end 0))) :=
      tendsto_const_nhds.sub hv_seq_lim
    have h3 : Filter.Tendsto
        (fun r => ((B_ℓ + 1) * ‖x_r r - x_end‖ + ‖x_r r - x_end‖ ^ 2) / (2 * ℓ))
        Filter.atTop (nhds (((B_ℓ + 1) * 0 + 0 ^ 2) / (2 * ℓ))) :=
      ((h_norm_lim.const_mul (B_ℓ + 1)).add (h_norm_lim.pow 2)).div_const (2 * ℓ)
    have h_sum := (h1.add h2).add h3
    have h_zero : 0 * L_end + (v (mkSpaceTime x_end 0) - v (mkSpaceTime x_end 0)) +
        ((B_ℓ + 1) * 0 + 0 ^ 2) / (2 * ℓ) = 0 := by ring
    rw [h_zero] at h_sum
    exact h_sum
  have h_ev : ∀ᶠ r in Filter.atTop,
      ℓ * L_end ≤ ℓ * slopePlus d ℓ v (mkSpaceTime x_end 0) + R_err r := by
    have h_ev_lt : ∀ᶠ r in Filter.atTop, τ_r r < ℓ / 2 :=
      hτ_lim.eventually (gt_mem_nhds (by positivity : (0 : ℝ) < ℓ / 2))
    exact h_ev_lt.mono h_step_r
  have h_lim_le : ℓ * L_end ≤ ℓ * slopePlus d ℓ v (mkSpaceTime x_end 0) + 0 :=
    ge_of_tendsto (tendsto_const_nhds.add hR_err_lim) h_ev
  exact le_of_mul_le_mul_left (by linarith) hℓ

theorem barycentric_contact_of_drift_lower_bound (d : ℕ) (κ : ℝ) (hκ : 0 < κ)
    (v : EuclideanSpace ℝ (Fin (d + 1)) → ℝ) (hv_cont : Continuous v)
    (hv_jensen : HasHorizontalJensenBound d κ v)
    (h_growth : ∀ (t₁ t₂ ε : ℝ), 0 < ε → ∃ M : ℝ, ∀ (y : EuclideanSpace ℝ (Fin d)) (s : ℝ),
      t₁ ≤ s → s ≤ t₂ → |v (mkSpaceTime y s)| ≤ M + ε * ‖y‖ ^ 2)
    (t₀ L_low : ℝ) (ht₀ : 0 < t₀)
    (x_star : EuclideanSpace ℝ (Fin d))
    (x_s : ℕ → EuclideanSpace ℝ (Fin d)) (ε_s : ℕ → ℝ)
    (hx_lim : Filter.Tendsto x_s Filter.atTop (nhds x_star))
    (hε_lim : Filter.Tendsto ε_s Filter.atTop (nhds 0))
    (h_seq : ∀ s : ℕ,
      0 < ε_s s ∧ ε_s s ≤ t₀ / 4 ∧
      L_low ≤ driftFunctional d κ (ε_s s) v (mkSpaceTime (x_s s) t₀)) :
    shiftedBarycentricEnvelope d κ v (mkSpaceTime x_star t₀) = v (mkSpaceTime x_star t₀) :=
by
  have h_projSpace : ∀ (x : EuclideanSpace ℝ (Fin d)) (t : ℝ), projSpace (mkSpaceTime x t) = x := by
    intro x t
    ext i
    simp [projSpace, mkSpaceTime]
  have h_projTime : ∀ (x : EuclideanSpace ℝ (Fin d)) (t : ℝ), projTime (mkSpaceTime x t) = t := by
    intro x t
    simp [projTime, mkSpaceTime]
  have h_cont_mk : Continuous (fun p : EuclideanSpace ℝ (Fin d) × ℝ => mkSpaceTime p.1 p.2) := by
    unfold mkSpaceTime
    refine (ContinuousLinearEquiv.continuous _).comp (continuous_pi_iff.mpr fun j => ?_)
    refine Fin.lastCases ?_ ?_ j
    · simpa [Fin.snoc_last] using continuous_snd
    · intro i
      simp only [Fin.snoc_castSucc]
      exact (PiLp.continuous_apply 2 _ i).comp continuous_fst
  have h_cont_Phi : Continuous (fun p : EuclideanSpace ℝ (Fin d) × ℝ => v (mkSpaceTime p.1 p.2)) :=
    hv_cont.comp h_cont_mk
  have h_norm_add_sq : ∀ a b : EuclideanSpace ℝ (Fin d), ‖a + b‖ ^ 2 ≤ 2 * ‖a‖ ^ 2 + 2 * ‖b‖ ^ 2 := by
    intro a b
    have h1 : ‖a + b‖ ≤ ‖a‖ + ‖b‖ := norm_add_le a b
    have h2 : 0 ≤ ‖a + b‖ := norm_nonneg (a + b)
    have h3 : 0 ≤ (‖a‖ - ‖b‖) ^ 2 := sq_nonneg (‖a‖ - ‖b‖)
    nlinarith
  have h_bary_mem : ∀ (x : EuclideanSpace ℝ (Fin d)) (t : ℝ),
      v (mkSpaceTime x t) ∈
        { val : ℝ | ∃ (N : ℕ) (θ : Fin N → ℝ) (y : Fin N → EuclideanSpace ℝ (Fin d)),
          (∀ i, 0 < θ i) ∧ (∑ i, θ i = 1) ∧ (∑ i, θ i • y i = projSpace (mkSpaceTime x t)) ∧
          val = (∑ i, θ i * v (mkSpaceTime (y i) (projTime (mkSpaceTime x t)))) -
            (∑ i, θ i * ‖y i - projSpace (mkSpaceTime x t)‖ ^ 2) / (2 * t) } := by
    intro x t
    refine ⟨1, fun _ => 1, fun _ => x, fun _ => zero_lt_one, by simp, ?_, ?_⟩
    · simp [h_projSpace]
    · simp [h_projSpace, h_projTime]
  have h_bary_ub : ∀ (x : EuclideanSpace ℝ (Fin d)) (t : ℝ), 0 < t →
      ∀ val ∈
        { val : ℝ | ∃ (N : ℕ) (θ : Fin N → ℝ) (y : Fin N → EuclideanSpace ℝ (Fin d)),
          (∀ i, 0 < θ i) ∧ (∑ i, θ i = 1) ∧ (∑ i, θ i • y i = projSpace (mkSpaceTime x t)) ∧
          val = (∑ i, θ i * v (mkSpaceTime (y i) (projTime (mkSpaceTime x t)))) -
            (∑ i, θ i * ‖y i - projSpace (mkSpaceTime x t)‖ ^ 2) / (2 * t) },
        val ≤ v (mkSpaceTime x t) + κ ^ 2 * t / 2 := by
    intro x t ht val hval
    rcases hval with ⟨N, θ, y, hθ_pos, hθ_sum, hy_mean, rfl⟩
    rw [h_projSpace] at hy_mean ⊢
    rw [h_projTime]
    have hj := hv_jensen t N θ y hθ_pos hθ_sum
    dsimp only at hj
    rw [hy_mean] at hj
    set V : ℝ := ∑ i, θ i * ‖y i - x‖ ^ 2
    set r : ℝ := Real.sqrt V
    have hV_nonneg : 0 ≤ V := by
      apply Finset.sum_nonneg
      intro i _
      exact mul_nonneg (le_of_lt (hθ_pos i)) (sq_nonneg _)
    have hr_sq : r ^ 2 = V := Real.sq_sqrt hV_nonneg
    have h_sq_nonneg : 0 ≤ (r - κ * t) ^ 2 / (2 * t) :=
      div_nonneg (sq_nonneg _) (by linarith)
    have h_id : κ * r - V / (2 * t) = κ ^ 2 * t / 2 - (r - κ * t) ^ 2 / (2 * t) := by
      rw [← hr_sq]
      have ht_ne : t ≠ 0 := ne_of_gt ht
      field_simp [ht_ne]
      ring
    linarith
  have hW_comp : ∀ (x : EuclideanSpace ℝ (Fin d)) (t : ℝ), 0 < t →
      ∀ (N : ℕ) (θ : Fin N → ℝ) (y : Fin N → EuclideanSpace ℝ (Fin d)),
        (∀ i, 0 < θ i) → (∑ i, θ i = 1) → (∑ i, θ i • y i = x) →
        (∑ i, θ i * v (mkSpaceTime (y i) t)) -
          (∑ i, θ i * ‖y i - x‖ ^ 2) / (2 * t) - κ ^ 2 * t / 2 ≤
            shiftedBarycentricEnvelope d κ v (mkSpaceTime x t) := by
    intro x t ht N θ y hθ_pos hθ_sum hy_mean
    unfold shiftedBarycentricEnvelope
    rw [h_projTime]
