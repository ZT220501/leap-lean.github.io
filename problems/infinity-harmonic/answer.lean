        |v_seq (ν (σ j)) (mkSpaceTime (x + h) (t + ℓ)) - v_seq (ν (σ j)) (mkSpaceTime x t) -
          inner ℝ (p_m (σ j)) h - q_m (σ j) * ℓ| ≤ 256 * R := by
      intro j hj
      have h_diff_p : ‖p - (1 + lam_seq (ν (σ j)) * q_m (σ j))⁻¹ • p_m (σ j)‖ ≤ 1 := by
        rw [norm_sub_rev, ← dist_eq_norm]
        exact le_of_lt (hj₁ j hj)
      have h_shear_j : ‖h - ((1 + lam_seq (ν (σ j)) * q_m (σ j))⁻¹ * ℓ) • p_m (σ j)‖ ≤ S := by
        have h_id : h - ((1 + lam_seq (ν (σ j)) * q_m (σ j))⁻¹ * ℓ) • p_m (σ j) =
            (h - ℓ • p) + ℓ • (p - (1 + lam_seq (ν (σ j)) * q_m (σ j))⁻¹ • p_m (σ j)) := by
          rw [smul_sub, mul_comm _ ℓ, mul_smul, sub_add_sub_cancel]
        rw [h_id]
        have h_tri := norm_add_le (h - ℓ • p) (ℓ • (p - (1 + lam_seq (ν (σ j)) * q_m (σ j))⁻¹ • p_m (σ j)))
        rw [norm_smul, Real.norm_eq_abs] at h_tri
        have h_mul : |ℓ| * ‖p - (1 + lam_seq (ν (σ j)) * q_m (σ j))⁻¹ • p_m (σ j)‖ ≤ R * 1 := by
          nlinarith [abs_nonneg ℓ, norm_nonneg (p - (1 + lam_seq (ν (σ j)) * q_m (σ j))⁻¹ • p_m (σ j))]
        dsimp [S]
        linarith
      have h_b := hbox_m (σ j) h ℓ hℓ_half h_shear_j
      dsimp [S] at h_b
      linarith
    have hv₁_tendsto : Filter.Tendsto (fun j => v_seq (ν (σ j)) (mkSpaceTime (x + h) (t + ℓ)))
        Filter.atTop (nhds (v (mkSpaceTime (x + h) (t + ℓ)))) :=
      (hv_tendsto (mkSpaceTime (x + h) (t + ℓ))).comp hμ_mono.tendsto_atTop
    have hv₀_tendsto : Filter.Tendsto (fun j => v_seq (ν (σ j)) (mkSpaceTime x t))
        Filter.atTop (nhds (v (mkSpaceTime x t))) :=
      (hv_tendsto (mkSpaceTime x t)).comp hμ_mono.tendsto_atTop
    have h_inner_tendsto : Filter.Tendsto (fun j => inner ℝ (p_m (σ j)) h)
        Filter.atTop (nhds (inner ℝ p h)) :=
      Filter.Tendsto.inner hp_tendsto tendsto_const_nhds
    have h_qℓ_tendsto : Filter.Tendsto (fun j => q_m (σ j) * ℓ)
        Filter.atTop (nhds (q * ℓ)) :=
      hq_tendsto.mul tendsto_const_nhds
    have h_lhs_tendsto : Filter.Tendsto
        (fun j => |v_seq (ν (σ j)) (mkSpaceTime (x + h) (t + ℓ)) - v_seq (ν (σ j)) (mkSpaceTime x t) -
          inner ℝ (p_m (σ j)) h - q_m (σ j) * ℓ|)
        Filter.atTop
        (nhds |v (mkSpaceTime (x + h) (t + ℓ)) - v (mkSpaceTime x t) - inner ℝ p h - q * ℓ|) :=
      (((hv₁_tendsto.sub hv₀_tendsto).sub h_inner_tendsto).sub h_qℓ_tendsto).abs
    have h_lim := le_of_tendsto h_lhs_tendsto (Filter.eventually_atTop.mpr ⟨j₁, h_bound_j⟩)
    have ha_eq : a - ‖p‖ ^ 2 / 2 = q := by dsimp [a]; ring
    rw [ha_eq]
    exact h_lim
  exact ⟨v, k, hv0, hv_cont, hk_mono, hv_unif, hv_fits⟩

theorem anisotropic_rescale_domain_and_continuity (d : ℕ) (hd : 3 ≤ d) (L : ℝ) (hL_ge : 1 ≤ L)
    (hL : HasUniformNormalizedLiftBounds d L)
    (u_seq : ℕ → EuclideanSpace ℝ (Fin d) → ℝ)
    (z_seq : ℕ → EuclideanSpace ℝ (Fin (d + 1)))
    (r_seq lam_seq : ℕ → ℝ)
    (h_scales : HasSelectedBlowupScales d u_seq z_seq r_seq lam_seq)
    (k : ℕ → ℕ) (hk_mono : StrictMono k)
    (P_seq : ℕ → EuclideanSpace ℝ (Fin (d + 1)))
    (O_seq : ℕ → (EuclideanSpace ℝ (Fin (d + 1)) ≃ₗᵢ[ℝ] EuclideanSpace ℝ (Fin (d + 1))))
    (z₀ : EuclideanSpace ℝ (Fin (d + 1))) (ρ : ℝ) (hρ : 0 < ρ) :
    ∃ i₁ : ℕ, ∀ i : ℕ, i₁ ≤ i →
      let j := k i
      (∀ w ∈ Metric.closedBall z₀ ρ,
        z_seq j + r_seq j • O_seq i (mkSpaceTime (Real.sqrt (lam_seq j) • projSpace w) (projTime w)) ∈
          Metric.ball (0 : EuclideanSpace ℝ (Fin (d + 1))) (15 / 16)) ∧
      ContinuousOn (anisotropicRescale (liftFunc (u_seq j)) (z_seq j) (r_seq j) ‖P_seq i‖ (lam_seq j) (O_seq i))
        (Metric.closedBall z₀ ρ) :=
by
  have h_projSpace_apply : ∀ (z : EuclideanSpace ℝ (Fin (d + 1))) (m : Fin d),
      projSpace z m = z (Fin.castSucc m) := fun _ _ => rfl
  have h_projTime_apply : ∀ (z : EuclideanSpace ℝ (Fin (d + 1))),
      projTime z = z (Fin.last d) := fun _ => rfl
  have h_projSpace_mk : ∀ (x : EuclideanSpace ℝ (Fin d)) (t : ℝ),
      projSpace (mkSpaceTime x t) = x := by
    intro x t
    ext m
    simp [projSpace, mkSpaceTime, Fin.snoc_castSucc]
  have h_projTime_mk : ∀ (x : EuclideanSpace ℝ (Fin d)) (t : ℝ),
      projTime (mkSpaceTime x t) = t := by
    intro x t
    simp [projTime, mkSpaceTime, Fin.snoc_last]
  have h_inner_split : ∀ (w₁ w₂ : EuclideanSpace ℝ (Fin (d + 1))),
      inner ℝ w₁ w₂ = inner ℝ (projSpace w₁) (projSpace w₂) + projTime w₁ * projTime w₂ := by
    intro w₁ w₂
    rw [PiLp.inner_apply, PiLp.inner_apply, Fin.sum_univ_castSucc]
    simp only [h_projSpace_apply, h_projTime_apply, RCLike.inner_apply, conj_trivial]
    ring
  have h_norm_sq : ∀ (w : EuclideanSpace ℝ (Fin (d + 1))),
      ‖w‖ ^ 2 = ‖projSpace w‖ ^ 2 + (projTime w) ^ 2 := by
    intro w
    have h1 := h_inner_split w w
    rw [real_inner_self_eq_norm_mul_norm, real_inner_self_eq_norm_mul_norm] at h1
    linarith [sq ‖w‖, sq ‖projSpace w‖, sq (projTime w)]
  have h_stretch_le : ∀ (w : EuclideanSpace ℝ (Fin (d + 1))) (lam : ℝ),
      0 ≤ lam → lam ≤ 1 →
      ‖mkSpaceTime (Real.sqrt lam • projSpace w) (projTime w)‖ ≤ ‖w‖ := by
    intro w lam hlam_nonneg hlam_le
    let u := mkSpaceTime (Real.sqrt lam • projSpace w) (projTime w)
    have h_sq_u : ‖u‖ ^ 2 = lam * ‖projSpace w‖ ^ 2 + (projTime w) ^ 2 := by
      rw [h_norm_sq u, h_projSpace_mk, h_projTime_mk, norm_smul,
        Real.norm_of_nonneg (Real.sqrt_nonneg lam), mul_pow, Real.sq_sqrt hlam_nonneg]
    have h_sq_le : ‖u‖ ^ 2 ≤ ‖w‖ ^ 2 := by
      rw [h_sq_u, h_norm_sq w]
      have h_mul : lam * ‖projSpace w‖ ^ 2 ≤ 1 * ‖projSpace w‖ ^ 2 :=
        mul_le_mul_of_nonneg_right hlam_le (sq_nonneg ‖projSpace w‖)
      linarith
    exact (abs_le_of_sq_le_sq' h_sq_le (norm_nonneg w)).2
  have h_cont_projTime : Continuous (projTime : EuclideanSpace ℝ (Fin (d + 1)) → ℝ) :=
    PiLp.continuous_apply 2 (fun _ : Fin (d + 1) => ℝ) (Fin.last d)
  have h_cont_stretch : ∀ (s : ℝ),
      Continuous (fun w : EuclideanSpace ℝ (Fin (d + 1)) =>
        mkSpaceTime (s • projSpace w) (projTime w)) := by
    intro s
    refine (EuclideanSpace.equiv (Fin (d + 1)) ℝ).symm.continuous.comp (continuous_pi (fun m => ?_))
    refine Fin.lastCases ?_ ?_ m
    · simp only [Fin.snoc_last]
      exact h_cont_projTime
    · intro m'
      simp only [Fin.snoc_castSucc]
      exact continuous_const.mul (PiLp.continuous_apply 2 (fun _ : Fin (d + 1) => ℝ) (Fin.castSucc m'))
  let K : ℝ := ‖z₀‖ + ρ
  have hK_pos : 0 < K := add_pos_of_nonneg_of_pos (norm_nonneg z₀) hρ
  obtain ⟨i₁, hi₁⟩ := exists_nat_gt (16 * K)
  refine ⟨i₁, fun i hi => ?_⟩
  intro j
  obtain ⟨hu_j, hz_j, hr_pos, hr_le, hlam_pos, hlam_lt, _, _⟩ := h_scales.1 j
  have hz_norm : ‖z_seq j‖ < 3 / 4 := by
    simpa [Metric.mem_ball, dist_zero_right] using hz_j
  have hij : i₁ ≤ j := hi.trans (hk_mono.id_le i)
  have hij_cast : (i₁ : ℝ) ≤ (j : ℝ) := Nat.cast_le.mpr hij
  have hj8_pos : 0 < (j : ℝ) + 8 := by positivity
  have hK_le_j8 : K ≤ (j : ℝ) + 8 := by linarith
  have hr_j8 : ((j : ℝ) + 8) * r_seq j ≤ 3 / 4 - ‖z_seq j‖ := by
    have h_mul := mul_le_mul_of_nonneg_left hr_le hj8_pos.le
    have h_cancel : ((j : ℝ) + 8) * (1 / ((j : ℝ) + 8) * (3 / 4 - ‖z_seq j‖)) = 3 / 4 - ‖z_seq j‖ := by
      field_simp [hj8_pos.ne']
    linarith
  have h_dom : ∀ w ∈ Metric.closedBall z₀ ρ,
      z_seq j + r_seq j • O_seq i (mkSpaceTime (Real.sqrt (lam_seq j) • projSpace w) (projTime w)) ∈
        Metric.ball (0 : EuclideanSpace ℝ (Fin (d + 1))) (15 / 16) := by
    intro w hw
    have hw_dist : ‖w - z₀‖ ≤ ρ := by
      simpa [Metric.mem_closedBall, dist_eq_norm] using hw
    have hw_norm : ‖w‖ ≤ K := by
      have h_tri : ‖w‖ ≤ ‖w - z₀‖ + ‖z₀‖ := by
        simpa [sub_add_cancel] using norm_add_le (w - z₀) z₀
      linarith
    let u_w := mkSpaceTime (Real.sqrt (lam_seq j) • projSpace w) (projTime w)
    have hlam_le1 : lam_seq j ≤ 1 := by linarith
    have hu_w_le : ‖u_w‖ ≤ K :=
      (h_stretch_le w (lam_seq j) hlam_pos.le hlam_le1).trans hw_norm
    have h_map_norm : ‖z_seq j + r_seq j • O_seq i u_w‖ < 15 / 16 := by
      have h_tri : ‖z_seq j + r_seq j • O_seq i u_w‖ ≤ ‖z_seq j‖ + ‖r_seq j • O_seq i u_w‖ :=
        norm_add_le _ _
      have h_smul : ‖r_seq j • O_seq i u_w‖ = r_seq j * ‖u_w‖ := by
        rw [norm_smul, Real.norm_of_nonneg hr_pos.le, (O_seq i).norm_map]
      have hrK : r_seq j * ‖u_w‖ ≤ 3 / 4 - ‖z_seq j‖ := by
        nlinarith
      linarith
    simpa [Metric.mem_ball, dist_zero_right] using h_map_norm
  refine ⟨h_dom, ?_⟩
  have hU_cont : ContinuousOn (liftFunc (u_seq j)) (Metric.ball 0 (15 / 16)) :=
    (hL (u_seq j) hu_j).1.1
  let T_i : EuclideanSpace ℝ (Fin (d + 1)) → EuclideanSpace ℝ (Fin (d + 1)) :=
    fun w => z_seq j + r_seq j • O_seq i (mkSpaceTime (Real.sqrt (lam_seq j) • projSpace w) (projTime w))
  have hT_cont : Continuous T_i :=
    continuous_const.add (((O_seq i).continuous.comp (h_cont_stretch (Real.sqrt (lam_seq j)))).const_smul (r_seq j))
  have hT_maps : Set.MapsTo T_i (Metric.closedBall z₀ ρ) (Metric.ball 0 (15 / 16)) :=
    fun w hw => h_dom w hw
  have h_comp_cont : ContinuousOn (fun w => liftFunc (u_seq j) (T_i w)) (Metric.closedBall z₀ ρ) :=
    ContinuousOn.comp hU_cont hT_cont.continuousOn hT_maps
  have h_num_cont : ContinuousOn
      (fun w => liftFunc (u_seq j) (T_i w) - liftFunc (u_seq j) (z_seq j) - r_seq j * ‖P_seq i‖ * projTime w)
      (Metric.closedBall z₀ ρ) :=
    (h_comp_cont.sub continuousOn_const).sub ((continuous_const.mul h_cont_projTime).continuousOn)
  exact h_num_cont.div_const (r_seq j * ‖P_seq i‖ * lam_seq j)

theorem interior_maximizer_seq_of_quartic_margin (d : ℕ)
    (z₀ : EuclideanSpace ℝ (Fin (d + 1))) (ρ : ℝ) (hρ : 0 < ρ)
    (f_seq : ℕ → EuclideanSpace ℝ (Fin (d + 1)) → ℝ)
    (f : EuclideanSpace ℝ (Fin (d + 1)) → ℝ) (i₁ : ℕ)
    (hf_cont : ∀ i : ℕ, i₁ ≤ i → ContinuousOn (f_seq i) (Metric.closedBall z₀ ρ))
    (hf_unif : ∀ ε : ℝ, 0 < ε →
      ∃ i₀ : ℕ, ∀ i : ℕ, i₀ ≤ i →
        ∀ w ∈ Metric.closedBall z₀ ρ, |f_seq i w - f w| ≤ ε)
    (hf_z₀ : f z₀ = 0)
    (hf_margin : ∀ w ∈ Metric.closedBall z₀ ρ, f w ≤ -‖w - z₀‖ ^ 4) :
    ∃ (i₂ : ℕ) (w_seq : ℕ → EuclideanSpace ℝ (Fin (d + 1))),
      i₁ ≤ i₂ ∧
      Filter.Tendsto w_seq Filter.atTop (nhds z₀) ∧
      (∀ i : ℕ, i₂ ≤ i →
        w_seq i ∈ Metric.ball z₀ ρ ∧
        ∀ w ∈ Metric.ball z₀ ρ, f_seq i w ≤ f_seq i (w_seq i)) :=
by
  let K : Set (EuclideanSpace ℝ (Fin (d + 1))) := Metric.closedBall z₀ ρ
  have hz₀_K : z₀ ∈ K := Metric.mem_closedBall_self hρ.le
  have hK_nonempty : K.Nonempty := ⟨z₀, hz₀_K⟩
  have hK_compact : IsCompact K := isCompact_closedBall z₀ ρ
  have h_ex_max : ∀ i : ℕ, ∃ wi ∈ K, i₁ ≤ i → ∀ w ∈ K, f_seq i w ≤ f_seq i wi := by
    intro i
    by_cases hi : i₁ ≤ i
    · obtain ⟨wi, hwi_K, hwi_max⟩ := hK_compact.exists_isMaxOn hK_nonempty (hf_cont i hi)
      exact ⟨wi, hwi_K, fun _ w hw => isMaxOn_iff.mp hwi_max w hw⟩
    · exact ⟨z₀, hz₀_K, fun h_le => False.elim (hi h_le)⟩
  choose w_seq hw_seq using h_ex_max
  have hw_K : ∀ i : ℕ, w_seq i ∈ K := fun i => (hw_seq i).1
  have hw_max_K : ∀ i : ℕ, i₁ ≤ i → ∀ w ∈ K, f_seq i w ≤ f_seq i (w_seq i) :=
    fun i hi w hw => (hw_seq i).2 hi w hw
  have hw_tendsto : Filter.Tendsto w_seq Filter.atTop (nhds z₀) := by
    rw [Metric.tendsto_atTop]
    intro r hr_pos
    let δ : ℝ := min r ρ
    have hδ_pos : 0 < δ := lt_min hr_pos hρ
    let ε : ℝ := δ ^ 4 / 4
    have hε_pos : 0 < ε := by positivity
    obtain ⟨i₀, hi₀⟩ := hf_unif ε hε_pos
    refine ⟨max i₁ i₀, fun i hi => ?_⟩
    have hi₁ : i₁ ≤ i := le_trans (le_max_left i₁ i₀) hi
    have hi₀_le : i₀ ≤ i := le_trans (le_max_right i₁ i₀) hi
    have hwi_K : w_seq i ∈ K := hw_K i
    have h_max_z₀ : f_seq i z₀ ≤ f_seq i (w_seq i) := hw_max_K i hi₁ z₀ hz₀_K
    have h_unif_wi : f_seq i (w_seq i) - f (w_seq i) ≤ ε :=
      (abs_sub_le_iff.mp (hi₀ i hi₀_le (w_seq i) hwi_K)).1
    have h_unif_z₀ : f z₀ - f_seq i z₀ ≤ ε :=
      (abs_sub_le_iff.mp (hi₀ i hi₀_le z₀ hz₀_K)).2
    have h_marg_wi : f (w_seq i) ≤ -‖w_seq i - z₀‖ ^ 4 := hf_margin (w_seq i) hwi_K
    have h_quartic_le : ‖w_seq i - z₀‖ ^ 4 ≤ 2 * ε := by linarith
    have h_lt_δ : ‖w_seq i - z₀‖ < δ := by
      by_contra h_not_lt
      have h_le_norm : δ ≤ ‖w_seq i - z₀‖ := not_lt.mp h_not_lt
      have h_pow : δ ^ 4 ≤ ‖w_seq i - z₀‖ ^ 4 := pow_le_pow_left₀ hδ_pos.le h_le_norm 4
      have hδ4_pos : 0 < δ ^ 4 := by positivity
      dsimp [ε] at h_quartic_le
      linarith
    rw [dist_eq_norm]
    exact lt_of_lt_of_le h_lt_δ (min_le_left r ρ)
  have h_ev_ball : ∀ᶠ i in Filter.atTop, w_seq i ∈ Metric.ball z₀ ρ :=
    hw_tendsto.eventually (Metric.isOpen_ball.mem_nhds (Metric.mem_ball_self hρ))
  obtain ⟨i₃, hi₃⟩ := Filter.eventually_atTop.mp h_ev_ball
  refine ⟨max i₁ i₃, w_seq, le_max_left i₁ i₃, hw_tendsto, fun i hi => ?_⟩
  have hi₁ : i₁ ≤ i := le_trans (le_max_left i₁ i₃) hi
  have hi₃_le : i₃ ≤ i := le_trans (le_max_right i₁ i₃) hi
  exact ⟨hi₃ i hi₃_le, fun w hw => hw_max_K i hi₁ w (Metric.ball_subset_closedBall hw)⟩

theorem anisotropic_pullback_test_and_infinityLaplacian (d : ℕ) (hd : 3 ≤ d)
    (U : EuclideanSpace ℝ (Fin (d + 1)) → ℝ)
    (hU_har : IsInfinityHarmonicOn U (Metric.ball 0 (15 / 16)))
    (z_c : EuclideanSpace ℝ (Fin (d + 1))) (r c lam : ℝ)
    (hr : 0 < r) (hc : 0 < c) (hlam : 0 < lam)
    (O : EuclideanSpace ℝ (Fin (d + 1)) ≃ₗᵢ[ℝ] EuclideanSpace ℝ (Fin (d + 1)))
    (W : Set (EuclideanSpace ℝ (Fin (d + 1)))) (hW_open : IsOpen W)
    (w₀ : EuclideanSpace ℝ (Fin (d + 1))) (hw₀ : w₀ ∈ W)
    (ψ : EuclideanSpace ℝ (Fin (d + 1)) → ℝ) (hψ_C2 : ContDiffOn ℝ 2 ψ W)
    (h_dom : ∀ w ∈ W,
      z_c + r • O (mkSpaceTime (Real.sqrt lam • projSpace w) (projTime w)) ∈
        Metric.ball (0 : EuclideanSpace ℝ (Fin (d + 1))) (15 / 16)) :
    let v_res := anisotropicRescale U z_c r c lam O
    let ξ : EuclideanSpace ℝ (Fin (d + 1)) :=
      mkSpaceTime (projSpace (gradient ψ w₀)) (1 + lam * projTime (gradient ψ w₀))
    ((∀ w ∈ W, v_res w - ψ w ≤ v_res w₀ - ψ w₀) →
      0 ≤ fderiv ℝ (fderiv ℝ ψ) w₀ ξ ξ) ∧
    ((∀ w ∈ W, v_res w₀ - ψ w₀ ≤ v_res w - ψ w) →
      fderiv ℝ (fderiv ℝ ψ) w₀ ξ ξ ≤ 0) :=
by
  intro v_res ξ
  have _ := hd
  have projSpace_mkSpaceTime :
      ∀ (x : EuclideanSpace ℝ (Fin d)) (t : ℝ), projSpace (mkSpaceTime x t) = x := by
    intro x t
    ext i
    simp [projSpace, mkSpaceTime, Fin.snoc_castSucc]
  have projTime_mkSpaceTime :
      ∀ (x : EuclideanSpace ℝ (Fin d)) (t : ℝ), projTime (mkSpaceTime x t) = t := by
    intro x t
    simp [projTime, mkSpaceTime, Fin.snoc_last]
  have mkSpaceTime_projSpace_projTime :
      ∀ z : EuclideanSpace ℝ (Fin (d + 1)), mkSpaceTime (projSpace z) (projTime z) = z := by
    intro z
    ext i
    refine Fin.lastCases ?_ ?_ i
    · simp [mkSpaceTime, projTime, Fin.snoc_last]
    · intro j
      simp [mkSpaceTime, projSpace, Fin.snoc_castSucc]
  have projSpace_add :
      ∀ z₁ z₂ : EuclideanSpace ℝ (Fin (d + 1)),
        projSpace (z₁ + z₂) = projSpace z₁ + projSpace z₂ := by
    intro z₁ z₂
    ext i
    simp [projSpace]
  have projTime_add :
      ∀ z₁ z₂ : EuclideanSpace ℝ (Fin (d + 1)),
        projTime (z₁ + z₂) = projTime z₁ + projTime z₂ := by
    intro z₁ z₂
    simp [projTime]
  have projSpace_smul :
      ∀ (a : ℝ) (z : EuclideanSpace ℝ (Fin (d + 1))),
        projSpace (a • z) = a • projSpace z := by
    intro a z
    ext i
    simp [projSpace]
  have projTime_smul :
      ∀ (a : ℝ) (z : EuclideanSpace ℝ (Fin (d + 1))),
        projTime (a • z) = a * projTime z := by
    intro a z
    simp [projTime]
  have mkSpaceTime_add :
      ∀ (x₁ x₂ : EuclideanSpace ℝ (Fin d)) (t₁ t₂ : ℝ),
        mkSpaceTime (x₁ + x₂) (t₁ + t₂) = mkSpaceTime x₁ t₁ + mkSpaceTime x₂ t₂ := by
    intro x₁ x₂ t₁ t₂
    ext i
    refine Fin.lastCases ?_ ?_ i
    · simp [mkSpaceTime, Fin.snoc_last]
    · intro j
      simp [mkSpaceTime, Fin.snoc_castSucc]
  have mkSpaceTime_smul :
      ∀ (a : ℝ) (x : EuclideanSpace ℝ (Fin d)) (t : ℝ),
        mkSpaceTime (a • x) (a * t) = a • mkSpaceTime x t := by
    intro a x t
    ext i
    refine Fin.lastCases ?_ ?_ i
    · simp [mkSpaceTime, Fin.snoc_last]
    · intro j
      simp [mkSpaceTime, Fin.snoc_castSucc]
  have inner_eq_projSpace_add_projTime :
      ∀ z₁ z₂ : EuclideanSpace ℝ (Fin (d + 1)),
        inner ℝ z₁ z₂ = inner ℝ (projSpace z₁) (projSpace z₂) + projTime z₁ * projTime z₂ := by
    intro z₁ z₂
    rw [PiLp.inner_apply, PiLp.inner_apply, Fin.sum_univ_castSucc]
    simp [projSpace, projTime, mul_comm]
  let projTimeCLM : EuclideanSpace ℝ (Fin (d + 1)) →L[ℝ] ℝ :=
    LinearMap.toContinuousLinearMap
      { toFun := projTime
        map_add' := projTime_add
        map_smul' := projTime_smul }
  have deriv_deriv_line_eq_fderiv_fderiv :
      ∀ {E : Type} [NormedAddCommGroup E] [NormedSpace ℝ E]
        {f : E → ℝ} {V : Set E}, IsOpen V → ∀ {z₀ : E}, z₀ ∈ V →
        ContDiffOn ℝ 2 f V → ∀ (v : E),
        deriv (deriv (fun t : ℝ => f (z₀ + t • v))) 0 = fderiv ℝ (fderiv ℝ f) z₀ v v := by
    intro E _ _ f V hV z₀ hz₀ hf v
    have h_pre : IsOpen ((fun t : ℝ => z₀ + t • v) ⁻¹' V) :=
      hV.preimage (continuous_const.add (continuous_id.smul continuous_const))
    have h0_mem : (0 : ℝ) ∈ (fun t : ℝ => z₀ + t • v) ⁻¹' V := by simp [hz₀]
    have h_ev : (fun t : ℝ => deriv (fun s : ℝ => f (z₀ + s • v)) t) =ᶠ[nhds 0]
        (fun t : ℝ => (fderiv ℝ f (z₀ + t • v)) v) := by
      filter_upwards [h_pre.mem_nhds h0_mem] with t ht
      have hf_diff : DifferentiableAt ℝ f (z₀ + t • v) :=
        ((hf.contDiffAt (hV.mem_nhds ht)).differentiableAt (by norm_num))
      have h_line : HasDerivAt (fun s : ℝ => z₀ + s • v) v t := by
        simpa using (hasDerivAt_id t).smul_const v |>.const_add z₀
      exact (hf_diff.hasFDerivAt.comp_hasDerivAt t h_line).deriv
    rw [h_ev.deriv_eq]
    have hcd : ContDiffAt ℝ 2 f z₀ := hf.contDiffAt (hV.mem_nhds hz₀)
    have hcd1 : ContDiffAt ℝ 1 (fderiv ℝ f) z₀ := hcd.fderiv_right (by norm_num)
    have hf2_diff : HasFDerivAt (fderiv ℝ f) (fderiv ℝ (fderiv ℝ f) z₀) (z₀ + (0 : ℝ) • v) := by
      simpa using (hcd1.differentiableAt (by norm_num)).hasFDerivAt
    have h_line0 : HasDerivAt (fun t : ℝ => z₀ + t • v) v 0 := by
      simpa using (hasDerivAt_id (0 : ℝ)).smul_const v |>.const_add z₀
    have h_comp : HasDerivAt (fun t : ℝ => fderiv ℝ f (z₀ + t • v))
        (fderiv ℝ (fderiv ℝ f) z₀ v) 0 :=
      hf2_diff.comp_hasDerivAt 0 h_line0
    exact ((ContinuousLinearMap.apply ℝ ℝ v).hasFDerivAt.comp_hasDerivAt 0 h_comp).deriv
  let stretchCLM : ℝ → (EuclideanSpace ℝ (Fin (d + 1)) →L[ℝ] EuclideanSpace ℝ (Fin (d + 1))) :=
    fun s => LinearMap.toContinuousLinearMap
      { toFun := fun w => mkSpaceTime (s • projSpace w) (projTime w)
        map_add' := fun w₁ w₂ => by
          rw [projSpace_add, smul_add, projTime_add, mkSpaceTime_add]
        map_smul' := fun a w => by
          rw [projSpace_smul, smul_comm s a, projTime_smul, RingHom.id_apply, mkSpaceTime_smul] }
  have stretchCLM_apply :
      ∀ (s : ℝ) (w : EuclideanSpace ℝ (Fin (d + 1))),
        stretchCLM s w = mkSpaceTime (s • projSpace w) (projTime w) :=
    fun _ _ => rfl
  have stretchCLM_comp_apply :
      ∀ (s₁ s₂ : ℝ) (w : EuclideanSpace ℝ (Fin (d + 1))),
        stretchCLM s₁ (stretchCLM s₂ w) = stretchCLM (s₁ * s₂) w := by
    intro s₁ s₂ w
    rw [stretchCLM_apply, stretchCLM_apply, projSpace_mkSpaceTime, projTime_mkSpaceTime,
      smul_smul, ← stretchCLM_apply]
  have stretchCLM_one :
      ∀ w : EuclideanSpace ℝ (Fin (d + 1)), stretchCLM 1 w = w := by
    intro w
    rw [stretchCLM_apply, one_smul, mkSpaceTime_projSpace_projTime]
  let σ : ℝ := Real.sqrt lam
  have hσ_pos : 0 < σ := Real.sqrt_pos.mpr hlam
  have hσ_ne : σ ≠ 0 := ne_of_gt hσ_pos
  have hr_ne : r ≠ 0 := ne_of_gt hr
  have hc_ne : c ≠ 0 := ne_of_gt hc
  have hlam_ne : lam ≠ 0 := ne_of_gt hlam
  have hσ_sq : σ * σ = lam := Real.mul_self_sqrt (le_of_lt hlam)
  let O_clm : EuclideanSpace ℝ (Fin (d + 1)) →L[ℝ] EuclideanSpace ℝ (Fin (d + 1)) :=
    O.toLinearIsometry.toContinuousLinearMap
  let O_symm_clm : EuclideanSpace ℝ (Fin (d + 1)) →L[ℝ] EuclideanSpace ℝ (Fin (d + 1)) :=
    O.symm.toLinearIsometry.toContinuousLinearMap
  let M : EuclideanSpace ℝ (Fin (d + 1)) →L[ℝ] EuclideanSpace ℝ (Fin (d + 1)) :=
    (r • O_clm).comp (stretchCLM σ)
  let M_inv : EuclideanSpace ℝ (Fin (d + 1)) →L[ℝ] EuclideanSpace ℝ (Fin (d + 1)) :=
    (stretchCLM σ⁻¹).comp (r⁻¹ • O_symm_clm)
  have hM_apply : ∀ w : EuclideanSpace ℝ (Fin (d + 1)),
      M w = r • O (mkSpaceTime (σ • projSpace w) (projTime w)) := fun _ => rfl
  have hM_inv_M : ∀ w : EuclideanSpace ℝ (Fin (d + 1)), M_inv (M w) = w := by
    intro w
    change stretchCLM σ⁻¹ (r⁻¹ • O.symm (r • O (stretchCLM σ w))) = w
    rw [O.symm.map_smul, O.symm_apply_apply, smul_smul, inv_mul_cancel₀ hr_ne, one_smul,
      stretchCLM_comp_apply, inv_mul_cancel₀ hσ_ne, stretchCLM_one]
  have hM_M_inv : ∀ u : EuclideanSpace ℝ (Fin (d + 1)), M (M_inv u) = u := by
    intro u
    change r • O (stretchCLM σ (stretchCLM σ⁻¹ (r⁻¹ • O.symm u))) = u
    rw [stretchCLM_comp_apply, mul_inv_cancel₀ hσ_ne, stretchCLM_one,
      map_smul, O.apply_symm_apply, smul_smul, mul_inv_cancel₀ hr_ne, one_smul]
  let T : EuclideanSpace ℝ (Fin (d + 1)) → EuclideanSpace ℝ (Fin (d + 1)) :=
    fun w => z_c + M w
  let T_inv : EuclideanSpace ℝ (Fin (d + 1)) → EuclideanSpace ℝ (Fin (d + 1)) :=
    fun Z => M_inv (Z - z_c)
  have hT_inv_T : ∀ w : EuclideanSpace ℝ (Fin (d + 1)), T_inv (T w) = w := by
    intro w
    dsimp [T, T_inv]
    rw [add_sub_cancel_left, hM_inv_M]
  have hT_T_inv : ∀ Z : EuclideanSpace ℝ (Fin (d + 1)), T (T_inv Z) = Z := by
    intro Z
    dsimp [T, T_inv]
    rw [hM_M_inv, add_sub_cancel]
  let V_phys : Set (EuclideanSpace ℝ (Fin (d + 1))) := T_inv ⁻¹' W
  let Z₀ : EuclideanSpace ℝ (Fin (d + 1)) := T w₀
  have hT_inv_C2 : ContDiff ℝ 2 T_inv :=
    M_inv.contDiff.comp (contDiff_id.sub contDiff_const)
  have hT_inv_cont : Continuous T_inv := hT_inv_C2.continuous
  have hV_open : IsOpen V_phys := hW_open.preimage hT_inv_cont
  have hZ₀_V : Z₀ ∈ V_phys := by
    change T_inv Z₀ ∈ W
    rw [hT_inv_T w₀]
    exact hw₀
  have hV_sub : V_phys ⊆ Metric.ball (0 : EuclideanSpace ℝ (Fin (d + 1))) (15 / 16) := by
    intro Z hZ
    have h_in : T (T_inv Z) ∈ Metric.ball (0 : EuclideanSpace ℝ (Fin (d + 1))) (15 / 16) :=
      h_dom (T_inv Z) hZ
    rwa [hT_T_inv Z] at h_in
  have hZ₀_ball : Z₀ ∈ Metric.ball (0 : EuclideanSpace ℝ (Fin (d + 1))) (15 / 16) :=
    hV_sub hZ₀_V
  let K : ℝ := r * c * lam
  have hK_pos : 0 < K := mul_pos (mul_pos hr hc) hlam
  have hK_ne : K ≠ 0 := ne_of_gt hK_pos
  let C₀ : ℝ := U z_c + K * (v_res w₀ - ψ w₀)
  let Φ : EuclideanSpace ℝ (Fin (d + 1)) → ℝ :=
    fun Z => C₀ + (r * c) * projTime (T_inv Z) + K * ψ (T_inv Z)
  have h_U_T : ∀ w : EuclideanSpace ℝ (Fin (d + 1)),
      U (T w) = U z_c + (r * c) * projTime w + K * v_res w := by
    intro w
    have h_def : v_res w = (U (T w) - U z_c - r * c * projTime w) / K := rfl
    rw [h_def, mul_div_cancel₀ _ hK_ne]
    ring
  have h_Φ_sub_U : ∀ Z : EuclideanSpace ℝ (Fin (d + 1)),
      Φ Z - U Z = K * ((v_res w₀ - ψ w₀) - (v_res (T_inv Z) - ψ (T_inv Z))) := by
    intro Z
    have h1 := h_U_T (T_inv Z)
    rw [hT_T_inv Z] at h1
    dsimp [Φ, C₀]
    linarith
  have hΦ_Z₀ : Φ Z₀ = U Z₀ := by
    have h1 := h_Φ_sub_U Z₀
    rw [hT_inv_T w₀] at h1
    linarith
  have hΦ_C2 : ContDiffOn ℝ 2 Φ V_phys := by
    have h_pt : ContDiffOn ℝ 2 (fun Z => (r * c) * projTime (T_inv Z)) V_phys := by
      change ContDiffOn ℝ 2 (fun Z => (r * c) • (projTimeCLM ∘ T_inv) Z) V_phys
      exact (projTimeCLM.contDiff.comp hT_inv_C2).contDiffOn.const_smul (r * c)
    have h_ψ_comp : ContDiffOn ℝ 2 (fun Z => K * ψ (T_inv Z)) V_phys := by
      change ContDiffOn ℝ 2 (fun Z => K • (ψ ∘ T_inv) Z) V_phys
      exact (hψ_C2.comp hT_inv_C2.contDiffOn (fun Z hZ => hZ)).const_smul K
    exact (contDiffOn_const.add h_pt).add h_ψ_comp
  let ζ : EuclideanSpace ℝ (Fin (d + 1)) := (c / r) • ξ
  let η : EuclideanSpace ℝ (Fin (d + 1)) := M ζ
  have hη_eq : η = c • O (stretchCLM σ ξ) := by
    dsimp [η, ζ]
    rw [map_smul, hM_apply, ← stretchCLM_apply, smul_smul, div_mul_cancel₀ c hr_ne]
  have hgrad_Φ : gradient Φ Z₀ = η := by
    apply HasGradientAt.gradient
    rw [hasGradientAt_iff_hasFDerivAt]
    have hT_inv_fd : HasFDerivAt T_inv M_inv Z₀ := by
      change HasFDerivAt (fun Z => M_inv (Z - z_c)) (M_inv.comp (ContinuousLinearMap.id ℝ _)) Z₀
      exact (M_inv.hasFDerivAt (x := Z₀ - z_c)).comp Z₀ ((hasFDerivAt_id Z₀).sub_const z_c)
    have hpt_fd : HasFDerivAt (fun Z => (r * c) * projTime (T_inv Z))
        ((r * c) • (projTimeCLM.comp M_inv)) Z₀ := by
      change HasFDerivAt (fun Z => (r * c) • (projTimeCLM (T_inv Z))) _ Z₀
      exact (projTimeCLM.hasFDerivAt.comp Z₀ hT_inv_fd).const_smul (r * c)
    have hψ_diff : DifferentiableAt ℝ ψ w₀ :=
      (hψ_C2.contDiffAt (hW_open.mem_nhds hw₀)).differentiableAt (by norm_num)
    have hψ_fd0 : HasFDerivAt ψ (InnerProductSpace.toDual ℝ _ (gradient ψ w₀)) (T_inv Z₀) := by
      rw [hT_inv_T w₀]
      exact hasGradientAt_iff_hasFDerivAt.mp hψ_diff.hasGradientAt
    have hψ_fd : HasFDerivAt (fun Z => K * ψ (T_inv Z))
        (K • ((InnerProductSpace.toDual ℝ _ (gradient ψ w₀)).comp M_inv)) Z₀ := by
      change HasFDerivAt (fun Z => K • ψ (T_inv Z)) _ Z₀
      exact (hψ_fd0.comp Z₀ hT_inv_fd).const_smul K
    have hΦ_fd : HasFDerivAt Φ
        (((r * c) • (projTimeCLM.comp M_inv)) +
          (K • ((InnerProductSpace.toDual ℝ _ (gradient ψ w₀)).comp M_inv))) Z₀ := by
      have h1 : HasFDerivAt (fun Z => C₀ + (r * c) * projTime (T_inv Z))
          (0 + (r * c) • (projTimeCLM.comp M_inv)) Z₀ :=
        (hasFDerivAt_const C₀ Z₀).add hpt_fd
      rw [zero_add] at h1
      exact h1.add hψ_fd
    have h_clm_eq : InnerProductSpace.toDual ℝ _ η =
        ((r * c) • (projTimeCLM.comp M_inv)) +
          (K • ((InnerProductSpace.toDual ℝ _ (gradient ψ w₀)).comp M_inv)) := by
      ext H
      set h := M_inv H
      have hH : H = r • O (stretchCLM σ h) := by
        have h1 := (hM_M_inv H).symm
        rwa [hM_apply, ← stretchCLM_apply] at h1
      change inner ℝ η H = (r * c) * projTime h + K * inner ℝ (gradient ψ w₀) h
      rw [hη_eq, hH, inner_smul_left, inner_smul_right, RCLike.conj_to_real,
        O.inner_map_map, stretchCLM_apply, stretchCLM_apply,
        inner_eq_projSpace_add_projTime, projSpace_mkSpaceTime, projTime_mkSpaceTime,
        projSpace_mkSpaceTime, projTime_mkSpaceTime,
        projSpace_mkSpaceTime, projTime_mkSpaceTime,
        inner_smul_left, inner_smul_right, RCLike.conj_to_real,
        inner_eq_projSpace_add_projTime (gradient ψ w₀) h]
      dsimp [K]
      linear_combination (r * c * inner ℝ (projSpace (gradient ψ w₀)) (projSpace h)) * hσ_sq
    rw [h_clm_eq]
    exact hΦ_fd
  have h_ray_T_inv : ∀ s : ℝ, T_inv (Z₀ + s • η) = w₀ + s • ζ := by
    intro s
    change M_inv (z_c + M w₀ + s • M ζ - z_c) = w₀ + s • ζ
    have h_vec : z_c + M w₀ + s • M ζ - z_c = M (w₀ + s • ζ) := by
      rw [M.map_add w₀ (s • ζ), M.map_smul s ζ, add_assoc, add_sub_cancel_left]
    rw [h_vec, hM_inv_M]
  let A₀ : ℝ := C₀ + (r * c) * projTime w₀
  let B₀ : ℝ := (r * c) * projTime ζ
  let g : ℝ → ℝ := fun s => ψ (w₀ + s • ζ)
  have h_ray_Φ : (fun s : ℝ => Φ (Z₀ + s • η)) = (fun s : ℝ => A₀ + B₀ * s + K * g s) := by
    ext s
    dsimp [Φ, A₀, B₀, g]
    rw [h_ray_T_inv s, projTime_add, projTime_smul]
    ring
  have h_lap_Φ : infinityLaplacian Φ Z₀ = (lam * c ^ 3 / r) * fderiv ℝ (fderiv ℝ ψ) w₀ ξ ξ := by
    unfold infinityLaplacian
    rw [hgrad_Φ, ← deriv_deriv_line_eq_fderiv_fderiv hV_open hZ₀_V hΦ_C2 η, h_ray_Φ]
    have h_pre_s : IsOpen ((fun s : ℝ => w₀ + s • ζ) ⁻¹' W) :=
      hW_open.preimage (continuous_const.add (continuous_id.smul continuous_const))
    have h0_s : (0 : ℝ) ∈ (fun s : ℝ => w₀ + s • ζ) ⁻¹' W := by simp [hw₀]
    have h_ev1 : deriv (fun s : ℝ => A₀ + B₀ * s + K * g s) =ᶠ[nhds 0]
        (fun s : ℝ => B₀ + K * deriv g s) := by
      filter_upwards [h_pre_s.mem_nhds h0_s] with s hs
      have hψ_diff_s : DifferentiableAt ℝ ψ (w₀ + s • ζ) :=
        (hψ_C2.contDiffAt (hW_open.mem_nhds hs)).differentiableAt (by norm_num)
      have h_line_s : HasDerivAt (fun t : ℝ => w₀ + t • ζ) ζ s := by
        simpa using (hasDerivAt_id s).smul_const ζ |>.const_add w₀
      have hg_diff_s : HasDerivAt g (deriv g s) s :=
        (hψ_diff_s.hasFDerivAt.comp_hasDerivAt s h_line_s).differentiableAt.hasDerivAt
      have h_lin_s : HasDerivAt (fun t : ℝ => A₀ + B₀ * t) B₀ s := by
        simpa using ((hasDerivAt_id s).const_mul B₀).const_add A₀
      exact (h_lin_s.add (hg_diff_s.const_mul K)).deriv
    rw [h_ev1.deriv_eq, deriv_const_add, deriv_const_mul_field,
      deriv_deriv_line_eq_fderiv_fderiv hW_open hw₀ hψ_C2 ζ]
    dsimp [ζ, K]
    rw [map_smul, map_smul, ContinuousLinearMap.smul_apply, smul_eq_mul, smul_eq_mul]
    field_simp [hr_ne]
  have h_pref_pos : 0 < lam * c ^ 3 / r := div_pos (mul_pos hlam (pow_pos hc 3)) hr
  refine ⟨?_, ?_⟩
  · intro h_max
    have h_upper : ∀ Z ∈ V_phys, U Z ≤ Φ Z := by
      intro Z hZ
      have h_le : v_res (T_inv Z) - ψ (T_inv Z) ≤ v_res w₀ - ψ w₀ := h_max (T_inv Z) hZ
      have h_sub := h_Φ_sub_U Z
      have h_nonneg : 0 ≤ K * ((v_res w₀ - ψ w₀) - (v_res (T_inv Z) - ψ (T_inv Z))) :=
        mul_nonneg (le_of_lt hK_pos) (sub_nonneg.mpr h_le)
      linarith
    have h_visc : 0 ≤ infinityLaplacian Φ Z₀ :=
      hU_har.2.1 Z₀ hZ₀_ball Φ V_phys hV_open hZ₀_V hV_sub hΦ_C2 hΦ_Z₀ h_upper
    rw [h_lap_Φ] at h_visc
    exact nonneg_of_mul_nonneg_right h_visc h_pref_pos
  · intro h_min
    have h_lower : ∀ Z ∈ V_phys, Φ Z ≤ U Z := by
      intro Z hZ
      have h_le : v_res w₀ - ψ w₀ ≤ v_res (T_inv Z) - ψ (T_inv Z) := h_min (T_inv Z) hZ
      have h_sub := h_Φ_sub_U Z
      have h_nonpos : K * ((v_res w₀ - ψ w₀) - (v_res (T_inv Z) - ψ (T_inv Z))) ≤ 0 :=
        mul_nonpos_of_nonneg_of_nonpos (le_of_lt hK_pos) (sub_nonpos.mpr h_le)
      linarith
    have h_visc : infinityLaplacian Φ Z₀ ≤ 0 :=
      hU_har.2.2 Z₀ hZ₀_ball Φ V_phys hV_open hZ₀_V hV_sub hΦ_C2 hΦ_Z₀ h_lower
    rw [h_lap_Φ] at h_visc
    exact nonpos_of_mul_nonpos_right h_visc h_pref_pos

theorem quartic_perturbation_and_rescaled_jet_limit (d : ℕ) (hd : 3 ≤ d)
    (V : Set (EuclideanSpace ℝ (Fin (d + 1)))) (hV_open : IsOpen V)
    (z₀ : EuclideanSpace ℝ (Fin (d + 1))) (hz₀ : z₀ ∈ V)
    (ϕ : EuclideanSpace ℝ (Fin (d + 1)) → ℝ) (hϕ_C2 : ContDiffOn ℝ 2 ϕ V)
    (σ : ℝ) :
    let ψ : EuclideanSpace ℝ (Fin (d + 1)) → ℝ := fun w => ϕ w + σ * ‖w - z₀‖ ^ 4
    ContDiffOn ℝ 2 ψ V ∧
    ∀ (w_seq : ℕ → EuclideanSpace ℝ (Fin (d + 1))) (μ_seq : ℕ → ℝ),
      Filter.Tendsto w_seq Filter.atTop (nhds z₀) →
      Filter.Tendsto μ_seq Filter.atTop (nhds 0) →
      Filter.Tendsto
        (fun i =>
          let ξ_i : EuclideanSpace ℝ (Fin (d + 1)) :=
            mkSpaceTime (projSpace (gradient ψ (w_seq i)))
              (1 + μ_seq i * projTime (gradient ψ (w_seq i)))
          fderiv ℝ (fderiv ℝ ψ) (w_seq i) ξ_i ξ_i)
        Filter.atTop (nhds (limitingOperator ϕ z₀)) :=
by
  intro ψ
  let q : EuclideanSpace ℝ (Fin (d + 1)) → ℝ := fun w => ‖w - z₀‖ ^ 2
  let q₂ : EuclideanSpace ℝ (Fin (d + 1)) → ℝ := fun w => (q w) ^ 2
  let g : EuclideanSpace ℝ (Fin (d + 1)) → ℝ := fun w => σ * q₂ w
  have hψ_eq : ψ = fun w => ϕ w + g w := by
    ext w
    dsimp [ψ, g, q₂, q]
    ring
  have hq_smooth : ContDiff ℝ (⊤ : ℕ∞) q := (contDiff_id.sub contDiff_const).norm_sq ℝ
  have hq₂_smooth : ContDiff ℝ (⊤ : ℕ∞) q₂ := hq_smooth.pow 2
  have hg_smooth : ContDiff ℝ (⊤ : ℕ∞) g := contDiff_const.mul hq₂_smooth
  have hg_c2 : ContDiffOn ℝ 2 g V := (hg_smooth.of_le (by simp)).contDiffOn
  have hψ_c2 : ContDiffOn ℝ 2 ψ V := by
    rw [hψ_eq]
    exact hϕ_C2.add hg_c2
  refine ⟨hψ_c2, ?_⟩
  have h_fderiv_c1 : ContDiffOn ℝ 1 (fderiv ℝ ψ) V :=
    hψ_c2.fderiv_of_isOpen hV_open (by norm_num)
  have h_fderiv2_cont : ContinuousOn (fderiv ℝ (fderiv ℝ ψ)) V :=
    h_fderiv_c1.continuousOn_fderiv_of_isOpen hV_open le_rfl
  have h_fderiv2_contAt : ContinuousAt (fderiv ℝ (fderiv ℝ ψ)) z₀ :=
    h_fderiv2_cont.continuousAt (hV_open.mem_nhds hz₀)
  have h_fderiv1_cont : ContinuousOn (fderiv ℝ ψ) V :=
    hψ_c2.continuousOn_fderiv_of_isOpen hV_open (by norm_num)
  have h_grad_cont : ContinuousOn (gradient ψ) V :=
    (InnerProductSpace.toDual ℝ (EuclideanSpace ℝ (Fin (d + 1)))).symm.continuous.comp_continuousOn
      h_fderiv1_cont
  have h_grad_contAt : ContinuousAt (gradient ψ) z₀ :=
    h_grad_cont.continuousAt (hV_open.mem_nhds hz₀)
  have hq_diff : Differentiable ℝ q := hq_smooth.differentiable (by simp)
  have hq₂_diff : Differentiable ℝ q₂ := hq₂_smooth.differentiable (by simp)
  have hg_diff : Differentiable ℝ g := hg_smooth.differentiable (by simp)
  have hq0 : q z₀ = 0 := by simp [q]
  have hq'_z0 : fderiv ℝ q z₀ = 0 := by
    have h1 := ((hasFDerivAt_id z₀).sub_const z₀).norm_sq
    have h2 := h1.fderiv
    simpa [q] using h2
  have h_mul : q₂ = q * q := by
    ext x
    exact sq (q x)
  have hq₂_fderiv_eq : fderiv ℝ q₂ = q • fderiv ℝ q + q • fderiv ℝ q := by
    ext y v
    have h_has := ((hq_diff y).hasFDerivAt.mul (hq_diff y).hasFDerivAt).fderiv
    rw [h_mul, h_has]
    rfl
  have hq₂_1 : fderiv ℝ q₂ z₀ = 0 := by
    rw [hq₂_fderiv_eq]
    simp [hq0]
  have hq'_smooth : ContDiff ℝ 1 (fderiv ℝ q) :=
    (hq_smooth.of_le (by simp : (2 : WithTop ℕ∞) ≤ (⊤ : ℕ∞))).fderiv_right (by norm_num)
  have hq'_diff : Differentiable ℝ (fderiv ℝ q) := hq'_smooth.differentiable (by norm_num)
  have hq₂_2 : fderiv ℝ (fderiv ℝ q₂) z₀ = 0 := by
    have h_smul := (hq_diff z₀).hasFDerivAt.smul (hq'_diff z₀).hasFDerivAt
    have h_add := (h_smul.add h_smul).fderiv
    rw [hq₂_fderiv_eq]
    simpa [hq0, hq'_z0] using h_add
  have hq₂'_diff_z0 : DifferentiableAt ℝ (fderiv ℝ q₂) z₀ := by
    have h_smul := (hq_diff z₀).hasFDerivAt.smul (hq'_diff z₀).hasFDerivAt
    rw [hq₂_fderiv_eq]
    exact (h_smul.add h_smul).differentiableAt
  have hg_fderiv_eq : fderiv ℝ g = σ • fderiv ℝ q₂ := by
    ext y v
    have h_has := ((hq₂_diff y).hasFDerivAt.const_mul σ).fderiv
    exact congrArg (fun L => L v) h_has
  have hg1 : fderiv ℝ g z₀ = 0 := by
    rw [hg_fderiv_eq]
    simp [hq₂_1]
  have hg'_diff_z0 : DifferentiableAt ℝ (fderiv ℝ g) z₀ := by
    rw [hg_fderiv_eq]
    exact (hq₂'_diff_z0.hasFDerivAt.const_smul σ).differentiableAt
  have hg2 : fderiv ℝ (fderiv ℝ g) z₀ = 0 := by
    have h_csmul := (hq₂'_diff_z0.hasFDerivAt.const_smul σ).fderiv
    rw [hg_fderiv_eq]
    simpa [hq₂_2] using h_csmul
  have hψ_fderiv_V : ∀ y ∈ V, fderiv ℝ ψ y = fderiv ℝ ϕ y + fderiv ℝ g y := by
    intro y hy
    have hϕ_diff : DifferentiableAt ℝ ϕ y :=
      (hϕ_C2.contDiffAt (hV_open.mem_nhds hy)).differentiableAt (by norm_num)
    rw [hψ_eq]
    exact fderiv_add hϕ_diff (hg_diff y)
  have hψ_fderiv_z0 : fderiv ℝ ψ z₀ = fderiv ℝ ϕ z₀ := by
    rw [hψ_fderiv_V z₀ hz₀, hg1, add_zero]
  have hψ_grad_z0 : gradient ψ z₀ = gradient ϕ z₀ := by
    simp [gradient, hψ_fderiv_z0]
  have h_ev : fderiv ℝ ψ =ᶠ[nhds z₀] fderiv ℝ ϕ + fderiv ℝ g :=
    Filter.eventuallyEq_of_mem (hV_open.mem_nhds hz₀) (fun y hy => hψ_fderiv_V y hy)
  have hϕ'_diff_z0 : DifferentiableAt ℝ (fderiv ℝ ϕ) z₀ := by
    have hϕ'_c1 : ContDiffAt ℝ 1 (fderiv ℝ ϕ) z₀ :=
      (hϕ_C2.contDiffAt (hV_open.mem_nhds hz₀)).fderiv_right (by norm_num)
    exact hϕ'_c1.differentiableAt (by norm_num)
  have hψ_fderiv2_z0 : fderiv ℝ (fderiv ℝ ψ) z₀ = fderiv ℝ (fderiv ℝ ϕ) z₀ := by
    rw [h_ev.fderiv_eq, fderiv_add hϕ'_diff_z0 hg'_diff_z0, hg2, add_zero]
  have projSpace_add :
      ∀ z₁ z₂ : EuclideanSpace ℝ (Fin (d + 1)),
        projSpace (z₁ + z₂) = projSpace z₁ + projSpace z₂ := by
    intro z₁ z₂
    ext i
    simp [projSpace]
  have projTime_add :
      ∀ z₁ z₂ : EuclideanSpace ℝ (Fin (d + 1)),
        projTime (z₁ + z₂) = projTime z₁ + projTime z₂ := by
    intro z₁ z₂
    simp [projTime]
  have projSpace_smul :
      ∀ (c : ℝ) (z : EuclideanSpace ℝ (Fin (d + 1))),
        projSpace (c • z) = c • projSpace z := by
    intro c z
    ext i
    simp [projSpace]
  have projTime_smul :
      ∀ (c : ℝ) (z : EuclideanSpace ℝ (Fin (d + 1))),
        projTime (c • z) = c * projTime z := by
    intro c z
    simp [projTime]
  have mkSpaceTime_add :
      ∀ (x₁ x₂ : EuclideanSpace ℝ (Fin d)) (t₁ t₂ : ℝ),
        mkSpaceTime (x₁ + x₂) (t₁ + t₂) = mkSpaceTime x₁ t₁ + mkSpaceTime x₂ t₂ := by
    intro x₁ x₂ t₁ t₂
    ext i
    refine Fin.lastCases ?_ ?_ i
    · simp [mkSpaceTime, Fin.snoc_last]
    · intro j
      simp [mkSpaceTime, Fin.snoc_castSucc]
  have mkSpaceTime_smul :
      ∀ (c : ℝ) (x : EuclideanSpace ℝ (Fin d)) (t : ℝ),
        mkSpaceTime (c • x) (c * t) = c • mkSpaceTime x t := by
    intro c x t
    ext i
    refine Fin.lastCases ?_ ?_ i
    · simp [mkSpaceTime, Fin.snoc_last]
    · intro j
      simp [mkSpaceTime, Fin.snoc_castSucc]
  let projSpaceCLM : EuclideanSpace ℝ (Fin (d + 1)) →L[ℝ] EuclideanSpace ℝ (Fin d) :=
    LinearMap.toContinuousLinearMap
      { toFun := projSpace
        map_add' := projSpace_add
        map_smul' := projSpace_smul }
  let projTimeCLM : EuclideanSpace ℝ (Fin (d + 1)) →L[ℝ] ℝ :=
    LinearMap.toContinuousLinearMap
      { toFun := projTime
        map_add' := projTime_add
        map_smul' := projTime_smul }
  let mkSpaceCLM : EuclideanSpace ℝ (Fin d) →L[ℝ] EuclideanSpace ℝ (Fin (d + 1)) :=
    LinearMap.toContinuousLinearMap
      { toFun := fun x => mkSpaceTime x 0
        map_add' := fun x₁ x₂ => by simpa using mkSpaceTime_add x₁ x₂ 0 0
        map_smul' := fun c x => by simpa using mkSpaceTime_smul c x 0 }
  let mkTimeCLM : ℝ →L[ℝ] EuclideanSpace ℝ (Fin (d + 1)) :=
    LinearMap.toContinuousLinearMap
      { toFun := fun t => mkSpaceTime 0 t
        map_add' := fun t₁ t₂ => by simpa using mkSpaceTime_add 0 0 t₁ t₂
        map_smul' := fun c t => by simpa using mkSpaceTime_smul c 0 t }
  have mkSpaceTime_eq_clm :
      ∀ (x : EuclideanSpace ℝ (Fin d)) (t : ℝ),
        mkSpaceTime x t = mkSpaceCLM x + mkTimeCLM t := by
    intro x t
    change mkSpaceTime x t = mkSpaceTime x 0 + mkSpaceTime 0 t
    simpa using mkSpaceTime_add x 0 0 t
  intro w_seq μ_seq hw_tendsto hμ_tendsto
  have h_grad_tendsto :
      Filter.Tendsto (fun i => gradient ψ (w_seq i)) Filter.atTop (nhds (gradient ϕ z₀)) := by
    rw [← hψ_grad_z0]
    exact h_grad_contAt.tendsto.comp hw_tendsto
  have h_space_tendsto :
      Filter.Tendsto (fun i => projSpace (gradient ψ (w_seq i)))
        Filter.atTop (nhds (projSpace (gradient ϕ z₀))) :=
    (projSpaceCLM.continuous.tendsto (gradient ϕ z₀)).comp h_grad_tendsto
  have h_time_grad_tendsto :
      Filter.Tendsto (fun i => projTime (gradient ψ (w_seq i)))
        Filter.atTop (nhds (projTime (gradient ϕ z₀))) :=
    (projTimeCLM.continuous.tendsto (gradient ϕ z₀)).comp h_grad_tendsto
  have h_time_tendsto :
      Filter.Tendsto (fun i => 1 + μ_seq i * projTime (gradient ψ (w_seq i)))
        Filter.atTop (nhds 1) := by
    simpa using tendsto_const_nhds.add (hμ_tendsto.mul h_time_grad_tendsto)
  let ξ₀ : EuclideanSpace ℝ (Fin (d + 1)) := mkSpaceTime (projSpace (gradient ϕ z₀)) 1
  have h_ξ_tendsto :
      Filter.Tendsto
        (fun i =>
          mkSpaceTime (projSpace (gradient ψ (w_seq i)))
            (1 + μ_seq i * projTime (gradient ψ (w_seq i))))
        Filter.atTop (nhds ξ₀) := by
    have h1 : Filter.Tendsto (fun i => mkSpaceCLM (projSpace (gradient ψ (w_seq i))))
        Filter.atTop (nhds (mkSpaceCLM (projSpace (gradient ϕ z₀)))) :=
      (mkSpaceCLM.continuous.tendsto (projSpace (gradient ϕ z₀))).comp h_space_tendsto
    have h2 : Filter.Tendsto (fun i => mkTimeCLM (1 + μ_seq i * projTime (gradient ψ (w_seq i))))
        Filter.atTop (nhds (mkTimeCLM 1)) :=
      (mkTimeCLM.continuous.tendsto (1 : ℝ)).comp h_time_tendsto
    have h3 := h1.add h2
    simp only [← mkSpaceTime_eq_clm] at h3
    exact h3
  have h_fderiv2_tendsto :
      Filter.Tendsto (fun i => fderiv ℝ (fderiv ℝ ψ) (w_seq i))
        Filter.atTop (nhds (fderiv ℝ (fderiv ℝ ϕ) z₀)) := by
    rw [← hψ_fderiv2_z0]
    exact h_fderiv2_contAt.tendsto.comp hw_tendsto
  have h_step1 :
      Filter.Tendsto
        (fun i =>
          fderiv ℝ (fderiv ℝ ψ) (w_seq i)
            (mkSpaceTime (projSpace (gradient ψ (w_seq i)))
              (1 + μ_seq i * projTime (gradient ψ (w_seq i)))))
        Filter.atTop (nhds (fderiv ℝ (fderiv ℝ ϕ) z₀ ξ₀)) :=
    (isBoundedBilinearMap_apply.continuous.tendsto (fderiv ℝ (fderiv ℝ ϕ) z₀, ξ₀)).comp
      (h_fderiv2_tendsto.prodMk_nhds h_ξ_tendsto)
  exact (isBoundedBilinearMap_apply.continuous.tendsto (fderiv ℝ (fderiv ℝ ϕ) z₀ ξ₀, ξ₀)).comp
    (h_step1.prodMk_nhds h_ξ_tendsto)

theorem viscosity_limit_of_anisotropic_blowup (d : ℕ) (hd : 3 ≤ d) (L : ℝ) (hL_ge : 1 ≤ L)
    (hL : HasUniformNormalizedLiftBounds d L)
    (u_seq : ℕ → EuclideanSpace ℝ (Fin d) → ℝ)
    (z_seq : ℕ → EuclideanSpace ℝ (Fin (d + 1)))
    (r_seq lam_seq : ℕ → ℝ)
    (h_scales : HasSelectedBlowupScales d u_seq z_seq r_seq lam_seq)
    (v : EuclideanSpace ℝ (Fin (d + 1)) → ℝ)
    (hv_cont : Continuous v)
    (hv_limit : IsAnisotropicBlowupLimit d L u_seq z_seq r_seq lam_seq v) :
    (∀ z : EuclideanSpace ℝ (Fin (d + 1)), ∀ ϕ : EuclideanSpace ℝ (Fin (d + 1)) → ℝ,
      ∀ V : Set (EuclideanSpace ℝ (Fin (d + 1))),
        IsOpen V → z ∈ V → ContDiffOn ℝ 2 ϕ V → ϕ z = v z → (∀ y ∈ V, v y ≤ ϕ y) →
        0 ≤ limitingOperator ϕ z) ∧
    (∀ z : EuclideanSpace ℝ (Fin (d + 1)), ∀ ϕ : EuclideanSpace ℝ (Fin (d + 1)) → ℝ,
      ∀ V : Set (EuclideanSpace ℝ (Fin (d + 1))),
        IsOpen V → z ∈ V → ContDiffOn ℝ 2 ϕ V → ϕ z = v z → (∀ y ∈ V, ϕ y ≤ v y) →
        limitingOperator ϕ z ≤ 0) :=
by
  obtain ⟨_, k, P_seq, O_seq, hk_mono, h_fit, hv_unif⟩ := hv_limit
  let v_seq : ℕ → EuclideanSpace ℝ (Fin (d + 1)) → ℝ :=
    fun i => anisotropicRescale (liftFunc (u_seq (k i))) (z_seq (k i)) (r_seq (k i)) ‖P_seq i‖ (lam_seq (k i)) (O_seq i)
  have hlam_k_tendsto : Filter.Tendsto (fun i => lam_seq (k i)) Filter.atTop (nhds 0) :=
    h_scales.2.1.comp hk_mono.tendsto_atTop
  refine ⟨?_, ?_⟩
  · intro z₀ ϕ V hV_open hz₀ hϕ_C2 hϕ_z₀ hv_le_ϕ
    obtain ⟨r₀, hr₀_pos, hr₀_sub⟩ := Metric.mem_nhds_iff.mp (hV_open.mem_nhds hz₀)
    let ρ : ℝ := r₀ / 2
    have hρ_pos : 0 < ρ := half_pos hr₀_pos
    have h_cb_sub : Metric.closedBall z₀ ρ ⊆ V :=
      (Metric.closedBall_subset_ball (half_lt_self hr₀_pos)).trans hr₀_sub
    have hw_norm_le : ∀ w ∈ Metric.closedBall z₀ ρ, ‖w‖ ≤ ‖z₀‖ + ρ + 1 := by
      intro w hw
      have hw_dist : ‖w - z₀‖ ≤ ρ := by simpa [Metric.mem_closedBall, dist_eq_norm] using hw
      have h_tri : ‖w‖ ≤ ‖w - z₀‖ + ‖z₀‖ := by
        simpa [sub_add_cancel] using norm_add_le (w - z₀) z₀
      linarith
    let ψ₁ : EuclideanSpace ℝ (Fin (d + 1)) → ℝ := fun w => ϕ w + (1 : ℝ) * ‖w - z₀‖ ^ 4
    obtain ⟨hψ₁_C2, hψ₁_lim⟩ :=
      quartic_perturbation_and_rescaled_jet_limit d hd V hV_open z₀ hz₀ ϕ hϕ_C2 1
    obtain ⟨i₁, hi₁⟩ :=
      anisotropic_rescale_domain_and_continuity d hd L hL_ge hL u_seq z_seq r_seq lam_seq h_scales
        k hk_mono P_seq O_seq z₀ ρ hρ_pos
    have hf₁_cont : ∀ i : ℕ, i₁ ≤ i →
        ContinuousOn (fun w => v_seq i w - ψ₁ w) (Metric.closedBall z₀ ρ) := by
      intro i hi
      exact (hi₁ i hi).2.sub (hψ₁_C2.continuousOn.mono h_cb_sub)
    have hf₁_unif : ∀ ε : ℝ, 0 < ε →
        ∃ i₀ : ℕ, ∀ i : ℕ, i₀ ≤ i →
          ∀ w ∈ Metric.closedBall z₀ ρ, |(v_seq i w - ψ₁ w) - (v w - ψ₁ w)| ≤ ε := by
      intro ε hε
      obtain ⟨i₀, hi₀⟩ := hv_unif (‖z₀‖ + ρ + 1) ε (by positivity) hε
      refine ⟨i₀, fun i hi w hw => ?_⟩
      have h_eq : (v_seq i w - ψ₁ w) - (v w - ψ₁ w) = v_seq i w - v w := by ring
      rw [h_eq]
      exact hi₀ i hi w (hw_norm_le w hw)
    have hf₁_z₀ : v z₀ - ψ₁ z₀ = 0 := by
      simp [ψ₁, hϕ_z₀]
    have hf₁_margin : ∀ w ∈ Metric.closedBall z₀ ρ, v w - ψ₁ w ≤ -‖w - z₀‖ ^ 4 := by
      intro w hw
      have h_le : v w ≤ ϕ w := hv_le_ϕ w (h_cb_sub hw)
      dsimp [ψ₁]
      linarith
    obtain ⟨i₂, w_seq, hi₁_le_i₂, hw_tendsto, hw_max⟩ :=
      interior_maximizer_seq_of_quartic_margin d z₀ ρ hρ_pos
        (fun i w => v_seq i w - ψ₁ w) (fun w => v w - ψ₁ w) i₁
        hf₁_cont hf₁_unif hf₁_z₀ hf₁_margin
    have h_jet_nonneg : ∀ i : ℕ, i₂ ≤ i →
        let ξ_i : EuclideanSpace ℝ (Fin (d + 1)) :=
          mkSpaceTime (projSpace (gradient ψ₁ (w_seq i)))
            (1 + lam_seq (k i) * projTime (gradient ψ₁ (w_seq i)))
        0 ≤ fderiv ℝ (fderiv ℝ ψ₁) (w_seq i) ξ_i ξ_i := by
      intro i hi
      let j := k i
      obtain ⟨hu_j, _, hr_j, _, hlam_j, _⟩ := h_scales.1 j
      have hU_har_j : IsInfinityHarmonicOn (liftFunc (u_seq j)) (Metric.ball 0 (15 / 16)) :=
        (hL (u_seq j) hu_j).1
      have hc_pos : 0 < ‖P_seq i‖ := by linarith [(h_fit i).2.1]
      have hψ₁_W : ContDiffOn ℝ 2 ψ₁ (Metric.ball z₀ ρ) :=
        hψ₁_C2.mono (Metric.ball_subset_closedBall.trans h_cb_sub)
      have h_dom_W : ∀ w ∈ Metric.ball z₀ ρ,
          z_seq j + r_seq j • O_seq i (mkSpaceTime (Real.sqrt (lam_seq j) • projSpace w) (projTime w)) ∈
            Metric.ball (0 : EuclideanSpace ℝ (Fin (d + 1))) (15 / 16) :=
        fun w hw => (hi₁ i (hi₁_le_i₂.trans hi)).1 w (Metric.ball_subset_closedBall hw)
      exact (anisotropic_pullback_test_and_infinityLaplacian d hd (liftFunc (u_seq j)) hU_har_j
        (z_seq j) (r_seq j) ‖P_seq i‖ (lam_seq j) hr_j hc_pos hlam_j (O_seq i)
        (Metric.ball z₀ ρ) Metric.isOpen_ball (w_seq i) (hw_max i hi).1 ψ₁ hψ₁_W h_dom_W).1
        (hw_max i hi).2
    exact ge_of_tendsto (hψ₁_lim w_seq (fun i => lam_seq (k i)) hw_tendsto hlam_k_tendsto)
      (Filter.eventually_atTop.mpr ⟨i₂, h_jet_nonneg⟩)
  · intro z₀ ϕ V hV_open hz₀ hϕ_C2 hϕ_z₀ hϕ_le_v
    obtain ⟨r₀, hr₀_pos, hr₀_sub⟩ := Metric.mem_nhds_iff.mp (hV_open.mem_nhds hz₀)
    let ρ : ℝ := r₀ / 2
    have hρ_pos : 0 < ρ := half_pos hr₀_pos
    have h_cb_sub : Metric.closedBall z₀ ρ ⊆ V :=
      (Metric.closedBall_subset_ball (half_lt_self hr₀_pos)).trans hr₀_sub
    have hw_norm_le : ∀ w ∈ Metric.closedBall z₀ ρ, ‖w‖ ≤ ‖z₀‖ + ρ + 1 := by
      intro w hw
      have hw_dist : ‖w - z₀‖ ≤ ρ := by simpa [Metric.mem_closedBall, dist_eq_norm] using hw
      have h_tri : ‖w‖ ≤ ‖w - z₀‖ + ‖z₀‖ := by
        simpa [sub_add_cancel] using norm_add_le (w - z₀) z₀
      linarith
    let ψ_neg : EuclideanSpace ℝ (Fin (d + 1)) → ℝ := fun w => ϕ w + (-1 : ℝ) * ‖w - z₀‖ ^ 4
    obtain ⟨hψ_neg_C2, hψ_neg_lim⟩ :=
      quartic_perturbation_and_rescaled_jet_limit d hd V hV_open z₀ hz₀ ϕ hϕ_C2 (-1)
    obtain ⟨i₁, hi₁⟩ :=
      anisotropic_rescale_domain_and_continuity d hd L hL_ge hL u_seq z_seq r_seq lam_seq h_scales
        k hk_mono P_seq O_seq z₀ ρ hρ_pos
    have hf_neg_cont : ∀ i : ℕ, i₁ ≤ i →
        ContinuousOn (fun w => ψ_neg w - v_seq i w) (Metric.closedBall z₀ ρ) := by
      intro i hi
      exact (hψ_neg_C2.continuousOn.mono h_cb_sub).sub (hi₁ i hi).2
    have hf_neg_unif : ∀ ε : ℝ, 0 < ε →
        ∃ i₀ : ℕ, ∀ i : ℕ, i₀ ≤ i →
          ∀ w ∈ Metric.closedBall z₀ ρ, |(ψ_neg w - v_seq i w) - (ψ_neg w - v w)| ≤ ε := by
      intro ε hε
      obtain ⟨i₀, hi₀⟩ := hv_unif (‖z₀‖ + ρ + 1) ε (by positivity) hε
      refine ⟨i₀, fun i hi w hw => ?_⟩
      have h_eq : (ψ_neg w - v_seq i w) - (ψ_neg w - v w) = -(v_seq i w - v w) := by ring
      rw [h_eq, abs_neg]
      exact hi₀ i hi w (hw_norm_le w hw)
    have hf_neg_z₀ : ψ_neg z₀ - v z₀ = 0 := by
      simp [ψ_neg, hϕ_z₀]
    have hf_neg_margin : ∀ w ∈ Metric.closedBall z₀ ρ, ψ_neg w - v w ≤ -‖w - z₀‖ ^ 4 := by
      intro w hw
      have h_le : ϕ w ≤ v w := hϕ_le_v w (h_cb_sub hw)
      dsimp [ψ_neg]
      linarith
    obtain ⟨i₂, w_seq, hi₁_le_i₂, hw_tendsto, hw_max⟩ :=
      interior_maximizer_seq_of_quartic_margin d z₀ ρ hρ_pos
        (fun i w => ψ_neg w - v_seq i w) (fun w => ψ_neg w - v w) i₁
        hf_neg_cont hf_neg_unif hf_neg_z₀ hf_neg_margin
    have h_jet_nonpos : ∀ i : ℕ, i₂ ≤ i →
        let ξ_i : EuclideanSpace ℝ (Fin (d + 1)) :=
          mkSpaceTime (projSpace (gradient ψ_neg (w_seq i)))
            (1 + lam_seq (k i) * projTime (gradient ψ_neg (w_seq i)))
        fderiv ℝ (fderiv ℝ ψ_neg) (w_seq i) ξ_i ξ_i ≤ 0 := by
      intro i hi
      let j := k i
      obtain ⟨hu_j, _, hr_j, _, hlam_j, _⟩ := h_scales.1 j
      have hU_har_j : IsInfinityHarmonicOn (liftFunc (u_seq j)) (Metric.ball 0 (15 / 16)) :=
        (hL (u_seq j) hu_j).1
      have hc_pos : 0 < ‖P_seq i‖ := by linarith [(h_fit i).2.1]
      have hψ_neg_W : ContDiffOn ℝ 2 ψ_neg (Metric.ball z₀ ρ) :=
        hψ_neg_C2.mono (Metric.ball_subset_closedBall.trans h_cb_sub)
      have h_dom_W : ∀ w ∈ Metric.ball z₀ ρ,
          z_seq j + r_seq j • O_seq i (mkSpaceTime (Real.sqrt (lam_seq j) • projSpace w) (projTime w)) ∈
            Metric.ball (0 : EuclideanSpace ℝ (Fin (d + 1))) (15 / 16) :=
        fun w hw => (hi₁ i (hi₁_le_i₂.trans hi)).1 w (Metric.ball_subset_closedBall hw)
      have h_min : ∀ w ∈ Metric.ball z₀ ρ,
          v_seq i (w_seq i) - ψ_neg (w_seq i) ≤ v_seq i w - ψ_neg w := by
        intro w hw
        have h_le := (hw_max i hi).2 w hw
        linarith
      exact (anisotropic_pullback_test_and_infinityLaplacian d hd (liftFunc (u_seq j)) hU_har_j
        (z_seq j) (r_seq j) ‖P_seq i‖ (lam_seq j) hr_j hc_pos hlam_j (O_seq i)
        (Metric.ball z₀ ρ) Metric.isOpen_ball (w_seq i) (hw_max i hi).1 ψ_neg hψ_neg_W h_dom_W).2
        h_min
    exact le_of_tendsto (hψ_neg_lim w_seq (fun i => lam_seq (k i)) hw_tendsto hlam_k_tendsto)
      (Filter.eventually_atTop.mpr ⟨i₂, h_jet_nonpos⟩)

theorem anisotropic_blowup_subseq_in_class_A (d : ℕ) (hd : 3 ≤ d) (L : ℝ) (hL_ge : 1 ≤ L)
    (hL : HasUniformNormalizedLiftBounds d L)
    (u_seq : ℕ → EuclideanSpace ℝ (Fin d) → ℝ)
    (z_seq : ℕ → EuclideanSpace ℝ (Fin (d + 1)))
    (r_seq lam_seq : ℕ → ℝ)
    (h_scales : HasSelectedBlowupScales d u_seq z_seq r_seq lam_seq) :
    ∃ v : EuclideanSpace ℝ (Fin (d + 1)) → ℝ,
      InLimitingClassA d 256 v ∧
      IsAnisotropicBlowupLimit d L u_seq z_seq r_seq lam_seq v :=
by
  let e_b : EuclideanSpace ℝ (Fin (d + 1)) := mkSpaceTime 0 1
  have heb_eq : e_b = EuclideanSpace.single (Fin.last d) (1 : ℝ) := by
    ext j
    rw [EuclideanSpace.single_apply]
    refine Fin.lastCases ?_ ?_ j
    · simp [e_b, mkSpaceTime]
    · intro k
      simp [e_b, mkSpaceTime, Fin.castSucc_ne_last]
  have heb_norm : ‖e_b‖ = 1 := by
    rw [heb_eq, EuclideanSpace.norm_single, Real.norm_eq_abs, abs_one]
  let P_base : ℕ → EuclideanSpace ℝ (Fin (d + 1)) :=
    fun i => Classical.choose (h_scales.1 i).2.2.2.2.2.2.2
  let O_base : ℕ → (EuclideanSpace ℝ (Fin (d + 1)) ≃ₗᵢ[ℝ] EuclideanSpace ℝ (Fin (d + 1))) :=
    fun i => (ℝ ∙ (e_b - (‖P_base i‖⁻¹) • P_base i))ᗮ.reflection
  have h_base : IsBaseSlopeAndFrameSeq d L u_seq z_seq r_seq lam_seq P_base O_base := by
    intro i
    obtain ⟨hu_i, hz_i, hr_pos, hr_le, hlam_pos, hlam_lt, _, hgood32⟩ := h_scales.1 i
    have hP_fit : IsCylinderFitAt (liftFunc (u_seq i)) (z_seq i) (r_seq i) (32 * lam_seq i) (P_base i) :=
      Classical.choose_spec hgood32
    have hz_lt : ‖z_seq i‖ < 3 / 4 := by
      simpa [Metric.mem_ball, dist_zero_right] using hz_i
    have hr_le8 : r_seq i ≤ (1 / 8) * (3 / 4 - ‖z_seq i‖) := by
      have hi_nonneg : (0 : ℝ) ≤ i := Nat.cast_nonneg i
      have h_inv : 1 / ((i : ℝ) + 8) ≤ 1 / 8 :=
        one_div_le_one_div_of_le (by norm_num) (by linarith)
      exact hr_le.trans (mul_le_mul_of_nonneg_right h_inv (by linarith))
    have h32_pos : 0 < 32 * lam_seq i := by linarith
    have h32_lt1 : 32 * lam_seq i < 1 := by linarith
    obtain ⟨hP_norm_le, hP_time⟩ :=
      (hL (u_seq i) hu_i).2.2.2 (z_seq i) hz_i (r_seq i) hr_pos hr_le8
        (32 * lam_seq i) h32_pos h32_lt1 (P_base i) hP_fit
    have hsqrt_le : Real.sqrt (32 * lam_seq i) ≤ 1 / 2 := by
      have h14 : 32 * lam_seq i ≤ (1 / 2 : ℝ) ^ 2 := by linarith
      exact (Real.sqrt_le_sqrt h14).trans (by norm_num)
    have hP_upper : ‖P_base i‖ ≤ L + 1 := by linarith
    have hP_time_ge : 1 / 2 ≤ projTime (P_base i) := by
      have h1 := (abs_le.mp hP_time).1
      linarith
    have hP_coord_le : |projTime (P_base i)| ≤ ‖P_base i‖ := by
      simpa [projTime, Real.norm_eq_abs] using PiLp.norm_apply_le (P_base i) (Fin.last d)
    have hP_lower : 1 / 2 ≤ ‖P_base i‖ := by
      linarith [le_abs_self (projTime (P_base i))]
    have h_unit_norm : ‖(‖P_base i‖⁻¹) • P_base i‖ = 1 := by
      rw [norm_smul, Real.norm_eq_abs, abs_inv, abs_norm, inv_mul_cancel₀ (by linarith)]
    have hO_eb : O_base i (mkSpaceTime 0 1) = (‖P_base i‖⁻¹) • P_base i :=
      Submodule.reflection_sub (heb_norm.trans h_unit_norm.symm)
    exact ⟨hP_fit, hP_lower, hP_upper, hO_eb⟩
  have h_comp : HasCylinderFitComparisonBounds d L :=
    cylinder_fit_comparison d hd L hL_ge
  let v_seq : ℕ → EuclideanSpace ℝ (Fin (d + 1)) → ℝ :=
    fun i => anisotropicRescale (liftFunc (u_seq i)) (z_seq i) (r_seq i) ‖P_base i‖ (lam_seq i) (O_base i)
  have h_boxes : HasUniformRescaledShearedBoxFits d lam_seq v_seq :=
    rescaled_sheared_box_fits_of_selected_scales d hd L hL_ge hL h_comp u_seq z_seq r_seq lam_seq h_scales P_base O_base h_base
  have hv_zero : ∀ i : ℕ, v_seq i 0 = 0 := by
    intro i
    have h_mk0 : mkSpaceTime (Real.sqrt (lam_seq i) • projSpace (0 : EuclideanSpace ℝ (Fin (d + 1))))
        (projTime (0 : EuclideanSpace ℝ (Fin (d + 1)))) = 0 := by
      ext j
      refine Fin.lastCases ?_ ?_ j
      · simp [mkSpaceTime, projTime]
      · intro k
        simp [mkSpaceTime, projSpace]
    have h_pt0 : projTime (0 : EuclideanSpace ℝ (Fin (d + 1))) = 0 := rfl
    dsimp [v_seq, anisotropicRescale]
    rw [h_mk0, h_pt0, map_zero, smul_zero, add_zero, mul_zero, sub_zero, sub_self, zero_div]
  obtain ⟨v, k, hv0, hv_cont, hk_mono, hv_unif, hv_fits⟩ :=
    subseq_limit_and_fits_of_rescaled_sheared_box_fits d hd lam_seq
      (fun i => (h_scales.1 i).2.2.2.2.1) h_scales.2.1 v_seq hv_zero h_boxes
  have hv_limit : IsAnisotropicBlowupLimit d L u_seq z_seq r_seq lam_seq v :=
    ⟨hv0, k, (fun i => P_base (k i)), (fun i => O_base (k i)), hk_mono, (fun i => h_base (k i)), hv_unif⟩
  obtain ⟨hv_sub, hv_super⟩ :=
    viscosity_limit_of_anisotropic_blowup d hd L hL_ge hL u_seq z_seq r_seq lam_seq h_scales v hv_cont hv_limit
  exact ⟨v, ⟨hv_cont, hv_sub, hv_super, hv_fits⟩, hv_limit⟩

theorem nonaffine_of_anisotropic_blowup_limit (d : ℕ) (hd : 3 ≤ d) (L : ℝ) (hL_ge : 1 ≤ L)
    (u_seq : ℕ → EuclideanSpace ℝ (Fin d) → ℝ)
    (z_seq : ℕ → EuclideanSpace ℝ (Fin (d + 1)))
    (r_seq lam_seq : ℕ → ℝ)
    (h_scales : HasSelectedBlowupScales d u_seq z_seq r_seq lam_seq)
    (v : EuclideanSpace ℝ (Fin (d + 1)) → ℝ)
    (hv_limit : IsAnisotropicBlowupLimit d L u_seq z_seq r_seq lam_seq v) :
    ¬ IsAffineSpaceTime d v :=
by
  have h_projSpace_apply : ∀ (z : EuclideanSpace ℝ (Fin (d + 1))) (m : Fin d),
      projSpace z m = z (Fin.castSucc m) := fun _ _ => rfl
  have h_projTime_apply : ∀ (z : EuclideanSpace ℝ (Fin (d + 1))),
      projTime z = z (Fin.last d) := fun _ => rfl
  have h_projSpace_mk : ∀ (x : EuclideanSpace ℝ (Fin d)) (t : ℝ),
      projSpace (mkSpaceTime x t) = x := by
    intro x t
    ext m
    simp [projSpace, mkSpaceTime, Fin.snoc_castSucc]
  have h_projTime_mk : ∀ (x : EuclideanSpace ℝ (Fin d)) (t : ℝ),
      projTime (mkSpaceTime x t) = t := by
    intro x t
    simp [projTime, mkSpaceTime, Fin.snoc_last]
  have h_mk_proj : ∀ (w : EuclideanSpace ℝ (Fin (d + 1))),
      mkSpaceTime (projSpace w) (projTime w) = w := by
    intro w
    ext m
    refine Fin.lastCases ?_ ?_ m
    · simp [mkSpaceTime, projTime, Fin.snoc_last]
    · intro m'
      simp [mkSpaceTime, projSpace, Fin.snoc_castSucc]
  have h_projSpace_add : ∀ (w₁ w₂ : EuclideanSpace ℝ (Fin (d + 1))),
      projSpace (w₁ + w₂) = projSpace w₁ + projSpace w₂ := by
    intro w₁ w₂; ext m; rfl
  have h_projSpace_smul : ∀ (a : ℝ) (w : EuclideanSpace ℝ (Fin (d + 1))),
      projSpace (a • w) = a • projSpace w := by
    intro a w; ext m; rfl
  have h_projTime_add : ∀ (w₁ w₂ : EuclideanSpace ℝ (Fin (d + 1))),
      projTime (w₁ + w₂) = projTime w₁ + projTime w₂ := fun _ _ => rfl
  have h_projTime_smul : ∀ (a : ℝ) (w : EuclideanSpace ℝ (Fin (d + 1))),
      projTime (a • w) = a * projTime w := fun _ _ => rfl
  have h_inner_split : ∀ (w₁ w₂ : EuclideanSpace ℝ (Fin (d + 1))),
      inner ℝ w₁ w₂ = inner ℝ (projSpace w₁) (projSpace w₂) + projTime w₁ * projTime w₂ := by
    intro w₁ w₂
    rw [PiLp.inner_apply, PiLp.inner_apply, Fin.sum_univ_castSucc]
    simp only [h_projSpace_apply, h_projTime_apply, RCLike.inner_apply, conj_trivial]
    ring
  have h_norm_sq : ∀ (w : EuclideanSpace ℝ (Fin (d + 1))),
      ‖w‖ ^ 2 = ‖projSpace w‖ ^ 2 + (projTime w) ^ 2 := by
    intro w
    have h1 := h_inner_split w w
    rw [real_inner_self_eq_norm_mul_norm, real_inner_self_eq_norm_mul_norm] at h1
    linarith [sq ‖w‖, sq ‖projSpace w‖, sq (projTime w)]
  have h_norm_projSpace_le : ∀ (w : EuclideanSpace ℝ (Fin (d + 1))),
      ‖projSpace w‖ ≤ ‖w‖ := by
    intro w
    have hsq : ‖projSpace w‖ ^ 2 ≤ ‖w‖ ^ 2 := by
      rw [h_norm_sq w]
      linarith [sq_nonneg (projTime w)]
    exact (abs_le_of_sq_le_sq' hsq (norm_nonneg w)).2
  have h_abs_projTime_le : ∀ (w : EuclideanSpace ℝ (Fin (d + 1))),
      |projTime w| ≤ ‖w‖ := by
    intro w
    have hsq : |projTime w| ^ 2 ≤ ‖w‖ ^ 2 := by
      rw [sq_abs, h_norm_sq w]
      linarith [sq_nonneg ‖projSpace w‖]
    exact (abs_le_of_sq_le_sq' hsq (norm_nonneg w)).2
  have h_norm_mk_le : ∀ (x : EuclideanSpace ℝ (Fin d)) (t : ℝ),
      ‖mkSpaceTime x t‖ ≤ ‖x‖ + |t| := by
    intro x t
    have hsq : ‖mkSpaceTime x t‖ ^ 2 ≤ (‖x‖ + |t|) ^ 2 := by
      rw [h_norm_sq (mkSpaceTime x t), h_projSpace_mk, h_projTime_mk]
      have h1 : 0 ≤ ‖x‖ * |t| := mul_nonneg (norm_nonneg x) (abs_nonneg t)
      have h2 : t ^ 2 = |t| ^ 2 := (sq_abs t).symm
      linarith
    exact (abs_le_of_sq_le_sq' hsq (add_nonneg (norm_nonneg x) (abs_nonneg t))).2
  intro h_aff
  rcases h_aff with ⟨P_inf, c_inf, hv_eq⟩
  have hv0 : v 0 = 0 := hv_limit.1
  have hc_inf : c_inf = 0 := by
    have h0 := hv_eq 0
    rw [hv0, inner_zero_right, zero_add] at h0
    exact h0.symm
  set p : EuclideanSpace ℝ (Fin d) := projSpace P_inf
  set q : ℝ := projTime P_inf
  have hv_split : ∀ w : EuclideanSpace ℝ (Fin (d + 1)),
      v w = inner ℝ p (projSpace w) + q * projTime w := by
    intro w
    rw [hv_eq w, hc_inf, add_zero, h_inner_split P_inf w]
  rcases hv_limit.2 with ⟨k, P_seq, O_seq, hk_mono, h_seq_props, h_conv⟩
  have h_lam_subseq : Filter.Tendsto (fun i => lam_seq (k i)) Filter.atTop (nhds 0) :=
    h_scales.2.1.comp hk_mono.tendsto_atTop
  set δ : ℝ := (1 / 2) / (|q| + 1)
  have hq_pos : 0 < |q| + 1 := by positivity
  have hδ_pos : 0 < δ := div_pos (by norm_num) hq_pos
  rcases Metric.tendsto_atTop.mp h_lam_subseq δ hδ_pos with ⟨i₁, hi₁⟩
  set K : ℝ := 2 * ‖p‖ + 3
  have hK_pos : 0 < K := by positivity
  have hL1_pos : 0 < L + 1 := by linarith
  set ε : ℝ := 1 / (L + 1)
  have hε_pos : 0 < ε := div_pos (by norm_num) hL1_pos
  rcases h_conv K ε hK_pos hε_pos with ⟨i₂, hi₂⟩
  let i : ℕ := max i₁ i₂
  let j : ℕ := k i
  set U_j := liftFunc (u_seq j)
  set z_j := z_seq j
  set r_j := r_seq j
  set lam_j := lam_seq j
  set c_i := ‖P_seq i‖
  set O_i := O_seq i
  have hr_pos : 0 < r_j := (h_scales.1 j).2.2.1
  have hlam_pos : 0 < lam_j := (h_scales.1 j).2.2.2.2.1
  have hlam_lt : lam_j < 1 / 128 := (h_scales.1 j).2.2.2.2.2.1
  have h_not_good : ¬ IsCylinderGood U_j z_j r_j lam_j := (h_scales.1 j).2.2.2.2.2.2.1
  have hc_ge : 1 / 2 ≤ c_i := (h_seq_props i).2.1
  have hc_le : c_i ≤ L + 1 := (h_seq_props i).2.2.1
  have hc_pos : 0 < c_i := by linarith
  have h_one_add_lam_q : 1 / 2 < 1 + lam_j * q := by
    have hd_lt : dist lam_j 0 < δ := hi₁ i (le_max_left i₁ i₂)
    rw [Real.dist_eq, sub_zero, abs_of_pos hlam_pos] at hd_lt
    have h1 : lam_j * (|q| + 1) < 1 / 2 := (lt_div_iff₀ hq_pos).mp hd_lt
    have h2 : -|q| ≤ q := neg_abs_le q
    nlinarith [abs_nonneg q]
  set Q_i : EuclideanSpace ℝ (Fin (d + 1)) :=
    mkSpaceTime (Real.sqrt lam_j • p) (1 + lam_j * q)
  set N_i : ℝ := ‖Q_i‖
  set n_i : EuclideanSpace ℝ (Fin (d + 1)) := N_i⁻¹ • Q_i
  set P_tilde : EuclideanSpace ℝ (Fin (d + 1)) := c_i • O_i Q_i
  have hN_ge : 1 / 2 < N_i := by
    have h1 : |projTime Q_i| ≤ N_i := h_abs_projTime_le Q_i
    rw [h_projTime_mk] at h1
    have h2 : 1 + lam_j * q ≤ |1 + lam_j * q| := le_abs_self _
    linarith
  have hN_pos : 0 < N_i := by linarith
  have hP_tilde_norm : ‖P_tilde‖ = c_i * N_i := by
    rw [norm_smul, Real.norm_of_nonneg (le_of_lt hc_pos), O_i.norm_map]
  have hP_tilde_ne : P_tilde ≠ 0 := by
    intro h_zero
    have h_norm_zero : ‖P_tilde‖ = 0 := by rw [h_zero, norm_zero]
    nlinarith [hP_tilde_norm]
  have h_unit_P_tilde : (‖P_tilde‖⁻¹) • P_tilde = O_i n_i := by
    rw [hP_tilde_norm, smul_smul]
    have h_cancel : (c_i * N_i)⁻¹ * c_i = N_i⁻¹ := by
      field_simp [ne_of_gt hc_pos, ne_of_gt hN_pos]
    rw [h_cancel, ← O_i.map_smul]
  apply h_not_good
  refine ⟨P_tilde, hP_tilde_ne, ?_⟩
  intro h
  dsimp only
  intro h_ax h_trans
  rw [h_unit_P_tilde] at h_ax h_trans
  set u : EuclideanSpace ℝ (Fin (d + 1)) := r_j⁻¹ • O_i.symm h
  have hsqrt_pos : 0 < Real.sqrt lam_j := Real.sqrt_pos.mpr hlam_pos
  set x : EuclideanSpace ℝ (Fin d) := (Real.sqrt lam_j)⁻¹ • projSpace u
  set t : ℝ := projTime u
  set w : EuclideanSpace ℝ (Fin (d + 1)) := mkSpaceTime x t
  have h_sqrt_x : Real.sqrt lam_j • x = projSpace u :=
    smul_inv_smul₀ (ne_of_gt hsqrt_pos) (projSpace u)
  have h_mk_u : mkSpaceTime (Real.sqrt lam_j • x) t = u := by
    rw [h_sqrt_x]
    exact h_mk_proj u
  have h_r_Oi_u : r_j • O_i u = h := by
    dsimp [u]
    rw [O_i.map_smul, smul_inv_smul₀ (ne_of_gt hr_pos), O_i.apply_symm_apply]
  set s : ℝ := inner ℝ u n_i
  set η : EuclideanSpace ℝ (Fin (d + 1)) := u - s • n_i
  have hu_decomp : u = (s * N_i⁻¹) • Q_i + η := by
    change u = (s * N_i⁻¹) • Q_i + (u - s • (N_i⁻¹ • Q_i))
    rw [smul_smul]
    abel
  have h_inner_h : inner ℝ h (O_i n_i) = r_j * s := by
    rw [← h_r_Oi_u, real_inner_smul_left, O_i.inner_map_map]
  have hs_abs : |s| ≤ 1 := by
    rw [h_inner_h, abs_mul, abs_of_pos hr_pos] at h_ax
    nlinarith
  have h_trans_eq : ‖h - (inner ℝ h (O_i n_i)) • O_i n_i‖ = r_j * ‖η‖ := by
    have h_vec : h - (inner ℝ h (O_i n_i)) • O_i n_i = r_j • O_i η := by
      have h1 : O_i η = O_i u - s • O_i n_i := by
        change O_i (u - s • n_i) = O_i u - s • O_i n_i
        rw [O_i.map_sub, O_i.map_smul s n_i]
      rw [h1, smul_sub, h_r_Oi_u, h_inner_h, smul_smul]
    rw [h_vec, norm_smul, Real.norm_of_nonneg (le_of_lt hr_pos), O_i.norm_map]
  have hη_norm : ‖η‖ ≤ Real.sqrt lam_j := by
    rw [h_trans_eq] at h_trans
    nlinarith
  have hx_norm : ‖x‖ ≤ 2 * ‖p‖ + 1 := by
    have h_ux : Real.sqrt lam_j • x =
        (s * N_i⁻¹ * Real.sqrt lam_j) • p + projSpace η := by
      rw [h_sqrt_x, hu_decomp, h_projSpace_add, h_projSpace_smul]
      dsimp [Q_i]
      rw [h_projSpace_mk, smul_smul]
    have h_lhs : ‖Real.sqrt lam_j • x‖ = Real.sqrt lam_j * ‖x‖ := by
      rw [norm_smul, Real.norm_of_nonneg (le_of_lt hsqrt_pos)]
    have h_rhs : ‖(s * N_i⁻¹ * Real.sqrt lam_j) • p + projSpace η‖ ≤
        |s * N_i⁻¹ * Real.sqrt lam_j| * ‖p‖ + ‖projSpace η‖ := by
      have := norm_add_le ((s * N_i⁻¹ * Real.sqrt lam_j) • p) (projSpace η)
      rwa [norm_smul, Real.norm_eq_abs] at this
    have h_coeff : |s * N_i⁻¹ * Real.sqrt lam_j| ≤ 2 * Real.sqrt lam_j := by
      rw [abs_mul, abs_mul, abs_of_pos (inv_pos.mpr hN_pos), abs_of_pos hsqrt_pos]
      have hN_inv_le : N_i⁻¹ ≤ 2 := by
        rw [inv_le_comm₀ hN_pos (by norm_num : (0 : ℝ) < 2)]
        linarith
      have h_sN : |s| * N_i⁻¹ ≤ 2 := by
        nlinarith [abs_nonneg s, inv_pos.mpr hN_pos]
      nlinarith
    have h_eta_space : ‖projSpace η‖ ≤ Real.sqrt lam_j :=
      le_trans (h_norm_projSpace_le η) hη_norm
    have h_comb : Real.sqrt lam_j * ‖x‖ ≤ Real.sqrt lam_j * (2 * ‖p‖ + 1) := by
      rw [← h_lhs, h_ux]
      nlinarith [norm_nonneg p]
    exact le_of_mul_le_mul_left h_comb hsqrt_pos
  have ht_abs : |t| ≤ 2 := by
    have h_ut : t = (s * N_i⁻¹) * (1 + lam_j * q) + projTime η := by
      change projTime u = _
      rw [hu_decomp, h_projTime_add, h_projTime_smul]
      dsimp [Q_i]
      rw [h_projTime_mk]
    have h_q_le_N : |1 + lam_j * q| ≤ N_i := by
      have h1 := h_abs_projTime_le Q_i
      rwa [h_projTime_mk] at h1
    have h_term1 : |(s * N_i⁻¹) * (1 + lam_j * q)| ≤ 1 := by
      rw [abs_mul, abs_mul, abs_of_pos (inv_pos.mpr hN_pos)]
      have h_prod : N_i⁻¹ * |1 + lam_j * q| ≤ 1 := by
        have := mul_le_mul_of_nonneg_left h_q_le_N (le_of_lt (inv_pos.mpr hN_pos))
        rwa [inv_mul_cancel₀ (ne_of_gt hN_pos)] at this
      nlinarith [abs_nonneg s, abs_nonneg (1 + lam_j * q), inv_pos.mpr hN_pos]
    have h_sqrt_le_one : Real.sqrt lam_j ≤ 1 := by
      rw [← Real.sqrt_one]
      exact Real.sqrt_le_sqrt (by linarith)
    have h_term2 : |projTime η| ≤ 1 :=
      le_trans (h_abs_projTime_le η) (le_trans hη_norm h_sqrt_le_one)
    have h_tri := abs_add_le ((s * N_i⁻¹) * (1 + lam_j * q)) (projTime η)
    rw [h_ut]
    linarith
  have hw_norm : ‖w‖ ≤ K := by
    have h1 := h_norm_mk_le x t
    change ‖w‖ ≤ ‖x‖ + |t| at h1
    dsimp [K]
    linarith
  have h_P_inner_h : inner ℝ P_tilde h = r_j * c_i * t + r_j * c_i * lam_j * v w := by
    rw [← h_r_Oi_u]
    dsimp [P_tilde]
    rw [real_inner_smul_left, real_inner_smul_right, O_i.inner_map_map]
    rw [← h_mk_u]
    dsimp [Q_i]
    rw [h_inner_split, h_projSpace_mk, h_projSpace_mk, h_projTime_mk, h_projTime_mk]
    rw [real_inner_smul_left, real_inner_smul_right, ← mul_assoc (Real.sqrt lam_j),
      Real.mul_self_sqrt (le_of_lt hlam_pos)]
    rw [hv_split w, h_projSpace_mk, h_projTime_mk]
    ring
  have h_rescale_eq :
      U_j (z_j + h) - U_j z_j - inner ℝ P_tilde h =
        r_j * c_i * lam_j * (anisotropicRescale U_j z_j r_j c_i lam_j O_i w - v w) := by
    have h_unfold : anisotropicRescale U_j z_j r_j c_i lam_j O_i w =
        (U_j (z_j + h) - U_j z_j - r_j * c_i * t) / (r_j * c_i * lam_j) := by
      dsimp [anisotropicRescale, w]
      rw [h_projSpace_mk, h_projTime_mk, h_mk_u, h_r_Oi_u]
    rw [h_unfold, h_P_inner_h]
    have h_denom_ne : r_j * c_i * lam_j ≠ 0 := by positivity
    field_simp [h_denom_ne]
    ring
  have h_conv_w : |anisotropicRescale U_j z_j r_j c_i lam_j O_i w - v w| ≤ 1 / (L + 1) :=
    hi₂ i (le_max_right i₁ i₂) w hw_norm
  have h_pos_prod : 0 < r_j * c_i * lam_j := by positivity
  rw [h_rescale_eq, abs_mul, abs_of_pos h_pos_prod]
  have h_step1 : r_j * c_i * lam_j * |anisotropicRescale U_j z_j r_j c_i lam_j O_i w - v w| ≤
      r_j * (L + 1) * lam_j * (1 / (L + 1)) := by
    have h_c_lam : r_j * c_i * lam_j ≤ r_j * (L + 1) * lam_j := by nlinarith
    exact mul_le_mul h_c_lam h_conv_w (abs_nonneg _) (by positivity)
  have h_step2 : r_j * (L + 1) * lam_j * (1 / (L + 1)) = lam_j * r_j := by
    field_simp [ne_of_gt hL1_pos]
  linarith

theorem nonaffine_limit_of_no_power_decay (d : ℕ) (hd : 3 ≤ d)
    (h_no_decay : ¬ ∃ B γ s₀ : ℝ, HasUniformCylinderPowerDecay d B γ s₀) :
    ∃ v : EuclideanSpace ℝ (Fin (d + 1)) → ℝ,
      InLimitingClassA d 256 v ∧ ¬ IsAffineSpaceTime d v :=
by
  obtain ⟨L, hL_ge, hL⟩ := normalized_lift_lipschitz_and_slope_bounds d hd
  have h_flat : HasUniformQualitativeFlatness d :=
    uniform_qualitative_flatness_of_lift d hd L hL_ge hL
  obtain ⟨u_seq, z_seq, r_seq, lam_seq, h_scales⟩ :=
    scale_selection_of_no_power_decay d hd h_flat h_no_decay
  obtain ⟨v, hv_class, hv_limit⟩ :=
    anisotropic_blowup_subseq_in_class_A d hd L hL_ge hL u_seq z_seq r_seq lam_seq h_scales
  have hv_nonaff : ¬ IsAffineSpaceTime d v :=
    nonaffine_of_anisotropic_blowup_limit d hd L hL_ge u_seq z_seq r_seq lam_seq h_scales v hv_limit
  exact ⟨v, hv_class, hv_nonaff⟩

theorem affine_of_horizontally_affine_classA (d : ℕ) (hd : 3 ≤ d) (C₀ : ℝ) (hC₀ : 0 ≤ C₀)
    (v₀ : EuclideanSpace ℝ (Fin (d + 1)) → ℝ) (hv₀ : InLimitingClassA d C₀ v₀)
    (h_horiz : ∀ t : ℝ, ∃ (p : EuclideanSpace ℝ (Fin d)) (c : ℝ),
      ∀ x : EuclideanSpace ℝ (Fin d), v₀ (mkSpaceTime x t) = inner ℝ p x + c) :
    IsAffineSpaceTime d v₀ :=
by
  let p : ℝ → EuclideanSpace ℝ (Fin d) := fun t => Classical.choose (h_horiz t)
  let c : ℝ → ℝ := fun t => Classical.choose (Classical.choose_spec (h_horiz t))
  have hv_slice : ∀ (t : ℝ) (x : EuclideanSpace ℝ (Fin d)),
      v₀ (mkSpaceTime x t) = inner ℝ (p t) x + c t :=
    fun t x => Classical.choose_spec (Classical.choose_spec (h_horiz t)) x
  have h_s1 : Continuous p ∧ Continuous c ∧ ∀ t : ℝ, ‖p t - p 0‖ ≤ 2 * C₀ := by
    have h_mk_cont : ∀ x : EuclideanSpace ℝ (Fin d), Continuous (fun t : ℝ => mkSpaceTime x t) := by
      intro x
      unfold mkSpaceTime
      apply Continuous.comp (EuclideanSpace.equiv (Fin (d + 1)) ℝ).symm.continuous
      rw [continuous_pi_iff]
      intro j
      refine Fin.lastCases ?_ ?_ j
      · simp only [Fin.snoc_last]
        exact continuous_id
      · intro i
        simp only [Fin.snoc_castSucc]
        exact continuous_const
    have hc_eq : c = fun t => v₀ (mkSpaceTime 0 t) := by
      ext t
      have h0 := hv_slice t 0
      simp only [inner_zero_right, zero_add] at h0
      exact h0.symm
    have hc_cont : Continuous c := by
      rw [hc_eq]
      exact hv₀.1.comp (h_mk_cont 0)
    have hp_cont : Continuous p := by
      have hp_eq : p = fun t => (EuclideanSpace.equiv (Fin d) ℝ).symm
          (fun i => v₀ (mkSpaceTime (EuclideanSpace.single i 1) t) - c t) := by
        ext t i
        have hi := hv_slice t (EuclideanSpace.single i 1)
        rw [EuclideanSpace.inner_single_right, one_mul, RCLike.conj_to_real] at hi
        simp only [EuclideanSpace.equiv, PiLp.continuousLinearEquiv_symm_apply]
        linarith
      rw [hp_eq]
      apply Continuous.comp (EuclideanSpace.equiv (Fin d) ℝ).symm.continuous
      rw [continuous_pi_iff]
      intro i
      exact (hv₀.1.comp (h_mk_cont (EuclideanSpace.single i 1))).sub hc_cont
    refine ⟨hp_cont, hc_cont, ?_⟩
    intro t
    set R : ℝ := |t| + 1
    have hR_pos : 0 < R := by positivity
    obtain ⟨p_R, a_R, h_fit⟩ := hv₀.2.2.2 0 0 R hR_pos
    have h_slope_diff : ∀ ℓ : ℝ, |ℓ| ≤ R → ∀ w : EuclideanSpace ℝ (Fin d), ‖w‖ ≤ R →
        |inner ℝ (p ℓ - p_R) w| ≤ C₀ * R := by
      intro ℓ hℓ w hw
      have h_plus : ‖(ℓ • p_R + w) - ℓ • p_R‖ ≤ R := by
        simpa [add_sub_cancel_left] using hw
      have h_minus : ‖(ℓ • p_R - w) - ℓ • p_R‖ ≤ R := by
        simpa [sub_sub_cancel_left, norm_neg] using hw
      have hf1 := h_fit (ℓ • p_R + w) ℓ hℓ h_plus
      have hf2 := h_fit (ℓ • p_R - w) ℓ hℓ h_minus
      simp only [zero_add] at hf1 hf2
      rw [hv_slice ℓ (ℓ • p_R + w)] at hf1
      rw [hv_slice ℓ (ℓ • p_R - w)] at hf2
      set A := inner ℝ (p ℓ) (ℓ • p_R + w) + c ℓ - v₀ (mkSpaceTime 0 0) -
        inner ℝ p_R (ℓ • p_R + w) - (a_R - ‖p_R‖ ^ 2 / 2) * ℓ
      set B := inner ℝ (p ℓ) (ℓ • p_R - w) + c ℓ - v₀ (mkSpaceTime 0 0) -
        inner ℝ p_R (ℓ • p_R - w) - (a_R - ‖p_R‖ ^ 2 / 2) * ℓ
      have hAB : A - B = 2 * inner ℝ (p ℓ - p_R) w := by
        simp only [A, B, inner_add_right, inner_sub_right, inner_sub_left]
        ring
      have h_abs : |A - B| ≤ 2 * (C₀ * R) := by
        calc |A - B| ≤ |A| + |B| := abs_sub A B
          _ ≤ C₀ * R + C₀ * R := add_le_add hf1 hf2
          _ = 2 * (C₀ * R) := by ring
      rw [hAB, abs_mul, abs_of_pos (by norm_num : (0 : ℝ) < 2)] at h_abs
      linarith
    have ht_le : |t| ≤ R := by simp [R]
    have h0_le : |(0 : ℝ)| ≤ R := by
      rw [abs_zero]
      exact le_of_lt hR_pos
    set u := p t - p 0
    by_cases hu : u = 0
    · simp [u, hu, hC₀]
    · have hu_pos : 0 < ‖u‖ := norm_pos_iff.mpr hu
      set w := (R / ‖u‖) • u
      have hw_norm : ‖w‖ ≤ R := by
        rw [norm_smul, Real.norm_eq_abs, abs_of_pos (div_pos hR_pos hu_pos),
          div_mul_cancel₀ R (ne_of_gt hu_pos)]
      have h1 := h_slope_diff t ht_le w hw_norm
      have h2 := h_slope_diff 0 h0_le w hw_norm
      have h_inner_u : inner ℝ u w = R * ‖u‖ := by
        simp only [w, inner_smul_right, real_inner_self_eq_norm_sq]
        field_simp [ne_of_gt hu_pos]
      have h_sub_u : inner ℝ u w = inner ℝ (p t - p_R) w - inner ℝ (p 0 - p_R) w := by
        rw [← inner_sub_left]
        congr 1
        simp [u]
      have h_le : inner ℝ u w ≤ 2 * C₀ * R := by
        have h_abs : |inner ℝ u w| ≤ C₀ * R + C₀ * R := by
          rw [h_sub_u]
          exact le_trans (abs_sub _ _) (add_le_add h1 h2)
        linarith [le_abs_self (inner ℝ u w)]
      rw [h_inner_u] at h_le
      nlinarith
  obtain ⟨hp_cont, hc_cont, hp_bdd⟩ := h_s1
  have h_test : ∀ (p₀ x y₀ : EuclideanSpace ℝ (Fin d)) (s₀ c₀ c₁ c₂ α : ℝ)
      (V : Set (EuclideanSpace ℝ (Fin (d + 1)))),
      ContDiffOn ℝ 2 (sliceQuadTest d p₀ x s₀ c₀ c₁ c₂ α) V ∧
      limitingOperator (sliceQuadTest d p₀ x s₀ c₀ c₁ c₂ α) (mkSpaceTime y₀ s₀) =
        c₂ + α * ‖p₀ + α • (y₀ - x)‖ ^ 2 := by
    intro p₀ x y₀ s₀ c₀ c₁ c₂ α V
    let P₀ : EuclideanSpace ℝ (Fin (d + 1)) := mkSpaceTime p₀ 0
    let e_t : EuclideanSpace ℝ (Fin (d + 1)) := mkSpaceTime 0 1
    let z₁ : EuclideanSpace ℝ (Fin (d + 1)) := mkSpaceTime x s₀
    have h_inner_P₀ : ∀ z : EuclideanSpace ℝ (Fin (d + 1)),
        inner ℝ P₀ z = inner ℝ p₀ (projSpace z) := by
      intro z
      simp only [P₀, PiLp.inner_apply, RCLike.inner_apply, conj_trivial]
      rw [Fin.sum_univ_castSucc]
      simp [mkSpaceTime, projSpace]
    have h_inner_et : ∀ z : EuclideanSpace ℝ (Fin (d + 1)),
        inner ℝ e_t (z - z₁) = projTime z - s₀ := by
      intro z
      simp only [e_t, z₁, PiLp.inner_apply, RCLike.inner_apply, conj_trivial]
      rw [Fin.sum_univ_castSucc]
      simp [mkSpaceTime, projTime]
    have h_norm_sq : ∀ z : EuclideanSpace ℝ (Fin (d + 1)),
        ‖z - z₁‖ ^ 2 = ‖projSpace z - x‖ ^ 2 + (projTime z - s₀) ^ 2 := by
      intro z
      simp only [z₁, PiLp.norm_sq_eq_of_L2, Real.norm_eq_abs, sq_abs]
      rw [Fin.sum_univ_castSucc]
      simp [mkSpaceTime, projSpace, projTime]
    have h_eq : sliceQuadTest d p₀ x s₀ c₀ c₁ c₂ α = fun z : EuclideanSpace ℝ (Fin (d + 1)) =>
        innerSL ℝ P₀ z + c₀ + c₁ * (innerSL ℝ e_t z - inner ℝ e_t z₁) +
        ((c₂ - α) / 2) * (innerSL ℝ e_t z - inner ℝ e_t z₁) ^ 2 + (α / 2) * ‖z - z₁‖ ^ 2 := by
      ext z
      unfold sliceQuadTest
      simp only [innerSL_apply_apply]
      rw [← inner_sub_right, h_inner_P₀ z, h_inner_et z, h_norm_sq z]
      ring
    have h_cd : ContDiffOn ℝ 2 (sliceQuadTest d p₀ x s₀ c₀ c₁ c₂ α) V := by
      rw [h_eq]
      apply ContDiff.contDiffOn
      have h1 : ContDiff ℝ 2 (fun z : EuclideanSpace ℝ (Fin (d + 1)) => innerSL ℝ P₀ z) :=
        (innerSL ℝ P₀).contDiff
      have h2 : ContDiff ℝ 2 (fun z : EuclideanSpace ℝ (Fin (d + 1)) =>
          innerSL ℝ e_t z - inner ℝ e_t z₁) :=
        (innerSL ℝ e_t).contDiff.sub contDiff_const
      have h3 : ContDiff ℝ 2 (fun z : EuclideanSpace ℝ (Fin (d + 1)) => ‖z - z₁‖ ^ 2) :=
        (contDiff_id.sub contDiff_const).norm_sq ℝ
      exact (((h1.add contDiff_const).add (contDiff_const.mul h2)).add
        (contDiff_const.mul (h2.pow 2))).add (contDiff_const.mul h3)
    refine ⟨h_cd, ?_⟩
    let G : EuclideanSpace ℝ (Fin (d + 1)) → EuclideanSpace ℝ (Fin (d + 1)) := fun z =>
      P₀ + (c₁ + (c₂ - α) * (innerSL ℝ e_t z - inner ℝ e_t z₁)) • e_t + α • (z - z₁)
    have h_fderiv1 : ∀ z : EuclideanSpace ℝ (Fin (d + 1)),
        HasFDerivAt (sliceQuadTest d p₀ x s₀ c₀ c₁ c₂ α) (innerSL ℝ (G z)) z := by
      intro z
      rw [h_eq]
      have hd_sub : HasFDerivAt (fun w : EuclideanSpace ℝ (Fin (d + 1)) => w - z₁)
          (ContinuousLinearMap.id ℝ (EuclideanSpace ℝ (Fin (d + 1)))) z :=
        (hasFDerivAt_id z).sub_const z₁
      have hd_P₀ : HasFDerivAt (fun w : EuclideanSpace ℝ (Fin (d + 1)) => innerSL ℝ P₀ w)
          (innerSL ℝ P₀) z :=
        (innerSL ℝ P₀).hasFDerivAt
      have hd_et : HasFDerivAt (fun w : EuclideanSpace ℝ (Fin (d + 1)) =>
          innerSL ℝ e_t w - inner ℝ e_t z₁) (innerSL ℝ e_t) z :=
        (innerSL ℝ e_t).hasFDerivAt.sub_const (inner ℝ e_t z₁)
      have hd_et_sq := hd_et.pow 2
      have hd_norm := hd_sub.norm_sq
      have hd_all := (((hd_P₀.add_const c₀).add (hd_et.const_mul c₁)).add
        (hd_et_sq.const_mul ((c₂ - α) / 2))).add (hd_norm.const_mul (α / 2))
      convert hd_all using 1
      ext v
      simp only [G, add_apply, smul_apply, ContinuousLinearMap.comp_apply,
        ContinuousLinearMap.id_apply, innerSL_apply_apply,
        inner_add_left, inner_smul_left, RCLike.conj_to_real, smul_eq_mul, nsmul_eq_mul,
        Nat.cast_ofNat]
      ring
    have h_fderiv_eq : fderiv ℝ (sliceQuadTest d p₀ x s₀ c₀ c₁ c₂ α) = fun z => innerSL ℝ (G z) := by
      ext z v
      rw [(h_fderiv1 z).fderiv]
    let z₀ : EuclideanSpace ℝ (Fin (d + 1)) := mkSpaceTime y₀ s₀
    have h_grad_z₀ : gradient (sliceQuadTest d p₀ x s₀ c₀ c₁ c₂ α) z₀ = G z₀ := by
      have h_dual : innerSL ℝ (G z₀) =
          InnerProductSpace.toDual ℝ (EuclideanSpace ℝ (Fin (d + 1))) (G z₀) := by
        ext v
        simp [InnerProductSpace.toDual_apply_apply]
      have h_f0 : HasFDerivAt (sliceQuadTest d p₀ x s₀ c₀ c₁ c₂ α)
          (InnerProductSpace.toDual ℝ (EuclideanSpace ℝ (Fin (d + 1))) (G z₀)) z₀ := by
        rw [← h_dual]
        exact h_fderiv1 z₀
      exact (hasGradientAt_iff_hasFDerivAt.mpr h_f0).gradient
    have h_proj_G : projSpace (G z₀) = p₀ + α • (y₀ - x) := by
      have hz₀_et : innerSL ℝ e_t z₀ - inner ℝ e_t z₁ = 0 := by
        rw [innerSL_apply_apply, ← inner_sub_right, h_inner_et z₀]
        simp [z₀, projTime, mkSpaceTime]
      have hG_z₀ : G z₀ = P₀ + c₁ • e_t + α • (z₀ - z₁) := by
        change P₀ + (c₁ + (c₂ - α) * (innerSL ℝ e_t z₀ - inner ℝ e_t z₁)) • e_t + α • (z₀ - z₁) = _
        rw [hz₀_et, mul_zero, add_zero]
      rw [hG_z₀]
      ext i
      simp [projSpace, P₀, e_t, z₀, z₁, mkSpaceTime, smul_eq_mul]
    let G' : EuclideanSpace ℝ (Fin (d + 1)) →L[ℝ] EuclideanSpace ℝ (Fin (d + 1)) :=
      ((c₂ - α) • (ContinuousLinearMap.smulRight (innerSL ℝ e_t) e_t)) +
        α • ContinuousLinearMap.id ℝ (EuclideanSpace ℝ (Fin (d + 1)))
    have h_fderiv_G : HasFDerivAt G G' z₀ := by
      have hd_sub : HasFDerivAt (fun w : EuclideanSpace ℝ (Fin (d + 1)) => w - z₁)
          (ContinuousLinearMap.id ℝ (EuclideanSpace ℝ (Fin (d + 1)))) z₀ :=
        (hasFDerivAt_id z₀).sub_const z₁
      have hd_et : HasFDerivAt (fun w : EuclideanSpace ℝ (Fin (d + 1)) =>
          innerSL ℝ e_t w - inner ℝ e_t z₁) (innerSL ℝ e_t) z₀ :=
        (innerSL ℝ e_t).hasFDerivAt.sub_const (inner ℝ e_t z₁)
      have hd_coef : HasFDerivAt (fun w : EuclideanSpace ℝ (Fin (d + 1)) =>
          c₁ + (c₂ - α) * (innerSL ℝ e_t w - inner ℝ e_t z₁))
          ((c₂ - α) • innerSL ℝ e_t) z₀ := by
        simpa using (hd_et.const_mul (c₂ - α)).const_add c₁
      have hd_term1 : HasFDerivAt (fun w : EuclideanSpace ℝ (Fin (d + 1)) =>
          (c₁ + (c₂ - α) * (innerSL ℝ e_t w - inner ℝ e_t z₁)) • e_t)
          (((c₂ - α) • innerSL ℝ e_t).smulRight e_t) z₀ :=
        hd_coef.smul_const e_t
      have hd_term2 : HasFDerivAt (fun w : EuclideanSpace ℝ (Fin (d + 1)) => α • (w - z₁))
          (α • ContinuousLinearMap.id ℝ (EuclideanSpace ℝ (Fin (d + 1)))) z₀ :=
        hd_sub.const_smul α
      have hd_G := (hd_term1.const_add P₀).add hd_term2
      convert hd_G using 1
      ext v i
      simp [G', smul_eq_mul, mul_assoc]
    have h_fderiv2 : HasFDerivAt (fderiv ℝ (sliceQuadTest d p₀ x s₀ c₀ c₁ c₂ α))
        ((innerSL ℝ : EuclideanSpace ℝ (Fin (d + 1)) →L[ℝ]
          (EuclideanSpace ℝ (Fin (d + 1)) →L[ℝ] ℝ)).comp G') z₀ := by
      rw [h_fderiv_eq]
      exact (innerSL ℝ : EuclideanSpace ℝ (Fin (d + 1)) →L[ℝ]
        (EuclideanSpace ℝ (Fin (d + 1)) →L[ℝ] ℝ)).hasFDerivAt.comp z₀ h_fderiv_G
    unfold limitingOperator
    rw [h_fderiv2.fderiv, h_grad_z₀, h_proj_G]
    set q : EuclideanSpace ℝ (Fin d) := p₀ + α • (y₀ - x)
    let ξ : EuclideanSpace ℝ (Fin (d + 1)) := mkSpaceTime q 1
    change (((innerSL ℝ : EuclideanSpace ℝ (Fin (d + 1)) →L[ℝ]
      (EuclideanSpace ℝ (Fin (d + 1)) →L[ℝ] ℝ)).comp G') ξ) ξ = c₂ + α * ‖q‖ ^ 2
    have h_et_ξ : inner ℝ e_t ξ = 1 := by
      simp only [e_t, ξ, PiLp.inner_apply, RCLike.inner_apply, conj_trivial]
      rw [Fin.sum_univ_castSucc]
      simp [mkSpaceTime]
    have h_ξ_ξ : inner ℝ ξ ξ = ‖q‖ ^ 2 + 1 := by
      rw [real_inner_self_eq_norm_sq]
      simp only [ξ, PiLp.norm_sq_eq_of_L2, Real.norm_eq_abs, sq_abs]
      rw [Fin.sum_univ_castSucc]
      simp [mkSpaceTime]
    simp only [G', ContinuousLinearMap.comp_apply, add_apply, smul_apply,
      ContinuousLinearMap.smulRight_apply, ContinuousLinearMap.id_apply, innerSL_apply_apply,
      inner_add_left, inner_smul_left, RCLike.conj_to_real, h_et_ξ, h_ξ_ξ]
    ring
  have h_chord : ∀ (F : ℝ → ℝ), Continuous F →
      (∀ (u w s₀ c₁ c₂ : ℝ), u < s₀ → s₀ < w →
        (∀ s : ℝ, u < s → s < w → F s ≤ F s₀ + c₁ * (s - s₀) + (c₂ / 2) * (s - s₀) ^ 2) →
        0 ≤ c₂) →
      ∀ (u t w : ℝ), u ≤ t → t ≤ w → (w - u) * F t ≤ (w - t) * F u + (t - u) * F w := by
    intro F hF_cont h_sub u t w hut htw
    rcases eq_or_lt_of_le hut with rfl | hut_lt
    · ring_nf; rfl
    rcases eq_or_lt_of_le htw with rfl | htw_lt
    · ring_nf; rfl
    have huw : u < w := lt_trans hut_lt htw_lt
    have hwu_pos : 0 < w - u := sub_pos.mpr huw
    by_contra h_not
    have h_gt : (w - t) * F u + (t - u) * F w < (w - u) * F t := lt_of_not_ge h_not
    set m : ℝ := (F w - F u) / (w - u)
    set L : ℝ → ℝ := fun s => F u + m * (s - u)
    have hLu : L u = F u := by simp [L]
    have hLw : L w = F w := by
      simp only [L, m]
      field_simp [ne_of_gt hwu_pos]
      ring
    have h_gap_mul : (w - u) * (F t - L t) = (w - u) * F t - ((w - t) * F u + (t - u) * F w) := by
      simp only [L, m]
      field_simp [ne_of_gt hwu_pos]
      ring
    have h_gap_pos : 0 < F t - L t := by
      have h_prod_pos : 0 < (w - u) * (F t - L t) := by linarith
      exact pos_of_mul_pos_right h_prod_pos (le_of_lt hwu_pos)
    have h_denom_pos : 0 < 2 * (t - u) * (w - t) := by
      have : 0 < t - u := sub_pos.mpr hut_lt
      have : 0 < w - t := sub_pos.mpr htw_lt
      positivity
    set δ : ℝ := (F t - L t) / (2 * (t - u) * (w - t))
    have hδ_pos : 0 < δ := div_pos h_gap_pos h_denom_pos
    set g : ℝ → ℝ := fun s => F s - L s - δ * (s - u) * (w - s)
    have hg_cont : Continuous g := by
      unfold g L
      fun_prop
    have hg_u : g u = 0 := by simp [g, hLu]
    have hg_w : g w = 0 := by simp [g, hLw]
    have hg_t : g t = (F t - L t) / 2 := by
      simp only [g, δ]
      field_simp [ne_of_gt (sub_pos.mpr hut_lt), ne_of_gt (sub_pos.mpr htw_lt)]
      ring
    have hg_t_pos : 0 < g t := by linarith
    obtain ⟨s₀, hs₀_mem, hs₀_max⟩ :=
      isCompact_Icc.exists_isMaxOn (Set.nonempty_Icc.mpr (le_of_lt huw)) hg_cont.continuousOn
    have ht_mem : t ∈ Set.Icc u w := ⟨le_of_lt hut_lt, le_of_lt htw_lt⟩
    have hgs₀_pos : 0 < g s₀ := lt_of_lt_of_le hg_t_pos (hs₀_max ht_mem)
    have hs₀_ne_u : s₀ ≠ u := by
      intro h_eq
      rw [h_eq, hg_u] at hgs₀_pos
      exact lt_irrefl 0 hgs₀_pos
    have hs₀_ne_w : s₀ ≠ w := by
      intro h_eq
      rw [h_eq, hg_w] at hgs₀_pos
      exact lt_irrefl 0 hgs₀_pos
    have hus₀ : u < s₀ := lt_of_le_of_ne hs₀_mem.1 (Ne.symm hs₀_ne_u)
    have hs₀w : s₀ < w := lt_of_le_of_ne hs₀_mem.2 hs₀_ne_w
    set c₁ : ℝ := m + δ * (u + w - 2 * s₀)
    set c₂ : ℝ := -2 * δ
    have h_quad : ∀ s : ℝ, u < s → s < w →
        F s ≤ F s₀ + c₁ * (s - s₀) + (c₂ / 2) * (s - s₀) ^ 2 := by
      intro s hus hsw
      have hs_mem : s ∈ Set.Icc u w := ⟨le_of_lt hus, le_of_lt hsw⟩
      have h_le : g s ≤ g s₀ := hs₀_max hs_mem
      have h_id : L s + δ * (s - u) * (w - s) + (F s₀ - L s₀ - δ * (s₀ - u) * (w - s₀)) =
          F s₀ + c₁ * (s - s₀) + (c₂ / 2) * (s - s₀) ^ 2 := by
        simp only [L, c₁, c₂]
        ring
      linarith [h_le, h_id]
    have hc₂_nonneg : 0 ≤ c₂ := h_sub u w s₀ c₁ c₂ hus₀ hs₀w h_quad
    linarith
  have h_mk_id : ∀ z : EuclideanSpace ℝ (Fin (d + 1)),
      mkSpaceTime (projSpace z) (projTime z) = z := by
    intro z
    ext j
    refine Fin.lastCases ?_ ?_ j
    · simp [mkSpaceTime, projTime]
    · intro i
      simp [mkSpaceTime, projSpace]
  have h_projSpace_mk : ∀ (y : EuclideanSpace ℝ (Fin d)) (s : ℝ),
      projSpace (mkSpaceTime y s) = y := by
    intro y s
    ext i
    simp [projSpace, mkSpaceTime]
  have h_projTime_mk : ∀ (y : EuclideanSpace ℝ (Fin d)) (s : ℝ),
      projTime (mkSpaceTime y s) = s := by
    intro y s
    simp [projTime, mkSpaceTime]
  have h_projTime_cont : Continuous (@projTime d) := by
    unfold projTime
    exact (continuous_apply (Fin.last d)).comp (EuclideanSpace.equiv (Fin (d + 1)) ℝ).continuous
  set M_p : ℝ := ‖p 0‖ + 2 * C₀
  have hMp_sq : ∀ s : ℝ, ‖p s‖ ^ 2 ≤ M_p ^ 2 := by
    intro s
    have h_norm : ‖p s‖ ≤ M_p := by
      have h_tri : ‖p s‖ ≤ ‖p 0‖ + ‖p s - p 0‖ := by
        simpa [add_sub_cancel] using norm_add_le (p 0) (p s - p 0)
      linarith [hp_bdd s]
    have h_nonneg : 0 ≤ ‖p s‖ := norm_nonneg _
    nlinarith
  let h_x : EuclideanSpace ℝ (Fin d) → ℝ → ℝ :=
    fun x s => inner ℝ (p s) x + c s + (1 / 2 : ℝ) * ‖p s‖ ^ 2
  let H_x : EuclideanSpace ℝ (Fin d) → ℝ → ℝ :=
    fun x s => h_x x s + (M_p ^ 2 / 2) * s ^ 2
  have hHx_cont : ∀ x : EuclideanSpace ℝ (Fin d), Continuous (H_x x) := by
    intro x
    unfold H_x h_x
    have h1 : Continuous (fun s => inner ℝ (p s) x) :=
      Continuous.inner hp_cont continuous_const
    have h2 : Continuous (fun s => ‖p s‖ ^ 2) := (hp_cont.norm).pow 2
    fun_prop
  have h_sq_comp : ∀ (x y : EuclideanSpace ℝ (Fin d)) (s : ℝ),
      v₀ (mkSpaceTime y s) ≤ h_x x s + (1 / 2 : ℝ) * ‖y - x‖ ^ 2 := by
    intro x y s
    rw [hv_slice s y]
    unfold h_x
    have h_nonneg : 0 ≤ ‖(y - x) - p s‖ ^ 2 := sq_nonneg _
    rw [norm_sub_sq_real, real_inner_comm, inner_sub_right] at h_nonneg
    linarith
  have h_sq_eq : ∀ (x : EuclideanSpace ℝ (Fin d)) (s : ℝ),
      v₀ (mkSpaceTime (x + p s) s) = h_x x s + (1 / 2 : ℝ) * ‖(x + p s) - x‖ ^ 2 := by
    intro x s
    rw [hv_slice s (x + p s), add_sub_cancel_left]
    unfold h_x
    rw [inner_add_right, real_inner_self_eq_norm_sq]
    ring
  have hHx_chord : ∀ (x : EuclideanSpace ℝ (Fin d)) (u t w : ℝ),
      u ≤ t → t ≤ w → (w - u) * H_x x t ≤ (w - t) * H_x x u + (t - u) * H_x x w := by
    intro x
    apply h_chord (H_x x) (hHx_cont x)
    intro u w s₀ c₁ c₂ hus₀ hs₀w h_quad
    let V : Set (EuclideanSpace ℝ (Fin (d + 1))) := (@projTime d) ⁻¹' Set.Ioo u w
    have hV_open : IsOpen V := isOpen_Ioo.preimage h_projTime_cont
    let y₀ : EuclideanSpace ℝ (Fin d) := x + p s₀
    let z₀ : EuclideanSpace ℝ (Fin (d + 1)) := mkSpaceTime y₀ s₀
    have hz₀_mem : z₀ ∈ V := by simp [V, z₀, h_projTime_mk, hus₀, hs₀w]
    let Φ := sliceQuadTest d 0 x s₀ (h_x x s₀) (c₁ - M_p ^ 2 * s₀) (c₂ - M_p ^ 2) 1
    have hΦ_test := h_test 0 x y₀ s₀ (h_x x s₀) (c₁ - M_p ^ 2 * s₀) (c₂ - M_p ^ 2) 1 V
    have hΦ_z₀ : Φ z₀ = v₀ z₀ := by
      unfold Φ sliceQuadTest
      rw [h_projSpace_mk, h_projTime_mk, h_sq_eq x s₀]
      simp [y₀]
    have hΦ_ge : ∀ z ∈ V, v₀ z ≤ Φ z := by
      intro z hz
      have h_u_z : u < projTime z := hz.1
      have h_z_w : projTime z < w := hz.2
      have h_v_le : v₀ z ≤ h_x x (projTime z) + (1 / 2 : ℝ) * ‖projSpace z - x‖ ^ 2 := by
        have h_tmp := h_sq_comp x (projSpace z) (projTime z)
        rwa [h_mk_id z] at h_tmp
      have h_H_le := h_quad (projTime z) h_u_z h_z_w
      unfold H_x at h_H_le
      unfold Φ sliceQuadTest
      simp only [inner_zero_left, zero_add]
      linarith
    have h_visc := hv₀.2.1 z₀ Φ V hV_open hz₀_mem hΦ_test.1 hΦ_z₀ hΦ_ge
    rw [hΦ_test.2] at h_visc
    have h_norm_p : ‖(0 : EuclideanSpace ℝ (Fin d)) + (1 : ℝ) • (y₀ - x)‖ ^ 2 = ‖p s₀‖ ^ 2 := by
      simp [y₀]
    rw [h_norm_p] at h_visc
    linarith [hMp_sq s₀]
  have hHx_mid : ∀ (x : EuclideanSpace ℝ (Fin d)) (s : ℝ),
      2 * H_x x s ≤ H_x x 0 + H_x x (2 * s) := by
    intro x s
    rcases le_or_gt 0 s with hs | hs
    · rcases eq_or_lt_of_le hs with rfl | hs_pos
      · ring_nf; linarith
      · have h_ch := hHx_chord x 0 s (2 * s) (le_of_lt hs_pos) (by linarith)
        nlinarith
    · have h_ch := hHx_chord x (2 * s) s 0 (by linarith) (le_of_lt hs)
      nlinarith
  have hp_double : ∀ s : ℝ, p (2 * s) - p 0 = (2 : ℝ) • (p s - p 0) := by
    intro s
    set q : EuclideanSpace ℝ (Fin d) := (2 : ℝ) • p s - p 0 - p (2 * s)
    set B : ℝ := H_x 0 0 + H_x 0 (2 * s) - 2 * H_x 0 s
    have h_in : ∀ x : EuclideanSpace ℝ (Fin d), inner ℝ q x ≤ B := by
      intro x
      have hm := hHx_mid x s
      have h_diff : ∀ t : ℝ, H_x x t = H_x 0 t + inner ℝ (p t) x := by
        intro t
        simp only [H_x, h_x, inner_zero_right]
        ring
      rw [h_diff s, h_diff 0, h_diff (2 * s)] at hm
      have hq_in : inner ℝ q x = 2 * inner ℝ (p s) x - inner ℝ (p 0) x - inner ℝ (p (2 * s)) x := by
        simp only [q, inner_sub_left, inner_smul_left, RCLike.conj_to_real]
      linarith
    have hq_zero : q = 0 := by
      by_contra hq_ne
      have hq_sq_pos : 0 < ‖q‖ ^ 2 := sq_pos_of_pos (norm_pos_iff.mpr hq_ne)
      have h_test_x := h_in (((|B| + 1) / ‖q‖ ^ 2) • q)
      rw [inner_smul_right, real_inner_self_eq_norm_sq,
        div_mul_cancel₀ (|B| + 1) (ne_of_gt hq_sq_pos)] at h_test_x
      linarith [le_abs_self B]
    calc p (2 * s) - p 0 = (2 : ℝ) • (p s - p 0) - q := by
          simp only [q]; module
      _ = (2 : ℝ) • (p s - p 0) := by rw [hq_zero, sub_zero]
  have hp_pow : ∀ (k : ℕ) (s : ℝ), p ((2 : ℝ) ^ k * s) - p 0 = ((2 : ℝ) ^ k) • (p s - p 0) := by
    intro k
    induction k with
    | zero =>
      intro s
      simp
    | succ k ih =>
      intro s
      have h_mul : (2 : ℝ) ^ (k + 1) * s = (2 : ℝ) ^ k * (2 * s) := by ring
      rw [h_mul, ih (2 * s), hp_double s, smul_smul, ← pow_succ]
  have hp_const : ∀ t : ℝ, p t = p 0 := by
    intro t
    by_contra h_ne
    have h_pos : 0 < ‖p t - p 0‖ := norm_pos_iff.mpr (sub_ne_zero.mpr h_ne)
    obtain ⟨k, hk⟩ := exists_nat_gt (2 * C₀ / ‖p t - p 0‖)
    have h_bdd_k := hp_bdd ((2 : ℝ) ^ k * t)
    rw [hp_pow k t, norm_smul, Real.norm_eq_abs, abs_of_pos (by positivity : (0 : ℝ) < (2 : ℝ) ^ k)] at h_bdd_k
    have hk_lt_pow : (k : ℝ) < (2 : ℝ) ^ k := by
      exact_mod_cast Nat.lt_two_pow_self
    have h_gt : 2 * C₀ < (k : ℝ) * ‖p t - p 0‖ := (div_lt_iff₀ h_pos).mp hk
    have h_pow_gt : (k : ℝ) * ‖p t - p 0‖ < (2 : ℝ) ^ k * ‖p t - p 0‖ :=
      mul_lt_mul_of_pos_right hk_lt_pow h_pos
    linarith
  have hc_upper : ∀ (u t w : ℝ), u ≤ t → t ≤ w →
      (w - u) * c t ≤ (w - t) * c u + (t - u) * c w := by
    apply h_chord c hc_cont
    intro u w s₀ c₁ c₂ hus₀ hs₀w h_quad
    let V : Set (EuclideanSpace ℝ (Fin (d + 1))) := (@projTime d) ⁻¹' Set.Ioo u w
    have hV_open : IsOpen V := isOpen_Ioo.preimage h_projTime_cont
    let z₀ : EuclideanSpace ℝ (Fin (d + 1)) := mkSpaceTime 0 s₀
    have hz₀_mem : z₀ ∈ V := by simp [V, z₀, h_projTime_mk, hus₀, hs₀w]
    let Φ := sliceQuadTest d (p 0) 0 s₀ (c s₀) c₁ c₂ 0
    have hΦ_test := h_test (p 0) 0 0 s₀ (c s₀) c₁ c₂ 0 V
    have hΦ_z₀ : Φ z₀ = v₀ z₀ := by
      rw [hv_slice s₀ 0, hp_const s₀]
      unfold Φ sliceQuadTest
      rw [h_projSpace_mk, h_projTime_mk]
      ring
    have hΦ_ge : ∀ z ∈ V, v₀ z ≤ Φ z := by
      intro z hz
      have h_vz : v₀ z = inner ℝ (p 0) (projSpace z) + c (projTime z) := by
        calc v₀ z = v₀ (mkSpaceTime (projSpace z) (projTime z)) := by rw [h_mk_id z]
          _ = inner ℝ (p (projTime z)) (projSpace z) + c (projTime z) :=
              hv_slice (projTime z) (projSpace z)
          _ = inner ℝ (p 0) (projSpace z) + c (projTime z) := by rw [hp_const (projTime z)]
      have h_c_le := h_quad (projTime z) hz.1 hz.2
      unfold Φ sliceQuadTest
      linarith
    have h_visc := hv₀.2.1 z₀ Φ V hV_open hz₀_mem hΦ_test.1 hΦ_z₀ hΦ_ge
    rw [hΦ_test.2] at h_visc
    linarith
  have hc_lower : ∀ (u t w : ℝ), u ≤ t → t ≤ w →
      (w - u) * (-c t) ≤ (w - t) * (-c u) + (t - u) * (-c w) := by
    apply h_chord (fun s => -c s) hc_cont.neg
    intro u w s₀ c₁ c₂ hus₀ hs₀w h_quad
    let V : Set (EuclideanSpace ℝ (Fin (d + 1))) := (@projTime d) ⁻¹' Set.Ioo u w
    have hV_open : IsOpen V := isOpen_Ioo.preimage h_projTime_cont
    let z₀ : EuclideanSpace ℝ (Fin (d + 1)) := mkSpaceTime 0 s₀
    have hz₀_mem : z₀ ∈ V := by simp [V, z₀, h_projTime_mk, hus₀, hs₀w]
    let Φ := sliceQuadTest d (p 0) 0 s₀ (c s₀) (-c₁) (-c₂) 0
    have hΦ_test := h_test (p 0) 0 0 s₀ (c s₀) (-c₁) (-c₂) 0 V
    have hΦ_z₀ : Φ z₀ = v₀ z₀ := by
      rw [hv_slice s₀ 0, hp_const s₀]
      unfold Φ sliceQuadTest
      rw [h_projSpace_mk, h_projTime_mk]
      ring
    have hΦ_le : ∀ z ∈ V, Φ z ≤ v₀ z := by
      intro z hz
      have h_vz : v₀ z = inner ℝ (p 0) (projSpace z) + c (projTime z) := by
        calc v₀ z = v₀ (mkSpaceTime (projSpace z) (projTime z)) := by rw [h_mk_id z]
          _ = inner ℝ (p (projTime z)) (projSpace z) + c (projTime z) :=
              hv_slice (projTime z) (projSpace z)
          _ = inner ℝ (p 0) (projSpace z) + c (projTime z) := by rw [hp_const (projTime z)]
      have h_c_le := h_quad (projTime z) hz.1 hz.2
      unfold Φ sliceQuadTest
      linarith
    have h_visc := hv₀.2.2.1 z₀ Φ V hV_open hz₀_mem hΦ_test.1 hΦ_z₀ hΦ_le
    rw [hΦ_test.2] at h_visc
    linarith
  have hc_chord_eq : ∀ (u t w : ℝ), u ≤ t → t ≤ w →
      (w - u) * c t = (w - t) * c u + (t - u) * c w := by
    intro u t w hut htw
    have h1 := hc_upper u t w hut htw
    have h2 := hc_lower u t w hut htw
    linarith
  have hc_aff : ∀ t : ℝ, c t = c 0 + (c 1 - c 0) * t := by
    intro t
    rcases le_total t 0 with ht0 | ht0
    · have h_eq := hc_chord_eq t 0 1 ht0 (by norm_num)
      linarith
    · rcases le_total t 1 with ht1 | ht1
      · have h_eq := hc_chord_eq 0 t 1 ht0 ht1
        linarith
      · have h_eq := hc_chord_eq 0 1 t (by norm_num) ht1
        linarith
  refine ⟨mkSpaceTime (p 0) (c 1 - c 0), c 0, fun z => ?_⟩
  have h_inner : inner ℝ (mkSpaceTime (p 0) (c 1 - c 0)) z =
      inner ℝ (p 0) (projSpace z) + (c 1 - c 0) * projTime z := by
    simp only [PiLp.inner_apply, RCLike.inner_apply, conj_trivial]
    rw [Fin.sum_univ_castSucc]
    simp [mkSpaceTime, projSpace, projTime, mul_comm]
  calc v₀ z = v₀ (mkSpaceTime (projSpace z) (projTime z)) := by rw [h_mk_id z]
    _ = inner ℝ (p (projTime z)) (projSpace z) + c (projTime z) :=
        hv_slice (projTime z) (projSpace z)
    _ = inner ℝ (p 0) (projSpace z) + (c 0 + (c 1 - c 0) * projTime z) := by
        rw [hp_const (projTime z), hc_aff (projTime z)]
    _ = inner ℝ (mkSpaceTime (p 0) (c 1 - c 0)) z + c 0 := by
        rw [h_inner]; ring

theorem positive_jensen_defect_of_not_horizontally_affine (d : ℕ) (C₀ : ℝ) (hC₀ : 0 ≤ C₀)
    (v₀ : EuclideanSpace ℝ (Fin (d + 1)) → ℝ) (hv₀ : InLimitingClassA d C₀ v₀)
    (h_not_horiz : ¬ ∀ t : ℝ, ∃ (p : EuclideanSpace ℝ (Fin d)) (c : ℝ),
      ∀ x : EuclideanSpace ℝ (Fin d), v₀ (mkSpaceTime x t) = inner ℝ p x + c) :
    ∃ (w₀ : EuclideanSpace ℝ (Fin (d + 1)) → ℝ) (t₀ : ℝ) (N₀ : ℕ)
      (θ₀ : Fin N₀ → ℝ) (y₀ : Fin N₀ → EuclideanSpace ℝ (Fin d)),
      InLimitingClassA d (max C₀ 1) w₀ ∧
      (∀ i, 0 < θ₀ i) ∧
      (∑ i, θ₀ i = 1) ∧
      0 < Real.sqrt (∑ i, θ₀ i * ‖y₀ i - ∑ j, θ₀ j • y₀ j‖ ^ 2) ∧
      0 < (∑ i, θ₀ i * w₀ (mkSpaceTime (y₀ i) t₀)) -
        w₀ (mkSpaceTime (∑ j, θ₀ j • y₀ j) t₀) :=
by
  have test_s1 : ∀ (g : EuclideanSpace ℝ (Fin d) → ℝ),
      (¬ ∃ (p : EuclideanSpace ℝ (Fin d)) (c : ℝ),
        ∀ x : EuclideanSpace ℝ (Fin d), g x = inner ℝ p x + c) →
      ∃ (lam : ℝ) (y₁ y₂ : EuclideanSpace ℝ (Fin d)),
        0 < lam ∧ lam < 1 ∧ y₁ ≠ y₂ ∧
        (1 - lam) * g y₁ + lam * g y₂ ≠ g ((1 - lam) • y₁ + lam • y₂) := by
    intro g h_not_aff
    by_contra h_all
    push_neg at h_all
    have h_conv : ∀ (lam : ℝ), 0 < lam → lam < 1 → ∀ (y₁ y₂ : EuclideanSpace ℝ (Fin d)),
        g ((1 - lam) • y₁ + lam • y₂) = (1 - lam) * g y₁ + lam * g y₂ := by
      intro lam h0 h1 y₁ y₂
      by_cases hne : y₁ = y₂
      · subst hne
        have h_smul : (1 - lam) • y₁ + lam • y₁ = y₁ := by
          rw [← add_smul, sub_add_cancel, one_smul]
        rw [h_smul]
        ring
      · exact (h_all lam y₁ y₂ h0 h1 hne).symm
    let h : EuclideanSpace ℝ (Fin d) → ℝ := fun x => g x - g 0
    have h0 : h 0 = 0 := sub_self (g 0)
    have h_conv_h : ∀ (lam : ℝ), 0 < lam → lam < 1 → ∀ (y₁ y₂ : EuclideanSpace ℝ (Fin d)),
        h ((1 - lam) • y₁ + lam • y₂) = (1 - lam) * h y₁ + lam * h y₂ := by
      intro lam hlam0 hlam1 y₁ y₂
      dsimp [h]
      rw [h_conv lam hlam0 hlam1 y₁ y₂]
      ring
    have h_smul_Ioo : ∀ (lam : ℝ), 0 < lam → lam < 1 → ∀ (x : EuclideanSpace ℝ (Fin d)),
        h (lam • x) = lam * h x := by
      intro lam hlam0 hlam1 x
      have := h_conv_h lam hlam0 hlam1 0 x
      simpa [h0] using this
    have h_smul_gt_one : ∀ (c : ℝ), 1 < c → ∀ (x : EuclideanSpace ℝ (Fin d)),
        h (c • x) = c * h x := by
      intro c hc x
      have hc_pos : 0 < c := by linarith
      have hc_ne : c ≠ 0 := ne_of_gt hc_pos
      have h_inv_pos : 0 < c⁻¹ := inv_pos.mpr hc_pos
      have h_inv_lt : c⁻¹ < 1 := inv_lt_one_of_one_lt₀ hc
      have h_eq := h_smul_Ioo c⁻¹ h_inv_pos h_inv_lt (c • x)
      rw [smul_smul, inv_mul_cancel₀ hc_ne, one_smul] at h_eq
      calc h (c • x) = c * (c⁻¹ * h (c • x)) := by
            rw [← mul_assoc, mul_inv_cancel₀ hc_ne, one_mul]
        _ = c * h x := by rw [← h_eq]
    have h_smul_nonneg : ∀ (c : ℝ), 0 ≤ c → ∀ (x : EuclideanSpace ℝ (Fin d)),
        h (c • x) = c * h x := by
      intro c hc x
      rcases eq_or_lt_of_le hc with rfl | hc_pos
      · simp [h0]
      · rcases lt_trichotomy c 1 with hc_lt | rfl | hc_gt
        · exact h_smul_Ioo c hc_pos hc_lt x
        · simp
        · exact h_smul_gt_one c hc_gt x
    have h_neg : ∀ (x : EuclideanSpace ℝ (Fin d)), h (-x) = -h x := by
      intro x
      have h_half := h_conv_h (1 / 2) (by norm_num) (by norm_num) x (-x)
      have h_mid : (1 - (1 / 2 : ℝ)) • x + (1 / 2 : ℝ) • (-x) = 0 := by
        ext i
        simp
        ring
      rw [h_mid, h0] at h_half
      linarith
    have h_smul : ∀ (c : ℝ) (x : EuclideanSpace ℝ (Fin d)), h (c • x) = c * h x := by
      intro c x
      rcases le_or_gt 0 c with hc | hc
      · exact h_smul_nonneg c hc x
      · have h_neg_c : 0 ≤ -c := by linarith
        have h_eq : c • x = (-c) • (-x) := by rw [smul_neg, neg_smul, neg_neg]
        rw [h_eq, h_smul_nonneg (-c) h_neg_c (-x), h_neg x]
        ring
    have h_add : ∀ (x y : EuclideanSpace ℝ (Fin d)), h (x + y) = h x + h y := by
      intro x y
      have h_half := h_conv_h (1 / 2) (by norm_num) (by norm_num) ((2 : ℝ) • x) ((2 : ℝ) • y)
      have h_mid : (1 - (1 / 2 : ℝ)) • ((2 : ℝ) • x) + (1 / 2 : ℝ) • ((2 : ℝ) • y) = x + y := by
        ext i
        simp
        ring
      rw [h_mid, h_smul 2 x, h_smul 2 y] at h_half
      linarith
    let L : EuclideanSpace ℝ (Fin d) →ₗ[ℝ] ℝ :=
      { toFun := h
        map_add' := h_add
        map_smul' := fun c x => by simp [h_smul] }
    let p : EuclideanSpace ℝ (Fin d) :=
      (InnerProductSpace.toDual ℝ (EuclideanSpace ℝ (Fin d))).symm L.toContinuousLinearMap
    apply h_not_aff
    refine ⟨p, g 0, fun x => ?_⟩
    have hp : inner ℝ p x = h x := by
      change inner ℝ ((InnerProductSpace.toDual ℝ (EuclideanSpace ℝ (Fin d))).symm L.toContinuousLinearMap) x = h x
      rw [InnerProductSpace.toDual_symm_apply]
      rfl
    dsimp [h] at hp
    linarith
  have test_s2 : ∀ (C₁ : ℝ), C₀ ≤ C₁ →
      ∀ (v : EuclideanSpace ℝ (Fin (d + 1)) → ℝ), InLimitingClassA d C₀ v →
      InLimitingClassA d C₁ (fun z => -v (mkSpaceTime (projSpace z) (-projTime z))) := by
    intro C₁ hC v hv
    let S_fun : EuclideanSpace ℝ (Fin (d + 1)) → EuclideanSpace ℝ (Fin (d + 1)) :=
      fun z => mkSpaceTime (projSpace z) (-projTime z)
    have hS_castSucc : ∀ (z : EuclideanSpace ℝ (Fin (d + 1))) (i : Fin d),
        S_fun z (Fin.castSucc i) = z (Fin.castSucc i) := by
      intro z i
      simp [S_fun, mkSpaceTime, projSpace]
    have hS_last : ∀ (z : EuclideanSpace ℝ (Fin (d + 1))),
        S_fun z (Fin.last d) = - z (Fin.last d) := by
      intro z
      simp [S_fun, mkSpaceTime, projTime]
    have hS_invol : ∀ z : EuclideanSpace ℝ (Fin (d + 1)), S_fun (S_fun z) = z := by
      intro z
      ext j
      refine Fin.lastCases ?_ ?_ j
      · rw [hS_last, hS_last, neg_neg]
      · intro i
        rw [hS_castSucc, hS_castSucc]
    have hS_add : ∀ z₁ z₂ : EuclideanSpace ℝ (Fin (d + 1)), S_fun (z₁ + z₂) = S_fun z₁ + S_fun z₂ := by
      intro z₁ z₂
      ext j
      refine Fin.lastCases ?_ ?_ j
      · simp only [PiLp.add_apply, hS_last]
        ring
      · intro i
        simp only [PiLp.add_apply, hS_castSucc]
    have hS_smul : ∀ (c : ℝ) (z : EuclideanSpace ℝ (Fin (d + 1))), S_fun (c • z) = c • S_fun z := by
      intro c z
      ext j
      refine Fin.lastCases ?_ ?_ j
      · simp only [PiLp.smul_apply, smul_eq_mul, hS_last]
        ring
      · intro i
        simp only [PiLp.smul_apply, smul_eq_mul, hS_castSucc]
    let S_lin : EuclideanSpace ℝ (Fin (d + 1)) ≃ₗ[ℝ] EuclideanSpace ℝ (Fin (d + 1)) :=
      { toFun := S_fun
        invFun := S_fun
        map_add' := hS_add
        map_smul' := fun c z => by simpa using hS_smul c z
        left_inv := hS_invol
        right_inv := hS_invol }
    let S : EuclideanSpace ℝ (Fin (d + 1)) ≃L[ℝ] EuclideanSpace ℝ (Fin (d + 1)) :=
      S_lin.toContinuousLinearEquiv
    have hS_apply : ∀ z : EuclideanSpace ℝ (Fin (d + 1)), S z = S_fun z := fun _ => rfl
    have hS_invol' : ∀ z : EuclideanSpace ℝ (Fin (d + 1)), S (S z) = z := hS_invol
    have hS_inner : ∀ u w : EuclideanSpace ℝ (Fin (d + 1)),
        inner ℝ (S u) w = inner ℝ u (S w) := by
      intro u w
      rw [PiLp.inner_apply, PiLp.inner_apply, Fin.sum_univ_castSucc, Fin.sum_univ_castSucc]
      congr 1
      · refine Finset.sum_congr rfl fun i _ => ?_
        rw [hS_apply, hS_apply, hS_castSucc, hS_castSucc]
      · rw [hS_apply, hS_apply, hS_last, hS_last]
        simp only [RCLike.inner_apply, conj_trivial]
        ring
    have h_op : ∀ (ϕ : EuclideanSpace ℝ (Fin (d + 1)) → ℝ) (z : EuclideanSpace ℝ (Fin (d + 1))),
        limitingOperator (fun w => -ϕ (S w)) (S z) = -limitingOperator ϕ z := by
      intro ϕ z
      let ϕ_tilde : EuclideanSpace ℝ (Fin (d + 1)) → ℝ := -(ϕ ∘ S)
      have h_fderiv1 : ∀ w : EuclideanSpace ℝ (Fin (d + 1)),
          fderiv ℝ ϕ_tilde w = -((fderiv ℝ ϕ (S w)).comp (S : EuclideanSpace ℝ (Fin (d + 1)) →L[ℝ] EuclideanSpace ℝ (Fin (d + 1)))) := by
        intro w
        dsimp [ϕ_tilde]
        rw [fderiv_neg]
        congr 1
        exact S.comp_right_fderiv
      have h_grad : gradient ϕ_tilde (S z) = - S (gradient ϕ z) := by
        apply ext_inner_right ℝ
        intro u
        rw [gradient, InnerProductSpace.toDual_symm_apply]
        rw [h_fderiv1 (S z), hS_invol' z]
        simp only [ContinuousLinearMap.neg_apply, ContinuousLinearMap.comp_apply,
          ContinuousLinearEquiv.coe_coe]
        rw [← InnerProductSpace.toDual_symm_apply, ← gradient, ← hS_inner, inner_neg_left]
      let ξ : EuclideanSpace ℝ (Fin (d + 1)) := mkSpaceTime (projSpace (gradient ϕ z)) 1
      let ξ_tilde : EuclideanSpace ℝ (Fin (d + 1)) := mkSpaceTime (projSpace (gradient ϕ_tilde (S z))) 1
      have h_xi : S ξ_tilde = -ξ := by
        ext j
        refine Fin.lastCases ?_ ?_ j
        · rw [hS_apply, hS_last]
          simp [ξ_tilde, ξ, mkSpaceTime]
        · intro i
          rw [hS_apply, hS_castSucc]
          dsimp only [ξ_tilde, ξ]
          rw [h_grad]
          simp [mkSpaceTime, projSpace, hS_apply, hS_castSucc]
      let A : (EuclideanSpace ℝ (Fin (d + 1)) →L[ℝ] ℝ) ≃L[ℝ] (EuclideanSpace ℝ (Fin (d + 1)) →L[ℝ] ℝ) :=
        S.symm.arrowCongr (ContinuousLinearEquiv.refl ℝ ℝ)
      have hA_apply : ∀ (α : EuclideanSpace ℝ (Fin (d + 1)) →L[ℝ] ℝ) (u : EuclideanSpace ℝ (Fin (d + 1))),
          A α u = α (S u) := fun _ _ => rfl
      have h_fderiv1_eq : fderiv ℝ ϕ_tilde = -(A ∘ (fderiv ℝ ϕ ∘ S)) := by
        ext w u
        rw [h_fderiv1 w]
        simp only [Pi.neg_apply, Function.comp_apply, ContinuousLinearMap.neg_apply,
          ContinuousLinearMap.comp_apply, ContinuousLinearEquiv.coe_coe, hA_apply]
      have h_fderiv2 : fderiv ℝ (fderiv ℝ ϕ_tilde) (S z) =
          -((A : (EuclideanSpace ℝ (Fin (d + 1)) →L[ℝ] ℝ) →L[ℝ] (EuclideanSpace ℝ (Fin (d + 1)) →L[ℝ] ℝ)).comp
            ((fderiv ℝ (fderiv ℝ ϕ) z).comp (S : EuclideanSpace ℝ (Fin (d + 1)) →L[ℝ] EuclideanSpace ℝ (Fin (d + 1))))) := by
        rw [h_fderiv1_eq, fderiv_neg, A.comp_fderiv, S.comp_right_fderiv, hS_invol' z]
      dsimp [limitingOperator]
      change fderiv ℝ (fderiv ℝ ϕ_tilde) (S z) ξ_tilde ξ_tilde = - (fderiv ℝ (fderiv ℝ ϕ) z ξ ξ)
      rw [h_fderiv2]
      simp only [ContinuousLinearMap.neg_apply, ContinuousLinearMap.comp_apply,
        ContinuousLinearEquiv.coe_coe, hA_apply, h_xi, map_neg]
      ring
    change InLimitingClassA d C₁ (fun z => -v (S z))
    refine ⟨?_, ?_, ?_, ?_⟩
    · exact (hv.1.comp S.continuous).neg
    · intro z ϕ V hV_open hzV hϕ_c2 hϕ_eq hϕ_ge
      let ϕ_tilde : EuclideanSpace ℝ (Fin (d + 1)) → ℝ := fun w => -ϕ (S w)
      let V_tilde : Set (EuclideanSpace ℝ (Fin (d + 1))) := S ⁻¹' V
      have hV_tilde_open : IsOpen V_tilde := hV_open.preimage S.continuous
      have hz_tilde : S z ∈ V_tilde := by
        change S (S z) ∈ V
        rw [hS_invol' z]
        exact hzV
      have hϕ_tilde_c2 : ContDiffOn ℝ 2 ϕ_tilde V_tilde :=
        (hϕ_c2.comp S.contDiff.contDiffOn (fun _ hw => hw)).neg
      have hϕ_tilde_eq : ϕ_tilde (S z) = v (S z) := by
        dsimp [ϕ_tilde]
        rw [hS_invol' z, hϕ_eq, neg_neg]
      have hϕ_tilde_le : ∀ y ∈ V_tilde, ϕ_tilde y ≤ v y := by
        intro y hy
        dsimp [ϕ_tilde]
        have h1 := hϕ_ge (S y) hy
        dsimp at h1
        rw [hS_invol' y] at h1
        linarith
      have h_sub := hv.2.2.1 (S z) ϕ_tilde V_tilde hV_tilde_open hz_tilde hϕ_tilde_c2 hϕ_tilde_eq hϕ_tilde_le
      rw [h_op ϕ z] at h_sub
      linarith
    · intro z ϕ V hV_open hzV hϕ_c2 hϕ_eq hϕ_le
      let ϕ_tilde : EuclideanSpace ℝ (Fin (d + 1)) → ℝ := fun w => -ϕ (S w)
      let V_tilde : Set (EuclideanSpace ℝ (Fin (d + 1))) := S ⁻¹' V
      have hV_tilde_open : IsOpen V_tilde := hV_open.preimage S.continuous
      have hz_tilde : S z ∈ V_tilde := by
        change S (S z) ∈ V
        rw [hS_invol' z]
        exact hzV
      have hϕ_tilde_c2 : ContDiffOn ℝ 2 ϕ_tilde V_tilde :=
        (hϕ_c2.comp S.contDiff.contDiffOn (fun _ hw => hw)).neg
      have hϕ_tilde_eq : ϕ_tilde (S z) = v (S z) := by
        dsimp [ϕ_tilde]
        rw [hS_invol' z, hϕ_eq, neg_neg]
      have hϕ_tilde_ge : ∀ y ∈ V_tilde, v y ≤ ϕ_tilde y := by
        intro y hy
        dsimp [ϕ_tilde]
        have h1 := hϕ_le (S y) hy
        dsimp at h1
        rw [hS_invol' y] at h1
        linarith
      have h_sup := hv.2.1 (S z) ϕ_tilde V_tilde hV_tilde_open hz_tilde hϕ_tilde_c2 hϕ_tilde_eq hϕ_tilde_ge
      rw [h_op ϕ z] at h_sup
      linarith
    · intro x t R hR
      obtain ⟨p, a, hpa⟩ := hv.2.2.2 x (-t) R hR
      refine ⟨-p, a, fun h ℓ hℓ hh => ?_⟩
      have hℓ_neg : |-ℓ| ≤ R := by rwa [abs_neg]
      have hh_neg : ‖h - (-ℓ) • p‖ ≤ R := by
        have : h - (-ℓ) • p = h - ℓ • (-p) := by rw [neg_smul, smul_neg]
        rwa [this]
      have h_fit := hpa h (-ℓ) hℓ_neg hh_neg
      have h_projS : ∀ (y : EuclideanSpace ℝ (Fin d)) (s : ℝ),
          projSpace (mkSpaceTime y s) = y := by
        intro y s
        ext i
        simp [projSpace, mkSpaceTime]
      have h_projT : ∀ (y : EuclideanSpace ℝ (Fin d)) (s : ℝ),
          projTime (mkSpaceTime y s) = s := by
        intro y s
        simp [projTime, mkSpaceTime]
      dsimp [S, S_lin, S_fun]
      simp only [h_projS, h_projT, neg_add_rev, add_comm (-ℓ) (-t), inner_neg_left, norm_neg]
      have h_eq : |-v (mkSpaceTime (x + h) (-t + -ℓ)) - -v (mkSpaceTime x (-t)) -
          -inner ℝ p h - (a - ‖p‖ ^ 2 / 2) * ℓ| =
        |v (mkSpaceTime (x + h) (-t + -ℓ)) - v (mkSpaceTime x (-t)) -
          inner ℝ p h - (a - ‖p‖ ^ 2 / 2) * (-ℓ)| := by
        rw [← abs_neg]
        congr 1
        ring
      rw [h_eq]
      exact le_trans h_fit (mul_le_mul_of_nonneg_right hC (le_of_lt hR))
  have test_s3 : ∀ (lam : ℝ), 0 < lam → lam < 1 →
      ∀ (y₁ y₂ : EuclideanSpace ℝ (Fin d)), y₁ ≠ y₂ →
      ∃ (θ₀ : Fin 2 → ℝ) (y₀ : Fin 2 → EuclideanSpace ℝ (Fin d)),
        (∀ i, 0 < θ₀ i) ∧
        (∑ i, θ₀ i = 1) ∧
        0 < Real.sqrt (∑ i, θ₀ i * ‖y₀ i - ∑ j, θ₀ j • y₀ j‖ ^ 2) ∧
        ∀ f : EuclideanSpace ℝ (Fin d) → ℝ,
          (∑ i, θ₀ i * f (y₀ i)) - f (∑ j, θ₀ j • y₀ j) =
            (1 - lam) * f y₁ + lam * f y₂ - f ((1 - lam) • y₁ + lam • y₂) := by
    intro lam hlam0 hlam1 y₁ y₂ hne
    let θ₀ : Fin 2 → ℝ := fun i => if i = 0 then 1 - lam else lam
    let y₀ : Fin 2 → EuclideanSpace ℝ (Fin d) := fun i => if i = 0 then y₁ else y₂
    refine ⟨θ₀, y₀, ?_, ?_, ?_, ?_⟩
    · intro i
      fin_cases i
      · dsimp [θ₀]
        linarith
      · dsimp [θ₀]
        exact hlam0
    · simp [θ₀, Fin.sum_univ_two]
    · rw [Real.sqrt_pos]
      simp only [θ₀, y₀, Fin.sum_univ_two, Fin.isValue, ↓reduceIte, one_ne_zero]
      have h_diff1 : y₁ - ((1 - lam) • y₁ + lam • y₂) = lam • (y₁ - y₂) := by
        rw [sub_smul, one_smul, smul_sub]
        abel
      rw [h_diff1]
      have h_pos1 : 0 < (1 - lam) * ‖lam • (y₁ - y₂)‖ ^ 2 := by
        apply mul_pos (by linarith)
        apply sq_pos_of_pos
        rw [norm_pos_iff]
        exact smul_ne_zero (ne_of_gt hlam0) (sub_ne_zero.mpr hne)
      have h_nonneg2 : 0 ≤ lam * ‖y₂ - ((1 - lam) • y₁ + lam • y₂)‖ ^ 2 :=
        mul_nonneg (le_of_lt hlam0) (sq_nonneg _)
      linarith
    · intro f
      simp [θ₀, y₀, Fin.sum_univ_two]
  rw [not_forall] at h_not_horiz
  obtain ⟨t₀, ht₀⟩ := h_not_horiz
  let g : EuclideanSpace ℝ (Fin d) → ℝ := fun x => v₀ (mkSpaceTime x t₀)
  obtain ⟨lam, y₁, y₂, hlam0, hlam1, hne, h_def_ne⟩ := test_s1 g ht₀
  obtain ⟨θ₀, y₀, hθ₀_pos, hθ₀_sum, hr₀_pos, h_eval⟩ :=
    test_s3 lam hlam0 hlam1 y₁ y₂ hne
  have h_projS : ∀ (x : EuclideanSpace ℝ (Fin d)) (s : ℝ),
      projSpace (mkSpaceTime x s) = x := by
    intro x s
    ext i
    simp [projSpace, mkSpaceTime]
  have h_projT : ∀ (x : EuclideanSpace ℝ (Fin d)) (s : ℝ),
      projTime (mkSpaceTime x s) = s := by
    intro x s
    simp [projTime, mkSpaceTime]
  rcases lt_or_gt_of_ne h_def_ne with h_lt | h_gt
  · let w₀ : EuclideanSpace ℝ (Fin (d + 1)) → ℝ :=
      fun z => -v₀ (mkSpaceTime (projSpace z) (-projTime z))
    have hw₀_class : InLimitingClassA d (max C₀ 1) w₀ :=
      test_s2 (max C₀ 1) (le_max_left C₀ 1) v₀ hv₀
    refine ⟨w₀, -t₀, 2, θ₀, y₀, hw₀_class, hθ₀_pos, hθ₀_sum, hr₀_pos, ?_⟩
    have h_eq := h_eval (fun x => w₀ (mkSpaceTime x (-t₀)))
    rw [h_eq]
    have h_w : ∀ x : EuclideanSpace ℝ (Fin d), w₀ (mkSpaceTime x (-t₀)) = -g x := by
      intro x
      simp [w₀, g, h_projS, h_projT]
    simp only [h_w]
    linarith
  · have hv₀_max : InLimitingClassA d (max C₀ 1) v₀ := by
      refine ⟨hv₀.1, hv₀.2.1, hv₀.2.2.1, fun x t R hR => ?_⟩
      obtain ⟨p, a, hpa⟩ := hv₀.2.2.2 x t R hR
      exact ⟨p, a, fun h ℓ hℓ hh =>
        le_trans (hpa h ℓ hℓ hh) (mul_le_mul_of_nonneg_right (le_max_left C₀ 1) (le_of_lt hR))⟩
    refine ⟨v₀, t₀, 2, θ₀, y₀, hv₀_max, hθ₀_pos, hθ₀_sum, hr₀_pos, ?_⟩
    have h_eq := h_eval g
    dsimp [g] at h_eq h_gt
    rw [h_eq]
    linarith

theorem extremal_jensen_constant_and_configurations (d : ℕ) (C₁ : ℝ) (hC₁ : 0 ≤ C₁)
    (w₀ : EuclideanSpace ℝ (Fin (d + 1)) → ℝ) (hw₀ : InLimitingClassA d C₁ w₀)
    (t₀ : ℝ) (N₀ : ℕ) (θ₀ : Fin N₀ → ℝ) (y₀ : Fin N₀ → EuclideanSpace ℝ (Fin d))
    (hθ₀_pos : ∀ i, 0 < θ₀ i) (hθ₀_sum : ∑ i, θ₀ i = 1)
    (hr₀_pos : 0 < Real.sqrt (∑ i, θ₀ i * ‖y₀ i - ∑ j, θ₀ j • y₀ j‖ ^ 2))
    (h_def_pos : 0 < (∑ i, θ₀ i * w₀ (mkSpaceTime (y₀ i) t₀)) -
      w₀ (mkSpaceTime (∑ j, θ₀ j • y₀ j) t₀)) :
    ∃ κ : ℝ,
      0 < κ ∧
      HasHorizontalJensenBound d κ w₀ ∧
      ∀ j : ℕ,
        ∃ (t_j : ℝ) (N_j : ℕ) (θ_j : Fin N_j → ℝ) (y_j : Fin N_j → EuclideanSpace ℝ (Fin d)),
          (∀ i, 0 < θ_j i) ∧
          (∑ i, θ_j i = 1) ∧
          0 < Real.sqrt (∑ i, θ_j i * ‖y_j i - ∑ k, θ_j k • y_j k‖ ^ 2) ∧
          (κ - 1 / ((j : ℝ) + 1)) * Real.sqrt (∑ i, θ_j i * ‖y_j i - ∑ k, θ_j k • y_j k‖ ^ 2) ≤
            (∑ i, θ_j i * w₀ (mkSpaceTime (y_j i) t_j)) -
              w₀ (mkSpaceTime (∑ k, θ_j k • y_j k) t_j) :=
by
  
  have h_zero_var : ∀ (t : ℝ) (N : ℕ) (θ : Fin N → ℝ) (y : Fin N → EuclideanSpace ℝ (Fin d)),
      (∀ i, 0 < θ i) → (∑ i, θ i = 1) →
      Real.sqrt (∑ i, θ i * ‖y i - ∑ k, θ k • y k‖ ^ 2) ≤ 0 →
      Real.sqrt (∑ i, θ i * ‖y i - ∑ k, θ k • y k‖ ^ 2) = 0 ∧
      (∑ i, θ i * w₀ (mkSpaceTime (y i) t)) - w₀ (mkSpaceTime (∑ k, θ k • y k) t) = 0 := by
    intro t N θ y hθ_pos hθ_sum hr_le
    set x : EuclideanSpace ℝ (Fin d) := ∑ k, θ k • y k
    set V : ℝ := ∑ i, θ i * ‖y i - x‖ ^ 2
    have hV_nonneg : 0 ≤ V := by
      apply Finset.sum_nonneg
      intro i _
      exact mul_nonneg (le_of_lt (hθ_pos i)) (sq_nonneg _)
    have hr_eq : Real.sqrt V = 0 := le_antisymm hr_le (Real.sqrt_nonneg V)
    have hV_eq : V = 0 := by
      have hsq := Real.sq_sqrt hV_nonneg
      rw [hr_eq] at hsq
      linarith
    have h_terms : ∀ i ∈ (Finset.univ : Finset (Fin N)), θ i * ‖y i - x‖ ^ 2 = 0 := by
      exact (Finset.sum_eq_zero_iff_of_nonneg (fun i _ => mul_nonneg (le_of_lt (hθ_pos i)) (sq_nonneg _))).mp hV_eq
    have hy_eq : ∀ i : Fin N, y i = x := by
      intro i
      have hi := h_terms i (Finset.mem_univ i)
      have h_sq_zero : ‖y i - x‖ ^ 2 = 0 := by
        cases mul_eq_zero.mp hi with
        | inl hθ0 => linarith [hθ_pos i]
        | inr hsq0 => exact hsq0
      have h_norm_zero : ‖y i - x‖ = 0 := sq_eq_zero_iff.mp h_sq_zero
      exact sub_eq_zero.mp (norm_eq_zero.mp h_norm_zero)
    have h_sum_w : (∑ i, θ i * w₀ (mkSpaceTime (y i) t)) = w₀ (mkSpaceTime x t) := by
      calc ∑ i, θ i * w₀ (mkSpaceTime (y i) t)
        _ = ∑ i, θ i * w₀ (mkSpaceTime x t) := by
            refine Finset.sum_congr rfl (fun i _ => ?_)
            rw [hy_eq i]
        _ = (∑ i, θ i) * w₀ (mkSpaceTime x t) := by rw [← Finset.sum_mul]
        _ = w₀ (mkSpaceTime x t) := by rw [hθ_sum, one_mul]
    exact ⟨hr_eq, by linarith⟩
  
  have h_lin_cancel : ∀ (N : ℕ) (θ : Fin N → ℝ) (y : Fin N → EuclideanSpace ℝ (Fin d))
      (p₀ : EuclideanSpace ℝ (Fin d)),
      (∑ i, θ i = 1) →
      ∑ i, θ i * inner ℝ p₀ (y i - ∑ k, θ k • y k) = 0 := by
    intro N θ y p₀ hθ_sum
    set x : EuclideanSpace ℝ (Fin d) := ∑ k, θ k • y k
    have h_step : ∀ i : Fin N,
        θ i * inner ℝ p₀ (y i - x) = inner ℝ p₀ (θ i • y i) - θ i * inner ℝ p₀ x := by
      intro i
      rw [inner_sub_right, real_inner_smul_right]
      ring
    calc ∑ i, θ i * inner ℝ p₀ (y i - x)
      _ = ∑ i, (inner ℝ p₀ (θ i • y i) - θ i * inner ℝ p₀ x) := by
          refine Finset.sum_congr rfl (fun i _ => h_step i)
      _ = (∑ i, inner ℝ p₀ (θ i • y i)) - ∑ i, θ i * inner ℝ p₀ x := by
          rw [Finset.sum_sub_distrib]
      _ = inner ℝ p₀ (∑ i, θ i • y i) - (∑ i, θ i) * inner ℝ p₀ x := by
          rw [← inner_sum, ← Finset.sum_mul]
      _ = inner ℝ p₀ x - 1 * inner ℝ p₀ x := by
          rw [hθ_sum]
      _ = 0 := by ring
  
  have h_two_radius : ∀ (x : EuclideanSpace ℝ (Fin d)) (t r : ℝ), 0 < r →
      ∃ p₀ : EuclideanSpace ℝ (Fin d),
        ∀ h : EuclideanSpace ℝ (Fin d),
          r * (w₀ (mkSpaceTime (x + h) t) - w₀ (mkSpaceTime x t) - inner ℝ p₀ h) ≤
            C₁ * (5 * r ^ 2 + 3 * ‖h‖ ^ 2) := by
    intro x t r hr
    obtain ⟨p₀, a₀, hp₀⟩ := hw₀.2.2.2 x t r hr
    have hp₀_horiz : ∀ u : EuclideanSpace ℝ (Fin d), ‖u‖ ≤ r →
        |w₀ (mkSpaceTime (x + u) t) - w₀ (mkSpaceTime x t) - inner ℝ p₀ u| ≤ C₁ * r := by
      intro u hu
      have h0 : |(0 : ℝ)| ≤ r := by simp [le_of_lt hr]
      have hu0 : ‖u - (0 : ℝ) • p₀‖ ≤ r := by simpa using hu
      have hfit := hp₀ u 0 h0 hu0
      simpa using hfit
    refine ⟨p₀, fun h => ?_⟩
    set R : ℝ := r + ‖h‖
    have h_norm_nonneg : 0 ≤ ‖h‖ := norm_nonneg h
    have hR_pos : 0 < R := by linarith
    obtain ⟨p_R, a_R, hp_R⟩ := hw₀.2.2.2 x t R hR_pos
    have hp_R_horiz : ∀ v : EuclideanSpace ℝ (Fin d), ‖v‖ ≤ R →
        |w₀ (mkSpaceTime (x + v) t) - w₀ (mkSpaceTime x t) - inner ℝ p_R v| ≤ C₁ * R := by
      intro v hv
      have h0 : |(0 : ℝ)| ≤ R := by simp [le_of_lt hR_pos]
      have hv0 : ‖v - (0 : ℝ) • p_R‖ ≤ R := by simpa using hv
      have hfit := hp_R v 0 h0 hv0
      simpa using hfit
    set u : EuclideanSpace ℝ (Fin d) := (r / R) • h
    have hrR_nonneg : 0 ≤ r / R := div_nonneg (le_of_lt hr) (le_of_lt hR_pos)
    have hu_norm : ‖u‖ = (r / R) * ‖h‖ := by
      rw [norm_smul, Real.norm_of_nonneg hrR_nonneg]
    have hu_le_r : ‖u‖ ≤ r := by
      rw [hu_norm]
      have h_le : (r / R) * ‖h‖ ≤ (r / R) * R :=
        mul_le_mul_of_nonneg_left (by linarith) hrR_nonneg
      have h_cancel : (r / R) * R = r := div_mul_cancel₀ r (ne_of_gt hR_pos)
      linarith
    have hu_le_R : ‖u‖ ≤ R := by linarith
    have h_fit_r_u : w₀ (mkSpaceTime (x + u) t) - w₀ (mkSpaceTime x t) - inner ℝ p₀ u ≤ C₁ * r :=
      (abs_le.mp (hp₀_horiz u hu_le_r)).2
    have h_fit_R_u : -(C₁ * R) ≤ w₀ (mkSpaceTime (x + u) t) - w₀ (mkSpaceTime x t) - inner ℝ p_R u :=
      (abs_le.mp (hp_R_horiz u hu_le_R)).1
    have h_diff_u : inner ℝ p_R u - inner ℝ p₀ u ≤ C₁ * (r + R) := by linarith
    have h_inner_u : inner ℝ p_R u - inner ℝ p₀ u = (r / R) * (inner ℝ p_R h - inner ℝ p₀ h) := by
      simp only [u, real_inner_smul_right]
      ring
    rw [h_inner_u] at h_diff_u
    have h_mul_R : R * ((r / R) * (inner ℝ p_R h - inner ℝ p₀ h)) ≤ R * (C₁ * (r + R)) :=
      mul_le_mul_of_nonneg_left h_diff_u (le_of_lt hR_pos)
    have h_R_cancel : R * ((r / R) * (inner ℝ p_R h - inner ℝ p₀ h)) =
        r * (inner ℝ p_R h - inner ℝ p₀ h) := by
      calc R * ((r / R) * (inner ℝ p_R h - inner ℝ p₀ h))
        _ = (R * (r / R)) * (inner ℝ p_R h - inner ℝ p₀ h) := by ring
        _ = r * (inner ℝ p_R h - inner ℝ p₀ h) := by rw [mul_div_cancel₀ r (ne_of_gt hR_pos)]
    rw [h_R_cancel] at h_mul_R
    have hh_le_R : ‖h‖ ≤ R := by linarith
    have h_fit_R_h : w₀ (mkSpaceTime (x + h) t) - w₀ (mkSpaceTime x t) - inner ℝ p_R h ≤ C₁ * R :=
      (abs_le.mp (hp_R_horiz h hh_le_R)).2
    have h_mul_r : r * (w₀ (mkSpaceTime (x + h) t) - w₀ (mkSpaceTime x t) - inner ℝ p_R h) ≤
        r * (C₁ * R) :=
      mul_le_mul_of_nonneg_left h_fit_R_h (le_of_lt hr)
    have h_comb : r * (w₀ (mkSpaceTime (x + h) t) - w₀ (mkSpaceTime x t) - inner ℝ p₀ h) ≤
        C₁ * (3 * r ^ 2 + 4 * r * ‖h‖ + ‖h‖ ^ 2) := by
      have h_alg : C₁ * (3 * r ^ 2 + 4 * r * ‖h‖ + ‖h‖ ^ 2) =
          R * (C₁ * (r + R)) + r * (C₁ * R) := by
        simp only [R]
        ring
      linarith
    have h_sq : 0 ≤ C₁ * (2 * (r - ‖h‖) ^ 2) :=
      mul_nonneg hC₁ (mul_nonneg (by norm_num) (sq_nonneg (r - ‖h‖)))
    linarith
  
  have hw₀_8C₁ : HasHorizontalJensenBound d (8 * C₁) w₀ := by
    intro t N θ y hθ_pos hθ_sum
    dsimp only
    set x : EuclideanSpace ℝ (Fin d) := ∑ i, θ i • y i
    set r : ℝ := Real.sqrt (∑ i, θ i * ‖y i - x‖ ^ 2)
    by_cases hr : r ≤ 0
    · obtain ⟨hr_eq, h_def_eq⟩ := h_zero_var t N θ y hθ_pos hθ_sum hr
      change r = 0 at hr_eq
      change (∑ i, θ i * w₀ (mkSpaceTime (y i) t)) - w₀ (mkSpaceTime x t) = 0 at h_def_eq
      change (∑ i, θ i * w₀ (mkSpaceTime (y i) t)) - w₀ (mkSpaceTime x t) ≤ (8 * C₁) * r
      rw [hr_eq, h_def_eq, mul_zero]
    · push_neg at hr
      obtain ⟨p₀, hp₀⟩ := h_two_radius x t r hr
      have h_pt : ∀ i : Fin N,
          θ i * (r * (w₀ (mkSpaceTime (y i) t) - w₀ (mkSpaceTime x t) - inner ℝ p₀ (y i - x))) ≤
            θ i * (C₁ * (5 * r ^ 2 + 3 * ‖y i - x‖ ^ 2)) := by
        intro i
        have hi := hp₀ (y i - x)
        rw [add_sub_cancel] at hi
        exact mul_le_mul_of_nonneg_left hi (le_of_lt (hθ_pos i))
      have h_sum_le :
          ∑ i, θ i * (r * (w₀ (mkSpaceTime (y i) t) - w₀ (mkSpaceTime x t) - inner ℝ p₀ (y i - x))) ≤
            ∑ i, θ i * (C₁ * (5 * r ^ 2 + 3 * ‖y i - x‖ ^ 2)) :=
        Finset.sum_le_sum (fun i _ => h_pt i)
      have h_lhs :
          ∑ i, θ i * (r * (w₀ (mkSpaceTime (y i) t) - w₀ (mkSpaceTime x t) - inner ℝ p₀ (y i - x))) =
            r * ((∑ i, θ i * w₀ (mkSpaceTime (y i) t)) - (∑ i, θ i) * w₀ (mkSpaceTime x t) -
              ∑ i, θ i * inner ℝ p₀ (y i - x)) := by
        calc ∑ i, θ i * (r * (w₀ (mkSpaceTime (y i) t) - w₀ (mkSpaceTime x t) - inner ℝ p₀ (y i - x)))
          _ = r * ∑ i, (θ i * w₀ (mkSpaceTime (y i) t) - θ i * w₀ (mkSpaceTime x t) -
                θ i * inner ℝ p₀ (y i - x)) := by
              rw [Finset.mul_sum]
              refine Finset.sum_congr rfl (fun i _ => by ring)
          _ = r * ((∑ i, θ i * w₀ (mkSpaceTime (y i) t)) - (∑ i, θ i) * w₀ (mkSpaceTime x t) -
                ∑ i, θ i * inner ℝ p₀ (y i - x)) := by
              rw [Finset.sum_sub_distrib, Finset.sum_sub_distrib, ← Finset.sum_mul]
      have h_lin0 : ∑ i, θ i * inner ℝ p₀ (y i - x) = 0 := h_lin_cancel N θ y p₀ hθ_sum
      rw [hθ_sum, one_mul, h_lin0, sub_zero] at h_lhs
      have hV_nonneg : 0 ≤ ∑ i, θ i * ‖y i - x‖ ^ 2 :=
        Finset.sum_nonneg (fun i _ => mul_nonneg (le_of_lt (hθ_pos i)) (sq_nonneg _))
      have hr_sq : ∑ i, θ i * ‖y i - x‖ ^ 2 = r ^ 2 := (Real.sq_sqrt hV_nonneg).symm
      have h_rhs :
          ∑ i, θ i * (C₁ * (5 * r ^ 2 + 3 * ‖y i - x‖ ^ 2)) = r * ((8 * C₁) * r) := by
        calc ∑ i, θ i * (C₁ * (5 * r ^ 2 + 3 * ‖y i - x‖ ^ 2))
          _ = ∑ i, (C₁ * 5 * r ^ 2 * θ i + C₁ * 3 * (θ i * ‖y i - x‖ ^ 2)) := by
              refine Finset.sum_congr rfl (fun i _ => by ring)
          _ = C₁ * 5 * r ^ 2 * (∑ i, θ i) + C₁ * 3 * (∑ i, θ i * ‖y i - x‖ ^ 2) := by
              rw [Finset.sum_add_distrib, ← Finset.mul_sum, ← Finset.mul_sum]
          _ = C₁ * 5 * r ^ 2 * 1 + C₁ * 3 * r ^ 2 := by rw [hθ_sum, hr_sq]
          _ = r * ((8 * C₁) * r) := by ring
      rw [h_lhs, h_rhs] at h_sum_le
      exact le_of_mul_le_mul_left h_sum_le hr
  
  let S : Set ℝ := { κ' : ℝ | HasHorizontalJensenBound d κ' w₀ }
  let κ : ℝ := sInf S
  have hS_ne : S.Nonempty := ⟨8 * C₁, hw₀_8C₁⟩
  set x₀ : EuclideanSpace ℝ (Fin d) := ∑ j, θ₀ j • y₀ j
  set r₀ : ℝ := Real.sqrt (∑ i, θ₀ i * ‖y₀ i - x₀‖ ^ 2)
  set D₀ : ℝ := (∑ i, θ₀ i * w₀ (mkSpaceTime (y₀ i) t₀)) - w₀ (mkSpaceTime x₀ t₀)
  have hS_lb : ∀ κ' ∈ S, D₀ / r₀ ≤ κ' := by
    intro κ' hκ'
    have h_bound := hκ' t₀ N₀ θ₀ y₀ hθ₀_pos hθ₀_sum
    dsimp only at h_bound
    exact (div_le_iff₀ hr₀_pos).mpr h_bound
  have hS_bdd : BddBelow S := ⟨D₀ / r₀, hS_lb⟩
  have hκ_ge : D₀ / r₀ ≤ κ := le_csInf hS_ne hS_lb
  have hD₀_div_pos : 0 < D₀ / r₀ := div_pos h_def_pos hr₀_pos
  have hκ_pos : 0 < κ := lt_of_lt_of_le hD₀_div_pos hκ_ge
  have hw₀_jensen : HasHorizontalJensenBound d κ w₀ := by
    intro t N θ y hθ_pos hθ_sum
    dsimp only
    set x : EuclideanSpace ℝ (Fin d) := ∑ i, θ i • y i
    set r : ℝ := Real.sqrt (∑ i, θ i * ‖y i - x‖ ^ 2)
    set D : ℝ := (∑ i, θ i * w₀ (mkSpaceTime (y i) t)) - w₀ (mkSpaceTime x t)
    by_cases hr : r ≤ 0
    · obtain ⟨hr_eq, hD_eq⟩ := h_zero_var t N θ y hθ_pos hθ_sum hr
      change r = 0 at hr_eq
      change D = 0 at hD_eq
      change D ≤ κ * r
      rw [hr_eq, hD_eq, mul_zero]
    · push_neg at hr
      have h_lb : ∀ κ' ∈ S, D / r ≤ κ' := by
        intro κ' hκ'
        have h_bound := hκ' t N θ y hθ_pos hθ_sum
        dsimp only at h_bound
        exact (div_le_iff₀ hr).mpr h_bound
      have h_le_κ : D / r ≤ κ := le_csInf hS_ne h_lb
      exact (div_le_iff₀ hr).mp h_le_κ
  have h_configs : ∀ j : ℕ,
      ∃ (t_j : ℝ) (N_j : ℕ) (θ_j : Fin N_j → ℝ) (y_j : Fin N_j → EuclideanSpace ℝ (Fin d)),
        (∀ i, 0 < θ_j i) ∧
        (∑ i, θ_j i = 1) ∧
        0 < Real.sqrt (∑ i, θ_j i * ‖y_j i - ∑ k, θ_j k • y_j k‖ ^ 2) ∧
        (κ - 1 / ((j : ℝ) + 1)) * Real.sqrt (∑ i, θ_j i * ‖y_j i - ∑ k, θ_j k • y_j k‖ ^ 2) ≤
          (∑ i, θ_j i * w₀ (mkSpaceTime (y_j i) t_j)) -
            w₀ (mkSpaceTime (∑ k, θ_j k • y_j k) t_j) := by
    intro j
    set ε_j : ℝ := min (κ / 2) (1 / ((j : ℝ) + 1))
    have hj_pos : 0 < (j : ℝ) + 1 := by positivity
    have hε_pos : 0 < ε_j := lt_min (by linarith) (div_pos zero_lt_one hj_pos)
    have h_lt_κ : κ - ε_j < κ := by linarith
    have h_not_mem : κ - ε_j ∉ S := notMem_of_lt_csInf h_lt_κ hS_bdd
    change ¬ HasHorizontalJensenBound d (κ - ε_j) w₀ at h_not_mem
    unfold HasHorizontalJensenBound at h_not_mem
    push_neg at h_not_mem
    obtain ⟨t_j, N_j, θ_j, y_j, hθ_j_pos, hθ_j_sum, h_viol⟩ := h_not_mem
    set x_j : EuclideanSpace ℝ (Fin d) := ∑ k, θ_j k • y_j k
    set r_j : ℝ := Real.sqrt (∑ i, θ_j i * ‖y_j i - x_j‖ ^ 2)
    set D_j : ℝ := (∑ i, θ_j i * w₀ (mkSpaceTime (y_j i) t_j)) - w₀ (mkSpaceTime x_j t_j)
    change ¬ (D_j ≤ (κ - ε_j) * r_j) at h_viol
    push_neg at h_viol
    have hr_j_pos : 0 < r_j := by
      by_contra hr_le
      push_neg at hr_le
      obtain ⟨hr_eq, hD_eq⟩ := h_zero_var t_j N_j θ_j y_j hθ_j_pos hθ_j_sum hr_le
      change r_j = 0 at hr_eq
      change D_j = 0 at hD_eq
      rw [hr_eq, hD_eq, mul_zero] at h_viol
      exact lt_irrefl 0 h_viol
    have hε_le : ε_j ≤ 1 / ((j : ℝ) + 1) := min_le_right (κ / 2) (1 / ((j : ℝ) + 1))
    have h_coeff : κ - 1 / ((j : ℝ) + 1) ≤ κ - ε_j := by linarith
    have h_mul : (κ - 1 / ((j : ℝ) + 1)) * r_j ≤ (κ - ε_j) * r_j :=
      mul_le_mul_of_nonneg_right h_coeff (le_of_lt hr_j_pos)
    exact ⟨t_j, N_j, θ_j, y_j, hθ_j_pos, hθ_j_sum, hr_j_pos, le_trans h_mul (le_of_lt h_viol)⟩
  exact ⟨κ, hκ_pos, hw₀_jensen, h_configs⟩

theorem sheared_frame_fits_and_centering : ∀ (d : ℕ) (C₁ : ℝ) (w₀ : EuclideanSpace ℝ (Fin (d + 1)) → ℝ),
      Continuous w₀ →
      (∀ (x : EuclideanSpace ℝ (Fin d)) (t R' : ℝ), 0 < R' →
        ∃ (p : EuclideanSpace ℝ (Fin d)) (a : ℝ), IsFitAt d C₁ w₀ x t R' p a) →
      ∀ (x₀ p₀ : EuclideanSpace ℝ (Fin d)) (t₀ R a₀ : ℝ),
        0 < R → IsFitAt d C₁ w₀ x₀ t₀ R p₀ a₀ →
        let v := shearedFrameTransform d w₀ x₀ t₀ R p₀ a₀
        Continuous v ∧
        IsCenteredAt d C₁ v 0 1 ∧
        (∀ (y_c : EuclideanSpace ℝ (Fin d)) (s_c ρ : ℝ), 0 < ρ →
          ∃ (p' : EuclideanSpace ℝ (Fin d)) (a' : ℝ), IsFitAt d C₁ v y_c s_c ρ p' a') :=
by
  intro d C₁ w₀ hw₀ hw₀_fits x₀ p₀ t₀ R a₀ hR h_fit₀ v
  have h_projSpace : ∀ (x : EuclideanSpace ℝ (Fin d)) (t : ℝ),
      projSpace (mkSpaceTime x t) = x := by
    intro x t
    ext i
    simp [projSpace, mkSpaceTime]
  have h_projTime : ∀ (x : EuclideanSpace ℝ (Fin d)) (t : ℝ),
      projTime (mkSpaceTime x t) = t := by
    intro x t
    simp [projTime, mkSpaceTime]
  have hc_projSpace : Continuous (projSpace (d := d)) := by
    unfold projSpace
    fun_prop
  have hc_projTime : Continuous (projTime (d := d)) := by
    unfold projTime
    fun_prop
  have hc_mkSpaceTime :
      Continuous (fun p : EuclideanSpace ℝ (Fin d) × ℝ => mkSpaceTime p.1 p.2) := by
    unfold mkSpaceTime
    apply Continuous.comp (ContinuousLinearEquiv.continuous _)
    rw [continuous_pi_iff]
    intro j
    refine Fin.lastCases ?_ ?_ j
    · simp only [Fin.snoc_last]
      exact continuous_snd
    · intro i
      simp only [Fin.snoc_castSucc]
      exact (PiLp.continuous_apply 2 _ i).comp continuous_fst
  have hv_cont : Continuous v := by
    have h_arg : Continuous (fun z : EuclideanSpace ℝ (Fin (d + 1)) =>
        (x₀ + R • (projSpace z + (projTime z - 1) • p₀),
          t₀ + R * (projTime z - 1))) := by
      fun_prop
    have h1 : Continuous (fun z : EuclideanSpace ℝ (Fin (d + 1)) =>
        w₀ (mkSpaceTime (x₀ + R • (projSpace z + (projTime z - 1) • p₀))
          (t₀ + R * (projTime z - 1)))) :=
      hw₀.comp (hc_mkSpaceTime.comp h_arg)
    change Continuous (shearedFrameTransform d w₀ x₀ t₀ R p₀ a₀)
    unfold shearedFrameTransform
    dsimp only
    fun_prop
  have h_cov : ∀ (y_c : EuclideanSpace ℝ (Fin d)) (s_c ρ : ℝ)
      (p : EuclideanSpace ℝ (Fin d)) (a : ℝ),
      IsFitAt d C₁ w₀ (x₀ + R • (y_c + (s_c - 1) • p₀)) (t₀ + R * (s_c - 1)) (R * ρ) p a →
      IsFitAt d C₁ v y_c s_c ρ (p - p₀) (a - a₀) := by
    intro y_c s_c ρ p a h_fit h ℓ hℓ hh
    let x_c : EuclideanSpace ℝ (Fin d) := x₀ + R • (y_c + (s_c - 1) • p₀)
    let t_c : ℝ := t₀ + R * (s_c - 1)
    let H : EuclideanSpace ℝ (Fin d) := R • (h + ℓ • p₀)
    let L : ℝ := R * ℓ
    have hL : |L| ≤ R * ρ := by
      dsimp [L]
      rw [abs_mul, abs_of_pos hR]
      exact mul_le_mul_of_nonneg_left hℓ (le_of_lt hR)
    have hH_eq : H - L • p = R • (h - ℓ • (p - p₀)) := by
      dsimp [H, L]
      module
    have hH : ‖H - L • p‖ ≤ R * ρ := by
      rw [hH_eq, norm_smul, Real.norm_eq_abs, abs_of_pos hR]
      exact mul_le_mul_of_nonneg_left hh (le_of_lt hR)
    have h_bound := h_fit H L hL hH
    have hx_shift : x₀ + R • ((y_c + h) + (s_c + ℓ - 1) • p₀) = x_c + H := by
      dsimp [x_c, H]
      module
    have ht_shift : t₀ + R * (s_c + ℓ - 1) = t_c + L := by
      dsimp [t_c, L]
      ring
    have h_inner_H : inner ℝ p H = R * (inner ℝ p h + ℓ * inner ℝ p p₀) := by
      dsimp [H]
      rw [real_inner_smul_right, inner_add_right, real_inner_smul_right]
    have h_inner_y : inner ℝ p₀ (y_c + h) = inner ℝ p₀ y_c + inner ℝ p₀ h :=
      inner_add_right p₀ y_c h
    have h_inner_sub : inner ℝ (p - p₀) h = inner ℝ p h - inner ℝ p₀ h :=
      inner_sub_left p p₀ h
    have h_norm_sub : ‖p - p₀‖ ^ 2 = ‖p‖ ^ 2 - 2 * inner ℝ p p₀ + ‖p₀‖ ^ 2 :=
      norm_sub_sq_real p p₀
    have hR_ne : R ≠ 0 := ne_of_gt hR
    have h_rem :
        v (mkSpaceTime (y_c + h) (s_c + ℓ)) - v (mkSpaceTime y_c s_c) -
          inner ℝ (p - p₀) h - (a - a₀ - ‖p - p₀‖ ^ 2 / 2) * ℓ =
        (w₀ (mkSpaceTime (x_c + H) (t_c + L)) - w₀ (mkSpaceTime x_c t_c) -
          inner ℝ p H - (a - ‖p‖ ^ 2 / 2) * L) / R := by
      change shearedFrameTransform d w₀ x₀ t₀ R p₀ a₀ (mkSpaceTime (y_c + h) (s_c + ℓ)) -
          shearedFrameTransform d w₀ x₀ t₀ R p₀ a₀ (mkSpaceTime y_c s_c) -
          inner ℝ (p - p₀) h - (a - a₀ - ‖p - p₀‖ ^ 2 / 2) * ℓ =
        (w₀ (mkSpaceTime (x_c + H) (t_c + L)) - w₀ (mkSpaceTime x_c t_c) -
          inner ℝ p H - (a - ‖p‖ ^ 2 / 2) * L) / R
      unfold shearedFrameTransform
      dsimp only
      rw [h_projSpace (y_c + h) (s_c + ℓ), h_projTime (y_c + h) (s_c + ℓ),
        h_projSpace y_c s_c, h_projTime y_c s_c, hx_shift, ht_shift]
      change (w₀ (mkSpaceTime (x_c + H) (t_c + L)) - w₀ (mkSpaceTime x₀ t₀)) / R -
          inner ℝ p₀ (y_c + h) - (a₀ + ‖p₀‖ ^ 2 / 2) * (s_c + ℓ - 1) -
          ((w₀ (mkSpaceTime x_c t_c) - w₀ (mkSpaceTime x₀ t₀)) / R -
            inner ℝ p₀ y_c - (a₀ + ‖p₀‖ ^ 2 / 2) * (s_c - 1)) -
          inner ℝ (p - p₀) h - (a - a₀ - ‖p - p₀‖ ^ 2 / 2) * ℓ =
        (w₀ (mkSpaceTime (x_c + H) (t_c + L)) - w₀ (mkSpaceTime x_c t_c) -
          inner ℝ p H - (a - ‖p‖ ^ 2 / 2) * (R * ℓ)) / R
      rw [h_inner_y, h_inner_sub, h_norm_sub, h_inner_H]
      field_simp [hR_ne]
      ring
    rw [h_rem, abs_div, abs_of_pos hR, div_le_iff₀ hR]
    calc |w₀ (mkSpaceTime (x_c + H) (t_c + L)) - w₀ (mkSpaceTime x_c t_c) -
          inner ℝ p H - (a - ‖p‖ ^ 2 / 2) * L|
      _ ≤ C₁ * (R * ρ) := h_bound
      _ = C₁ * ρ * R := by ring
  have hv_01 : v (mkSpaceTime 0 1) = 0 := by
    change shearedFrameTransform d w₀ x₀ t₀ R p₀ a₀ (mkSpaceTime 0 1) = 0
    unfold shearedFrameTransform
    dsimp only
    rw [h_projSpace 0 1, h_projTime 0 1]
    simp
  have hv_fit01 : IsFitAt d C₁ v 0 1 1 0 0 := by
    have h_fit₀' : IsFitAt d C₁ w₀ (x₀ + R • (0 + ((1 : ℝ) - 1) • p₀)) (t₀ + R * (1 - 1)) (R * 1) p₀ a₀ := by
      simpa using h_fit₀
    have h_cov01 := h_cov 0 1 1 p₀ a₀ h_fit₀'
    simpa using h_cov01
  have hv_fits : ∀ (y_c : EuclideanSpace ℝ (Fin d)) (s_c ρ : ℝ), 0 < ρ →
      ∃ (p' : EuclideanSpace ℝ (Fin d)) (a' : ℝ), IsFitAt d C₁ v y_c s_c ρ p' a' := by
    intro y_c s_c ρ hρ
    obtain ⟨p, a, h_fit⟩ := hw₀_fits (x₀ + R • (y_c + (s_c - 1) • p₀)) (t₀ + R * (s_c - 1)) (R * ρ) (mul_pos hR hρ)
    exact ⟨p - p₀, a - a₀, h_cov y_c s_c ρ p a h_fit⟩
  exact ⟨hv_cont, ⟨hv_01, hv_fit01⟩, hv_fits⟩

theorem sheared_frame_viscosity_covariance : ∀ (d : ℕ) (C₁ : ℝ) (w₀ : EuclideanSpace ℝ (Fin (d + 1)) → ℝ),
      InLimitingClassA d C₁ w₀ →
      ∀ (x₀ p₀ : EuclideanSpace ℝ (Fin d)) (t₀ R a₀ : ℝ),
