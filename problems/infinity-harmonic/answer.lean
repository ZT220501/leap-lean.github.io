    have hp_k := (hpa_exp k).1
    have ha_k := (hpa_exp k).2
    have hT₁_pk : T₁ * ‖p k‖ ≤ (2 : ℝ) ^ n := by nlinarith
    have hT₁_ak : T₁ * |a k| ≤ (2 : ℝ) ^ n := by nlinarith
    have hB54_ge_1 : 1 ≤ B₀ * (5 / 4 : ℝ) ^ k := by nlinarith
    have hT₁_le_2n : T₁ ≤ (2 : ℝ) ^ n := by nlinarith
    have h_coef_bound : (3 / 2 : ℝ) * ‖p k‖ + 1 + 2 * C₁ ≤ (ε / 4) * (2 : ℝ) ^ n := by
      have h_step1 : (3 / 2 : ℝ) * ‖p k‖ + 1 + 2 * C₁ ≤
