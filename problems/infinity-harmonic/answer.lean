      rw [norm_sub_sq_real, norm_sub_sq_real, real_inner_smul_right, real_inner_smul_right,
        norm_smul, norm_smul, Real.norm_eq_abs, Real.norm_eq_abs, h_n_hat_norm, mul_one, mul_one,
        sq_abs, sq_abs]
      ring
    have h_sq_le : ‖u - (inner ℝ u n_hat) • n_hat‖ ^ 2 ≤ ‖u - α • n_hat‖ ^ 2 := by
