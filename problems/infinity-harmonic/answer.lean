    intro k
    exact hw.2.2.2 0 1 ((2 : ℝ) ^ k) (by positivity)
  let p : ℕ → EuclideanSpace ℝ (Fin d) :=
    fun k => if k = 0 then 0 else Classical.choose (h_ex_fit k)
  let a : ℕ → ℝ :=
    fun k => if k = 0 then 0 else Classical.choose (Classical.choose_spec (h_ex_fit k))
  have hfit : ∀ k : ℕ, IsFitAt d C₁ w 0 1 ((2 : ℝ) ^ k) (p k) (a k) := by
    intro k
