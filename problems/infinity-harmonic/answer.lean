    ring
  have h_Pt_ident : ‖P‖ - P_t = (1 / 2) * ‖P‖ * ‖n_hat - e_b‖ ^ 2 := by
    rw [h_norm_diff_sq]
    have h_mul : ‖P‖ * ((‖P‖⁻¹) * P_t) = P_t := mul_inv_cancel_left₀ hP_ne P_t
    linarith
  have h_dir_sq : ‖n_hat - e_b‖ ^ 2 ≤ 32 * B ^ 2 * lam := by
    have h1 : ‖n_hat - e_b‖ ^ 2 ≤ (B * Real.sqrt (32 * lam)) ^ 2 :=
      sq_le_sq' (by linarith [norm_nonneg (n_hat - e_b)]) h_dir_hat
    have h2 : (B * Real.sqrt (32 * lam)) ^ 2 = B ^ 2 * (Real.sqrt (32 * lam)) ^ 2 := by ring
    rw [h2, Real.sq_sqrt (by linarith)] at h1
    linarith
  have h_Pt_norm_diff : |P_t - ‖P‖| ≤ 16 * (L + 1) * B ^ 2 * lam := by
    rw [abs_sub_comm]
    have h_nonneg : 0 ≤ ‖P‖ - P_t := by
      rw [h_Pt_ident]
      positivity
    rw [abs_of_nonneg h_nonneg, h_Pt_ident]
    have h1 : (1 / 2) * ‖P‖ * ‖n_hat - e_b‖ ^ 2 ≤ (1 / 2) * (L + 1) * (32 * B ^ 2 * lam) := by
      have ha : (1 / 2) * ‖P‖ ≤ (1 / 2) * (L + 1) := by linarith
      exact mul_le_mul ha h_dir_sq (sq_nonneg _) (by linarith)
    linarith
  have h_Pt_c_diff : |P_t - c| ≤ (16 * (L + 1) * B ^ 2 + 32 * B) * lam := by
    have h_tri := abs_sub_le P_t ‖P‖ c
    linarith
  set p' : EuclideanSpace ℝ (Fin d) := (c * Real.sqrt lam)⁻¹ • P_x
  set q' : ℝ := (P_t - c) / (c * lam)
  have hp'_bound : ‖p'‖ ≤ 2 * Real.sqrt 32 * (L + 1) * B := by
    have h_cs_pos : 0 < c * Real.sqrt lam := mul_pos hc_pos hsqrt_pos
    have h_lhs : (c * Real.sqrt lam) * ‖p'‖ = ‖P_x‖ := by
      dsimp [p']
      rw [norm_smul, Real.norm_of_nonneg (inv_nonneg.mpr (le_of_lt h_cs_pos)),
        mul_inv_cancel_left₀ (ne_of_gt h_cs_pos)]
    have h_rhs : ‖P_x‖ ≤ (c * Real.sqrt lam) * (2 * Real.sqrt 32 * (L + 1) * B) := by
      have h1 : (1 / 2) * Real.sqrt lam ≤ c * Real.sqrt lam :=
        mul_le_mul_of_nonneg_right hc_lower (le_of_lt hsqrt_pos)
      have h2 : 0 ≤ 2 * Real.sqrt 32 * (L + 1) * B := by positivity
      have h3 := mul_le_mul_of_nonneg_right h1 h2
      linarith
    exact le_of_mul_le_mul_left (h_lhs.trans_le h_rhs) h_cs_pos
  have hq'_bound : |q'| ≤ 32 * (L + 1) * B ^ 2 + 64 * B := by
    have h_cl_pos : 0 < c * lam := mul_pos hc_pos hlam_pos
    have h_lhs : (c * lam) * |q'| = |P_t - c| := by
      dsimp [q']
      rw [abs_div, abs_of_pos h_cl_pos, mul_div_cancel₀ _ (ne_of_gt h_cl_pos)]
    have h_rhs : |P_t - c| ≤ (c * lam) * (32 * (L + 1) * B ^ 2 + 64 * B) := by
      have h1 : (1 / 2) * lam ≤ c * lam :=
        mul_le_mul_of_nonneg_right hc_lower (le_of_lt hlam_pos)
      have h2 : 0 ≤ 32 * (L + 1) * B ^ 2 + 64 * B := by positivity
      have h3 := mul_le_mul_of_nonneg_right h1 h2
      linarith
    exact le_of_mul_le_mul_left (h_lhs.trans_le h_rhs) h_cl_pos
  have hpq_bound : ‖p'‖ + |q'| ≤ C_BL := by
    dsimp [C_BL]
    linarith
  have hC_BL_nonneg : 0 ≤ C_BL := by
    have := norm_nonneg p'
    have := abs_nonneg q'
    linarith
  have hq'_le_sq : |q'| ≤ (C_BL + 1) ^ 2 := by
    have : |q'| ≤ C_BL := by linarith [norm_nonneg p']
    nlinarith [sq_nonneg C_BL]
  have h_lam_q_abs : lam * |q'| ≤ 1 / 64 := by
    have h1 : lam * |q'| ≤ lam * (C_BL + 1) ^ 2 :=
      mul_le_mul_of_nonneg_left hq'_le_sq (le_of_lt hlam_pos)
    exact h1.trans hlam_small
  set A : ℝ := 1 + lam * q'
  have hA_ge_34 : 3 / 4 ≤ A := by
    have h1 : -|q'| ≤ q' := neg_abs_le q'
    have h2 : -(lam * |q'|) ≤ lam * q' := by nlinarith
    dsimp [A]
    linarith
  have hA_ge_half : 1 / 2 ≤ A := by linarith
  have hA_pos : 0 < A := by linarith
  have hA_ne : A ≠ 0 := ne_of_gt hA_pos
  have h_sqrt_p_le : Real.sqrt lam * ‖p'‖ ≤ 1 / 8 := by
    have hp_le : ‖p'‖ ≤ C_BL + 1 := by linarith [abs_nonneg q']
    have hp_sq : ‖p'‖ ^ 2 ≤ (C_BL + 1) ^ 2 :=
      sq_le_sq' (by linarith [norm_nonneg p']) hp_le
    have hsq : (Real.sqrt lam * ‖p'‖) ^ 2 ≤ (1 / 8 : ℝ) ^ 2 := by
      have h1 : (Real.sqrt lam * ‖p'‖) ^ 2 = lam * ‖p'‖ ^ 2 := by
        calc (Real.sqrt lam * ‖p'‖) ^ 2 = (Real.sqrt lam) ^ 2 * ‖p'‖ ^ 2 := by ring
          _ = lam * ‖p'‖ ^ 2 := by rw [Real.sq_sqrt (le_of_lt hlam_pos)]
      have h2 : lam * ‖p'‖ ^ 2 ≤ lam * (C_BL + 1) ^ 2 :=
        mul_le_mul_of_nonneg_left hp_sq (le_of_lt hlam_pos)
      linarith
    exact (abs_le_of_sq_le_sq' hsq (by norm_num)).2
  set Q : EuclideanSpace ℝ (Fin (d + 1)) := mkSpaceTime (Real.sqrt lam • p') A
  set N : ℝ := ‖Q‖
  have h_c_sqrt_p : c • (Real.sqrt lam • p') = P_x := by
    dsimp [p']
    rw [smul_smul, smul_smul, mul_inv_cancel₀ (mul_ne_zero hc_ne hsqrt_ne), one_smul]
  have h_c_A : c * A = P_t := by
    dsimp [A, q']
    field_simp [hc_ne, ne_of_gt hlam_pos]
