    have h_cancel_high : a' - a - ‖p' - p‖ ^ 2 / 2 ≤ 3 * C₁ * (1 + 3 * C₁) :=
      le_of_mul_le_mul_right h_bd_high hℓ_pos
    have h_sq_le : ‖p' - p‖ ^ 2 ≤ 9 * C₁ ^ 2 := by
      have h_nn : 0 ≤ ‖p' - p‖ := norm_nonneg _
      nlinarith
    have h_sq_nn : 0 ≤ ‖p' - p‖ ^ 2 := sq_nonneg _
    rw [abs_le]
    constructor <;> linarith
  let B₁ : ℝ := 3 * C₁ * (1 + 3 * C₁) + (9 / 2) * C₁ ^ 2
  have h3C₁_le_B₁ : 3 * C₁ ≤ B₁ := by
    dsimp [B₁]
    nlinarith
  have hB₁_ge_one : 1 ≤ B₁ := by linarith
  let B₀ : ℝ := 4 * B₁
  let T₁ : ℝ := T + 1
  have hB₀_ge_4 : 4 ≤ B₀ := by dsimp [B₀]; linarith
  have hT₁_ge_one : 1 ≤ T₁ := by dsimp [T₁]; linarith
  let K_req : ℝ := (5 / 4 : ℝ) * max (T₁ * B₀) ((4 / ε) * ((3 / 2 : ℝ) * B₀ + 1 + 2 * C₁))
