    have h_le : ‖τ • w₂‖ ≤ δ - ‖ξ_bar₂‖ := le_of_lt (lt_of_lt_of_le hτ_w₂_lt (min_le_left _ _))
    linarith
  have hτ_cb₃ : ξ_bar₃ + τ • w₃ ∈ Metric.closedBall (0 : EuclideanSpace ℝ (Fin (d + 1))) δ := by
    rw [Metric.mem_closedBall, dist_zero_right]
    have h_tri := norm_add_le ξ_bar₃ (τ • w₃)
    have h_le : ‖τ • w₃‖ ≤ δ - ‖ξ_bar₃‖ := le_of_lt (lt_of_lt_of_le hτ_w₃_lt (min_le_left _ _))
    linarith
  have hτ_test₁ : ξ_bar₁ + τ • w₁ ∈ Metric.ball ξ_bar₁ δ_test₁ := by
    rw [Metric.mem_ball, dist_eq_norm, add_sub_cancel_left]
    exact lt_of_lt_of_le hτ_w₁_lt (min_le_right _ _)
  have hτ_test₂ : ξ_bar₂ + τ • w₂ ∈ Metric.ball ξ_bar₂ δ_test₂ := by
    rw [Metric.mem_ball, dist_eq_norm, add_sub_cancel_left]
    exact lt_of_lt_of_le hτ_w₂_lt (min_le_right _ _)
  have hτ_test₃ : ξ_bar₃ + τ • w₃ ∈ Metric.ball ξ_bar₃ δ_test₃ := by
    rw [Metric.mem_ball, dist_eq_norm, add_sub_cancel_left]
    exact lt_of_lt_of_le hτ_w₃_lt (min_le_right _ _)
  have ht_low₁ : τ ^ 2 * ((1 / 2 : ℝ) * inner ℝ (X₁ w₁) w₁ - (κ / 2) * ‖w₁‖ ^ 2) ≤
      u_hat₁ (ξ_bar₁ + τ • w₁) - u_hat₁ ξ_bar₁ - inner ℝ q₁ (τ • w₁) := by
    have ht := (abs_le.mp (htaylor₁ (ξ_bar₁ + τ • w₁) hτ_test₁)).1
    rw [add_sub_cancel_left] at ht
    have h_quad_eq : (1 / 2 : ℝ) * inner ℝ (X₁ (τ • w₁)) (τ • w₁) =
        τ ^ 2 * ((1 / 2 : ℝ) * inner ℝ (X₁ w₁) w₁) := by
      rw [map_smul, inner_smul_left, inner_smul_right, RCLike.conj_to_real]
      ring
    have h_norm_eq : (κ / 2) * ‖τ • w₁‖ ^ 2 = τ ^ 2 * ((κ / 2) * ‖w₁‖ ^ 2) := by
      rw [norm_smul, Real.norm_eq_abs, mul_pow, sq_abs]
      ring
    linarith
  have ht_low₂ : τ ^ 2 * ((1 / 2 : ℝ) * inner ℝ (X₂ w₂) w₂ - (κ / 2) * ‖w₂‖ ^ 2) ≤
      u_hat₂ (ξ_bar₂ + τ • w₂) - u_hat₂ ξ_bar₂ - inner ℝ q₂ (τ • w₂) := by
    have ht := (abs_le.mp (htaylor₂ (ξ_bar₂ + τ • w₂) hτ_test₂)).1
    rw [add_sub_cancel_left] at ht
    have h_quad_eq : (1 / 2 : ℝ) * inner ℝ (X₂ (τ • w₂)) (τ • w₂) =
        τ ^ 2 * ((1 / 2 : ℝ) * inner ℝ (X₂ w₂) w₂) := by
      rw [map_smul, inner_smul_left, inner_smul_right, RCLike.conj_to_real]
      ring
    have h_norm_eq : (κ / 2) * ‖τ • w₂‖ ^ 2 = τ ^ 2 * ((κ / 2) * ‖w₂‖ ^ 2) := by
      rw [norm_smul, Real.norm_eq_abs, mul_pow, sq_abs]
      ring
    linarith
  have ht_low₃ : τ ^ 2 * ((1 / 2 : ℝ) * inner ℝ (X₃ w₃) w₃ - (κ / 2) * ‖w₃‖ ^ 2) ≤
      u_hat₃ (ξ_bar₃ + τ • w₃) - u_hat₃ ξ_bar₃ - inner ℝ q₃ (τ • w₃) := by
    have ht := (abs_le.mp (htaylor₃ (ξ_bar₃ + τ • w₃) hτ_test₃)).1
    rw [add_sub_cancel_left] at ht
    have h_quad_eq : (1 / 2 : ℝ) * inner ℝ (X₃ (τ • w₃)) (τ • w₃) =
        τ ^ 2 * ((1 / 2 : ℝ) * inner ℝ (X₃ w₃) w₃) := by
      rw [map_smul, inner_smul_left, inner_smul_right, RCLike.conj_to_real]
      ring
    have h_norm_eq : (κ / 2) * ‖τ • w₃‖ ^ 2 = τ ^ 2 * ((κ / 2) * ‖w₃‖ ^ 2) := by
      rw [norm_smul, Real.norm_eq_abs, mul_pow, sq_abs]
      ring
    linarith
  have hQ_smul : threePointQuadForm e_hat α' β' γ' (K' + η) (τ • w₁) (τ • w₂) (τ • w₃) =
      τ ^ 2 * threePointQuadForm e_hat α' β' γ' (K' + η) w₁ w₂ w₃ := by
    have h_sub : τ • w₁ - τ • w₂ = τ • (w₁ - w₂) := (smul_sub τ w₁ w₂).symm
    have h_in : inner ℝ e_hat (τ • w₁ - τ • w₂) = τ * inner ℝ e_hat (w₁ - w₂) := by
      rw [h_sub, inner_smul_right]
    have h_perp : (τ • w₁ - τ • w₂) - (inner ℝ e_hat (τ • w₁ - τ • w₂)) • e_hat =
        τ • ((w₁ - w₂) - (inner ℝ e_hat (w₁ - w₂)) • e_hat) := by
      rw [h_in]
      module
    have h_mid : τ • w₃ - (1 / 2 : ℝ) • (τ • w₁ + τ • w₂) =
        τ • (w₃ - (1 / 2 : ℝ) • (w₁ + w₂)) := by
      module
    have h_norm_sq : ∀ v : EuclideanSpace ℝ (Fin (d + 1)), ‖τ • v‖ ^ 2 = τ ^ 2 * ‖v‖ ^ 2 := by
      intro v
      rw [norm_smul, Real.norm_eq_abs, mul_pow, sq_abs]
    dsimp only [threePointQuadForm]
    rw [h_perp, h_in, h_mid, h_norm_sq, h_norm_sq, h_norm_sq, h_norm_sq, h_norm_sq]
    ring
  have h_star_τ := h_star (τ • w₁) (τ • w₂) (τ • w₃) hτ_cb₁ hτ_cb₂ hτ_cb₃
  rw [hQ_smul] at h_star_τ
  have h_sum_τ : τ ^ 2 * (-κ * S_w) ≤ τ ^ 2 * threePointQuadForm e_hat α' β' γ' (K' + η) w₁ w₂ w₃ := by
    have h_inner_sum : -κ * S_w ≤
        ((1 / 2 : ℝ) * inner ℝ (X₁ w₁) w₁ - (κ / 2) * ‖w₁‖ ^ 2) +
        ((1 / 2 : ℝ) * inner ℝ (X₂ w₂) w₂ - (κ / 2) * ‖w₂‖ ^ 2) +
        ((1 / 2 : ℝ) * inner ℝ (X₃ w₃) w₃ - (κ / 2) * ‖w₃‖ ^ 2) := by
      dsimp [S_w]
      linarith [hsub₁_val, hsub₂_val, hsub₃_val]
    have h_mul := mul_le_mul_of_nonneg_left h_inner_sum (sq_nonneg τ)
    linarith [h_mul, ht_low₁, ht_low₂, ht_low₃, h_star_τ]
  have hQ_w_lower : -ε / 8 ≤ threePointQuadForm e_hat α' β' γ' (K' + η) w₁ w₂ w₃ := by
    have h_div := le_of_mul_le_mul_left h_sum_τ (sq_pos_of_pos hτ_pos)
    linarith
  have hQ_w_upper : threePointQuadForm e_hat α' β' γ' (K' + η) w₁ w₂ w₃ ≤
      threePointQuadForm e_hat α' β' γ' (K' + η) p₁ p₂ p₀ + G_p * (C_q * δ) := by
    have hw₃_add : w₃ = p₀ + (-(1 / 2 : ℝ) • q₃) := by
      dsimp [w₃]
      rw [sub_eq_add_neg, neg_smul]
    have ht := hQ_taylor p₁ p₂ p₀ q₁ q₂ (-(1 / 2 : ℝ) • q₃)
    change threePointQuadForm e_hat α' β' γ' (K' + η) w₁ w₂ (p₀ + (-(1 / 2 : ℝ) • q₃)) -
        threePointQuadForm e_hat α' β' γ' (K' + η) p₁ p₂ p₀ =
        inner ℝ g₁_p q₁ + inner ℝ g₂_p q₂ + inner ℝ g₃_p (-(1 / 2 : ℝ) • q₃) +
        threePointQuadForm e_hat α' β' γ' (K' + η) q₁ q₂ (-(1 / 2 : ℝ) • q₃) at ht
    rw [← hw₃_add] at ht
    have hq₃_half_norm : ‖-(1 / 2 : ℝ) • q₃‖ ≤ C_q * δ := by
      rw [neg_smul, norm_neg, norm_smul, Real.norm_eq_abs]
      have : |(1 / 2 : ℝ)| = 1 / 2 := by norm_num
      rw [this]
      linarith [norm_nonneg q₃, hq₃_norm]
    have hi₁ : inner ℝ g₁_p q₁ ≤ ‖g₁_p‖ * (C_q * δ) :=
      le_trans (real_inner_le_norm g₁_p q₁) (mul_le_mul_of_nonneg_left hq₁_norm (norm_nonneg g₁_p))
    have hi₂ : inner ℝ g₂_p q₂ ≤ ‖g₂_p‖ * (C_q * δ) :=
      le_trans (real_inner_le_norm g₂_p q₂) (mul_le_mul_of_nonneg_left hq₂_norm (norm_nonneg g₂_p))
    have hi₃ : inner ℝ g₃_p (-(1 / 2 : ℝ) • q₃) ≤ ‖g₃_p‖ * (C_q * δ) :=
      le_trans (real_inner_le_norm g₃_p (-(1 / 2 : ℝ) • q₃))
        (mul_le_mul_of_nonneg_left hq₃_half_norm (norm_nonneg g₃_p))
    have hq₁_sq : ‖q₁‖ ^ 2 ≤ (C_q * δ) ^ 2 := sq_le_sq' (by linarith [norm_nonneg q₁]) hq₁_norm
    have hq₂_sq : ‖q₂‖ ^ 2 ≤ (C_q * δ) ^ 2 := sq_le_sq' (by linarith [norm_nonneg q₂]) hq₂_norm
    have hq₃_sq : ‖-(1 / 2 : ℝ) • q₃‖ ^ 2 ≤ (C_q * δ) ^ 2 :=
      sq_le_sq' (by linarith [norm_nonneg (-(1 / 2 : ℝ) • q₃)]) hq₃_half_norm
    have h_sq_le : (C_q * δ) ^ 2 ≤ C_q * δ := by
      calc (C_q * δ) ^ 2 = (C_q * δ) * (C_q * δ) := sq (C_q * δ)
        _ ≤ 1 * (C_q * δ) := mul_le_mul_of_nonneg_right hCq_δ_le_one hCq_δ_nonneg
        _ = C_q * δ := one_mul (C_q * δ)
    have h_quad_q : threePointQuadForm e_hat α' β' γ' (K' + η) q₁ q₂ (-(1 / 2 : ℝ) • q₃) ≤
        3 * C_Q * (C_q * δ) := by
      have hq := le_trans (le_abs_self _) (hQ_quad q₁ q₂ (-(1 / 2 : ℝ) • q₃))
      have h_sum_q_sq : ‖q₁‖ ^ 2 + ‖q₂‖ ^ 2 + ‖-(1 / 2 : ℝ) • q₃‖ ^ 2 ≤ 3 * (C_q * δ) := by
        linarith [hq₁_sq, hq₂_sq, hq₃_sq, h_sq_le]
      have h_mul_q := mul_le_mul_of_nonneg_left h_sum_q_sq (le_of_lt hC_Q_pos)
      linarith
    have h_Gp_eq : G_p * (C_q * δ) =
        ‖g₁_p‖ * (C_q * δ) + ‖g₂_p‖ * (C_q * δ) + ‖g₃_p‖ * (C_q * δ) +
        3 * C_Q * (C_q * δ) + C_q * δ := by
      dsimp [G_p]
      ring
    linarith
  linarith

theorem three_point_midpoint_flatness (d : ℕ) (hd : 3 ≤ d) (L : ℝ) (hL_ge : 1 ≤ L)
    (U_hat : ℕ → EuclideanSpace ℝ (Fin (d + 1)) → ℝ)
    (P_star : EuclideanSpace ℝ (Fin (d + 1)))
    (hU_har : ∀ i : ℕ, IsInfinityHarmonicOn (U_hat i) (Metric.ball 0 1))
    (hU_lip : ∀ i : ℕ, ∀ X₁ ∈ Metric.ball (0 : EuclideanSpace ℝ (Fin (d + 1))) 1,
      ∀ X₂ ∈ Metric.ball (0 : EuclideanSpace ℝ (Fin (d + 1))) 1,
        |U_hat i X₁ - U_hat i X₂| ≤ L * ‖X₁ - X₂‖)
    (h_conv : HasUniformLinearLimitOnBall U_hat 1 P_star) :
    HasUniformMidpointFlatnessOnQuarterBall U_hat :=
by
  have hP_le : ‖P_star‖ ≤ L := by
    by_cases hP : P_star = 0
    · rw [hP, norm_zero]
      linarith
    · by_contra h_gt
      push_neg at h_gt
      have hP_pos : 0 < ‖P_star‖ := norm_pos_iff.mpr hP
      let e_star : EuclideanSpace ℝ (Fin (d + 1)) := (2 * ‖P_star‖)⁻¹ • P_star
      have he_norm : ‖e_star‖ = 1 / 2 := by
        simp only [e_star, norm_smul, norm_inv, Real.norm_eq_abs,
          abs_of_pos (by positivity : (0 : ℝ) < 2 * ‖P_star‖)]
        field_simp
      have he_mem : e_star ∈ Metric.ball (0 : EuclideanSpace ℝ (Fin (d + 1))) 1 := by
        rw [Metric.mem_ball, dist_zero_right, he_norm]
        norm_num
      have h0_mem : (0 : EuclideanSpace ℝ (Fin (d + 1))) ∈
          Metric.ball (0 : EuclideanSpace ℝ (Fin (d + 1))) 1 := by
        rw [Metric.mem_ball, dist_self]
        norm_num
      have he_inner : inner ℝ P_star e_star = (1 / 2 : ℝ) * ‖P_star‖ := by
        simp only [e_star, inner_smul_right, real_inner_self_eq_norm_sq]
        field_simp
      have hδ₀_pos : 0 < (‖P_star‖ - L) / 8 := by linarith
      obtain ⟨i₀, hi₀⟩ := h_conv ((‖P_star‖ - L) / 8) hδ₀_pos
      have h1 := hi₀ i₀ (le_refl i₀) e_star he_mem
      have h2 := hi₀ i₀ (le_refl i₀) 0 h0_mem
      rw [inner_zero_right, sub_zero] at h2
      have h3 := hU_lip i₀ e_star he_mem 0 h0_mem
      rw [sub_zero, he_norm] at h3
      rw [he_inner] at h1
      linarith [abs_le.mp h1, abs_le.mp h2, abs_le.mp h3]
  have h_neg_lap : ∀ (ϕ : EuclideanSpace ℝ (Fin (d + 1)) → ℝ)
      (z : EuclideanSpace ℝ (Fin (d + 1))),
      infinityLaplacian (-ϕ) z = -infinityLaplacian ϕ z := by
    intro ϕ z
    have h_fderiv1 : fderiv ℝ (-ϕ) = -fderiv ℝ ϕ := by
      funext x
      exact fderiv_neg
    have h_fderiv2 : fderiv ℝ (fderiv ℝ (-ϕ)) z = -fderiv ℝ (fderiv ℝ ϕ) z := by
      rw [h_fderiv1]
      exact fderiv_neg
    have h_grad : gradient (-ϕ) z = -gradient ϕ z := by
      simp only [gradient, fderiv_neg, map_neg]
    simp only [infinityLaplacian, h_fderiv2, h_grad, ContinuousLinearMap.neg_apply,
      ContinuousLinearMap.map_neg, neg_neg]
  have h_neg_har : ∀ i : ℕ, IsInfinityHarmonicOn (-U_hat i) (Metric.ball 0 1) := by
    intro i
    obtain ⟨h_cont, h_sub, h_sup⟩ := hU_har i
    refine ⟨h_cont.neg, ?_, ?_⟩
    · intro z hz ϕ V hV_open hzV hV_sub hϕ_diff hϕ_eq hϕ_ge
      have h_le := h_sup z hz (-ϕ) V hV_open hzV hV_sub hϕ_diff.neg
        (by simp [Pi.neg_apply, hϕ_eq])
        (fun y hy => by
          have := hϕ_ge y hy
          simp only [Pi.neg_apply] at this ⊢
          linarith)
      rw [h_neg_lap] at h_le
      linarith
    · intro z hz ϕ V hV_open hzV hV_sub hϕ_diff hϕ_eq hϕ_le
      have h_ge := h_sub z hz (-ϕ) V hV_open hzV hV_sub hϕ_diff.neg
        (by simp [Pi.neg_apply, hϕ_eq])
        (fun y hy => by
          have := hϕ_le y hy
          simp only [Pi.neg_apply] at this ⊢
          linarith)
      rw [h_neg_lap] at h_ge
      linarith
  have h_one_sided : ∀ (η : ℝ), 0 < η →
      ∀ (P : EuclideanSpace ℝ (Fin (d + 1))), ‖P‖ ≤ L →
      ∃ ε₀ : ℝ, 0 < ε₀ ∧
        ∀ (U : EuclideanSpace ℝ (Fin (d + 1)) → ℝ),
          IsInfinityHarmonicOn U (Metric.ball 0 1) →
          (∀ X₁ ∈ Metric.ball (0 : EuclideanSpace ℝ (Fin (d + 1))) 1,
            ∀ X₂ ∈ Metric.ball (0 : EuclideanSpace ℝ (Fin (d + 1))) 1,
              |U X₁ - U X₂| ≤ L * ‖X₁ - X₂‖) →
          (∀ X ∈ Metric.ball (0 : EuclideanSpace ℝ (Fin (d + 1))) 1,
            |U X - inner ℝ P X| ≤ ε₀) →
          ∀ X ∈ Metric.ball (0 : EuclideanSpace ℝ (Fin (d + 1))) (1 / 4),
            ∀ Y ∈ Metric.ball (0 : EuclideanSpace ℝ (Fin (d + 1))) (1 / 4),
              U X + U Y - 2 * U ((1 / 2 : ℝ) • (X + Y)) ≤ η * ‖X - Y‖ := by
    intro η hη_pos P hP_norm
    obtain ⟨r_max, hr_max_pos, h_quad⟩ :=
      three_point_penalty_quadratic_bound d hd L η hL_ge hη_pos P hP_norm
    let ε₁ : ℝ := η / (320 * (1 + 4 * L))
    let ε₂ : ℝ := η * r_max / 10
    let ε₀ : ℝ := min ε₁ ε₂
    have hε₁_pos : 0 < ε₁ := by positivity
    have hε₂_pos : 0 < ε₂ := by positivity
    have hε₀_pos : 0 < ε₀ := lt_min hε₁_pos hε₂_pos
    have hε₀_le₁ : ε₀ ≤ η / (320 * (1 + 4 * L)) := min_le_left ε₁ ε₂
    have hε₀_le₂ : 10 * ε₀ / η ≤ r_max := by
      have h_le : ε₀ ≤ η * r_max / 10 := min_le_right ε₁ ε₂
      rw [div_le_iff₀ hη_pos]
      linarith
    refine ⟨ε₀, hε₀_pos, ?_⟩
    intro U hU_har' hU_lip' hU_approx X hX Y hY
    by_contra h_viol
    push_neg at h_viol
    obtain ⟨x_hat, y_hat, z_hat, hx_hat, hy_hat, hz_hat, hr_pos, hr_le_ε, hh_le, hc_lt, h_max⟩ :=
      three_point_penalized_maximizer d hd L η ε₀ hL_ge hη_pos hε₀_pos hε₀_le₁ U P X Y
        hP_norm hU_lip' hU_approx hX hY h_viol
    have hr_le_max : ‖x_hat - y_hat‖ ≤ r_max := le_trans hr_le_ε hε₀_le₂
    obtain ⟨p₁, p₂, p₀, e_hat, α, β, γ, K, ρ, he_hat, hα, hβ, hγ, hK, hρ_pos, hρ_le,
      h_taylor, h_neg_quad⟩ :=
      h_quad ((1 / 2 : ℝ) • (X + Y)) x_hat y_hat z_hat hx_hat hy_hat hz_hat
        hr_pos hr_le_max hh_le hc_lt
    have h_upper : ∀ x ∈ Metric.closedBall (0 : EuclideanSpace ℝ (Fin (d + 1))) ρ,
        ∀ y ∈ Metric.closedBall (0 : EuclideanSpace ℝ (Fin (d + 1))) ρ,
          ∀ z ∈ Metric.closedBall (0 : EuclideanSpace ℝ (Fin (d + 1))) ρ,
            (U (x_hat + x) - U x_hat - inner ℝ p₁ x) +
              (U (y_hat + y) - U y_hat - inner ℝ p₂ y) -
              2 * (U (z_hat + z) - U z_hat - inner ℝ p₀ z) ≤
                threePointQuadForm e_hat α β γ K x y z := by
      intro x hx y hy z hz
      obtain ⟨hx_cb, hy_cb, hz_cb, hne, h_psi⟩ := h_taylor x hx y hy z hz
      have h_m := h_max (x_hat + x) hx_cb (y_hat + y) hy_cb (z_hat + z) hz_cb hne
      linarith
    obtain ⟨lam, u_hat₁, u_hat₂, u_hat₃, hlam_pos, hu₁0, hu₂0, hu₃0,
      hconv₁, hconv₂, hconv₃, hsub₁, hsub₂, hsub₃, hsum_le⟩ :=
      sup_convolution_semiconvex_reduction d hd L hL_ge U x_hat y_hat z_hat p₁ p₂ p₀ e_hat
        α β γ K ρ hU_har' hU_lip' hx_hat hy_hat hz_hat he_hat hα hβ hγ hK hρ_pos hρ_le h_upper
    have h_nonneg := semiconvex_sum_quadForm_nonneg d hd lam (ρ / 2) (α / 2) (2 * β) (2 * γ) (2 * K)
      e_hat p₁ p₂ p₀ u_hat₁ u_hat₂ u_hat₃ hlam_pos (by positivity) (by positivity) (by positivity)
      (by positivity) (by positivity) hu₁0 hu₂0 hu₃0 hconv₁ hconv₂ hconv₃ hsub₁ hsub₂ hsub₃ hsum_le
    linarith
  intro η hη_pos
  obtain ⟨ε₀_pos_branch, hε₁_pos, h_pos_branch⟩ := h_one_sided η hη_pos P_star hP_le
  have hP_neg_le : ‖-P_star‖ ≤ L := by
    rw [norm_neg]
    exact hP_le
  obtain ⟨ε₀_neg_branch, hε₂_pos, h_neg_branch⟩ := h_one_sided η hη_pos (-P_star) hP_neg_le
  let ε₀ : ℝ := min ε₀_pos_branch ε₀_neg_branch
  have hε₀_pos : 0 < ε₀ := lt_min hε₁_pos hε₂_pos
  obtain ⟨i₀, hi₀⟩ := h_conv ε₀ hε₀_pos
  refine ⟨i₀, fun i hi X hX Y hY => ?_⟩
  have h_upper : U_hat i X + U_hat i Y - 2 * U_hat i ((1 / 2 : ℝ) • (X + Y)) ≤ η * ‖X - Y‖ :=
    h_pos_branch (U_hat i) (hU_har i) (hU_lip i)
      (fun Z hZ => le_trans (hi₀ i hi Z hZ) (min_le_left _ _)) X hX Y hY
  have h_lower_neg : (-U_hat i) X + (-U_hat i) Y - 2 * (-U_hat i) ((1 / 2 : ℝ) • (X + Y)) ≤
      η * ‖X - Y‖ := by
    apply h_neg_branch (-U_hat i) (h_neg_har i)
    · intro X₁ hX₁ X₂ hX₂
      have h_eq : (-U_hat i) X₁ - (-U_hat i) X₂ = -(U_hat i X₁ - U_hat i X₂) := by
        simp only [Pi.neg_apply]
        ring
      rw [h_eq, abs_neg]
      exact hU_lip i X₁ hX₁ X₂ hX₂
    · intro Z hZ
      have h_eq : (-U_hat i) Z - inner ℝ (-P_star) Z = -(U_hat i Z - inner ℝ P_star Z) := by
        simp only [Pi.neg_apply, inner_neg_left]
        ring
      rw [h_eq, abs_neg]
      exact le_trans (hi₀ i hi Z hZ) (min_le_right _ _)
    · exact hX
    · exact hY
  simp only [Pi.neg_apply] at h_lower_neg
  rw [abs_le]
  constructor <;> linarith

theorem small_scale_linear_blowup_of_midpoint_flatness (d : ℕ) (hd : 3 ≤ d) (L : ℝ) (hL_ge : 1 ≤ L)
    (hL : HasUniformNormalizedLiftBounds d L)
    (u_seq : ℕ → EuclideanSpace ℝ (Fin d) → ℝ)
    (z_seq : ℕ → EuclideanSpace ℝ (Fin (d + 1)))
    (r_seq R_seq : ℕ → ℝ)
    (z_star : EuclideanSpace ℝ (Fin (d + 1)))
    (hu_seq : ∀ i : ℕ, IsNormalizedInfinityHarmonic d (u_seq i))
    (hz_seq : ∀ i : ℕ, z_seq i ∈ Metric.ball (0 : EuclideanSpace ℝ (Fin (d + 1))) (3 / 4))
    (hr_seq : ∀ i : ℕ, 0 < r_seq i ∧ r_seq i ≤ (1 / 8) * (3 / 4 - ‖z_seq i‖))
    (hR_pos : ∀ i : ℕ, 0 < R_seq i)
    (hr_ratio : Filter.Tendsto (fun i => r_seq i / R_seq i) Filter.atTop (nhds 0))
    (hz_ratio : Filter.Tendsto (fun i => ‖z_seq i - z_star‖ / R_seq i) Filter.atTop (nhds 0))
    (h_mid : HasUniformMidpointFlatnessOnQuarterBall
      (fun i => isotropicBlowup (liftFunc (u_seq i)) z_star (R_seq i)))
    (ε : ℝ) (hε_pos : 0 < ε) :
    ∃ i : ℕ, ∀ lam : ℝ, ε ≤ lam → lam < 1 →
      IsCylinderGood (liftFunc (u_seq i)) (z_seq i) (r_seq i) lam :=
by
  let η : ℝ := ε / (14 * (d + 1 : ℝ))
  have hd_pos : (0 : ℝ) < (d + 1 : ℝ) := by positivity
  have hη_pos : 0 < η := by positivity
  have hη : 0 ≤ η := le_of_lt hη_pos
  have hL0 : 0 ≤ L := by linarith
  obtain ⟨i₀, hi₀⟩ := h_mid η hη_pos
  have hr_ev : ∀ᶠ i in Filter.atTop, r_seq i / R_seq i < 1 / 16 :=
    (tendsto_order.mp hr_ratio).2 (1 / 16) (by norm_num)
  obtain ⟨i₁, hi₁⟩ := Filter.eventually_atTop.mp hr_ev
  have hz_ev : ∀ᶠ i in Filter.atTop, ‖z_seq i - z_star‖ / R_seq i < 1 / 8 :=
    (tendsto_order.mp hz_ratio).2 (1 / 8) (by norm_num)
  obtain ⟨i₂, hi₂⟩ := Filter.eventually_atTop.mp hz_ev
  let i : ℕ := max i₀ (max i₁ i₂)
  have hi₀_le : i₀ ≤ i := le_max_left i₀ (max i₁ i₂)
  have hi₁_le : i₁ ≤ i := le_trans (le_max_left i₁ i₂) (le_max_right i₀ (max i₁ i₂))
  have hi₂_le : i₂ ≤ i := le_trans (le_max_right i₁ i₂) (le_max_right i₀ (max i₁ i₂))
  let U : EuclideanSpace ℝ (Fin (d + 1)) → ℝ := liftFunc (u_seq i)
  let z : EuclideanSpace ℝ (Fin (d + 1)) := z_seq i
  let r : ℝ := r_seq i
  let R : ℝ := R_seq i
  let W : EuclideanSpace ℝ (Fin (d + 1)) → ℝ := isotropicBlowup U z r
  have hr_pos : 0 < r := (hr_seq i).1
  have hr_ne : r ≠ 0 := ne_of_gt hr_pos
  have hR_pos_i : 0 < R := hR_pos i
  have hR_ne : R ≠ 0 := ne_of_gt hR_pos_i
  have hW0 : W 0 = 0 := by simp [W, isotropicBlowup]
  have hW_last : W (EuclideanSpace.single (Fin.last d) 1) = 1 := by
    let e_last : EuclideanSpace ℝ (Fin (d + 1)) := EuclideanSpace.single (Fin.last d) 1
    have h_space : projSpace (z + r • e_last) = projSpace z := by
      ext m
      dsimp [projSpace]
      have h_ne : Fin.castSucc m ≠ Fin.last d := Fin.castSucc_ne_last m
      have hs : e_last (Fin.castSucc m) = 0 := by
        simp [e_last, h_ne]
      change (z + r • e_last).ofLp (Fin.castSucc m) = z.ofLp (Fin.castSucc m)
      rw [PiLp.add_apply, PiLp.smul_apply, smul_eq_mul, hs, mul_zero, add_zero]
    have h_time : projTime (z + r • e_last) = projTime z + r := by
      dsimp [projTime]
      have hs : e_last (Fin.last d) = 1 := by
        simp [e_last]
      change (z + r • e_last).ofLp (Fin.last d) = z.ofLp (Fin.last d) + r
      rw [PiLp.add_apply, PiLp.smul_apply, smul_eq_mul, hs, mul_one]
    dsimp [W, isotropicBlowup, U, liftFunc]
    change (u_seq i (projSpace (z + r • e_last)) + projTime (z + r • e_last) -
      (u_seq i (projSpace z) + projTime z)) / r = 1
    rw [h_space, h_time]
    field_simp [hr_ne]
    ring
  have hz_ball : ∀ H ∈ Metric.closedBall (0 : EuclideanSpace ℝ (Fin (d + 1))) 2,
      z + r • H ∈ Metric.ball (0 : EuclideanSpace ℝ (Fin (d + 1))) (7 / 8) := by
    intro H hH
    have hz_lt : ‖z‖ < 3 / 4 := by simpa [z, Metric.mem_ball, dist_zero_right] using hz_seq i
    have hr_le : r ≤ (1 / 8) * (3 / 4 - ‖z‖) := (hr_seq i).2
    have hH_norm : ‖H‖ ≤ 2 := by simpa [Metric.mem_closedBall, dist_zero_right] using hH
    rw [Metric.mem_ball, dist_zero_right]
    have h_tri := norm_add_le z (r • H)
    rw [norm_smul, Real.norm_eq_abs, abs_of_pos hr_pos] at h_tri
    nlinarith
  have hW_lip : ∀ H₁ ∈ Metric.closedBall (0 : EuclideanSpace ℝ (Fin (d + 1))) 2,
      ∀ H₂ ∈ Metric.closedBall (0 : EuclideanSpace ℝ (Fin (d + 1))) 2,
        |W H₁ - W H₂| ≤ L * ‖H₁ - H₂‖ := by
    intro H₁ hH₁ H₂ hH₂
    have hU_lip := (hL (u_seq i) (hu_seq i)).2.2.1 (z + r • H₁) (hz_ball H₁ hH₁) (z + r • H₂) (hz_ball H₂ hH₂)
    have h_diff_norm : ‖(z + r • H₁) - (z + r • H₂)‖ = r * ‖H₁ - H₂‖ := by
      have : (z + r • H₁) - (z + r • H₂) = r • (H₁ - H₂) := by rw [smul_sub]; abel
      rw [this, norm_smul, Real.norm_eq_abs, abs_of_pos hr_pos]
    rw [h_diff_norm] at hU_lip
    have hW_diff : W H₁ - W H₂ = (U (z + r • H₁) - U (z + r • H₂)) / r := by
      dsimp [W, isotropicBlowup]
      ring
    rw [hW_diff, abs_div, abs_of_pos hr_pos, div_le_iff₀ hr_pos]
    linarith
  have hX_ball : ∀ H ∈ Metric.closedBall (0 : EuclideanSpace ℝ (Fin (d + 1))) 2,
      R⁻¹ • (z - z_star + r • H) ∈ Metric.ball (0 : EuclideanSpace ℝ (Fin (d + 1))) (1 / 4) := by
    intro H hH
    have hH_norm : ‖H‖ ≤ 2 := by simpa [Metric.mem_closedBall, dist_zero_right] using hH
    have hrR : r / R < 1 / 16 := hi₁ i hi₁_le
    have hzR : ‖z - z_star‖ / R < 1 / 8 := hi₂ i hi₂_le
    rw [div_lt_iff₀ hR_pos_i] at hrR hzR
    rw [Metric.mem_ball, dist_zero_right, norm_smul, Real.norm_eq_abs, abs_inv, abs_of_pos hR_pos_i,
      inv_mul_lt_iff₀ hR_pos_i]
    have h_tri := norm_add_le (z - z_star) (r • H)
    rw [norm_smul, Real.norm_eq_abs, abs_of_pos hr_pos] at h_tri
    nlinarith
  have hW_mid : ∀ H ∈ Metric.closedBall (0 : EuclideanSpace ℝ (Fin (d + 1))) 2,
      ∀ K ∈ Metric.closedBall (0 : EuclideanSpace ℝ (Fin (d + 1))) 2,
        |W H + W K - 2 * W ((1 / 2 : ℝ) • (H + K))| ≤ η * ‖H - K‖ := by
    intro H hH K hK
    let X : EuclideanSpace ℝ (Fin (d + 1)) := R⁻¹ • (z - z_star + r • H)
    let Y : EuclideanSpace ℝ (Fin (d + 1)) := R⁻¹ • (z - z_star + r • K)
    have hX : X ∈ Metric.ball 0 (1 / 4) := hX_ball H hH
    have hY : Y ∈ Metric.ball 0 (1 / 4) := hX_ball K hK
    have h_mid_XY := hi₀ i hi₀_le X hX Y hY
    have h_pt : ∀ V : EuclideanSpace ℝ (Fin (d + 1)),
        z_star + R • (R⁻¹ • (z - z_star + r • V)) = z + r • V := by
      intro V
      rw [smul_smul, mul_inv_cancel₀ hR_ne, one_smul]
      abel
    have h_pt_X : z_star + R • X = z + r • H := h_pt H
    have h_pt_Y : z_star + R • Y = z + r • K := h_pt K
    have h_mid_eq : (1 / 2 : ℝ) • (X + Y) = R⁻¹ • (z - z_star + r • ((1 / 2 : ℝ) • (H + K))) := by
      dsimp [X, Y]
      ext m
      simp [PiLp.add_apply, PiLp.sub_apply, PiLp.smul_apply, smul_eq_mul]
      ring
    have h_pt_M : z_star + R • ((1 / 2 : ℝ) • (X + Y)) = z + r • ((1 / 2 : ℝ) • (H + K)) := by
      rw [h_mid_eq]
      exact h_pt ((1 / 2 : ℝ) • (H + K))
    have h_diff_XY : ‖X - Y‖ = (r / R) * ‖H - K‖ := by
      have : X - Y = (r / R) • (H - K) := by
        dsimp [X, Y]
        ext m
        simp [PiLp.sub_apply, PiLp.smul_apply, smul_eq_mul]
        ring
      rw [this, norm_smul, Real.norm_eq_abs, abs_of_pos (div_pos hr_pos hR_pos_i)]
    have h_sec : W H + W K - 2 * W ((1 / 2 : ℝ) • (H + K)) =
        (R / r) * (isotropicBlowup U z_star R X + isotropicBlowup U z_star R Y -
          2 * isotropicBlowup U z_star R ((1 / 2 : ℝ) • (X + Y))) := by
      dsimp [W, isotropicBlowup]
      rw [h_pt_X, h_pt_Y, h_pt_M]
      field_simp [hr_ne, hR_ne]
      ring
    rw [h_sec, abs_mul, abs_of_pos (div_pos hR_pos_i hr_pos)]
    change |isotropicBlowup U z_star R X + isotropicBlowup U z_star R Y -
      2 * isotropicBlowup U z_star R ((1 / 2 : ℝ) • (X + Y))| ≤ η * ‖X - Y‖ at h_mid_XY
    rw [h_diff_XY] at h_mid_XY
    have h_prod := mul_le_mul_of_nonneg_left h_mid_XY (le_of_lt (div_pos hR_pos_i hr_pos))
    have h_cancel : (R / r) * (η * (r / R * ‖H - K‖)) = η * ‖H - K‖ := by
      field_simp [hr_ne, hR_ne]
    linarith
  have h_ray : ∀ H ∈ Metric.closedBall (0 : EuclideanSpace ℝ (Fin (d + 1))) 2,
      ∀ j : Fin (d + 1),
        |W ((H j) • EuclideanSpace.single j 1) - (H j) * W (EuclideanSpace.single j 1)| ≤ 8 * η := by
    intro H hH j
    let e : EuclideanSpace ℝ (Fin (d + 1)) := EuclideanSpace.single j 1
    have he_norm : ‖e‖ = 1 := by simp [e]
    have hc_mem : ∀ c : ℝ, |c| ≤ 2 → c • e ∈ Metric.closedBall (0 : EuclideanSpace ℝ (Fin (d + 1))) 2 := by
      intro c hc
      rw [Metric.mem_closedBall, dist_zero_right, norm_smul, he_norm, Real.norm_eq_abs, mul_one]
      exact hc
    let g : ℝ → ℝ := fun t => W ((2 * t) • e)
    have hg0 : g 0 = 0 := by simp [g, hW0]
    have ht_mem : ∀ t : ℝ, |t| ≤ 1 → (2 * t) • e ∈ Metric.closedBall (0 : EuclideanSpace ℝ (Fin (d + 1))) 2 := by
      intro t ht
      apply hc_mem
      rw [abs_mul, abs_of_pos (by norm_num : (0 : ℝ) < 2)]
      linarith
    have hg_bdd : ∀ t : ℝ, |t| ≤ 1 → |g t| ≤ 2 * L := by
      intro t ht
      have h0_mem : (0 : EuclideanSpace ℝ (Fin (d + 1))) ∈ Metric.closedBall 0 2 := by simp
      have hlip := hW_lip ((2 * t) • e) (ht_mem t ht) 0 h0_mem
      rw [hW0, sub_zero, sub_zero, norm_smul, he_norm, mul_one, Real.norm_eq_abs, abs_mul,
        abs_of_pos (by norm_num : (0 : ℝ) < 2)] at hlip
      nlinarith
    have hg_mid : ∀ s u : ℝ, |s| ≤ 1 → |u| ≤ 1 → |g s + g u - 2 * g ((s + u) / 2)| ≤ 2 * η * |s - u| := by
      intro s u hs hu
      have hmid := hW_mid ((2 * s) • e) (ht_mem s hs) ((2 * u) • e) (ht_mem u hu)
      have h_eq1 : (1 / 2 : ℝ) • ((2 * s) • e + (2 * u) • e) = (2 * ((s + u) / 2)) • e := by
        rw [← add_smul, smul_smul]
        congr 1
        ring
      have h_eq2 : ‖(2 * s) • e - (2 * u) • e‖ = 2 * |s - u| := by
        have : (2 * s) • e - (2 * u) • e = (2 * (s - u)) • e := by
          rw [← sub_smul]
          congr 1
          ring
        rw [this, norm_smul, he_norm, mul_one, Real.norm_eq_abs, abs_mul,
          abs_of_pos (by norm_num : (0 : ℝ) < 2)]
      rw [h_eq1, h_eq2] at hmid
      dsimp [g]
      linarith
    let h : ℝ → ℝ := fun t => g t - t * g 1
    have hh0 : h 0 = 0 := by simp [h, hg0]
    have hh1 : h 1 = 0 := by simp [h]
    have hh_mid : ∀ s u : ℝ, |s| ≤ 1 → |u| ≤ 1 → |h s + h u - 2 * h ((s + u) / 2)| ≤ 2 * η * |s - u| := by
      intro s u hs hu
      have h_id : h s + h u - 2 * h ((s + u) / 2) = g s + g u - 2 * g ((s + u) / 2) := by
        dsimp [h]
        ring
      rw [h_id]
      exact hg_mid s u hs hu
    have hh_ind : ∀ (m : ℕ) (t : ℝ), 0 ≤ t → t ≤ 1 → |h t| ≤ 2 * η + 4 * L * (1 / 2 : ℝ) ^ m := by
      intro m
      induction m with
      | zero =>
        intro t ht0 ht1
        have hgt : |g t| ≤ 2 * L := hg_bdd t (abs_le.mpr ⟨by linarith, ht1⟩)
        have hg1 : |g 1| ≤ 2 * L := hg_bdd 1 (by norm_num)
        have h_tri : |h t| ≤ |g t| + |t * g 1| := by
          simpa [h, sub_eq_add_neg] using abs_add_le (g t) (-(t * g 1))
        rw [abs_mul, abs_of_nonneg ht0] at h_tri
        simp only [pow_zero, mul_one]
        nlinarith
      | succ m ihm =>
        intro t ht0 ht1
        rcases le_total t (1 / 2) with h_le | h_ge
        · have h2t0 : 0 ≤ 2 * t := by linarith
          have h2t1 : 2 * t ≤ 1 := by linarith
          have h_step := hh_mid 0 (2 * t) (by norm_num) (abs_le.mpr ⟨by linarith, h2t1⟩)
          have h_arg : (0 + 2 * t) / 2 = t := by ring
          rw [hh0, zero_add, h_arg, zero_sub, abs_neg, abs_of_nonneg h2t0] at h_step
          have h_ih := ihm (2 * t) h2t0 h2t1
          rw [abs_le] at h_step h_ih ⊢
          constructor <;> { rw [pow_succ]; nlinarith }
        · have h2t0 : 0 ≤ 2 * t - 1 := by linarith
          have h2t1 : 2 * t - 1 ≤ 1 := by linarith
          have h_step := hh_mid (2 * t - 1) 1 (abs_le.mpr ⟨by linarith, h2t1⟩) (by norm_num)
          have h_arg : (2 * t - 1 + 1) / 2 = t := by ring
          have h_sub : |2 * t - 1 - 1| = 2 * (1 - t) := by
            have : 2 * t - 1 - 1 = -(2 * (1 - t)) := by ring
            rw [this, abs_neg, abs_of_nonneg (by linarith)]
          rw [hh1, add_zero, h_arg, h_sub] at h_step
          have h_ih := ihm (2 * t - 1) h2t0 h2t1
          rw [abs_le] at h_step h_ih ⊢
          constructor <;> { rw [pow_succ]; nlinarith }
    have hh_nonneg : ∀ t : ℝ, 0 ≤ t → t ≤ 1 → |h t| ≤ 2 * η := by
      intro t ht0 ht1
      have h_tend : Filter.Tendsto (fun m : ℕ => 2 * η + 4 * L * (1 / 2 : ℝ) ^ m) Filter.atTop (nhds (2 * η + 4 * L * 0)) :=
        tendsto_const_nhds.add ((tendsto_pow_atTop_nhds_zero_of_lt_one (by norm_num) (by norm_num)).const_mul (4 * L))
      rw [mul_zero, add_zero] at h_tend
      exact ge_of_tendsto h_tend (Filter.Eventually.of_forall (fun m => hh_ind m t ht0 ht1))
    have hh_all : ∀ t : ℝ, |t| ≤ 1 → |h t| ≤ 6 * η := by
      intro t ht
      rcases le_total 0 t with ht0 | ht0
      · have ht1 : t ≤ 1 := (abs_le.mp ht).2
        have := hh_nonneg t ht0 ht1
        linarith
      · have hmt0 : 0 ≤ -t := by linarith
        have hmt1 : -t ≤ 1 := by linarith [(abs_le.mp ht).1]
        have h_pos := hh_nonneg (-t) hmt0 hmt1
        have h_sym := hg_mid t (-t) ht (by rw [abs_neg]; exact ht)
        have h_avg : (t + -t) / 2 = 0 := by ring
        have h_diff : |t - -t| = -2 * t := by
          have : t - -t = -(-2 * t) := by ring
          rw [this, abs_neg, abs_of_nonneg (by linarith)]
        rw [h_avg, hg0, mul_zero, sub_zero, h_diff] at h_sym
        have h_id : h t = (g t + g (-t)) - h (-t) := by dsimp [h]; ring
        rw [h_id]
        rw [abs_le] at h_pos h_sym ⊢
        constructor <;> nlinarith
    have hg1_half : |g 1 - 2 * W e| ≤ 2 * η := by
      have h_m := hg_mid 1 0 (by norm_num) (by norm_num)
      have h_avg : (1 + 0) / 2 = (1 / 2 : ℝ) := by ring
      have h_ge : g (1 / 2) = W e := by
        dsimp [g]
        have : (2 * (1 / 2 : ℝ)) = 1 := by ring
        rw [this, one_smul]
      rw [hg0, add_zero, h_avg, h_ge, sub_zero, abs_one, mul_one] at h_m
      exact h_m
    have hHj : |H j| ≤ 2 := by
      have hH_norm : ‖H‖ ≤ 2 := by simpa [Metric.mem_closedBall, dist_zero_right] using hH
      have h_le : ‖H j‖ ≤ ‖H‖ := PiLp.norm_apply_le H j
      simpa [Real.norm_eq_abs] using le_trans h_le hH_norm
    let t : ℝ := H j / 2
    have ht_abs : |t| ≤ 1 := by
      dsimp [t]
      rw [abs_div, abs_of_pos (by norm_num : (0 : ℝ) < 2)]
      linarith
    have hht := hh_all t ht_abs
    have h_eval : g t = W ((H j) • e) := by
      dsimp [g, t]
      have : 2 * (H j / 2) = H j := by ring
      rw [this]
    have h_id : W ((H j) • e) - (H j) * W e = h t + t * (g 1 - 2 * W e) := by
      rw [← h_eval]
      dsimp [h, t]
      ring
    have h_prod : |t * (g 1 - 2 * W e)| ≤ 2 * η := by
      rw [abs_mul]
      nlinarith [abs_nonneg (g 1 - 2 * W e)]
    have h_tri := abs_add_le (h t) (t * (g 1 - 2 * W e))
    rw [← h_id] at h_tri
    linarith
  have h_sum_approx : ∀ H ∈ Metric.closedBall (0 : EuclideanSpace ℝ (Fin (d + 1))) 2,
      |W H - ∑ j : Fin (d + 1), W ((H j) • EuclideanSpace.single j 1)| ≤ 6 * (d + 1 : ℝ) * η := by
    intro H hH
    have h_add : ∀ X Y : EuclideanSpace ℝ (Fin (d + 1)),
        X ∈ Metric.closedBall 0 2 → Y ∈ Metric.closedBall 0 2 → X + Y ∈ Metric.closedBall 0 2 →
        |W (X + Y) - W X - W Y| ≤ 6 * η := by
      intro X Y hX hY hXY
      have h0 : (0 : EuclideanSpace ℝ (Fin (d + 1))) ∈ Metric.closedBall 0 2 := by simp
      have h1 := hW_mid (X + Y) hXY 0 h0
      rw [hW0, add_zero, add_zero, sub_zero] at h1
      have hXY_norm : ‖X + Y‖ ≤ 2 := by simpa [Metric.mem_closedBall, dist_zero_right] using hXY
      have hX_norm : ‖X‖ ≤ 2 := by simpa [Metric.mem_closedBall, dist_zero_right] using hX
      have hY_norm : ‖Y‖ ≤ 2 := by simpa [Metric.mem_closedBall, dist_zero_right] using hY
      have h2 := hW_mid X hX Y hY
      have h_diff_norm : ‖X - Y‖ ≤ 4 := by
        have := norm_sub_le X Y
        linarith
      have h1' : |W (X + Y) - 2 * W ((1 / 2 : ℝ) • (X + Y))| ≤ 2 * η := by nlinarith
      have h2' : |W X + W Y - 2 * W ((1 / 2 : ℝ) • (X + Y))| ≤ 4 * η := by nlinarith
      rw [abs_le] at h1' h2' ⊢
      constructor <;> linarith
    have hH_norm : ‖H‖ ≤ 2 := by simpa [Metric.mem_closedBall, dist_zero_right] using hH
    let S : Finset (Fin (d + 1)) → EuclideanSpace ℝ (Fin (d + 1)) :=
      fun s => ∑ j ∈ s, (H j) • EuclideanSpace.single j 1
    have hS_apply : ∀ (s : Finset (Fin (d + 1))) (k : Fin (d + 1)),
        (S s) k = if k ∈ s then H k else 0 := by
      intro s
      induction s using Finset.induction_on with
      | empty =>
        intro k
        simp [S]
      | @insert a t ha iht =>
        intro k
        have h_ins : S (insert a t) = (H a) • EuclideanSpace.single a 1 + S t :=
          Finset.sum_insert ha
        rw [h_ins, PiLp.add_apply, PiLp.smul_apply, smul_eq_mul, iht k]
        have h_single : (EuclideanSpace.single a (1 : ℝ)) k = if k = a then 1 else 0 := by
          simp [PiLp.single_apply, eq_comm]
        rw [h_single]
        by_cases hka : k = a
        · subst hka
          simp [ha]
        · simp [hka]
    have hS_mem : ∀ s : Finset (Fin (d + 1)), S s ∈ Metric.closedBall (0 : EuclideanSpace ℝ (Fin (d + 1))) 2 := by
      intro s
      rw [Metric.mem_closedBall, dist_zero_right]
      have h_le : ‖S s‖ ≤ ‖H‖ := by
        rw [EuclideanSpace.norm_eq (S s), EuclideanSpace.norm_eq H]
        apply Real.sqrt_le_sqrt
        apply Finset.sum_le_sum
        intro k _
        have hk := hS_apply s k
        change (S s).ofLp k = _ at hk
        rw [hk]
        split_ifs <;> simp [sq_nonneg]
      exact le_trans h_le hH_norm
    have h_single_mem : ∀ a : Fin (d + 1),
        (H a) • EuclideanSpace.single a 1 ∈ Metric.closedBall (0 : EuclideanSpace ℝ (Fin (d + 1))) 2 := by
      intro a
      have h_eq : (H a) • EuclideanSpace.single a 1 = S {a} := (Finset.sum_singleton _ _).symm
      rw [h_eq]
      exact hS_mem {a}
    have hS_ind : ∀ s : Finset (Fin (d + 1)),
        |W (S s) - ∑ j ∈ s, W ((H j) • EuclideanSpace.single j 1)| ≤ 6 * (s.card : ℝ) * η := by
      intro s
      induction s using Finset.induction_on with
      | empty =>
        simp [S, hW0]
      | @insert a t ha iht =>
        have h_ins : S (insert a t) = (H a) • EuclideanSpace.single a 1 + S t :=
          Finset.sum_insert ha
        have h_sum : (∑ j ∈ insert a t, W ((H j) • EuclideanSpace.single j 1)) =
            W ((H a) • EuclideanSpace.single a 1) + ∑ j ∈ t, W ((H j) • EuclideanSpace.single j 1) :=
          Finset.sum_insert ha
        have h_step := h_add ((H a) • EuclideanSpace.single a 1) (S t)
          (h_single_mem a) (hS_mem t) (by rw [← h_ins]; exact hS_mem (insert a t))
        rw [h_ins, h_sum, Finset.card_insert_of_notMem ha, Nat.cast_add, Nat.cast_one]
        rw [abs_le] at h_step iht ⊢
        constructor <;> linarith
    have hS_univ : S Finset.univ = H := by
      ext k
      have hk := hS_apply Finset.univ k
      simpa using hk
    have h_fin := hS_ind Finset.univ
    rw [hS_univ, Finset.card_univ, Fintype.card_fin, Nat.cast_add, Nat.cast_one] at h_fin
    exact h_fin
  have hW_lin : ∀ H ∈ Metric.closedBall (0 : EuclideanSpace ℝ (Fin (d + 1))) 2,
      |W H - ∑ j : Fin (d + 1), (H j) * W (EuclideanSpace.single j 1)| ≤ ε := by
    intro H hH
    have h1 := h_sum_approx H hH
    have h2 : |(∑ j : Fin (d + 1), W ((H j) • EuclideanSpace.single j 1)) -
        ∑ j : Fin (d + 1), (H j) * W (EuclideanSpace.single j 1)| ≤ (d + 1 : ℝ) * (8 * η) := by
      rw [← Finset.sum_sub_distrib]
      calc |∑ j : Fin (d + 1), (W ((H j) • EuclideanSpace.single j 1) - (H j) * W (EuclideanSpace.single j 1))|
        _ ≤ ∑ j : Fin (d + 1), |W ((H j) • EuclideanSpace.single j 1) - (H j) * W (EuclideanSpace.single j 1)| :=
          Finset.abs_sum_le_sum_abs _ _
        _ ≤ ∑ _j : Fin (d + 1), 8 * η :=
          Finset.sum_le_sum (fun j _ => h_ray H hH j)
        _ = (d + 1 : ℝ) * (8 * η) := by
          simp [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
    have h_tri := abs_sub_le (W H) (∑ j : Fin (d + 1), W ((H j) • EuclideanSpace.single j 1))
      (∑ j : Fin (d + 1), (H j) * W (EuclideanSpace.single j 1))
    have h_eta_eq : 14 * (d + 1 : ℝ) * η = ε := by
      dsimp [η]
      have : 14 * (d + 1 : ℝ) ≠ 0 := by positivity
      field_simp [this]
    linarith
  refine ⟨i, fun lam hlam_ge hlam_lt => ?_⟩
  let P : EuclideanSpace ℝ (Fin (d + 1)) :=
    ∑ j : Fin (d + 1), W (EuclideanSpace.single j 1) • EuclideanSpace.single j 1
  have hP_inner : ∀ v : EuclideanSpace ℝ (Fin (d + 1)),
      inner ℝ P v = ∑ j : Fin (d + 1), (v j) * W (EuclideanSpace.single j 1) := by
    intro v
    dsimp [P]
    rw [sum_inner]
    apply Finset.sum_congr rfl
    intro j _
    rw [real_inner_smul_left, EuclideanSpace.inner_single_left]
    simp [mul_comm]
  have hP_ne : P ≠ 0 := by
    intro hP0
    have h1 : inner ℝ P (EuclideanSpace.single (Fin.last d) 1) = 1 := by
      rw [hP_inner]
      have h_sum : (∑ j : Fin (d + 1), ((EuclideanSpace.single (Fin.last d) (1 : ℝ)) j) * W (EuclideanSpace.single j 1)) =
          W (EuclideanSpace.single (Fin.last d) 1) := by
        have h_congr : ∀ j : Fin (d + 1),
            ((EuclideanSpace.single (Fin.last d) (1 : ℝ)) j) * W (EuclideanSpace.single j 1) =
              if j = Fin.last d then W (EuclideanSpace.single j 1) else 0 := by
          intro j
          have hs : (EuclideanSpace.single (Fin.last d) (1 : ℝ)) j = if j = Fin.last d then 1 else 0 := by
            simp [PiLp.single_apply]
          rw [hs]
          split_ifs <;> ring
        simp_rw [h_congr]
        simp
      rw [h_sum]
      exact hW_last
    rw [hP0, inner_zero_left] at h1
    norm_num at h1
  refine ⟨P, hP_ne, ?_⟩
  intro h N_P h_par h_perp
  have hNP_norm : ‖N_P‖ = 1 := by
    dsimp [N_P]
    rw [norm_smul, Real.norm_eq_abs, abs_inv, abs_norm, inv_mul_cancel₀ (norm_ne_zero_iff.mpr hP_ne)]
  have h_norm : ‖h‖ ≤ 2 * r := by
    have h_decomp : h = (h - (inner ℝ h N_P) • N_P) + (inner ℝ h N_P) • N_P := by abel
    have h_tri : ‖h‖ ≤ ‖h - (inner ℝ h N_P) • N_P‖ + ‖(inner ℝ h N_P) • N_P‖ := by
      simpa [← h_decomp] using norm_add_le (h - (inner ℝ h N_P) • N_P) ((inner ℝ h N_P) • N_P)
    rw [norm_smul, hNP_norm, mul_one, Real.norm_eq_abs] at h_tri
    have h_sqrt : Real.sqrt lam ≤ 1 := Real.sqrt_le_one.mpr (le_of_lt hlam_lt)
    nlinarith
  let H : EuclideanSpace ℝ (Fin (d + 1)) := r⁻¹ • h
  have hH_mem : H ∈ Metric.closedBall (0 : EuclideanSpace ℝ (Fin (d + 1))) 2 := by
    rw [Metric.mem_closedBall, dist_zero_right, norm_smul, Real.norm_eq_abs, abs_inv, abs_of_pos hr_pos]
    exact (inv_mul_le_iff₀ hr_pos).mpr (by linarith)
  have h_fit := hW_lin H hH_mem
  rw [← hP_inner H] at h_fit
  have h_zh : z + r • H = z + h := by
    dsimp [H]
    rw [smul_smul, mul_inv_cancel₀ hr_ne, one_smul]
  have h_id : U (z + h) - U z - inner ℝ P h = r * (W H - inner ℝ P H) := by
    dsimp [W, isotropicBlowup]
    rw [h_zh]
    have h_in : inner ℝ P H = r⁻¹ * inner ℝ P h := by
      dsimp [H]
      rw [real_inner_smul_right]
    rw [h_in]
    field_simp [hr_ne]
  rw [h_id, abs_mul, abs_of_pos hr_pos]
  nlinarith

theorem uniform_qualitative_flatness_of_lift (d : ℕ) (hd : 3 ≤ d) (L : ℝ) (hL_ge : 1 ≤ L)
    (hL : HasUniformNormalizedLiftBounds d L) :
    HasUniformQualitativeFlatness d :=
by
  intro ε hε_pos
  by_contra h_not_flat
  have h_ex : ∀ i : ℕ, ∃ (u : EuclideanSpace ℝ (Fin d) → ℝ)
      (z : EuclideanSpace ℝ (Fin (d + 1))) (r lam : ℝ),
      IsNormalizedInfinityHarmonic d u ∧
      z ∈ Metric.ball (0 : EuclideanSpace ℝ (Fin (d + 1))) (3 / 4) ∧
      (0 < r ∧ r ≤ (1 / (8 * (i + 1 : ℝ))) * (3 / 4 - ‖z‖)) ∧
      (ε ≤ lam ∧ lam < 1 ∧ ¬ IsCylinderGood (liftFunc u) z r lam) := by
    intro i
    have hs_pos : (0 : ℝ) < 1 / (8 * (i + 1 : ℝ)) := by positivity
    have hs_le : 1 / (8 * (i + 1 : ℝ)) ≤ 1 / 8 := by
      have hi : (1 : ℝ) ≤ (i + 1 : ℝ) := by
        exact_mod_cast Nat.succ_le_succ (Nat.zero_le i)
      exact one_div_le_one_div_of_le (by positivity) (by linarith)
    by_contra h_all
    apply h_not_flat
    refine ⟨1 / (8 * (i + 1 : ℝ)), hs_pos, hs_le, ?_⟩
    intro u hu z hz r hr_pos hr_le lam hlam_ge hlam_lt
    by_contra h_bad
    exact h_all ⟨u, z, r, lam, hu, hz, ⟨hr_pos, hr_le⟩, ⟨hlam_ge, hlam_lt, h_bad⟩⟩
  choose u_seq z_seq r_seq lam_seq h_seq using h_ex
  have hu_seq : ∀ i : ℕ, IsNormalizedInfinityHarmonic d (u_seq i) := fun i => (h_seq i).1
  have hz_seq : ∀ i : ℕ, z_seq i ∈ Metric.ball (0 : EuclideanSpace ℝ (Fin (d + 1))) (3 / 4) :=
    fun i => (h_seq i).2.1
  have hr_seq : ∀ i : ℕ, 0 < r_seq i ∧ r_seq i ≤ (1 / (8 * (i + 1 : ℝ))) * (3 / 4 - ‖z_seq i‖) :=
    fun i => (h_seq i).2.2.1
  have hlam_seq : ∀ i : ℕ, ε ≤ lam_seq i ∧ lam_seq i < 1 ∧
      ¬ IsCylinderGood (liftFunc (u_seq i)) (z_seq i) (r_seq i) (lam_seq i) :=
    fun i => (h_seq i).2.2.2
  obtain ⟨U₀, z_star, k₁, R_seq, hU₀_har, hU₀_lip, hz_star, hk₁, hR_props,
    hR_tendsto, hr_ratio, hz_ratio, h_approx⟩ :=
    subseq_limit_and_slow_scales d hd L hL_ge hL u_seq z_seq r_seq hu_seq hz_seq hr_seq
  have hR_bounds : ∀ i : ℕ, 0 < R_seq i ∧ R_seq i ≤ 1 / 16 :=
    fun i => ⟨(hR_props i).1, (hR_props i).2.1⟩
  obtain ⟨k₂, P_star, hk₂, h_lin⟩ :=
    fixed_center_affine_blowup d hd L hL_ge U₀ z_star R_seq hU₀_har hU₀_lip hz_star hR_bounds hR_tendsto
  let k : ℕ → ℕ := fun i => k₁ (k₂ i)
  let F_seq : ℕ → EuclideanSpace ℝ (Fin (d + 1)) → ℝ :=
    fun i => isotropicBlowup (liftFunc (u_seq (k i))) z_star (R_seq (k₂ i))
  have hF_har : ∀ i : ℕ, IsInfinityHarmonicOn (F_seq i) (Metric.ball 0 1) :=
    fun i => (hR_props (k₂ i)).2.2.1
  have hF_lip : ∀ i : ℕ, ∀ X₁ ∈ Metric.ball (0 : EuclideanSpace ℝ (Fin (d + 1))) 1,
      ∀ X₂ ∈ Metric.ball (0 : EuclideanSpace ℝ (Fin (d + 1))) 1,
        |F_seq i X₁ - F_seq i X₂| ≤ L * ‖X₁ - X₂‖ :=
    fun i => (hR_props (k₂ i)).2.2.2
  have hF_conv : HasUniformLinearLimitOnBall F_seq 1 P_star := by
    intro δ hδ_pos
    obtain ⟨i₁, hi₁⟩ := h_approx (δ / 2) (half_pos hδ_pos)
    obtain ⟨i₂, hi₂⟩ := h_lin (δ / 2) (half_pos hδ_pos)
    refine ⟨max i₁ i₂, fun i hi X hX => ?_⟩
    have hi₁_le : i₁ ≤ k₂ i := le_trans (le_trans (le_max_left i₁ i₂) hi) (hk₂.id_le i)
    have hi₂_le : i₂ ≤ i := le_trans (le_max_right i₁ i₂) hi
    have h1 := hi₁ (k₂ i) hi₁_le X hX
    have h2 := hi₂ i hi₂_le X hX
    have h_tri := abs_sub_le (F_seq i X) (isotropicBlowup U₀ z_star (R_seq (k₂ i)) X) (inner ℝ P_star X)
    linarith
  have h_mid : HasUniformMidpointFlatnessOnQuarterBall F_seq :=
    three_point_midpoint_flatness d hd L hL_ge F_seq P_star hF_har hF_lip hF_conv
  have hr_sub : ∀ i : ℕ, 0 < r_seq (k i) ∧ r_seq (k i) ≤ (1 / 8) * (3 / 4 - ‖z_seq (k i)‖) := by
    intro i
    refine ⟨(hr_seq (k i)).1, ?_⟩
    have h_pos_dist : 0 ≤ 3 / 4 - ‖z_seq (k i)‖ := by
      have hz_lt : ‖z_seq (k i)‖ < 3 / 4 := by
        simpa [Metric.mem_ball, dist_zero_right] using hz_seq (k i)
      linarith
    have h_coeff : 1 / (8 * (k i + 1 : ℝ)) ≤ 1 / 8 := by
      have hk_ge : (1 : ℝ) ≤ (k i + 1 : ℝ) := by
        exact_mod_cast Nat.succ_le_succ (Nat.zero_le (k i))
      exact one_div_le_one_div_of_le (by positivity) (by linarith)
    exact le_trans (hr_seq (k i)).2 (mul_le_mul_of_nonneg_right h_coeff h_pos_dist)
  have hR_sub_pos : ∀ i : ℕ, 0 < R_seq (k₂ i) := fun i => (hR_props (k₂ i)).1
  have hr_ratio_sub : Filter.Tendsto (fun i => r_seq (k i) / R_seq (k₂ i)) Filter.atTop (nhds 0) :=
    hr_ratio.comp hk₂.tendsto_atTop
  have hz_ratio_sub : Filter.Tendsto (fun i => ‖z_seq (k i) - z_star‖ / R_seq (k₂ i)) Filter.atTop (nhds 0) :=
    hz_ratio.comp hk₂.tendsto_atTop
  obtain ⟨i, hi_good⟩ :=
    small_scale_linear_blowup_of_midpoint_flatness d hd L hL_ge hL
      (fun i => u_seq (k i)) (fun i => z_seq (k i)) (fun i => r_seq (k i)) (fun i => R_seq (k₂ i)) z_star
      (fun i => hu_seq (k i)) (fun i => hz_seq (k i)) hr_sub hR_sub_pos
      hr_ratio_sub hz_ratio_sub h_mid ε hε_pos
  exact (hlam_seq (k i)).2.2 (hi_good (lam_seq (k i)) (hlam_seq (k i)).1 (hlam_seq (k i)).2.1)

theorem scale_selection_of_no_power_decay (d : ℕ) (hd : 3 ≤ d)
    (h_flat : HasUniformQualitativeFlatness d)
    (h_no_decay : ¬ ∃ B γ s₀ : ℝ, HasUniformCylinderPowerDecay d B γ s₀) :
    ∃ (u_seq : ℕ → EuclideanSpace ℝ (Fin d) → ℝ)
      (z_seq : ℕ → EuclideanSpace ℝ (Fin (d + 1)))
      (r_seq lam_seq : ℕ → ℝ),
      HasSelectedBlowupScales d u_seq z_seq r_seq lam_seq :=
by
  have hS_ne : ∀ s : ℝ, (insert (0 : ℝ) (badParamSet d s)).Nonempty :=
    fun s => Set.insert_nonempty 0 (badParamSet d s)
  have hS_bdd : ∀ s : ℝ, BddAbove (insert (0 : ℝ) (badParamSet d s)) := by
    intro s
    refine ⟨1, fun x hx => ?_⟩
    rcases hx with rfl | hx
    · norm_num
    · exact le_of_lt hx.2.1
  have hb_nonneg : ∀ s : ℝ, 0 ≤ familyBadness d s := by
    intro s
    exact le_csSup (hS_bdd s) (Set.mem_insert 0 (badParamSet d s))
  have hb_le_one : ∀ s : ℝ, familyBadness d s ≤ 1 := by
    intro s
    refine csSup_le (hS_ne s) (fun x hx => ?_)
    rcases hx with rfl | hx
    · norm_num
    · exact le_of_lt hx.2.1
  have hb_good : ∀ (s : ℝ) (u : EuclideanSpace ℝ (Fin d) → ℝ),
      IsNormalizedInfinityHarmonic d u →
      ∀ z ∈ Metric.ball (0 : EuclideanSpace ℝ (Fin (d + 1))) (3 / 4),
        ∀ r : ℝ, 0 < r → r ≤ s * (3 / 4 - ‖z‖) →
          ∀ lam : ℝ, familyBadness d s < lam → lam < 1 →
            IsCylinderGood (liftFunc u) z r lam := by
    intro s u hu z hz r hr_pos hr_le lam hlam_gt hlam_lt
    by_contra h_not_good
    have hlam_pos : 0 < lam := lt_of_le_of_lt (hb_nonneg s) hlam_gt
    have hlam_mem : lam ∈ insert (0 : ℝ) (badParamSet d s) :=
      Set.mem_insert_of_mem 0 ⟨hlam_pos, hlam_lt, u, z, r, hu, hz, hr_pos, hr_le, h_not_good⟩
    have hlam_le : lam ≤ familyBadness d s := le_csSup (hS_bdd s) hlam_mem
    linarith
  have hb_extract : ∀ s : ℝ, 0 < familyBadness d s →
      ∃ (u : EuclideanSpace ℝ (Fin d) → ℝ) (z : EuclideanSpace ℝ (Fin (d + 1))) (r lam : ℝ),
        IsNormalizedInfinityHarmonic d u ∧
        z ∈ Metric.ball (0 : EuclideanSpace ℝ (Fin (d + 1))) (3 / 4) ∧
        0 < r ∧ r ≤ s * (3 / 4 - ‖z‖) ∧
        0 < lam ∧ lam < 1 ∧
        familyBadness d s / 2 < lam ∧ lam ≤ familyBadness d s ∧
        ¬ IsCylinderGood (liftFunc u) z r lam := by
    intro s hbs_pos
    have h_half_lt : familyBadness d s / 2 < familyBadness d s := by linarith
    obtain ⟨lam, hlam_mem, hlam_gt⟩ := (lt_csSup_iff (hS_bdd s) (hS_ne s)).mp h_half_lt
    have hlam_le : lam ≤ familyBadness d s := le_csSup (hS_bdd s) hlam_mem
    rcases hlam_mem with rfl | ⟨hlam_pos, hlam_lt, u, z, r, hu, hz, hr_pos, hr_le, h_not_good⟩
    · linarith
    · exact ⟨u, z, r, lam, hu, hz, hr_pos, hr_le, hlam_pos, hlam_lt, hlam_gt, hlam_le, h_not_good⟩
  have hb_flat : ∀ ε : ℝ, 0 < ε →
      ∃ s₀ : ℝ, 0 < s₀ ∧ s₀ ≤ 1 / 8 ∧ ∀ s : ℝ, s ≤ s₀ → familyBadness d s ≤ ε := by
    intro ε hε
    obtain ⟨s₀, hs₀_pos, hs₀_le, h_good_s₀⟩ := h_flat ε hε
    refine ⟨s₀, hs₀_pos, hs₀_le, fun s hs => ?_⟩
    refine csSup_le (hS_ne s) (fun lam hlam => ?_)
    rcases hlam with rfl | ⟨hlam_pos, hlam_lt, u, z, r, hu, hz, hr_pos, hr_le, h_not_good⟩
    · exact le_of_lt hε
    · by_contra h_gt
      push_neg at h_gt
      have hz_norm : ‖z‖ < 3 / 4 := by simpa [Metric.mem_ball, dist_zero_right] using hz
      have hr_le_s₀ : r ≤ s₀ * (3 / 4 - ‖z‖) := by
        calc r ≤ s * (3 / 4 - ‖z‖) := hr_le
          _ ≤ s₀ * (3 / 4 - ‖z‖) := by nlinarith
      exact h_not_good (h_good_s₀ u hu z hz r hr_pos hr_le_s₀ lam (le_of_lt h_gt) hlam_lt)
  have hb_unbdd : ∀ γ : ℝ, 0 < γ → γ ≤ 1 → ∀ B : ℝ, 0 < B →
      ∃ s : ℝ, 0 < s ∧ s ≤ 1 / 8 ∧ B * s ^ γ < familyBadness d s := by
    intro γ hγ_pos hγ_le B hB_pos
    by_contra h_all
    push_neg at h_all
    apply h_no_decay
    refine ⟨B, γ, 1 / 8, hB_pos, hγ_pos, hγ_le, by norm_num, le_rfl, ?_⟩
    intro u hu z hz r hr_pos hr_le lam hlam_gt hlam_lt
    have hz_norm : ‖z‖ < 3 / 4 := by simpa [Metric.mem_ball, dist_zero_right] using hz
    have hD_pos : 0 < 3 / 4 - ‖z‖ := by linarith
    set s := r / (3 / 4 - ‖z‖)
    have hs_pos : 0 < s := div_pos hr_pos hD_pos
    have hs_le : s ≤ 1 / 8 := (div_le_iff₀ hD_pos).mpr hr_le
    have hr_eq : r ≤ s * (3 / 4 - ‖z‖) := by
      rw [div_mul_cancel₀ r (ne_of_gt hD_pos)]
    have hbs_le : familyBadness d s ≤ B * s ^ γ := h_all s hs_pos hs_le
    exact hb_good s u hu z hz r hr_pos hr_eq lam (lt_of_le_of_lt hbs_le hlam_gt) hlam_lt
  have h_doubling : ∀ (γ δ : ℝ), 0 < γ → γ ≤ 1 → 0 < δ → δ ≤ 1 / 8 →
      ∃ s_star : ℝ, 0 < s_star ∧ s_star < δ ∧ 0 < familyBadness d s_star ∧
        ∀ s : ℝ, s_star ≤ s → s ≤ 1 / 8 →
          familyBadness d s ≤ 2 * familyBadness d s_star * (s / s_star) ^ γ := by
    intro γ δ hγ_pos hγ_le hδ_pos hδ_le
    have hδ_rpow_pos : 0 < δ ^ γ := Real.rpow_pos_of_pos hδ_pos γ
    have hB_pos : 0 < 2 / δ ^ γ := div_pos (by norm_num) hδ_rpow_pos
    obtain ⟨h, hh_pos, hh_le, hh_gt⟩ := hb_unbdd γ hγ_pos hγ_le (2 / δ ^ γ) hB_pos
    have hh_rpow_pos : 0 < h ^ γ := Real.rpow_pos_of_pos hh_pos γ
    let q : ℝ → ℝ := fun s => familyBadness d s / s ^ γ
    let E : Set ℝ := q '' Set.Icc h (1 / 8)
    have hE_ne : E.Nonempty := ⟨q h, h, ⟨le_rfl, hh_le⟩, rfl⟩
    have hE_bdd : BddAbove E := by
      refine ⟨1 / h ^ γ, ?_⟩
      rintro _ ⟨s, ⟨hs_ge, _⟩, rfl⟩
      have hs_pos : 0 < s := lt_of_lt_of_le hh_pos hs_ge
      have hs_rpow_pos : 0 < s ^ γ := Real.rpow_pos_of_pos hs_pos γ
      have hs_rpow_ge : h ^ γ ≤ s ^ γ :=
        Real.rpow_le_rpow (le_of_lt hh_pos) hs_ge (le_of_lt hγ_pos)
      calc familyBadness d s / s ^ γ ≤ 1 / s ^ γ :=
            div_le_div_of_nonneg_right (hb_le_one s) (le_of_lt hs_rpow_pos)
        _ ≤ 1 / h ^ γ := one_div_le_one_div_of_le hh_rpow_pos hs_rpow_ge
    have hqh_gt : 2 / δ ^ γ < q h := (lt_div_iff₀ hh_rpow_pos).mpr hh_gt
    have hqh_mem : q h ∈ E := ⟨h, ⟨le_rfl, hh_le⟩, rfl⟩
    have hK_gt : 2 / δ ^ γ < sSup E := lt_of_lt_of_le hqh_gt (le_csSup hE_bdd hqh_mem)
    have hK_pos : 0 < sSup E := lt_trans hB_pos hK_gt
    have hK_half_lt : sSup E / 2 < sSup E := by linarith
    obtain ⟨_, ⟨s_star, ⟨hs_star_ge, hs_star_le⟩, rfl⟩, hs_star_gt⟩ :=
      (lt_csSup_iff hE_bdd hE_ne).mp hK_half_lt
    have hs_star_pos : 0 < s_star := lt_of_lt_of_le hh_pos hs_star_ge
    have hs_star_rpow_pos : 0 < s_star ^ γ := Real.rpow_pos_of_pos hs_star_pos γ
    have h_two_div : 2 / δ ^ γ = 2 * (1 / δ ^ γ) := by ring
    have hq_star_gt : 1 / δ ^ γ < q s_star := by linarith
    have hs_star_lt_δ : s_star < δ := by
      by_contra h_ge
      push_neg at h_ge
      have hδ_le_s_star : δ ^ γ ≤ s_star ^ γ :=
        Real.rpow_le_rpow (le_of_lt hδ_pos) h_ge (le_of_lt hγ_pos)
      have hq_star_le : q s_star ≤ 1 / δ ^ γ := by
        calc familyBadness d s_star / s_star ^ γ ≤ 1 / s_star ^ γ :=
              div_le_div_of_nonneg_right (hb_le_one s_star) (le_of_lt hs_star_rpow_pos)
          _ ≤ 1 / δ ^ γ := one_div_le_one_div_of_le hδ_rpow_pos hδ_le_s_star
      linarith
    have hbs_star_pos : 0 < familyBadness d s_star := by
      have h1 : 0 < 1 / δ ^ γ := div_pos (by norm_num) hδ_rpow_pos
      have h2 : 0 < familyBadness d s_star / s_star ^ γ := lt_trans h1 hq_star_gt
      exact (div_pos_iff_of_pos_right hs_star_rpow_pos).mp h2
    refine ⟨s_star, hs_star_pos, hs_star_lt_δ, hbs_star_pos, fun s hs_ge hs_le => ?_⟩
    have hs_pos : 0 < s := lt_of_lt_of_le hs_star_pos hs_ge
    have hs_rpow_pos : 0 < s ^ γ := Real.rpow_pos_of_pos hs_pos γ
    have hqs_mem : q s ∈ E := ⟨s, ⟨le_trans hs_star_ge hs_ge, hs_le⟩, rfl⟩
    have hqs_le : q s ≤ sSup E := le_csSup hE_bdd hqs_mem
    have hqs_le2 : familyBadness d s / s ^ γ ≤ 2 * (familyBadness d s_star / s_star ^ γ) := by
      change q s ≤ 2 * q s_star
      linarith
    have hbs_le : familyBadness d s ≤ 2 * (familyBadness d s_star / s_star ^ γ) * s ^ γ :=
      (div_le_iff₀ hs_rpow_pos).mp hqs_le2
    calc familyBadness d s ≤ 2 * (familyBadness d s_star / s_star ^ γ) * s ^ γ := hbs_le
      _ = 2 * familyBadness d s_star * (s ^ γ / s_star ^ γ) := by ring
      _ = 2 * familyBadness d s_star * (s / s_star) ^ γ := by
          rw [Real.div_rpow (le_of_lt hs_pos) (le_of_lt hs_star_pos) γ]
  have h_ex : ∀ i : ℕ,
      ∃ (s_i : ℝ) (u_i : EuclideanSpace ℝ (Fin d) → ℝ)
        (z_i : EuclideanSpace ℝ (Fin (d + 1))) (r_i lam_i : ℝ),
        0 < s_i ∧ s_i ≤ 1 / (i + 8 : ℝ) ∧
        (∀ s : ℝ, s_i ≤ s → s ≤ 1 / 8 →
          familyBadness d s ≤ 2 * familyBadness d s_i * (s / s_i) ^ (1 / (i + 2 : ℝ))) ∧
        IsNormalizedInfinityHarmonic d u_i ∧
        z_i ∈ Metric.ball (0 : EuclideanSpace ℝ (Fin (d + 1))) (3 / 4) ∧
        0 < r_i ∧ r_i ≤ s_i * (3 / 4 - ‖z_i‖) ∧
        0 < lam_i ∧ lam_i ≤ 1 / (256 * (i + 1 : ℝ)) ∧
        familyBadness d s_i < 2 * lam_i ∧
        ¬ IsCylinderGood (liftFunc u_i) z_i r_i lam_i := by
    intro i
    have hi2_pos : (0 : ℝ) < (i + 2 : ℝ) := by positivity
    have hi8_pos : (0 : ℝ) < (i + 8 : ℝ) := by positivity
    have hγ_pos : 0 < 1 / (i + 2 : ℝ) := by positivity
    have hγ_le : 1 / (i + 2 : ℝ) ≤ 1 := by
      rw [div_le_iff₀ hi2_pos]
      have : (0 : ℝ) ≤ (i : ℝ) := Nat.cast_nonneg i
      linarith
    have hε_pos : 0 < 1 / (256 * (i + 1 : ℝ)) := by positivity
    obtain ⟨s₀, hs₀_pos, hs₀_le, hs₀_flat⟩ := hb_flat (1 / (256 * (i + 1 : ℝ))) hε_pos
    let δ := min s₀ (1 / (i + 8 : ℝ))
    have hδ_pos : 0 < δ := lt_min hs₀_pos (by positivity)
    have hδ_le : δ ≤ 1 / 8 := le_trans (min_le_left _ _) hs₀_le
    obtain ⟨s_i, hs_i_pos, hs_i_lt_δ, hbs_i_pos, hs_i_doub⟩ :=
      h_doubling (1 / (i + 2 : ℝ)) δ hγ_pos hγ_le hδ_pos hδ_le
    have hs_i_le_s₀ : s_i ≤ s₀ := le_of_lt (lt_of_lt_of_le hs_i_lt_δ (min_le_left _ _))
    have hs_i_le_i8 : s_i ≤ 1 / (i + 8 : ℝ) :=
      le_of_lt (lt_of_lt_of_le hs_i_lt_δ (min_le_right _ _))
    have hbs_i_le_ε : familyBadness d s_i ≤ 1 / (256 * (i + 1 : ℝ)) :=
      hs₀_flat s_i hs_i_le_s₀
    obtain ⟨u_i, z_i, r_i, lam_i, hu_i, hz_i, hr_i_pos, hr_i_le, hlam_i_pos, _,
      hlam_i_gt, hlam_i_le, h_not_good⟩ := hb_extract s_i hbs_i_pos
    refine ⟨s_i, u_i, z_i, r_i, lam_i, hs_i_pos, hs_i_le_i8, hs_i_doub,
      hu_i, hz_i, hr_i_pos, hr_i_le, hlam_i_pos, le_trans hlam_i_le hbs_i_le_ε,
      by linarith, h_not_good⟩
  choose s_seq u_seq z_seq r_seq lam_seq h_spec using h_ex
  refine ⟨u_seq, z_seq, r_seq, lam_seq, ?_, ?_, ?_⟩
  · intro i
    obtain ⟨hs_pos, hs_le, _, hu, hz, hr_pos, hr_le, hlam_pos, hlam_le, h_lt_2lam, h_not_good⟩ :=
      h_spec i
    have hz_norm : ‖z_seq i‖ < 3 / 4 := by simpa [Metric.mem_ball, dist_zero_right] using hz
    have hD_pos : 0 < 3 / 4 - ‖z_seq i‖ := by linarith
    have hr_le_i8 : r_seq i ≤ (1 / (i + 8 : ℝ)) * (3 / 4 - ‖z_seq i‖) := by
      calc r_seq i ≤ s_seq i * (3 / 4 - ‖z_seq i‖) := hr_le
        _ ≤ (1 / (i + 8 : ℝ)) * (3 / 4 - ‖z_seq i‖) :=
            mul_le_mul_of_nonneg_right hs_le (le_of_lt hD_pos)
    have hi_nonneg : (0 : ℝ) ≤ (i : ℝ) := Nat.cast_nonneg i
    have h256_pos : (0 : ℝ) < 256 * (i + 1 : ℝ) := by positivity
    have hlam_le_256 : lam_seq i ≤ 1 / 256 := by
      have h1 : 1 / (256 * (i + 1 : ℝ)) ≤ 1 / 256 := by
        rw [div_le_div_iff₀ h256_pos (by norm_num)]
        linarith
      exact le_trans hlam_le h1
    have hlam_lt_128 : lam_seq i < 1 / 128 := by linarith
    have h32_gt : familyBadness d (s_seq i) < 32 * lam_seq i := by linarith
    have h32_lt : 32 * lam_seq i < 1 := by linarith
    have h_good_32 : IsCylinderGood (liftFunc (u_seq i)) (z_seq i) (r_seq i) (32 * lam_seq i) :=
      hb_good (s_seq i) (u_seq i) hu (z_seq i) hz (r_seq i) hr_pos hr_le (32 * lam_seq i)
        h32_gt h32_lt
    exact ⟨hu, hz, hr_pos, hr_le_i8, hlam_pos, hlam_lt_128, h_not_good, h_good_32⟩
  · rw [Metric.tendsto_atTop]
    intro ε hε
    obtain ⟨N, hN⟩ := exists_nat_ge (ε⁻¹)
    refine ⟨N, fun i hi => ?_⟩
    obtain ⟨_, _, _, _, _, _, _, hlam_pos, hlam_le, _, _⟩ := h_spec i
    rw [Real.dist_eq, sub_zero, abs_of_pos hlam_pos]
    have hiN : (N : ℝ) ≤ (i : ℝ) := Nat.cast_le.mpr hi
    have hi1_pos : (0 : ℝ) < (i + 1 : ℝ) := by positivity
    have h256_pos : (0 : ℝ) < 256 * (i + 1 : ℝ) := by positivity
    have h_inv_lt : 1 / (256 * (i + 1 : ℝ)) < ε := by
      rw [div_lt_iff₀ h256_pos]
      have hε_inv : 1 ≤ ε * (N : ℝ) := by
        have := mul_le_mul_of_nonneg_left hN (le_of_lt hε)
        rwa [mul_inv_cancel₀ (ne_of_gt hε)] at this
      nlinarith
    exact lt_of_le_of_lt hlam_le h_inv_lt
  · intro M hM
    obtain ⟨i₀, hi₀⟩ := exists_nat_ge (16 * M)
    refine ⟨i₀, fun i hi z hz_dist r hr_pos hr_le => ?_⟩
    obtain ⟨hs_pos, hs_le, hs_doub, hu, hz_i, hr_i_pos, hr_i_le, hlam_pos, hlam_le,
      h_lt_2lam, _⟩ := h_spec i
    have hi_ge : 16 * M ≤ (i : ℝ) := le_trans hi₀ (Nat.cast_le.mpr hi)
    have hi8_pos : (0 : ℝ) < (i + 8 : ℝ) := by positivity
    have h2M_pos : 0 < 2 * M := by linarith
    have hs_2M_le : 2 * M * s_seq i ≤ 1 / 8 := by
      have h1 : 2 * M * s_seq i ≤ 2 * M * (1 / (i + 8 : ℝ)) :=
        mul_le_mul_of_nonneg_left hs_le (by linarith)
      have h2 : 2 * M * (1 / (i + 8 : ℝ)) ≤ 1 / 8 := by
        rw [mul_one_div, div_le_div_iff₀ hi8_pos (by norm_num)]
        linarith
      exact le_trans h1 h2
    have hs_le_2M : s_seq i ≤ 2 * M * s_seq i := by nlinarith
    have hMs_le_half : M * s_seq i ≤ 1 / 2 := by linarith
    have hz_i_norm : ‖z_seq i‖ < 3 / 4 := by simpa [Metric.mem_ball, dist_zero_right] using hz_i
    have hD_i_pos : 0 < 3 / 4 - ‖z_seq i‖ := by linarith
    have hMr_i_le : M * r_seq i ≤ (M * s_seq i) * (3 / 4 - ‖z_seq i‖) := by
      calc M * r_seq i ≤ M * (s_seq i * (3 / 4 - ‖z_seq i‖)) :=
            mul_le_mul_of_nonneg_left hr_i_le (by linarith)
        _ = (M * s_seq i) * (3 / 4 - ‖z_seq i‖) := by ring
    have hz_sub_le : ‖z - z_seq i‖ ≤ (1 / 2) * (3 / 4 - ‖z_seq i‖) := by
      calc ‖z - z_seq i‖ ≤ M * r_seq i := hz_dist
        _ ≤ (M * s_seq i) * (3 / 4 - ‖z_seq i‖) := hMr_i_le
        _ ≤ (1 / 2) * (3 / 4 - ‖z_seq i‖) :=
            mul_le_mul_of_nonneg_right hMs_le_half (le_of_lt hD_i_pos)
    have h_tri : ‖z‖ ≤ ‖z_seq i‖ + ‖z - z_seq i‖ := by
      calc ‖z‖ = ‖z_seq i + (z - z_seq i)‖ := by abel_nf
        _ ≤ ‖z_seq i‖ + ‖z - z_seq i‖ := norm_add_le _ _
    have hD_z_ge : (1 / 2) * (3 / 4 - ‖z_seq i‖) ≤ 3 / 4 - ‖z‖ := by linarith
    have hz_ball : z ∈ Metric.ball (0 : EuclideanSpace ℝ (Fin (d + 1))) (3 / 4) := by
      rw [Metric.mem_ball, dist_zero_right]
      linarith
    have hr_le_2M : r ≤ (2 * M * s_seq i) * (3 / 4 - ‖z‖) := by
      calc r ≤ M * r_seq i := hr_le
        _ ≤ (M * s_seq i) * (3 / 4 - ‖z_seq i‖) := hMr_i_le
        _ = (2 * M * s_seq i) * ((1 / 2) * (3 / 4 - ‖z_seq i‖)) := by ring
        _ ≤ (2 * M * s_seq i) * (3 / 4 - ‖z‖) :=
            mul_le_mul_of_nonneg_left hD_z_ge (by positivity)
    have hr_le_8 : r ≤ (1 / 8) * (3 / 4 - ‖z‖) := by
      calc r ≤ (2 * M * s_seq i) * (3 / 4 - ‖z‖) := hr_le_2M
        _ ≤ (1 / 8) * (3 / 4 - ‖z‖) :=
            mul_le_mul_of_nonneg_right hs_2M_le (by linarith)
    have hrpow_le_2 : (2 * M) ^ (1 / (i + 2 : ℝ)) ≤ 2 := by
      have h_lt_pow : i + 2 < 2 ^ (i + 2) := Nat.lt_two_pow_self
      have h_le_pow_real : ((i + 2 : ℕ) : ℝ) ≤ ((2 ^ (i + 2) : ℕ) : ℝ) :=
        Nat.cast_le.mpr (le_of_lt h_lt_pow)
      push_cast at h_le_pow_real
      have h2M_le_pow : 2 * M ≤ (2 : ℝ) ^ (i + 2 : ℕ) := by linarith
      have hi2_pos : (0 : ℝ) < (i + 2 : ℝ) := by positivity
      have h_exp_nonneg : 0 ≤ 1 / (i + 2 : ℝ) := by positivity
      calc (2 * M) ^ (1 / (i + 2 : ℝ))
          ≤ ((2 : ℝ) ^ (i + 2 : ℕ)) ^ (1 / (i + 2 : ℝ)) :=
            Real.rpow_le_rpow (by positivity) h2M_le_pow h_exp_nonneg
        _ = ((2 : ℝ) ^ ((i + 2 : ℕ) : ℝ)) ^ (1 / (i + 2 : ℝ)) := by
            rw [Real.rpow_natCast]
        _ = (2 : ℝ) ^ (((i + 2 : ℕ) : ℝ) * (1 / (i + 2 : ℝ))) := by
            rw [← Real.rpow_mul (by norm_num)]
        _ = (2 : ℝ) ^ (1 : ℝ) := by
            push_cast
            rw [mul_one_div_cancel (ne_of_gt hi2_pos)]
        _ = 2 := Real.rpow_one 2
    have hb_2M_le : familyBadness d (2 * M * s_seq i) ≤
        2 * familyBadness d (s_seq i) * (2 * M) ^ (1 / (i + 2 : ℝ)) := by
      have h_doub := hs_doub (2 * M * s_seq i) hs_le_2M hs_2M_le
      have h_div : (2 * M * s_seq i) / s_seq i = 2 * M :=
        mul_div_cancel_right₀ (2 * M) (ne_of_gt hs_pos)
      rwa [h_div] at h_doub
    have hbs_i_nonneg : 0 ≤ familyBadness d (s_seq i) := hb_nonneg (s_seq i)
    have hb_2M_lt_32 : familyBadness d (2 * M * s_seq i) < 32 * lam_seq i := by
      have h1 : 2 * familyBadness d (s_seq i) * (2 * M) ^ (1 / (i + 2 : ℝ)) ≤
          2 * familyBadness d (s_seq i) * 2 :=
        mul_le_mul_of_nonneg_left hrpow_le_2 (by positivity)
      linarith
    have h256_pos : (0 : ℝ) < 256 * (i + 1 : ℝ) := by positivity
    have hlam_le_256 : lam_seq i ≤ 1 / 256 := by
      have h1 : 1 / (256 * (i + 1 : ℝ)) ≤ 1 / 256 := by
        rw [div_le_div_iff₀ h256_pos (by norm_num)]
        have : (0 : ℝ) ≤ (i : ℝ) := Nat.cast_nonneg i
        linarith
      exact le_trans hlam_le h1
    have h32_lt_1 : 32 * lam_seq i < 1 := by linarith
    have h_good_z : IsCylinderGood (liftFunc (u_seq i)) z r (32 * lam_seq i) :=
      hb_good (2 * M * s_seq i) (u_seq i) hu z hz_ball r hr_pos hr_le_2M
        (32 * lam_seq i) hb_2M_lt_32 h32_lt_1
    exact ⟨hz_ball, hr_le_8, h_good_z⟩

theorem cylinder_fit_comparison (d : ℕ) (hd : 3 ≤ d) (L : ℝ) (hL_ge : 1 ≤ L) :
    HasCylinderFitComparisonBounds d L :=
by
  refine ⟨1152 * (L + 2), by linarith, ?_⟩
  intro U z z' H H' θ P P' hθ_pos hθ_lt hP_low hP_high hP'_low hP'_high n n' h_cases
  have hP_pos : 0 < ‖P‖ := by linarith
  have hP'_pos : 0 < ‖P'‖ := by linarith
  have hP_ne : ‖P‖ ≠ 0 := ne_of_gt hP_pos
  have hP'_ne : ‖P'‖ ≠ 0 := ne_of_gt hP'_pos
  have hn_norm : ‖n‖ = 1 := by
    change ‖(‖P‖⁻¹) • P‖ = 1
    rw [norm_smul, Real.norm_eq_abs, abs_inv, abs_norm, inv_mul_cancel₀ hP_ne]
  have hn'_norm : ‖n'‖ = 1 := by
    change ‖(‖P'‖⁻¹) • P'‖ = 1
    rw [norm_smul, Real.norm_eq_abs, abs_inv, abs_norm, inv_mul_cancel₀ hP'_ne]
  have hPn : ‖P‖ • n = P := smul_inv_smul₀ hP_ne P
  have hP'n' : ‖P'‖ • n' = P' := smul_inv_smul₀ hP'_ne P'
  have hsqrt_θ : Real.sqrt (θ ^ 2) = θ := Real.sqrt_sq (le_of_lt hθ_pos)
  have h_inner_u : ∀ (u : EuclideanSpace ℝ (Fin (d + 1))), ‖u‖ = 1 →
      ∀ h : EuclideanSpace ℝ (Fin (d + 1)), |inner ℝ h u| ≤ ‖h‖ := by
    intro u hu h
    calc |inner ℝ h u| ≤ ‖h‖ * ‖u‖ := abs_real_inner_le_norm h u
      _ = ‖h‖ := by rw [hu, mul_one]
  have h_proj_u : ∀ (u : EuclideanSpace ℝ (Fin (d + 1))), ‖u‖ = 1 →
      ∀ (h : EuclideanSpace ℝ (Fin (d + 1))) (α : ℝ),
        ‖h - (inner ℝ h u) • u‖ ≤ ‖h - α • u‖ := by
    intro u hu h α
    set s : ℝ := inner ℝ h u
    have h1 : ‖h - s • u‖ ^ 2 = ‖h‖ ^ 2 - 2 * inner ℝ h (s • u) + ‖s • u‖ ^ 2 :=
      norm_sub_sq_real h (s • u)
    have h2 : ‖h - α • u‖ ^ 2 = ‖h‖ ^ 2 - 2 * inner ℝ h (α • u) + ‖α • u‖ ^ 2 :=
      norm_sub_sq_real h (α • u)
    have hs_in : inner ℝ h (s • u) = s ^ 2 := by
      rw [real_inner_smul_right]; ring
    have hα_in : inner ℝ h (α • u) = α * s := by
      rw [real_inner_smul_right]
    have hs_nm : ‖s • u‖ ^ 2 = s ^ 2 := by
      rw [norm_smul, hu, mul_one, Real.norm_eq_abs, sq_abs]
    have hα_nm : ‖α • u‖ ^ 2 = α ^ 2 := by
      rw [norm_smul, hu, mul_one, Real.norm_eq_abs, sq_abs]
    have h_sq_le : ‖h - s • u‖ ^ 2 ≤ ‖h - α • u‖ ^ 2 := by
      have h_diff : ‖h - α • u‖ ^ 2 - ‖h - s • u‖ ^ 2 = (s - α) ^ 2 := by
        linarith [h1, h2, hs_in, hα_in, hs_nm, hα_nm]
      linarith [sq_nonneg (s - α)]
    calc ‖h - s • u‖ = Real.sqrt (‖h - s • u‖ ^ 2) := (Real.sqrt_sq (norm_nonneg _)).symm
      _ ≤ Real.sqrt (‖h - α • u‖ ^ 2) := Real.sqrt_le_sqrt h_sq_le
      _ = ‖h - α • u‖ := Real.sqrt_sq (norm_nonneg _)
  have h_proj_le_norm : ∀ (u : EuclideanSpace ℝ (Fin (d + 1))), ‖u‖ = 1 →
      ∀ h : EuclideanSpace ℝ (Fin (d + 1)), ‖h - (inner ℝ h u) • u‖ ≤ ‖h‖ := by
    intro u hu h
    simpa using h_proj_u u hu h 0
  have h_ball_to_norm : ∀ (r M : ℝ), 0 < r → 0 ≤ M →
      (∀ h : EuclideanSpace ℝ (Fin (d + 1)), ‖h‖ ≤ r → |inner ℝ (P - P') h| ≤ M * r) →
      ‖P - P'‖ ≤ M := by
    intro r M hr hM h_ball
    by_cases hPP' : P - P' = 0
    · rw [hPP', norm_zero]; exact hM
    · have h_pos : 0 < ‖P - P'‖ := norm_pos_iff.mpr hPP'
      have h_ne : ‖P - P'‖ ≠ 0 := ne_of_gt h_pos
      let c : ℝ := r * ‖P - P'‖⁻¹
      have hc_pos : 0 < c := mul_pos hr (inv_pos.mpr h_pos)
      let h₁ : EuclideanSpace ℝ (Fin (d + 1)) := c • (P - P')
      have hh₁_norm : ‖h₁‖ ≤ r := by
        rw [norm_smul, Real.norm_eq_abs, abs_of_pos hc_pos]
        dsimp [c]
        rw [mul_assoc, inv_mul_cancel₀ h_ne, mul_one]
      have h_eval := h_ball h₁ hh₁_norm
      have h_inner : inner ℝ (P - P') h₁ = r * ‖P - P'‖ := by
        dsimp [h₁, c]
        rw [real_inner_smul_right, real_inner_self_eq_norm_mul_norm]
        calc r * ‖P - P'‖⁻¹ * (‖P - P'‖ * ‖P - P'‖)
            = r * (‖P - P'‖⁻¹ * ‖P - P'‖) * ‖P - P'‖ := by ring
          _ = r * ‖P - P'‖ := by rw [inv_mul_cancel₀ h_ne, mul_one]
      have h_le : r * ‖P - P'‖ ≤ M * r := by
        calc r * ‖P - P'‖ ≤ |r * ‖P - P'‖| := le_abs_self _
          _ = |inner ℝ (P - P') h₁| := by rw [h_inner]
          _ ≤ M * r := h_eval
      nlinarith
  have h_unit : ‖n - n'‖ ≤ 4 * ‖P - P'‖ := by
    have h_vec : ‖P‖ • (n - n') = (P - P') + (‖P'‖ - ‖P‖) • n' := by
      rw [smul_sub, sub_smul, hPn, hP'n']
      abel
    have h_norm_eq : ‖‖P‖ • (n - n')‖ = ‖P‖ * ‖n - n'‖ := by
      rw [norm_smul, Real.norm_eq_abs, abs_of_pos hP_pos]
    have h_norm_le : ‖P‖ * ‖n - n'‖ ≤ 2 * ‖P - P'‖ := by
      calc ‖P‖ * ‖n - n'‖ = ‖(P - P') + (‖P'‖ - ‖P‖) • n'‖ := by rw [← h_norm_eq, h_vec]
        _ ≤ ‖P - P'‖ + ‖(‖P'‖ - ‖P‖) • n'‖ := norm_add_le _ _
        _ = ‖P - P'‖ + |‖P‖ - ‖P'‖| := by
            rw [norm_smul, Real.norm_eq_abs, hn'_norm, mul_one, abs_sub_comm]
        _ ≤ ‖P - P'‖ + ‖P - P'‖ := by linarith [abs_norm_sub_norm_le P P']
        _ = 2 * ‖P - P'‖ := by ring
    nlinarith [norm_nonneg (n - n')]
  have h_finish : ‖P - P'‖ ≤ 12 * θ → |inner ℝ (P - P') n'| ≤ 288 * θ ^ 2 →
      ‖P - P'‖ ≤ 1152 * (L + 2) * θ ∧
      ‖n - n'‖ ≤ 1152 * (L + 2) * θ ∧
      |‖P‖ - ‖P'‖| ≤ 1152 * (L + 2) * θ ^ 2 := by
    intro hPP'_le h_ax
    have hnn'_le : ‖n - n'‖ ≤ 48 * θ := by linarith
    have h_sq_id : ‖n - n'‖ ^ 2 = 2 - 2 * inner ℝ n n' := by
      have h := norm_sub_sq_real n n'
      rw [hn_norm, hn'_norm] at h
      linarith
    have h_inner_exp : inner ℝ (P - P') n' = ‖P‖ * inner ℝ n n' - ‖P'‖ := by
      calc inner ℝ (P - P') n' = inner ℝ P n' - inner ℝ P' n' := inner_sub_left P P' n'
        _ = inner ℝ (‖P‖ • n) n' - inner ℝ (‖P'‖ • n') n' := by rw [hPn, hP'n']
        _ = ‖P‖ * inner ℝ n n' - ‖P'‖ * inner ℝ n' n' := by
            rw [real_inner_smul_left n n' ‖P‖, real_inner_smul_left n' n' ‖P'‖]
        _ = ‖P‖ * inner ℝ n n' - ‖P'‖ := by
            rw [real_inner_self_eq_norm_mul_norm, hn'_norm, mul_one, mul_one]
    have h_norm_diff_id : ‖P‖ - ‖P'‖ = inner ℝ (P - P') n' + (1 / 2) * ‖P‖ * ‖n - n'‖ ^ 2 := by
      nlinarith [h_sq_id, h_inner_exp]
    have hnn'_sq : ‖n - n'‖ ^ 2 ≤ (48 * θ) ^ 2 := by
      nlinarith [norm_nonneg (n - n'), hnn'_le]
    have h_term2 : (1 / 2) * ‖P‖ * ‖n - n'‖ ^ 2 ≤ 1152 * (L + 1) * θ ^ 2 := by
      have h1 : (1 / 2) * ‖P‖ * ‖n - n'‖ ^ 2 ≤ (1 / 2) * (L + 1) * ‖n - n'‖ ^ 2 := by
        nlinarith [sq_nonneg ‖n - n'‖, hP_high]
      nlinarith [h1, hnn'_sq, hL_ge]
    have h_abs_norm : |‖P‖ - ‖P'‖| ≤ 1152 * (L + 2) * θ ^ 2 := by
      have h_nonneg_t2 : 0 ≤ (1 / 2) * ‖P‖ * ‖n - n'‖ ^ 2 := by positivity
      calc |‖P‖ - ‖P'‖| = |inner ℝ (P - P') n' + (1 / 2) * ‖P‖ * ‖n - n'‖ ^ 2| := by
            rw [h_norm_diff_id]
        _ ≤ |inner ℝ (P - P') n'| + |(1 / 2) * ‖P‖ * ‖n - n'‖ ^ 2| := abs_add_le _ _
        _ = |inner ℝ (P - P') n'| + (1 / 2) * ‖P‖ * ‖n - n'‖ ^ 2 := by
            rw [abs_of_nonneg h_nonneg_t2]
        _ ≤ 288 * θ ^ 2 + 1152 * (L + 1) * θ ^ 2 := add_le_add h_ax h_term2
        _ ≤ 1152 * (L + 2) * θ ^ 2 := by nlinarith [sq_nonneg θ]
    refine ⟨by nlinarith, by nlinarith, h_abs_norm⟩
  rcases h_cases with ⟨_, hH_pos, hH_le, hH'_le, hfit, hfit'⟩ | ⟨_, hH_pos, h_ax_z, h_tr_z, hfit, hfit'⟩
  · 
    have h_two_fit : ∀ h : EuclideanSpace ℝ (Fin (d + 1)),
        |inner ℝ h n| ≤ H → ‖h - (inner ℝ h n) • n‖ ≤ θ * H →
        |inner ℝ h n'| ≤ H' → ‖h - (inner ℝ h n') • n'‖ ≤ θ * H' →
        |inner ℝ (P - P') h| ≤ 3 * θ ^ 2 * H := by
      intro h hn_ax hn_tr hn'_ax hn'_tr
      have hb1 : |U (z + h) - U z - inner ℝ P h| ≤ θ ^ 2 * H := by
        apply hfit.2 h hn_ax
        rwa [hsqrt_θ]
      have hb2 : |U (z + h) - U z - inner ℝ P' h| ≤ θ ^ 2 * H' := by
        apply hfit'.2 h hn'_ax
        rwa [hsqrt_θ]
      have h_id : inner ℝ (P - P') h =
          (U (z + h) - U z - inner ℝ P' h) - (U (z + h) - U z - inner ℝ P h) := by
        rw [inner_sub_left]; ring
      have h_abs : |inner ℝ (P - P') h| ≤
          |U (z + h) - U z - inner ℝ P' h| + |U (z + h) - U z - inner ℝ P h| := by
        rw [h_id]
        simpa using abs_sub (U (z + h) - U z - inner ℝ P' h) (U (z + h) - U z - inner ℝ P h)
      nlinarith [sq_nonneg θ]
    have h_ball : ∀ h : EuclideanSpace ℝ (Fin (d + 1)), ‖h‖ ≤ θ * H →
        |inner ℝ (P - P') h| ≤ (3 * θ) * (θ * H) := by
      intro h hh
      have hn_ax : |inner ℝ h n| ≤ H := by
        have := h_inner_u n hn_norm h
        nlinarith
      have hn_tr : ‖h - (inner ℝ h n) • n‖ ≤ θ * H :=
        (h_proj_le_norm n hn_norm h).trans hh
      have hn'_ax : |inner ℝ h n'| ≤ H' := by
        have := h_inner_u n' hn'_norm h
        nlinarith
      have hn'_tr : ‖h - (inner ℝ h n') • n'‖ ≤ θ * H' := by
        have := (h_proj_le_norm n' hn'_norm h).trans hh
        nlinarith
      have := h_two_fit h hn_ax hn_tr hn'_ax hn'_tr
      linarith
    have hPP'_le3 : ‖P - P'‖ ≤ 3 * θ :=
      h_ball_to_norm (θ * H) (3 * θ) (mul_pos hθ_pos hH_pos) (by linarith) h_ball
    have hPP'_le12 : ‖P - P'‖ ≤ 12 * θ := by linarith
    have hnn'_le12 : ‖n - n'‖ ≤ 12 * θ := by linarith
    let c : ℝ := H / 24
    have hc_pos : 0 < c := by dsimp [c]; linarith
    let h₂ : EuclideanSpace ℝ (Fin (d + 1)) := c • n'
    have hh₂_norm : ‖h₂‖ = c := by
      dsimp [h₂]
      rw [norm_smul, Real.norm_eq_abs, abs_of_pos hc_pos, hn'_norm, mul_one]
    have hh₂_in_n' : inner ℝ h₂ n' = c := by
      dsimp [h₂]
      rw [real_inner_smul_left, real_inner_self_eq_norm_mul_norm, hn'_norm, mul_one, mul_one]
    have hh₂_n'_ax : |inner ℝ h₂ n'| ≤ H' := by
      rw [hh₂_in_n', abs_of_pos hc_pos]
      dsimp [c]; linarith
    have hh₂_n'_tr : ‖h₂ - (inner ℝ h₂ n') • n'‖ ≤ θ * H' := by
      rw [hh₂_in_n']
      dsimp [h₂]
      rw [sub_self, norm_zero]
      nlinarith
    have hh₂_n_ax : |inner ℝ h₂ n| ≤ H := by
      have := h_inner_u n hn_norm h₂
      rw [hh₂_norm] at this
      dsimp [c] at this; linarith
    have hh₂_n_tr : ‖h₂ - (inner ℝ h₂ n) • n‖ ≤ θ * H := by
      have h_p := h_proj_u n hn_norm h₂ c
      have h_sub : h₂ - c • n = c • (n' - n) := by dsimp [h₂]; rw [smul_sub]
      have h_nm : ‖h₂ - c • n‖ = c * ‖n - n'‖ := by
        rw [h_sub, norm_smul, Real.norm_eq_abs, abs_of_pos hc_pos, norm_sub_rev]
      dsimp [c] at h_p h_nm ⊢
      nlinarith
    have h_eval2 := h_two_fit h₂ hh₂_n_ax hh₂_n_tr hh₂_n'_ax hh₂_n'_tr
    have h_in2 : |inner ℝ (P - P') h₂| = c * |inner ℝ (P - P') n'| := by
      dsimp [h₂]
      rw [real_inner_smul_right, abs_mul, abs_of_pos hc_pos]
    have h_ax_bound : |inner ℝ (P - P') n'| ≤ 288 * θ ^ 2 := by
      rw [h_in2] at h_eval2
      dsimp [c] at h_eval2
      nlinarith [sq_nonneg θ]
    exact h_finish hPP'_le12 h_ax_bound
  · 
    let dz : EuclideanSpace ℝ (Fin (d + 1)) := z' - z
    have hdz_fit : |U z' - U z - inner ℝ P dz| ≤ θ ^ 2 * H := by
      have h_z_add : z + dz = z' := add_sub_cancel z z'
      have hb := hfit.2 dz (by linarith) (by rw [hsqrt_θ]; nlinarith)
      rwa [h_z_add] at hb
    have h_three_fit : ∀ k : EuclideanSpace ℝ (Fin (d + 1)),
        |inner ℝ (dz + k) n| ≤ H → ‖(dz + k) - (inner ℝ (dz + k) n) • n‖ ≤ θ * H →
        |inner ℝ k n'| ≤ H → ‖k - (inner ℝ k n') • n'‖ ≤ θ * H →
        |inner ℝ (P - P') k| ≤ 3 * θ ^ 2 * H := by
      intro k hn_ax hn_tr hn'_ax hn'_tr
      have hb1 : |U (z + (dz + k)) - U z - inner ℝ P (dz + k)| ≤ θ ^ 2 * H := by
        apply hfit.2 (dz + k) hn_ax
        rwa [hsqrt_θ]
      have hb2 : |U (z' + k) - U z' - inner ℝ P' k| ≤ θ ^ 2 * H := by
        apply hfit'.2 k hn'_ax
        rwa [hsqrt_θ]
      have h_zk : z + (dz + k) = z' + k := by
        dsimp [dz]; abel
      rw [h_zk] at hb1
      have h_id : inner ℝ (P - P') k =
          (U (z' + k) - U z' - inner ℝ P' k) -
          (U (z' + k) - U z - inner ℝ P (dz + k)) +
          (U z' - U z - inner ℝ P dz) := by
        rw [inner_sub_left, inner_add_right]
        ring
      have h_abs1 : |(U (z' + k) - U z' - inner ℝ P' k) - (U (z' + k) - U z - inner ℝ P (dz + k))| ≤
          |U (z' + k) - U z' - inner ℝ P' k| + |U (z' + k) - U z - inner ℝ P (dz + k)| := by
        simpa using abs_sub (U (z' + k) - U z' - inner ℝ P' k) (U (z' + k) - U z - inner ℝ P (dz + k))
      have h_abs2 : |inner ℝ (P - P') k| ≤
          |(U (z' + k) - U z' - inner ℝ P' k) - (U (z' + k) - U z - inner ℝ P (dz + k))| +
          |U z' - U z - inner ℝ P dz| := by
        rw [h_id]
        exact abs_add_le _ _
      linarith
    have h_tr_add : ∀ k : EuclideanSpace ℝ (Fin (d + 1)),
        ‖(dz + k) - (inner ℝ (dz + k) n) • n‖ ≤
        ‖dz - (inner ℝ dz n) • n‖ + ‖k - (inner ℝ k n) • n‖ := by
      intro k
      have h_eq : (dz + k) - (inner ℝ (dz + k) n) • n =
          (dz - (inner ℝ dz n) • n) + (k - (inner ℝ k n) • n) := by
        rw [inner_add_left, add_smul]
        abel
      rw [h_eq]
      exact norm_add_le _ _
    have h_ball : ∀ k : EuclideanSpace ℝ (Fin (d + 1)), ‖k‖ ≤ θ * H / 4 →
        |inner ℝ (P - P') k| ≤ (12 * θ) * (θ * H / 4) := by
      intro k hk
      have hk_n_ax : |inner ℝ k n| ≤ θ * H / 4 := (h_inner_u n hn_norm k).trans hk
      have hn_ax : |inner ℝ (dz + k) n| ≤ H := by
        have h_add : |inner ℝ (dz + k) n| ≤ |inner ℝ dz n| + |inner ℝ k n| := by
          rw [inner_add_left]; exact abs_add_le _ _
        nlinarith
      have hn_tr : ‖(dz + k) - (inner ℝ (dz + k) n) • n‖ ≤ θ * H := by
        have h1 := h_tr_add k
        have h2 := (h_proj_le_norm n hn_norm k).trans hk
        nlinarith
      have hn'_ax : |inner ℝ k n'| ≤ H := by
        have := (h_inner_u n' hn'_norm k).trans hk
        nlinarith
      have hn'_tr : ‖k - (inner ℝ k n') • n'‖ ≤ θ * H := by
        have := (h_proj_le_norm n' hn'_norm k).trans hk
        nlinarith
      have := h_three_fit k hn_ax hn_tr hn'_ax hn'_tr
      linarith
    have hPP'_le12 : ‖P - P'‖ ≤ 12 * θ :=
      h_ball_to_norm (θ * H / 4) (12 * θ) (by nlinarith) (by linarith) h_ball
    have hnn'_le48 : ‖n - n'‖ ≤ 48 * θ := by linarith
    let c' : ℝ := H / 96
    have hc'_pos : 0 < c' := by dsimp [c']; linarith
    let k₂ : EuclideanSpace ℝ (Fin (d + 1)) := c' • n'
    have hk₂_norm : ‖k₂‖ = c' := by
      dsimp [k₂]
      rw [norm_smul, Real.norm_eq_abs, abs_of_pos hc'_pos, hn'_norm, mul_one]
    have hk₂_in_n' : inner ℝ k₂ n' = c' := by
      dsimp [k₂]
      rw [real_inner_smul_left, real_inner_self_eq_norm_mul_norm, hn'_norm, mul_one, mul_one]
    have hk₂_n'_ax : |inner ℝ k₂ n'| ≤ H := by
      rw [hk₂_in_n', abs_of_pos hc'_pos]
      dsimp [c']; linarith
    have hk₂_n'_tr : ‖k₂ - (inner ℝ k₂ n') • n'‖ ≤ θ * H := by
      rw [hk₂_in_n']
      dsimp [k₂]
      rw [sub_self, norm_zero]
      nlinarith
    have hk₂_n_ax : |inner ℝ (dz + k₂) n| ≤ H := by
      have h_add : |inner ℝ (dz + k₂) n| ≤ |inner ℝ dz n| + |inner ℝ k₂ n| := by
        rw [inner_add_left]; exact abs_add_le _ _
      have hk₂_ax : |inner ℝ k₂ n| ≤ c' := by
        have := h_inner_u n hn_norm k₂
        rwa [hk₂_norm] at this
      dsimp [c'] at hk₂_ax
      linarith
    have hk₂_n_tr : ‖(dz + k₂) - (inner ℝ (dz + k₂) n) • n‖ ≤ θ * H := by
      have h1 := h_tr_add k₂
      have h_p := h_proj_u n hn_norm k₂ c'
      have h_sub : k₂ - c' • n = c' • (n' - n) := by dsimp [k₂]; rw [smul_sub]
      have h_nm : ‖k₂ - c' • n‖ = c' * ‖n - n'‖ := by
        rw [h_sub, norm_smul, Real.norm_eq_abs, abs_of_pos hc'_pos, norm_sub_rev]
      dsimp [c'] at h_p h_nm ⊢
      nlinarith
    have h_eval2 := h_three_fit k₂ hk₂_n_ax hk₂_n_tr hk₂_n'_ax hk₂_n'_tr
    have h_in2 : |inner ℝ (P - P') k₂| = c' * |inner ℝ (P - P') n'| := by
      dsimp [k₂]
      rw [real_inner_smul_right, abs_mul, abs_of_pos hc'_pos]
    have h_ax_bound : |inner ℝ (P - P') n'| ≤ 288 * θ ^ 2 := by
      rw [h_in2] at h_eval2
      dsimp [c'] at h_eval2
      nlinarith [sq_nonneg θ]
    exact h_finish hPP'_le12 h_ax_bound

theorem admissible_cylinder_fits_of_selected_scales (d : ℕ) (hd : 3 ≤ d) (L : ℝ) (hL_ge : 1 ≤ L)
    (hL : HasUniformNormalizedLiftBounds d L)
    (u_seq : ℕ → EuclideanSpace ℝ (Fin d) → ℝ)
    (z_seq : ℕ → EuclideanSpace ℝ (Fin (d + 1)))
    (r_seq lam_seq : ℕ → ℝ)
    (h_scales : HasSelectedBlowupScales d u_seq z_seq r_seq lam_seq)
    (M : ℝ) (hM : 2 ≤ M) :
    ∃ i₁ : ℕ, ∀ i : ℕ, i₁ ≤ i →
      let θ := Real.sqrt (32 * lam_seq i)
      0 < θ ∧ θ < 1 / 2 ∧ θ ^ 2 = 32 * lam_seq i ∧
      ∀ z : EuclideanSpace ℝ (Fin (d + 1)), ‖z - z_seq i‖ ≤ M * r_seq i →
        ∀ r : ℝ, 0 < r → r ≤ M * r_seq i →
          ∃ P : EuclideanSpace ℝ (Fin (d + 1)),
            IsBoundedCylinderFitAt d L (liftFunc (u_seq i)) z r (θ ^ 2) P :=
by
  obtain ⟨i₁, hi₁⟩ := h_scales.2.2 M hM
  refine ⟨i₁, fun i hi => ?_⟩
  dsimp only
  obtain ⟨hu_i, _, _, _, hlam_pos, hlam_lt, _, _⟩ := h_scales.1 i
  have h32_pos : 0 < 32 * lam_seq i := by linarith
  have h32_lt1 : 32 * lam_seq i < 1 := by linarith
  have hθ_pos : 0 < Real.sqrt (32 * lam_seq i) := Real.sqrt_pos.mpr h32_pos
  have hθ_lt : Real.sqrt (32 * lam_seq i) < 1 / 2 := by
    exact (Real.sqrt_lt h32_pos.le (by norm_num)).mpr (by linarith)
  have hθ_sq : Real.sqrt (32 * lam_seq i) ^ 2 = 32 * lam_seq i :=
    Real.sq_sqrt h32_pos.le
  refine ⟨hθ_pos, hθ_lt, hθ_sq, fun z hz r hr_pos hr_le => ?_⟩
  obtain ⟨hz_ball, hr_adm, P, hP_fit⟩ := hi₁ i hi z hz r hr_pos hr_le
  obtain ⟨hP_norm_le, hP_time⟩ :=
    (hL (u_seq i) hu_i).2.2.2 z hz_ball r hr_pos hr_adm (32 * lam_seq i) h32_pos h32_lt1 P hP_fit
  have hP_upper : ‖P‖ ≤ L + 1 := by linarith
  have hP_time_ge : 1 / 2 ≤ projTime P := by
    have h1 := (abs_le.mp hP_time).1
    linarith
  have hP_coord_le : |projTime P| ≤ ‖P‖ := by
    simpa [projTime, Real.norm_eq_abs] using PiLp.norm_apply_le P (Fin.last d)
  have hP_lower : 1 / 2 ≤ ‖P‖ := by
    linarith [le_abs_self (projTime P)]
  refine ⟨P, ?_, hP_lower, hP_upper⟩
  rwa [hθ_sq]

theorem same_center_multi_scale_cylinder_comparison (d : ℕ) (hd : 3 ≤ d) (L C_comp : ℝ)
    (hC_comp : IsCylinderComparisonConstant d L C_comp)
    (U : EuclideanSpace ℝ (Fin (d + 1)) → ℝ)
    (z : EuclideanSpace ℝ (Fin (d + 1))) (M_rad θ : ℝ)
    (hθ_pos : 0 < θ) (hθ_lt : θ < 1 / 2)
    (h_fits : ∀ r : ℝ, 0 < r → r ≤ M_rad →
      ∃ P : EuclideanSpace ℝ (Fin (d + 1)), IsBoundedCylinderFitAt d L U z r (θ ^ 2) P)
    (k : ℕ) (H H' : ℝ)
    (hH_pos : 0 < H) (hH'_pos : 0 < H')
    (hH_le : H ≤ M_rad) (hH'_le : H' ≤ M_rad)
    (hHH' : H ≤ (2 : ℝ) ^ k * H') (hH'H : H' ≤ (2 : ℝ) ^ k * H)
    (P P' : EuclideanSpace ℝ (Fin (d + 1)))
    (hP : IsBoundedCylinderFitAt d L U z H (θ ^ 2) P)
    (hP' : IsBoundedCylinderFitAt d L U z H' (θ ^ 2) P') :
    ‖(‖P‖⁻¹) • P - (‖P'‖⁻¹) • P'‖ ≤ ((k : ℝ) + 1) * C_comp * θ ∧
    |‖P‖ - ‖P'‖| ≤ ((k : ℝ) + 1) * C_comp * θ ^ 2 :=
by
  obtain ⟨hC_pos, hC_body⟩ := hC_comp
  have h_single : ∀ (H₁ H₂ : ℝ) (P₁ P₂ : EuclideanSpace ℝ (Fin (d + 1))),
      0 < H₁ → H₁ ≤ H₂ → H₂ ≤ 2 * H₁ →
      IsBoundedCylinderFitAt d L U z H₁ (θ ^ 2) P₁ →
      IsBoundedCylinderFitAt d L U z H₂ (θ ^ 2) P₂ →
      ‖(‖P₁‖⁻¹) • P₁ - (‖P₂‖⁻¹) • P₂‖ ≤ C_comp * θ ∧
      |‖P₁‖ - ‖P₂‖| ≤ C_comp * θ ^ 2 := by
    intro H₁ H₂ P₁ P₂ hH₁_pos hH₁₂ hH₂_2H₁ hP₁ hP₂
    exact (hC_body U z z H₁ H₂ θ P₁ P₂ hθ_pos hθ_lt hP₁.2.1 hP₁.2.2 hP₂.2.1 hP₂.2.2
      (Or.inl ⟨rfl, hH₁_pos, hH₁₂, hH₂_2H₁, hP₁.1, hP₂.1⟩)).2
  have h_ord : ∀ (m : ℕ) (H₁ H₂ : ℝ) (P₁ P₂ : EuclideanSpace ℝ (Fin (d + 1))),
      0 < H₁ → H₁ ≤ H₂ → H₂ ≤ (2 : ℝ) ^ m * H₁ → H₂ ≤ M_rad →
      IsBoundedCylinderFitAt d L U z H₁ (θ ^ 2) P₁ →
      IsBoundedCylinderFitAt d L U z H₂ (θ ^ 2) P₂ →
      ‖(‖P₁‖⁻¹) • P₁ - (‖P₂‖⁻¹) • P₂‖ ≤ ((m : ℝ) + 1) * C_comp * θ ∧
      |‖P₁‖ - ‖P₂‖| ≤ ((m : ℝ) + 1) * C_comp * θ ^ 2 := by
    intro m
    induction m with
    | zero =>
      intro H₁ H₂ P₁ P₂ hH₁_pos hH₁₂ hH₂_pow hH₂_le hP₁ hP₂
      have hH₂_2H₁ : H₂ ≤ 2 * H₁ := by
        rw [pow_zero, one_mul] at hH₂_pow
        linarith
      obtain ⟨h_dir, h_norm⟩ := h_single H₁ H₂ P₁ P₂ hH₁_pos hH₁₂ hH₂_2H₁ hP₁ hP₂
      push_cast
      exact ⟨by linarith, by linarith⟩
    | succ m ih =>
      intro H₁ H₂ P₁ P₂ hH₁_pos hH₁₂ hH₂_pow hH₂_le hP₁ hP₂
      let H_mid : ℝ := (2 : ℝ) ^ m * H₁
      rcases le_total H₂ H_mid with h_le | h_ge
      · obtain ⟨h_dir, h_norm⟩ := ih H₁ H₂ P₁ P₂ hH₁_pos hH₁₂ h_le hH₂_le hP₁ hP₂
        have hCθ_nonneg : 0 ≤ C_comp * θ := by positivity
        have hCθ2_nonneg : 0 ≤ C_comp * θ ^ 2 := by positivity
        push_cast
        exact ⟨by linarith, by linarith⟩
      · have h_pow_ge1 : (1 : ℝ) ≤ (2 : ℝ) ^ m := one_le_pow₀ (by norm_num)
        have hH₁_mid : H₁ ≤ H_mid := by
          have h1 : 1 * H₁ ≤ (2 : ℝ) ^ m * H₁ :=
            mul_le_mul_of_nonneg_right h_pow_ge1 hH₁_pos.le
          dsimp [H_mid]
          linarith
        have hH_mid_pos : 0 < H_mid := hH₁_pos.trans_le hH₁_mid
        have hH_mid_le : H_mid ≤ M_rad := h_ge.trans hH₂_le
        have hH₂_2mid : H₂ ≤ 2 * H_mid := by
          have h_eq : (2 : ℝ) ^ (m + 1) * H₁ = 2 * H_mid := by
            dsimp [H_mid]
            rw [pow_succ']
            ring
          linarith
        obtain ⟨P_mid, hP_mid⟩ := h_fits H_mid hH_mid_pos hH_mid_le
        obtain ⟨h_dir1, h_norm1⟩ :=
          ih H₁ H_mid P₁ P_mid hH₁_pos hH₁_mid (le_refl _) hH_mid_le hP₁ hP_mid
        obtain ⟨h_dir2, h_norm2⟩ :=
          h_single H_mid H₂ P_mid P₂ hH_mid_pos h_ge hH₂_2mid hP_mid hP₂
        have h_dir_tri :
            ‖(‖P₁‖⁻¹) • P₁ - (‖P₂‖⁻¹) • P₂‖ ≤
              ‖(‖P₁‖⁻¹) • P₁ - (‖P_mid‖⁻¹) • P_mid‖ +
              ‖(‖P_mid‖⁻¹) • P_mid - (‖P₂‖⁻¹) • P₂‖ := by
          simpa only [sub_add_sub_cancel] using
            norm_add_le ((‖P₁‖⁻¹) • P₁ - (‖P_mid‖⁻¹) • P_mid)
              ((‖P_mid‖⁻¹) • P_mid - (‖P₂‖⁻¹) • P₂)
        have h_norm_tri := abs_sub_le ‖P₁‖ ‖P_mid‖ ‖P₂‖
        push_cast
        exact ⟨by linarith, by linarith⟩
  rcases le_total H H' with h_le | h_ge
  · exact h_ord k H H' P P' hH_pos h_le hH'H hH'_le hP hP'
  · obtain ⟨h_dir_rev, h_norm_rev⟩ := h_ord k H' H P' P hH'_pos h_ge hHH' hH_le hP' hP
    refine ⟨?_, ?_⟩
    · rw [norm_sub_rev]
      exact h_dir_rev
    · rw [abs_sub_comm]
      exact h_norm_rev

theorem displaced_box_center_cylinder_comparison (d : ℕ) (hd : 3 ≤ d) (L C_comp : ℝ)
    (hC_comp : IsCylinderComparisonConstant d L C_comp)
    (U : EuclideanSpace ℝ (Fin (d + 1)) → ℝ)
    (z₀ : EuclideanSpace ℝ (Fin (d + 1))) (r c lam K R B₁ : ℝ)
    (O : EuclideanSpace ℝ (Fin (d + 1)) ≃ₗᵢ[ℝ] EuclideanSpace ℝ (Fin (d + 1)))
    (P_base P_R : EuclideanSpace ℝ (Fin (d + 1)))
    (hr_pos : 0 < r) (hlam_pos : 0 < lam) (hlam_lt : lam < 1 / 128)
    (hK_pos : 0 < K) (hB₁_nonneg : 0 ≤ B₁)
    (hR_K : 8 * K ≤ R) (hR_B₁ : 4 * K * (1 + B₁) ≤ R)
    (hO_eb : O (mkSpaceTime 0 1) = (‖P_base‖⁻¹) • P_base)
    (hc_eq : c = ‖P_base‖)
    (hP_R : IsBoundedCylinderFitAt d L U z₀ (R * r) ((Real.sqrt (32 * lam)) ^ 2) P_R)
    (h_dir_R : ‖(‖P_R‖⁻¹) • P_R - (‖P_base‖⁻¹) • P_base‖ ≤ B₁ * Real.sqrt (32 * lam))
    (h_norm_R : |‖P_R‖ - c| ≤ B₁ * (Real.sqrt (32 * lam)) ^ 2)
    (x : EuclideanSpace ℝ (Fin d)) (t : ℝ)
    (hxt : ‖mkSpaceTime x t‖ ≤ K) :
    let z := z₀ + r • O (mkSpaceTime (Real.sqrt lam • x) t)
    let θ := Real.sqrt (32 * lam)
    ‖z - z₀‖ ≤ 2 * K * r ∧
    ∀ P_zR : EuclideanSpace ℝ (Fin (d + 1)),
      IsBoundedCylinderFitAt d L U z (R * r) (θ ^ 2) P_zR →
      ‖(‖P_zR‖⁻¹) • P_zR - (‖P_base‖⁻¹) • P_base‖ ≤ (B₁ + C_comp) * θ ∧
      |‖P_zR‖ - c| ≤ (B₁ + C_comp) * θ ^ 2 :=
by
  intro z θ
  have h_mk_decomp : ∀ (y : EuclideanSpace ℝ (Fin d)) (s : ℝ),
      mkSpaceTime y s = mkSpaceTime y 0 + s • mkSpaceTime 0 1 := by
    intro y s
    ext m
    refine Fin.lastCases ?_ ?_ m
    · simp [mkSpaceTime, Fin.snoc_last]
    · intro i
      simp [mkSpaceTime, Fin.snoc_castSucc]
  have h_mk_norm_sq : ∀ (y : EuclideanSpace ℝ (Fin d)) (s : ℝ),
      ‖mkSpaceTime y s‖ ^ 2 = ‖y‖ ^ 2 + s ^ 2 := by
    intro y s
    have h1 : ‖mkSpaceTime y s‖ ^ 2 = inner ℝ (mkSpaceTime y s) (mkSpaceTime y s) := by
      rw [real_inner_self_eq_norm_mul_norm, sq]
    have h2 : ‖y‖ ^ 2 = inner ℝ y y := by
      rw [real_inner_self_eq_norm_mul_norm, sq]
    rw [h1, h2, PiLp.inner_apply, PiLp.inner_apply, Fin.sum_univ_castSucc]
    simp [mkSpaceTime, Fin.snoc_castSucc, Fin.snoc_last, sq]
  have h_mk_norm_zero : ∀ y : EuclideanSpace ℝ (Fin d), ‖mkSpaceTime y 0‖ = ‖y‖ := by
    intro y
    have hsq : ‖mkSpaceTime y 0‖ ^ 2 = ‖y‖ ^ 2 := by
      rw [h_mk_norm_sq y 0]
      ring
    rw [← Real.sqrt_sq (norm_nonneg (mkSpaceTime y 0)), ← Real.sqrt_sq (norm_nonneg y), hsq]
  have h_mk_norm_le : ∀ (y : EuclideanSpace ℝ (Fin d)) (s : ℝ),
      ‖mkSpaceTime y s‖ ≤ ‖y‖ + |s| := by
    intro y s
    have h_nonneg : 0 ≤ ‖y‖ + |s| := add_nonneg (norm_nonneg y) (abs_nonneg s)
    have hsq : ‖mkSpaceTime y s‖ ^ 2 ≤ (‖y‖ + |s|) ^ 2 := by
      have h_mul : 0 ≤ 2 * ‖y‖ * |s| := by positivity
      have h_abs_sq : |s| ^ 2 = s ^ 2 := sq_abs s
      linarith [h_mk_norm_sq y s]
    have hsqrt := Real.sqrt_le_sqrt hsq
    rwa [Real.sqrt_sq (norm_nonneg (mkSpaceTime y s)), Real.sqrt_sq h_nonneg] at hsqrt
  have h_proj_u : ∀ (u h : EuclideanSpace ℝ (Fin (d + 1))) (α : ℝ),
      ‖u‖ = 1 → ‖h - (inner ℝ h u) • u‖ ≤ ‖h - α • u‖ := by
    intro u h α hu
    let s : ℝ := inner ℝ h u
    have h_expand : ∀ β : ℝ, ‖h - β • u‖ ^ 2 = ‖h‖ ^ 2 - 2 * (β * s) + β ^ 2 := by
      intro β
      have h_sub := norm_sub_sq_real h (β • u)
      have h_in : inner ℝ h (β • u) = β * s := real_inner_smul_right h u β
      have h_nm : ‖β • u‖ ^ 2 = β ^ 2 := by
        rw [norm_smul, Real.norm_eq_abs, hu, mul_one, sq_abs]
      linarith
    have h_sq_le : ‖h - s • u‖ ^ 2 ≤ ‖h - α • u‖ ^ 2 := by
      have h1 := h_expand s
      have h2 := h_expand α
      have h3 : 0 ≤ (s - α) ^ 2 := sq_nonneg (s - α)
      nlinarith
    have hsqrt := Real.sqrt_le_sqrt h_sq_le
    rwa [Real.sqrt_sq (norm_nonneg (h - s • u)), Real.sqrt_sq (norm_nonneg (h - α • u))] at hsqrt
  have h32_pos : 0 < 32 * lam := by linarith
  have h32_lt : 32 * lam < (1 / 2 : ℝ) ^ 2 := by linarith
  have hθ_pos : 0 < θ := Real.sqrt_pos.mpr h32_pos
  have hθ_lt : θ < 1 / 2 := by
    have h1 : Real.sqrt (32 * lam) < Real.sqrt ((1 / 2 : ℝ) ^ 2) :=
      Real.sqrt_lt_sqrt h32_pos.le h32_lt
    have h2 : Real.sqrt ((1 / 2 : ℝ) ^ 2) = 1 / 2 := Real.sqrt_sq (by norm_num)
    dsimp [θ]
    linarith
  have hsqrt_lam_nonneg : 0 ≤ Real.sqrt lam := Real.sqrt_nonneg lam
  have hsqrt_lam_le_one : Real.sqrt lam ≤ 1 := by
    have h1 : Real.sqrt lam ≤ Real.sqrt 1 := Real.sqrt_le_sqrt (by linarith)
    rwa [Real.sqrt_one] at h1
  have hsqrt_lam_le_θ : Real.sqrt lam ≤ θ := Real.sqrt_le_sqrt (by linarith)
  have hR_pos : 0 < R := by linarith
  have hHR_pos : 0 < R * r := mul_pos hR_pos hr_pos
  have hxt_sq : ‖x‖ ^ 2 + t ^ 2 ≤ K ^ 2 := by
    have h1 : ‖mkSpaceTime x t‖ ^ 2 ≤ K ^ 2 := by
      nlinarith [norm_nonneg (mkSpaceTime x t)]
    linarith [h_mk_norm_sq x t]
  have hx_le_K : ‖x‖ ≤ K := by
    have hsq : ‖x‖ ^ 2 ≤ K ^ 2 := by linarith [sq_nonneg t]
    have hsqrt := Real.sqrt_le_sqrt hsq
    rwa [Real.sqrt_sq (norm_nonneg x), Real.sqrt_sq hK_pos.le] at hsqrt
  have ht_le_K : |t| ≤ K := by
    have hsq : |t| ^ 2 ≤ K ^ 2 := by linarith [sq_nonneg ‖x‖, sq_abs t]
    have hsqrt := Real.sqrt_le_sqrt hsq
    rwa [Real.sqrt_sq (abs_nonneg t), Real.sqrt_sq hK_pos.le] at hsqrt
  let dz : EuclideanSpace ℝ (Fin (d + 1)) := z - z₀
  have hdz_eq : dz = r • O (mkSpaceTime (Real.sqrt lam • x) t) := by
    dsimp [dz, z]
    exact add_sub_cancel_left z₀ (r • O (mkSpaceTime (Real.sqrt lam • x) t))
  have h_norm_lam_x : ‖Real.sqrt lam • x‖ = Real.sqrt lam * ‖x‖ := by
    rw [norm_smul, Real.norm_of_nonneg hsqrt_lam_nonneg]
  have hdz_norm : ‖z - z₀‖ ≤ 2 * K * r := by
    change ‖dz‖ ≤ 2 * K * r
    rw [hdz_eq, norm_smul, Real.norm_of_nonneg hr_pos.le, O.norm_map]
    have h1 : ‖mkSpaceTime (Real.sqrt lam • x) t‖ ≤ Real.sqrt lam * ‖x‖ + |t| := by
      simpa [h_norm_lam_x] using h_mk_norm_le (Real.sqrt lam • x) t
    have h2 : Real.sqrt lam * ‖x‖ + |t| ≤ 2 * K := by
      nlinarith [norm_nonneg x]
    nlinarith
  refine ⟨hdz_norm, ?_⟩
  intro P_zR hP_zR
  obtain ⟨hP_R_fit, hP_R_low, hP_R_high⟩ := hP_R
  obtain ⟨hP_zR_fit, hP_zR_low, hP_zR_high⟩ := hP_zR
  let n_R : EuclideanSpace ℝ (Fin (d + 1)) := (‖P_R‖⁻¹) • P_R
  let n₀ : EuclideanSpace ℝ (Fin (d + 1)) := (‖P_base‖⁻¹) • P_base
  let n_zR : EuclideanSpace ℝ (Fin (d + 1)) := (‖P_zR‖⁻¹) • P_zR
  have hn_R_norm : ‖n_R‖ = 1 := by
    dsimp [n_R]
    rw [norm_smul, Real.norm_eq_abs, abs_inv, abs_norm, inv_mul_cancel₀ (by linarith)]
  have h_ax_offset : |inner ℝ (z - z₀) n_R| ≤ (R * r) / 4 := by
    have hcs : |inner ℝ (z - z₀) n_R| ≤ ‖z - z₀‖ * ‖n_R‖ := abs_real_inner_le_norm (z - z₀) n_R
    rw [hn_R_norm, mul_one] at hcs
    have h_2Kr : 2 * K * r ≤ (R * r) / 4 := by nlinarith
    linarith
  have h_tr_offset : ‖(z - z₀) - (inner ℝ (z - z₀) n_R) • n_R‖ ≤ θ * (R * r) / 4 := by
    change ‖dz - (inner ℝ dz n_R) • n_R‖ ≤ θ * (R * r) / 4
    have h_min : ‖dz - (inner ℝ dz n_R) • n_R‖ ≤ ‖dz - (r * t) • n_R‖ :=
      h_proj_u n_R dz (r * t) hn_R_norm
    have hdz_split : dz - (r * t) • n_R =
        r • O (mkSpaceTime (Real.sqrt lam • x) 0) + (r * t) • (n₀ - n_R) := by
      rw [hdz_eq, h_mk_decomp (Real.sqrt lam • x) t, O.map_add, O.map_smul, hO_eb]
      change r • (O (mkSpaceTime (Real.sqrt lam • x) 0) + t • n₀) - (r * t) • n_R =
        r • O (mkSpaceTime (Real.sqrt lam • x) 0) + (r * t) • (n₀ - n_R)
      rw [smul_add, smul_smul, smul_sub]
      abel
    have h_tri : ‖dz - (r * t) • n_R‖ ≤
        ‖r • O (mkSpaceTime (Real.sqrt lam • x) 0)‖ + ‖(r * t) • (n₀ - n_R)‖ := by
      rw [hdz_split]
      exact norm_add_le _ _
    have h_term1 : ‖r • O (mkSpaceTime (Real.sqrt lam • x) 0)‖ = r * (Real.sqrt lam * ‖x‖) := by
      rw [norm_smul, Real.norm_of_nonneg hr_pos.le, O.norm_map, h_mk_norm_zero, h_norm_lam_x]
    have h_term2 : ‖(r * t) • (n₀ - n_R)‖ = r * |t| * ‖n_R - n₀‖ := by
      rw [norm_smul, Real.norm_eq_abs, abs_mul, abs_of_pos hr_pos, norm_sub_rev n₀ n_R]
    have h_term1_le : r * (Real.sqrt lam * ‖x‖) ≤ r * (θ * K) := by
      have h1 : Real.sqrt lam * ‖x‖ ≤ θ * K :=
        mul_le_mul hsqrt_lam_le_θ hx_le_K (norm_nonneg x) hθ_pos.le
      exact mul_le_mul_of_nonneg_left h1 hr_pos.le
    have h_dir_R' : ‖n_R - n₀‖ ≤ B₁ * θ := h_dir_R
    have h_term2_le : r * |t| * ‖n_R - n₀‖ ≤ r * K * (B₁ * θ) := by
      have h1 : r * |t| ≤ r * K := mul_le_mul_of_nonneg_left ht_le_K hr_pos.le
      exact mul_le_mul h1 h_dir_R' (norm_nonneg _) (by positivity)
    have h_R_bound : r * (θ * K) + r * K * (B₁ * θ) ≤ θ * (R * r) / 4 := by
      have h1 : 4 * K * (1 + B₁) * (θ * r) ≤ R * (θ * r) :=
        mul_le_mul_of_nonneg_right hR_B₁ (by positivity)
      linarith
    linarith
  have h_comp_res :=
    hC_comp.2 U z₀ z (R * r) (R * r) θ P_R P_zR
      hθ_pos hθ_lt hP_R_low hP_R_high hP_zR_low hP_zR_high
      (Or.inr ⟨rfl, hHR_pos, h_ax_offset, h_tr_offset, hP_R_fit, hP_zR_fit⟩)
  obtain ⟨_, h_dir_comp, h_norm_comp⟩ := h_comp_res
  have h_dir_final : ‖n_zR - n₀‖ ≤ (B₁ + C_comp) * θ := by
    have h1 : ‖n_zR - n_R‖ ≤ C_comp * θ := by
      rw [norm_sub_rev]
      exact h_dir_comp
    have h2 : ‖n_zR - n₀‖ ≤ ‖n_zR - n_R‖ + ‖n_R - n₀‖ := by
      simpa only [sub_add_sub_cancel] using norm_add_le (n_zR - n_R) (n_R - n₀)
    have h3 : ‖n_R - n₀‖ ≤ B₁ * θ := h_dir_R
    linarith
  have h_norm_final : |‖P_zR‖ - c| ≤ (B₁ + C_comp) * θ ^ 2 := by
    have h1 : |‖P_zR‖ - ‖P_R‖| ≤ C_comp * θ ^ 2 := by
      rw [abs_sub_comm]
      exact h_norm_comp
    have h2 : |‖P_zR‖ - c| ≤ |‖P_zR‖ - ‖P_R‖| + |‖P_R‖ - c| :=
      abs_sub_le ‖P_zR‖ ‖P_R‖ c
    have h3 : |‖P_R‖ - c| ≤ B₁ * θ ^ 2 := h_norm_R
    linarith
  exact ⟨h_dir_final, h_norm_final⟩

theorem sheared_box_fit_of_cylinder_fit_and_slope_bounds (d : ℕ) (hd : 3 ≤ d) (L : ℝ) (hL_ge : 1 ≤ L)
    (U : EuclideanSpace ℝ (Fin (d + 1)) → ℝ)
    (z₀ : EuclideanSpace ℝ (Fin (d + 1))) (r c lam S B : ℝ)
    (O : EuclideanSpace ℝ (Fin (d + 1)) ≃ₗᵢ[ℝ] EuclideanSpace ℝ (Fin (d + 1)))
    (P_base P : EuclideanSpace ℝ (Fin (d + 1)))
    (hr_pos : 0 < r) (hc_lower : 1 / 2 ≤ c) (hc_upper : c ≤ L + 1)
    (hlam_pos : 0 < lam) (hlam_lt : lam < 1 / 128)
    (hS_pos : 0 < S) (hB_nonneg : 0 ≤ B)
    (hO_eb : O (mkSpaceTime 0 1) = (‖P_base‖⁻¹) • P_base)
    (x : EuclideanSpace ℝ (Fin d)) (t : ℝ)
    (hP : IsBoundedCylinderFitAt d L U (z₀ + r • O (mkSpaceTime (Real.sqrt lam • x) t)) (S * r) (32 * lam) P)
    (h_dir : ‖(‖P‖⁻¹) • P - (‖P_base‖⁻¹) • P_base‖ ≤ B * Real.sqrt (32 * lam))
    (h_norm : |‖P‖ - c| ≤ B * (32 * lam))
    (hlam_small : lam * ((2 * Real.sqrt 32 * (L + 1) * B + 32 * (L + 1) * B ^ 2 + 64 * B) + 1) ^ 2 ≤ 1 / 64) :
    let C_BL := 2 * Real.sqrt 32 * (L + 1) * B + 32 * (L + 1) * B ^ 2 + 64 * B
    ∃ (p' : EuclideanSpace ℝ (Fin d)) (q' : ℝ),
      ‖p'‖ + |q'| ≤ C_BL ∧
      1 / 2 ≤ 1 + lam * q' ∧
      ∀ (h : EuclideanSpace ℝ (Fin d)) (ℓ : ℝ),
        |ℓ| ≤ S / 2 →
        ‖h - ((1 + lam * q')⁻¹ * ℓ) • p'‖ ≤ S →
        |anisotropicRescale U z₀ r c lam O (mkSpaceTime (x + h) (t + ℓ)) -
          anisotropicRescale U z₀ r c lam O (mkSpaceTime x t) -
          inner ℝ p' h - q' * ℓ| ≤ 64 * S :=
by
  intro C_BL
  have h_projSpace_apply : ∀ (z : EuclideanSpace ℝ (Fin (d + 1))) (m : Fin d),
      projSpace z m = z (Fin.castSucc m) := fun _ _ => rfl
  have h_projTime_apply : ∀ (z : EuclideanSpace ℝ (Fin (d + 1))),
      projTime z = z (Fin.last d) := fun _ => rfl
  have h_projSpace_mk : ∀ (x : EuclideanSpace ℝ (Fin d)) (t : ℝ),
      projSpace (mkSpaceTime x t) = x := by
    intro x t
    ext m
    simp [projSpace, mkSpaceTime, Fin.snoc_castSucc]
  have h_projTime_mk : ∀ (x : EuclideanSpace ℝ (Fin d)) (t : ℝ),
      projTime (mkSpaceTime x t) = t := by
    intro x t
    simp [projTime, mkSpaceTime, Fin.snoc_last]
  have h_mk_proj : ∀ (w : EuclideanSpace ℝ (Fin (d + 1))),
      mkSpaceTime (projSpace w) (projTime w) = w := by
    intro w
    ext m
    refine Fin.lastCases ?_ ?_ m
    · simp [mkSpaceTime, projTime, Fin.snoc_last]
    · intro m'
      simp [mkSpaceTime, projSpace, Fin.snoc_castSucc]
  have h_projSpace_add : ∀ (w₁ w₂ : EuclideanSpace ℝ (Fin (d + 1))),
      projSpace (w₁ + w₂) = projSpace w₁ + projSpace w₂ := by
    intro w₁ w₂; ext m; rfl
  have h_projSpace_sub : ∀ (w₁ w₂ : EuclideanSpace ℝ (Fin (d + 1))),
      projSpace (w₁ - w₂) = projSpace w₁ - projSpace w₂ := by
    intro w₁ w₂; ext m; rfl
  have h_projSpace_smul : ∀ (a : ℝ) (w : EuclideanSpace ℝ (Fin (d + 1))),
      projSpace (a • w) = a • projSpace w := by
    intro a w; ext m; rfl
  have h_projTime_add : ∀ (w₁ w₂ : EuclideanSpace ℝ (Fin (d + 1))),
      projTime (w₁ + w₂) = projTime w₁ + projTime w₂ := fun _ _ => rfl
  have h_projTime_sub : ∀ (w₁ w₂ : EuclideanSpace ℝ (Fin (d + 1))),
      projTime (w₁ - w₂) = projTime w₁ - projTime w₂ := fun _ _ => rfl
  have h_projTime_smul : ∀ (a : ℝ) (w : EuclideanSpace ℝ (Fin (d + 1))),
      projTime (a • w) = a * projTime w := fun _ _ => rfl
  have h_mk_add : ∀ (x₁ x₂ : EuclideanSpace ℝ (Fin d)) (t₁ t₂ : ℝ),
      mkSpaceTime (x₁ + x₂) (t₁ + t₂) = mkSpaceTime x₁ t₁ + mkSpaceTime x₂ t₂ := by
    intro x₁ x₂ t₁ t₂
    rw [← h_mk_proj (mkSpaceTime x₁ t₁ + mkSpaceTime x₂ t₂),
      h_projSpace_add, h_projTime_add, h_projSpace_mk, h_projSpace_mk,
      h_projTime_mk, h_projTime_mk]
  have h_mk_smul : ∀ (a : ℝ) (x : EuclideanSpace ℝ (Fin d)) (t : ℝ),
      a • mkSpaceTime x t = mkSpaceTime (a • x) (a * t) := by
    intro a x t
    rw [← h_mk_proj (a • mkSpaceTime x t),
      h_projSpace_smul, h_projTime_smul, h_projSpace_mk, h_projTime_mk]
  have h_inner_split : ∀ (w₁ w₂ : EuclideanSpace ℝ (Fin (d + 1))),
      inner ℝ w₁ w₂ = inner ℝ (projSpace w₁) (projSpace w₂) + projTime w₁ * projTime w₂ := by
    intro w₁ w₂
    rw [PiLp.inner_apply, PiLp.inner_apply, Fin.sum_univ_castSucc]
    simp only [h_projSpace_apply, h_projTime_apply, RCLike.inner_apply, conj_trivial]
    ring
  have h_norm_sq : ∀ (w : EuclideanSpace ℝ (Fin (d + 1))),
      ‖w‖ ^ 2 = ‖projSpace w‖ ^ 2 + (projTime w) ^ 2 := by
    intro w
    have h1 := h_inner_split w w
    rw [real_inner_self_eq_norm_mul_norm, real_inner_self_eq_norm_mul_norm] at h1
    linarith [sq ‖w‖, sq ‖projSpace w‖, sq (projTime w)]
  have h_norm_projSpace_le : ∀ (w : EuclideanSpace ℝ (Fin (d + 1))),
      ‖projSpace w‖ ≤ ‖w‖ := by
    intro w
    have hsq : ‖projSpace w‖ ^ 2 ≤ ‖w‖ ^ 2 := by
      rw [h_norm_sq w]
      linarith [sq_nonneg (projTime w)]
    exact (abs_le_of_sq_le_sq' hsq (norm_nonneg w)).2
  have h_abs_projTime_le : ∀ (w : EuclideanSpace ℝ (Fin (d + 1))),
      |projTime w| ≤ ‖w‖ := by
    intro w
    have hsq : |projTime w| ^ 2 ≤ ‖w‖ ^ 2 := by
      rw [sq_abs, h_norm_sq w]
      linarith [sq_nonneg ‖projSpace w‖]
    exact (abs_le_of_sq_le_sq' hsq (norm_nonneg w)).2
  have h_norm_mk_le : ∀ (x : EuclideanSpace ℝ (Fin d)) (t : ℝ),
      ‖mkSpaceTime x t‖ ≤ ‖x‖ + |t| := by
    intro x t
    have hsq : ‖mkSpaceTime x t‖ ^ 2 ≤ (‖x‖ + |t|) ^ 2 := by
      rw [h_norm_sq (mkSpaceTime x t), h_projSpace_mk, h_projTime_mk]
