    have h54_k_ge_1 : (1 : ℝ) ≤ (5 / 4 : ℝ) ^ k := one_le_pow₀ (by norm_num)
    have h54_succ : (5 / 4 : ℝ) ^ k = (5 / 4 : ℝ) * (5 / 4 : ℝ) ^ n := pow_succ' (5 / 4 : ℝ) n
