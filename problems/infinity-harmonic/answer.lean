        (w (mkSpaceTime (0 + h) (1 + ℓ)) - w (mkSpaceTime 0 1) -
          inner ℝ p h - (a - ‖p‖ ^ 2 / 2) * ℓ) -
        (w (mkSpaceTime (0 + h) (1 + ℓ)) - w (mkSpaceTime 0 1) -
          inner ℝ p' h - (a' - ‖p'‖ ^ 2 / 2) * ℓ) =
        (a' - a - ‖p' - p‖ ^ 2 / 2) * ℓ := by
      rw [h_ip1, h_ip2, h_norm_sub]
      ring
    have h3R : 3 * C₁ * R = (3 * C₁ * (1 + 3 * C₁)) * ℓ := by
      rw [← hℓ_mul]
      ring
    have h_bd_low : (-(3 * C₁ * (1 + 3 * C₁))) * ℓ ≤ (a' - a - ‖p' - p‖ ^ 2 / 2) * ℓ := by
