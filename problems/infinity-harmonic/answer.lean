        dsimp [ρ₂]
        linarith
      have hv2 : |v (mkSpaceTime x t)| ≤ M₂ := by
        apply hM₂
        have hrPr : 0 ≤ r * P_r := mul_nonneg (le_of_lt hr) hP_r_nonneg
        dsimp [ρ₂]
        linarith
      rw [h_inner] at h_eval
      have hp_sq : ‖p‖ ^ 2 ≤ P_r ^ 2 := by nlinarith [norm_nonneg p]
      have h_Ar : A_r * r = 2 * M₂ + C₁ * r + P_r ^ 2 / 2 * r := by
        dsimp [A_r]
        have hr_ne : r ≠ 0 := ne_of_gt hr
