    have hℓ_mul : ℓ * (1 + 3 * C₁) = R := div_mul_cancel₀ R (ne_of_gt h_denom_pos)
    have hℓ_le_R : ℓ ≤ R := by nlinarith
    have hℓ_abs_R : |ℓ| ≤ R := by rw [abs_of_pos hℓ_pos]; exact hℓ_le_R
    have hℓ_abs_2R : |ℓ| ≤ 2 * R := by rw [abs_of_pos hℓ_pos]; linarith
    let h : EuclideanSpace ℝ (Fin d) := ℓ • p
