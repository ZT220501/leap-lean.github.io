  have hr_v_pos : 0 < r_v := by positivity
  let S_v : Set E3 := Metric.closedBall (0 : E3) r_v
  let F : E3 → E3 := fun v => if hv : v ∈ S_v then Classical.choose (h_s1 v hv) else 0
  have hF_spec : ∀ v ∈ S_v,
      F v 0 ∈ Metric.closedBall (0 : E) (7 * δ / 8) ∧
      F v 1 ∈ Metric.closedBall (0 : E) (7 * δ / 8) ∧
      F v 2 ∈ Metric.closedBall (0 : E) (7 * δ / 8) ∧
      ∀ ξ₁ ∈ Metric.closedBall (0 : E) δ,
        ∀ ξ₂ ∈ Metric.closedBall (0 : E) δ,
          ∀ ξ₃ ∈ Metric.closedBall (0 : E) δ,
            (u_hat₁ ξ₁ + inner ℝ (v 0) ξ₁) +
              (u_hat₂ ξ₂ + inner ℝ (v 1) ξ₂) +
              (u_hat₃ ξ₃ + inner ℝ (v 2) ξ₃) -
              threePointQuadForm e_hat α' β' γ' (K' + η) ξ₁ ξ₂ ξ₃ ≤
            (u_hat₁ (F v 0) + inner ℝ (v 0) (F v 0)) +
              (u_hat₂ (F v 1) + inner ℝ (v 1) (F v 1)) +
              (u_hat₃ (F v 2) + inner ℝ (v 2) (F v 2)) -
              threePointQuadForm e_hat α' β' γ' (K' + η) (F v 0) (F v 1) (F v 2) := by
    intro v hv
    have h_eq : F v = Classical.choose (h_s1 v hv) := dif_pos hv
    rw [h_eq]
    exact Classical.choose_spec (h_s1 v hv)
  let q₀ : E3 → E := fun v =>
    threePointQuadGrad₁ e_hat α' β' γ' (K' + η) (F v 0) (F v 1) (F v 2) - v 0
  let q₁ : E3 → E := fun v =>
    threePointQuadGrad₂ e_hat α' β' γ' (K' + η) (F v 0) (F v 1) (F v 2) - v 1
  let q₂ : E3 → E := fun v =>
    threePointQuadGrad₃ γ' (K' + η) (F v 0) (F v 1) (F v 2) - v 2
  have h78_le : 7 * δ / 8 ≤ δ := by linarith
  have hF_ub : ∀ v ∈ S_v,
      (∀ z ∈ Metric.closedBall (0 : E) δ,
        u_hat₁ z - u_hat₁ (F v 0) - inner ℝ (q₀ v) (z - F v 0) ≤ C_Q * ‖z - F v 0‖ ^ 2) ∧
      (∀ z ∈ Metric.closedBall (0 : E) δ,
        u_hat₂ z - u_hat₂ (F v 1) - inner ℝ (q₁ v) (z - F v 1) ≤ C_Q * ‖z - F v 1‖ ^ 2) ∧
      (∀ z ∈ Metric.closedBall (0 : E) δ,
        u_hat₃ z - u_hat₃ (F v 2) - inner ℝ (q₂ v) (z - F v 2) ≤ C_Q * ‖z - F v 2‖ ^ 2) := by
    intro v hv
    obtain ⟨h0_78, h1_78, h2_78, hmax⟩ := hF_spec v hv
    have h0_cb : F v 0 ∈ Metric.closedBall (0 : E) δ :=
      Metric.closedBall_subset_closedBall h78_le h0_78
    have h1_cb : F v 1 ∈ Metric.closedBall (0 : E) δ :=
      Metric.closedBall_subset_closedBall h78_le h1_78
    have h2_cb : F v 2 ∈ Metric.closedBall (0 : E) δ :=
      Metric.closedBall_subset_closedBall h78_le h2_78
    have h_star : ∀ h₁ h₂ h₃ : E,
        F v 0 + h₁ ∈ Metric.closedBall (0 : E) δ →
        F v 1 + h₂ ∈ Metric.closedBall (0 : E) δ →
        F v 2 + h₃ ∈ Metric.closedBall (0 : E) δ →
        (u_hat₁ (F v 0 + h₁) - u_hat₁ (F v 0) - inner ℝ (q₀ v) h₁) +
          (u_hat₂ (F v 1 + h₂) - u_hat₂ (F v 1) - inner ℝ (q₁ v) h₂) +
          (u_hat₃ (F v 2 + h₃) - u_hat₃ (F v 2) - inner ℝ (q₂ v) h₃) ≤
            threePointQuadForm e_hat α' β' γ' (K' + η) h₁ h₂ h₃ := by
      intro h₁ h₂ h₃ hh₁ hh₂ hh₃
      have hm := hmax (F v 0 + h₁) hh₁ (F v 1 + h₂) hh₂ (F v 2 + h₃) hh₃
      have ht := h_taylor (F v 0) (F v 1) (F v 2) h₁ h₂ h₃
      have hi₁ : inner ℝ (q₀ v) h₁ =
          inner ℝ (threePointQuadGrad₁ e_hat α' β' γ' (K' + η) (F v 0) (F v 1) (F v 2)) h₁ -
            inner ℝ (v 0) h₁ := inner_sub_left _ _ _
      have hi₂ : inner ℝ (q₁ v) h₂ =
          inner ℝ (threePointQuadGrad₂ e_hat α' β' γ' (K' + η) (F v 0) (F v 1) (F v 2)) h₂ -
            inner ℝ (v 1) h₂ := inner_sub_left _ _ _
      have hi₃ : inner ℝ (q₂ v) h₃ =
          inner ℝ (threePointQuadGrad₃ γ' (K' + η) (F v 0) (F v 1) (F v 2)) h₃ -
            inner ℝ (v 2) h₃ := inner_sub_left _ _ _
      have hv₁_add : inner ℝ (v 0) (F v 0 + h₁) = inner ℝ (v 0) (F v 0) + inner ℝ (v 0) h₁ :=
        inner_add_right _ _ _
      have hv₂_add : inner ℝ (v 1) (F v 1 + h₂) = inner ℝ (v 1) (F v 1) + inner ℝ (v 1) h₂ :=
        inner_add_right _ _ _
      have hv₃_add : inner ℝ (v 2) (F v 2 + h₃) = inner ℝ (v 2) (F v 2) + inner ℝ (v 2) h₃ :=
        inner_add_right _ _ _
      linarith
    refine ⟨?_, ?_, ?_⟩
    · intro z hz
      have hz_add : F v 0 + (z - F v 0) ∈ Metric.closedBall (0 : E) δ := by
        simpa [add_sub_cancel] using hz
      have hs := h_star (z - F v 0) 0 0 hz_add (by simpa using h1_cb) (by simpa using h2_cb)
      rw [add_sub_cancel, add_zero, add_zero, inner_zero_right, inner_zero_right] at hs
      have hq := le_trans (le_abs_self _) (h_quad (z - F v 0) 0 0)
      rw [norm_zero] at hq
      linarith
    · intro z hz
      have hz_add : F v 1 + (z - F v 1) ∈ Metric.closedBall (0 : E) δ := by
        simpa [add_sub_cancel] using hz
      have hs := h_star 0 (z - F v 1) 0 (by simpa using h0_cb) hz_add (by simpa using h2_cb)
      rw [add_zero, add_sub_cancel, add_zero, inner_zero_right, inner_zero_right] at hs
      have hq := le_trans (le_abs_self _) (h_quad 0 (z - F v 1) 0)
      rw [norm_zero] at hq
      linarith
    · intro z hz
      have hz_add : F v 2 + (z - F v 2) ∈ Metric.closedBall (0 : E) δ := by
        simpa [add_sub_cancel] using hz
      have hs := h_star 0 0 (z - F v 2) (by simpa using h0_cb) (by simpa using h1_cb) hz_add
      rw [add_zero, add_zero, add_sub_cancel, inner_zero_right, inner_zero_right] at hs
      have hq := le_trans (le_abs_self _) (h_quad 0 0 (z - F v 2))
      rw [norm_zero] at hq
      linarith
  let Λ : ℝ := 70 * C_Q + 16 * lam
  have hΛ_pos : 0 < Λ := by positivity
  have hF_rev_lip : ∀ v ∈ S_v, ∀ v' ∈ S_v, ‖v - v'‖ ≤ Λ * ‖F v - F v'‖ := by
    intro v hv v' hv'
    obtain ⟨h0_78, h1_78, h2_78, _⟩ := hF_spec v hv
    obtain ⟨h0_78', h1_78', h2_78', _⟩ := hF_spec v' hv'
    obtain ⟨hub₀, hub₁, hub₂⟩ := hF_ub v hv
    obtain ⟨hub₀', hub₁', hub₂'⟩ := hF_ub v' hv'
    have hq₀_lip := h_s2 u_hat₁ hconv₁ (F v 0) (F v' 0) (q₀ v) (q₀ v') h0_78 h0_78' hub₀ hub₀'
    have hq₁_lip := h_s2 u_hat₂ hconv₂ (F v 1) (F v' 1) (q₁ v) (q₁ v') h1_78 h1_78' hub₁ hub₁'
    have hq₂_lip := h_s2 u_hat₃ hconv₃ (F v 2) (F v' 2) (q₂ v) (q₂ v') h2_78 h2_78' hub₂ hub₂'
    have hF0_le : ‖F v 0 - F v' 0‖ ≤ ‖F v - F v'‖ := norm_le_pi_norm (F v - F v') 0
    have hF1_le : ‖F v 1 - F v' 1‖ ≤ ‖F v - F v'‖ := norm_le_pi_norm (F v - F v') 1
    have hF2_le : ‖F v 2 - F v' 2‖ ≤ ‖F v - F v'‖ := norm_le_pi_norm (F v - F v') 2
    have h_sum_F : 2 * C_Q * (‖F v 0 - F v' 0‖ + ‖F v 1 - F v' 1‖ + ‖F v 2 - F v' 2‖) ≤
        6 * C_Q * ‖F v - F v'‖ := by
      have h_s : ‖F v 0 - F v' 0‖ + ‖F v 1 - F v' 1‖ + ‖F v 2 - F v' 2‖ ≤ 3 * ‖F v - F v'‖ := by
        linarith
      have := mul_le_mul_of_nonneg_left h_s (by positivity : 0 ≤ 2 * C_Q)
      linarith
    obtain ⟨hg₀_lip, hg₁_lip, hg₂_lip⟩ := h_lip (F v 0) (F v 1) (F v 2) (F v' 0) (F v' 1) (F v' 2)
    have h_coeff_pos : 0 ≤ 64 * C_Q + 16 * lam := by positivity
    have hv₀_le : ‖(v - v') 0‖ ≤ Λ * ‖F v - F v'‖ := by
      have h_eq : (v - v') 0 =
          (threePointQuadGrad₁ e_hat α' β' γ' (K' + η) (F v 0) (F v 1) (F v 2) -
           threePointQuadGrad₁ e_hat α' β' γ' (K' + η) (F v' 0) (F v' 1) (F v' 2)) -
          (q₀ v - q₀ v') := by
        change v 0 - v' 0 = _
        dsimp [q₀]
        abel
      rw [h_eq]
      have h_tri := norm_sub_le
        (threePointQuadGrad₁ e_hat α' β' γ' (K' + η) (F v 0) (F v 1) (F v 2) -
         threePointQuadGrad₁ e_hat α' β' γ' (K' + η) (F v' 0) (F v' 1) (F v' 2))
        (q₀ v - q₀ v')
      have hq₀_pi : ‖q₀ v - q₀ v'‖ ≤ (64 * C_Q + 16 * lam) * ‖F v - F v'‖ :=
        le_trans hq₀_lip (mul_le_mul_of_nonneg_left hF0_le h_coeff_pos)
      dsimp [Λ]
      linarith
    have hv₁_le : ‖(v - v') 1‖ ≤ Λ * ‖F v - F v'‖ := by
      have h_eq : (v - v') 1 =
          (threePointQuadGrad₂ e_hat α' β' γ' (K' + η) (F v 0) (F v 1) (F v 2) -
           threePointQuadGrad₂ e_hat α' β' γ' (K' + η) (F v' 0) (F v' 1) (F v' 2)) -
          (q₁ v - q₁ v') := by
        change v 1 - v' 1 = _
        dsimp [q₁]
        abel
      rw [h_eq]
      have h_tri := norm_sub_le
        (threePointQuadGrad₂ e_hat α' β' γ' (K' + η) (F v 0) (F v 1) (F v 2) -
         threePointQuadGrad₂ e_hat α' β' γ' (K' + η) (F v' 0) (F v' 1) (F v' 2))
        (q₁ v - q₁ v')
      have hq₁_pi : ‖q₁ v - q₁ v'‖ ≤ (64 * C_Q + 16 * lam) * ‖F v - F v'‖ :=
        le_trans hq₁_lip (mul_le_mul_of_nonneg_left hF1_le h_coeff_pos)
      dsimp [Λ]
      linarith
    have hv₂_le : ‖(v - v') 2‖ ≤ Λ * ‖F v - F v'‖ := by
      have h_eq : (v - v') 2 =
          (threePointQuadGrad₃ γ' (K' + η) (F v 0) (F v 1) (F v 2) -
           threePointQuadGrad₃ γ' (K' + η) (F v' 0) (F v' 1) (F v' 2)) -
          (q₂ v - q₂ v') := by
        change v 2 - v' 2 = _
        dsimp [q₂]
        abel
      rw [h_eq]
      have h_tri := norm_sub_le
        (threePointQuadGrad₃ γ' (K' + η) (F v 0) (F v 1) (F v 2) -
         threePointQuadGrad₃ γ' (K' + η) (F v' 0) (F v' 1) (F v' 2))
        (q₂ v - q₂ v')
      have hq₂_pi : ‖q₂ v - q₂ v'‖ ≤ (64 * C_Q + 16 * lam) * ‖F v - F v'‖ :=
        le_trans hq₂_lip (mul_le_mul_of_nonneg_left hF2_le h_coeff_pos)
      dsimp [Λ]
      linarith
    rw [pi_norm_le_iff_of_nonneg (by positivity)]
    intro i
    fin_cases i
    · exact hv₀_le
    · exact hv₁_le
    · exact hv₂_le
  have h_vol_pos : MeasureTheory.volume (F '' S_v) ≠ 0 :=
    h_s3 r_v Λ hr_v_pos hΛ_pos F hF_rev_lip
  have h_exists_good : ∃ v ∈ S_v, ¬ (F v 0 ∈ N₁ ∨ F v 1 ∈ N₂ ∨ F v 2 ∈ N₃) := by
    by_contra h_all_bad
    push_neg at h_all_bad
    have h_sub_bad : F '' S_v ⊆ {ξ : E3 | ξ 0 ∈ N₁ ∨ ξ 1 ∈ N₂ ∨ ξ 2 ∈ N₃} := by
      rintro _ ⟨v, hv, rfl⟩
      exact h_all_bad v hv
    exact h_vol_pos (MeasureTheory.measure_mono_null h_sub_bad h_s4)
  obtain ⟨v, hv, h_not_bad⟩ := h_exists_good
  obtain ⟨h0_78, h1_78, h2_78, hmax⟩ := hF_spec v hv
  have h78_lt : 7 * δ / 8 < δ := by linarith
  have h0_ball : F v 0 ∈ Metric.ball (0 : E) δ :=
    Metric.closedBall_subset_ball h78_lt h0_78
  have h1_ball : F v 1 ∈ Metric.ball (0 : E) δ :=
    Metric.closedBall_subset_ball h78_lt h1_78
  have h2_ball : F v 2 ∈ Metric.ball (0 : E) δ :=
    Metric.closedBall_subset_ball h78_lt h2_78
  have hv_norm : ‖v‖ ≤ η * δ / 4 := by simpa [S_v, Metric.mem_closedBall, dist_zero_right] using hv
  have hv₀_cb : v 0 ∈ Metric.closedBall (0 : E) (η * δ / 4) := by
    rw [Metric.mem_closedBall, dist_zero_right]
    exact le_trans (norm_le_pi_norm v 0) hv_norm
  have hv₁_cb : v 1 ∈ Metric.closedBall (0 : E) (η * δ / 4) := by
    rw [Metric.mem_closedBall, dist_zero_right]
    exact le_trans (norm_le_pi_norm v 1) hv_norm
  have hv₂_cb : v 2 ∈ Metric.closedBall (0 : E) (η * δ / 4) := by
    rw [Metric.mem_closedBall, dist_zero_right]
    exact le_trans (norm_le_pi_norm v 2) hv_norm
  have h0_not_N₁ : F v 0 ∉ N₁ := fun h => h_not_bad (Or.inl h)
  have h1_not_N₂ : F v 1 ∉ N₂ := fun h => h_not_bad (Or.inr (Or.inl h))
  have h2_not_N₃ : F v 2 ∉ N₃ := fun h => h_not_bad (Or.inr (Or.inr h))
  exact ⟨F v 0, F v 1, F v 2, v 0, v 1, v 2,
    h0_ball, h1_ball, h2_ball, hv₀_cb, hv₁_cb, hv₂_cb,
    h0_not_N₁, h1_not_N₂, h2_not_N₃, hmax⟩

theorem semiconvex_sum_quadForm_nonneg (d : ℕ) (hd : 3 ≤ d)
    (lam r α' β' γ' K' : ℝ)
    (e_hat p₁ p₂ p₀ : EuclideanSpace ℝ (Fin (d + 1)))
    (u_hat₁ u_hat₂ u_hat₃ : EuclideanSpace ℝ (Fin (d + 1)) → ℝ)
    (hlam : 0 < lam) (hr : 0 < r)
    (hα' : 0 < α') (hβ' : 0 < β') (hγ' : 0 < γ') (hK' : 0 < K')
    (hu₁0 : u_hat₁ 0 = 0) (hu₂0 : u_hat₂ 0 = 0) (hu₃0 : u_hat₃ 0 = 0)
    (hconv₁ : ConvexOn ℝ Set.univ (fun ξ => u_hat₁ ξ + (lam / 2) * ‖ξ‖ ^ 2))
    (hconv₂ : ConvexOn ℝ Set.univ (fun ξ => u_hat₂ ξ + (lam / 2) * ‖ξ‖ ^ 2))
    (hconv₃ : ConvexOn ℝ Set.univ (fun ξ => u_hat₃ ξ + (lam / 2) * ‖ξ‖ ^ 2))
    (hsub₁ : HasQuadraticSubsolutionTest u_hat₁ p₁ r)
    (hsub₂ : HasQuadraticSubsolutionTest u_hat₂ p₂ r)
    (hsub₃ : HasQuadraticSubsolutionTest u_hat₃ (-(2 : ℝ) • p₀) r)
    (hsum : ∀ ξ₁ ∈ Metric.closedBall (0 : EuclideanSpace ℝ (Fin (d + 1))) r,
      ∀ ξ₂ ∈ Metric.closedBall (0 : EuclideanSpace ℝ (Fin (d + 1))) r,
        ∀ ξ₃ ∈ Metric.closedBall (0 : EuclideanSpace ℝ (Fin (d + 1))) r,
          u_hat₁ ξ₁ + u_hat₂ ξ₂ + u_hat₃ ξ₃ ≤
            threePointQuadForm e_hat α' β' γ' K' ξ₁ ξ₂ ξ₃) :
    0 ≤ threePointQuadForm e_hat α' β' γ' K' p₁ p₂ p₀ :=
by
  by_contra h_neg
  push_neg at h_neg
  let Q₀ : ℝ := threePointQuadForm e_hat α' β' γ' K' p₁ p₂ p₀
  let ε : ℝ := -Q₀
  have hε_pos : 0 < ε := by
    dsimp [ε, Q₀]
    linarith
  let S_p : ℝ := ‖p₁‖ ^ 2 + ‖p₂‖ ^ 2 + ‖p₀‖ ^ 2
  have hSp_nonneg : 0 ≤ S_p := by positivity
  let η : ℝ := ε / (2 * (S_p + 1))
  have hη_pos : 0 < η := by positivity
  have hK_η_pos : 0 < K' + η := by positivity
  have hQ_η_p : threePointQuadForm e_hat α' β' γ' (K' + η) p₁ p₂ p₀ ≤ -ε / 2 := by
    have h_eq : threePointQuadForm e_hat α' β' γ' (K' + η) p₁ p₂ p₀ = Q₀ + η * S_p := by
      dsimp only [threePointQuadForm, Q₀, S_p]
      ring
    have h_eta_le : η * S_p ≤ η * (S_p + 1) :=
      mul_le_mul_of_nonneg_left (by linarith) (le_of_lt hη_pos)
    have h_eta_eq : η * (S_p + 1) = ε / 2 := by
      dsimp [η]
      have h_pos : 0 < S_p + 1 := by positivity
      field_simp
    have h_Q₀ : Q₀ = -ε := by ring
    linarith
  obtain ⟨J₁, N₁, hJ₁_prox, hN₁_vol, hN₁_diff⟩ :=
    convex_proximal_map_and_ae_differentiable d (fun ξ => u_hat₁ ξ + (lam / 2) * ‖ξ‖ ^ 2) hconv₁
  obtain ⟨J₂, N₂, hJ₂_prox, hN₂_vol, hN₂_diff⟩ :=
    convex_proximal_map_and_ae_differentiable d (fun ξ => u_hat₂ ξ + (lam / 2) * ‖ξ‖ ^ 2) hconv₂
  obtain ⟨J₃, N₃, hJ₃_prox, hN₃_vol, hN₃_diff⟩ :=
    convex_proximal_map_and_ae_differentiable d (fun ξ => u_hat₃ ξ + (lam / 2) * ‖ξ‖ ^ 2) hconv₃
  let C_Q : ℝ := 2 * α' * ‖e_hat‖ ^ 2 + 2 * β' * (1 + ‖e_hat‖ ^ 2) ^ 2 + 2 * γ' + (K' + η)
  obtain ⟨hC_Q_pos, hQ_taylor, hQ_quad, hQ_lip⟩ :=
    threePointQuadForm_taylor_and_grad_bounds d e_hat α' β' γ' (K' + η) hα' hβ' hγ' hK_η_pos
  change 0 < C_Q at hC_Q_pos
  change ∀ h₁ h₂ h₃ : EuclideanSpace ℝ (Fin (d + 1)),
    |threePointQuadForm e_hat α' β' γ' (K' + η) h₁ h₂ h₃| ≤
      C_Q * (‖h₁‖ ^ 2 + ‖h₂‖ ^ 2 + ‖h₃‖ ^ 2) at hQ_quad
  change ∀ x₁ x₂ x₃ y₁ y₂ y₃ : EuclideanSpace ℝ (Fin (d + 1)),
    ‖threePointQuadGrad₁ e_hat α' β' γ' (K' + η) x₁ x₂ x₃ -
      threePointQuadGrad₁ e_hat α' β' γ' (K' + η) y₁ y₂ y₃‖ ≤
      2 * C_Q * (‖x₁ - y₁‖ + ‖x₂ - y₂‖ + ‖x₃ - y₃‖) ∧
    ‖threePointQuadGrad₂ e_hat α' β' γ' (K' + η) x₁ x₂ x₃ -
      threePointQuadGrad₂ e_hat α' β' γ' (K' + η) y₁ y₂ y₃‖ ≤
      2 * C_Q * (‖x₁ - y₁‖ + ‖x₂ - y₂‖ + ‖x₃ - y₃‖) ∧
    ‖threePointQuadGrad₃ γ' (K' + η) x₁ x₂ x₃ -
      threePointQuadGrad₃ γ' (K' + η) y₁ y₂ y₃‖ ≤
      2 * C_Q * (‖x₁ - y₁‖ + ‖x₂ - y₂‖ + ‖x₃ - y₃‖) at hQ_lip
  let C_q : ℝ := 6 * C_Q + η / 4
  have hC_q_pos : 0 < C_q := by positivity
  let g₁_p := threePointQuadGrad₁ e_hat α' β' γ' (K' + η) p₁ p₂ p₀
  let g₂_p := threePointQuadGrad₂ e_hat α' β' γ' (K' + η) p₁ p₂ p₀
  let g₃_p := threePointQuadGrad₃ γ' (K' + η) p₁ p₂ p₀
  let G_p : ℝ := ‖g₁_p‖ + ‖g₂_p‖ + ‖g₃_p‖ + 3 * C_Q + 1
  have hG_p_pos : 0 < G_p := by positivity
  let δ : ℝ := min (r / 2) (min (1 / C_q) (ε / (4 * G_p * C_q)))
  have hδ_pos : 0 < δ := by positivity
  have hδ_le_r2 : δ ≤ r / 2 := min_le_left _ _
  have hδ_lt_r : δ < r := by linarith
  have hδ_le_inv : δ ≤ 1 / C_q := le_trans (min_le_right _ _) (min_le_left _ _)
  have hδ_le_eps : δ ≤ ε / (4 * G_p * C_q) := le_trans (min_le_right _ _) (min_le_right _ _)
  have hCq_δ_nonneg : 0 ≤ C_q * δ := by positivity
  have hCq_δ_le_one : C_q * δ ≤ 1 := by
    have := mul_le_mul_of_nonneg_left hδ_le_inv (le_of_lt hC_q_pos)
