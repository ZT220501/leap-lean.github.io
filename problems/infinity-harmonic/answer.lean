    linarith
  have h_inner_ush_abs : |inner ℝ u_sh n_hat| ≤ (1 / 8) * S := by
    have h1 := abs_real_inner_le_norm u_sh n_hat
    rw [h_n_hat_norm, mul_one] at h1
    have h2 : ‖u_sh‖ ≤ (1 / 8) * S := by
