      rw [hy'_diff, norm_add_sq_real, norm_smul ℓ Q, Real.norm_eq_abs, abs_of_pos hℓ,
        mul_pow, real_inner_smul_left, inner_sub_right]
      field_simp [ne_of_gt hℓ]
      ring
    have h_csq_nonneg : 0 ≤ (t / (2 * ℓ * s)) * ‖u - (s / t) • h‖ ^ 2 := by
      positivity
    have h_csq_id : ‖u‖ ^ 2 / (2 * s) - ‖u - h‖ ^ 2 / (2 * ℓ) =
        ‖h‖ ^ 2 / (2 * t) - (t / (2 * ℓ * s)) * ‖u - (s / t) • h‖ ^ 2 := by
      have hst_pos : 0 < s / t := div_pos hs_pos ht
      rw [norm_sub_sq_real u h, norm_sub_sq_real u ((s / t) • h),
        norm_smul (s / t) h, Real.norm_eq_abs, abs_of_pos hst_pos, mul_pow,
        real_inner_smul_right]
      dsimp [s]
      field_simp [ne_of_gt ht, ne_of_gt hℓ, ne_of_gt hs_pos]
      ring
    dsimp [s, y] at h_first_order h_csq_id h_csq_nonneg
    linarith [h_first_order, hy'_norm, h_csq_id, h_csq_nonneg, hQ]
  exact ⟨h_lower, h_upper⟩

theorem existence_of_optimizing_step_triple_and_small_steps (d : ℕ) (κ : ℝ) (hκ : 0 < κ)
    (v : EuclideanSpace ℝ (Fin (d + 1)) → ℝ) (hv_cont : Continuous v)
    (hv_jensen : HasHorizontalJensenBound d κ v)
    (h_growth : ∀ (t₁ t₂ η : ℝ), 0 < η →
      ∃ M : ℝ, ∀ (y : EuclideanSpace ℝ (Fin d)) (s : ℝ),
        t₁ ≤ s → s ≤ t₂ → |v (mkSpaceTime y s)| ≤ M + η * ‖y‖ ^ 2) :
    (∀ (x y : EuclideanSpace ℝ (Fin d)) (s ε : ℝ), 0 < s → 0 < ε →
      shiftedBarycentricEnvelope d κ v (mkSpaceTime y (s + ε)) - ‖y - x‖ ^ 2 / (2 * ε) ≤
        quadEnvelopePlus d ε (shiftedBarycentricEnvelope d κ v) (mkSpaceTime x s) ∧
      quadEnvelopeMinus d ε v (mkSpaceTime x s) ≤
        v (mkSpaceTime y (s - ε)) + ‖y - x‖ ^ 2 / (2 * ε)) ∧
    ∃ (Q_plus Q_minus Q_zero : EuclideanSpace ℝ (Fin d) → ℝ → ℝ → EuclideanSpace ℝ (Fin d)),
      (∀ (x : EuclideanSpace ℝ (Fin d)) (t ε : ℝ), 0 < ε → ε < t →
        IsOptimizingStepTriple d κ ε v x t (Q_plus x t ε) (Q_minus x t ε) (Q_zero x t ε)) ∧
      (∀ (R T : ℝ), 2 ≤ R → 2 ≤ T →
        ∃ ε₀ : ℝ, 0 < ε₀ ∧
          ∀ (ε : ℝ) (x : EuclideanSpace ℝ (Fin d)) (t : ℝ),
            0 < ε → ε ≤ ε₀ → ‖x‖ ≤ R → ε < t → t ≤ T →
            ‖ε • Q_plus x t ε‖ ≤ 1 ∧ ‖ε • Q_minus x t ε‖ ≤ 1) :=
by
  have projSpace_mkSpaceTime : ∀ (x : EuclideanSpace ℝ (Fin d)) (s : ℝ),
      projSpace (mkSpaceTime x s) = x := by
    intro x s
    ext i
    simp [projSpace, mkSpaceTime]
  have projTime_mkSpaceTime : ∀ (x : EuclideanSpace ℝ (Fin d)) (s : ℝ),
      projTime (mkSpaceTime x s) = s := by
    intro x s
    simp [projTime, mkSpaceTime]
  have continuous_mkSpaceTime_left : ∀ s : ℝ,
      Continuous (fun y : EuclideanSpace ℝ (Fin d) => mkSpaceTime y s) := by
    intro s
    unfold mkSpaceTime
    apply (ContinuousLinearEquiv.continuous _).comp
    rw [continuous_pi_iff]
    intro j
    refine Fin.lastCases ?_ ?_ j
    · simp only [Fin.snoc_last]
      exact continuous_const
    · intro i
      simp only [Fin.snoc_castSucc]
      exact (continuous_apply i).comp (EuclideanSpace.equiv (Fin d) ℝ).continuous
  have norm_sq_le_two_sub_add : ∀ (x y : EuclideanSpace ℝ (Fin d)),
      ‖y‖ ^ 2 ≤ 2 * ‖y - x‖ ^ 2 + 2 * ‖x‖ ^ 2 := by
    intro x y
    have h1 : y = (y - x) + x := (sub_add_cancel y x).symm
    have h2 : ‖y‖ ^ 2 = ‖y - x‖ ^ 2 + 2 * inner ℝ (y - x) x + ‖x‖ ^ 2 := by
      conv_lhs => rw [h1]
      exact norm_add_sq_real (y - x) x
    have h3 : 0 ≤ ‖(y - x) - x‖ ^ 2 := sq_nonneg _
    rw [norm_sub_sq_real] at h3
    linarith
  let barySet : EuclideanSpace ℝ (Fin d) → ℝ → Set ℝ := fun y s =>
    let z := mkSpaceTime y s
    { val : ℝ | ∃ (N : ℕ) (θ : Fin N → ℝ) (y_cfg : Fin N → EuclideanSpace ℝ (Fin d)),
      (∀ i, 0 < θ i) ∧ (∑ i, θ i = 1) ∧ (∑ i, θ i • y_cfg i = projSpace z) ∧
      val = (∑ i, θ i * v (mkSpaceTime (y_cfg i) (projTime z))) -
        (∑ i, θ i * ‖y_cfg i - projSpace z‖ ^ 2) / (2 * projTime z) }
  have h_bary_mem : ∀ (y : EuclideanSpace ℝ (Fin d)) (s : ℝ),
      v (mkSpaceTime y s) ∈ barySet y s := by
    intro y s
    refine ⟨1, fun _ => 1, fun _ => y, fun _ => zero_lt_one, by simp, ?_, ?_⟩
    · simp [projSpace_mkSpaceTime]
    · simp [projSpace_mkSpaceTime, projTime_mkSpaceTime]
  have h_bary_ub : ∀ (y : EuclideanSpace ℝ (Fin d)) (s : ℝ), 0 < s →
      ∀ val ∈ barySet y s, val ≤ v (mkSpaceTime y s) + κ ^ 2 * s / 2 := by
    intro y s hs val hval
    rcases hval with ⟨N, θ, y_cfg, hθ_pos, hθ_sum, hy_mean, rfl⟩
    rw [projSpace_mkSpaceTime] at hy_mean
    rw [projSpace_mkSpaceTime, projTime_mkSpaceTime]
    have h_var_nonneg : 0 ≤ ∑ i, θ i * ‖y_cfg i - y‖ ^ 2 := by
      apply Finset.sum_nonneg
      intro i _
      exact mul_nonneg (le_of_lt (hθ_pos i)) (sq_nonneg _)
    let r : ℝ := Real.sqrt (∑ i, θ i * ‖y_cfg i - y‖ ^ 2)
    have hr_sq : r ^ 2 = ∑ i, θ i * ‖y_cfg i - y‖ ^ 2 := Real.sq_sqrt h_var_nonneg
    have h_j := hv_jensen s N θ y_cfg hθ_pos hθ_sum
    dsimp only at h_j
    rw [hy_mean] at h_j
    have h_sq_nonneg : 0 ≤ (r - κ * s) ^ 2 / (2 * s) :=
      div_nonneg (sq_nonneg _) (by positivity)
    have h_alg : v (mkSpaceTime y s) + κ * r - r ^ 2 / (2 * s) =
        v (mkSpaceTime y s) + κ ^ 2 * s / 2 - (r - κ * s) ^ 2 / (2 * s) := by
      field_simp [ne_of_gt hs]
      ring
    have h_step : (∑ i, θ i * v (mkSpaceTime (y_cfg i) s)) -
        (∑ i, θ i * ‖y_cfg i - y‖ ^ 2) / (2 * s) ≤
        v (mkSpaceTime y s) + κ * r - r ^ 2 / (2 * s) := by
      rw [← hr_sq]
      linarith
    linarith
  have h_sand : ∀ (y : EuclideanSpace ℝ (Fin d)) (s : ℝ), 0 < s →
      v (mkSpaceTime y s) - κ ^ 2 * s / 2 ≤ shiftedBarycentricEnvelope d κ v (mkSpaceTime y s) ∧
      shiftedBarycentricEnvelope d κ v (mkSpaceTime y s) ≤ v (mkSpaceTime y s) := by
    intro y s hs
    have h_sSup_ge : v (mkSpaceTime y s) ≤
        barycentricEnvelope d (projTime (mkSpaceTime y s)) v (mkSpaceTime y s) :=
      le_csSup ⟨v (mkSpaceTime y s) + κ ^ 2 * s / 2, h_bary_ub y s hs⟩ (h_bary_mem y s)
    have h_sSup_le :
        barycentricEnvelope d (projTime (mkSpaceTime y s)) v (mkSpaceTime y s) ≤
          v (mkSpaceTime y s) + κ ^ 2 * s / 2 :=
      csSup_le ⟨v (mkSpaceTime y s), h_bary_mem y s⟩ (h_bary_ub y s hs)
    dsimp [shiftedBarycentricEnvelope]
    rw [projTime_mkSpaceTime] at h_sSup_ge h_sSup_le ⊢
    constructor <;> linarith
  have h_comp : ∀ (x y : EuclideanSpace ℝ (Fin d)) (s ε : ℝ), 0 < s → 0 < ε →
      shiftedBarycentricEnvelope d κ v (mkSpaceTime y (s + ε)) - ‖y - x‖ ^ 2 / (2 * ε) ≤
        quadEnvelopePlus d ε (shiftedBarycentricEnvelope d κ v) (mkSpaceTime x s) ∧
      quadEnvelopeMinus d ε v (mkSpaceTime x s) ≤
        v (mkSpaceTime y (s - ε)) + ‖y - x‖ ^ 2 / (2 * ε) := by
    intro x y s ε hs hε
    let W := shiftedBarycentricEnvelope d κ v
    have hsε_pos : 0 < s + ε := by linarith
    have hη_pos : 0 < 1 / (4 * ε) := by positivity
    obtain ⟨M₁, hM₁⟩ := h_growth (s + ε) (s + ε) (1 / (4 * ε)) hη_pos
    obtain ⟨M₂, hM₂⟩ := h_growth (s - ε) (s - ε) (1 / (4 * ε)) hη_pos
    constructor
    · dsimp [quadEnvelopePlus]
      rw [projTime_mkSpaceTime, projSpace_mkSpaceTime]
      apply le_csSup
      · refine ⟨M₁ + ‖x‖ ^ 2 / (2 * ε), ?_⟩
        rintro val ⟨y', -, rfl⟩
        dsimp only
        have hW_le : W (mkSpaceTime y' (s + ε)) ≤ v (mkSpaceTime y' (s + ε)) :=
          (h_sand y' (s + ε) hsε_pos).2
        have hv_le : v (mkSpaceTime y' (s + ε)) ≤ M₁ + (1 / (4 * ε)) * ‖y'‖ ^ 2 :=
          le_trans (le_abs_self _) (hM₁ y' (s + ε) (le_refl _) (le_refl _))
        have h_yn := norm_sq_le_two_sub_add x y'
        have h_alg : (1 / (4 * ε)) * (2 * ‖y' - x‖ ^ 2 + 2 * ‖x‖ ^ 2) - ‖y' - x‖ ^ 2 / (2 * ε) =
            ‖x‖ ^ 2 / (2 * ε) := by
          field_simp [ne_of_gt hε]
          ring
        have h_mul : (1 / (4 * ε)) * ‖y'‖ ^ 2 ≤
            (1 / (4 * ε)) * (2 * ‖y' - x‖ ^ 2 + 2 * ‖x‖ ^ 2) :=
          mul_le_mul_of_nonneg_left h_yn (le_of_lt hη_pos)
        linarith
      · exact ⟨y, Set.mem_univ y, rfl⟩
    · dsimp [quadEnvelopeMinus]
      rw [projTime_mkSpaceTime, projSpace_mkSpaceTime]
      apply csInf_le
      · refine ⟨-M₂ - ‖x‖ ^ 2 / (2 * ε), ?_⟩
        rintro val ⟨y', -, rfl⟩
        dsimp only
        have hv_ge : -(M₂ + (1 / (4 * ε)) * ‖y'‖ ^ 2) ≤ v (mkSpaceTime y' (s - ε)) :=
          (abs_le.mp (hM₂ y' (s - ε) (le_refl _) (le_refl _))).1
        have h_yn := norm_sq_le_two_sub_add x y'
        have h_alg : (1 / (4 * ε)) * (2 * ‖y' - x‖ ^ 2 + 2 * ‖x‖ ^ 2) - ‖y' - x‖ ^ 2 / (2 * ε) =
            ‖x‖ ^ 2 / (2 * ε) := by
          field_simp [ne_of_gt hε]
          ring
        have h_mul : (1 / (4 * ε)) * ‖y'‖ ^ 2 ≤
            (1 / (4 * ε)) * (2 * ‖y' - x‖ ^ 2 + 2 * ‖x‖ ^ 2) :=
          mul_le_mul_of_nonneg_left h_yn (le_of_lt hη_pos)
        linarith
      · exact ⟨y, Set.mem_univ y, rfl⟩
  have hW_cont : ∀ s : ℝ, 0 < s →
      Continuous (fun y : EuclideanSpace ℝ (Fin d) =>
        shiftedBarycentricEnvelope d κ v (mkSpaceTime y s)) := by
    intro s hs
    let g : EuclideanSpace ℝ (Fin d) → ℝ := fun y =>
      barycentricEnvelope d (projTime (mkSpaceTime y s)) v (mkSpaceTime y s) - ‖y‖ ^ 2 / (2 * s)
    let h_s : EuclideanSpace ℝ (Fin d) → ℝ := fun w =>
      v (mkSpaceTime w s) - ‖w‖ ^ 2 / (2 * s)
    have h_par_axis : ∀ (y : EuclideanSpace ℝ (Fin d)) (N : ℕ) (θ : Fin N → ℝ)
        (y_cfg : Fin N → EuclideanSpace ℝ (Fin d)),
        (∑ i, θ i = 1) → (∑ i, θ i • y_cfg i = y) →
        ((∑ i, θ i * v (mkSpaceTime (y_cfg i) s)) -
          (∑ i, θ i * ‖y_cfg i - y‖ ^ 2) / (2 * s)) - ‖y‖ ^ 2 / (2 * s) =
          ∑ i, θ i * h_s (y_cfg i) := by
      intro y N θ y_cfg hθ_sum hy_mean
      have h_inner_sum : ∑ i, θ i * inner ℝ (y_cfg i) y = ‖y‖ ^ 2 := by
        calc ∑ i, θ i * inner ℝ (y_cfg i) y
          _ = ∑ i, inner ℝ (θ i • y_cfg i) y := by
              congr 1 with i
              rw [real_inner_smul_left]
          _ = inner ℝ (∑ i, θ i • y_cfg i) y := by
              rw [← sum_inner]
          _ = ‖y‖ ^ 2 := by
              rw [hy_mean, real_inner_self_eq_norm_sq]
      have h_var_id : ∑ i, θ i * ‖y_cfg i - y‖ ^ 2 =
          (∑ i, θ i * ‖y_cfg i‖ ^ 2) - ‖y‖ ^ 2 := by
        have h_term : ∀ i, θ i * ‖y_cfg i - y‖ ^ 2 =
            θ i * ‖y_cfg i‖ ^ 2 - 2 * (θ i * inner ℝ (y_cfg i) y) + θ i * ‖y‖ ^ 2 := by
          intro i
          rw [norm_sub_sq_real]
          ring
        simp_rw [h_term, Finset.sum_add_distrib, Finset.sum_sub_distrib, ← Finset.mul_sum,
          ← Finset.sum_mul, h_inner_sum, hθ_sum]
        ring
      rw [h_var_id]
      have h_rhs : ∑ i, θ i * h_s (y_cfg i) =
          (∑ i, θ i * v (mkSpaceTime (y_cfg i) s)) -
            (∑ i, θ i * ‖y_cfg i‖ ^ 2) / (2 * s) := by
        dsimp [h_s]
        simp_rw [mul_sub, Finset.sum_sub_distrib, ← mul_div_assoc, ← Finset.sum_div]
      rw [h_rhs]
      ring
    have h_concave : ∀ (y₁ y₂ : EuclideanSpace ℝ (Fin d)) (α₁ α₂ : ℝ),
        0 < α₁ → 0 < α₂ → α₁ + α₂ = 1 →
        α₁ * g y₁ + α₂ * g y₂ ≤ g (α₁ • y₁ + α₂ • y₂) := by
      intro y₁ y₂ α₁ α₂ hα₁ hα₂ hα_sum
      let y_bar := α₁ • y₁ + α₂ • y₂
      have h_pair : ∀ val₁ ∈ barySet y₁ s, ∀ val₂ ∈ barySet y₂ s,
          α₁ * (val₁ - ‖y₁‖ ^ 2 / (2 * s)) + α₂ * (val₂ - ‖y₂‖ ^ 2 / (2 * s)) ≤ g y_bar := by
        rintro val₁ ⟨N₁, θ₁, z₁, hθ₁_pos, hθ₁_sum, hz₁_mean, rfl⟩
          val₂ ⟨N₂, θ₂, z₂, hθ₂_pos, hθ₂_sum, hz₂_mean, rfl⟩
        rw [projSpace_mkSpaceTime] at hz₁_mean hz₂_mean
        simp only [projSpace_mkSpaceTime, projTime_mkSpaceTime]
        let θ : Fin (N₁ + N₂) → ℝ :=
          @Fin.addCases N₁ N₂ (fun _ => ℝ) (fun i => α₁ * θ₁ i) (fun j => α₂ * θ₂ j)
        let z : Fin (N₁ + N₂) → EuclideanSpace ℝ (Fin d) :=
          @Fin.addCases N₁ N₂ (fun _ => EuclideanSpace ℝ (Fin d)) z₁ z₂
        let val₁₂ : ℝ :=
          (∑ k, θ k * v (mkSpaceTime (z k) (projTime (mkSpaceTime y_bar s)))) -
            (∑ k, θ k * ‖z k - projSpace (mkSpaceTime y_bar s)‖ ^ 2) /
              (2 * projTime (mkSpaceTime y_bar s))
        have hθ_pos : ∀ k, 0 < θ k := by
          intro k
          refine Fin.addCases (fun i => ?_) (fun j => ?_) k
          · simp only [θ, Fin.addCases_left]
            exact mul_pos hα₁ (hθ₁_pos i)
          · simp only [θ, Fin.addCases_right]
            exact mul_pos hα₂ (hθ₂_pos j)
        have hθ_sum : ∑ k, θ k = 1 := by
          rw [Fin.sum_univ_add]
          simp only [θ, Fin.addCases_left, Fin.addCases_right, ← Finset.mul_sum,
            hθ₁_sum, hθ₂_sum, mul_one, hα_sum]
        have hz_mean : ∑ k, θ k • z k = y_bar := by
          rw [Fin.sum_univ_add]
          simp only [θ, z, Fin.addCases_left, Fin.addCases_right, mul_smul,
            ← Finset.smul_sum, hz₁_mean, hz₂_mean, y_bar]
        have h_mem12 : val₁₂ ∈ barySet y_bar s := by
          refine ⟨N₁ + N₂, θ, z, hθ_pos, hθ_sum, ?_, rfl⟩
          rw [projSpace_mkSpaceTime]
          exact hz_mean
        have h_le_sSup : val₁₂ ≤
            barycentricEnvelope d (projTime (mkSpaceTime y_bar s)) v (mkSpaceTime y_bar s) :=
          le_csSup ⟨v (mkSpaceTime y_bar s) + κ ^ 2 * s / 2, h_bary_ub y_bar s hs⟩ h_mem12
        have h_id1 : ((∑ i, θ₁ i * v (mkSpaceTime (z₁ i) s)) -
            (∑ i, θ₁ i * ‖z₁ i - y₁‖ ^ 2) / (2 * s)) - ‖y₁‖ ^ 2 / (2 * s) =
            ∑ i, θ₁ i * h_s (z₁ i) :=
          h_par_axis y₁ N₁ θ₁ z₁ hθ₁_sum hz₁_mean
        have h_id2 : ((∑ j, θ₂ j * v (mkSpaceTime (z₂ j) s)) -
            (∑ j, θ₂ j * ‖z₂ j - y₂‖ ^ 2) / (2 * s)) - ‖y₂‖ ^ 2 / (2 * s) =
            ∑ j, θ₂ j * h_s (z₂ j) :=
          h_par_axis y₂ N₂ θ₂ z₂ hθ₂_sum hz₂_mean
        have h_id12 : val₁₂ - ‖y_bar‖ ^ 2 / (2 * s) = ∑ k, θ k * h_s (z k) := by
          dsimp [val₁₂]
          rw [projSpace_mkSpaceTime, projTime_mkSpaceTime]
          exact h_par_axis y_bar (N₁ + N₂) θ z hθ_sum hz_mean
        have h_sum12 : ∑ k, θ k * h_s (z k) =
            α₁ * (∑ i, θ₁ i * h_s (z₁ i)) + α₂ * (∑ j, θ₂ j * h_s (z₂ j)) := by
          rw [Fin.sum_univ_add]
          simp only [θ, z, Fin.addCases_left, Fin.addCases_right, mul_assoc, ← Finset.mul_sum]
        rw [h_id1, h_id2, ← h_sum12, ← h_id12]
        dsimp [g]
        linarith
      have h_step1 : ∀ val₂ ∈ barySet y₂ s,
          α₁ * g y₁ + α₂ * (val₂ - ‖y₂‖ ^ 2 / (2 * s)) ≤ g y_bar := by
        intro val₂ hval₂
        have h_ub1 : barycentricEnvelope d (projTime (mkSpaceTime y₁ s)) v (mkSpaceTime y₁ s) ≤
            (g y_bar - α₂ * (val₂ - ‖y₂‖ ^ 2 / (2 * s))) / α₁ + ‖y₁‖ ^ 2 / (2 * s) := by
          apply csSup_le ⟨v (mkSpaceTime y₁ s), h_bary_mem y₁ s⟩
          intro val₁ hval₁
          have hp := h_pair val₁ hval₁ val₂ hval₂
          have h_div : val₁ - ‖y₁‖ ^ 2 / (2 * s) ≤
              (g y_bar - α₂ * (val₂ - ‖y₂‖ ^ 2 / (2 * s))) / α₁ := by
            rw [le_div_iff₀ hα₁]
            linarith
          linarith
        have h_mul := (le_div_iff₀ hα₁).mp (by linarith [h_ub1] :
          barycentricEnvelope d (projTime (mkSpaceTime y₁ s)) v (mkSpaceTime y₁ s) -
            ‖y₁‖ ^ 2 / (2 * s) ≤ (g y_bar - α₂ * (val₂ - ‖y₂‖ ^ 2 / (2 * s))) / α₁)
        dsimp [g]
        linarith
      have h_ub2 : barycentricEnvelope d (projTime (mkSpaceTime y₂ s)) v (mkSpaceTime y₂ s) ≤
          (g y_bar - α₁ * g y₁) / α₂ + ‖y₂‖ ^ 2 / (2 * s) := by
        apply csSup_le ⟨v (mkSpaceTime y₂ s), h_bary_mem y₂ s⟩
        intro val₂ hval₂
        have hp := h_step1 val₂ hval₂
        have h_div : val₂ - ‖y₂‖ ^ 2 / (2 * s) ≤ (g y_bar - α₁ * g y₁) / α₂ := by
          rw [le_div_iff₀ hα₂]
          linarith
        linarith
      have h_mul2 := (le_div_iff₀ hα₂).mp (by linarith [h_ub2] :
        barycentricEnvelope d (projTime (mkSpaceTime y₂ s)) v (mkSpaceTime y₂ s) -
          ‖y₂‖ ^ 2 / (2 * s) ≤ (g y_bar - α₁ * g y₁) / α₂)
      dsimp [g]
      linarith
    have hg_cont : Continuous g := by
      rw [Metric.continuous_iff]
      intro y₀ ε_tol hε_tol
      obtain ⟨M, hM⟩ := h_growth s s 1 zero_lt_one
      let M₀ : ℝ := max M 0 + (1 + 1 / (2 * s)) * (1 + ‖y₀‖) ^ 2 + κ ^ 2 * s / 2 + 1
      have hM₀_pos : 0 < M₀ := by
        have h1 : 0 ≤ max M 0 := le_max_right M 0
        have h2 : 0 ≤ (1 + 1 / (2 * s)) * (1 + ‖y₀‖) ^ 2 := by positivity
        have h3 : 0 ≤ κ ^ 2 * s / 2 := by positivity
        dsimp [M₀]
        linarith
      have hg_bdd_ball : ∀ z : EuclideanSpace ℝ (Fin d),
          ‖z - y₀‖ ≤ 1 → -M₀ ≤ g z ∧ g z ≤ M₀ := by
        intro z hz
        have hz_norm : ‖z‖ ≤ 1 + ‖y₀‖ := by
          have h_tri : ‖z‖ ≤ ‖z - y₀‖ + ‖y₀‖ := by
            simpa [sub_add_cancel] using norm_add_le (z - y₀) y₀
          linarith
        have hz_sq : ‖z‖ ^ 2 ≤ (1 + ‖y₀‖) ^ 2 :=
          pow_le_pow_left₀ (norm_nonneg z) hz_norm 2
        have hv_abs := abs_le.mp (hM z s (le_refl s) (le_refl s))
        have hM_le : M ≤ max M 0 := le_max_left M 0
        have h_sand_z := h_sand z s hs
        dsimp [shiftedBarycentricEnvelope] at h_sand_z
        have h_div_le : ‖z‖ ^ 2 / (2 * s) ≤ (1 + ‖y₀‖) ^ 2 / (2 * s) :=
          div_le_div_of_nonneg_right hz_sq (by positivity)
        have h_div_nonneg : 0 ≤ ‖z‖ ^ 2 / (2 * s) := by positivity
        have h_κ_nonneg : 0 ≤ κ ^ 2 * s / 2 := by positivity
