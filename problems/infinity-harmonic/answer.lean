    have h_lim_ψ : limitingOperator ψ w_c =
        deriv (deriv (fun s : ℝ => A₀ + B₀ * s + R * g s)) 0 := by
      change fderiv ℝ (fderiv ℝ ψ) w_c ξ_ψ ξ_ψ = _
      rw [← deriv_deriv_line_eq_fderiv_fderiv hV'_open hw_c_mem hψ_C2 ξ_ψ, hψ_ray_eq]
    have hU_s_open : IsOpen ((fun s : ℝ => z₀ + s • ζ) ⁻¹' V) :=
      hV_open.preimage (continuous_const.add (continuous_id.smul continuous_const))
    have h0_U_s : (0 : ℝ) ∈ (fun s : ℝ => z₀ + s • ζ) ⁻¹' V := by simp [hz₀]
    have h_ev_d1 : (fun s : ℝ => deriv (fun r : ℝ => A₀ + B₀ * r + R * g r) s) =ᶠ[nhds 0]
        fun s : ℝ => B₀ + R * deriv g s := by
      filter_upwards [hU_s_open.mem_nhds h0_U_s] with s hs
      have hϕ_s_diff : DifferentiableAt ℝ ϕ (z₀ + s • ζ) :=
        (hϕ_C2.contDiffAt (hV_open.mem_nhds hs)).differentiableAt (by norm_num)
      have h_line_s : HasDerivAt (fun r : ℝ => z₀ + r • ζ) ζ s := by
        simpa using (hasDerivAt_id s).smul_const ζ |>.const_add z₀
      have hg_diff : HasDerivAt g (deriv g s) s :=
        (hϕ_s_diff.hasFDerivAt.comp_hasDerivAt s h_line_s).differentiableAt.hasDerivAt
      have h_id_s : HasDerivAt (fun r : ℝ => r) 1 s := hasDerivAt_id s
      have h_comb : HasDerivAt (fun r : ℝ => A₀ + B₀ * r + R * g r) (B₀ + R * deriv g s) s := by
        convert ((hasDerivAt_const s A₀).add (h_id_s.const_mul B₀)).add (hg_diff.const_mul R) using 1
        ring
      exact h_comb.deriv
    have h_d2_ray : deriv (deriv (fun s : ℝ => A₀ + B₀ * s + R * g s)) 0 =
        R * deriv (deriv g) 0 := by
      rw [h_ev_d1.deriv_eq, deriv_const_add B₀, deriv_const_mul_field R]
    have h_dd_g : deriv (deriv g) 0 = R⁻¹ * (R⁻¹ * limitingOperator ϕ z₀) := by
      dsimp [g]
      rw [deriv_deriv_line_eq_fderiv_fderiv hV_open hz₀ hϕ_C2 ζ]
      dsimp [ζ, limitingOperator, ξ_ϕ]
      rw [map_smul, map_smul, ContinuousLinearMap.smul_apply, smul_eq_mul, smul_eq_mul]
    have h_lim_eq : limitingOperator ϕ z₀ = R * limitingOperator ψ w_c := by
      rw [h_lim_ψ, h_d2_ray, h_dd_g]
      field_simp [hR_ne]
    exact ⟨hV'_open, hw_c_mem, hψ_C2, hψ_wc, hψ_diff_eq, h_lim_eq⟩
  refine ⟨?_, ?_⟩
  · intro z₀ ϕ V hV_open hz₀ hϕ_C2 hϕ_z₀ h_upper
    obtain ⟨hV'_open, hw_c_mem, hψ_C2, hψ_wc, hψ_diff_eq, h_lim_eq⟩ :=
      h_pullback z₀ ϕ V hV_open hz₀ hϕ_C2 hϕ_z₀
    have hψ_upper : ∀ w ∈ Ψ ⁻¹' V, w₀ w ≤
        w₀ w_orig + R * (ϕ (Ψ w) + inner ℝ q₀ (Ψ w - z_one)) := by
      intro w hw
      have h_le : 0 ≤ ϕ (Ψ w) - v (Ψ w) := sub_nonneg.mpr (h_upper (Ψ w) hw)
      have h_diff := hψ_diff_eq w
      have h_nonneg : 0 ≤ R * (ϕ (Ψ w) - v (Ψ w)) := mul_nonneg (le_of_lt hR) h_le
      linarith
    have h_op_ψ : 0 ≤ limitingOperator
        (fun w => w₀ w_orig + R * (ϕ (Ψ w) + inner ℝ q₀ (Ψ w - z_one))) (Φ z₀) :=
      hw₀.2.1 (Φ z₀) _ (Ψ ⁻¹' V) hV'_open hw_c_mem hψ_C2 hψ_wc hψ_upper
    rw [h_lim_eq]
    exact mul_nonneg (le_of_lt hR) h_op_ψ
  · intro z₀ ϕ V hV_open hz₀ hϕ_C2 hϕ_z₀ h_lower
    obtain ⟨hV'_open, hw_c_mem, hψ_C2, hψ_wc, hψ_diff_eq, h_lim_eq⟩ :=
      h_pullback z₀ ϕ V hV_open hz₀ hϕ_C2 hϕ_z₀
    have hψ_lower : ∀ w ∈ Ψ ⁻¹' V,
        w₀ w_orig + R * (ϕ (Ψ w) + inner ℝ q₀ (Ψ w - z_one)) ≤ w₀ w := by
      intro w hw
      have h_le : ϕ (Ψ w) - v (Ψ w) ≤ 0 := sub_nonpos.mpr (h_lower (Ψ w) hw)
      have h_diff := hψ_diff_eq w
      have h_nonpos : R * (ϕ (Ψ w) - v (Ψ w)) ≤ 0 :=
        mul_nonpos_of_nonneg_of_nonpos (le_of_lt hR) h_le
      linarith
    have h_op_ψ : limitingOperator
        (fun w => w₀ w_orig + R * (ϕ (Ψ w) + inner ℝ q₀ (Ψ w - z_one))) (Φ z₀) ≤ 0 :=
      hw₀.2.2.1 (Φ z₀) _ (Ψ ⁻¹' V) hV'_open hw_c_mem hψ_C2 hψ_wc hψ_lower
    rw [h_lim_eq]
    exact mul_nonpos_of_nonneg_of_nonpos (le_of_lt hR) h_op_ψ

theorem sheared_frame_jensen_covariance : ∀ (d : ℕ) (κ : ℝ) (w₀ : EuclideanSpace ℝ (Fin (d + 1)) → ℝ),
      HasHorizontalJensenBound d κ w₀ →
      ∀ (x₀ p₀ : EuclideanSpace ℝ (Fin d)) (t₀ R a₀ : ℝ),
        0 < R →
        HasHorizontalJensenBound d κ (shearedFrameTransform d w₀ x₀ t₀ R p₀ a₀) :=
by
  intro d κ w₀ hw₀ x₀ p₀ t₀ R a₀ hR s N θ y hθ_pos hθ_sum
  dsimp only
  set x_bar : EuclideanSpace ℝ (Fin d) := ∑ i, θ i • y i
  set r : ℝ := Real.sqrt (∑ i, θ i * ‖y i - x_bar‖ ^ 2)
  have h_projSpace : ∀ (u : EuclideanSpace ℝ (Fin d)) (t : ℝ), projSpace (mkSpaceTime u t) = u := by
    intro u t
    ext j
    simp [projSpace, mkSpaceTime]
  have h_projTime : ∀ (u : EuclideanSpace ℝ (Fin d)) (t : ℝ), projTime (mkSpaceTime u t) = t := by
    intro u t
    simp [projTime, mkSpaceTime]
  let t_hat : ℝ := t₀ + R * (s - 1)
  have hv_eval : ∀ (u : EuclideanSpace ℝ (Fin d)),
      shearedFrameTransform d w₀ x₀ t₀ R p₀ a₀ (mkSpaceTime u s) =
        (w₀ (mkSpaceTime (x₀ + R • (u + (s - 1) • p₀)) t_hat) - w₀ (mkSpaceTime x₀ t₀)) / R -
          inner ℝ p₀ u - (a₀ + ‖p₀‖ ^ 2 / 2) * (s - 1) := by
    intro u
    dsimp [shearedFrameTransform, t_hat]
    rw [h_projSpace, h_projTime]
  let y_hat : Fin N → EuclideanSpace ℝ (Fin d) := fun i => x₀ + R • (y i + (s - 1) • p₀)
  let x_hat : EuclideanSpace ℝ (Fin d) := x₀ + R • (x_bar + (s - 1) • p₀)
  let c_vec : EuclideanSpace ℝ (Fin d) := x₀ + R • ((s - 1) • p₀)
  have hy_hat_eq : ∀ i, y_hat i = R • y i + c_vec := by
    intro i
    dsimp [y_hat, c_vec]
    rw [smul_add]
    abel
  have hx_hat_eq : x_hat = R • x_bar + c_vec := by
    dsimp [x_hat, c_vec]
    rw [smul_add]
    abel
  have hx_hat : ∑ i, θ i • y_hat i = x_hat := by
    have h_term : ∀ i, θ i • y_hat i = R • (θ i • y i) + θ i • c_vec := by
      intro i
      rw [hy_hat_eq i, smul_add, smul_comm R (θ i) (y i)]
    simp_rw [h_term]
    rw [Finset.sum_add_distrib, ← Finset.smul_sum, ← Finset.sum_smul, hθ_sum, one_smul, ← hx_hat_eq]
  have h_diff : ∀ i, y_hat i - x_hat = R • (y i - x_bar) := by
    intro i
    rw [hy_hat_eq i, hx_hat_eq, add_sub_add_right_eq_sub, ← smul_sub]
  have hr_hat : Real.sqrt (∑ i, θ i * ‖y_hat i - (∑ j, θ j • y_hat j)‖ ^ 2) = R * r := by
    rw [hx_hat]
    have h_norm_sq : ∀ i, θ i * ‖y_hat i - x_hat‖ ^ 2 = R ^ 2 * (θ i * ‖y i - x_bar‖ ^ 2) := by
      intro i
      rw [h_diff i, norm_smul, Real.norm_of_nonneg (le_of_lt hR)]
      ring
    simp_rw [h_norm_sq]
    rw [← Finset.mul_sum, Real.sqrt_mul (sq_nonneg R), Real.sqrt_sq (le_of_lt hR)]
  have h_inner_sum : ∑ i, θ i * inner ℝ p₀ (y i - x_bar) = 0 := by
    have h_term : ∀ i, θ i * inner ℝ p₀ (y i - x_bar) =
        inner ℝ p₀ (θ i • y i) - θ i * inner ℝ p₀ x_bar := by
      intro i
      rw [inner_sub_right, mul_sub, real_inner_smul_right]
    simp_rw [h_term]
    rw [Finset.sum_sub_distrib, ← inner_sum, ← Finset.sum_mul, hθ_sum, one_mul]
    exact sub_self (inner ℝ p₀ x_bar)
  have h_defect :
      (∑ i, θ i * shearedFrameTransform d w₀ x₀ t₀ R p₀ a₀ (mkSpaceTime (y i) s)) -
        shearedFrameTransform d w₀ x₀ t₀ R p₀ a₀ (mkSpaceTime x_bar s) =
      ((∑ i, θ i * w₀ (mkSpaceTime (y_hat i) t_hat)) -
        w₀ (mkSpaceTime (∑ i, θ i • y_hat i) t_hat)) / R := by
    rw [hx_hat]
    have h_pt : ∀ i,
        shearedFrameTransform d w₀ x₀ t₀ R p₀ a₀ (mkSpaceTime (y i) s) -
          shearedFrameTransform d w₀ x₀ t₀ R p₀ a₀ (mkSpaceTime x_bar s) =
        (w₀ (mkSpaceTime (y_hat i) t_hat) - w₀ (mkSpaceTime x_hat t_hat)) / R -
          inner ℝ p₀ (y i - x_bar) := by
      intro i
      rw [hv_eval (y i), hv_eval x_bar, inner_sub_right]
      dsimp [y_hat, x_hat]
      ring
    calc (∑ i, θ i * shearedFrameTransform d w₀ x₀ t₀ R p₀ a₀ (mkSpaceTime (y i) s)) -
          shearedFrameTransform d w₀ x₀ t₀ R p₀ a₀ (mkSpaceTime x_bar s)
      _ = (∑ i, θ i * shearedFrameTransform d w₀ x₀ t₀ R p₀ a₀ (mkSpaceTime (y i) s)) -
          (∑ i, θ i) * shearedFrameTransform d w₀ x₀ t₀ R p₀ a₀ (mkSpaceTime x_bar s) := by
          rw [hθ_sum, one_mul]
      _ = ∑ i, θ i * (shearedFrameTransform d w₀ x₀ t₀ R p₀ a₀ (mkSpaceTime (y i) s) -
          shearedFrameTransform d w₀ x₀ t₀ R p₀ a₀ (mkSpaceTime x_bar s)) := by
          rw [Finset.sum_mul, ← Finset.sum_sub_distrib]
          refine Finset.sum_congr rfl (fun i _ => ?_)
          ring
      _ = ∑ i, (θ i * ((w₀ (mkSpaceTime (y_hat i) t_hat) - w₀ (mkSpaceTime x_hat t_hat)) / R) -
          θ i * inner ℝ p₀ (y i - x_bar)) := by
          refine Finset.sum_congr rfl (fun i _ => ?_)
          rw [h_pt i, mul_sub]
      _ = (∑ i, (θ i * w₀ (mkSpaceTime (y_hat i) t_hat) - θ i * w₀ (mkSpaceTime x_hat t_hat)) / R) -
          ∑ i, θ i * inner ℝ p₀ (y i - x_bar) := by
          rw [Finset.sum_sub_distrib]
          congr 1
          refine Finset.sum_congr rfl (fun i _ => ?_)
          ring
      _ = ((∑ i, θ i * w₀ (mkSpaceTime (y_hat i) t_hat)) -
          w₀ (mkSpaceTime x_hat t_hat)) / R := by
          rw [h_inner_sum, sub_zero, ← Finset.sum_div, Finset.sum_sub_distrib, ← Finset.sum_mul,
            hθ_sum, one_mul]
  have hw₀_step := hw₀ t_hat N θ y_hat hθ_pos hθ_sum
  dsimp only at hw₀_step
  rw [hr_hat] at hw₀_step
  rw [h_defect, div_le_iff₀ hR]
  linarith

theorem sheared_frame_barycentric_lower_bound : ∀ (d : ℕ) (κ δ : ℝ), 0 < κ →
      ∀ (w₀ : EuclideanSpace ℝ (Fin (d + 1)) → ℝ) (t₀ : ℝ)
        (N : ℕ) (θ : Fin N → ℝ) (y : Fin N → EuclideanSpace ℝ (Fin d)),
        (∀ i, 0 < θ i) → (∑ i, θ i = 1) →
        let x₀ := ∑ j, θ j • y j
        let r₀ := Real.sqrt (∑ i, θ i * ‖y i - x₀‖ ^ 2)
        0 < r₀ →
        (κ - δ) * r₀ ≤
          (∑ i, θ i * w₀ (mkSpaceTime (y i) t₀)) - w₀ (mkSpaceTime x₀ t₀) →
        ∀ (p₀ : EuclideanSpace ℝ (Fin d)) (a₀ : ℝ),
          let R := r₀ / κ
          let v := shearedFrameTransform d w₀ x₀ t₀ R p₀ a₀
          HasHorizontalJensenBound d κ v →
          κ ^ 2 / 2 - κ * δ ≤ barycentricEnvelope d 1 v (mkSpaceTime 0 1) - v (mkSpaceTime 0 1) :=
by
  intro d κ δ hκ_pos w₀ t₀ N θ y hθ_pos hθ_sum x₀ r₀ hr_pos h_def p₀ a₀ R v hv_jensen
  have h_projSpace : ∀ (x : EuclideanSpace ℝ (Fin d)) (t : ℝ), projSpace (mkSpaceTime x t) = x := by
    intro x t
    ext i
    simp [projSpace, mkSpaceTime]
  have h_projTime : ∀ (x : EuclideanSpace ℝ (Fin d)) (t : ℝ), projTime (mkSpaceTime x t) = t := by
    intro x t
    simp [projTime, mkSpaceTime]
  have hR_pos : 0 < R := div_pos hr_pos hκ_pos
  have hR_ne : R ≠ 0 := ne_of_gt hR_pos
  have hκ_ne : κ ≠ 0 := ne_of_gt hκ_pos
  have hr₀_ne : r₀ ≠ 0 := ne_of_gt hr_pos
  have hV₀_nonneg : 0 ≤ ∑ i, θ i * ‖y i - x₀‖ ^ 2 := by
    apply Finset.sum_nonneg
    intro i _
    exact mul_nonneg (le_of_lt (hθ_pos i)) (sq_nonneg _)
  have hr₀_sq : r₀ ^ 2 = ∑ i, θ i * ‖y i - x₀‖ ^ 2 := Real.sq_sqrt hV₀_nonneg
  have hv_slice : ∀ u : EuclideanSpace ℝ (Fin d),
      v (mkSpaceTime u 1) =
        (w₀ (mkSpaceTime (x₀ + R • u) t₀) - w₀ (mkSpaceTime x₀ t₀)) / R - inner ℝ p₀ u := by
    intro u
    change shearedFrameTransform d w₀ x₀ t₀ R p₀ a₀ (mkSpaceTime u 1) = _
    unfold shearedFrameTransform
    simp [h_projSpace, h_projTime]
  have hv_zero : v (mkSpaceTime 0 1) = 0 := by
    rw [hv_slice 0]
    simp
  have h_bary_ub : ∀ val ∈
      { val : ℝ | ∃ (N' : ℕ) (θ' : Fin N' → ℝ) (y' : Fin N' → EuclideanSpace ℝ (Fin d)),
        (∀ i, 0 < θ' i) ∧ (∑ i, θ' i = 1) ∧
        (∑ i, θ' i • y' i = projSpace (mkSpaceTime (0 : EuclideanSpace ℝ (Fin d)) 1)) ∧
        val = (∑ i, θ' i * v (mkSpaceTime (y' i) (projTime (mkSpaceTime (0 : EuclideanSpace ℝ (Fin d)) 1)))) -
          (∑ i, θ' i * ‖y' i - projSpace (mkSpaceTime (0 : EuclideanSpace ℝ (Fin d)) 1)‖ ^ 2) / (2 * 1) },
      val ≤ v (mkSpaceTime 0 1) + κ ^ 2 / 2 := by
    rintro val ⟨N', θ', y', hθ'_pos, hθ'_sum, hy'_mean, rfl⟩
    rw [h_projSpace] at hy'_mean ⊢
    rw [h_projTime]
    have hj := hv_jensen 1 N' θ' y' hθ'_pos hθ'_sum
    dsimp only at hj
    rw [hy'_mean] at hj
    set V' : ℝ := ∑ i, θ' i * ‖y' i - 0‖ ^ 2
    set r' : ℝ := Real.sqrt V'
    have hV'_nonneg : 0 ≤ V' := by
      apply Finset.sum_nonneg
      intro i _
      exact mul_nonneg (le_of_lt (hθ'_pos i)) (sq_nonneg _)
    have hr'_sq : r' ^ 2 = V' := Real.sq_sqrt hV'_nonneg
    have h_sq_nonneg : 0 ≤ (r' - κ) ^ 2 / 2 := div_nonneg (sq_nonneg _) (by norm_num)
    have h_id : κ * r' - V' / (2 * 1) = κ ^ 2 / 2 - (r' - κ) ^ 2 / 2 := by
      rw [← hr'_sq]
      ring
    linarith
  let y_tilde : Fin N → EuclideanSpace ℝ (Fin d) := fun i => R⁻¹ • (y i - x₀)
  have hy_tilde_mean : ∑ i, θ i • y_tilde i = 0 := by
    change ∑ i, θ i • (R⁻¹ • (y i - x₀)) = 0
    have h_comm : ∀ i, θ i • (R⁻¹ • (y i - x₀)) = R⁻¹ • (θ i • (y i - x₀)) := by
      intro i
      exact smul_comm (θ i) R⁻¹ (y i - x₀)
    simp_rw [h_comm, ← Finset.smul_sum, smul_sub, Finset.sum_sub_distrib, ← Finset.sum_smul, hθ_sum, one_smul]
    change R⁻¹ • (x₀ - x₀) = 0
    simp
  have hy_tilde_rec : ∀ i, x₀ + R • y_tilde i = y i := by
    intro i
    change x₀ + R • (R⁻¹ • (y i - x₀)) = y i
    rw [smul_smul, mul_inv_cancel₀ hR_ne, one_smul, add_sub_cancel]
  have hy_tilde_var : ∑ i, θ i * ‖y_tilde i - 0‖ ^ 2 = κ ^ 2 := by
    have h_term : ∀ i, θ i * ‖y_tilde i - 0‖ ^ 2 = (R⁻¹) ^ 2 * (θ i * ‖y i - x₀‖ ^ 2) := by
      intro i
      change θ i * ‖R⁻¹ • (y i - x₀) - 0‖ ^ 2 = _
      rw [sub_zero, norm_smul, Real.norm_eq_abs, mul_pow, sq_abs]
      ring
    simp_rw [h_term, ← Finset.mul_sum, ← hr₀_sq]
    change (r₀ / κ)⁻¹ ^ 2 * r₀ ^ 2 = κ ^ 2
    field_simp [hr₀_ne, hκ_ne]
  have hy_tilde_tilt : ∑ i, θ i * inner ℝ p₀ (y_tilde i) = 0 := by
    have h_in : ∀ i, θ i * inner ℝ p₀ (y_tilde i) = inner ℝ p₀ (θ i • y_tilde i) := by
      intro i
      exact (real_inner_smul_right p₀ (y_tilde i) (θ i)).symm
    simp_rw [h_in, ← inner_sum, hy_tilde_mean, inner_zero_right]
  have hy_tilde_val : ∑ i, θ i * v (mkSpaceTime (y_tilde i) 1) =
      ((∑ i, θ i * w₀ (mkSpaceTime (y i) t₀)) - w₀ (mkSpaceTime x₀ t₀)) / R := by
    have h_v : ∀ i, θ i * v (mkSpaceTime (y_tilde i) 1) =
        (θ i * w₀ (mkSpaceTime (y i) t₀) - θ i * w₀ (mkSpaceTime x₀ t₀)) / R -
          θ i * inner ℝ p₀ (y_tilde i) := by
      intro i
      rw [hv_slice (y_tilde i), hy_tilde_rec i]
      ring
    simp_rw [h_v]
    rw [Finset.sum_sub_distrib, hy_tilde_tilt, sub_zero, ← Finset.sum_div,
      Finset.sum_sub_distrib, ← Finset.sum_mul, hθ_sum, one_mul]
  have hy_tilde_lb : (κ - δ) * κ ≤ ∑ i, θ i * v (mkSpaceTime (y_tilde i) 1) := by
    rw [hy_tilde_val]
    have h_div := div_le_div_of_nonneg_right h_def (le_of_lt hR_pos)
    have h_lhs : (κ - δ) * r₀ / R = (κ - δ) * κ := by
      change (κ - δ) * r₀ / (r₀ / κ) = (κ - δ) * κ
      field_simp [hr₀_ne, hκ_ne]
    linarith
  have h_le_env : (∑ i, θ i * v (mkSpaceTime (y_tilde i) 1)) -
      (∑ i, θ i * ‖y_tilde i - 0‖ ^ 2) / (2 * 1) ≤
        barycentricEnvelope d 1 v (mkSpaceTime 0 1) := by
    apply le_csSup ⟨v (mkSpaceTime 0 1) + κ ^ 2 / 2, h_bary_ub⟩
    refine ⟨N, θ, y_tilde, hθ_pos, hθ_sum, ?_, ?_⟩
    · rw [h_projSpace, hy_tilde_mean]
    · rw [h_projSpace, h_projTime]
  rw [hy_tilde_var] at h_le_env
  have h_alg : (κ - δ) * κ - κ ^ 2 / (2 * 1) = κ ^ 2 / 2 - κ * δ := by ring
  linarith

theorem sheared_frame_normalization_at_configuration (d : ℕ) (C₁ : ℝ) (hC₁ : 0 ≤ C₁)
    (κ δ : ℝ) (hκ_pos : 0 < κ)
    (w₀ : EuclideanSpace ℝ (Fin (d + 1)) → ℝ) (hw₀ : InLimitingClassA d C₁ w₀)
    (hw₀_jensen : HasHorizontalJensenBound d κ w₀)
    (t₀ : ℝ) (N : ℕ) (θ : Fin N → ℝ) (y : Fin N → EuclideanSpace ℝ (Fin d))
    (hθ_pos : ∀ i, 0 < θ i) (hθ_sum : ∑ i, θ i = 1)
    (hr_pos : 0 < Real.sqrt (∑ i, θ i * ‖y i - ∑ j, θ j • y j‖ ^ 2))
    (h_def : (κ - δ) * Real.sqrt (∑ i, θ i * ‖y i - ∑ j, θ j • y j‖ ^ 2) ≤
      (∑ i, θ i * w₀ (mkSpaceTime (y i) t₀)) -
        w₀ (mkSpaceTime (∑ j, θ j • y j) t₀)) :
    ∃ v : EuclideanSpace ℝ (Fin (d + 1)) → ℝ,
      InLimitingClassA d C₁ v ∧
      IsCenteredAt d C₁ v 0 1 ∧
      HasHorizontalJensenBound d κ v ∧
      κ ^ 2 / 2 - κ * δ ≤
        barycentricEnvelope d 1 v (mkSpaceTime 0 1) - v (mkSpaceTime 0 1) :=
by
  let x₀ : EuclideanSpace ℝ (Fin d) := ∑ j, θ j • y j
  let r₀ : ℝ := Real.sqrt (∑ i, θ i * ‖y i - x₀‖ ^ 2)
  let R : ℝ := r₀ / κ
  have hR_pos : 0 < R := div_pos hr_pos hκ_pos
  obtain ⟨p₀, a₀, h_fit₀⟩ := hw₀.2.2.2 x₀ t₀ R hR_pos
  let v := shearedFrameTransform d w₀ x₀ t₀ R p₀ a₀
  obtain ⟨hv_cont, hv_cent, hv_fits⟩ :=
    sheared_frame_fits_and_centering d C₁ w₀ hw₀.1 hw₀.2.2.2 x₀ p₀ t₀ R a₀ hR_pos h_fit₀
  obtain ⟨hv_sub, hv_super⟩ :=
    sheared_frame_viscosity_covariance d C₁ w₀ hw₀ x₀ p₀ t₀ R a₀ hR_pos
  have hv_class : InLimitingClassA d C₁ v := ⟨hv_cont, hv_sub, hv_super, hv_fits⟩
  have hv_jensen : HasHorizontalJensenBound d κ v :=
    sheared_frame_jensen_covariance d κ w₀ hw₀_jensen x₀ p₀ t₀ R a₀ hR_pos
  have hv_bary :
      κ ^ 2 / 2 - κ * δ ≤ barycentricEnvelope d 1 v (mkSpaceTime 0 1) - v (mkSpaceTime 0 1) :=
    sheared_frame_barycentric_lower_bound d κ δ hκ_pos w₀ t₀ N θ y hθ_pos hθ_sum
      hr_pos h_def p₀ a₀ hv_jensen
  exact ⟨v, hv_class, hv_cent, hv_jensen, hv_bary⟩

theorem extremal_jensen_defect_sequence (d : ℕ) (hd : 3 ≤ d) (C₀ : ℝ) (hC₀ : 0 ≤ C₀)
    (v₀ : EuclideanSpace ℝ (Fin (d + 1)) → ℝ) (hv₀ : InLimitingClassA d C₀ v₀)
    (h_nonaff : ¬ IsAffineSpaceTime d v₀) :
    ∃ (κ : ℝ) (v_seq : ℕ → EuclideanSpace ℝ (Fin (d + 1)) → ℝ),
      0 < κ ∧
      ∀ j : ℕ,
        InLimitingClassA d (max C₀ 1) (v_seq j) ∧
        IsCenteredAt d (max C₀ 1) (v_seq j) 0 1 ∧
        HasHorizontalJensenBound d κ (v_seq j) ∧
        κ ^ 2 / 2 - κ / ((j : ℝ) + 1) ≤
          barycentricEnvelope d 1 (v_seq j) (mkSpaceTime 0 1) - (v_seq j) (mkSpaceTime 0 1) :=
by
  have h_not_horiz_aff : ¬ ∀ t : ℝ, ∃ (p : EuclideanSpace ℝ (Fin d)) (c : ℝ),
      ∀ x : EuclideanSpace ℝ (Fin d), v₀ (mkSpaceTime x t) = inner ℝ p x + c := by
    intro h_horiz
    exact h_nonaff (affine_of_horizontally_affine_classA d hd C₀ hC₀ v₀ hv₀ h_horiz)
  obtain ⟨w₀, t₀, N₀, θ₀, y₀, hw₀_class, hθ₀_pos, hθ₀_sum, hr₀_pos, h_def_pos⟩ :=
    positive_jensen_defect_of_not_horizontally_affine d C₀ hC₀ v₀ hv₀ h_not_horiz_aff
  have hC₁ : (0 : ℝ) ≤ max C₀ 1 := le_trans hC₀ (le_max_left C₀ 1)
  obtain ⟨κ, hκ_pos, hw₀_jensen, h_configs⟩ :=
    extremal_jensen_constant_and_configurations d (max C₀ 1) hC₁ w₀ hw₀_class
      t₀ N₀ θ₀ y₀ hθ₀_pos hθ₀_sum hr₀_pos h_def_pos
  have hv_ex : ∀ j : ℕ, ∃ v : EuclideanSpace ℝ (Fin (d + 1)) → ℝ,
      InLimitingClassA d (max C₀ 1) v ∧
      IsCenteredAt d (max C₀ 1) v 0 1 ∧
      HasHorizontalJensenBound d κ v ∧
      κ ^ 2 / 2 - κ / ((j : ℝ) + 1) ≤
        barycentricEnvelope d 1 v (mkSpaceTime 0 1) - v (mkSpaceTime 0 1) := by
    intro j
    obtain ⟨t_j, N_j, θ_j, y_j, hθ_j_pos, hθ_j_sum, hr_j_pos, h_def_j⟩ := h_configs j
    obtain ⟨v, hv_class, hv_cent, hv_jensen, hv_bary⟩ :=
      sheared_frame_normalization_at_configuration d (max C₀ 1) hC₁ κ (1 / ((j : ℝ) + 1))
        hκ_pos w₀ hw₀_class hw₀_jensen t_j N_j θ_j y_j hθ_j_pos hθ_j_sum hr_j_pos h_def_j
    refine ⟨v, hv_class, hv_cent, hv_jensen, ?_⟩
    have h_eq : κ * (1 / ((j : ℝ) + 1)) = κ / ((j : ℝ) + 1) := by ring
    linarith
  exact ⟨κ, fun j => Classical.choose (hv_ex j), hκ_pos,
    fun j => Classical.choose_spec (hv_ex j)⟩

theorem centered_class_A_equicontinuity_and_growth (d : ℕ) (hd : 3 ≤ d) (C₁ : ℝ) (hC₁ : 1 ≤ C₁) :
    HasCenteredClassABounds d C₁ :=
by
  have hC₁_nonneg : (0 : ℝ) ≤ C₁ := by linarith
  have h_mk_proj : ∀ z : EuclideanSpace ℝ (Fin (d + 1)),
      mkSpaceTime (projSpace z) (projTime z) = z := by
    intro z
    ext j
    refine Fin.lastCases ?_ ?_ j
    · simp [mkSpaceTime, projTime]
    · intro i
      simp [mkSpaceTime, projSpace]
  have h_proj_sub : ∀ z₁ z₂ : EuclideanSpace ℝ (Fin (d + 1)),
      ‖projSpace z₂ - projSpace z₁‖ ≤ ‖z₁ - z₂‖ ∧
      |projTime z₂ - projTime z₁| ≤ ‖z₁ - z₂‖ := by
    intro z₁ z₂
    have h_time : |projTime z₂ - projTime z₁| ≤ ‖z₁ - z₂‖ := by
      have h1 : |projTime z₂ - projTime z₁| = ‖(z₂ - z₁) (Fin.last d)‖ := by
        simp [projTime]
      rw [h1, norm_sub_rev z₁ z₂]
      exact PiLp.norm_apply_le (z₂ - z₁) (Fin.last d)
    have h_space_sq : ‖projSpace z₂ - projSpace z₁‖ ^ 2 ≤ ‖z₁ - z₂‖ ^ 2 := by
      rw [norm_sub_rev z₁ z₂, PiLp.norm_sq_eq_of_L2, PiLp.norm_sq_eq_of_L2, Fin.sum_univ_castSucc]
      have h_sum_eq :
          (∑ i : Fin d, ‖(projSpace z₂ - projSpace z₁) i‖ ^ 2) =
          ∑ i : Fin d, ‖(z₂ - z₁) (Fin.castSucc i)‖ ^ 2 := by
        refine Finset.sum_congr rfl fun i _ => ?_
        simp [projSpace]
      rw [h_sum_eq]
      have h_last_nn : 0 ≤ ‖(z₂ - z₁) (Fin.last d)‖ ^ 2 := sq_nonneg _
      linarith
    have h_space : ‖projSpace z₂ - projSpace z₁‖ ≤ ‖z₁ - z₂‖ := by
      have h1 : 0 ≤ ‖projSpace z₂ - projSpace z₁‖ := norm_nonneg _
      have h2 : 0 ≤ ‖z₁ - z₂‖ := norm_nonneg _
      nlinarith
    exact ⟨h_space, h_time⟩
  have h_two_scale :
      ∀ (w : EuclideanSpace ℝ (Fin (d + 1)) → ℝ)
        (x₀ : EuclideanSpace ℝ (Fin d)) (t₀ R : ℝ), 0 < R →
        ∀ (p p' : EuclideanSpace ℝ (Fin d)) (a a' : ℝ),
          IsFitAt d C₁ w x₀ t₀ R p a →
          IsFitAt d C₁ w x₀ t₀ (2 * R) p' a' →
          ‖p' - p‖ ≤ 3 * C₁ ∧
          |a' - a| ≤ 3 * C₁ * (1 + 3 * C₁) + (9 / 2) * C₁ ^ 2 := by
    intro w x₀ t₀ R hR p p' a a' hfit1 hfit2
    have h_horiz : ∀ h : EuclideanSpace ℝ (Fin d), ‖h‖ ≤ R →
        inner ℝ (p' - p) h ≤ 3 * C₁ * R := by
      intro h hh
      have h0_le_R : |(0 : ℝ)| ≤ R := by simp [le_of_lt hR]
      have h0_le_2R : |(0 : ℝ)| ≤ 2 * R := by simp; linarith
      have hh1 : ‖h - (0 : ℝ) • p‖ ≤ R := by simpa using hh
      have hh2 : ‖h - (0 : ℝ) • p'‖ ≤ 2 * R := by
        have : ‖h - (0 : ℝ) • p'‖ = ‖h‖ := by simp
        linarith
      have hb1 := abs_le.mp (hfit1 h 0 h0_le_R hh1)
      have hb2 := abs_le.mp (hfit2 h 0 h0_le_2R hh2)
      rw [inner_sub_left]
      linarith
    have hp_diff : ‖p' - p‖ ≤ 3 * C₁ := by
      by_cases hp : ‖p' - p‖ = 0
      · linarith
      · have hp_pos : 0 < ‖p' - p‖ := norm_pos_iff.mpr (fun h_eq => hp (by simp [h_eq]))
        let h : EuclideanSpace ℝ (Fin d) := (R / ‖p' - p‖) • (p' - p)
        have hh_norm : ‖h‖ ≤ R := by
          dsimp [h]
          rw [norm_smul, Real.norm_eq_abs, abs_of_pos (div_pos hR hp_pos),
            div_mul_cancel₀ R (ne_of_gt hp_pos)]
        have h_in := h_horiz h hh_norm
        have h_eval : inner ℝ (p' - p) h = R * ‖p' - p‖ := by
          dsimp [h]
          rw [real_inner_smul_right, real_inner_self_eq_norm_sq]
          rw [sq, ← mul_assoc, div_mul_cancel₀ R (ne_of_gt hp_pos)]
        rw [h_eval] at h_in
        nlinarith
    refine ⟨hp_diff, ?_⟩
    have h_denom_pos : 0 < 1 + 3 * C₁ := by linarith
    let ℓ : ℝ := R / (1 + 3 * C₁)
    have hℓ_pos : 0 < ℓ := div_pos hR h_denom_pos
    have hℓ_mul : ℓ * (1 + 3 * C₁) = R := div_mul_cancel₀ R (ne_of_gt h_denom_pos)
    have hℓ_le_R : ℓ ≤ R := by nlinarith
    have hℓ_abs_R : |ℓ| ≤ R := by rw [abs_of_pos hℓ_pos]; exact hℓ_le_R
    have hℓ_abs_2R : |ℓ| ≤ 2 * R := by rw [abs_of_pos hℓ_pos]; linarith
    let h : EuclideanSpace ℝ (Fin d) := ℓ • p
    have hh1 : ‖h - ℓ • p‖ ≤ R := by simp [h, le_of_lt hR]
    have hh2 : ‖h - ℓ • p'‖ ≤ 2 * R := by
      have h_eq : h - ℓ • p' = ℓ • (p - p') := by simp [h, smul_sub]
      rw [h_eq, norm_smul, Real.norm_eq_abs, abs_of_pos hℓ_pos, norm_sub_rev]
      nlinarith
    have hb1 := abs_le.mp (hfit1 h ℓ hℓ_abs_R hh1)
    have hb2 := abs_le.mp (hfit2 h ℓ hℓ_abs_2R hh2)
    have h_ip1 : inner ℝ p h = ℓ * ‖p‖ ^ 2 := by
      dsimp [h]
      rw [real_inner_smul_right, real_inner_self_eq_norm_sq]
    have h_ip2 : inner ℝ p' h = ℓ * inner ℝ p' p := by
      dsimp [h]
      rw [real_inner_smul_right]
    have h_norm_sub : ‖p' - p‖ ^ 2 = ‖p'‖ ^ 2 - 2 * inner ℝ p' p + ‖p‖ ^ 2 :=
      norm_sub_sq_real p' p
    have h_diff_id :
        (w (mkSpaceTime (x₀ + h) (t₀ + ℓ)) - w (mkSpaceTime x₀ t₀) -
          inner ℝ p h - (a - ‖p‖ ^ 2 / 2) * ℓ) -
        (w (mkSpaceTime (x₀ + h) (t₀ + ℓ)) - w (mkSpaceTime x₀ t₀) -
          inner ℝ p' h - (a' - ‖p'‖ ^ 2 / 2) * ℓ) =
        (a' - a - ‖p' - p‖ ^ 2 / 2) * ℓ := by
      rw [h_ip1, h_ip2, h_norm_sub]
      ring
    have h3R : 3 * C₁ * R = (3 * C₁ * (1 + 3 * C₁)) * ℓ := by
      rw [← hℓ_mul]
      ring
    have h_bd_low : (-(3 * C₁ * (1 + 3 * C₁))) * ℓ ≤ (a' - a - ‖p' - p‖ ^ 2 / 2) * ℓ := by
      linarith [hb1.1, hb2.2, h_diff_id, h3R]
    have h_bd_high : (a' - a - ‖p' - p‖ ^ 2 / 2) * ℓ ≤ (3 * C₁ * (1 + 3 * C₁)) * ℓ := by
      linarith [hb1.2, hb2.1, h_diff_id, h3R]
    have h_cancel_low : -(3 * C₁ * (1 + 3 * C₁)) ≤ a' - a - ‖p' - p‖ ^ 2 / 2 :=
      le_of_mul_le_mul_right h_bd_low hℓ_pos
    have h_cancel_high : a' - a - ‖p' - p‖ ^ 2 / 2 ≤ 3 * C₁ * (1 + 3 * C₁) :=
      le_of_mul_le_mul_right h_bd_high hℓ_pos
    have h_sq_le : ‖p' - p‖ ^ 2 ≤ 9 * C₁ ^ 2 := by
      have h_nn : 0 ≤ ‖p' - p‖ := norm_nonneg _
      nlinarith
    have h_sq_nn : 0 ≤ ‖p' - p‖ ^ 2 := sq_nonneg _
    rw [abs_le]
    constructor <;> linarith
  have h_ind_54 : ∀ k : ℕ, (k : ℝ) + 4 ≤ 4 * (5 / 4 : ℝ) ^ k := by
    intro k
    induction' k with k ih
    · norm_num
    · push_cast
      rw [pow_succ']
      have hk_nn : (0 : ℝ) ≤ (k : ℝ) := Nat.cast_nonneg k
      linarith
  have h_ind_85 : ∀ k : ℕ, 1 + (3 / 5 : ℝ) * (k : ℝ) ≤ (8 / 5 : ℝ) ^ k := by
    intro k
    induction' k with k ih
    · norm_num
    · push_cast
      rw [pow_succ']
      have hk_nn : (0 : ℝ) ≤ (k : ℝ) := Nat.cast_nonneg k
      linarith
  have h_ind_3225 : ∀ k : ℕ, 1 + (7 / 25 : ℝ) * (k : ℝ) ≤ (32 / 25 : ℝ) ^ k := by
    intro k
    induction' k with k ih
    · norm_num
    · push_cast
      rw [pow_succ']
      have hk_nn : (0 : ℝ) ≤ (k : ℝ) := Nat.cast_nonneg k
      linarith
  have h_ind_2 : ∀ k : ℕ, (k : ℝ) ≤ (2 : ℝ) ^ k := by
    intro k
    induction' k with k ih
    · norm_num
    · push_cast
      rw [pow_succ']
      have h1 : (1 : ℝ) ≤ (2 : ℝ) ^ k := one_le_pow₀ (by norm_num)
      linarith
  let B₁ : ℝ := 3 * C₁ * (1 + 3 * C₁) + (9 / 2) * C₁ ^ 2
  have h3C₁_le_B₁ : 3 * C₁ ≤ B₁ := by
    dsimp [B₁]
    nlinarith
  have hB₁_ge_one : 1 ≤ B₁ := by linarith
  have h_growth : HasUniformSubquadraticGrowth d C₁ := by
    intro T hT ε hε
    let B₀ : ℝ := 4 * B₁
    let T₁ : ℝ := T + 1
    have hB₀_ge_4 : 4 ≤ B₀ := by dsimp [B₀]; linarith
    have hT₁_ge_one : 1 ≤ T₁ := by dsimp [T₁]; linarith
    let K_req : ℝ := (5 / 4 : ℝ) * max (T₁ * B₀) ((4 / ε) * ((3 / 2 : ℝ) * B₀ + 1 + 2 * C₁))
    obtain ⟨k₀, hk₀⟩ := exists_nat_ge ((5 / 3 : ℝ) * K_req)
    have hK_le_k0 : K_req ≤ (8 / 5 : ℝ) ^ k₀ := by
      have h1 := h_ind_85 k₀
      linarith
    have hK_dom : ∀ n : ℕ, k₀ ≤ n → K_req * (5 / 4 : ℝ) ^ n ≤ (2 : ℝ) ^ n := by
      intro n hn
      have h85_mono : (8 / 5 : ℝ) ^ k₀ ≤ (8 / 5 : ℝ) ^ n :=
        pow_le_pow_right₀ (by norm_num) hn
      have hK_le_n : K_req ≤ (8 / 5 : ℝ) ^ n := le_trans hK_le_k0 h85_mono
      have h54_pos : (0 : ℝ) ≤ (5 / 4 : ℝ) ^ n := by positivity
      have h_mul : K_req * (5 / 4 : ℝ) ^ n ≤ (8 / 5 : ℝ) ^ n * (5 / 4 : ℝ) ^ n :=
        mul_le_mul_of_nonneg_right hK_le_n h54_pos
      have h_pow_eq : (8 / 5 : ℝ) ^ n * (5 / 4 : ℝ) ^ n = (2 : ℝ) ^ n := by
        rw [← mul_pow]
        norm_num
      linarith
    refine ⟨(2 : ℝ) ^ k₀, by positivity, ?_⟩
    intro w hw hw_cent x t ht hx_ge
    have hw0 : w (mkSpaceTime 0 1) = 0 := hw_cent.1
    have hfit0 : IsFitAt d C₁ w 0 1 1 0 0 := hw_cent.2
    have h_ex_fit : ∀ k : ℕ, ∃ (p : EuclideanSpace ℝ (Fin d)) (a : ℝ),
        IsFitAt d C₁ w 0 1 ((2 : ℝ) ^ k) p a := by
      intro k
      exact hw.2.2.2 0 1 ((2 : ℝ) ^ k) (by positivity)
    let p : ℕ → EuclideanSpace ℝ (Fin d) :=
      fun k => if k = 0 then 0 else Classical.choose (h_ex_fit k)
    let a : ℕ → ℝ :=
      fun k => if k = 0 then 0 else Classical.choose (Classical.choose_spec (h_ex_fit k))
    have hfit : ∀ k : ℕ, IsFitAt d C₁ w 0 1 ((2 : ℝ) ^ k) (p k) (a k) := by
      intro k
      by_cases hk : k = 0
      · subst hk
        simpa [p, a] using hfit0
      · simp only [p, a, hk, ↓reduceIte]
        exact Classical.choose_spec (Classical.choose_spec (h_ex_fit k))
    have hpa_lin : ∀ k : ℕ, ‖p k‖ ≤ B₁ * (k : ℝ) ∧ |a k| ≤ B₁ * (k : ℝ) := by
      intro k
      induction' k with k ih
      · simp [p, a]
      · have h_R_eq : (2 : ℝ) ^ (k + 1) = 2 * (2 : ℝ) ^ k := pow_succ' 2 k
        have hfit_succ : IsFitAt d C₁ w 0 1 (2 * (2 : ℝ) ^ k) (p (k + 1)) (a (k + 1)) := by
          rw [← h_R_eq]
          exact hfit (k + 1)
        have h_step := h_two_scale w 0 1 ((2 : ℝ) ^ k) (by positivity) (p k) (p (k + 1)) (a k) (a (k + 1))
          (hfit k) hfit_succ
        have ha_step : |a (k + 1) - a k| ≤ B₁ := h_step.2
        have hp_tri : ‖p (k + 1)‖ ≤ ‖p k‖ + ‖p (k + 1) - p k‖ := by
          simpa using norm_add_le (p k) (p (k + 1) - p k)
        have ha_tri : |a (k + 1)| ≤ |a k| + |a (k + 1) - a k| := by
          simpa using abs_add_le (a k) (a (k + 1) - a k)
        push_cast
        constructor <;> linarith [ih.1, ih.2, h_step.1, ha_step, h3C₁_le_B₁, hp_tri, ha_tri]
    have hpa_exp : ∀ k : ℕ, ‖p k‖ ≤ B₀ * (5 / 4 : ℝ) ^ k ∧ |a k| ≤ B₀ * (5 / 4 : ℝ) ^ k := by
      intro k
      have hk_le : (k : ℝ) ≤ 4 * (5 / 4 : ℝ) ^ k := by linarith [h_ind_54 k]
      have hB₁_nn : 0 ≤ B₁ := by linarith
      have h_mul : B₁ * (k : ℝ) ≤ B₀ * (5 / 4 : ℝ) ^ k := by
        dsimp [B₀]
        nlinarith
      exact ⟨le_trans (hpa_lin k).1 h_mul, le_trans (hpa_lin k).2 h_mul⟩
    have h_single_scale : ∀ n : ℕ, k₀ ≤ n → ‖x‖ ≤ (2 : ℝ) ^ n →
        |w (mkSpaceTime x t)| ≤ (ε / 4) * ((2 : ℝ) ^ n) ^ 2 := by
      intro n hn hx_n
      let k : ℕ := n + 1
      have h54_n_ge_1 : (1 : ℝ) ≤ (5 / 4 : ℝ) ^ n := one_le_pow₀ (by norm_num)
      have h54_k_ge_1 : (1 : ℝ) ≤ (5 / 4 : ℝ) ^ k := one_le_pow₀ (by norm_num)
      have h54_succ : (5 / 4 : ℝ) ^ k = (5 / 4 : ℝ) * (5 / 4 : ℝ) ^ n := pow_succ' (5 / 4 : ℝ) n
      have h2_succ : (2 : ℝ) ^ k = 2 * (2 : ℝ) ^ n := pow_succ' 2 n
      have h2n_pos : (0 : ℝ) < (2 : ℝ) ^ n := by positivity
      have hK_n : K_req * (5 / 4 : ℝ) ^ n ≤ (2 : ℝ) ^ n := hK_dom n hn
      have hK_1 : (5 / 4 : ℝ) * (T₁ * B₀) ≤ K_req :=
        mul_le_mul_of_nonneg_left (le_max_left _ _) (by norm_num)
      have hK_2 : (5 / 4 : ℝ) * ((4 / ε) * ((3 / 2 : ℝ) * B₀ + 1 + 2 * C₁)) ≤ K_req :=
        mul_le_mul_of_nonneg_left (le_max_right _ _) (by norm_num)
      have hTB_bound : T₁ * (B₀ * (5 / 4 : ℝ) ^ k) ≤ (2 : ℝ) ^ n := by
        have h_eq : T₁ * (B₀ * (5 / 4 : ℝ) ^ k) = ((5 / 4 : ℝ) * (T₁ * B₀)) * (5 / 4 : ℝ) ^ n := by
          rw [h54_succ]
          ring
        rw [h_eq]
        have h_le : ((5 / 4 : ℝ) * (T₁ * B₀)) * (5 / 4 : ℝ) ^ n ≤ K_req * (5 / 4 : ℝ) ^ n :=
          mul_le_mul_of_nonneg_right hK_1 (by positivity)
        exact le_trans h_le hK_n
      have hp_k := (hpa_exp k).1
      have ha_k := (hpa_exp k).2
      have hT₁_pk : T₁ * ‖p k‖ ≤ (2 : ℝ) ^ n := by nlinarith
      have hT₁_ak : T₁ * |a k| ≤ (2 : ℝ) ^ n := by nlinarith
      have hB54_ge_1 : 1 ≤ B₀ * (5 / 4 : ℝ) ^ k := by nlinarith
      have hT₁_le_2n : T₁ ≤ (2 : ℝ) ^ n := by nlinarith
      have h_coef_bound : (3 / 2 : ℝ) * ‖p k‖ + 1 + 2 * C₁ ≤ (ε / 4) * (2 : ℝ) ^ n := by
        have h_step1 : (3 / 2 : ℝ) * ‖p k‖ + 1 + 2 * C₁ ≤
            ((3 / 2 : ℝ) * B₀ + 1 + 2 * C₁) * (5 / 4 : ℝ) ^ k := by
          nlinarith
        have h_eq : ((3 / 2 : ℝ) * B₀ + 1 + 2 * C₁) * (5 / 4 : ℝ) ^ k =
            (ε / 4) * (((5 / 4 : ℝ) * ((4 / ε) * ((3 / 2 : ℝ) * B₀ + 1 + 2 * C₁))) * (5 / 4 : ℝ) ^ n) := by
          rw [h54_succ]
          have hε_ne : ε ≠ 0 := ne_of_gt hε
          field_simp [hε_ne]
        have h_step2 :
            ((5 / 4 : ℝ) * ((4 / ε) * ((3 / 2 : ℝ) * B₀ + 1 + 2 * C₁))) * (5 / 4 : ℝ) ^ n ≤ (2 : ℝ) ^ n :=
          le_trans (mul_le_mul_of_nonneg_right hK_2 (by positivity)) hK_n
        nlinarith
      let ℓ : ℝ := t - 1
      have hℓ_le_T₁ : |ℓ| ≤ T₁ := by
        dsimp [ℓ, T₁]
        have h_tri := abs_sub_le t 0 1
