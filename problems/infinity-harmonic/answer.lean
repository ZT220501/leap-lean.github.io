      have h_eval1 := (abs_le.mp h_eval).1
      have h_eval2 := (abs_le.mp h_eval).2
      have hv1_1 := (abs_le.mp hv1).1
      have hv1_2 := (abs_le.mp hv1).2
      have hv2_1 := (abs_le.mp hv2).1
      have hv2_2 := (abs_le.mp hv2).2
      have ha_upper : a * r ≤ A_r * r := by nlinarith [sq_nonneg ‖p‖]
      have ha_lower : (-A_r) * r ≤ a * r := by nlinarith [sq_nonneg ‖p‖]
      rw [abs_le]
      exact ⟨le_of_mul_le_mul_right ha_lower hr, le_of_mul_le_mul_right ha_upper hr⟩
    exact ⟨hp_le, ha_le⟩
  have hm_ge : ∀ n : ℕ, h ≤ φ₀ (n + h) := by
    intro n
    have h1 : n + h ≤ φ₀ (n + h) := hφ₀_mono.id_le (n + h)
    omega
  have hj_ex : ∀ n : ℕ, ∃ j : ℕ, h ≤ j ∧ j ≤ M_blk h ∧ j ≤ N_seq (φ₀ (n + h)) ∧
      ‖x_term (φ₀ (n + h)) - x_mk (φ₀ (n + h)) j -
        ((1 / 2 : ℝ) ^ (N_seq (φ₀ (n + h))) - (1 / 2 : ℝ) ^ j) • p_mk (φ₀ (n + h)) j‖ ≤
        K * (1 / 2 : ℝ) ^ j :=
    fun n => (h_pre.2.2.2.2.2 (φ₀ (n + h))).2.2.2.2.2 h hh (hm_ge n)
  let j_seq : ℕ → ℕ := fun n => Classical.choose (hj_ex n)
  have hj_spec : ∀ n : ℕ, h ≤ j_seq n ∧ j_seq n ≤ M_blk h ∧ j_seq n ≤ N_seq (φ₀ (n + h)) ∧
      ‖x_term (φ₀ (n + h)) - x_mk (φ₀ (n + h)) (j_seq n) -
        ((1 / 2 : ℝ) ^ (N_seq (φ₀ (n + h))) - (1 / 2 : ℝ) ^ (j_seq n)) • p_mk (φ₀ (n + h)) (j_seq n)‖ ≤
        K * (1 / 2 : ℝ) ^ (j_seq n) :=
    fun n => Classical.choose_spec (hj_ex n)
  have hj_mem : ∀ n : ℕ, j_seq n ∈ Set.Icc h (M_blk h) :=
    fun n => ⟨(hj_spec n).1, (hj_spec n).2.1⟩
  obtain ⟨j, hj_Icc, ψ₁, hψ₁_mono, hj_lim⟩ :=
    (Set.finite_Icc h (M_blk h)).isCompact.tendsto_subseq hj_mem
  have hj_pure : Filter.Tendsto (j_seq ∘ ψ₁) Filter.atTop (pure j) := by
    rwa [congr_fun (nhds_discrete ℕ) j] at hj_lim
  obtain ⟨S₀, hS₀⟩ := Filter.eventually_atTop.mp (Filter.tendsto_pure.mp hj_pure)
  let ψ : ℕ → ℕ := fun s => ψ₁ (s + S₀) + h
  have hψ_mono : StrictMono ψ := by
    intro s₁ s₂ hs
    dsimp [ψ]
    have h1 : s₁ + S₀ < s₂ + S₀ := by omega
    have h2 : ψ₁ (s₁ + S₀) < ψ₁ (s₂ + S₀) := hψ₁_mono h1
    omega
  have hj_ge : h ≤ j := hj_Icc.1
  have hj1 : 1 ≤ j := le_trans hh hj_ge
  let r_j : ℝ := (1 / 2 : ℝ) ^ j
  let μ : ℕ → ℕ := fun s => φ₀ (ψ s)
  have h_sub : ∀ s : ℕ,
      j ≤ N_seq (μ s) ∧
      ‖x_mk (μ s) j‖ ≤ R + 1 ∧
      IsFitAt d C₁ v (x_mk (μ s) j) r_j r_j (p_mk (μ s) j) (a_mk (μ s) j) ∧
      L₀ - D₀ * (2 : ℝ) ^ j ≤
        driftFunctional d κ (ε_seq (μ s)) v (mkSpaceTime (x_mk (μ s) j) r_j) ∧
      ‖x_term (μ s) - x_mk (μ s) j - ((1 / 2 : ℝ) ^ (N_seq (μ s)) - r_j) • p_mk (μ s) j‖ ≤
        K * r_j := by
    intro s
    have hj_eq : j_seq (ψ₁ (s + S₀)) = j := hS₀ (s + S₀) (by omega)
    have h_sp := hj_spec (ψ₁ (s + S₀))
    rw [hj_eq] at h_sp
    have h_mk := (h_pre.2.2.2.2.2 (μ s)).2.2.2.2.1 j hj1 h_sp.2.2.1
    exact ⟨h_sp.2.2.1, h_mk.1, h_mk.2.1, h_mk.2.2, h_sp.2.2.2⟩
  have hr_pos : 0 < r_j := by positivity
  obtain ⟨P_r, A_r, _, _, h_bounds⟩ := h_fit_bounds (R + 1) r_j r_j hr_pos
  let seq_fit : ℕ → EuclideanSpace ℝ (Fin d) × (EuclideanSpace ℝ (Fin d) × ℝ) :=
    fun s => (x_mk (μ s) j, (p_mk (μ s) j, a_mk (μ s) j))
  let K_fit : Set (EuclideanSpace ℝ (Fin d) × (EuclideanSpace ℝ (Fin d) × ℝ)) :=
    Metric.closedBall 0 (R + 1) ×ˢ (Metric.closedBall 0 P_r ×ˢ Set.Icc (-A_r) A_r)
  have hK_comp : IsCompact K_fit :=
    (ProperSpace.isCompact_closedBall 0 (R + 1)).prod
      ((ProperSpace.isCompact_closedBall 0 P_r).prod isCompact_Icc)
  have h_seq_mem : ∀ s : ℕ, seq_fit s ∈ K_fit := by
    intro s
    have hs := h_sub s
    have hpa := h_bounds (x_mk (μ s) j) (p_mk (μ s) j) (a_mk (μ s) j) hs.2.1 hs.2.2.1
    refine ⟨?_, ?_, ?_⟩
    · rw [Metric.mem_closedBall, dist_zero_right]
      exact hs.2.1
    · rw [Metric.mem_closedBall, dist_zero_right]
      exact hpa.1
    · exact abs_le.mp hpa.2
  obtain ⟨⟨x, p, a⟩, _, ψ₂, hψ₂_mono, h_lim⟩ := hK_comp.tendsto_subseq h_seq_mem
  let ν : ℕ → ℕ := fun s => μ (ψ₂ s)
  have hx_lim : Filter.Tendsto (fun s => x_mk (ν s) j) Filter.atTop (nhds x) :=
    (continuous_fst.tendsto (x, (p, a))).comp h_lim
  have hpa_lim : Filter.Tendsto (fun s => (p_mk (ν s) j, a_mk (ν s) j)) Filter.atTop (nhds (p, a)) :=
    (continuous_snd.tendsto (x, (p, a))).comp h_lim
  have hp_lim : Filter.Tendsto (fun s => p_mk (ν s) j) Filter.atTop (nhds p) :=
    (continuous_fst.tendsto (p, a)).comp hpa_lim
  have ha_lim : Filter.Tendsto (fun s => a_mk (ν s) j) Filter.atTop (nhds a) :=
    (continuous_snd.tendsto (p, a)).comp hpa_lim
  have h_fit_lim : IsFitAt d C₁ v x r_j r_j p a :=
    h_fit_tendsto r_j r_j x p a
      (fun s => x_mk (ν s) j) (fun s => p_mk (ν s) j) (fun s => a_mk (ν s) j)
      hx_lim hp_lim ha_lim (fun s => (h_sub (ψ₂ s)).2.2.1)
  have hν_mono : StrictMono ν := hφ₀_mono.comp (hψ_mono.comp hψ₂_mono)
  have hN_mono : StrictMono (fun s => N_seq (ν s)) := h_pre.2.2.2.1.comp hν_mono
  have hτ_lim : Filter.Tendsto (fun s => (1 / 2 : ℝ) ^ (N_seq (ν s))) Filter.atTop (nhds 0) :=
    (tendsto_pow_atTop_nhds_zero_of_lt_one (by norm_num) (by norm_num)).comp hN_mono.tendsto_atTop
  have hε_lim : Filter.Tendsto (fun s => ε_seq (ν s)) Filter.atTop (nhds 0) := by
    refine squeeze_zero (fun s => le_of_lt (h_pre.2.2.2.2.2 (ν s)).1)
      (fun s => (h_pre.2.2.2.2.2 (ν s)).2.1) ?_
    simpa using hτ_lim.div_const (4 : ℝ)
  have h_env : shiftedBarycentricEnvelope d κ v (mkSpaceTime x r_j) = v (mkSpaceTime x r_j) := by
    apply h_contact j x (fun s => x_mk (ν s) j) (fun s => ε_seq (ν s)) hj1 hx_lim hε_lim
    intro s
    have hm := h_pre.2.2.2.2.2 (ν s)
    have hs := h_sub (ψ₂ s)
    have h_pow : (1 / 2 : ℝ) ^ (N_seq (ν s)) ≤ r_j :=
      pow_le_pow_of_le_one (by norm_num) (by norm_num) hs.1
    refine ⟨hm.1, ?_, hs.2.2.2.1⟩
    linarith [hm.2.1]
  have hx_term_lim : Filter.Tendsto (fun s => x_term (ν s)) Filter.atTop (nhds x_end) :=
    hx_end.comp (hψ_mono.comp hψ₂_mono).tendsto_atTop
  have h_smul_lim :
      Filter.Tendsto (fun s => ((1 / 2 : ℝ) ^ (N_seq (ν s)) - r_j) • p_mk (ν s) j)
        Filter.atTop (nhds ((0 - r_j) • p)) :=
    (hτ_lim.sub tendsto_const_nhds).smul hp_lim
  have h_vec_lim :
      Filter.Tendsto
        (fun s => x_term (ν s) - x_mk (ν s) j - ((1 / 2 : ℝ) ^ (N_seq (ν s)) - r_j) • p_mk (ν s) j)
        Filter.atTop (nhds (x_end - x + r_j • p)) := by
    have h1 := (hx_term_lim.sub hx_lim).sub h_smul_lim
    have h_eq : x_end - x - (0 - r_j) • p = x_end - x + r_j • p := by
      rw [zero_sub, neg_smul, sub_neg_eq_add]
    rwa [h_eq] at h1
  have h_loc_lim : ‖x_end - x + r_j • p‖ ≤ K * r_j :=
    le_of_tendsto h_vec_lim.norm (Filter.Eventually.of_forall (fun s => (h_sub (ψ₂ s)).2.2.2.2))
  exact ⟨j, x, p, a, hj_ge, h_env, h_fit_lim, h_loc_lim⟩

theorem diagonal_limit_of_prelimit_contacts (d : ℕ) (hd : 3 ≤ d) (C₁ : ℝ) (hC₁ : 1 ≤ C₁)
    (κ : ℝ) (hκ : 0 < κ) (v : EuclideanSpace ℝ (Fin (d + 1)) → ℝ)
    (hv_class : InLimitingClassA d C₁ v)
    (hv_cent : IsCenteredAt d C₁ v 0 1)
    (hv_jensen : HasHorizontalJensenBound d κ v)
    (R K L₀ D₀ : ℝ) (M_blk N_seq : ℕ → ℕ) (ε_seq : ℕ → ℝ)
    (x_term : ℕ → EuclideanSpace ℝ (Fin d))
    (x_mk p_mk : ℕ → ℕ → EuclideanSpace ℝ (Fin d))
    (a_mk : ℕ → ℕ → ℝ)
    (h_pre : HasPrelimitWalkContacts d C₁ κ v R K L₀ D₀ M_blk N_seq ε_seq x_term x_mk p_mk a_mk) :
    ∃ (x_end : EuclideanSpace ℝ (Fin d)) (H_end : ℝ)
      (k : ℕ → ℕ) (x_seq : ℕ → EuclideanSpace ℝ (Fin d))
      (p_seq : ℕ → EuclideanSpace ℝ (Fin d)) (a_seq : ℕ → ℝ),
      HasCommonSlopeLimit d v (mkSpaceTime x_end 0) H_end ∧
      StrictMono k ∧
      ∀ j : ℕ,
        let r_j : ℝ := (1 / 2 : ℝ) ^ (k j)
        shiftedBarycentricEnvelope d κ v (mkSpaceTime (x_seq j) r_j) =
          v (mkSpaceTime (x_seq j) r_j) ∧
        IsFitAt d C₁ v (x_seq j) r_j r_j (p_seq j) (a_seq j) ∧
        ‖x_end - x_seq j + r_j • p_seq j‖ ≤ K * r_j :=
by
  have hC₁_nonneg : (0 : ℝ) ≤ C₁ := by linarith
  have h_growth := subquadratic_growth_of_inLimitingClassA d C₁ hC₁_nonneg v hv_class
  obtain ⟨h_comp, h_attain, h_mono⟩ :=
    envelope_attainment_and_slope_monotonicity d C₁ hC₁_nonneg v hv_class h_growth
  obtain ⟨_, h_fwd_to_common⟩ :=
    common_slope_limit_of_monotone_envelopes d v hv_class.1 h_growth h_comp h_attain h_mono
  have hx_mem : ∀ m : ℕ, x_term m ∈ Metric.closedBall (0 : EuclideanSpace ℝ (Fin d)) (R + 1) := by
    intro m
    rw [Metric.mem_closedBall, dist_zero_right]
    exact (h_pre.2.2.2.2.2 m).2.2.1
  obtain ⟨x_end, _, φ₀, hφ₀_mono, hx_end⟩ :=
    (ProperSpace.isCompact_closedBall (0 : EuclideanSpace ℝ (Fin d)) (R + 1)).tendsto_subseq hx_mem
  have hN_mono : StrictMono (fun r => N_seq (φ₀ r)) := h_pre.2.2.2.1.comp hφ₀_mono
  have hτ_lim : Filter.Tendsto (fun r => (1 / 2 : ℝ) ^ (N_seq (φ₀ r))) Filter.atTop (nhds 0) :=
    (tendsto_pow_atTop_nhds_zero_of_lt_one (by norm_num) (by norm_num)).comp hN_mono.tendsto_atTop
  obtain ⟨L_end, hL_end⟩ :=
    terminal_slope_lower_bound_of_prelimit_drift d κ hκ v hv_class.1 hv_jensen
      h_growth h_comp h_attain h_mono R L₀ x_end
      (fun r => x_term (φ₀ r)) (fun r => (1 / 2 : ℝ) ^ (N_seq (φ₀ r))) (fun r => ε_seq (φ₀ r))
      hx_end hτ_lim (fun r => by
        have hm := h_pre.2.2.2.2.2 (φ₀ r)
        refine ⟨by positivity, pow_le_one₀ (by norm_num) (by norm_num),
          hm.1, hm.2.1, hm.2.2.1, hm.2.2.2.1⟩)
  obtain ⟨H_end, hslope_end⟩ := h_fwd_to_common x_end 0 L_end hL_end
  have h_contact : ∀ (j : ℕ) (x_star : EuclideanSpace ℝ (Fin d))
      (x_s : ℕ → EuclideanSpace ℝ (Fin d)) (ε_s : ℕ → ℝ),
      1 ≤ j →
      let δ_j : ℝ := (1 / 2 : ℝ) ^ j
      Filter.Tendsto x_s Filter.atTop (nhds x_star) →
      Filter.Tendsto ε_s Filter.atTop (nhds 0) →
      (∀ s : ℕ, 0 < ε_s s ∧ ε_s s ≤ δ_j / 4 ∧
        L₀ - D₀ * (2 : ℝ) ^ j ≤ driftFunctional d κ (ε_s s) v (mkSpaceTime (x_s s) δ_j)) →
      shiftedBarycentricEnvelope d κ v (mkSpaceTime x_star δ_j) = v (mkSpaceTime x_star δ_j) := by
    intro j x_star x_s ε_s _ δ_j hx_s hε_s h_seq
    exact barycentric_contact_of_drift_lower_bound d κ hκ v hv_class.1 hv_jensen h_growth
      δ_j (L₀ - D₀ * (2 : ℝ) ^ j) (by positivity) x_star x_s ε_s hx_s hε_s h_seq
  have h_block := localized_contact_scale_of_prelimit_block d C₁ κ hC₁_nonneg v hv_class.1
    R K L₀ D₀ M_blk N_seq ε_seq x_term x_mk p_mk a_mk h_pre h_contact x_end φ₀ hφ₀_mono hx_end
  let P_scale (j : ℕ) : Prop :=
    ∃ (x p : EuclideanSpace ℝ (Fin d)) (a : ℝ),
      let r_j : ℝ := (1 / 2 : ℝ) ^ j
      shiftedBarycentricEnvelope d κ v (mkSpaceTime x r_j) = v (mkSpaceTime x r_j) ∧
      IsFitAt d C₁ v x r_j r_j p a ∧
      ‖x_end - x + r_j • p‖ ≤ K * r_j
  have h_step : ∀ h : ℕ, 1 ≤ h → ∃ j : ℕ, h ≤ j ∧ P_scale j := by
    intro h hh
    obtain ⟨j, x, p, a, hj_ge, h_j⟩ := h_block h hh
    exact ⟨j, hj_ge, x, p, a, h_j⟩
  let k : ℕ → ℕ := fun n =>
    Nat.recOn n (Classical.choose (h_step 1 le_rfl))
      (fun _ kn => Classical.choose (h_step (kn + 1) (Nat.succ_pos kn)))
  have hk_mono : StrictMono k := by
    apply strictMono_nat_of_lt_succ
    intro n
    exact (Classical.choose_spec (h_step (k n + 1) (Nat.succ_pos (k n)))).1
  have hk_prop : ∀ j : ℕ, P_scale (k j) := by
    intro j
    cases j with
    | zero => exact (Classical.choose_spec (h_step 1 le_rfl)).2
    | succ n => exact (Classical.choose_spec (h_step (k n + 1) (Nat.succ_pos (k n)))).2
  let x_seq : ℕ → EuclideanSpace ℝ (Fin d) := fun j => Classical.choose (hk_prop j)
  let p_seq : ℕ → EuclideanSpace ℝ (Fin d) := fun j => Classical.choose (Classical.choose_spec (hk_prop j))
  let a_seq : ℕ → ℝ := fun j => Classical.choose (Classical.choose_spec (Classical.choose_spec (hk_prop j)))
  refine ⟨x_end, H_end, k, x_seq, p_seq, a_seq, hslope_end, hk_mono, fun j => ?_⟩
  exact Classical.choose_spec (Classical.choose_spec (Classical.choose_spec (hk_prop j)))

theorem stopped_walk_contact_localization (d : ℕ) (hd : 3 ≤ d) (C₁ : ℝ) (hC₁ : 1 ≤ C₁)
    (κ H_star : ℝ) (hκ : 0 < κ) (v : EuclideanSpace ℝ (Fin (d + 1)) → ℝ)
    (hv_class : InLimitingClassA d C₁ v)
    (hv_cent : IsCenteredAt d C₁ v 0 1)
    (hv_jensen : HasHorizontalJensenBound d κ v)
    (hv_gap : barycentricEnvelope d 1 v (mkSpaceTime 0 1) - v (mkSpaceTime 0 1) = κ ^ 2 / 2)
    (hv_slope : HasCommonSlopeLimit d v (mkSpaceTime 0 1) H_star ∧
      Filter.Tendsto (fun ℓ => slopePlus d ℓ (shiftedBarycentricEnvelope d κ v) (mkSpaceTime 0 1))
        (nhdsWithin 0 (Set.Ioi 0)) (nhds H_star)) :
    ∃ (K : ℝ) (x_end : EuclideanSpace ℝ (Fin d)) (H_end : ℝ)
      (k : ℕ → ℕ) (x_seq : ℕ → EuclideanSpace ℝ (Fin d))
      (p_seq : ℕ → EuclideanSpace ℝ (Fin d)) (a_seq : ℕ → ℝ),
      0 < K ∧
      HasCommonSlopeLimit d v (mkSpaceTime x_end 0) H_end ∧
      StrictMono k ∧
      ∀ j : ℕ,
        let r_j : ℝ := (1 / 2 : ℝ) ^ (k j)
        shiftedBarycentricEnvelope d κ v (mkSpaceTime (x_seq j) r_j) =
          v (mkSpaceTime (x_seq j) r_j) ∧
        IsFitAt d C₁ v (x_seq j) r_j r_j (p_seq j) (a_seq j) ∧
        ‖x_end - x_seq j + r_j • p_seq j‖ ≤ K * r_j :=
by
  let z₀ : EuclideanSpace ℝ (Fin (d + 1)) := mkSpaceTime 0 1
  let W : EuclideanSpace ℝ (Fin (d + 1)) → ℝ := shiftedBarycentricEnvelope d κ v
  have hz₀_t : projTime z₀ = 1 := by
    simp [z₀, mkSpaceTime, projTime]
  have hW_eq_v : shiftedBarycentricEnvelope d κ v z₀ = v z₀ := by
    dsimp [shiftedBarycentricEnvelope]
    rw [hz₀_t]
    linarith [hv_gap]
  have hJ_eq : ∀ ℓ : ℝ,
      driftFunctional d κ ℓ v z₀ =
        (slopePlus d ℓ W z₀ + slopeMinus d ℓ v z₀) / 2 := by
    intro ℓ
    dsimp [driftFunctional, slopePlus, slopeMinus, W]
    rw [hW_eq_v]
    ring
  have hJ_start : Filter.Tendsto
      (fun ℓ => driftFunctional d κ ℓ v z₀)
      (nhdsWithin 0 (Set.Ioi 0)) (nhds H_star) := by
    have h_sum := (hv_slope.2.add hv_slope.1.2).div_const (2 : ℝ)
    have h_half : (H_star + H_star) / 2 = H_star := by ring
    rw [h_half] at h_sum
    exact h_sum.congr (fun ℓ => (hJ_eq ℓ).symm)
  obtain ⟨Q_plus, Q_minus, Q_zero, hQ_opt_drift, hQ_step⟩ :=
    existence_of_drift_step_selectors d hd C₁ hC₁ κ hκ v hv_class hv_cent hv_jensen
  obtain ⟨C_vel, C_ub, hC_vel, hC_ub, hQ_vel, hJ_ub⟩ :=
    fitted_frame_step_velocity_bounds d hd C₁ hC₁ κ hκ v hv_class hv_cent hv_jensen
      Q_plus Q_minus Q_zero (fun x t ε hε ht => (hQ_opt_drift x t ε hε ht).1)
  obtain ⟨R, K, L₀, D₀, M_blk, N_seq, ε_seq, x_term, x_mk, p_mk, a_mk, h_pre⟩ :=
    stopped_walk_prelimit_localization d hd C₁ hC₁ κ H_star hκ v hv_class hv_cent hJ_start
      Q_plus Q_minus Q_zero (fun x t ε hε ht => (hQ_opt_drift x t ε hε ht).2)
      hQ_step C_vel C_ub hC_vel hC_ub hQ_vel hJ_ub
  obtain ⟨x_end, H_end, k, x_seq, p_seq, a_seq, hslope_end, hk_mono, h_contacts⟩ :=
    diagonal_limit_of_prelimit_contacts d hd C₁ hC₁ κ hκ v hv_class hv_cent hv_jensen
      R K L₀ D₀ M_blk N_seq ε_seq x_term x_mk p_mk a_mk h_pre
  exact ⟨K, x_end, H_end, k, x_seq, p_seq, a_seq, h_pre.2.1, hslope_end, hk_mono, h_contacts⟩

theorem centered_class_A_subquadratic_growth : ∀ (d : ℕ), 3 ≤ d → ∀ (C₁ : ℝ), 1 ≤ C₁ → HasUniformSubquadraticGrowth d C₁ :=
by
  intro d _hd C₁ hC₁ T hT ε hε
  have hC₁_nonneg : (0 : ℝ) ≤ C₁ := by linarith
  have h_two_scale :
      ∀ (w : EuclideanSpace ℝ (Fin (d + 1)) → ℝ) (R : ℝ), 0 < R →
        ∀ (p p' : EuclideanSpace ℝ (Fin d)) (a a' : ℝ),
          IsFitAt d C₁ w 0 1 R p a →
          IsFitAt d C₁ w 0 1 (2 * R) p' a' →
          ‖p' - p‖ ≤ 3 * C₁ ∧
          |a' - a| ≤ 3 * C₁ * (1 + 3 * C₁) + (9 / 2) * C₁ ^ 2 := by
    intro w R hR p p' a a' hfit1 hfit2
    have h_horiz : ∀ h : EuclideanSpace ℝ (Fin d), ‖h‖ ≤ R →
        inner ℝ (p' - p) h ≤ 3 * C₁ * R := by
      intro h hh
      have h0_le_R : |(0 : ℝ)| ≤ R := by simp [le_of_lt hR]
      have h0_le_2R : |(0 : ℝ)| ≤ 2 * R := by simp; linarith
      have hh1 : ‖h - (0 : ℝ) • p‖ ≤ R := by simpa using hh
      have hh2 : ‖h - (0 : ℝ) • p'‖ ≤ 2 * R := by
        have : ‖h - (0 : ℝ) • p'‖ = ‖h‖ := by simp
        linarith
      have hb1 := abs_le.mp (hfit1 h 0 h0_le_R hh1)
      have hb2 := abs_le.mp (hfit2 h 0 h0_le_2R hh2)
      rw [inner_sub_left]
      linarith
    have hp_diff : ‖p' - p‖ ≤ 3 * C₁ := by
      by_cases hp : ‖p' - p‖ = 0
      · linarith
      · have hp_pos : 0 < ‖p' - p‖ := norm_pos_iff.mpr (fun h_eq => hp (by simp [h_eq]))
        let h : EuclideanSpace ℝ (Fin d) := (R / ‖p' - p‖) • (p' - p)
        have hh_norm : ‖h‖ ≤ R := by
          dsimp [h]
          rw [norm_smul, Real.norm_eq_abs, abs_of_pos (div_pos hR hp_pos),
            div_mul_cancel₀ R (ne_of_gt hp_pos)]
        have h_in := h_horiz h hh_norm
