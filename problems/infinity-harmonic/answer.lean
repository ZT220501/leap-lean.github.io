    rw [h_cancel]
  refine ⟨p', q', hpq_bound, hA_ge_half, ?_⟩
  intro h ℓ hℓ_abs hh_sh
  set h_sh : EuclideanSpace ℝ (Fin d) := h - (A⁻¹ * ℓ) • p'
  set u : EuclideanSpace ℝ (Fin (d + 1)) := mkSpaceTime (Real.sqrt lam • h) ℓ
  set u_sh : EuclideanSpace ℝ (Fin (d + 1)) := mkSpaceTime (Real.sqrt lam • h_sh) 0
  set α : ℝ := ℓ * N * A⁻¹
