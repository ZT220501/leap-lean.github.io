        rw [Real.log_mul (by positivity) (ne_of_gt hL_pos),
          Real.log_mul (by positivity) (ne_of_gt hK_pos)]
      rw [h1, Real.log_pow]
      have h_log_S0 : Real.log S₀ ≤ S₀ - 1 := Real.log_le_sub_one_of_pos hS₀_pos
      have h_log_L : Real.log L ≤ L - 1 := Real.log_le_sub_one_of_pos hL_pos
      push_cast
      dsimp [L] at h_log_L ⊢
      nlinarith
    obtain ⟨p_R, a_R, hfit_R⟩ := hv_class.2.2.2 0 1 R hR_pos
    have hp_a_bound : ‖p_R‖ + |a_R| ≤ S₀ ^ 2 * L - 1 := by
      have h_cmp := h_same 0 1 1 R 0 p_R 0 a_R zero_lt_one hR_pos hv_cent.2 hfit_R
      rw [zero_sub, norm_neg, zero_sub, abs_neg] at h_cmp
      have h_cs : 40 * C₁ ^ 2 = (S₀ - 4) / 8 := by dsimp [S₀, C_same]; ring
      nlinarith
    have hp_R_le : ‖p_R‖ ≤ S₀ ^ 2 * L - 1 := by linarith [abs_nonneg a_R]
    have ha_R_le : |a_R| ≤ S₀ ^ 2 * L := by linarith [norm_nonneg p_R]
    have hs_le_R : |s - 1| ≤ R := by
      rw [hR_eq]
      nlinarith
    have hz_sheared : ‖z - (s - 1) • p_R‖ ≤ R := by
      have h_tri := norm_sub_le z ((s - 1) • p_R)
      rw [norm_smul, Real.norm_eq_abs] at h_tri
      have h_prod : |s - 1| * ‖p_R‖ ≤ K * (S₀ ^ 2 * L - 1) := by
        nlinarith [norm_nonneg p_R, abs_nonneg (s - 1)]
      dsimp [R]
      linarith
    have h_eval := hfit_R z (s - 1) hs_le_R hz_sheared
    have h0z : (0 : EuclideanSpace ℝ (Fin d)) + z = z := zero_add z
    have h1s : 1 + (s - 1) = s := add_sub_cancel 1 s
    rw [h0z, h1s, hv_cent.1, sub_zero] at h_eval
    let KL2 : ℝ := K * L ^ 2
    have hL_le_L2 : L ≤ L ^ 2 := by nlinarith
    have hKL_le_KL2 : K * L ≤ KL2 := by dsimp [KL2]; nlinarith
    have hKL2_pos : 0 < KL2 := by positivity
    have h_inner_le : |inner ℝ p_R z| ≤ S₀ ^ 2 * KL2 := by
      have h_cs := abs_real_inner_le_norm p_R z
      have h1 : |inner ℝ p_R z| ≤ (S₀ ^ 2 * L) * K := by
        nlinarith [norm_nonneg p_R, norm_nonneg z]
      have h2 : (S₀ ^ 2 * L) * K = S₀ ^ 2 * (K * L) := by ring
      rw [h2] at h1
      nlinarith
    have h_a_s_le : |a_R * (s - 1)| ≤ S₀ ^ 2 * KL2 := by
      rw [abs_mul]
      have h1 : |a_R| * |s - 1| ≤ (S₀ ^ 2 * L) * K := by
        nlinarith [abs_nonneg a_R, abs_nonneg (s - 1)]
      have h2 : (S₀ ^ 2 * L) * K = S₀ ^ 2 * (K * L) := by ring
      rw [h2] at h1
      nlinarith
    have h_p_sq_le : |‖p_R‖ ^ 2 * (s - 1)| ≤ S₀ ^ 4 * KL2 := by
      rw [abs_mul, abs_of_nonneg (sq_nonneg _)]
      have hp_R_le' : ‖p_R‖ ≤ S₀ ^ 2 * L := by linarith
      have hp_sq : ‖p_R‖ ^ 2 ≤ (S₀ ^ 2 * L) ^ 2 := by nlinarith [norm_nonneg p_R]
      have h1 : ‖p_R‖ ^ 2 * |s - 1| ≤ (S₀ ^ 2 * L) ^ 2 * K := by
        nlinarith [abs_nonneg (s - 1), sq_nonneg ‖p_R‖]
      have h2 : (S₀ ^ 2 * L) ^ 2 * K = S₀ ^ 4 * KL2 := by dsimp [KL2]; ring
      linarith
    have h_eval_le : |v (mkSpaceTime z s) - inner ℝ p_R z - (a_R - ‖p_R‖ ^ 2 / 2) * (s - 1)| ≤
        C₁ * S₀ ^ 2 * KL2 := by
      have h1 : C₁ * R = (C₁ * S₀ ^ 2) * (K * L) := by dsimp [R]; ring
      have h2 : 0 ≤ C₁ * S₀ ^ 2 := by positivity
      linarith [mul_le_mul_of_nonneg_left hKL_le_KL2 h2]
    have h_S0_comb : 2 * S₀ ^ 2 + (1 / 2 : ℝ) * S₀ ^ 4 ≤ S₀ ^ 4 := by nlinarith
    obtain ⟨he_lo, he_hi⟩ := abs_le.mp h_eval_le
    obtain ⟨hi_lo, hi_hi⟩ := abs_le.mp h_inner_le
    obtain ⟨ha_lo, ha_hi⟩ := abs_le.mp h_a_s_le
    obtain ⟨hp_lo, hp_hi⟩ := abs_le.mp h_p_sq_le
    have h_target_eq : C_box * K * (1 + Real.log K) ^ 2 = (S₀ ^ 4 + C₁ * S₀ ^ 2) * KL2 := by
      dsimp [C_box, KL2, L]
      ring
    rw [h_target_eq, abs_le]
    constructor <;> nlinarith

theorem reference_velocity_bound_of_shifted_fit (d : ℕ) (C₁ : ℝ) (hC₁ : 1 ≤ C₁)
    (κ : ℝ) (hκ : 0 < κ) (v : EuclideanSpace ℝ (Fin (d + 1)) → ℝ)
    (hv_class : InLimitingClassA d C₁ v)
    (hv_jensen : HasHorizontalJensenBound d κ v)
    (h_growth : ∀ (t₁ t₂ ε : ℝ), 0 < ε → ∃ M : ℝ, ∀ (y : EuclideanSpace ℝ (Fin d)) (s : ℝ),
      t₁ ≤ s → s ≤ t₂ → |v (mkSpaceTime y s)| ≤ M + ε * ‖y‖ ^ 2)
    (x p₀ p_fit Q_plus Q_minus Q_zero : EuclideanSpace ℝ (Fin d))
    (t ε a_fit : ℝ) (hε : 0 < ε) (ht : ε < t)
    (h_opt : IsOptimizingStepTriple d κ ε v x t Q_plus Q_minus Q_zero)
    (h_fit : IsFitAt d C₁ v (x + ε • p₀) (t + ε) (t + ε) p_fit a_fit) :
    ‖Q_zero - p₀‖ ≤ 4 * C₁ + 2 * (1 + κ ^ 2) + 4 * ‖p_fit - p₀‖ :=
by
  have h_projSpace : ∀ (y : EuclideanSpace ℝ (Fin d)) (s : ℝ), projSpace (mkSpaceTime y s) = y := by
    intro y s
    ext i
    simp [projSpace, mkSpaceTime]
  have h_projTime : ∀ (y : EuclideanSpace ℝ (Fin d)) (s : ℝ), projTime (mkSpaceTime y s) = s := by
    intro y s
    simp [projTime, mkSpaceTime]
  let W := shiftedBarycentricEnvelope d κ v
  let S : EuclideanSpace ℝ (Fin d) → ℝ → Set ℝ := fun y s =>
    { val : ℝ | ∃ (N : ℕ) (θ : Fin N → ℝ) (y_cfg : Fin N → EuclideanSpace ℝ (Fin d)),
      (∀ i, 0 < θ i) ∧ (∑ i, θ i = 1) ∧ (∑ i, θ i • y_cfg i = projSpace (mkSpaceTime y s)) ∧
      val = (∑ i, θ i * v (mkSpaceTime (y_cfg i) (projTime (mkSpaceTime y s)))) -
        (∑ i, θ i * ‖y_cfg i - projSpace (mkSpaceTime y s)‖ ^ 2) / (2 * s) }
  have hS_mem : ∀ (y : EuclideanSpace ℝ (Fin d)) (s : ℝ), v (mkSpaceTime y s) ∈ S y s := by
    intro y s
    refine ⟨1, fun _ => 1, fun _ => y, fun _ => zero_lt_one, by simp, ?_, ?_⟩
    · simp [h_projSpace]
    · simp [h_projSpace, h_projTime]
  have hS_ub : ∀ (y : EuclideanSpace ℝ (Fin d)) (s : ℝ), 0 < s →
      ∀ val ∈ S y s, val ≤ v (mkSpaceTime y s) + κ ^ 2 * s / 2 := by
    intro y s hs
    rintro val ⟨N, θ, y_cfg, hθ_pos, hθ_sum, hy_mean, rfl⟩
    rw [h_projSpace] at hy_mean
    rw [h_projSpace, h_projTime]
    have h_var_nonneg : 0 ≤ ∑ i, θ i * ‖y_cfg i - y‖ ^ 2 := by
      apply Finset.sum_nonneg
      intro i _
      exact mul_nonneg (le_of_lt (hθ_pos i)) (sq_nonneg _)
    let r : ℝ := Real.sqrt (∑ i, θ i * ‖y_cfg i - y‖ ^ 2)
    have hr_sq : r ^ 2 = ∑ i, θ i * ‖y_cfg i - y‖ ^ 2 := Real.sq_sqrt h_var_nonneg
    have h_j := hv_jensen s N θ y_cfg hθ_pos hθ_sum
    dsimp only at h_j
    rw [hy_mean] at h_j
    have h_sq_nonneg : 0 ≤ (r - κ * s) ^ 2 / (2 * s) :=
      div_nonneg (sq_nonneg _) (by positivity)
    have h_alg : v (mkSpaceTime y s) + κ * r - r ^ 2 / (2 * s) =
        v (mkSpaceTime y s) + κ ^ 2 * s / 2 - (r - κ * s) ^ 2 / (2 * s) := by
      field_simp [ne_of_gt hs]
      ring
    have h_step : (∑ i, θ i * v (mkSpaceTime (y_cfg i) s)) -
        (∑ i, θ i * ‖y_cfg i - y‖ ^ 2) / (2 * s) ≤
        v (mkSpaceTime y s) + κ * r - r ^ 2 / (2 * s) := by
      rw [← hr_sq]
      linarith
    change (∑ i, θ i * v (mkSpaceTime (y_cfg i) s)) -
        (∑ i, θ i * ‖y_cfg i - y‖ ^ 2) / (2 * s) ≤
        v (mkSpaceTime y s) + κ ^ 2 * s / 2
    linarith
  have h_sand : ∀ (y : EuclideanSpace ℝ (Fin d)) (s : ℝ), 0 < s →
      v (mkSpaceTime y s) - κ ^ 2 * s / 2 ≤ W (mkSpaceTime y s) ∧
      W (mkSpaceTime y s) ≤ v (mkSpaceTime y s) := by
    intro y s hs
    have h_sSup_ge : v (mkSpaceTime y s) ≤ barycentricEnvelope d s v (mkSpaceTime y s) :=
      le_csSup ⟨v (mkSpaceTime y s) + κ ^ 2 * s / 2, hS_ub y s hs⟩ (hS_mem y s)
    have h_sSup_le : barycentricEnvelope d s v (mkSpaceTime y s) ≤ v (mkSpaceTime y s) + κ ^ 2 * s / 2 :=
      csSup_le ⟨v (mkSpaceTime y s), hS_mem y s⟩ (hS_ub y s hs)
    dsimp [W, shiftedBarycentricEnvelope]
    rw [h_projTime]
    constructor <;> linarith
  have h_var_decomp : ∀ (N : ℕ) (θ : Fin N → ℝ) (y_cfg : Fin N → EuclideanSpace ℝ (Fin d))
      (z_c x_tilde : EuclideanSpace ℝ (Fin d)),
      ∑ i, θ i = 1 → ∑ i, θ i • y_cfg i = z_c →
      ∑ i, θ i * ‖y_cfg i - x_tilde‖ ^ 2 =
        (∑ i, θ i * ‖y_cfg i - z_c‖ ^ 2) + ‖z_c - x_tilde‖ ^ 2 := by
    intro N θ y_cfg z_c x_tilde hθ_sum hy_mean
    have h_zero_mean : ∑ i, θ i • (y_cfg i - z_c) = 0 := by
      calc ∑ i, θ i • (y_cfg i - z_c)
        _ = ∑ i, (θ i • y_cfg i - θ i • z_c) :=
            Finset.sum_congr rfl (fun i _ => smul_sub (θ i) (y_cfg i) z_c)
        _ = (∑ i, θ i • y_cfg i) - (∑ i, θ i) • z_c := by
            rw [Finset.sum_sub_distrib, ← Finset.sum_smul]
        _ = 0 := by
            rw [hy_mean, hθ_sum, one_smul, sub_self]
    have h_pt : ∀ i, θ i * ‖y_cfg i - x_tilde‖ ^ 2 =
        θ i * ‖y_cfg i - z_c‖ ^ 2 +
        2 * inner ℝ (θ i • (y_cfg i - z_c)) (z_c - x_tilde) +
        θ i * ‖z_c - x_tilde‖ ^ 2 := by
      intro i
      have h_split : y_cfg i - x_tilde = (y_cfg i - z_c) + (z_c - x_tilde) := by abel
      rw [h_split, norm_add_sq_real, real_inner_smul_left]
      ring
    calc ∑ i, θ i * ‖y_cfg i - x_tilde‖ ^ 2
      _ = ∑ i, (θ i * ‖y_cfg i - z_c‖ ^ 2 +
          2 * inner ℝ (θ i • (y_cfg i - z_c)) (z_c - x_tilde) +
          θ i * ‖z_c - x_tilde‖ ^ 2) :=
          Finset.sum_congr rfl (fun i _ => h_pt i)
      _ = (∑ i, θ i * ‖y_cfg i - z_c‖ ^ 2) +
          2 * inner ℝ (∑ i, θ i • (y_cfg i - z_c)) (z_c - x_tilde) +
          (∑ i, θ i) * ‖z_c - x_tilde‖ ^ 2 := by
          rw [Finset.sum_add_distrib, Finset.sum_add_distrib, ← Finset.mul_sum,
            ← sum_inner, ← Finset.sum_mul]
      _ = (∑ i, θ i * ‖y_cfg i - z_c‖ ^ 2) + ‖z_c - x_tilde‖ ^ 2 := by
          rw [h_zero_mean, inner_zero_left, hθ_sum]
          ring
  have h_two_point : ∀ (τ : ℝ) (z₁ z₂ x_tilde : EuclideanSpace ℝ (Fin d)) (α₁ α₂ : ℝ),
      0 < τ → 0 < α₁ → 0 < α₂ → α₁ + α₂ = 1 → α₁ • z₁ + α₂ • z₂ = x_tilde →
      α₁ * W (mkSpaceTime z₁ τ) + α₂ * W (mkSpaceTime z₂ τ) -
        (α₁ * ‖z₁ - x_tilde‖ ^ 2 + α₂ * ‖z₂ - x_tilde‖ ^ 2) / (2 * τ) ≤
        W (mkSpaceTime x_tilde τ) := by
    intro τ z₁ z₂ x_tilde α₁ α₂ hτ hα₁ hα₂ hα_sum hα_mean
    let pen : ℝ := (α₁ * ‖z₁ - x_tilde‖ ^ 2 + α₂ * ‖z₂ - x_tilde‖ ^ 2) / (2 * τ)
    have h_pt_conc : ∀ V₁ ∈ S z₁ τ, ∀ V₂ ∈ S z₂ τ,
        α₁ * V₁ + α₂ * V₂ - pen ≤ barycentricEnvelope d τ v (mkSpaceTime x_tilde τ) := by
      rintro V₁ ⟨N₁, θ₁, y₁, hθ₁_pos, hθ₁_sum, hy₁_mean, rfl⟩
        V₂ ⟨N₂, θ₂, y₂, hθ₂_pos, hθ₂_sum, hy₂_mean, rfl⟩
      rw [h_projSpace] at hy₁_mean hy₂_mean
      simp only [h_projSpace, h_projTime]
      let θ_cat : Fin (N₁ + N₂) → ℝ :=
        Fin.addCases (fun i => α₁ * θ₁ i) (fun j => α₂ * θ₂ j)
      let y_cat : Fin (N₁ + N₂) → EuclideanSpace ℝ (Fin d) :=
        Fin.addCases y₁ y₂
      have hθ_cat_pos : ∀ k, 0 < θ_cat k := by
        intro k
        refine Fin.addCases ?_ ?_ k
        · intro i
          dsimp [θ_cat]
          rw [Fin.addCases_left]
          exact mul_pos hα₁ (hθ₁_pos i)
        · intro j
          dsimp [θ_cat]
          rw [Fin.addCases_right]
          exact mul_pos hα₂ (hθ₂_pos j)
      have hθ_cat_sum : ∑ k, θ_cat k = 1 := by
        rw [Fin.sum_univ_add]
        simp only [θ_cat, Fin.addCases_left, Fin.addCases_right, ← Finset.mul_sum,
          hθ₁_sum, hθ₂_sum, mul_one, hα_sum]
      have hy_cat_mean : ∑ k, θ_cat k • y_cat k = projSpace (mkSpaceTime x_tilde τ) := by
        rw [h_projSpace, Fin.sum_univ_add]
        simp only [θ_cat, y_cat, Fin.addCases_left, Fin.addCases_right, mul_smul,
          ← Finset.smul_sum, hy₁_mean, hy₂_mean, hα_mean]
      have h_val_sum : ∑ k, θ_cat k * v (mkSpaceTime (y_cat k) (projTime (mkSpaceTime x_tilde τ))) =
          α₁ * (∑ i, θ₁ i * v (mkSpaceTime (y₁ i) τ)) +
          α₂ * (∑ j, θ₂ j * v (mkSpaceTime (y₂ j) τ)) := by
        rw [h_projTime, Fin.sum_univ_add]
        simp only [θ_cat, y_cat, Fin.addCases_left, Fin.addCases_right, mul_assoc,
          ← Finset.mul_sum]
      have h_var_sum : ∑ k, θ_cat k * ‖y_cat k - projSpace (mkSpaceTime x_tilde τ)‖ ^ 2 =
          α₁ * ((∑ i, θ₁ i * ‖y₁ i - z₁‖ ^ 2) + ‖z₁ - x_tilde‖ ^ 2) +
          α₂ * ((∑ j, θ₂ j * ‖y₂ j - z₂‖ ^ 2) + ‖z₂ - x_tilde‖ ^ 2) := by
        rw [h_projSpace, Fin.sum_univ_add]
        simp only [θ_cat, y_cat, Fin.addCases_left, Fin.addCases_right, mul_assoc,
          ← Finset.mul_sum]
        rw [h_var_decomp N₁ θ₁ y₁ z₁ x_tilde hθ₁_sum hy₁_mean,
          h_var_decomp N₂ θ₂ y₂ z₂ x_tilde hθ₂_sum hy₂_mean]
      have h_cat_mem : α₁ * ((∑ i, θ₁ i * v (mkSpaceTime (y₁ i) τ)) -
            (∑ i, θ₁ i * ‖y₁ i - z₁‖ ^ 2) / (2 * τ)) +
          α₂ * ((∑ j, θ₂ j * v (mkSpaceTime (y₂ j) τ)) -
            (∑ j, θ₂ j * ‖y₂ j - z₂‖ ^ 2) / (2 * τ)) - pen ∈ S x_tilde τ := by
        refine ⟨N₁ + N₂, θ_cat, y_cat, hθ_cat_pos, hθ_cat_sum, hy_cat_mean, ?_⟩
        rw [h_val_sum, h_var_sum]
        dsimp [pen]
        ring
      exact le_csSup ⟨v (mkSpaceTime x_tilde τ) + κ ^ 2 * τ / 2, hS_ub x_tilde τ hτ⟩ h_cat_mem
    have h_sup₁ : ∀ V₂ ∈ S z₂ τ,
        α₁ * barycentricEnvelope d τ v (mkSpaceTime z₁ τ) + α₂ * V₂ - pen ≤
          barycentricEnvelope d τ v (mkSpaceTime x_tilde τ) := by
      intro V₂ hV₂
      have h_le : barycentricEnvelope d τ v (mkSpaceTime z₁ τ) ≤
          (barycentricEnvelope d τ v (mkSpaceTime x_tilde τ) - α₂ * V₂ + pen) / α₁ := by
        apply csSup_le ⟨v (mkSpaceTime z₁ τ), hS_mem z₁ τ⟩
        intro V₁ hV₁
        rw [le_div_iff₀ hα₁]
        linarith [h_pt_conc V₁ hV₁ V₂ hV₂]
      rw [le_div_iff₀ hα₁] at h_le
      linarith
    have h_sup₂ : α₁ * barycentricEnvelope d τ v (mkSpaceTime z₁ τ) +
        α₂ * barycentricEnvelope d τ v (mkSpaceTime z₂ τ) - pen ≤
          barycentricEnvelope d τ v (mkSpaceTime x_tilde τ) := by
      have h_le : barycentricEnvelope d τ v (mkSpaceTime z₂ τ) ≤
          (barycentricEnvelope d τ v (mkSpaceTime x_tilde τ) -
            α₁ * barycentricEnvelope d τ v (mkSpaceTime z₁ τ) + pen) / α₂ := by
        apply csSup_le ⟨v (mkSpaceTime z₂ τ), hS_mem z₂ τ⟩
        intro V₂ hV₂
        rw [le_div_iff₀ hα₂]
        linarith [h_sup₁ V₂ hV₂]
      rw [le_div_iff₀ hα₂] at h_le
      linarith
    dsimp [W, shiftedBarycentricEnvelope, pen] at h_sup₂ ⊢
    rw [h_projTime, h_projTime, h_projTime]
    have h_shift_split : κ ^ 2 * τ / 2 = (α₁ + α₂) * (κ ^ 2 * τ / 2) := by
      rw [hα_sum, one_mul]
    linarith
  let τ : ℝ := t + ε
  let x_tilde : EuclideanSpace ℝ (Fin d) := x + ε • p₀
  let h : EuclideanSpace ℝ (Fin d) := ε • (Q_zero - p₀)
  have ht_pos : 0 < t := by linarith
  have hτ_pos : 0 < τ := by dsimp [τ]; linarith
  have hη_pos : 0 < 1 / (4 * ε) := by positivity
  obtain ⟨M₁, hM₁⟩ := h_growth τ τ (1 / (4 * ε)) hη_pos
  have h_norm_ineq : ∀ y' : EuclideanSpace ℝ (Fin d),
      ‖y'‖ ^ 2 ≤ 2 * ‖y' - x‖ ^ 2 + 2 * ‖x‖ ^ 2 := by
    intro y'
    have h1 : y' = (y' - x) + x := (sub_add_cancel y' x).symm
    have h2 : ‖y'‖ ^ 2 = ‖y' - x‖ ^ 2 + 2 * inner ℝ (y' - x) x + ‖x‖ ^ 2 := by
      conv_lhs => rw [h1]
      exact norm_add_sq_real (y' - x) x
    have h3 : 0 ≤ ‖(y' - x) - x‖ ^ 2 := sq_nonneg _
    rw [norm_sub_sq_real] at h3
    linarith
  have h_quad_comp : W (mkSpaceTime x_tilde τ) - ‖x_tilde - x‖ ^ 2 / (2 * ε) ≤
      quadEnvelopePlus d ε W (mkSpaceTime x t) := by
    dsimp [quadEnvelopePlus]
    rw [h_projTime, h_projSpace]
    apply le_csSup
    · refine ⟨M₁ + ‖x‖ ^ 2 / (2 * ε), ?_⟩
      rintro val ⟨y', -, rfl⟩
      dsimp only
      have hW_le : W (mkSpaceTime y' τ) ≤ v (mkSpaceTime y' τ) :=
        (h_sand y' τ hτ_pos).2
      have hv_le : v (mkSpaceTime y' τ) ≤ M₁ + (1 / (4 * ε)) * ‖y'‖ ^ 2 :=
        le_trans (le_abs_self _) (hM₁ y' τ (le_refl _) (le_refl _))
      have h_yn := h_norm_ineq y'
      have h_alg : (1 / (4 * ε)) * (2 * ‖y' - x‖ ^ 2 + 2 * ‖x‖ ^ 2) - ‖y' - x‖ ^ 2 / (2 * ε) =
          ‖x‖ ^ 2 / (2 * ε) := by
        field_simp [ne_of_gt hε]
        ring
      have h_mul : (1 / (4 * ε)) * ‖y'‖ ^ 2 ≤
          (1 / (4 * ε)) * (2 * ‖y' - x‖ ^ 2 + 2 * ‖x‖ ^ 2) :=
        mul_le_mul_of_nonneg_left h_yn (le_of_lt hη_pos)
      linarith
    · exact ⟨x_tilde, Set.mem_univ x_tilde, rfl⟩
  have h_opt_zero : W (mkSpaceTime (x + ε • Q_zero) τ) - (ε / 2) * ‖Q_zero‖ ^ 2 =
      quadEnvelopePlus d ε W (mkSpaceTime x t) := h_opt.1
  have hx_Q_eq : x + ε • Q_zero = x_tilde + h := by
    dsimp [x_tilde, h]
    module
  have hx_tilde_diff : x_tilde - x = ε • p₀ := by
    dsimp [x_tilde]
    abel
  have hεQ_eq : ε • Q_zero = ε • p₀ + h := by
    dsimp [h]
    module
  have h_norm_p₀ : ‖x_tilde - x‖ ^ 2 = ε ^ 2 * ‖p₀‖ ^ 2 := by
    rw [hx_tilde_diff, norm_smul, Real.norm_eq_abs, abs_of_pos hε, mul_pow]
  have h_norm_Q₀ : ε ^ 2 * ‖Q_zero‖ ^ 2 =
      ε ^ 2 * ‖p₀‖ ^ 2 + 2 * ε * inner ℝ p₀ h + ‖h‖ ^ 2 := by
    have h1 : ε ^ 2 * ‖Q_zero‖ ^ 2 = ‖ε • Q_zero‖ ^ 2 := by
      rw [norm_smul, Real.norm_eq_abs, abs_of_pos hε, mul_pow]
    rw [h1, hεQ_eq, norm_add_sq_real, norm_smul, Real.norm_eq_abs, abs_of_pos hε,
      mul_pow, real_inner_smul_left]
    ring
  have h_pen_diff : (ε / 2) * ‖Q_zero‖ ^ 2 - ‖x_tilde - x‖ ^ 2 / (2 * ε) =
      inner ℝ p₀ h + ‖h‖ ^ 2 / (2 * ε) := by
    have h2 : (ε / 2) * ‖Q_zero‖ ^ 2 = (ε ^ 2 * ‖Q_zero‖ ^ 2) / (2 * ε) := by
      field_simp [ne_of_gt hε]
    rw [h2, h_norm_Q₀, h_norm_p₀]
    field_simp [ne_of_gt hε]
    ring
  have h_comp_shift : ‖h‖ ^ 2 / (2 * ε) ≤
      W (mkSpaceTime (x_tilde + h) τ) - W (mkSpaceTime x_tilde τ) - inner ℝ p₀ h := by
    rw [hx_Q_eq] at h_opt_zero
    linarith
  by_cases h_vel_zero : ‖Q_zero - p₀‖ = 0
  · rw [h_vel_zero]
    positivity
  · have h_vel_pos : 0 < ‖Q_zero - p₀‖ :=
      lt_of_le_of_ne (norm_nonneg _) (Ne.symm h_vel_zero)
    let ρ : ℝ := ‖h‖
    have hρ_eq : ρ = ε * ‖Q_zero - p₀‖ := by
      dsimp [ρ, h]
      rw [norm_smul, Real.norm_eq_abs, abs_of_pos hε]
    have hρ_pos : 0 < ρ := by
      rw [hρ_eq]
      exact mul_pos hε h_vel_pos
    let h_fit_vec : EuclideanSpace ℝ (Fin d) := -((τ / ρ) • h)
    let z₁ : EuclideanSpace ℝ (Fin d) := x_tilde + h
    let z₂ : EuclideanSpace ℝ (Fin d) := x_tilde + h_fit_vec
    have h_norm_hfit : ‖h_fit_vec‖ = τ := by
      dsimp [h_fit_vec]
      rw [norm_neg, norm_smul, Real.norm_eq_abs, abs_of_pos (div_pos hτ_pos hρ_pos)]
      exact div_mul_cancel₀ τ (ne_of_gt hρ_pos)
    have h_fit_app := h_fit h_fit_vec 0
      (by simp; linarith)
      (by simp [h_norm_hfit, τ])
    have h_fit_lb : -C₁ * τ ≤
        v (mkSpaceTime z₂ τ) - v (mkSpaceTime x_tilde τ) - inner ℝ p_fit h_fit_vec := by
      have h1 := (abs_le.mp h_fit_app).1
      simpa [z₂, x_tilde, τ] using h1
    have h_inner_hfit : inner ℝ p_fit h_fit_vec = -(τ / ρ) * inner ℝ p_fit h := by
      dsimp [h_fit_vec]
      rw [inner_neg_right, real_inner_smul_right]
      ring
    have h_cs : inner ℝ p_fit h - inner ℝ p₀ h ≤ ‖p_fit - p₀‖ * ρ := by
      rw [← inner_sub_left]
      exact le_trans (le_abs_self _) (abs_real_inner_le_norm (p_fit - p₀) h)
    have h_cs_scaled : (τ / ρ) * inner ℝ p_fit h - (τ / ρ) * inner ℝ p₀ h ≤
        ‖p_fit - p₀‖ * τ := by
      have h1 : (τ / ρ) * (inner ℝ p_fit h - inner ℝ p₀ h) ≤
          (τ / ρ) * (‖p_fit - p₀‖ * ρ) :=
        mul_le_mul_of_nonneg_left h_cs (le_of_lt (div_pos hτ_pos hρ_pos))
      have h2 : (τ / ρ) * (‖p_fit - p₀‖ * ρ) = ‖p_fit - p₀‖ * τ := by
        field_simp [ne_of_gt hρ_pos]
      linarith
    have hW_xtilde_ub : W (mkSpaceTime x_tilde τ) ≤ v (mkSpaceTime x_tilde τ) :=
      (h_sand x_tilde τ hτ_pos).2
    have hW_z₂_lb : v (mkSpaceTime z₂ τ) - κ ^ 2 * τ / 2 ≤ W (mkSpaceTime z₂ τ) :=
      (h_sand z₂ τ hτ_pos).1
    have h_refl_bound : W (mkSpaceTime x_tilde τ) - W (mkSpaceTime z₂ τ) -
        (τ / ρ) * inner ℝ p₀ h ≤ (C₁ + κ ^ 2 / 2 + ‖p_fit - p₀‖) * τ := by
      linarith
    let α₁ : ℝ := τ / (τ + ρ)
    let α₂ : ℝ := ρ / (τ + ρ)
    have hτρ_pos : 0 < τ + ρ := add_pos hτ_pos hρ_pos
    have hα₁_pos : 0 < α₁ := div_pos hτ_pos hτρ_pos
    have hα₂_pos : 0 < α₂ := div_pos hρ_pos hτρ_pos
    have hα_sum : α₁ + α₂ = 1 := by
      dsimp [α₁, α₂]
      field_simp [ne_of_gt hτρ_pos]
    have hα_coeff : α₂ * (τ / ρ) = α₁ := by
      dsimp [α₁, α₂]
      field_simp [ne_of_gt hρ_pos, ne_of_gt hτρ_pos]
    have hα_mean : α₁ • z₁ + α₂ • z₂ = x_tilde := by
      have h_lin : α₁ • z₁ + α₂ • z₂ = (α₁ + α₂) • x_tilde + (α₁ - α₂ * (τ / ρ)) • h := by
        dsimp [z₁, z₂, h_fit_vec]
        module
      rw [h_lin, hα_sum, hα_coeff, sub_self, one_smul, zero_smul, add_zero]
    have hz₁_diff : ‖z₁ - x_tilde‖ ^ 2 = ρ ^ 2 := by
      dsimp [z₁, ρ]
      rw [add_sub_cancel_left]
    have hz₂_diff : ‖z₂ - x_tilde‖ ^ 2 = τ ^ 2 := by
      dsimp [z₂]
      rw [add_sub_cancel_left, h_norm_hfit]
    have h_pen_eq : (α₁ * ‖z₁ - x_tilde‖ ^ 2 + α₂ * ‖z₂ - x_tilde‖ ^ 2) / (2 * τ) =
        ρ / 2 := by
      rw [hz₁_diff, hz₂_diff]
      dsimp [α₁, α₂]
      field_simp [ne_of_gt hτ_pos, ne_of_gt hτρ_pos]
      ring
    have h_conc := h_two_point τ z₁ z₂ x_tilde α₁ α₂ hτ_pos hα₁_pos hα₂_pos hα_sum hα_mean
    rw [h_pen_eq] at h_conc
    have h_chord_mul : (τ + ρ) *
        (α₁ * W (mkSpaceTime z₁ τ) + α₂ * W (mkSpaceTime z₂ τ) - ρ / 2) ≤
        (τ + ρ) * W (mkSpaceTime x_tilde τ) :=
      mul_le_mul_of_nonneg_left h_conc (le_of_lt hτρ_pos)
    have h_chord_alg : (τ + ρ) *
        (α₁ * W (mkSpaceTime z₁ τ) + α₂ * W (mkSpaceTime z₂ τ) - ρ / 2) =
        τ * W (mkSpaceTime z₁ τ) + ρ * W (mkSpaceTime z₂ τ) - (τ + ρ) * ρ / 2 := by
      dsimp [α₁, α₂]
      field_simp [ne_of_gt hτρ_pos]
    have h_p₀_scale : ρ * ((τ / ρ) * inner ℝ p₀ h) = τ * inner ℝ p₀ h := by
      field_simp [ne_of_gt hρ_pos]
    have h_chord_clean : τ * (W (mkSpaceTime z₁ τ) - W (mkSpaceTime x_tilde τ) - inner ℝ p₀ h) ≤
        ρ * (W (mkSpaceTime x_tilde τ) - W (mkSpaceTime z₂ τ) - (τ / ρ) * inner ℝ p₀ h) +
        (τ + ρ) * ρ / 2 := by
      linarith
    have h_lhs_mul : τ * (ρ ^ 2 / (2 * ε)) ≤
        τ * (W (mkSpaceTime z₁ τ) - W (mkSpaceTime x_tilde τ) - inner ℝ p₀ h) :=
      mul_le_mul_of_nonneg_left h_comp_shift (le_of_lt hτ_pos)
    have h_rhs_mul : ρ * (W (mkSpaceTime x_tilde τ) - W (mkSpaceTime z₂ τ) -
        (τ / ρ) * inner ℝ p₀ h) ≤ ρ * ((C₁ + κ ^ 2 / 2 + ‖p_fit - p₀‖) * τ) :=
      mul_le_mul_of_nonneg_left h_refl_bound (le_of_lt hρ_pos)
    have h_combined : τ * (ρ ^ 2 / (2 * ε)) - ρ ^ 2 / 2 ≤
        ρ * τ * (C₁ + (1 + κ ^ 2) / 2 + ‖p_fit - p₀‖) := by
      linarith
    have h_lhs_id : 4 * (τ * (ρ ^ 2 / (2 * ε)) - ρ ^ 2 / 2) =
        (t - ε) * (ρ * ‖Q_zero - p₀‖) + ρ * τ * ‖Q_zero - p₀‖ := by
      have hρ_div : ρ ^ 2 / ε = ρ * ‖Q_zero - p₀‖ := by
        rw [hρ_eq]
        field_simp [ne_of_gt hε]
      calc 4 * (τ * (ρ ^ 2 / (2 * ε)) - ρ ^ 2 / 2)
        _ = (2 * τ - 2 * ε) * (ρ ^ 2 / ε) := by
            field_simp [ne_of_gt hε]
            ring
        _ = ((t - ε) + τ) * (ρ * ‖Q_zero - p₀‖) := by
            rw [hρ_div]
            dsimp [τ]
            ring
        _ = (t - ε) * (ρ * ‖Q_zero - p₀‖) + ρ * τ * ‖Q_zero - p₀‖ := by
            ring
    have h_slack_pos : 0 ≤ (t - ε) * (ρ * ‖Q_zero - p₀‖) := by
      have htε : 0 ≤ t - ε := by linarith
      positivity
    have h_final_mul : ρ * τ * ‖Q_zero - p₀‖ ≤
        ρ * τ * (4 * C₁ + 2 * (1 + κ ^ 2) + 4 * ‖p_fit - p₀‖) := by
      linarith
    have hρτ_pos : 0 < ρ * τ := mul_pos hρ_pos hτ_pos
    nlinarith

theorem drift_functional_polylog_upper_bound (d : ℕ) (C₁ : ℝ) (hC₁ : 1 ≤ C₁)
    (κ : ℝ) (hκ : 0 < κ) (v : EuclideanSpace ℝ (Fin (d + 1)) → ℝ)
    (hv_class : InLimitingClassA d C₁ v)
    (hv_jensen : HasHorizontalJensenBound d κ v)
    (h_comp : ∀ (x y : EuclideanSpace ℝ (Fin d)) (t ℓ : ℝ), 0 < ℓ →
      v (mkSpaceTime y (t + ℓ)) - v (mkSpaceTime x t) - ‖y - x‖ ^ 2 / (2 * ℓ) ≤
        ℓ * slopePlus d ℓ v (mkSpaceTime x t) ∧
      v (mkSpaceTime x t) - v (mkSpaceTime y (t - ℓ)) - ‖y - x‖ ^ 2 / (2 * ℓ) ≤
        ℓ * slopeMinus d ℓ v (mkSpaceTime x t))
    (h_attain : ∀ (x : EuclideanSpace ℝ (Fin d)) (t ℓ : ℝ), 0 < ℓ →
      (∃ y_plus : EuclideanSpace ℝ (Fin d),
        v (mkSpaceTime y_plus (t + ℓ)) - v (mkSpaceTime x t) - ‖y_plus - x‖ ^ 2 / (2 * ℓ) =
          ℓ * slopePlus d ℓ v (mkSpaceTime x t)) ∧
      (∃ y_minus : EuclideanSpace ℝ (Fin d),
        v (mkSpaceTime x t) - v (mkSpaceTime y_minus (t - ℓ)) - ‖y_minus - x‖ ^ 2 / (2 * ℓ) =
          ℓ * slopeMinus d ℓ v (mkSpaceTime x t)))
    (h_mono : ∀ (x : EuclideanSpace ℝ (Fin d)) (t ℓ₁ ℓ₂ : ℝ), 0 < ℓ₁ → ℓ₁ ≤ ℓ₂ →
      slopePlus d ℓ₁ v (mkSpaceTime x t) ≤ slopePlus d ℓ₂ v (mkSpaceTime x t) ∧
      slopeMinus d ℓ₁ v (mkSpaceTime x t) ≤ slopeMinus d ℓ₂ v (mkSpaceTime x t))
    (C_box : ℝ) (hC_box : 0 < C_box)
    (h_box : ∀ (K : ℝ) (z : EuclideanSpace ℝ (Fin d)) (s : ℝ),
      2 ≤ K → ‖z‖ ≤ K → |s - 1| ≤ K →
      |v (mkSpaceTime z s)| ≤ C_box * K * (1 + Real.log K) ^ 2) :
    ∃ C_ub : ℝ, 0 < C_ub ∧
      ∀ (B ε : ℝ) (x : EuclideanSpace ℝ (Fin d)) (t : ℝ),
        2 ≤ B → 0 < ε → ε ≤ B → ‖x‖ ≤ B → ε < t → t ≤ B →
        driftFunctional d κ ε v (mkSpaceTime x t) ≤ C_ub * (1 + Real.log B) ^ 4 :=
by
  have h_projSpace : ∀ (x : EuclideanSpace ℝ (Fin d)) (t : ℝ), projSpace (mkSpaceTime x t) = x := by
    intro x t
    ext i
    simp [projSpace, mkSpaceTime]
  have h_projTime : ∀ (x : EuclideanSpace ℝ (Fin d)) (t : ℝ), projTime (mkSpaceTime x t) = t := by
    intro x t
    simp [projTime, mkSpaceTime]
  have h_bary_mem : ∀ (x : EuclideanSpace ℝ (Fin d)) (t : ℝ),
      v (mkSpaceTime x t) ∈
        { val : ℝ | ∃ (N : ℕ) (θ : Fin N → ℝ) (y : Fin N → EuclideanSpace ℝ (Fin d)),
          (∀ i, 0 < θ i) ∧ (∑ i, θ i = 1) ∧ (∑ i, θ i • y i = projSpace (mkSpaceTime x t)) ∧
          val = (∑ i, θ i * v (mkSpaceTime (y i) (projTime (mkSpaceTime x t)))) -
            (∑ i, θ i * ‖y i - projSpace (mkSpaceTime x t)‖ ^ 2) / (2 * t) } := by
    intro x t
    refine ⟨1, fun _ => 1, fun _ => x, fun _ => zero_lt_one, by simp, ?_, ?_⟩
    · simp [h_projSpace]
    · simp [h_projSpace, h_projTime]
  have h_bary_ub : ∀ (x : EuclideanSpace ℝ (Fin d)) (t : ℝ), 0 < t →
      ∀ val ∈
        { val : ℝ | ∃ (N : ℕ) (θ : Fin N → ℝ) (y : Fin N → EuclideanSpace ℝ (Fin d)),
          (∀ i, 0 < θ i) ∧ (∑ i, θ i = 1) ∧ (∑ i, θ i • y i = projSpace (mkSpaceTime x t)) ∧
          val = (∑ i, θ i * v (mkSpaceTime (y i) (projTime (mkSpaceTime x t)))) -
            (∑ i, θ i * ‖y i - projSpace (mkSpaceTime x t)‖ ^ 2) / (2 * t) },
        val ≤ v (mkSpaceTime x t) + κ ^ 2 * t / 2 := by
    intro x t ht val hval
    rcases hval with ⟨N, θ, y, hθ_pos, hθ_sum, hy_mean, rfl⟩
    rw [h_projSpace] at hy_mean ⊢
    rw [h_projTime]
    have hj := hv_jensen t N θ y hθ_pos hθ_sum
    dsimp only at hj
    rw [hy_mean] at hj
    set V : ℝ := ∑ i, θ i * ‖y i - x‖ ^ 2
    set r : ℝ := Real.sqrt V
    have hV_nonneg : 0 ≤ V := by
      apply Finset.sum_nonneg
      intro i _
      exact mul_nonneg (le_of_lt (hθ_pos i)) (sq_nonneg _)
    have hr_sq : r ^ 2 = V := Real.sq_sqrt hV_nonneg
    have h_sq_nonneg : 0 ≤ (r - κ * t) ^ 2 / (2 * t) :=
      div_nonneg (sq_nonneg _) (by linarith)
    have h_id : κ * r - V / (2 * t) = κ ^ 2 * t / 2 - (r - κ * t) ^ 2 / (2 * t) := by
      rw [← hr_sq]
      have ht_ne : t ≠ 0 := ne_of_gt ht
      field_simp [ht_ne]
      ring
    linarith
  have hW_le_v : ∀ (x : EuclideanSpace ℝ (Fin d)) (t : ℝ), 0 < t →
      shiftedBarycentricEnvelope d κ v (mkSpaceTime x t) ≤ v (mkSpaceTime x t) := by
    intro x t ht
    unfold shiftedBarycentricEnvelope
    rw [h_projTime]
    have h_ub : barycentricEnvelope d t v (mkSpaceTime x t) ≤
        v (mkSpaceTime x t) + κ ^ 2 * t / 2 :=
      csSup_le ⟨v (mkSpaceTime x t), h_bary_mem x t⟩ (h_bary_ub x t ht)
    linarith
  have hP_W_le : ∀ (x : EuclideanSpace ℝ (Fin d)) (t ε : ℝ), 0 < t → 0 < ε →
      quadEnvelopePlus d ε (shiftedBarycentricEnvelope d κ v) (mkSpaceTime x t) ≤
        v (mkSpaceTime x t) + ε * slopePlus d ε v (mkSpaceTime x t) := by
    intro x t ε ht hε
    apply csSup_le
    · exact ⟨_, ⟨0, Set.mem_univ 0, rfl⟩⟩
    · rintro b ⟨y', -, rfl⟩
      rw [h_projSpace, h_projTime]
      have hW := hW_le_v y' (t + ε) (by linarith)
      have hv_le := (h_comp x y' t ε hε).1
      linarith
  have hJ_le_slope : ∀ (B ε : ℝ) (x : EuclideanSpace ℝ (Fin d)) (t : ℝ),
      0 < ε → ε ≤ B → ε < t →
      driftFunctional d κ ε v (mkSpaceTime x t) ≤
        (slopePlus d B v (mkSpaceTime x t) + slopeMinus d B v (mkSpaceTime x t)) / 2 := by
    intro B ε x t hε hεB ht
    have ht_pos : 0 < t := by linarith
    have hP := hP_W_le x t ε ht_pos hε
    have hε_ne : ε ≠ 0 := ne_of_gt hε
    have hM : ε * slopeMinus d ε v (mkSpaceTime x t) =
        v (mkSpaceTime x t) - quadEnvelopeMinus d ε v (mkSpaceTime x t) := by
      unfold slopeMinus
      exact mul_div_cancel₀ _ hε_ne
    have h_mono_plus := (h_mono x t ε B hε hεB).1
    have h_mono_minus := (h_mono x t ε B hε hεB).2
    have h_plus_mul : ε * slopePlus d ε v (mkSpaceTime x t) ≤
        ε * slopePlus d B v (mkSpaceTime x t) :=
      mul_le_mul_of_nonneg_left h_mono_plus (le_of_lt hε)
    have h_minus_mul : ε * slopeMinus d ε v (mkSpaceTime x t) ≤
        ε * slopeMinus d B v (mkSpaceTime x t) :=
      mul_le_mul_of_nonneg_left h_mono_minus (le_of_lt hε)
    unfold driftFunctional
    rw [div_le_iff₀ (by linarith : (0 : ℝ) < 2 * ε)]
    linarith
  let A : ℝ := 32 * C_box
  let C_ub : ℝ := (4 * A ^ 2 + 2 * A + 3) ^ 2
  have hA_pos : 0 < A := by positivity
  have hC_ub_pos : 0 < C_ub := by positivity
  have h_disp_bound : ∀ (B : ℝ) (x y : EuclideanSpace ℝ (Fin d)) (t σ : ℝ),
      2 ≤ B → ‖x‖ ≤ B → 0 < t → t ≤ B → |σ - 1| ≤ 3 * B →
      |v (mkSpaceTime y σ)| + |v (mkSpaceTime x t)| - ‖y - x‖ ^ 2 / (2 * B) ≤
        C_ub * B * (1 + Real.log B) ^ 4 := by
    intro B x y t σ hB hx ht_pos htB hσ
    have hB_pos : 0 < B := by linarith
    have h_logB_nonneg : 0 ≤ Real.log B := Real.log_nonneg (by linarith)
    let L : ℝ := 1 + Real.log B
    have hL_ge_one : 1 ≤ L := by dsimp [L]; linarith
    have hL_pos : 0 < L := by linarith
    have hL_sq_ge_one : 1 ≤ L ^ 2 := by nlinarith
    let r : ℝ := ‖y - x‖
    have hr_nonneg : 0 ≤ r := norm_nonneg (y - x)
    let K : ℝ := 3 * B * L ^ 2 + r
    have hBL2_ge : B ≤ B * L ^ 2 := le_mul_of_one_le_right (le_of_lt hB_pos) hL_sq_ge_one
    have hK_ge_3B : 3 * B ≤ K := by dsimp [K]; linarith
    have hK_ge_two : 2 ≤ K := by linarith
    have hK_pos : 0 < K := by linarith
    have hx_K : ‖x‖ ≤ K := by linarith
    have ht_K : |t - 1| ≤ K := abs_le.mpr ⟨by linarith, by linarith⟩
    have hy_K : ‖y‖ ≤ K := by
      have h_tri : ‖y‖ ≤ ‖x‖ + ‖y - x‖ := by
        simpa [add_sub_cancel] using norm_add_le x (y - x)
      change ‖y‖ ≤ 3 * B * L ^ 2 + r
      change ‖y‖ ≤ ‖x‖ + r at h_tri
      linarith
    have hσ_K : |σ - 1| ≤ K := by linarith
    have hv_x := h_box K x t hK_ge_two hx_K ht_K
    have hv_y := h_box K y σ hK_ge_two hy_K hσ_K
    have hv_sum : |v (mkSpaceTime y σ)| + |v (mkSpaceTime x t)| ≤
        2 * C_box * K * (1 + Real.log K) ^ 2 := by linarith
    have hBL2_pos : 0 < B * L ^ 2 := by positivity
    let X : ℝ := K / (B * L ^ 2)
    have hX_pos : 0 < X := div_pos hK_pos hBL2_pos
    let q : ℝ := Real.sqrt (Real.sqrt X)
    have hq_pos : 0 < q := Real.sqrt_pos.mpr (Real.sqrt_pos.mpr hX_pos)
    have hq_sq : q ^ 2 = Real.sqrt X := Real.sq_sqrt (Real.sqrt_nonneg X)
    have hq_pow4 : q ^ 4 = X := by
      calc q ^ 4 = (q ^ 2) ^ 2 := by ring
        _ = (Real.sqrt X) ^ 2 := by rw [hq_sq]
        _ = X := Real.sq_sqrt (le_of_lt hX_pos)
    have hK_eq : K = B * L ^ 2 * q ^ 4 := by
      rw [hq_pow4]
      dsimp [X]
      exact (mul_div_cancel₀ K (ne_of_gt hBL2_pos)).symm
    have hr_eq : r = B * L ^ 2 * (q ^ 4 - 3) := by
      have h1 : K = 3 * B * L ^ 2 + r := rfl
      linarith [hK_eq, h1]
    have hr_sq_div : r ^ 2 / (2 * B) = (1 / 2) * B * L ^ 4 * (q ^ 4 - 3) ^ 2 := by
      rw [hr_eq]
      have hB_ne : B ≠ 0 := ne_of_gt hB_pos
      field_simp [hB_ne]
    have h_logK_eq : Real.log K = Real.log B + 2 * Real.log L + 4 * Real.log q := by
      rw [hK_eq]
      rw [Real.log_mul (ne_of_gt hBL2_pos) (by positivity)]
      rw [Real.log_mul (ne_of_gt hB_pos) (by positivity)]
      rw [Real.log_pow, Real.log_pow]
      push_cast
      ring
    have h_logL_le : Real.log L ≤ L - 1 := Real.log_le_sub_one_of_pos hL_pos
    have h_logq_le : Real.log q ≤ q - 1 := Real.log_le_sub_one_of_pos hq_pos
    have h_logK_ub : 1 + Real.log K ≤ 4 * L * (1 + q) := by
      have h_L_def : 1 + Real.log B = L := rfl
      have h_prod : q ≤ L * q := le_mul_of_one_le_left (le_of_lt hq_pos) hL_ge_one
      linarith
    have h_logK_nonneg : 0 ≤ 1 + Real.log K := by
      have : 0 ≤ Real.log K := Real.log_nonneg (by linarith)
      linarith
    have h_logK_sq : (1 + Real.log K) ^ 2 ≤ 16 * L ^ 2 * (1 + q) ^ 2 := by
      calc (1 + Real.log K) ^ 2
        _ ≤ (4 * L * (1 + q)) ^ 2 := by gcongr
        _ = 16 * L ^ 2 * (1 + q) ^ 2 := by ring
    have h_term1_ub : 2 * C_box * K * (1 + Real.log K) ^ 2 ≤
        B * L ^ 4 * (A * q ^ 4 * (1 + q) ^ 2) := by
      calc 2 * C_box * K * (1 + Real.log K) ^ 2
        _ ≤ 2 * C_box * K * (16 * L ^ 2 * (1 + q) ^ 2) :=
            mul_le_mul_of_nonneg_left h_logK_sq (by positivity)
        _ = B * L ^ 4 * (A * q ^ 4 * (1 + q) ^ 2) := by
            rw [hK_eq]
            dsimp [A]
            ring
    have h_sos_id : C_ub - (A * q ^ 4 * (1 + q) ^ 2 - (1 / 2) * (q ^ 4 - 3) ^ 2) =
        9 / 2 + A * q ^ 4 * (q - 1) ^ 2 + (1 / 4) * q ^ 4 * (q ^ 2 - 4 * A) ^ 2 +
          (1 / 4) * (q ^ 4 - 2 * (4 * A ^ 2 + 2 * A + 3)) ^ 2 := by
      dsimp [C_ub]
      ring
    have h_sos_nonneg : 0 ≤ 9 / 2 + A * q ^ 4 * (q - 1) ^ 2 +
        (1 / 4) * q ^ 4 * (q ^ 2 - 4 * A) ^ 2 +
        (1 / 4) * (q ^ 4 - 2 * (4 * A ^ 2 + 2 * A + 3)) ^ 2 := by
      positivity
    have h_poly_ub : A * q ^ 4 * (1 + q) ^ 2 - (1 / 2) * (q ^ 4 - 3) ^ 2 ≤ C_ub := by
      linarith
    have h_scaled_ub : B * L ^ 4 * (A * q ^ 4 * (1 + q) ^ 2 - (1 / 2) * (q ^ 4 - 3) ^ 2) ≤
        B * L ^ 4 * C_ub :=
      mul_le_mul_of_nonneg_left h_poly_ub (by positivity)
    change |v (mkSpaceTime y σ)| + |v (mkSpaceTime x t)| - r ^ 2 / (2 * B) ≤ C_ub * B * L ^ 4
    linarith [hv_sum, h_term1_ub, hr_sq_div, h_scaled_ub]
  refine ⟨C_ub, hC_ub_pos, ?_⟩
  intro B ε x t hB hε hεB hx ht htB
  have hB_pos : 0 < B := by linarith
  have ht_pos : 0 < t := by linarith
  obtain ⟨⟨y_plus, hy_plus⟩, ⟨y_minus, hy_minus⟩⟩ := h_attain x t B hB_pos
  have hσ_plus : |(t + B) - 1| ≤ 3 * B := abs_le.mpr ⟨by linarith, by linarith⟩
  have hσ_minus : |(t - B) - 1| ≤ 3 * B := abs_le.mpr ⟨by linarith, by linarith⟩
  have h_ub_plus := h_disp_bound B x y_plus t (t + B) hB hx ht_pos htB hσ_plus
  have h_ub_minus := h_disp_bound B x y_minus t (t - B) hB hx ht_pos htB hσ_minus
  have hv_diff_plus : v (mkSpaceTime y_plus (t + B)) - v (mkSpaceTime x t) ≤
      |v (mkSpaceTime y_plus (t + B))| + |v (mkSpaceTime x t)| := by
    linarith [le_abs_self (v (mkSpaceTime y_plus (t + B))), neg_le_abs (v (mkSpaceTime x t))]
  have hv_diff_minus : v (mkSpaceTime x t) - v (mkSpaceTime y_minus (t - B)) ≤
      |v (mkSpaceTime y_minus (t - B))| + |v (mkSpaceTime x t)| := by
    linarith [le_abs_self (v (mkSpaceTime x t)), neg_le_abs (v (mkSpaceTime y_minus (t - B)))]
  have h_B_slope_plus : B * slopePlus d B v (mkSpaceTime x t) ≤
      B * (C_ub * (1 + Real.log B) ^ 4) := by
    linarith [hy_plus, h_ub_plus, hv_diff_plus]
  have h_B_slope_minus : B * slopeMinus d B v (mkSpaceTime x t) ≤
      B * (C_ub * (1 + Real.log B) ^ 4) := by
    linarith [hy_minus, h_ub_minus, hv_diff_minus]
  have h_slope_plus : slopePlus d B v (mkSpaceTime x t) ≤ C_ub * (1 + Real.log B) ^ 4 :=
    le_of_mul_le_mul_left h_B_slope_plus hB_pos
  have h_slope_minus : slopeMinus d B v (mkSpaceTime x t) ≤ C_ub * (1 + Real.log B) ^ 4 :=
    le_of_mul_le_mul_left h_B_slope_minus hB_pos
  have hJ := hJ_le_slope B ε x t hε hεB ht
  linarith

theorem fitted_frame_step_velocity_bounds (d : ℕ) (hd : 3 ≤ d) (C₁ : ℝ) (hC₁ : 1 ≤ C₁)
    (κ : ℝ) (hκ : 0 < κ) (v : EuclideanSpace ℝ (Fin (d + 1)) → ℝ)
    (hv_class : InLimitingClassA d C₁ v)
    (hv_cent : IsCenteredAt d C₁ v 0 1)
    (hv_jensen : HasHorizontalJensenBound d κ v)
    (Q_plus Q_minus Q_zero : EuclideanSpace ℝ (Fin d) → ℝ → ℝ → EuclideanSpace ℝ (Fin d))
    (hQ_opt : ∀ (x : EuclideanSpace ℝ (Fin d)) (t ε : ℝ), 0 < ε → ε < t →
      IsOptimizingStepTriple d κ ε v x t (Q_plus x t ε) (Q_minus x t ε) (Q_zero x t ε)) :
    ∃ (C_vel C_ub : ℝ), 0 < C_vel ∧ 0 < C_ub ∧
      (∀ (r : ℝ) (x₀ : EuclideanSpace ℝ (Fin d)) (p₀ : EuclideanSpace ℝ (Fin d)) (a₀ : ℝ),
        0 < r → IsFitAt d C₁ v x₀ r r p₀ a₀ →
        ∀ (K ε : ℝ) (x : EuclideanSpace ℝ (Fin d)) (t : ℝ),
          2 ≤ K → 0 < ε → ε ≤ r → ε < t → t ≤ K * r →
          ‖x - x₀ - (t - r) • p₀‖ ≤ K * r →
          ‖Q_zero x t ε - p₀‖ ≤ C_vel * (1 + Real.log K + |Real.log (t / r)|)) ∧
      (∀ (B ε : ℝ) (x : EuclideanSpace ℝ (Fin d)) (t : ℝ),
        2 ≤ B → 0 < ε → ε ≤ B → ‖x‖ ≤ B → ε < t → t ≤ B →
        driftFunctional d κ ε v (mkSpaceTime x t) ≤ C_ub * (1 + Real.log B) ^ 4) :=
by
  have _hd : 3 ≤ d := hd
  have hC₁_nonneg : (0 : ℝ) ≤ C₁ := by linarith
  have h_growth : ∀ (t₁ t₂ ε : ℝ), 0 < ε → ∃ M : ℝ, ∀ (y : EuclideanSpace ℝ (Fin d)) (s : ℝ),
      t₁ ≤ s → s ≤ t₂ → |v (mkSpaceTime y s)| ≤ M + ε * ‖y‖ ^ 2 :=
    subquadratic_growth_of_inLimitingClassA d C₁ hC₁_nonneg v hv_class
  obtain ⟨h_comp, h_attain, h_mono⟩ :=
    envelope_attainment_and_slope_monotonicity d C₁ hC₁_nonneg v hv_class h_growth
  obtain ⟨C_shift, C_box, hC_shift, hC_box, h_shift, h_box_cent⟩ :=
    same_center_and_box_fit_bounds d C₁ hC₁ v hv_class
  obtain ⟨C_ub, hC_ub, hJ_ub⟩ :=
    drift_functional_polylog_upper_bound d C₁ hC₁ κ hκ v hv_class hv_jensen
      h_comp h_attain h_mono C_box hC_box (h_box_cent hv_cent)
  let C_vel : ℝ := 4 * C₁ + 2 * (1 + κ ^ 2) + 8 * C_shift
  have hC_vel : 0 < C_vel := by positivity
  refine ⟨C_vel, C_ub, hC_vel, hC_ub, ?_, hJ_ub⟩
  intro r x₀ p₀ a₀ hr hfit₀ K ε x t hK hε hεr ht htK hx
  let x_tilde : EuclideanSpace ℝ (Fin d) := x + ε • p₀
  let τ : ℝ := t + ε
  have ht_pos : 0 < t := by linarith
  have hτ_pos : 0 < τ := by dsimp [τ]; linarith
  have hτ_le : τ ≤ 2 * K * r := by dsimp [τ]; linarith
  have hx_tilde_eq : x_tilde - x₀ - (τ - r) • p₀ = x - x₀ - (t - r) • p₀ := by
    dsimp [x_tilde, τ]
    module
  have hx_tilde : ‖x_tilde - x₀ - (τ - r) • p₀‖ ≤ K * r := by
    rw [hx_tilde_eq]
    exact hx
  obtain ⟨p_fit, a_fit, hfit_τ⟩ := hv_class.2.2.2 x_tilde τ τ hτ_pos
  have hp_fit : ‖p_fit - p₀‖ ≤ C_shift * (1 + Real.log K + |Real.log (τ / r)|) :=
    h_shift r x₀ p₀ a₀ hr hfit₀ K τ x_tilde p_fit a_fit hK hτ_pos hτ_le hx_tilde hfit_τ
  have hQ_bound : ‖Q_zero x t ε - p₀‖ ≤ 4 * C₁ + 2 * (1 + κ ^ 2) + 4 * ‖p_fit - p₀‖ :=
    reference_velocity_bound_of_shifted_fit d C₁ hC₁ κ hκ v hv_class hv_jensen h_growth
      x p₀ p_fit (Q_plus x t ε) (Q_minus x t ε) (Q_zero x t ε) t ε a_fit hε ht
      (hQ_opt x t ε hε ht) hfit_τ
  have h_ratio_pos : 0 < τ / t := div_pos hτ_pos ht_pos
  have h_ratio_ge : 1 ≤ τ / t := (one_le_div ht_pos).mpr (by dsimp [τ]; linarith)
  have h_ratio_le : τ / t ≤ 2 := (div_le_iff₀ ht_pos).mpr (by dsimp [τ]; linarith)
  have h_log_ratio_nonneg : 0 ≤ Real.log (τ / t) := Real.log_nonneg h_ratio_ge
  have h_log_ratio_le : Real.log (τ / t) ≤ 1 := by
    have h1 := Real.log_le_sub_one_of_pos h_ratio_pos
    linarith
  have h_div_eq : τ / r = (t / r) * (τ / t) := by
    field_simp [ne_of_gt hr, ne_of_gt ht_pos]
  have h_tr_pos : 0 < t / r := div_pos ht_pos hr
  have h_log_split : Real.log (τ / r) = Real.log (t / r) + Real.log (τ / t) := by
    rw [h_div_eq, Real.log_mul (ne_of_gt h_tr_pos) (ne_of_gt h_ratio_pos)]
  have h_abs_log : |Real.log (τ / r)| ≤ |Real.log (t / r)| + 1 := by
    rw [h_log_split]
    have h_tri := abs_add_le (Real.log (t / r)) (Real.log (τ / t))
    rw [abs_of_nonneg h_log_ratio_nonneg] at h_tri
    linarith
  have h_logK_nonneg : 0 ≤ Real.log K := Real.log_nonneg (by linarith)
  have h_abs_nonneg : 0 ≤ |Real.log (t / r)| := abs_nonneg _
  have h_one_le : 1 ≤ 1 + Real.log K + |Real.log (t / r)| := by linarith
  have h_tau_le_two : 1 + Real.log K + |Real.log (τ / r)| ≤
      2 * (1 + Real.log K + |Real.log (t / r)|) := by linarith
  have h_const_nonneg : 0 ≤ 4 * C₁ + 2 * (1 + κ ^ 2) := by positivity
  calc ‖Q_zero x t ε - p₀‖
    _ ≤ 4 * C₁ + 2 * (1 + κ ^ 2) + 4 * ‖p_fit - p₀‖ := hQ_bound
    _ ≤ (4 * C₁ + 2 * (1 + κ ^ 2)) * 1 +
          4 * (C_shift * (1 + Real.log K + |Real.log (τ / r)|)) := by linarith
    _ ≤ (4 * C₁ + 2 * (1 + κ ^ 2)) * (1 + Real.log K + |Real.log (t / r)|) +
          4 * (C_shift * (2 * (1 + Real.log K + |Real.log (t / r)|))) := by
        gcongr
    _ = C_vel * (1 + Real.log K + |Real.log (t / r)|) := by
        dsimp [C_vel]
        ring

theorem psiPotential_bounds : HasPsiPotentialBounds :=
by
  have h_nonneg : ∀ s : ℝ, 0 ≤ psiPotential s := by
    intro s
    dsimp [psiPotential]
    have h_id : 2 * s ^ 2 * (Real.log s) ^ 2 - 6 * s ^ 2 * Real.log s + 8 * s ^ 2 =
        2 * (s * Real.log s - (3 / 2 : ℝ) * s) ^ 2 + (7 / 2 : ℝ) * s ^ 2 := by ring
    rw [h_id]
    positivity
  let psiDeriv : ℝ → ℝ := fun t => 4 * t * (Real.log t) ^ 2 - 8 * t * Real.log t + 10 * t
  let psiDeriv2 : ℝ → ℝ := fun t => 4 * (Real.log t) ^ 2 + 2
  have hPsi' : ∀ t : ℝ, t ≠ 0 → HasDerivAt psiPotential (psiDeriv t) t := by
    intro t ht
    have h_id : HasDerivAt (fun x : ℝ => x) 1 t := hasDerivAt_id t
    have h_log : HasDerivAt Real.log t⁻¹ t := Real.hasDerivAt_log ht
    have h_sq : HasDerivAt (fun x : ℝ => x ^ 2) (↑(2 : ℕ) * t ^ (2 - 1) * 1) t := h_id.pow 2
    have h_log_sq : HasDerivAt (fun x : ℝ => Real.log x ^ 2) (↑(2 : ℕ) * Real.log t ^ (2 - 1) * t⁻¹) t := h_log.pow 2
    have h_raw : HasDerivAt psiPotential
        (2 * (↑(2 : ℕ) * t ^ (2 - 1) * 1) * Real.log t ^ 2 +
          2 * t ^ 2 * (↑(2 : ℕ) * Real.log t ^ (2 - 1) * t⁻¹) -
          (6 * (↑(2 : ℕ) * t ^ (2 - 1) * 1) * Real.log t + 6 * t ^ 2 * t⁻¹) +
          8 * (↑(2 : ℕ) * t ^ (2 - 1) * 1)) t :=
      (((h_sq.const_mul (2 : ℝ)).mul h_log_sq).sub ((h_sq.const_mul (6 : ℝ)).mul h_log)).add
        (h_sq.const_mul (8 : ℝ))
    exact h_raw.congr_deriv (by dsimp [psiDeriv]; field_simp [ht]; ring)
  have hPsi'' : ∀ t : ℝ, t ≠ 0 → HasDerivAt psiDeriv (psiDeriv2 t) t := by
    intro t ht
    have h_id : HasDerivAt (fun x : ℝ => x) 1 t := hasDerivAt_id t
    have h_log : HasDerivAt Real.log t⁻¹ t := Real.hasDerivAt_log ht
    have h_log_sq : HasDerivAt (fun x : ℝ => Real.log x ^ 2) (↑(2 : ℕ) * Real.log t ^ (2 - 1) * t⁻¹) t := h_log.pow 2
    have h_raw : HasDerivAt psiDeriv
        (4 * 1 * Real.log t ^ 2 + 4 * t * (↑(2 : ℕ) * Real.log t ^ (2 - 1) * t⁻¹) -
          (8 * 1 * Real.log t + 8 * t * t⁻¹) + 10 * 1) t :=
      (((h_id.const_mul (4 : ℝ)).mul h_log_sq).sub ((h_id.const_mul (8 : ℝ)).mul h_log)).add
        (h_id.const_mul (10 : ℝ))
    exact h_raw.congr_deriv (by dsimp [psiDeriv2]; field_simp [ht]; ring)
  have h_mono : ∀ s T : ℝ, 0 < s → s ≤ T → psiPotential s ≤ psiPotential T := by
    intro s T hs hsT
    rcases lt_or_eq_of_le hsT with hlt | rfl
    · have h_cont : ContinuousOn psiPotential (Set.Icc s T) := by
        intro x hx
        have hx_ne : x ≠ 0 := ne_of_gt (lt_of_lt_of_le hs hx.1)
        exact (hPsi' x hx_ne).continuousAt.continuousWithinAt
      have h_deriv : ∀ x ∈ Set.Ioo s T, HasDerivAt psiPotential (psiDeriv x) x := by
        intro x hx
        have hx_ne : x ≠ 0 := ne_of_gt (lt_trans hs hx.1)
        exact hPsi' x hx_ne
      obtain ⟨c, hc, hc_eq⟩ := exists_hasDerivAt_eq_slope psiPotential psiDeriv hlt h_cont h_deriv
      have hc_pos : 0 < c := lt_trans hs hc.1
      have h_deriv_nonneg : 0 ≤ psiDeriv c := by
        dsimp [psiDeriv]
        have h_id : 4 * c * (Real.log c) ^ 2 - 8 * c * Real.log c + 10 * c =
            4 * c * (Real.log c - 1) ^ 2 + 6 * c := by ring
        rw [h_id]
        positivity
      have hTs : 0 < T - s := sub_pos.mpr hlt
      have h_diff : psiPotential T - psiPotential s = psiDeriv c * (T - s) := by
        rw [hc_eq, div_mul_cancel₀ _ (ne_of_gt hTs)]
      have h_prod : 0 ≤ psiDeriv c * (T - s) := mul_nonneg h_deriv_nonneg (le_of_lt hTs)
      linarith
    · exact le_rfl
  have h_sec_diff : ∀ s ε : ℝ, 0 < ε → 4 * ε ≤ s →
      ε ^ 2 * ((Real.log s) ^ 2 + 1 / 2) ≤
        (psiPotential (s + ε) + psiPotential (s - ε)) / 2 - psiPotential s := by
    intro s ε hε hsε
    let F : ℝ → ℝ := fun u => psiPotential (s + u) - psiPotential ((s - ε) + u)
    let F' : ℝ → ℝ := fun u => psiDeriv (s + u) - psiDeriv ((s - ε) + u)
    have hF_deriv : ∀ u ∈ Set.Icc (0 : ℝ) ε, HasDerivAt F (F' u) u := by
      intro u hu
      have h1 : s + u ≠ 0 := by linarith [hu.1]
      have h2 : (s - ε) + u ≠ 0 := by linarith [hu.1]
      exact ((hPsi' (s + u) h1).comp_const_add s u).sub
        ((hPsi' ((s - ε) + u) h2).comp_const_add (s - ε) u)
    have hF_cont : ContinuousOn F (Set.Icc 0 ε) :=
      fun u hu => (hF_deriv u hu).continuousAt.continuousWithinAt
    have hF_deriv_oo : ∀ u ∈ Set.Ioo (0 : ℝ) ε, HasDerivAt F (F' u) u :=
      fun u hu => hF_deriv u (Set.Ioo_subset_Icc_self hu)
    obtain ⟨u₁, hu₁, hu₁_eq⟩ := exists_hasDerivAt_eq_slope F F' hε hF_cont hF_deriv_oo
    have hF_diff : F ε - F 0 = F' u₁ * ε := by
      have h_sub : ε - 0 = ε := sub_zero ε
      rw [h_sub] at hu₁_eq
      rw [hu₁_eq, div_mul_cancel₀ _ (ne_of_gt hε)]
    let a₁ : ℝ := (s - ε) + u₁
    let b₁ : ℝ := s + u₁
    have hab₁ : a₁ < b₁ := by dsimp [a₁, b₁]; linarith
    have hPsi'_deriv : ∀ x ∈ Set.Icc a₁ b₁, HasDerivAt psiDeriv (psiDeriv2 x) x := by
      intro x hx
      have hx_ne : x ≠ 0 := by
        have : a₁ ≤ x := hx.1
        dsimp [a₁] at this
        linarith [hu₁.1]
      exact hPsi'' x hx_ne
    have hPsi'_cont : ContinuousOn psiDeriv (Set.Icc a₁ b₁) :=
      fun x hx => (hPsi'_deriv x hx).continuousAt.continuousWithinAt
    have hPsi'_deriv_oo : ∀ x ∈ Set.Ioo a₁ b₁, HasDerivAt psiDeriv (psiDeriv2 x) x :=
      fun x hx => hPsi'_deriv x (Set.Ioo_subset_Icc_self hx)
    obtain ⟨ξ, hξ, hξ_eq⟩ := exists_hasDerivAt_eq_slope psiDeriv psiDeriv2 hab₁ hPsi'_cont hPsi'_deriv_oo
    have hF'_eq : F' u₁ = psiDeriv2 ξ * ε := by
      have h_ba : b₁ - a₁ = ε := by dsimp [a₁, b₁]; ring
      have h_num : psiDeriv b₁ - psiDeriv a₁ = F' u₁ := rfl
      rw [h_ba, h_num] at hξ_eq
      rw [hξ_eq, div_mul_cancel₀ _ (ne_of_gt hε)]
    have h_sec_id : (psiPotential (s + ε) + psiPotential (s - ε)) / 2 - psiPotential s =
        (F ε - F 0) / 2 := by
      dsimp [F]
      have h1 : (s - ε) + ε = s := by ring
      have h2 : s + 0 = s := by ring
      have h3 : (s - ε) + 0 = s - ε := by ring
      rw [h1, h2, h3]
      ring
    have h_sec_xi : (psiPotential (s + ε) + psiPotential (s - ε)) / 2 - psiPotential s =
        ε ^ 2 * (2 * (Real.log ξ) ^ 2 + 1) := by
      rw [h_sec_id, hF_diff, hF'_eq]
      dsimp [psiDeriv2]
      ring
    have hs_pos : 0 < s := by linarith
    have hξ_gt : s - ε < ξ := by
      have : a₁ < ξ := hξ.1
      dsimp [a₁] at this
      linarith [hu₁.1]
    have hξ_lt : ξ < s + ε := by
      have : ξ < b₁ := hξ.2
      dsimp [b₁] at this
      linarith [hu₁.2]
    have hξ_pos : 0 < ξ := by linarith
    have h_s_div_xi : s / ξ ≤ 4 / 3 := by
      rw [div_le_iff₀ hξ_pos]
      linarith
    have h_xi_div_s : ξ / s ≤ 5 / 4 := by
      rw [div_le_iff₀ hs_pos]
      linarith
    have h_log_diff1 : Real.log s - Real.log ξ ≤ 1 / 2 := by
      have h_log_eq : Real.log (s / ξ) = Real.log s - Real.log ξ :=
        Real.log_div (ne_of_gt hs_pos) (ne_of_gt hξ_pos)
      have h_log_le : Real.log (s / ξ) ≤ s / ξ - 1 :=
        Real.log_le_sub_one_of_pos (div_pos hs_pos hξ_pos)
      linarith
    have h_log_diff2 : Real.log ξ - Real.log s ≤ 1 / 2 := by
      have h_log_eq : Real.log (ξ / s) = Real.log ξ - Real.log s :=
        Real.log_div (ne_of_gt hξ_pos) (ne_of_gt hs_pos)
      have h_log_le : Real.log (ξ / s) ≤ ξ / s - 1 :=
        Real.log_le_sub_one_of_pos (div_pos hξ_pos hs_pos)
      linarith
    have h_log_quad : (Real.log s) ^ 2 + 1 / 2 ≤ 2 * (Real.log ξ) ^ 2 + 1 := by
      have h_sos : (2 * (Real.log ξ) ^ 2 + 1) - ((Real.log s) ^ 2 + 1 / 2) =
          (2 * Real.log ξ - Real.log s) ^ 2 +
            2 * (1 / 2 - (Real.log s - Real.log ξ)) * (1 / 2 + (Real.log s - Real.log ξ)) := by
        ring
      have h_f1 : 0 ≤ 1 / 2 - (Real.log s - Real.log ξ) := by linarith
      have h_f2 : 0 ≤ 1 / 2 + (Real.log s - Real.log ξ) := by linarith
      have h_prod : 0 ≤ 2 * (1 / 2 - (Real.log s - Real.log ξ)) * (1 / 2 + (Real.log s - Real.log ξ)) := by
        positivity
      have h_sq : 0 ≤ (2 * Real.log ξ - Real.log s) ^ 2 := sq_nonneg _
      linarith
    rw [h_sec_xi]
    exact mul_le_mul_of_nonneg_left h_log_quad (sq_nonneg ε)
  exact ⟨h_nonneg, h_mono, h_sec_diff⟩

theorem predictable_walk_travel_bound (d : ℕ) (h_psi : HasPsiPotentialBounds) :
    HasPredictableTravelBound d :=
by
  intro h ε' S_max M_vel C_vel B₀ y s act q_plus q_minus q_zero
    hε' hS_max hM_vel hC_vel hB₀ h_init h_pred h_step h_sh h_disc
  have h_card : (∑ _ : Fin h → Bool, (1 : ℝ)) = (2 : ℝ) ^ h := by
    simp [Finset.sum_const, Finset.card_univ, Fintype.card_fun, Fintype.card_bool, Fintype.card_fin]
  have h_two_pow_pos : (0 : ℝ) < (2 : ℝ) ^ h := by positivity
  have h_two_pow_nonneg : (0 : ℝ) ≤ (2 : ℝ) ^ h := le_of_lt h_two_pow_pos
  have h_flip_invol : ∀ n : ℕ, Function.Involutive (flipBit h n) := by
    intro n ω
    ext i
    dsimp [flipBit]
    split_ifs <;> simp
  have h_sum_flip : ∀ (n : ℕ) (F : (Fin h → Bool) → ℝ),
      (∑ ω : Fin h → Bool, F (flipBit h n ω)) = ∑ ω : Fin h → Bool, F ω := by
    intro n F
    exact Fintype.sum_bijective (flipBit h n) (h_flip_invol n).bijective
      (fun ω => F (flipBit h n ω)) F (fun _ => rfl)
  have h_bit_flip_eq : ∀ (n : ℕ), n < h → ∀ (ω : Fin h → Bool),
      walkStepBit h (flipBit h n ω) n = !(walkStepBit h ω n) := by
    intro n hn ω
    dsimp [walkStepBit, flipBit]
    rw [dif_pos hn, dif_pos hn, if_pos rfl]
  have h_bit_flip_lt : ∀ (k n : ℕ), k < n → n < h → ∀ (ω : Fin h → Bool),
      walkStepBit h (flipBit h n ω) k = walkStepBit h ω k := by
    intro k n hkn hn ω
    have hkh : k < h := lt_trans hkn hn
    have hkne : k ≠ n := ne_of_lt hkn
    dsimp [walkStepBit, flipBit]
    rw [dif_pos hkh, dif_pos hkh, if_neg hkne]
  have h_s_pair : ∀ n < h, ∀ ω,
      s (n + 1) ω + s (n + 1) (flipBit h n ω) = 2 * s n ω := by
    intro n hn ω
    have h_s_pred : s n (flipBit h n ω) = s n ω := (h_pred n n (le_refl n) hn ω).2.1
    have h_act_pred : act n (flipBit h n ω) = act n ω := (h_pred n n (le_refl n) hn ω).2.2.1
    cases h_act : act n ω
    · have h_act' : act n (flipBit h n ω) = false := h_act_pred.trans h_act
      have hs1 := ((h_step n hn ω).2 h_act).2
      have hs2 := ((h_step n hn (flipBit h n ω)).2 h_act').2
      linarith
    · have h_act' : act n (flipBit h n ω) = true := h_act_pred.trans h_act
      have hs1 := ((h_step n hn ω).1 h_act).2.1
      have hs2 := ((h_step n hn (flipBit h n ω)).1 h_act').2.1
      rw [h_bit_flip_eq n hn ω, h_s_pred] at hs2
      cases h_bit : walkStepBit h ω n <;> simp [h_bit] at hs1 hs2 <;> linarith
  have h_s_sum_step : ∀ n < h, (∑ ω, s (n + 1) ω) = ∑ ω, s n ω := by
    intro n hn
    have h1 : (∑ ω, (s (n + 1) ω + s (n + 1) (flipBit h n ω))) = ∑ ω, (2 * s n ω) :=
      Finset.sum_congr rfl (fun ω _ => h_s_pair n hn ω)
    rw [Finset.sum_add_distrib, h_sum_flip n (fun ω => s (n + 1) ω), ← Finset.mul_sum] at h1
    linarith
  have h_s_expect : uniformExp h (fun ω => s h ω) = 1 := by
    dsimp [uniformExp]
    have h_tele := Finset.sum_range_sub (fun n => ∑ ω, s n ω) h
    have h_zero : ∑ n ∈ Finset.range h, ((∑ ω, s (n + 1) ω) - (∑ ω, s n ω)) = 0 := by
      apply Finset.sum_eq_zero
      intro n hn
      rw [h_s_sum_step n (Finset.mem_range.mp hn), sub_self]
    have h_s0 : (∑ ω : Fin h → Bool, s 0 ω) = (2 : ℝ) ^ h := by
      trans (∑ _ : Fin h → Bool, (1 : ℝ))
      · exact Finset.sum_congr rfl (fun ω _ => (h_init ω).2)
      · exact h_card
    have h_sh_sum : (∑ ω, s h ω) = (2 : ℝ) ^ h := by linarith
    rw [h_sh_sum, div_self (ne_of_gt h_two_pow_pos)]
  have h_psi_pair : ∀ n < h, ∀ ω,
      2 * (if act n ω then (ε') ^ 2 * ((Real.log (s n ω)) ^ 2 + 1 / 2) else 0) ≤
        psiPotential (s (n + 1) ω) + psiPotential (s (n + 1) (flipBit h n ω)) -
          2 * psiPotential (s n ω) := by
    intro n hn ω
    have h_s_pred : s n (flipBit h n ω) = s n ω := (h_pred n n (le_refl n) hn ω).2.1
    have h_act_pred : act n (flipBit h n ω) = act n ω := (h_pred n n (le_refl n) hn ω).2.2.1
    cases h_act : act n ω
    · have h_act' : act n (flipBit h n ω) = false := h_act_pred.trans h_act
      have hs1 := ((h_step n hn ω).2 h_act).2
      have hs2 := ((h_step n hn (flipBit h n ω)).2 h_act').2
      simp [h_act, hs1, hs2, h_s_pred]
      linarith
    · have h_act' : act n (flipBit h n ω) = true := h_act_pred.trans h_act
      have hs1 := ((h_step n hn ω).1 h_act).2.1
      have hs2 := ((h_step n hn (flipBit h n ω)).1 h_act').2.1
      have h4ε := ((h_step n hn ω).1 h_act).2.2.1
      have h_conv := h_psi.2.2 (s n ω) ε' hε' h4ε
      rw [h_bit_flip_eq n hn ω, h_s_pred] at hs2
      simp only [h_act, ↓reduceIte]
      cases h_bit : walkStepBit h ω n <;> simp [h_bit] at hs1 hs2 <;> rw [hs1, hs2] <;> linarith
  have h_psi_sum_step : ∀ n < h,
      (∑ ω, if act n ω then (ε') ^ 2 * ((Real.log (s n ω)) ^ 2 + 1 / 2) else 0) ≤
        (∑ ω, psiPotential (s (n + 1) ω)) - (∑ ω, psiPotential (s n ω)) := by
    intro n hn
    have h1 := Finset.sum_le_sum (fun ω (_ : ω ∈ Finset.univ) => h_psi_pair n hn ω)
    rw [← Finset.mul_sum, Finset.sum_sub_distrib, Finset.sum_add_distrib,
        h_sum_flip n (fun ω => psiPotential (s (n + 1) ω)), ← Finset.mul_sum] at h1
    linarith
  have h_occ_sum : (∑ ω, ∑ n ∈ Finset.range h,
      if act n ω then (ε') ^ 2 * ((Real.log (s n ω)) ^ 2 + 1 / 2) else 0) ≤
      psiPotential S_max * (2 : ℝ) ^ h := by
    rw [Finset.sum_comm]
    have h1 := Finset.sum_le_sum (fun n (hn : n ∈ Finset.range h) =>
      h_psi_sum_step n (Finset.mem_range.mp hn))
    rw [Finset.sum_range_sub (fun n => ∑ ω, psiPotential (s n ω)) h] at h1
    have h_s0_nonneg : 0 ≤ ∑ ω : Fin h → Bool, psiPotential (s 0 ω) :=
      Finset.sum_nonneg (fun ω _ => h_psi.1 (s 0 ω))
    have h_sh_le : (∑ ω : Fin h → Bool, psiPotential (s h ω)) ≤ psiPotential S_max * (2 : ℝ) ^ h := by
      calc (∑ ω : Fin h → Bool, psiPotential (s h ω))
        _ ≤ ∑ _ : Fin h → Bool, psiPotential S_max :=
            Finset.sum_le_sum (fun ω _ => h_psi.2.1 (s h ω) S_max (h_sh ω).1 (h_sh ω).2)
        _ = (∑ _ : Fin h → Bool, (1 : ℝ)) * psiPotential S_max := by
            rw [Finset.sum_mul, one_mul]
        _ = psiPotential S_max * (2 : ℝ) ^ h := by rw [h_card, mul_comm]
    linarith
  have h_act_eps_sum : (∑ ω, ∑ n ∈ Finset.range h, if act n ω then (ε') ^ 2 else 0) ≤
      2 * psiPotential S_max * (2 : ℝ) ^ h := by
    have h_pt : ∀ ω, (∑ n ∈ Finset.range h, if act n ω then (ε') ^ 2 else 0) ≤
        2 * (∑ n ∈ Finset.range h, if act n ω then (ε') ^ 2 * ((Real.log (s n ω)) ^ 2 + 1 / 2) else 0) := by
      intro ω
      rw [Finset.mul_sum]
      apply Finset.sum_le_sum
      intro n _
      split_ifs
      · nlinarith [sq_nonneg ε', sq_nonneg (Real.log (s n ω))]
      · norm_num
    have h1 := Finset.sum_le_sum (fun ω (_ : ω ∈ Finset.univ) => h_pt ω)
    rw [← Finset.mul_sum] at h1
    linarith
  have h_act_eps_expect : uniformExp h (fun ω => ∑ n ∈ Finset.range h,
      if act n ω then (ε') ^ 2 else 0) ≤ 2 * psiPotential S_max := by
    dsimp [uniformExp]
    exact (div_le_iff₀ h_two_pow_pos).mpr h_act_eps_sum
  let M_step : ℕ → (Fin h → Bool) → EuclideanSpace ℝ (Fin d) :=
    fun k ω => if act k ω then (if walkStepBit h ω k then ε' • q_zero k ω else -(ε' • q_zero k ω)) else 0
  let M_sum : ℕ → (Fin h → Bool) → EuclideanSpace ℝ (Fin d) :=
    fun n ω => ∑ k ∈ Finset.range n, M_step k ω
  have h_M_pred : ∀ n < h, ∀ ω, M_sum n (flipBit h n ω) = M_sum n ω := by
    intro n hn ω
    dsimp [M_sum, M_step]
    apply Finset.sum_congr rfl
    intro k hk
    have hkn : k < n := Finset.mem_range.mp hk
    have h_act_k : act k (flipBit h n ω) = act k ω := (h_pred k n (le_of_lt hkn) hn ω).2.2.1
    have h_q0_k : q_zero k (flipBit h n ω) = q_zero k ω := (h_pred k n (le_of_lt hkn) hn ω).2.2.2
    have h_bit_k : walkStepBit h (flipBit h n ω) k = walkStepBit h ω k := h_bit_flip_lt k n hkn hn ω
    rw [h_act_k, h_q0_k, h_bit_k]
  have h_M_pair : ∀ n < h, ∀ ω,
      ‖M_sum (n + 1) ω‖ ^ 2 + ‖M_sum (n + 1) (flipBit h n ω)‖ ^ 2 - 2 * ‖M_sum n ω‖ ^ 2 =
        2 * (if act n ω then (ε') ^ 2 * ‖q_zero n ω‖ ^ 2 else 0) := by
    intro n hn ω
    have h_Mn : M_sum n (flipBit h n ω) = M_sum n ω := h_M_pred n hn ω
    have h_act_n : act n (flipBit h n ω) = act n ω := (h_pred n n (le_refl n) hn ω).2.2.1
    have h_q0_n : q_zero n (flipBit h n ω) = q_zero n ω := (h_pred n n (le_refl n) hn ω).2.2.2
    have h_bit_n : walkStepBit h (flipBit h n ω) n = !(walkStepBit h ω n) := h_bit_flip_eq n hn ω
    have h_succ1 : M_sum (n + 1) ω = M_sum n ω + M_step n ω :=
      Finset.sum_range_succ (fun k => M_step k ω) n
    have h_succ2 : M_sum (n + 1) (flipBit h n ω) = M_sum n ω + M_step n (flipBit h n ω) := by
      rw [← h_Mn]
      exact Finset.sum_range_succ (fun k => M_step k (flipBit h n ω)) n
    rw [h_succ1, h_succ2]
    dsimp [M_step]
    rw [h_act_n, h_q0_n, h_bit_n]
    cases h_act : act n ω
    · simp
      ring
    · simp only [↓reduceIte]
      have h_para : ‖M_sum n ω + ε' • q_zero n ω‖ ^ 2 + ‖M_sum n ω + -(ε' • q_zero n ω)‖ ^ 2 -
          2 * ‖M_sum n ω‖ ^ 2 = 2 * ((ε') ^ 2 * ‖q_zero n ω‖ ^ 2) := by
        rw [← sub_eq_add_neg, norm_add_sq_real, norm_sub_sq_real]
        have h_ns : ‖ε' • q_zero n ω‖ ^ 2 = (ε') ^ 2 * ‖q_zero n ω‖ ^ 2 := by
          rw [norm_smul, Real.norm_eq_abs, mul_pow, sq_abs]
        linarith
      cases h_bit : walkStepBit h ω n <;> simp [h_bit] <;> linarith [h_para]
  have h_M_sum_step : ∀ n < h,
      (∑ ω, ‖M_sum (n + 1) ω‖ ^ 2) - (∑ ω, ‖M_sum n ω‖ ^ 2) =
        ∑ ω, if act n ω then (ε') ^ 2 * ‖q_zero n ω‖ ^ 2 else 0 := by
    intro n hn
    have h1 : (∑ ω, (‖M_sum (n + 1) ω‖ ^ 2 + ‖M_sum (n + 1) (flipBit h n ω)‖ ^ 2 - 2 * ‖M_sum n ω‖ ^ 2)) =
        ∑ ω, 2 * (if act n ω then (ε') ^ 2 * ‖q_zero n ω‖ ^ 2 else 0) :=
      Finset.sum_congr rfl (fun ω _ => h_M_pair n hn ω)
    rw [Finset.sum_sub_distrib, Finset.sum_add_distrib,
        h_sum_flip n (fun ω => ‖M_sum (n + 1) ω‖ ^ 2),
        ← Finset.mul_sum, ← Finset.mul_sum] at h1
    linarith
  have h_q0_sq_le : ∀ n < h, ∀ ω,
      (if act n ω then (ε') ^ 2 * ‖q_zero n ω‖ ^ 2 else 0) ≤
        4 * (M_vel + C_vel) ^ 2 *
          (if act n ω then (ε') ^ 2 * ((Real.log (s n ω)) ^ 2 + 1 / 2) else 0) := by
    intro n hn ω
    cases h_act : act n ω
    · simp
    · simp only [↓reduceIte]
      have h_vel_n : ‖q_zero n ω‖ ≤ M_vel + C_vel * |Real.log (s n ω)| :=
        ((h_step n hn ω).1 h_act).2.2.2
      have h_L_nonneg : 0 ≤ |Real.log (s n ω)| := abs_nonneg _
      have h_q_le : ‖q_zero n ω‖ ≤ (M_vel + C_vel) * (1 + |Real.log (s n ω)|) := by
        nlinarith
      have h_q_sq : ‖q_zero n ω‖ ^ 2 ≤ ((M_vel + C_vel) * (1 + |Real.log (s n ω)|)) ^ 2 := by
        nlinarith [norm_nonneg (q_zero n ω)]
      have h_L_sq : |Real.log (s n ω)| ^ 2 = (Real.log (s n ω)) ^ 2 := sq_abs _
      have h_mult : (1 + |Real.log (s n ω)|) ^ 2 ≤ 4 * ((Real.log (s n ω)) ^ 2 + 1 / 2) := by
        nlinarith [sq_nonneg (|Real.log (s n ω)| - 1)]
      have h_comb : ‖q_zero n ω‖ ^ 2 ≤ 4 * (M_vel + C_vel) ^ 2 * ((Real.log (s n ω)) ^ 2 + 1 / 2) := by
        calc ‖q_zero n ω‖ ^ 2
          _ ≤ (M_vel + C_vel) ^ 2 * (1 + |Real.log (s n ω)|) ^ 2 := by
              linarith [show ((M_vel + C_vel) * (1 + |Real.log (s n ω)|)) ^ 2 =
                (M_vel + C_vel) ^ 2 * (1 + |Real.log (s n ω)|) ^ 2 by ring]
          _ ≤ (M_vel + C_vel) ^ 2 * (4 * ((Real.log (s n ω)) ^ 2 + 1 / 2)) :=
              mul_le_mul_of_nonneg_left h_mult (sq_nonneg _)
          _ = 4 * (M_vel + C_vel) ^ 2 * ((Real.log (s n ω)) ^ 2 + 1 / 2) := by ring
      have h_eps_comb := mul_le_mul_of_nonneg_left h_comb (sq_nonneg ε')
      linarith
  have h_M_sq_sum : (∑ ω, ‖M_sum h ω‖ ^ 2) ≤
      4 * (M_vel + C_vel) ^ 2 * psiPotential S_max * (2 : ℝ) ^ h := by
    have h_tele := Finset.sum_range_sub (fun n => ∑ ω, ‖M_sum n ω‖ ^ 2) h
    have h_M0 : (∑ ω : Fin h → Bool, ‖M_sum 0 ω‖ ^ 2) = 0 := by
      simp [M_sum]
    have h_eq : (∑ ω, ‖M_sum h ω‖ ^ 2) =
        ∑ n ∈ Finset.range h, ∑ ω, if act n ω then (ε') ^ 2 * ‖q_zero n ω‖ ^ 2 else 0 := by
      have h1 : (∑ n ∈ Finset.range h, ((∑ ω, ‖M_sum (n + 1) ω‖ ^ 2) - (∑ ω, ‖M_sum n ω‖ ^ 2))) =
          ∑ n ∈ Finset.range h, ∑ ω, if act n ω then (ε') ^ 2 * ‖q_zero n ω‖ ^ 2 else 0 :=
        Finset.sum_congr rfl (fun n hn => h_M_sum_step n (Finset.mem_range.mp hn))
      linarith
    rw [h_eq, Finset.sum_comm]
    have h_le : (∑ ω, ∑ n ∈ Finset.range h, if act n ω then (ε') ^ 2 * ‖q_zero n ω‖ ^ 2 else 0) ≤
        4 * (M_vel + C_vel) ^ 2 *
          (∑ ω, ∑ n ∈ Finset.range h, if act n ω then (ε') ^ 2 * ((Real.log (s n ω)) ^ 2 + 1 / 2) else 0) := by
      rw [Finset.mul_sum]
      apply Finset.sum_le_sum
      intro ω _
      rw [Finset.mul_sum]
      exact Finset.sum_le_sum (fun n hn => h_q0_sq_le n (Finset.mem_range.mp hn) ω)
    have h_mult_occ := mul_le_mul_of_nonneg_left h_occ_sum (show 0 ≤ 4 * (M_vel + C_vel) ^ 2 by positivity)
    linarith
  have h_psi_nonneg : 0 ≤ psiPotential S_max := h_psi.1 S_max
  have h_M_l1_sum : (∑ ω, ‖M_sum h ω‖) ≤
      2 * (M_vel + C_vel) * Real.sqrt (psiPotential S_max) * (2 : ℝ) ^ h := by
    have h_cs := Finset.sum_mul_sq_le_sq_mul_sq Finset.univ (fun ω => ‖M_sum h ω‖) (fun _ => (1 : ℝ))
    simp only [mul_one, one_pow, h_card] at h_cs
    have h_rhs_le : (∑ ω, ‖M_sum h ω‖ ^ 2) * (2 : ℝ) ^ h ≤
        (2 * (M_vel + C_vel) * Real.sqrt (psiPotential S_max) * (2 : ℝ) ^ h) ^ 2 := by
      calc (∑ ω, ‖M_sum h ω‖ ^ 2) * (2 : ℝ) ^ h
        _ ≤ (4 * (M_vel + C_vel) ^ 2 * psiPotential S_max * (2 : ℝ) ^ h) * (2 : ℝ) ^ h :=
            mul_le_mul_of_nonneg_right h_M_sq_sum h_two_pow_nonneg
        _ = (2 * (M_vel + C_vel) * (2 : ℝ) ^ h) ^ 2 * (Real.sqrt (psiPotential S_max)) ^ 2 := by
            rw [Real.sq_sqrt h_psi_nonneg]
            ring
        _ = (2 * (M_vel + C_vel) * Real.sqrt (psiPotential S_max) * (2 : ℝ) ^ h) ^ 2 := by ring
    have h_sq_le : (∑ ω, ‖M_sum h ω‖) ^ 2 ≤
        (2 * (M_vel + C_vel) * Real.sqrt (psiPotential S_max) * (2 : ℝ) ^ h) ^ 2 :=
      le_trans h_cs h_rhs_le
    have h_sqrt := Real.sqrt_le_sqrt h_sq_le
    rw [Real.sqrt_sq (Finset.sum_nonneg (fun ω _ => norm_nonneg _)),
        Real.sqrt_sq (by positivity)] at h_sqrt
    exact h_sqrt
  let f_step : ℕ → (Fin h → Bool) → ℝ :=
    fun n ω => if act n ω then ε' else 0
  let g_step : ℕ → (Fin h → Bool) → ℝ :=
    fun n ω => if act n ω then
      (if walkStepBit h ω n then ‖q_plus n ω - q_zero n ω‖ else ‖q_minus n ω - q_zero n ω‖)
    else 0
  have h_err_step_norm : ∀ n < h, ∀ ω,
      ‖(y (n + 1) ω - M_sum (n + 1) ω) - (y n ω - M_sum n ω)‖ = f_step n ω * g_step n ω := by
    intro n hn ω
    have h_succ : M_sum (n + 1) ω = M_sum n ω + M_step n ω :=
      Finset.sum_range_succ (fun k => M_step k ω) n
    have h_rearr : (y (n + 1) ω - M_sum (n + 1) ω) - (y n ω - M_sum n ω) =
        (y (n + 1) ω - y n ω) - M_step n ω := by
      rw [h_succ]
      abel
    rw [h_rearr]
    dsimp [M_step, f_step, g_step]
    cases h_act : act n ω
    · have hy := ((h_step n hn ω).2 h_act).1
      simp [hy]
    · have hy := ((h_step n hn ω).1 h_act).1
      simp only [↓reduceIte]
      cases h_bit : walkStepBit h ω n
      · simp only [h_bit, Bool.false_eq_true, ↓reduceIte] at hy ⊢
        have h_vec : y (n + 1) ω - y n ω - -(ε' • q_zero n ω) =
            -(ε' • (q_minus n ω - q_zero n ω)) := by
          rw [hy, smul_sub]
          abel
        rw [h_vec, norm_neg, norm_smul, Real.norm_of_nonneg (le_of_lt hε')]
      · simp only [h_bit, ↓reduceIte] at hy ⊢
        have h_vec : y (n + 1) ω - y n ω - ε' • q_zero n ω =
            ε' • (q_plus n ω - q_zero n ω) := by
          rw [hy, smul_sub]
          abel
        rw [h_vec, norm_smul, Real.norm_of_nonneg (le_of_lt hε')]
  let A_path : (Fin h → Bool) → ℝ :=
    fun ω => ∑ n ∈ Finset.range h, if act n ω then (ε') ^ 2 else 0
  let B_path : (Fin h → Bool) → ℝ :=
    fun ω => ∑ n ∈ Finset.range h,
      if act n ω then (‖q_plus n ω - q_zero n ω‖ ^ 2 + ‖q_minus n ω - q_zero n ω‖ ^ 2) else 0
  have h_A_nonneg : ∀ ω, 0 ≤ A_path ω := by
    intro ω
    apply Finset.sum_nonneg
    intro n _
    split_ifs <;> positivity
  have h_B_nonneg : ∀ ω, 0 ≤ B_path ω := by
    intro ω
    apply Finset.sum_nonneg
    intro n _
    split_ifs <;> positivity
  have h_err_path : ∀ ω, ‖y h ω - M_sum h ω‖ ≤ Real.sqrt (A_path ω) * Real.sqrt (B_path ω) := by
    intro ω
    have h_tele := Finset.sum_range_sub (fun n => y n ω - M_sum n ω) h
    have h_zero0 : y 0 ω - M_sum 0 ω = 0 := by
      simp [(h_init ω).1, M_sum]
    rw [h_zero0, sub_zero] at h_tele
    have h_norm_le : ‖y h ω - M_sum h ω‖ ≤ ∑ n ∈ Finset.range h, f_step n ω * g_step n ω := by
      rw [← h_tele]
      calc ‖∑ n ∈ Finset.range h, ((y (n + 1) ω - M_sum (n + 1) ω) - (y n ω - M_sum n ω))‖
        _ ≤ ∑ n ∈ Finset.range h, ‖(y (n + 1) ω - M_sum (n + 1) ω) - (y n ω - M_sum n ω)‖ :=
            norm_sum_le _ _
        _ = ∑ n ∈ Finset.range h, f_step n ω * g_step n ω :=
            Finset.sum_congr rfl (fun n hn => h_err_step_norm n (Finset.mem_range.mp hn) ω)
    have h_cs := Finset.sum_mul_sq_le_sq_mul_sq (Finset.range h) (fun n => f_step n ω) (fun n => g_step n ω)
    have h_f_sq : (∑ n ∈ Finset.range h, (f_step n ω) ^ 2) = A_path ω := by
      apply Finset.sum_congr rfl
      intro n _
      dsimp [f_step]
      split_ifs <;> ring
    have h_g_sq : (∑ n ∈ Finset.range h, (g_step n ω) ^ 2) ≤ B_path ω := by
      apply Finset.sum_le_sum
      intro n _
      dsimp [g_step]
      split_ifs <;> nlinarith [sq_nonneg ‖q_plus n ω - q_zero n ω‖, sq_nonneg ‖q_minus n ω - q_zero n ω‖]
    have h_sq_le : ‖y h ω - M_sum h ω‖ ^ 2 ≤ (Real.sqrt (A_path ω) * Real.sqrt (B_path ω)) ^ 2 := by
      calc ‖y h ω - M_sum h ω‖ ^ 2
        _ ≤ (∑ n ∈ Finset.range h, f_step n ω * g_step n ω) ^ 2 := by
            nlinarith [norm_nonneg (y h ω - M_sum h ω)]
        _ ≤ (∑ n ∈ Finset.range h, (f_step n ω) ^ 2) * (∑ n ∈ Finset.range h, (g_step n ω) ^ 2) := h_cs
        _ ≤ A_path ω * B_path ω := by
            rw [h_f_sq]
            exact mul_le_mul_of_nonneg_left h_g_sq (h_A_nonneg ω)
        _ = (Real.sqrt (A_path ω)) ^ 2 * (Real.sqrt (B_path ω)) ^ 2 := by
            rw [Real.sq_sqrt (h_A_nonneg ω), Real.sq_sqrt (h_B_nonneg ω)]
        _ = (Real.sqrt (A_path ω) * Real.sqrt (B_path ω)) ^ 2 := by ring
    have h_sqrt := Real.sqrt_le_sqrt h_sq_le
    rw [Real.sqrt_sq (norm_nonneg _), Real.sqrt_sq (by positivity)] at h_sqrt
    exact h_sqrt
  have h_disc_sum : (∑ ω, B_path ω) ≤ B₀ * (2 : ℝ) ^ h := by
    dsimp [uniformExp] at h_disc
    exact (div_le_iff₀ h_two_pow_pos).mp h_disc
  have h_err_l1_sum : (∑ ω, ‖y h ω - M_sum h ω‖) ≤
      Real.sqrt (psiPotential S_max) * Real.sqrt (2 * B₀) * (2 : ℝ) ^ h := by
    have h_sum_le : (∑ ω, ‖y h ω - M_sum h ω‖) ≤
        ∑ ω, Real.sqrt (A_path ω) * Real.sqrt (B_path ω) :=
      Finset.sum_le_sum (fun ω _ => h_err_path ω)
    have h_cs := Finset.sum_mul_sq_le_sq_mul_sq Finset.univ
      (fun ω => Real.sqrt (A_path ω)) (fun ω => Real.sqrt (B_path ω))
    have h_A_sq : (∑ ω, (Real.sqrt (A_path ω)) ^ 2) = ∑ ω, A_path ω :=
      Finset.sum_congr rfl (fun ω _ => Real.sq_sqrt (h_A_nonneg ω))
    have h_B_sq : (∑ ω, (Real.sqrt (B_path ω)) ^ 2) = ∑ ω, B_path ω :=
      Finset.sum_congr rfl (fun ω _ => Real.sq_sqrt (h_B_nonneg ω))
    rw [h_A_sq, h_B_sq] at h_cs
    have h_AB_le : (∑ ω, A_path ω) * (∑ ω, B_path ω) ≤
        (Real.sqrt (psiPotential S_max) * Real.sqrt (2 * B₀) * (2 : ℝ) ^ h) ^ 2 := by
      calc (∑ ω, A_path ω) * (∑ ω, B_path ω)
        _ ≤ (2 * psiPotential S_max * (2 : ℝ) ^ h) * (B₀ * (2 : ℝ) ^ h) :=
            mul_le_mul h_act_eps_sum h_disc_sum
              (Finset.sum_nonneg (fun ω _ => h_B_nonneg ω)) (by positivity)
        _ = (Real.sqrt (psiPotential S_max)) ^ 2 * (Real.sqrt (2 * B₀)) ^ 2 * ((2 : ℝ) ^ h) ^ 2 := by
            rw [Real.sq_sqrt h_psi_nonneg, Real.sq_sqrt (by positivity)]
            ring
        _ = (Real.sqrt (psiPotential S_max) * Real.sqrt (2 * B₀) * (2 : ℝ) ^ h) ^ 2 := by ring
    have h_sq_le : (∑ ω, ‖y h ω - M_sum h ω‖) ^ 2 ≤
        (Real.sqrt (psiPotential S_max) * Real.sqrt (2 * B₀) * (2 : ℝ) ^ h) ^ 2 := by
      have h_nonneg : 0 ≤ ∑ ω, ‖y h ω - M_sum h ω‖ :=
        Finset.sum_nonneg (fun ω _ => norm_nonneg _)
      have h_sq1 : (∑ ω, ‖y h ω - M_sum h ω‖) ^ 2 ≤
          (∑ ω, Real.sqrt (A_path ω) * Real.sqrt (B_path ω)) ^ 2 := by nlinarith
      exact le_trans h_sq1 (le_trans h_cs h_AB_le)
    have h_sqrt := Real.sqrt_le_sqrt h_sq_le
    rw [Real.sqrt_sq (Finset.sum_nonneg (fun ω _ => norm_nonneg _)),
        Real.sqrt_sq (by positivity)] at h_sqrt
    exact h_sqrt
  refine ⟨h_s_expect, h_act_eps_expect, ?_⟩
  dsimp [uniformExp]
  have h_tri_sum : (∑ ω, ‖y h ω‖) ≤
      (Real.sqrt (psiPotential S_max) * (2 * (M_vel + C_vel) + Real.sqrt (2 * B₀))) * (2 : ℝ) ^ h := by
    have h_pt : (∑ ω, ‖y h ω‖) ≤ (∑ ω, ‖M_sum h ω‖) + (∑ ω, ‖y h ω - M_sum h ω‖) := by
      rw [← Finset.sum_add_distrib]
      apply Finset.sum_le_sum
      intro ω _
      have h_eq : y h ω = M_sum h ω + (y h ω - M_sum h ω) := by abel
      calc ‖y h ω‖
        _ = ‖M_sum h ω + (y h ω - M_sum h ω)‖ := by rw [← h_eq]
        _ ≤ ‖M_sum h ω‖ + ‖y h ω - M_sum h ω‖ := norm_add_le _ _
    linarith
  exact (div_le_iff₀ h_two_pow_pos).mpr h_tri_sum

theorem outer_cutoff_and_walk_scale_selection (d : ℕ) (κ H_star : ℝ)
    (v : EuclideanSpace ℝ (Fin (d + 1)) → ℝ)
    (hJ_start : Filter.Tendsto (fun ℓ => driftFunctional d κ ℓ v (mkSpaceTime 0 1))
      (nhdsWithin 0 (Set.Ioi 0)) (nhds H_star))
    (Q_plus Q_minus : EuclideanSpace ℝ (Fin d) → ℝ → ℝ → EuclideanSpace ℝ (Fin d))
    (hQ_step : ∀ (R T : ℝ), 2 ≤ R → 2 ≤ T →
      ∃ ε₀ : ℝ, 0 < ε₀ ∧
        ∀ (ε : ℝ) (x : EuclideanSpace ℝ (Fin d)) (t : ℝ),
          0 < ε → ε ≤ ε₀ → ‖x‖ ≤ R → ε < t → t ≤ T →
          ‖ε • Q_plus x t ε‖ ≤ 1 ∧ ‖ε • Q_minus x t ε‖ ≤ 1)
    (C_vel C_ub : ℝ) (hC_vel : 0 < C_vel) (hC_ub : 0 < C_ub)
    (h_psi : HasPsiPotentialBounds) :
    ∃ (R U_R D_raw B₀ : ℝ) (m_walk h_walk : ℕ → ℕ),
      16 ≤ R ∧ 0 < D_raw ∧ 0 < B₀ ∧
      U_R = C_ub * (1 + Real.log (R + 1)) ^ 4 ∧
      U_R - H_star + 1 ≤ D_raw ∧
      B₀ = D_raw / (1 / (16 * (1 + Real.log 2))) ∧
      Real.sqrt (psiPotential 16) *
        (2 * (C_vel * (1 + Real.log R) + C_vel) + Real.sqrt (2 * B₀)) ≤ R / 8 ∧
      ∀ N : ℕ, 1 ≤ N →
        let ε := (1 / 2 : ℝ) ^ (m_walk N)
        N + 2 ≤ m_walk N ∧
        0 < ε ∧ ε ≤ ((1 / 2 : ℝ) ^ N) / 4 ∧
        (∀ (x : EuclideanSpace ℝ (Fin d)) (t : ℝ),
          ‖x‖ ≤ R → ε < t → t ≤ 16 →
          ‖ε • Q_plus x t ε‖ ≤ 1 ∧ ‖ε • Q_minus x t ε‖ ≤ 1) ∧
        H_star - 1 ≤ driftFunctional d κ ε v (mkSpaceTime 0 1) ∧
        32 * psiPotential 16 + 1 ≤ (h_walk N : ℝ) * ε ^ 2 :=
by
  let c_drift : ℝ := 1 / (16 * (1 + Real.log 2))
  have h_log2 : 0 < Real.log 2 := Real.log_pos (by norm_num)
  have hc_drift_pos : 0 < c_drift := by
    dsimp [c_drift]
    positivity
  let M_H : ℝ := max (1 - H_star) 1
  have hMH_left : 1 - H_star ≤ M_H := le_max_left (1 - H_star) 1
  have hMH_one : 1 ≤ M_H := le_max_right (1 - H_star) 1
  have hMH_pos : 0 < M_H := by linarith
  let A_0 : ℝ := Real.sqrt (2 * (256 * C_ub + M_H) / c_drift)
  have hA0_nonneg : 0 ≤ A_0 := Real.sqrt_nonneg _
  have hA0_sq : A_0 ^ 2 = 2 * (256 * C_ub + M_H) / c_drift := by
    dsimp [A_0]
    exact Real.sq_sqrt (by positivity)
  have h_psi16_nonneg : 0 ≤ psiPotential 16 := h_psi.1 16
  have h_sqrt_psi : 0 ≤ Real.sqrt (psiPotential 16) := Real.sqrt_nonneg _
  let K_0 : ℝ := Real.sqrt (psiPotential 16) * (10 * C_vel + A_0)
  have hK0_nonneg : 0 ≤ K_0 := by
    dsimp [K_0]
    positivity
  let w : ℝ := max 3 (16 * K_0)
  have hw3 : 3 ≤ w := le_max_left 3 (16 * K_0)
  have hwK : 16 * K_0 ≤ w := le_max_right 3 (16 * K_0)
  have hw_pos : 0 < w := by linarith
  have hw2_ge1 : 1 ≤ w ^ 2 := by nlinarith
  have hw4_ge1 : 1 ≤ w ^ 4 := by nlinarith
  let R : ℝ := w ^ 4 - 1
  have hR80_id : R - 80 = (w - 3) * (w ^ 3 + 3 * w ^ 2 + 9 * w + 27) := by
    dsimp [R]
    ring
  have hR80 : 80 ≤ R := by
    have h_factor_pos : 0 < w ^ 3 + 3 * w ^ 2 + 9 * w + 27 := by positivity
    nlinarith
  have hR16 : 16 ≤ R := by linarith
  have hR2 : 2 ≤ R := by linarith
  have hR1 : 1 ≤ R := by linarith
  have hR_pos : 0 < R := by linarith
  have hw3_id : R - w ^ 3 = (w - 3) * (w ^ 3 + 2 * w ^ 2 + 6 * w + 18) + 53 := by
    dsimp [R]
    ring
  have hw3_le_R : w ^ 3 ≤ R := by
    have h_factor_pos : 0 < w ^ 3 + 2 * w ^ 2 + 6 * w + 18 := by positivity
    nlinarith
  have h16K0_w2 : 16 * K_0 * w ^ 2 ≤ R := by
    have hw2_nonneg : 0 ≤ w ^ 2 := sq_nonneg w
    have h_step : 16 * K_0 * w ^ 2 ≤ w * w ^ 2 := mul_le_mul_of_nonneg_right hwK hw2_nonneg
    have h_cube : w * w ^ 2 = w ^ 3 := by ring
    linarith
  have hK0_w2 : K_0 * w ^ 2 ≤ R / 8 := by linarith
  let U_R : ℝ := C_ub * (1 + Real.log (R + 1)) ^ 4
  let D_raw : ℝ := max (U_R - H_star + 1) 1
  have hD_raw_ge : U_R - H_star + 1 ≤ D_raw := le_max_left _ _
  have hD_raw_one : 1 ≤ D_raw := le_max_right _ _
  have hD_raw_pos : 0 < D_raw := by linarith
  let B₀ : ℝ := D_raw / c_drift
  have hB0_pos : 0 < B₀ := div_pos hD_raw_pos hc_drift_pos
  have hlogR_nonneg : 0 ≤ Real.log R := Real.log_nonneg hR1
  have hlogR_le : Real.log R ≤ Real.log (R + 1) :=
    Real.log_le_log hR_pos (by linarith)
  have hR1_eq : R + 1 = w ^ 4 := by
    dsimp [R]
    ring
  have hlogR1_eq : Real.log (R + 1) = 4 * Real.log w := by
    rw [hR1_eq, Real.log_pow]
    norm_num
  have hlogw_le : Real.log w ≤ w - 1 := Real.log_le_sub_one_of_pos hw_pos
  have h1logR_le : 1 + Real.log R ≤ 4 * w := by linarith
  have h1logR1_nonneg : 0 ≤ 1 + Real.log (R + 1) := by linarith
  have h1logR1_le : 1 + Real.log (R + 1) ≤ 4 * w := by linarith
  have h_pow4_le : (1 + Real.log (R + 1)) ^ 4 ≤ 256 * w ^ 4 := by
    calc (1 + Real.log (R + 1)) ^ 4
      _ ≤ (4 * w) ^ 4 := pow_le_pow_left₀ h1logR1_nonneg h1logR1_le 4
      _ = 256 * w ^ 4 := by ring
  have hUR_ub : U_R ≤ 256 * C_ub * w ^ 4 := by
    dsimp [U_R]
    nlinarith
  have hD_raw_ub : D_raw ≤ (256 * C_ub + M_H) * w ^ 4 := by
    apply max_le
    · nlinarith
    · nlinarith
  have h2B0_ub : 2 * B₀ ≤ (A_0 * w ^ 2) ^ 2 := by
    have h_div : D_raw / c_drift ≤ ((256 * C_ub + M_H) * w ^ 4) / c_drift :=
      div_le_div_of_nonneg_right hD_raw_ub (le_of_lt hc_drift_pos)
    calc 2 * B₀
      _ = 2 * (D_raw / c_drift) := rfl
      _ ≤ 2 * (((256 * C_ub + M_H) * w ^ 4) / c_drift) := by linarith
      _ = (2 * (256 * C_ub + M_H) / c_drift) * w ^ 4 := by ring
      _ = A_0 ^ 2 * w ^ 4 := by rw [← hA0_sq]
      _ = (A_0 * w ^ 2) ^ 2 := by ring
  have h_sqrt_B0 : Real.sqrt (2 * B₀) ≤ A_0 * w ^ 2 := by
    calc Real.sqrt (2 * B₀)
      _ ≤ Real.sqrt ((A_0 * w ^ 2) ^ 2) := Real.sqrt_le_sqrt h2B0_ub
      _ = A_0 * w ^ 2 := Real.sqrt_sq (by positivity)
  have h_vel_ub : 2 * (C_vel * (1 + Real.log R) + C_vel) ≤ 10 * C_vel * w ^ 2 := by
    have hw_le_w2 : w ≤ w ^ 2 := by nlinarith
    nlinarith
  have h_inner_ub : 2 * (C_vel * (1 + Real.log R) + C_vel) + Real.sqrt (2 * B₀) ≤
      (10 * C_vel + A_0) * w ^ 2 := by linarith
  have h_travel_bound : Real.sqrt (psiPotential 16) *
      (2 * (C_vel * (1 + Real.log R) + C_vel) + Real.sqrt (2 * B₀)) ≤ R / 8 := by
    calc Real.sqrt (psiPotential 16) *
        (2 * (C_vel * (1 + Real.log R) + C_vel) + Real.sqrt (2 * B₀))
      _ ≤ Real.sqrt (psiPotential 16) * ((10 * C_vel + A_0) * w ^ 2) :=
        mul_le_mul_of_nonneg_left h_inner_ub h_sqrt_psi
      _ = K_0 * w ^ 2 := by
        dsimp [K_0]
        ring
      _ ≤ R / 8 := hK0_w2
  obtain ⟨ε₀, hε₀_pos, hε₀_step⟩ := hQ_step R 16 hR2 (by norm_num)
  obtain ⟨δ₀, hδ₀_pos, hδ₀_lim⟩ :=
    (Metric.tendsto_nhdsWithin_nhds.mp hJ_start) 1 zero_lt_one
  let η : ℝ := min ε₀ δ₀
  have hη_pos : 0 < η := lt_min hε₀_pos hδ₀_pos
  have hη_ε₀ : η ≤ ε₀ := min_le_left ε₀ δ₀
  have hη_δ₀ : η ≤ δ₀ := min_le_right ε₀ δ₀
  let m₀ : ℕ := Nat.ceil (η⁻¹) + 1
  have hm₀_gt : η⁻¹ < (m₀ : ℝ) := by
    have h_ceil : η⁻¹ ≤ (Nat.ceil (η⁻¹) : ℝ) := Nat.le_ceil (η⁻¹)
    dsimp [m₀]
    push_cast
    linarith
  have hm₀_pow : (m₀ : ℝ) < (2 : ℝ) ^ m₀ := by
    exact_mod_cast @Nat.lt_two_pow_self m₀
  have h_inv_lt : η⁻¹ < (2 : ℝ) ^ m₀ := by linarith
  have h_half_m₀_lt : (1 / 2 : ℝ) ^ m₀ < η := by
    have h_pos_prod : 0 < η * (1 / 2 : ℝ) ^ m₀ := by positivity
    have h_mul := mul_lt_mul_of_pos_right h_inv_lt h_pos_prod
    have h_lhs : η⁻¹ * (η * (1 / 2 : ℝ) ^ m₀) = (1 / 2 : ℝ) ^ m₀ := by
      calc η⁻¹ * (η * (1 / 2 : ℝ) ^ m₀)
        _ = (η⁻¹ * η) * (1 / 2 : ℝ) ^ m₀ := by ring
        _ = 1 * (1 / 2 : ℝ) ^ m₀ := by rw [inv_mul_cancel₀ (ne_of_gt hη_pos)]
        _ = (1 / 2 : ℝ) ^ m₀ := one_mul _
    have h_rhs : (2 : ℝ) ^ m₀ * (η * (1 / 2 : ℝ) ^ m₀) = η := by
      calc (2 : ℝ) ^ m₀ * (η * (1 / 2 : ℝ) ^ m₀)
        _ = η * ((2 : ℝ) ^ m₀ * (1 / 2 : ℝ) ^ m₀) := by ring
        _ = η * ((2 * (1 / 2) : ℝ) ^ m₀) := by rw [← mul_pow]
        _ = η := by norm_num
    linarith
  let m_walk : ℕ → ℕ := fun N => N + 2 + m₀
  let M_psi : ℕ := Nat.ceil (32 * psiPotential 16 + 1)
  let h_walk : ℕ → ℕ := fun N => M_psi * 4 ^ (m_walk N)
  refine ⟨R, U_R, D_raw, B₀, m_walk, h_walk, hR16, hD_raw_pos, hB0_pos, rfl, hD_raw_ge, rfl,
    h_travel_bound, ?_⟩
  intro N _hN1
  dsimp only
  set ε : ℝ := (1 / 2 : ℝ) ^ (m_walk N)
  have hNm : N + 2 ≤ m_walk N := by
    dsimp [m_walk]
    omega
  have hm₀_le : m₀ ≤ m_walk N := by
    dsimp [m_walk]
    omega
  have hε_pos : 0 < ε := by positivity
  have hε_le_quarter : ε ≤ ((1 / 2 : ℝ) ^ N) / 4 := by
    calc ε
      _ ≤ (1 / 2 : ℝ) ^ (N + 2) :=
        pow_le_pow_of_le_one (by norm_num) (by norm_num) hNm
      _ = ((1 / 2 : ℝ) ^ N) * (1 / 2 : ℝ) ^ 2 := pow_add (1 / 2 : ℝ) N 2
      _ = ((1 / 2 : ℝ) ^ N) / 4 := by ring
  have hε_le_m₀ : ε ≤ (1 / 2 : ℝ) ^ m₀ :=
    pow_le_pow_of_le_one (by norm_num) (by norm_num) hm₀_le
  have hε_lt_η : ε < η := lt_of_le_of_lt hε_le_m₀ h_half_m₀_lt
  have hε_le_ε₀ : ε ≤ ε₀ := by linarith
  have hε_lt_δ₀ : ε < δ₀ := by linarith
  have h_step : ∀ (x : EuclideanSpace ℝ (Fin d)) (t : ℝ),
      ‖x‖ ≤ R → ε < t → t ≤ 16 →
      ‖ε • Q_plus x t ε‖ ≤ 1 ∧ ‖ε • Q_minus x t ε‖ ≤ 1 := by
    intro x t hx ht1 ht2
    exact hε₀_step ε x t hε_pos hε_le_ε₀ hx ht1 ht2
  have hJ_init : H_star - 1 ≤ driftFunctional d κ ε v (mkSpaceTime 0 1) := by
    have h_mem : ε ∈ Set.Ioi (0 : ℝ) := hε_pos
    have h_dist : dist ε 0 < δ₀ := by
      rw [Real.dist_eq, sub_zero, abs_of_pos hε_pos]
      exact hε_lt_δ₀
    have h_lim := hδ₀_lim h_mem h_dist
    rw [Real.dist_eq] at h_lim
    linarith [abs_lt.mp h_lim]
  have h_horizon : 32 * psiPotential 16 + 1 ≤ (h_walk N : ℝ) * ε ^ 2 := by
    have h_cancel : (4 : ℝ) ^ (m_walk N) * ε ^ 2 = 1 := by
      dsimp [ε]
      calc (4 : ℝ) ^ (m_walk N) * ((1 / 2 : ℝ) ^ (m_walk N)) ^ 2
        _ = (4 : ℝ) ^ (m_walk N) * ((1 / 2 : ℝ) ^ 2) ^ (m_walk N) := by
          rw [← pow_mul, mul_comm (m_walk N) 2, pow_mul]
        _ = (4 * (1 / 2 : ℝ) ^ 2) ^ (m_walk N) := by rw [← mul_pow]
        _ = 1 := by norm_num
    have h_prod : (h_walk N : ℝ) * ε ^ 2 = (M_psi : ℝ) := by
      dsimp [h_walk]
      push_cast
      calc (M_psi : ℝ) * (4 : ℝ) ^ (m_walk N) * ε ^ 2
        _ = (M_psi : ℝ) * ((4 : ℝ) ^ (m_walk N) * ε ^ 2) := by ring
        _ = (M_psi : ℝ) * 1 := by rw [h_cancel]
        _ = (M_psi : ℝ) := mul_one _
    rw [h_prod]
    exact Nat.le_ceil (32 * psiPotential 16 + 1)
  exact ⟨hNm, hε_pos, hε_le_quarter, h_step, hJ_init, h_horizon⟩

theorem stoppedWalk_pathwise_invariants_and_coupling (d : ℕ)
    (Q_plus Q_minus : EuclideanSpace ℝ (Fin d) → ℝ → ℝ → EuclideanSpace ℝ (Fin d))
    (R : ℝ) (hR : 16 ≤ R) (m h : ℕ)
    (h_step : ∀ (x : EuclideanSpace ℝ (Fin d)) (t : ℝ),
      ‖x‖ ≤ R → (1 / 2 : ℝ) ^ m < t → t ≤ 16 →
      ‖((1 / 2 : ℝ) ^ m) • Q_plus x t ((1 / 2 : ℝ) ^ m)‖ ≤ 1 ∧
      ‖((1 / 2 : ℝ) ^ m) • Q_minus x t ((1 / 2 : ℝ) ^ m)‖ ≤ 1)
    (j : ℕ) (hj1 : 1 ≤ j) (hjm : j + 2 ≤ m) :
    let ε := (1 / 2 : ℝ) ^ m
    let δ_j := (1 / 2 : ℝ) ^ j
    (∀ (n : ℕ) (ω : Fin h → Bool),
      let z := stoppedWalk d Q_plus Q_minus ε δ_j R h ω n
      δ_j ≤ z.2 ∧ z.2 ≤ 16 ∧ ‖z.1‖ ≤ R + 1 ∧ (z.2 ≤ δ_j → z.2 = δ_j)) ∧
    (∀ (k n : ℕ), k ≤ n → n < h → ∀ ω : Fin h → Bool,
      stoppedWalk d Q_plus Q_minus ε δ_j R h (flipBit h n ω) k =
        stoppedWalk d Q_plus Q_minus ε δ_j R h ω k) ∧
    (∀ ω : Fin h → Bool,
      isWalkActive d δ_j R (stoppedWalk d Q_plus Q_minus ε δ_j R h ω h) = true →
      ∀ n < h, isWalkActive d δ_j R (stoppedWalk d Q_plus Q_minus ε δ_j R h ω n) = true) ∧
    (∀ (N : ℕ), j ≤ N → N + 2 ≤ m → ∀ ω : Fin h → Bool,
      let δ_N := (1 / 2 : ℝ) ^ N
      (stoppedWalk d Q_plus Q_minus ε δ_N R h ω h).2 = δ_N →
      (stoppedWalk d Q_plus Q_minus ε δ_j R h ω h).2 = δ_j) :=
by
  intro ε δ_j
  have hε_pos : 0 < ε := by positivity
  have h_delta_grid : ((2 ^ (m - j) : ℕ) : ℝ) * ε = δ_j := by
    have hm_split : (1 / 2 : ℝ) ^ m = (1 / 2 : ℝ) ^ (m - j) * (1 / 2 : ℝ) ^ j := by
      rw [← pow_add, Nat.sub_add_cancel (by omega)]
    dsimp [ε, δ_j]
    rw [hm_split, Nat.cast_pow, Nat.cast_ofNat, ← mul_assoc, ← mul_pow]
    norm_num
  have h_one_grid : ((2 ^ m : ℕ) : ℝ) * ε = 1 := by
    dsimp [ε]
    rw [Nat.cast_pow, Nat.cast_ofNat, ← mul_pow]
    norm_num
  have h_16_grid : ((2 ^ (m + 4) : ℕ) : ℝ) * ε = 16 := by
    dsimp [ε]
    rw [Nat.cast_pow, Nat.cast_ofNat, pow_add (2 : ℝ) m 4, mul_right_comm, ← mul_pow]
    norm_num
  have h_eps_lt_delta : ε < δ_j := by
    dsimp [ε, δ_j]
    exact pow_lt_pow_right_of_lt_one₀ (by norm_num) (by norm_num) (by omega)
  have h_grid_ind : ∀ (n : ℕ) (ω : Fin h → Bool),
      let z := stoppedWalk d Q_plus Q_minus ε δ_j R h ω n
      (∃ k : ℕ, 2 ^ (m - j) ≤ k ∧ k ≤ 2 ^ (m + 4) ∧ z.2 = (k : ℝ) * ε) ∧ ‖z.1‖ ≤ R + 1 := by
    intro n ω
    induction n with
    | zero =>
      dsimp [stoppedWalk]
      refine ⟨⟨2 ^ m, ?_, ?_, h_one_grid.symm⟩, ?_⟩
      · exact Nat.pow_le_pow_right (by norm_num) (Nat.sub_le m j)
      · exact Nat.pow_le_pow_right (by norm_num) (Nat.le_add_right m 4)
      · rw [norm_zero]
        linarith
    | succ n ih =>
      obtain ⟨⟨k, hk_lo, hk_hi, hk_eq⟩, h_norm⟩ := ih
      dsimp only [stoppedWalk]
      cases h_act : isWalkActive d δ_j R (stoppedWalk d Q_plus Q_minus ε δ_j R h ω n)
      · simp only [Bool.false_eq_true, ↓reduceIte]
        exact ⟨⟨k, hk_lo, hk_hi, hk_eq⟩, h_norm⟩
      · simp only [↓reduceIte]
        have h_act_prop : δ_j < (stoppedWalk d Q_plus Q_minus ε δ_j R h ω n).2 ∧
            (stoppedWalk d Q_plus Q_minus ε δ_j R h ω n).2 < 16 ∧
            ‖(stoppedWalk d Q_plus Q_minus ε δ_j R h ω n).1‖ < R := by
          unfold isWalkActive at h_act
          exact decide_eq_true_iff.mp h_act
        rcases h_act_prop with ⟨ht_lo, ht_hi, hx_lt⟩
        have hk_gt : 2 ^ (m - j) < k := by
          have h1 : ((2 ^ (m - j) : ℕ) : ℝ) * ε < (k : ℝ) * ε := by
            linarith [h_delta_grid, hk_eq, ht_lo]
          exact Nat.cast_lt.mp (lt_of_mul_lt_mul_right h1 (le_of_lt hε_pos))
        have hk_lt : k < 2 ^ (m + 4) := by
          have h2 : (k : ℝ) * ε < ((2 ^ (m + 4) : ℕ) : ℝ) * ε := by
            linarith [h_16_grid, hk_eq, ht_hi]
          exact Nat.cast_lt.mp (lt_of_mul_lt_mul_right h2 (le_of_lt hε_pos))
        have hQ := h_step (stoppedWalk d Q_plus Q_minus ε δ_j R h ω n).1
          (stoppedWalk d Q_plus Q_minus ε δ_j R h ω n).2
          (le_of_lt hx_lt) (lt_trans h_eps_lt_delta ht_lo) (le_of_lt ht_hi)
        cases walkStepBit h ω n
        · simp only [Bool.false_eq_true, ↓reduceIte]
          have hk_pos : 1 ≤ k := by
            have : 1 ≤ 2 ^ (m - j) := Nat.one_le_two_pow
            omega
          refine ⟨⟨k - 1, by omega, by omega, ?_⟩, ?_⟩
          · rw [hk_eq, Nat.cast_sub hk_pos, Nat.cast_one]
            ring
          · calc ‖(stoppedWalk d Q_plus Q_minus ε δ_j R h ω n).1 -
                ε • Q_minus (stoppedWalk d Q_plus Q_minus ε δ_j R h ω n).1
                  (stoppedWalk d Q_plus Q_minus ε δ_j R h ω n).2 ε‖
              _ ≤ ‖(stoppedWalk d Q_plus Q_minus ε δ_j R h ω n).1‖ +
                  ‖ε • Q_minus (stoppedWalk d Q_plus Q_minus ε δ_j R h ω n).1
                    (stoppedWalk d Q_plus Q_minus ε δ_j R h ω n).2 ε‖ := norm_sub_le _ _
              _ ≤ R + 1 := by linarith [hx_lt, hQ.2]
        · simp only [↓reduceIte]
          refine ⟨⟨k + 1, by omega, by omega, ?_⟩, ?_⟩
          · rw [hk_eq, Nat.cast_add, Nat.cast_one]
            ring
          · calc ‖(stoppedWalk d Q_plus Q_minus ε δ_j R h ω n).1 +
                ε • Q_plus (stoppedWalk d Q_plus Q_minus ε δ_j R h ω n).1
                  (stoppedWalk d Q_plus Q_minus ε δ_j R h ω n).2 ε‖
              _ ≤ ‖(stoppedWalk d Q_plus Q_minus ε δ_j R h ω n).1‖ +
                  ‖ε • Q_plus (stoppedWalk d Q_plus Q_minus ε δ_j R h ω n).1
                    (stoppedWalk d Q_plus Q_minus ε δ_j R h ω n).2 ε‖ := norm_add_le _ _
              _ ≤ R + 1 := by linarith [hx_lt, hQ.1]
  have h_conj1 : ∀ (n : ℕ) (ω : Fin h → Bool),
      let z := stoppedWalk d Q_plus Q_minus ε δ_j R h ω n
      δ_j ≤ z.2 ∧ z.2 ≤ 16 ∧ ‖z.1‖ ≤ R + 1 ∧ (z.2 ≤ δ_j → z.2 = δ_j) := by
    intro n ω
    obtain ⟨⟨k, hk_lo, hk_hi, hk_eq⟩, h_norm⟩ := h_grid_ind n ω
    have hz_lo : δ_j ≤ (stoppedWalk d Q_plus Q_minus ε δ_j R h ω n).2 := by
      rw [hk_eq, ← h_delta_grid]
      exact mul_le_mul_of_nonneg_right (Nat.cast_le.mpr hk_lo) (le_of_lt hε_pos)
    have hz_hi : (stoppedWalk d Q_plus Q_minus ε δ_j R h ω n).2 ≤ 16 := by
      rw [hk_eq, ← h_16_grid]
      exact mul_le_mul_of_nonneg_right (Nat.cast_le.mpr hk_hi) (le_of_lt hε_pos)
    exact ⟨hz_lo, hz_hi, h_norm, fun hle => le_antisymm hle hz_lo⟩
  have h_conj2 : ∀ (k n : ℕ), k ≤ n → n < h → ∀ ω : Fin h → Bool,
      stoppedWalk d Q_plus Q_minus ε δ_j R h (flipBit h n ω) k =
        stoppedWalk d Q_plus Q_minus ε δ_j R h ω k := by
    intro k n hkn hnh ω
    induction k with
    | zero => rfl
    | succ k ih =>
      have hk_le : k ≤ n := by omega
      have hk_lt_h : k < h := by omega
      have hk_ne_n : k ≠ n := by omega
      have h_prev := ih hk_le
      have h_bit : walkStepBit h (flipBit h n ω) k = walkStepBit h ω k := by
        dsimp [walkStepBit, flipBit]
        rw [dif_pos hk_lt_h, dif_pos hk_lt_h, if_neg hk_ne_n]
      dsimp only [stoppedWalk]
      rw [h_prev, h_bit]
  have h_freeze : ∀ (ω : Fin h → Bool) (n p : ℕ), n ≤ p →
      isWalkActive d δ_j R (stoppedWalk d Q_plus Q_minus ε δ_j R h ω n) = false →
      stoppedWalk d Q_plus Q_minus ε δ_j R h ω p =
        stoppedWalk d Q_plus Q_minus ε δ_j R h ω n := by
    intro ω n p hnp h_inact
    induction p, hnp using Nat.le_induction with
    | base => rfl
    | succ p hnp ih =>
      dsimp only [stoppedWalk]
      rw [ih, h_inact]
      rfl
  have h_conj3 : ∀ ω : Fin h → Bool,
      isWalkActive d δ_j R (stoppedWalk d Q_plus Q_minus ε δ_j R h ω h) = true →
      ∀ n < h, isWalkActive d δ_j R (stoppedWalk d Q_plus Q_minus ε δ_j R h ω n) = true := by
    intro ω h_act_h n hnh
    cases h_act_n : isWalkActive d δ_j R (stoppedWalk d Q_plus Q_minus ε δ_j R h ω n)
    · have h_eq := h_freeze ω n h (le_of_lt hnh) h_act_n
      rw [h_eq, h_act_n] at h_act_h
      exact Bool.noConfusion h_act_h
    · rfl
  have h_conj4 : ∀ (N : ℕ), j ≤ N → N + 2 ≤ m → ∀ ω : Fin h → Bool,
      let δ_N := (1 / 2 : ℝ) ^ N
      (stoppedWalk d Q_plus Q_minus ε δ_N R h ω h).2 = δ_N →
      (stoppedWalk d Q_plus Q_minus ε δ_j R h ω h).2 = δ_j := by
    intro N hjN hNm ω δ_N h_reach_N
    have h_delta_le : δ_N ≤ δ_j :=
      pow_le_pow_of_le_one (by norm_num) (by norm_num) hjN
    have h_couple : ∀ n : ℕ,
        stoppedWalk d Q_plus Q_minus ε δ_j R h ω n =
          stoppedWalk d Q_plus Q_minus ε δ_N R h ω n ∨
        (stoppedWalk d Q_plus Q_minus ε δ_j R h ω n).2 = δ_j := by
      intro n
      induction n with
      | zero => exact Or.inl rfl
      | succ n ih =>
        rcases ih with h_eq | h_at_j
        · dsimp only [stoppedWalk]
          cases h_act_j : isWalkActive d δ_j R (stoppedWalk d Q_plus Q_minus ε δ_j R h ω n)
          · simp only [Bool.false_eq_true, ↓reduceIte]
            cases h_act_N : isWalkActive d δ_N R (stoppedWalk d Q_plus Q_minus ε δ_N R h ω n)
            · simp only [Bool.false_eq_true, ↓reduceIte]
              exact Or.inl h_eq
            · have h_act_N_prop : δ_N < (stoppedWalk d Q_plus Q_minus ε δ_N R h ω n).2 ∧
                  (stoppedWalk d Q_plus Q_minus ε δ_N R h ω n).2 < 16 ∧
                  ‖(stoppedWalk d Q_plus Q_minus ε δ_N R h ω n).1‖ < R := by
                unfold isWalkActive at h_act_N
                exact decide_eq_true_iff.mp h_act_N
              have h_inact_j_prop : ¬ (δ_j < (stoppedWalk d Q_plus Q_minus ε δ_j R h ω n).2 ∧
                  (stoppedWalk d Q_plus Q_minus ε δ_j R h ω n).2 < 16 ∧
                  ‖(stoppedWalk d Q_plus Q_minus ε δ_j R h ω n).1‖ < R) := by
                unfold isWalkActive at h_act_j
                exact decide_eq_false_iff_not.mp h_act_j
              rw [← h_eq] at h_act_N_prop
              have h_le_j : (stoppedWalk d Q_plus Q_minus ε δ_j R h ω n).2 ≤ δ_j := by
                by_contra h_not_le
                push_neg at h_not_le
                exact h_inact_j_prop ⟨h_not_le, h_act_N_prop.2.1, h_act_N_prop.2.2⟩
              exact Or.inr ((h_conj1 n ω).2.2.2 h_le_j)
          · have h_act_j_prop : δ_j < (stoppedWalk d Q_plus Q_minus ε δ_j R h ω n).2 ∧
                (stoppedWalk d Q_plus Q_minus ε δ_j R h ω n).2 < 16 ∧
                ‖(stoppedWalk d Q_plus Q_minus ε δ_j R h ω n).1‖ < R := by
              unfold isWalkActive at h_act_j
              exact decide_eq_true_iff.mp h_act_j
            have h_act_N : isWalkActive d δ_N R (stoppedWalk d Q_plus Q_minus ε δ_N R h ω n) = true := by
              unfold isWalkActive
              rw [← h_eq]
              exact decide_eq_true_iff.mpr
                ⟨lt_of_le_of_lt h_delta_le h_act_j_prop.1, h_act_j_prop.2.1, h_act_j_prop.2.2⟩
            rw [h_act_N, h_eq]
            exact Or.inl rfl
        · have h_act_j : isWalkActive d δ_j R (stoppedWalk d Q_plus Q_minus ε δ_j R h ω n) = false := by
            unfold isWalkActive
            apply decide_eq_false_iff_not.mpr
            intro h_all
            linarith [h_all.1, h_at_j]
          dsimp only [stoppedWalk]
          rw [h_act_j]
          simp only [Bool.false_eq_true, ↓reduceIte]
          exact Or.inr h_at_j
    rcases h_couple h with h_eq_h | h_at_j_h
    · have h_le_j : (stoppedWalk d Q_plus Q_minus ε δ_j R h ω h).2 ≤ δ_j := by
        rw [h_eq_h, h_reach_N]
        exact h_delta_le
      exact (h_conj1 h ω).2.2.2 h_le_j
    · exact h_at_j_h
  exact ⟨h_conj1, h_conj2, h_conj3, h_conj4⟩

theorem stoppedWalk_drift_submartingale_and_discrepancy (d : ℕ) (κ H_star : ℝ)
    (v : EuclideanSpace ℝ (Fin (d + 1)) → ℝ)
    (Q_plus Q_minus Q_zero : EuclideanSpace ℝ (Fin d) → ℝ → ℝ → EuclideanSpace ℝ (Fin d))
    (hQ_drift : ∀ (x : EuclideanSpace ℝ (Fin d)) (t ε : ℝ), 0 < ε → ε < t →
      (driftFunctional d κ ε v (mkSpaceTime (x + ε • Q_plus x t ε) (t + ε)) +
        driftFunctional d κ ε v (mkSpaceTime (x - ε • Q_minus x t ε) (t - ε))) / 2 -
        driftFunctional d κ ε v (mkSpaceTime x t) ≥
          (1 / (16 * (1 + Real.log 2))) *
            (‖Q_plus x t ε - Q_zero x t ε‖ ^ 2 + ‖Q_minus x t ε - Q_zero x t ε‖ ^ 2))
    (C_ub : ℝ)
    (hJ_ub : ∀ (B ε : ℝ) (x : EuclideanSpace ℝ (Fin d)) (t : ℝ),
      2 ≤ B → 0 < ε → ε ≤ B → ‖x‖ ≤ B → ε < t → t ≤ B →
      driftFunctional d κ ε v (mkSpaceTime x t) ≤ C_ub * (1 + Real.log B) ^ 4)
    (R U_R D_raw B₀ : ℝ) (hR : 16 ≤ R)
    (hU_R : U_R = C_ub * (1 + Real.log (R + 1)) ^ 4)
    (hD_raw : U_R - H_star + 1 ≤ D_raw)
    (hB₀ : B₀ = D_raw / (1 / (16 * (1 + Real.log 2))))
    (m h j : ℕ) (hj1 : 1 ≤ j) (hjm : j + 2 ≤ m)
    (hJ_init : H_star - 1 ≤ driftFunctional d κ ((1 / 2 : ℝ) ^ m) v (mkSpaceTime 0 1))
    (h_inv : ∀ (n : ℕ) (ω : Fin h → Bool),
      let z := stoppedWalk d Q_plus Q_minus ((1 / 2 : ℝ) ^ m) ((1 / 2 : ℝ) ^ j) R h ω n
      (1 / 2 : ℝ) ^ j ≤ z.2 ∧ z.2 ≤ 16 ∧ ‖z.1‖ ≤ R + 1)
    (h_flip : ∀ (n : ℕ), n < h → ∀ ω : Fin h → Bool,
      stoppedWalk d Q_plus Q_minus ((1 / 2 : ℝ) ^ m) ((1 / 2 : ℝ) ^ j) R h (flipBit h n ω) n =
        stoppedWalk d Q_plus Q_minus ((1 / 2 : ℝ) ^ m) ((1 / 2 : ℝ) ^ j) R h ω n) :
    let ε := (1 / 2 : ℝ) ^ m
    let δ_j := (1 / 2 : ℝ) ^ j
    uniformExp h (fun ω => ∑ n ∈ Finset.range h,
      let z := stoppedWalk d Q_plus Q_minus ε δ_j R h ω n
      if isWalkActive d δ_j R z then
        (‖Q_plus z.1 z.2 ε - Q_zero z.1 z.2 ε‖ ^ 2 +
         ‖Q_minus z.1 z.2 ε - Q_zero z.1 z.2 ε‖ ^ 2)
      else 0) ≤ B₀ ∧
    (∀ ω : Fin h → Bool,
      let z_h := stoppedWalk d Q_plus Q_minus ε δ_j R h ω h
      0 ≤ U_R - driftFunctional d κ ε v (mkSpaceTime z_h.1 z_h.2)) ∧
    uniformExp h (fun ω =>
      let z_h := stoppedWalk d Q_plus Q_minus ε δ_j R h ω h
      U_R - driftFunctional d κ ε v (mkSpaceTime z_h.1 z_h.2)) ≤ D_raw :=
by
  let ε : ℝ := (1 / 2 : ℝ) ^ m
  let δ_j : ℝ := (1 / 2 : ℝ) ^ j
  let c : ℝ := 1 / (16 * (1 + Real.log 2))
  let z : ℕ → (Fin h → Bool) → EuclideanSpace ℝ (Fin d) × ℝ :=
    fun n ω => stoppedWalk d Q_plus Q_minus ε δ_j R h ω n
  let J : ℕ → (Fin h → Bool) → ℝ :=
    fun n ω => driftFunctional d κ ε v (mkSpaceTime (z n ω).1 (z n ω).2)
  let D : ℕ → (Fin h → Bool) → ℝ :=
    fun n ω =>
      if isWalkActive d δ_j R (z n ω) then
        (‖Q_plus (z n ω).1 (z n ω).2 ε - Q_zero (z n ω).1 (z n ω).2 ε‖ ^ 2 +
         ‖Q_minus (z n ω).1 (z n ω).2 ε - Q_zero (z n ω).1 (z n ω).2 ε‖ ^ 2)
      else 0
  have hε_pos : 0 < ε := by positivity
  have hε_lt_δ : ε < δ_j :=
    pow_lt_pow_right_of_lt_one₀ (by norm_num) (by norm_num) (by omega)
  have hδ_le_one : δ_j ≤ 1 := pow_le_one₀ (by norm_num) (by norm_num)
  have hlog2_pos : 0 < Real.log 2 := Real.log_pos (by norm_num)
  have hc_pos : 0 < c := by dsimp [c]; positivity
  have h_card : (∑ _ : Fin h → Bool, (1 : ℝ)) = (2 : ℝ) ^ h := by
    simp [Finset.sum_const, Finset.card_univ, Fintype.card_fun, Fintype.card_bool, Fintype.card_fin]
  have h_two_pow_pos : (0 : ℝ) < (2 : ℝ) ^ h := by positivity
  have h_flip_invol : ∀ n : ℕ, Function.Involutive (flipBit h n) := by
    intro n ω
    ext i
    dsimp [flipBit]
    split_ifs <;> simp
  have h_sum_flip : ∀ (n : ℕ) (F : (Fin h → Bool) → ℝ),
      (∑ ω : Fin h → Bool, F (flipBit h n ω)) = ∑ ω : Fin h → Bool, F ω := by
    intro n F
    exact Fintype.sum_bijective (flipBit h n) (h_flip_invol n).bijective
      (fun ω => F (flipBit h n ω)) F (fun _ => rfl)
  have h_bit_flip_eq : ∀ (n : ℕ), n < h → ∀ (ω : Fin h → Bool),
      walkStepBit h (flipBit h n ω) n = !(walkStepBit h ω n) := by
    intro n hn ω
    dsimp [walkStepBit, flipBit]
    rw [dif_pos hn, dif_pos hn, if_pos rfl]
  have h_J_pair : ∀ n < h, ∀ ω : Fin h → Bool,
      2 * (c * D n ω) ≤ J (n + 1) ω + J (n + 1) (flipBit h n ω) - 2 * J n ω := by
    intro n hn ω
    have hz_flip : z n (flipBit h n ω) = z n ω := h_flip n hn ω
    have hz1 : z (n + 1) ω =
        if isWalkActive d δ_j R (z n ω) then
          if walkStepBit h ω n then
            ((z n ω).1 + ε • Q_plus (z n ω).1 (z n ω).2 ε, (z n ω).2 + ε)
          else
            ((z n ω).1 - ε • Q_minus (z n ω).1 (z n ω).2 ε, (z n ω).2 - ε)
        else z n ω := rfl
    have hz2 : z (n + 1) (flipBit h n ω) =
        if isWalkActive d δ_j R (z n ω) then
          if !(walkStepBit h ω n) then
            ((z n ω).1 + ε • Q_plus (z n ω).1 (z n ω).2 ε, (z n ω).2 + ε)
          else
            ((z n ω).1 - ε • Q_minus (z n ω).1 (z n ω).2 ε, (z n ω).2 - ε)
        else z n ω := by
      change (if isWalkActive d δ_j R (z n (flipBit h n ω)) then
          if walkStepBit h (flipBit h n ω) n then
            ((z n (flipBit h n ω)).1 + ε • Q_plus (z n (flipBit h n ω)).1 (z n (flipBit h n ω)).2 ε,
             (z n (flipBit h n ω)).2 + ε)
          else
            ((z n (flipBit h n ω)).1 - ε • Q_minus (z n (flipBit h n ω)).1 (z n (flipBit h n ω)).2 ε,
             (z n (flipBit h n ω)).2 - ε)
        else z n (flipBit h n ω)) = _
      rw [hz_flip, h_bit_flip_eq n hn ω]
    dsimp only [J, D]
    rw [hz1, hz2]
    cases h_act : isWalkActive d δ_j R (z n ω)
    · simp; linarith
    · simp only [↓reduceIte]
      have h_t_ge : δ_j ≤ (z n ω).2 := (h_inv n ω).1
      have hε_lt_t : ε < (z n ω).2 := lt_of_lt_of_le hε_lt_δ h_t_ge
      have h_drift := hQ_drift (z n ω).1 (z n ω).2 ε hε_pos hε_lt_t
      cases h_bit : walkStepBit h ω n <;>
        simp only [h_bit, Bool.not_true, Bool.not_false, Bool.false_eq_true, ↓reduceIte] <;>
        linarith
  have h_J_sum_step : ∀ n < h,
      c * (∑ ω, D n ω) ≤ (∑ ω, J (n + 1) ω) - (∑ ω, J n ω) := by
    intro n hn
    have h1 := Finset.sum_le_sum (fun ω (_ : ω ∈ Finset.univ) => h_J_pair n hn ω)
    rw [← Finset.mul_sum, ← Finset.mul_sum, Finset.sum_sub_distrib, Finset.sum_add_distrib,
        h_sum_flip n (fun ω => J (n + 1) ω), ← Finset.mul_sum] at h1
    linarith
  have h_disc_tele : c * (∑ ω, ∑ n ∈ Finset.range h, D n ω) ≤
      (∑ ω, J h ω) - (∑ ω, J 0 ω) := by
    rw [Finset.sum_comm, Finset.mul_sum]
    have h1 := Finset.sum_le_sum (fun n (hn : n ∈ Finset.range h) =>
      h_J_sum_step n (Finset.mem_range.mp hn))
    rw [Finset.sum_range_sub (fun n => ∑ ω, J n ω) h] at h1
    exact h1
  have h_J0_sum : (H_star - 1) * (2 : ℝ) ^ h ≤ ∑ ω : Fin h → Bool, J 0 ω := by
    have h_eq : (∑ ω : Fin h → Bool, J 0 ω) =
        driftFunctional d κ ε v (mkSpaceTime 0 1) * (2 : ℝ) ^ h := by
      calc (∑ ω : Fin h → Bool, J 0 ω)
        _ = ∑ _ : Fin h → Bool, driftFunctional d κ ε v (mkSpaceTime 0 1) := rfl
        _ = (∑ _ : Fin h → Bool, (1 : ℝ)) * driftFunctional d κ ε v (mkSpaceTime 0 1) := by
            rw [Finset.sum_mul, one_mul]
        _ = driftFunctional d κ ε v (mkSpaceTime 0 1) * (2 : ℝ) ^ h := by
            rw [h_card, mul_comm]
    rw [h_eq]
    exact mul_le_mul_of_nonneg_right hJ_init (le_of_lt h_two_pow_pos)
  have h_D_nonneg : 0 ≤ ∑ ω : Fin h → Bool, ∑ n ∈ Finset.range h, D n ω := by
    apply Finset.sum_nonneg
    intro ω _
    apply Finset.sum_nonneg
    intro n _
    dsimp [D]
    split_ifs <;> positivity
  have h_Jh_le : ∀ ω : Fin h → Bool, J h ω ≤ U_R := by
    intro ω
    have h_inv_h := h_inv h ω
    have hB_ge : (2 : ℝ) ≤ R + 1 := by linarith
    have hε_le_B : ε ≤ R + 1 := by linarith
    have hx_le_B : ‖(z h ω).1‖ ≤ R + 1 := h_inv_h.2.2
    have hε_lt_th : ε < (z h ω).2 := lt_of_lt_of_le hε_lt_δ h_inv_h.1
    have hth_le_B : (z h ω).2 ≤ R + 1 := by linarith [h_inv_h.2.1]
    have h_ub := hJ_ub (R + 1) ε (z h ω).1 (z h ω).2 hB_ge hε_pos hε_le_B hx_le_B hε_lt_th hth_le_B
    linarith [hU_R]
  have h_Jh_sum_le : (∑ ω : Fin h → Bool, J h ω) ≤ U_R * (2 : ℝ) ^ h := by
    calc (∑ ω : Fin h → Bool, J h ω)
      _ ≤ ∑ _ : Fin h → Bool, U_R := Finset.sum_le_sum (fun ω _ => h_Jh_le ω)
      _ = (∑ _ : Fin h → Bool, (1 : ℝ)) * U_R := by rw [Finset.sum_mul, one_mul]
      _ = U_R * (2 : ℝ) ^ h := by rw [h_card, mul_comm]
  have h_raw_pow : (U_R - H_star + 1) * (2 : ℝ) ^ h ≤ D_raw * (2 : ℝ) ^ h :=
    mul_le_mul_of_nonneg_right hD_raw (le_of_lt h_two_pow_pos)
  refine ⟨?_, ?_, ?_⟩
  · dsimp [uniformExp]
    have h_c_sum : c * (∑ ω, ∑ n ∈ Finset.range h, D n ω) ≤ D_raw * (2 : ℝ) ^ h := by
      linarith
    have h_sum_le : (∑ ω, ∑ n ∈ Finset.range h, D n ω) ≤ B₀ * (2 : ℝ) ^ h := by
      rw [hB₀, div_mul_eq_mul_div, le_div_iff₀ hc_pos]
      linarith
    exact (div_le_iff₀ h_two_pow_pos).mpr h_sum_le
  · intro ω
    linarith [h_Jh_le ω]
  · dsimp [uniformExp]
    rw [div_le_iff₀ h_two_pow_pos]
    have h_sub_sum : (∑ ω : Fin h → Bool, (U_R - J h ω)) =
        U_R * (2 : ℝ) ^ h - ∑ ω : Fin h → Bool, J h ω := by
      rw [Finset.sum_sub_distrib]
      have h_const : (∑ _ : Fin h → Bool, U_R) = U_R * (2 : ℝ) ^ h := by
        calc (∑ _ : Fin h → Bool, U_R)
          _ = (∑ _ : Fin h → Bool, (1 : ℝ)) * U_R := by rw [Finset.sum_mul, one_mul]
          _ = U_R * (2 : ℝ) ^ h := by rw [h_card, mul_comm]
      rw [h_const]
    have h_disc_nonneg : 0 ≤ c * (∑ ω, ∑ n ∈ Finset.range h, D n ω) :=
      mul_nonneg (le_of_lt hc_pos) h_D_nonneg
    linarith

theorem stoppedWalk_reach_prob_ge_three_quarters (d : ℕ) (C₁ : ℝ)
    (v : EuclideanSpace ℝ (Fin (d + 1)) → ℝ)
    (hv_cent : IsCenteredAt d C₁ v 0 1)
    (Q_plus Q_minus Q_zero : EuclideanSpace ℝ (Fin d) → ℝ → ℝ → EuclideanSpace ℝ (Fin d))
    (C_vel : ℝ) (hC_vel : 0 < C_vel)
    (hQ_vel : ∀ (r : ℝ) (x₀ : EuclideanSpace ℝ (Fin d)) (p₀ : EuclideanSpace ℝ (Fin d)) (a₀ : ℝ),
      0 < r → IsFitAt d C₁ v x₀ r r p₀ a₀ →
      ∀ (K ε : ℝ) (x : EuclideanSpace ℝ (Fin d)) (t : ℝ),
        2 ≤ K → 0 < ε → ε ≤ r → ε < t → t ≤ K * r →
        ‖x - x₀ - (t - r) • p₀‖ ≤ K * r →
        ‖Q_zero x t ε - p₀‖ ≤ C_vel * (1 + Real.log K + |Real.log (t / r)|))
    (h_psi : HasPsiPotentialBounds)
    (h_travel : HasPredictableTravelBound d)
    (R B₀ : ℝ) (hR : 16 ≤ R) (hB₀ : 0 < B₀)
    (h_R_bound : Real.sqrt (psiPotential 16) *
      (2 * (C_vel * (1 + Real.log R) + C_vel) + Real.sqrt (2 * B₀)) ≤ R / 8)
    (m h N : ℕ) (hN1 : 1 ≤ N) (hNm : N + 2 ≤ m)
    (h_horizon : 32 * psiPotential 16 + 1 ≤ (h : ℝ) * ((1 / 2 : ℝ) ^ m) ^ 2)
    (h_inv : ∀ (n : ℕ) (ω : Fin h → Bool),
      let z := stoppedWalk d Q_plus Q_minus ((1 / 2 : ℝ) ^ m) ((1 / 2 : ℝ) ^ N) R h ω n
      (1 / 2 : ℝ) ^ N ≤ z.2 ∧ z.2 ≤ 16 ∧ ‖z.1‖ ≤ R + 1 ∧
      (z.2 ≤ (1 / 2 : ℝ) ^ N → z.2 = (1 / 2 : ℝ) ^ N))
    (h_flip : ∀ (k n : ℕ), k ≤ n → n < h → ∀ ω : Fin h → Bool,
      stoppedWalk d Q_plus Q_minus ((1 / 2 : ℝ) ^ m) ((1 / 2 : ℝ) ^ N) R h (flipBit h n ω) k =
        stoppedWalk d Q_plus Q_minus ((1 / 2 : ℝ) ^ m) ((1 / 2 : ℝ) ^ N) R h ω k)
    (h_act_pers : ∀ ω : Fin h → Bool,
      isWalkActive d ((1 / 2 : ℝ) ^ N) R
        (stoppedWalk d Q_plus Q_minus ((1 / 2 : ℝ) ^ m) ((1 / 2 : ℝ) ^ N) R h ω h) = true →
      ∀ n < h, isWalkActive d ((1 / 2 : ℝ) ^ N) R
        (stoppedWalk d Q_plus Q_minus ((1 / 2 : ℝ) ^ m) ((1 / 2 : ℝ) ^ N) R h ω n) = true)
    (h_disc : uniformExp h (fun ω => ∑ n ∈ Finset.range h,
      let z := stoppedWalk d Q_plus Q_minus ((1 / 2 : ℝ) ^ m) ((1 / 2 : ℝ) ^ N) R h ω n
      if isWalkActive d ((1 / 2 : ℝ) ^ N) R z then
        (‖Q_plus z.1 z.2 ((1 / 2 : ℝ) ^ m) - Q_zero z.1 z.2 ((1 / 2 : ℝ) ^ m)‖ ^ 2 +
         ‖Q_minus z.1 z.2 ((1 / 2 : ℝ) ^ m) - Q_zero z.1 z.2 ((1 / 2 : ℝ) ^ m)‖ ^ 2)
      else 0) ≤ B₀) :
    let ε := (1 / 2 : ℝ) ^ m
    let δ_N := (1 / 2 : ℝ) ^ N
    uniformProb h (fun ω => (stoppedWalk d Q_plus Q_minus ε δ_N R h ω h).2 = δ_N) ≥ 3 / 4 :=
by
  classical
  dsimp only
  let ε : ℝ := (1 / 2 : ℝ) ^ m
  let δ_N : ℝ := (1 / 2 : ℝ) ^ N
  let M_vel : ℝ := C_vel * (1 + Real.log R)
  have hε_pos : 0 < ε := by positivity
  have hδ_pos : 0 < δ_N := by positivity
  have hS_max : (2 : ℝ) ≤ 16 := by norm_num
  have h1_le_R : (1 : ℝ) ≤ R := by linarith
  have h_logR_nonneg : 0 ≤ Real.log R := Real.log_nonneg h1_le_R
  have hC_vel_nonneg : 0 ≤ C_vel := le_of_lt hC_vel
  have hM_vel_nonneg : 0 ≤ M_vel := by
    dsimp [M_vel]
    exact mul_nonneg hC_vel_nonneg (by linarith)
  have hB₀_nonneg : 0 ≤ B₀ := le_of_lt hB₀
  have hε_le_one : ε ≤ 1 := by
    dsimp [ε]
    exact pow_le_one₀ (by norm_num) (by norm_num)
  have h4ε_le_δ : 4 * ε ≤ δ_N := by
    have h_pow : ((1 / 2 : ℝ) ^ m) ≤ (1 / 2 : ℝ) ^ (N + 2) :=
