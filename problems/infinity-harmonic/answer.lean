    have h_iso_u2 : ‖(2 * K) • u₂‖ ≤ 2 * K * D := by
      rw [norm_smul, Real.norm_eq_abs, abs_of_pos (by positivity : 0 < 2 * K)]
      exact mul_le_mul_of_nonneg_left hu₂_le (by positivity)
    have h_iso_u3 : ‖(2 * K) • u₃‖ ≤ 2 * K * D := by
      rw [norm_smul, Real.norm_eq_abs, abs_of_pos (by positivity : 0 < 2 * K)]
      exact mul_le_mul_of_nonneg_left hu₃_le (by positivity)
    have h_2CQ_D : 2 * C_Q * D =
        4 * α' * ‖e_hat‖ ^ 2 * D + 4 * β' * (1 + ‖e_hat‖ ^ 2) ^ 2 * D + 4 * γ' * D + 2 * K * D := by
      dsimp [C_Q]
      ring
    have h_extra1 : 0 ≤ α' * ‖e_hat‖ ^ 2 * D := by positivity
    have h_extra2 : 0 ≤ β' * (1 + ‖e_hat‖ ^ 2) ^ 2 * D := by positivity
    have h_extra3 : 0 ≤ γ' * D := by positivity
    refine ⟨?_, ?_, ?_⟩
    · change ‖((-2 * α' * inner ℝ e_hat (u₁ - u₂)) • e_hat +
          (2 * β') • P_perp (P_perp (u₁ - u₂)) -
          γ' • (u₃ - (1 / 2 : ℝ) • (u₁ + u₂)) +
          (2 * K) • u₁)‖ ≤ 2 * C_Q * D
      have h_tri1 := norm_add_le
        ((-2 * α' * inner ℝ e_hat (u₁ - u₂)) • e_hat +
          (2 * β') • P_perp (P_perp (u₁ - u₂)) -
          γ' • (u₃ - (1 / 2 : ℝ) • (u₁ + u₂)))
        ((2 * K) • u₁)
      have h_tri2 := norm_sub_le
        ((-2 * α' * inner ℝ e_hat (u₁ - u₂)) • e_hat +
          (2 * β') • P_perp (P_perp (u₁ - u₂)))
        (γ' • (u₃ - (1 / 2 : ℝ) • (u₁ + u₂)))
      have h_tri3 := norm_add_le
        ((-2 * α' * inner ℝ e_hat (u₁ - u₂)) • e_hat)
        ((2 * β') • P_perp (P_perp (u₁ - u₂)))
      linarith
    · change ‖((2 * α' * inner ℝ e_hat (u₁ - u₂)) • e_hat -
          (2 * β') • P_perp (P_perp (u₁ - u₂)) -
          γ' • (u₃ - (1 / 2 : ℝ) • (u₁ + u₂)) +
          (2 * K) • u₂)‖ ≤ 2 * C_Q * D
      have h_tri1 := norm_add_le
        ((2 * α' * inner ℝ e_hat (u₁ - u₂)) • e_hat -
          (2 * β') • P_perp (P_perp (u₁ - u₂)) -
          γ' • (u₃ - (1 / 2 : ℝ) • (u₁ + u₂)))
        ((2 * K) • u₂)
      have h_tri2 := norm_sub_le
        ((2 * α' * inner ℝ e_hat (u₁ - u₂)) • e_hat -
          (2 * β') • P_perp (P_perp (u₁ - u₂)))
        (γ' • (u₃ - (1 / 2 : ℝ) • (u₁ + u₂)))
      have h_tri3 := norm_sub_le
        ((2 * α' * inner ℝ e_hat (u₁ - u₂)) • e_hat)
        ((2 * β') • P_perp (P_perp (u₁ - u₂)))
      linarith
    · change ‖(2 * γ') • (u₃ - (1 / 2 : ℝ) • (u₁ + u₂)) + (2 * K) • u₃‖ ≤ 2 * C_Q * D
      have h_tri1 := norm_add_le
        ((2 * γ') • (u₃ - (1 / 2 : ℝ) • (u₁ + u₂)))
        ((2 * K) • u₃)
      linarith
  have h_lip : ∀ x₁ x₂ x₃ y₁ y₂ y₃ : EuclideanSpace ℝ (Fin (d + 1)),
      ‖threePointQuadGrad₁ e_hat α' β' γ' K x₁ x₂ x₃ -
        threePointQuadGrad₁ e_hat α' β' γ' K y₁ y₂ y₃‖ ≤
        2 * C_Q * (‖x₁ - y₁‖ + ‖x₂ - y₂‖ + ‖x₃ - y₃‖) ∧
      ‖threePointQuadGrad₂ e_hat α' β' γ' K x₁ x₂ x₃ -
        threePointQuadGrad₂ e_hat α' β' γ' K y₁ y₂ y₃‖ ≤
        2 * C_Q * (‖x₁ - y₁‖ + ‖x₂ - y₂‖ + ‖x₃ - y₃‖) ∧
      ‖threePointQuadGrad₃ γ' K x₁ x₂ x₃ -
        threePointQuadGrad₃ γ' K y₁ y₂ y₃‖ ≤
        2 * C_Q * (‖x₁ - y₁‖ + ‖x₂ - y₂‖ + ‖x₃ - y₃‖) := by
    intro x₁ x₂ x₃ y₁ y₂ y₃
    let u₁ := x₁ - y₁
    let u₂ := x₂ - y₂
    let u₃ := x₃ - y₃
    have h_diff_xy : (x₁ - x₂) - (y₁ - y₂) = u₁ - u₂ := by
      dsimp [u₁, u₂]
      module
    have h_P2_diff : P_perp (P_perp (x₁ - x₂)) - P_perp (P_perp (y₁ - y₂)) =
        P_perp (P_perp (u₁ - u₂)) := by
      rw [← hP_sub, ← hP_sub, h_diff_xy]
    have h_in_diff : inner ℝ e_hat (x₁ - x₂) - inner ℝ e_hat (y₁ - y₂) =
        inner ℝ e_hat (u₁ - u₂) := by
      rw [← inner_sub_right, h_diff_xy]
    have hg₁_sub : threePointQuadGrad₁ e_hat α' β' γ' K x₁ x₂ x₃ -
        threePointQuadGrad₁ e_hat α' β' γ' K y₁ y₂ y₃ =
        threePointQuadGrad₁ e_hat α' β' γ' K u₁ u₂ u₃ := by
      change ((-2 * α' * inner ℝ e_hat (x₁ - x₂)) • e_hat +
          (2 * β') • P_perp (P_perp (x₁ - x₂)) -
          γ' • (x₃ - (1 / 2 : ℝ) • (x₁ + x₂)) +
          (2 * K) • x₁) -
        ((-2 * α' * inner ℝ e_hat (y₁ - y₂)) • e_hat +
          (2 * β') • P_perp (P_perp (y₁ - y₂)) -
          γ' • (y₃ - (1 / 2 : ℝ) • (y₁ + y₂)) +
          (2 * K) • y₁) =
        (-2 * α' * inner ℝ e_hat (u₁ - u₂)) • e_hat +
          (2 * β') • P_perp (P_perp (u₁ - u₂)) -
          γ' • (u₃ - (1 / 2 : ℝ) • (u₁ + u₂)) +
          (2 * K) • u₁
      rw [← h_P2_diff, ← h_in_diff]
      dsimp [u₁, u₂, u₃]
      module
    have hg₂_sub : threePointQuadGrad₂ e_hat α' β' γ' K x₁ x₂ x₃ -
        threePointQuadGrad₂ e_hat α' β' γ' K y₁ y₂ y₃ =
        threePointQuadGrad₂ e_hat α' β' γ' K u₁ u₂ u₃ := by
      change ((2 * α' * inner ℝ e_hat (x₁ - x₂)) • e_hat -
          (2 * β') • P_perp (P_perp (x₁ - x₂)) -
          γ' • (x₃ - (1 / 2 : ℝ) • (x₁ + x₂)) +
          (2 * K) • x₂) -
        ((2 * α' * inner ℝ e_hat (y₁ - y₂)) • e_hat -
          (2 * β') • P_perp (P_perp (y₁ - y₂)) -
          γ' • (y₃ - (1 / 2 : ℝ) • (y₁ + y₂)) +
          (2 * K) • y₂) =
        (2 * α' * inner ℝ e_hat (u₁ - u₂)) • e_hat -
          (2 * β') • P_perp (P_perp (u₁ - u₂)) -
          γ' • (u₃ - (1 / 2 : ℝ) • (u₁ + u₂)) +
          (2 * K) • u₂
      rw [← h_P2_diff, ← h_in_diff]
      dsimp [u₁, u₂, u₃]
      module
    have hg₃_sub : threePointQuadGrad₃ γ' K x₁ x₂ x₃ -
        threePointQuadGrad₃ γ' K y₁ y₂ y₃ =
        threePointQuadGrad₃ γ' K u₁ u₂ u₃ := by
      dsimp [threePointQuadGrad₃, u₁, u₂, u₃]
      module
    rw [hg₁_sub, hg₂_sub, hg₃_sub]
    exact h_grad_norm u₁ u₂ u₃
  exact ⟨hC_Q_pos, h_taylor, h_quad, h_lip⟩

theorem jensen_perturbed_maximizer_on_full_measure (d : ℕ)
    (lam r α' β' γ' K' η δ C_Q : ℝ)
    (e_hat : EuclideanSpace ℝ (Fin (d + 1)))
    (u_hat₁ u_hat₂ u_hat₃ : EuclideanSpace ℝ (Fin (d + 1)) → ℝ)
    (N₁ N₂ N₃ : Set (EuclideanSpace ℝ (Fin (d + 1))))
    (hlam : 0 < lam) (hr : 0 < r) (hη : 0 < η) (hδ : 0 < δ) (hδ_lt : δ < r) (hC_Q : 0 < C_Q)
    (hu₁0 : u_hat₁ 0 = 0) (hu₂0 : u_hat₂ 0 = 0) (hu₃0 : u_hat₃ 0 = 0)
    (hconv₁ : ConvexOn ℝ Set.univ (fun ξ => u_hat₁ ξ + (lam / 2) * ‖ξ‖ ^ 2))
    (hconv₂ : ConvexOn ℝ Set.univ (fun ξ => u_hat₂ ξ + (lam / 2) * ‖ξ‖ ^ 2))
    (hconv₃ : ConvexOn ℝ Set.univ (fun ξ => u_hat₃ ξ + (lam / 2) * ‖ξ‖ ^ 2))
    (hsum : ∀ ξ₁ ∈ Metric.closedBall (0 : EuclideanSpace ℝ (Fin (d + 1))) r,
      ∀ ξ₂ ∈ Metric.closedBall (0 : EuclideanSpace ℝ (Fin (d + 1))) r,
        ∀ ξ₃ ∈ Metric.closedBall (0 : EuclideanSpace ℝ (Fin (d + 1))) r,
          u_hat₁ ξ₁ + u_hat₂ ξ₂ + u_hat₃ ξ₃ ≤
            threePointQuadForm e_hat α' β' γ' K' ξ₁ ξ₂ ξ₃)
    (h_taylor : ∀ x₁ x₂ x₃ h₁ h₂ h₃ : EuclideanSpace ℝ (Fin (d + 1)),
      threePointQuadForm e_hat α' β' γ' (K' + η) (x₁ + h₁) (x₂ + h₂) (x₃ + h₃) -
        threePointQuadForm e_hat α' β' γ' (K' + η) x₁ x₂ x₃ =
        inner ℝ (threePointQuadGrad₁ e_hat α' β' γ' (K' + η) x₁ x₂ x₃) h₁ +
        inner ℝ (threePointQuadGrad₂ e_hat α' β' γ' (K' + η) x₁ x₂ x₃) h₂ +
        inner ℝ (threePointQuadGrad₃ γ' (K' + η) x₁ x₂ x₃) h₃ +
        threePointQuadForm e_hat α' β' γ' (K' + η) h₁ h₂ h₃)
    (h_quad : ∀ h₁ h₂ h₃ : EuclideanSpace ℝ (Fin (d + 1)),
      |threePointQuadForm e_hat α' β' γ' (K' + η) h₁ h₂ h₃| ≤
        C_Q * (‖h₁‖ ^ 2 + ‖h₂‖ ^ 2 + ‖h₃‖ ^ 2))
    (h_lip : ∀ x₁ x₂ x₃ y₁ y₂ y₃ : EuclideanSpace ℝ (Fin (d + 1)),
      ‖threePointQuadGrad₁ e_hat α' β' γ' (K' + η) x₁ x₂ x₃ -
        threePointQuadGrad₁ e_hat α' β' γ' (K' + η) y₁ y₂ y₃‖ ≤
        2 * C_Q * (‖x₁ - y₁‖ + ‖x₂ - y₂‖ + ‖x₃ - y₃‖) ∧
      ‖threePointQuadGrad₂ e_hat α' β' γ' (K' + η) x₁ x₂ x₃ -
        threePointQuadGrad₂ e_hat α' β' γ' (K' + η) y₁ y₂ y₃‖ ≤
        2 * C_Q * (‖x₁ - y₁‖ + ‖x₂ - y₂‖ + ‖x₃ - y₃‖) ∧
      ‖threePointQuadGrad₃ γ' (K' + η) x₁ x₂ x₃ -
        threePointQuadGrad₃ γ' (K' + η) y₁ y₂ y₃‖ ≤
        2 * C_Q * (‖x₁ - y₁‖ + ‖x₂ - y₂‖ + ‖x₃ - y₃‖))
    (hN₁ : MeasureTheory.volume N₁ = 0)
    (hN₂ : MeasureTheory.volume N₂ = 0)
    (hN₃ : MeasureTheory.volume N₃ = 0) :
    ∃ (ξ_bar₁ ξ_bar₂ ξ_bar₃ v₁ v₂ v₃ : EuclideanSpace ℝ (Fin (d + 1))),
      ξ_bar₁ ∈ Metric.ball (0 : EuclideanSpace ℝ (Fin (d + 1))) δ ∧
      ξ_bar₂ ∈ Metric.ball (0 : EuclideanSpace ℝ (Fin (d + 1))) δ ∧
      ξ_bar₃ ∈ Metric.ball (0 : EuclideanSpace ℝ (Fin (d + 1))) δ ∧
      v₁ ∈ Metric.closedBall (0 : EuclideanSpace ℝ (Fin (d + 1))) (η * δ / 4) ∧
      v₂ ∈ Metric.closedBall (0 : EuclideanSpace ℝ (Fin (d + 1))) (η * δ / 4) ∧
      v₃ ∈ Metric.closedBall (0 : EuclideanSpace ℝ (Fin (d + 1))) (η * δ / 4) ∧
      ξ_bar₁ ∉ N₁ ∧ ξ_bar₂ ∉ N₂ ∧ ξ_bar₃ ∉ N₃ ∧
      ∀ ξ₁ ∈ Metric.closedBall (0 : EuclideanSpace ℝ (Fin (d + 1))) δ,
        ∀ ξ₂ ∈ Metric.closedBall (0 : EuclideanSpace ℝ (Fin (d + 1))) δ,
          ∀ ξ₃ ∈ Metric.closedBall (0 : EuclideanSpace ℝ (Fin (d + 1))) δ,
            (u_hat₁ ξ₁ + inner ℝ v₁ ξ₁) +
              (u_hat₂ ξ₂ + inner ℝ v₂ ξ₂) +
              (u_hat₃ ξ₃ + inner ℝ v₃ ξ₃) -
              threePointQuadForm e_hat α' β' γ' (K' + η) ξ₁ ξ₂ ξ₃ ≤
            (u_hat₁ ξ_bar₁ + inner ℝ v₁ ξ_bar₁) +
              (u_hat₂ ξ_bar₂ + inner ℝ v₂ ξ_bar₂) +
              (u_hat₃ ξ_bar₃ + inner ℝ v₃ ξ_bar₃) -
              threePointQuadForm e_hat α' β' γ' (K' + η) ξ_bar₁ ξ_bar₂ ξ_bar₃ :=
by
  let E := EuclideanSpace ℝ (Fin (d + 1))
  let E3 := Fin 3 → E
  have h_s4 : MeasureTheory.volume {ξ : E3 | ξ 0 ∈ N₁ ∨ ξ 1 ∈ N₂ ∨ ξ 2 ∈ N₃} = 0 := by
    let C₀ : Set E3 := Set.univ.pi (fun i : Fin 3 => if i = 0 then N₁ else Set.univ)
    let C₁ : Set E3 := Set.univ.pi (fun i : Fin 3 => if i = 1 then N₂ else Set.univ)
    let C₂ : Set E3 := Set.univ.pi (fun i : Fin 3 => if i = 2 then N₃ else Set.univ)
    have hC₀ : MeasureTheory.volume C₀ = 0 := by
      dsimp [C₀]
      rw [MeasureTheory.volume_pi_pi, Fin.prod_univ_three]
      simp [hN₁]
    have hC₁ : MeasureTheory.volume C₁ = 0 := by
      dsimp [C₁]
      rw [MeasureTheory.volume_pi_pi, Fin.prod_univ_three]
      simp [hN₂]
    have hC₂ : MeasureTheory.volume C₂ = 0 := by
      dsimp [C₂]
      rw [MeasureTheory.volume_pi_pi, Fin.prod_univ_three]
      simp [hN₃]
    have h_sub : {ξ : E3 | ξ 0 ∈ N₁ ∨ ξ 1 ∈ N₂ ∨ ξ 2 ∈ N₃} ⊆ (C₀ ∪ C₁) ∪ C₂ := by
      intro ξ hξ
      rcases hξ with h0 | h1 | h2
      · left; left
        intro i _
        dsimp
        split_ifs with hi
        · subst hi; exact h0
        · trivial
      · left; right
        intro i _
        dsimp
        split_ifs with hi
        · subst hi; exact h1
        · trivial
      · right
        intro i _
        dsimp
        split_ifs with hi
        · subst hi; exact h2
        · trivial
    exact MeasureTheory.measure_mono_null h_sub
      (MeasureTheory.measure_union_null (MeasureTheory.measure_union_null hC₀ hC₁) hC₂)
  have h_s3 : ∀ (r_v Λ : ℝ), 0 < r_v → 0 < Λ → ∀ (F : E3 → E3),
      (∀ v ∈ Metric.closedBall (0 : E3) r_v, ∀ v' ∈ Metric.closedBall (0 : E3) r_v,
        ‖v - v'‖ ≤ Λ * ‖F v - F v'‖) →
      MeasureTheory.volume (F '' Metric.closedBall (0 : E3) r_v) ≠ 0 := by
    intro r_v Λ hr_v hΛ F h_rev hK_zero
    letI : SMul ℝ (Set E3) := Set.smulSet
    let S : Set E3 := Metric.closedBall (0 : E3) r_v
    let K : Set E3 := F '' S
    classical
    let V : E3 → E3 := fun ξ => if h : ξ ∈ K then Classical.choose h else 0
    have hV_mem : ∀ ξ ∈ K, V ξ ∈ S := by
      intro ξ hξ
      dsimp [V]
      rw [dif_pos hξ]
      exact (Classical.choose_spec hξ).1
    have hFV_eq : ∀ ξ ∈ K, F (V ξ) = ξ := by
      intro ξ hξ
      dsimp [V]
      rw [dif_pos hξ]
      exact (Classical.choose_spec hξ).2
    have hS_sub : S ⊆ V '' K := by
      intro v hv
      have hFv : F v ∈ K := ⟨v, hv, rfl⟩
      refine ⟨F v, hFv, ?_⟩
      have h1 := h_rev v hv (V (F v)) (hV_mem (F v) hFv)
      rw [hFV_eq (F v) hFv, sub_self, norm_zero, mul_zero] at h1
      have h2 : ‖V (F v) - v‖ = 0 := le_antisymm (by rw [norm_sub_rev]; exact h1) (norm_nonneg _)
      exact sub_eq_zero.mp (norm_eq_zero.mp h2)
    have h_det : ENNReal.ofReal |(0 : E3 →L[ℝ] E3).det| < ↑(2 : NNReal) := by
      change ENNReal.ofReal |LinearMap.det (0 : E3 →ₗ[ℝ] E3)| < ↑(2 : NNReal)
      rw [LinearMap.det_zero'']
      simp
    have h_haar := MeasureTheory.addHaar_image_le_mul_of_det_lt
      (MeasureTheory.volume : MeasureTheory.Measure E3) (0 : E3 →L[ℝ] E3) h_det
    rcases (Filter.eventually_iff_exists_mem.mp h_haar) with ⟨U_nhds, hU_mem, hU_prop⟩
    rw [Metric.mem_nhdsWithin_iff] at hU_mem
    rcases hU_mem with ⟨ε_nhds, hε_pos, hε_sub⟩
    let δ₀ : NNReal := ⟨ε_nhds / 2, by positivity⟩
    have hδ₀_pos : (0 : ℝ) < δ₀ := by
      change 0 < ε_nhds / 2
      linarith
    have hδ₀_in : δ₀ ∈ U_nhds := by
      apply hε_sub
      refine ⟨?_, hδ₀_pos⟩
      rw [Metric.mem_ball, NNReal.dist_eq, NNReal.coe_zero, sub_zero, abs_of_pos hδ₀_pos]
      change ε_nhds / 2 < ε_nhds
      linarith
    let c : ℝ := (δ₀ : ℝ) / (Λ + 1)
    have hc_pos : 0 < c := by positivity
    have hc_ne : c ≠ 0 := ne_of_gt hc_pos
    let g : E3 → E3 := fun ξ => c • V ξ
    have hg_approx : ApproximatesLinearOn g (0 : E3 →L[ℝ] E3) K δ₀ := by
      rw [ApproximatesLinearOn.approximatesLinearOn_iff_lipschitzOnWith]
      apply LipschitzOnWith.of_dist_le_mul
      intro x hx y hy
      rw [dist_eq_norm, dist_eq_norm]
      change ‖c • V x - 0 - (c • V y - 0)‖ ≤ (δ₀ : ℝ) * ‖x - y‖
      rw [sub_zero, sub_zero, ← smul_sub, norm_smul, Real.norm_eq_abs, abs_of_pos hc_pos]
      have hV_lip : ‖V x - V y‖ ≤ Λ * ‖x - y‖ := by
        have := h_rev (V x) (hV_mem x hx) (V y) (hV_mem y hy)
        rwa [hFV_eq x hx, hFV_eq y hy] at this
      calc c * ‖V x - V y‖ ≤ c * (Λ * ‖x - y‖) := mul_le_mul_of_nonneg_left hV_lip (le_of_lt hc_pos)
        _ = (c * Λ) * ‖x - y‖ := by ring
        _ ≤ (δ₀ : ℝ) * ‖x - y‖ := by
          apply mul_le_mul_of_nonneg_right _ (norm_nonneg _)
          dsimp [c]
          rw [div_mul_eq_mul_div, div_le_iff₀ (by positivity)]
          nlinarith
    have hgK_le := hU_prop δ₀ hδ₀_in K g hg_approx
    rw [hK_zero, mul_zero, nonpos_iff_eq_zero] at hgK_le
    have hgK_eq : g '' K = c • (V '' K) := by
      ext z
      simp only [Set.mem_image, Set.mem_smul_set, g]
      constructor
      · rintro ⟨x, hx, rfl⟩
        exact ⟨V x, ⟨x, hx, rfl⟩, rfl⟩
      · rintro ⟨_, ⟨x, hx, rfl⟩, rfl⟩
        exact ⟨x, hx, rfl⟩
    rw [hgK_eq, MeasureTheory.Measure.addHaar_smul] at hgK_le
    have h_pow_pos : 0 < |c ^ Module.finrank ℝ E3| := abs_pos.mpr (pow_ne_zero _ hc_ne)
    have h_ofReal_ne : ENNReal.ofReal |c ^ Module.finrank ℝ E3| ≠ 0 :=
      ENNReal.ofReal_ne_zero_iff.mpr h_pow_pos
    have hVK_zero : MeasureTheory.volume (V '' K) = 0 := by
      rcases mul_eq_zero.mp hgK_le with h1 | h2
      · exact absurd h1 h_ofReal_ne
      · exact h2
    have h_ball_sub : Metric.ball (0 : E3) r_v ⊆ V '' K :=
      Set.Subset.trans Metric.ball_subset_closedBall hS_sub
    have h_ball_zero : MeasureTheory.volume (Metric.ball (0 : E3) r_v) = 0 :=
      MeasureTheory.measure_mono_null h_ball_sub hVK_zero
    have h_ball_ne : MeasureTheory.volume (Metric.ball (0 : E3) r_v) ≠ 0 :=
      IsOpen.measure_ne_zero MeasureTheory.volume Metric.isOpen_ball ⟨0, Metric.mem_ball_self hr_v⟩
    exact h_ball_ne h_ball_zero
  have h_s2 : ∀ (u : E → ℝ),
      ConvexOn ℝ Set.univ (fun ξ => u ξ + (lam / 2) * ‖ξ‖ ^ 2) →
      ∀ (ξ₁ ξ₂ q₁ q₂ : E),
        ξ₁ ∈ Metric.closedBall (0 : E) (7 * δ / 8) →
        ξ₂ ∈ Metric.closedBall (0 : E) (7 * δ / 8) →
        (∀ z ∈ Metric.closedBall (0 : E) δ,
          u z - u ξ₁ - inner ℝ q₁ (z - ξ₁) ≤ C_Q * ‖z - ξ₁‖ ^ 2) →
        (∀ z ∈ Metric.closedBall (0 : E) δ,
          u z - u ξ₂ - inner ℝ q₂ (z - ξ₂) ≤ C_Q * ‖z - ξ₂‖ ^ 2) →
