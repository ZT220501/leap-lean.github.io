    have h_fit_abs := abs_le.mp h_fit_eval
    have h_cs : |inner ℝ (p k) x| ≤ ‖p k‖ * (2 : ℝ) ^ n := by
      have h1 : |inner ℝ (p k) x| ≤ ‖p k‖ * ‖x‖ := abs_real_inner_le_norm (p k) x
      have h2 : ‖p k‖ * ‖x‖ ≤ ‖p k‖ * (2 : ℝ) ^ n :=
        mul_le_mul_of_nonneg_left hx_n (norm_nonneg _)
      exact le_trans h1 h2
    have h_cs_abs := abs_le.mp h_cs
    have h_ak_ell : |a k * ℓ| ≤ (2 : ℝ) ^ n := by
      rw [abs_mul]
      have h1 : |a k| * |ℓ| ≤ |a k| * T₁ :=
