theorem fitted_frame_fits_and_centering : ∀ (d : ℕ) (C₁ : ℝ) (v : EuclideanSpace ℝ (Fin (d + 1)) → ℝ),
    Continuous v →
    (∀ (x : EuclideanSpace ℝ (Fin d)) (t R : ℝ), 0 < R →
      ∃ (p : EuclideanSpace ℝ (Fin d)) (a : ℝ), IsFitAt d C₁ v x t R p a) →
    ∀ (x₀ p₀ : EuclideanSpace ℝ (Fin d)) (r a₀ : ℝ),
      0 < r →
      IsFitAt d C₁ v x₀ r r p₀ a₀ →
      let w := fittedFrameTransform d v x₀ r p₀ a₀
      Continuous w ∧
      IsCenteredAt d C₁ w 0 1 ∧
      (∀ (y : EuclideanSpace ℝ (Fin d)) (s ρ : ℝ), 0 < ρ →
        ∃ (p' : EuclideanSpace ℝ (Fin d)) (a' : ℝ), IsFitAt d C₁ w y s ρ p' a') :=
by
  intro d C₁ v hv hv_fits x₀ p₀ r a₀ hr h_fit₀
  dsimp only
  set w := fittedFrameTransform d v x₀ r p₀ a₀
  have hr_ne : r ≠ 0 := ne_of_gt hr
  have h_projSpace : ∀ (x : EuclideanSpace ℝ (Fin d)) (t : ℝ),
      projSpace (mkSpaceTime x t) = x := by
    intro x t
    ext i
    simp [projSpace, mkSpaceTime]
  have h_projTime : ∀ (x : EuclideanSpace ℝ (Fin d)) (t : ℝ),
      projTime (mkSpaceTime x t) = t := by
    intro x t
    simp [projTime, mkSpaceTime]
  have hc_projSpace : Continuous (projSpace (d := d)) := by
    unfold projSpace
    fun_prop
  have hc_projTime : Continuous (projTime (d := d)) := by
    unfold projTime
    fun_prop
  have hc_mkSpaceTime : Continuous (fun p : EuclideanSpace ℝ (Fin d) × ℝ => mkSpaceTime p.1 p.2) := by
    unfold mkSpaceTime
    apply Continuous.comp (ContinuousLinearEquiv.continuous _)
    rw [continuous_pi_iff]
    intro j
    refine Fin.lastCases ?_ ?_ j
    · simpa [Fin.snoc_last] using continuous_snd
    · intro i
      have hc_coord : Continuous (fun p : EuclideanSpace ℝ (Fin d) × ℝ => p.1 i) :=
        ((continuous_apply i).comp (EuclideanSpace.equiv (Fin d) ℝ).continuous).comp continuous_fst
      simpa [Fin.snoc_castSucc] using hc_coord
  have hw_cont : Continuous w := by
    change Continuous (fittedFrameTransform d v x₀ r p₀ a₀)
    unfold fittedFrameTransform
    have hc_pair : Continuous (fun z : EuclideanSpace ℝ (Fin (d + 1)) =>
        (x₀ + r • (projSpace z + (projTime z - 1) • p₀), r * projTime z)) := by
      fun_prop
    have hc_arg : Continuous (fun z : EuclideanSpace ℝ (Fin (d + 1)) =>
        mkSpaceTime (x₀ + r • (projSpace z + (projTime z - 1) • p₀)) (r * projTime z)) :=
      hc_mkSpaceTime.comp hc_pair
    have hc_v : Continuous (fun z : EuclideanSpace ℝ (Fin (d + 1)) =>
        v (mkSpaceTime (x₀ + r • (projSpace z + (projTime z - 1) • p₀)) (r * projTime z))) :=
      hv.comp hc_arg
    fun_prop
  have h_cov : ∀ (y : EuclideanSpace ℝ (Fin d)) (s ρ : ℝ)
      (p : EuclideanSpace ℝ (Fin d)) (a : ℝ),
      IsFitAt d C₁ v (x₀ + r • (y + (s - 1) • p₀)) (r * s) (r * ρ) p a →
      IsFitAt d C₁ w y s ρ (p - p₀) (a - a₀) := by
    intro y s ρ p a h_fit h ℓ hℓ hh
    set x_c : EuclideanSpace ℝ (Fin d) := x₀ + r • (y + (s - 1) • p₀)
    set t_c : ℝ := r * s
    set H : EuclideanSpace ℝ (Fin d) := r • (h + ℓ • p₀)
    set L : ℝ := r * ℓ
    have hL : |L| ≤ r * ρ := by
      dsimp [L]
      rw [abs_mul, abs_of_pos hr]
      exact mul_le_mul_of_nonneg_left hℓ (le_of_lt hr)
    have hH_eq : H - L • p = r • (h - ℓ • (p - p₀)) := by
      dsimp [H, L]
      module
    have hH : ‖H - L • p‖ ≤ r * ρ := by
      rw [hH_eq, norm_smul, Real.norm_eq_abs, abs_of_pos hr]
      exact mul_le_mul_of_nonneg_left hh (le_of_lt hr)
    have h_v_bound := h_fit H L hL hH
    have h_space_arg :
        x₀ + r • ((y + h) + (s + ℓ - 1) • p₀) = x_c + H := by
      dsimp [x_c, H]
      module
    have h_time_arg :
        r * (s + ℓ) = t_c + L := by
      dsimp [t_c, L]
      ring
    have h_inner_H : inner ℝ p H = r * (inner ℝ p h + ℓ * inner ℝ p p₀) := by
      dsimp [H]
      rw [real_inner_smul_right, inner_add_right, real_inner_smul_right]
    have h_norm_sub : ‖p - p₀‖ ^ 2 = ‖p‖ ^ 2 - 2 * inner ℝ p p₀ + ‖p₀‖ ^ 2 :=
      norm_sub_sq_real p p₀
    have h_inner_p0 : inner ℝ p₀ (y + h) = inner ℝ p₀ y + inner ℝ p₀ h :=
      inner_add_right p₀ y h
    have h_inner_sub : inner ℝ (p - p₀) h = inner ℝ p h - inner ℝ p₀ h :=
      inner_sub_left p p₀ h
    have h_rem_eq :
        w (mkSpaceTime (y + h) (s + ℓ)) - w (mkSpaceTime y s) -
          inner ℝ (p - p₀) h - (a - a₀ - ‖p - p₀‖ ^ 2 / 2) * ℓ =
        (v (mkSpaceTime (x_c + H) (t_c + L)) - v (mkSpaceTime x_c t_c) -
          inner ℝ p H - (a - ‖p‖ ^ 2 / 2) * L) / r := by
      change fittedFrameTransform d v x₀ r p₀ a₀ (mkSpaceTime (y + h) (s + ℓ)) -
          fittedFrameTransform d v x₀ r p₀ a₀ (mkSpaceTime y s) -
          inner ℝ (p - p₀) h - (a - a₀ - ‖p - p₀‖ ^ 2 / 2) * ℓ = _
      unfold fittedFrameTransform
      dsimp only
      rw [h_projSpace (y + h) (s + ℓ), h_projTime (y + h) (s + ℓ),
        h_projSpace y s, h_projTime y s,
        h_space_arg, h_time_arg]
      change (v (mkSpaceTime (x_c + H) (t_c + L)) - v (mkSpaceTime x₀ r)) / r -
          inner ℝ p₀ (y + h) - (a₀ + ‖p₀‖ ^ 2 / 2) * (s + ℓ - 1) -
          ((v (mkSpaceTime x_c t_c) - v (mkSpaceTime x₀ r)) / r -
            inner ℝ p₀ y - (a₀ + ‖p₀‖ ^ 2 / 2) * (s - 1)) -
          inner ℝ (p - p₀) h - (a - a₀ - ‖p - p₀‖ ^ 2 / 2) * ℓ =
        (v (mkSpaceTime (x_c + H) (t_c + L)) - v (mkSpaceTime x_c t_c) -
          inner ℝ p H - (a - ‖p‖ ^ 2 / 2) * (r * ℓ)) / r
      rw [h_inner_p0, h_inner_sub, h_norm_sub, h_inner_H]
      field_simp [hr_ne]
      ring
    rw [h_rem_eq, abs_div, abs_of_pos hr, div_le_iff₀ hr]
    calc |v (mkSpaceTime (x_c + H) (t_c + L)) - v (mkSpaceTime x_c t_c) -
            inner ℝ p H - (a - ‖p‖ ^ 2 / 2) * L|
      _ ≤ C₁ * (r * ρ) := h_v_bound
      _ = C₁ * ρ * r := by ring
  have hw_01 : w (mkSpaceTime 0 1) = 0 := by
    change fittedFrameTransform d v x₀ r p₀ a₀ (mkSpaceTime 0 1) = 0
    unfold fittedFrameTransform
    dsimp only
    rw [h_projSpace 0 1, h_projTime 0 1]
    simp
  have hw_fit01 : IsFitAt d C₁ w 0 1 1 0 0 := by
    have h_fit01_v : IsFitAt d C₁ v (x₀ + r • (0 + ((1 : ℝ) - 1) • p₀)) (r * 1) (r * 1) p₀ a₀ := by
      simpa using h_fit₀
    have h_cov01 := h_cov 0 1 1 p₀ a₀ h_fit01_v
    simpa using h_cov01
  have hw_fits : ∀ (y : EuclideanSpace ℝ (Fin d)) (s ρ : ℝ), 0 < ρ →
      ∃ (p' : EuclideanSpace ℝ (Fin d)) (a' : ℝ), IsFitAt d C₁ w y s ρ p' a' := by
    intro y s ρ hρ
    obtain ⟨p, a, h_fit⟩ :=
      hv_fits (x₀ + r • (y + (s - 1) • p₀)) (r * s) (r * ρ) (mul_pos hr hρ)
    exact ⟨p - p₀, a - a₀, h_cov y s ρ p a h_fit⟩
  exact ⟨hw_cont, ⟨hw_01, hw_fit01⟩, hw_fits⟩

theorem fitted_frame_viscosity_covariance : ∀ (d : ℕ) (C₁ : ℝ) (v : EuclideanSpace ℝ (Fin (d + 1)) → ℝ),
    InLimitingClassA d C₁ v →
    ∀ (x₀ p₀ : EuclideanSpace ℝ (Fin d)) (r a₀ : ℝ),
      0 < r →
      let w := fittedFrameTransform d v x₀ r p₀ a₀
      (∀ z : EuclideanSpace ℝ (Fin (d + 1)), ∀ ϕ : EuclideanSpace ℝ (Fin (d + 1)) → ℝ,
        ∀ V : Set (EuclideanSpace ℝ (Fin (d + 1))),
          IsOpen V → z ∈ V → ContDiffOn ℝ 2 ϕ V → ϕ z = w z → (∀ y ∈ V, w y ≤ ϕ y) →
          0 ≤ limitingOperator ϕ z) ∧
      (∀ z : EuclideanSpace ℝ (Fin (d + 1)), ∀ ϕ : EuclideanSpace ℝ (Fin (d + 1)) → ℝ,
        ∀ V : Set (EuclideanSpace ℝ (Fin (d + 1))),
          IsOpen V → z ∈ V → ContDiffOn ℝ 2 ϕ V → ϕ z = w z → (∀ y ∈ V, ϕ y ≤ w y) →
          limitingOperator ϕ z ≤ 0) :=
by
  intro d C₁ v hv x₀ p₀ r a₀ hr
  set w := fittedFrameTransform d v x₀ r p₀ a₀
  have hr_ne : r ≠ 0 := ne_of_gt hr
  have projSpace_mkSpaceTime :
      ∀ (y : EuclideanSpace ℝ (Fin d)) (s : ℝ), projSpace (mkSpaceTime y s) = y := by
    intro y s
    ext i
    simp [projSpace, mkSpaceTime, Fin.snoc_castSucc]
  have projTime_mkSpaceTime :
      ∀ (y : EuclideanSpace ℝ (Fin d)) (s : ℝ), projTime (mkSpaceTime y s) = s := by
    intro y s
    simp [projTime, mkSpaceTime, Fin.snoc_last]
  have mkSpaceTime_projSpace_projTime :
      ∀ z : EuclideanSpace ℝ (Fin (d + 1)), mkSpaceTime (projSpace z) (projTime z) = z := by
    intro z
    ext i
    refine Fin.lastCases ?_ ?_ i
    · simp [mkSpaceTime, projTime, Fin.snoc_last]
    · intro j
      simp [mkSpaceTime, projSpace, Fin.snoc_castSucc]
  have projSpace_add :
      ∀ z₁ z₂ : EuclideanSpace ℝ (Fin (d + 1)),
        projSpace (z₁ + z₂) = projSpace z₁ + projSpace z₂ := by
    intro z₁ z₂
    ext i
    simp [projSpace]
  have projTime_add :
      ∀ z₁ z₂ : EuclideanSpace ℝ (Fin (d + 1)),
        projTime (z₁ + z₂) = projTime z₁ + projTime z₂ := by
    intro z₁ z₂
    simp [projTime]
  have projSpace_sub :
      ∀ z₁ z₂ : EuclideanSpace ℝ (Fin (d + 1)),
        projSpace (z₁ - z₂) = projSpace z₁ - projSpace z₂ := by
    intro z₁ z₂
    ext i
    simp [projSpace]
  have projTime_sub :
      ∀ z₁ z₂ : EuclideanSpace ℝ (Fin (d + 1)),
        projTime (z₁ - z₂) = projTime z₁ - projTime z₂ := by
    intro z₁ z₂
    simp [projTime]
  have projSpace_smul :
      ∀ (c : ℝ) (z : EuclideanSpace ℝ (Fin (d + 1))),
        projSpace (c • z) = c • projSpace z := by
    intro c z
    ext i
    simp [projSpace]
  have projTime_smul :
      ∀ (c : ℝ) (z : EuclideanSpace ℝ (Fin (d + 1))),
        projTime (c • z) = c * projTime z := by
    intro c z
    simp [projTime]
  have mkSpaceTime_add :
      ∀ (x₁ x₂ : EuclideanSpace ℝ (Fin d)) (t₁ t₂ : ℝ),
        mkSpaceTime (x₁ + x₂) (t₁ + t₂) = mkSpaceTime x₁ t₁ + mkSpaceTime x₂ t₂ := by
    intro x₁ x₂ t₁ t₂
    ext i
    refine Fin.lastCases ?_ ?_ i
    · simp [mkSpaceTime, Fin.snoc_last]
    · intro j
      simp [mkSpaceTime, Fin.snoc_castSucc]
  have inner_eq_projSpace_add_projTime :
      ∀ z₁ z₂ : EuclideanSpace ℝ (Fin (d + 1)),
        inner ℝ z₁ z₂ = inner ℝ (projSpace z₁) (projSpace z₂) + projTime z₁ * projTime z₂ := by
    intro z₁ z₂
    rw [PiLp.inner_apply, PiLp.inner_apply, Fin.sum_univ_castSucc]
    simp [projSpace, projTime, mul_comm]
  let projTimeCLM : EuclideanSpace ℝ (Fin (d + 1)) →L[ℝ] ℝ :=
    LinearMap.toContinuousLinearMap
      { toFun := projTime
        map_add' := projTime_add
        map_smul' := projTime_smul }
  have deriv_deriv_line_eq_fderiv_fderiv :
      ∀ {E : Type} [NormedAddCommGroup E] [NormedSpace ℝ E]
        {f : E → ℝ} {W : Set E}, IsOpen W → ∀ {z₀ : E}, z₀ ∈ W →
        ContDiffOn ℝ 2 f W → ∀ (ξ : E),
        deriv (deriv (fun s : ℝ => f (z₀ + s • ξ))) 0 = fderiv ℝ (fderiv ℝ f) z₀ ξ ξ := by
    intro E _ _ f W hW z₀ hz₀ hf ξ
    have h_pre : IsOpen ((fun s : ℝ => z₀ + s • ξ) ⁻¹' W) :=
      hW.preimage (continuous_const.add (continuous_id.smul continuous_const))
    have h0_mem : (0 : ℝ) ∈ (fun s : ℝ => z₀ + s • ξ) ⁻¹' W := by simp [hz₀]
    have h_ev : (fun s : ℝ => deriv (fun r : ℝ => f (z₀ + r • ξ)) s) =ᶠ[nhds 0]
        (fun s : ℝ => (fderiv ℝ f (z₀ + s • ξ)) ξ) := by
      filter_upwards [h_pre.mem_nhds h0_mem] with s hs
      have hf_diff : DifferentiableAt ℝ f (z₀ + s • ξ) :=
        ((hf.contDiffAt (hW.mem_nhds hs)).differentiableAt (by norm_num))
      have h_line : HasDerivAt (fun r : ℝ => z₀ + r • ξ) ξ s := by
        simpa using (hasDerivAt_id s).smul_const ξ |>.const_add z₀
      exact (hf_diff.hasFDerivAt.comp_hasDerivAt s h_line).deriv
    rw [h_ev.deriv_eq]
    have hcd : ContDiffAt ℝ 2 f z₀ := hf.contDiffAt (hW.mem_nhds hz₀)
    have hcd1 : ContDiffAt ℝ 1 (fderiv ℝ f) z₀ := hcd.fderiv_right (by norm_num)
    have hf2_diff : HasFDerivAt (fderiv ℝ f) (fderiv ℝ (fderiv ℝ f) z₀) (z₀ + (0 : ℝ) • ξ) := by
      simpa using (hcd1.differentiableAt (by norm_num)).hasFDerivAt
    have h_line0 : HasDerivAt (fun s : ℝ => z₀ + s • ξ) ξ 0 := by
      simpa using (hasDerivAt_id (0 : ℝ)).smul_const ξ |>.const_add z₀
    have h_comp : HasDerivAt (fun s : ℝ => fderiv ℝ f (z₀ + s • ξ))
        (fderiv ℝ (fderiv ℝ f) z₀ ξ) 0 :=
      hf2_diff.comp_hasDerivAt 0 h_line0
    exact ((ContinuousLinearMap.apply ℝ ℝ ξ).hasFDerivAt.comp_hasDerivAt 0 h_comp).deriv
  set e_p : EuclideanSpace ℝ (Fin (d + 1)) := mkSpaceTime p₀ 0
  set z_one : EuclideanSpace ℝ (Fin (d + 1)) := mkSpaceTime 0 1
  set w_orig : EuclideanSpace ℝ (Fin (d + 1)) := mkSpaceTime x₀ r
  set q₀ : EuclideanSpace ℝ (Fin (d + 1)) := mkSpaceTime p₀ (a₀ + ‖p₀‖ ^ 2 / 2)
  let B_inv : EuclideanSpace ℝ (Fin (d + 1)) →L[ℝ] EuclideanSpace ℝ (Fin (d + 1)) :=
    ContinuousLinearMap.id ℝ (EuclideanSpace ℝ (Fin (d + 1))) - projTimeCLM.smulRight e_p
  let L : EuclideanSpace ℝ (Fin (d + 1)) →L[ℝ] EuclideanSpace ℝ (Fin (d + 1)) :=
    r⁻¹ • B_inv
  have hL_apply : ∀ u : EuclideanSpace ℝ (Fin (d + 1)),
      L u = r⁻¹ • (u - (projTime u) • e_p) := by
    intro u
    rfl
  have hprojSpace_L : ∀ u : EuclideanSpace ℝ (Fin (d + 1)),
      projSpace (L u) = r⁻¹ • (projSpace u - (projTime u) • p₀) := by
    intro u
    rw [hL_apply, projSpace_smul, projSpace_sub, projSpace_smul, projSpace_mkSpaceTime]
  have hprojTime_L : ∀ u : EuclideanSpace ℝ (Fin (d + 1)),
      projTime (L u) = r⁻¹ * projTime u := by
    intro u
    rw [hL_apply, projTime_smul, projTime_sub, projTime_smul, projTime_mkSpaceTime]
    ring
  set Φ : EuclideanSpace ℝ (Fin (d + 1)) → EuclideanSpace ℝ (Fin (d + 1)) :=
    fun z => mkSpaceTime (x₀ + r • (projSpace z + (projTime z - 1) • p₀))
      (r * projTime z)
  set Ψ : EuclideanSpace ℝ (Fin (d + 1)) → EuclideanSpace ℝ (Fin (d + 1)) :=
    fun u => z_one + L (u - w_orig)
  have hΨΦ : ∀ z : EuclideanSpace ℝ (Fin (d + 1)), Ψ (Φ z) = z := by
    intro z
    rw [← mkSpaceTime_projSpace_projTime (Ψ (Φ z))]
    have h_time : projTime (Ψ (Φ z)) = projTime z := by
      dsimp [Ψ, Φ, z_one, w_orig]
      rw [projTime_add, projTime_mkSpaceTime, hprojTime_L, projTime_sub,
        projTime_mkSpaceTime, projTime_mkSpaceTime]
      field_simp [hr_ne]
      ring
    have h_space : projSpace (Ψ (Φ z)) = projSpace z := by
      dsimp [Ψ, Φ, z_one, w_orig]
      rw [projSpace_add, projSpace_mkSpaceTime, zero_add, hprojSpace_L,
        projSpace_sub, projSpace_mkSpaceTime, projSpace_mkSpaceTime,
        projTime_sub, projTime_mkSpaceTime, projTime_mkSpaceTime]
      have h1 : x₀ + r • (projSpace z + (projTime z - 1) • p₀) - x₀ =
          r • projSpace z + (r * (projTime z - 1)) • p₀ := by
        rw [add_sub_cancel_left, smul_add, smul_smul]
      have h2 : r * projTime z - r = r * (projTime z - 1) := by ring
      rw [h1, h2, add_sub_cancel_right, smul_smul, inv_mul_cancel₀ hr_ne, one_smul]
    rw [h_space, h_time, mkSpaceTime_projSpace_projTime]
  have hΦΨ : ∀ u : EuclideanSpace ℝ (Fin (d + 1)), Φ (Ψ u) = u := by
    intro u
    have h_time_Ψ : projTime (Ψ u) = 1 + r⁻¹ * (projTime u - r) := by
      dsimp [Ψ, z_one, w_orig]
      rw [projTime_add, projTime_mkSpaceTime, hprojTime_L, projTime_sub, projTime_mkSpaceTime]
    have h_space_Ψ : projSpace (Ψ u) =
        r⁻¹ • ((projSpace u - x₀) - (projTime u - r) • p₀) := by
      dsimp [Ψ, z_one, w_orig]
      rw [projSpace_add, projSpace_mkSpaceTime, zero_add, hprojSpace_L,
        projSpace_sub, projSpace_mkSpaceTime, projTime_sub, projTime_mkSpaceTime]
    dsimp [Φ]
    rw [h_time_Ψ, h_space_Ψ, add_sub_cancel_left]
    have h_s : x₀ + r • (r⁻¹ • (projSpace u - x₀ - (projTime u - r) • p₀) +
        (r⁻¹ * (projTime u - r)) • p₀) = projSpace u := by
      rw [mul_smul r⁻¹ (projTime u - r) p₀, ← smul_add, sub_add_cancel,
        smul_smul, mul_inv_cancel₀ hr_ne, one_smul, add_sub_cancel]
    have h_t : r * (1 + r⁻¹ * (projTime u - r)) = projTime u := by
      field_simp [hr_ne]
      ring
    rw [h_s, h_t, mkSpaceTime_projSpace_projTime]
  have hΨ_line : ∀ (u η : EuclideanSpace ℝ (Fin (d + 1))) (s : ℝ),
      Ψ (u + s • η) = Ψ u + s • L η := by
    intro u η s
    dsimp [Ψ]
    have h_sub : u + s • η - w_orig = (u - w_orig) + s • η := by abel
    rw [h_sub, map_add, map_smul, add_assoc]
  have hw_eq : ∀ z : EuclideanSpace ℝ (Fin (d + 1)),
      w z = (v (Φ z) - v w_orig) / r - inner ℝ q₀ (z - z_one) := by
    intro z
    have h_in : inner ℝ q₀ (z - z_one) =
        inner ℝ p₀ (projSpace z) + (a₀ + ‖p₀‖ ^ 2 / 2) * (projTime z - 1) := by
      rw [inner_eq_projSpace_add_projTime]
      dsimp [q₀, z_one]
      rw [projSpace_mkSpaceTime, projTime_mkSpaceTime,
        projSpace_sub, projSpace_mkSpaceTime, sub_zero,
        projTime_sub, projTime_mkSpaceTime]
    dsimp [w, fittedFrameTransform, Φ, w_orig]
    rw [h_in]
    ring
  have h_pullback :
      ∀ (z₀ : EuclideanSpace ℝ (Fin (d + 1)))
        (ϕ : EuclideanSpace ℝ (Fin (d + 1)) → ℝ)
        (V : Set (EuclideanSpace ℝ (Fin (d + 1)))),
        IsOpen V → z₀ ∈ V → ContDiffOn ℝ 2 ϕ V → ϕ z₀ = w z₀ →
        let V' : Set (EuclideanSpace ℝ (Fin (d + 1))) := Ψ ⁻¹' V
        let w_c : EuclideanSpace ℝ (Fin (d + 1)) := Φ z₀
        let ψ : EuclideanSpace ℝ (Fin (d + 1)) → ℝ :=
          fun u => v w_orig + r * (ϕ (Ψ u) + inner ℝ q₀ (Ψ u - z_one))
        IsOpen V' ∧ w_c ∈ V' ∧ ContDiffOn ℝ 2 ψ V' ∧ ψ w_c = v w_c ∧
        (∀ u : EuclideanSpace ℝ (Fin (d + 1)), ψ u - v u = r * (ϕ (Ψ u) - w (Ψ u))) ∧
        limitingOperator ϕ z₀ = r * limitingOperator ψ w_c := by
    intro z₀ ϕ V hV_open hz₀ hϕ_C2 hϕ_z₀
    set V' : Set (EuclideanSpace ℝ (Fin (d + 1))) := Ψ ⁻¹' V
    set w_c : EuclideanSpace ℝ (Fin (d + 1)) := Φ z₀
    set ψ : EuclideanSpace ℝ (Fin (d + 1)) → ℝ :=
      fun u => v w_orig + r * (ϕ (Ψ u) + inner ℝ q₀ (Ψ u - z_one))
    have hΨ_C2 : ContDiff ℝ 2 Ψ :=
      contDiff_const.add (L.contDiff.comp (contDiff_id.sub contDiff_const))
    have hV'_open : IsOpen V' := hV_open.preimage hΨ_C2.continuous
    have hΨ_wc : Ψ w_c = z₀ := hΨΦ z₀
    have hw_c_mem : w_c ∈ V' := by
      change Ψ w_c ∈ V
      rw [hΨ_wc]
      exact hz₀
    have hϕΨ_C2 : ContDiffOn ℝ 2 (fun u => ϕ (Ψ u)) V' :=
      hϕ_C2.comp hΨ_C2.contDiffOn (fun u hu => hu)
    have h_in_C2 : ContDiff ℝ 2 (fun u => inner ℝ q₀ (Ψ u - z_one)) := by
      change ContDiff ℝ 2 (fun u => (InnerProductSpace.toDual ℝ _ q₀) (Ψ u - z_one))
      exact (InnerProductSpace.toDual ℝ _ q₀).contDiff.comp (hΨ_C2.sub contDiff_const)
    have hψ_C2 : ContDiffOn ℝ 2 ψ V' :=
      contDiffOn_const.add (contDiffOn_const.mul (hϕΨ_C2.add h_in_C2.contDiffOn))
    have hψ_diff_eq : ∀ u : EuclideanSpace ℝ (Fin (d + 1)),
        ψ u - v u = r * (ϕ (Ψ u) - w (Ψ u)) := by
      intro u
      have hw_Ψ : w (Ψ u) = (v u - v w_orig) / r - inner ℝ q₀ (Ψ u - z_one) := by
        rw [hw_eq (Ψ u), hΦΨ u]
      dsimp [ψ]
      rw [hw_Ψ]
      field_simp [hr_ne]
      ring
    have hψ_wc : ψ w_c = v w_c := by
      have h1 := hψ_diff_eq w_c
      rw [hΨ_wc, hϕ_z₀, sub_self, mul_zero, sub_eq_zero] at h1
      exact h1
    have hϕ_diff : DifferentiableAt ℝ ϕ z₀ :=
      (hϕ_C2.contDiffAt (hV_open.mem_nhds hz₀)).differentiableAt (by norm_num)
    have hϕ_fd : HasFDerivAt ϕ (InnerProductSpace.toDual ℝ _ (gradient ϕ z₀)) z₀ :=
      hasGradientAt_iff_hasFDerivAt.mp hϕ_diff.hasGradientAt
    have hψ_diff : DifferentiableAt ℝ ψ w_c :=
      (hψ_C2.contDiffAt (hV'_open.mem_nhds hw_c_mem)).differentiableAt (by norm_num)
    have hψ_fd : HasFDerivAt ψ (InnerProductSpace.toDual ℝ _ (gradient ψ w_c)) w_c :=
      hasGradientAt_iff_hasFDerivAt.mp hψ_diff.hasGradientAt
    have h_grad_space : projSpace (gradient ψ w_c) = projSpace (gradient ϕ z₀) + p₀ := by
      apply ext_inner_right ℝ
      intro h
      set u_h : EuclideanSpace ℝ (Fin (d + 1)) := mkSpaceTime h 0
      set α_h : ℝ → EuclideanSpace ℝ (Fin (d + 1)) := fun s => w_c + s • u_h
      have h_line_w : HasDerivAt α_h u_h 0 := by
        simpa [α_h] using (hasDerivAt_id (0 : ℝ)).smul_const u_h |>.const_add w_c
      have hα0 : α_h 0 = w_c := by simp [α_h]
      have hψ_fd0 : HasFDerivAt ψ (InnerProductSpace.toDual ℝ _ (gradient ψ w_c)) (α_h 0) := by
        rw [hα0]; exact hψ_fd
      have h_val_ψ : (InnerProductSpace.toDual ℝ _ (gradient ψ w_c)) u_h =
          inner ℝ (projSpace (gradient ψ w_c)) h := by
        rw [InnerProductSpace.toDual_apply_apply, inner_eq_projSpace_add_projTime]
        simp [u_h, projSpace_mkSpaceTime, projTime_mkSpaceTime]
      have h_d1 : HasDerivAt (fun s : ℝ => ψ (α_h s)) (inner ℝ (projSpace (gradient ψ w_c)) h) 0 := by
        rw [← h_val_ψ]
        exact hψ_fd0.comp_hasDerivAt 0 h_line_w
      have hL_uh : L u_h = r⁻¹ • u_h := by
        rw [hL_apply, projTime_mkSpaceTime, zero_smul, sub_zero]
      have hΨ_α : ∀ s : ℝ, Ψ (α_h s) = z₀ + s • (r⁻¹ • u_h) := by
        intro s
        dsimp [α_h]
        rw [hΨ_line, hΨ_wc, hL_uh]
      have h_in_uh : inner ℝ q₀ (r⁻¹ • u_h) = r⁻¹ * inner ℝ p₀ h := by
        rw [real_inner_smul_right, inner_eq_projSpace_add_projTime]
        dsimp [q₀, u_h]
        simp [projSpace_mkSpaceTime, projTime_mkSpaceTime]
      have hψ_α_eq : (fun s : ℝ => ψ (α_h s)) =
          fun s : ℝ => v w_orig + r * (ϕ (z₀ + s • (r⁻¹ • u_h)) +
            (inner ℝ q₀ (z₀ - z_one) + s * (r⁻¹ * inner ℝ p₀ h))) := by
        ext s
        dsimp [ψ]
        rw [hΨ_α s]
        have h_sub : z₀ + s • (r⁻¹ • u_h) - z_one = (z₀ - z_one) + s • (r⁻¹ • u_h) := by abel
        rw [h_sub, inner_add_right, real_inner_smul_right, h_in_uh]
      have h_line_z : HasDerivAt (fun s : ℝ => z₀ + s • (r⁻¹ • u_h)) (r⁻¹ • u_h) 0 := by
        simpa using (hasDerivAt_id (0 : ℝ)).smul_const (r⁻¹ • u_h) |>.const_add z₀
      have hϕ_fd0 : HasFDerivAt ϕ (InnerProductSpace.toDual ℝ _ (gradient ϕ z₀))
          (z₀ + (0 : ℝ) • (r⁻¹ • u_h)) := by
        simpa using hϕ_fd
      have h_val_ϕ : (InnerProductSpace.toDual ℝ _ (gradient ϕ z₀)) (r⁻¹ • u_h) =
          r⁻¹ * inner ℝ (projSpace (gradient ϕ z₀)) h := by
        rw [map_smul, smul_eq_mul, InnerProductSpace.toDual_apply_apply,
          inner_eq_projSpace_add_projTime]
        simp [u_h, projSpace_mkSpaceTime, projTime_mkSpaceTime]
      have h_d_ϕ : HasDerivAt (fun s : ℝ => ϕ (z₀ + s • (r⁻¹ • u_h)))
          (r⁻¹ * inner ℝ (projSpace (gradient ϕ z₀)) h) 0 := by
        rw [← h_val_ϕ]
        exact hϕ_fd0.comp_hasDerivAt 0 h_line_z
      have h_d_aff : HasDerivAt (fun s : ℝ => inner ℝ q₀ (z₀ - z_one) + s * (r⁻¹ * inner ℝ p₀ h))
          (r⁻¹ * inner ℝ p₀ h) 0 := by
        have h_id : HasDerivAt (fun s : ℝ => s) 1 0 := hasDerivAt_id 0
        convert (hasDerivAt_const (0 : ℝ) (inner ℝ q₀ (z₀ - z_one))).add
          (h_id.mul_const (r⁻¹ * inner ℝ p₀ h)) using 1
        ring
      have h_d2 : HasDerivAt (fun s : ℝ => ψ (α_h s))
          (inner ℝ (projSpace (gradient ϕ z₀) + p₀) h) 0 := by
        rw [hψ_α_eq]
        convert (hasDerivAt_const (0 : ℝ) (v w_orig)).add
          ((h_d_ϕ.add h_d_aff).const_mul r) using 1
        rw [inner_add_left]
        field_simp [hr_ne]
        ring
      exact h_d1.unique h_d2
    set ξ_ψ : EuclideanSpace ℝ (Fin (d + 1)) := mkSpaceTime (projSpace (gradient ψ w_c)) 1
    set ξ_ϕ : EuclideanSpace ℝ (Fin (d + 1)) := mkSpaceTime (projSpace (gradient ϕ z₀)) 1
    set ζ : EuclideanSpace ℝ (Fin (d + 1)) := r⁻¹ • ξ_ϕ
    have hξ_ψ_eq : ξ_ψ = ξ_ϕ + e_p := by
      dsimp [ξ_ψ, ξ_ϕ, e_p]
      rw [h_grad_space, ← mkSpaceTime_add, add_zero]
    have hL_ξ : L ξ_ψ = ζ := by
      dsimp [ζ]
      rw [hL_apply, projTime_mkSpaceTime, one_smul, hξ_ψ_eq, add_sub_cancel_right]
    have hΨ_ray : ∀ s : ℝ, Ψ (w_c + s • ξ_ψ) = z₀ + s • ζ := by
      intro s
      rw [hΨ_line, hΨ_wc, hL_ξ]
    set A₀ : ℝ := v w_orig + r * inner ℝ q₀ (z₀ - z_one)
    set B₀ : ℝ := r * inner ℝ q₀ ζ
    set g : ℝ → ℝ := fun s => ϕ (z₀ + s • ζ)
    have hψ_ray_eq : (fun s : ℝ => ψ (w_c + s • ξ_ψ)) =
        fun s : ℝ => A₀ + B₀ * s + r * g s := by
      ext s
      dsimp [ψ, A₀, B₀, g]
      rw [hΨ_ray s]
      have h_sub : z₀ + s • ζ - z_one = (z₀ - z_one) + s • ζ := by abel
      rw [h_sub, inner_add_right, real_inner_smul_right]
      ring
    have h_lim_ψ : limitingOperator ψ w_c =
        deriv (deriv (fun s : ℝ => A₀ + B₀ * s + r * g s)) 0 := by
      change fderiv ℝ (fderiv ℝ ψ) w_c ξ_ψ ξ_ψ = _
      rw [← deriv_deriv_line_eq_fderiv_fderiv hV'_open hw_c_mem hψ_C2 ξ_ψ, hψ_ray_eq]
    have hU_s_open : IsOpen ((fun s : ℝ => z₀ + s • ζ) ⁻¹' V) :=
      hV_open.preimage (continuous_const.add (continuous_id.smul continuous_const))
    have h0_U_s : (0 : ℝ) ∈ (fun s : ℝ => z₀ + s • ζ) ⁻¹' V := by simp [hz₀]
    have h_ev_d1 : (fun s : ℝ => deriv (fun τ : ℝ => A₀ + B₀ * τ + r * g τ) s) =ᶠ[nhds 0]
        fun s : ℝ => B₀ + r * deriv g s := by
      filter_upwards [hU_s_open.mem_nhds h0_U_s] with s hs
      have hϕ_s_diff : DifferentiableAt ℝ ϕ (z₀ + s • ζ) :=
        (hϕ_C2.contDiffAt (hV_open.mem_nhds hs)).differentiableAt (by norm_num)
      have h_line_s : HasDerivAt (fun τ : ℝ => z₀ + τ • ζ) ζ s := by
        simpa using (hasDerivAt_id s).smul_const ζ |>.const_add z₀
      have hg_diff : HasDerivAt g (deriv g s) s :=
        (hϕ_s_diff.hasFDerivAt.comp_hasDerivAt s h_line_s).differentiableAt.hasDerivAt
      have h_id_s : HasDerivAt (fun τ : ℝ => τ) 1 s := hasDerivAt_id s
      have h_comb : HasDerivAt (fun τ : ℝ => A₀ + B₀ * τ + r * g τ) (B₀ + r * deriv g s) s := by
        convert ((hasDerivAt_const s A₀).add (h_id_s.const_mul B₀)).add (hg_diff.const_mul r) using 1
        ring
      exact h_comb.deriv
    have h_d2_ray : deriv (deriv (fun s : ℝ => A₀ + B₀ * s + r * g s)) 0 =
        r * deriv (deriv g) 0 := by
      rw [h_ev_d1.deriv_eq, deriv_const_add B₀, deriv_const_mul_field r]
    have h_dd_g : deriv (deriv g) 0 = r⁻¹ * (r⁻¹ * limitingOperator ϕ z₀) := by
      dsimp [g]
      rw [deriv_deriv_line_eq_fderiv_fderiv hV_open hz₀ hϕ_C2 ζ]
      dsimp [ζ, limitingOperator, ξ_ϕ]
      rw [map_smul, map_smul, ContinuousLinearMap.smul_apply, smul_eq_mul, smul_eq_mul]
    have h_lim_eq : limitingOperator ϕ z₀ = r * limitingOperator ψ w_c := by
      rw [h_lim_ψ, h_d2_ray, h_dd_g]
      field_simp [hr_ne]
    exact ⟨hV'_open, hw_c_mem, hψ_C2, hψ_wc, hψ_diff_eq, h_lim_eq⟩
  refine ⟨?_, ?_⟩
  · intro z₀ ϕ V hV_open hz₀ hϕ_C2 hϕ_z₀ h_upper
    obtain ⟨hV'_open, hw_c_mem, hψ_C2, hψ_wc, hψ_diff_eq, h_lim_eq⟩ :=
      h_pullback z₀ ϕ V hV_open hz₀ hϕ_C2 hϕ_z₀
    have hψ_upper : ∀ u ∈ Ψ ⁻¹' V, v u ≤
        v w_orig + r * (ϕ (Ψ u) + inner ℝ q₀ (Ψ u - z_one)) := by
      intro u hu
      have h_le : 0 ≤ ϕ (Ψ u) - w (Ψ u) := sub_nonneg.mpr (h_upper (Ψ u) hu)
      have h_diff := hψ_diff_eq u
      have h_nonneg : 0 ≤ r * (ϕ (Ψ u) - w (Ψ u)) := mul_nonneg (le_of_lt hr) h_le
      linarith
    have h_op_ψ : 0 ≤ limitingOperator
        (fun u => v w_orig + r * (ϕ (Ψ u) + inner ℝ q₀ (Ψ u - z_one))) (Φ z₀) :=
      hv.2.1 (Φ z₀) _ (Ψ ⁻¹' V) hV'_open hw_c_mem hψ_C2 hψ_wc hψ_upper
    rw [h_lim_eq]
    exact mul_nonneg (le_of_lt hr) h_op_ψ
  · intro z₀ ϕ V hV_open hz₀ hϕ_C2 hϕ_z₀ h_lower
    obtain ⟨hV'_open, hw_c_mem, hψ_C2, hψ_wc, hψ_diff_eq, h_lim_eq⟩ :=
      h_pullback z₀ ϕ V hV_open hz₀ hϕ_C2 hϕ_z₀
    have hψ_lower : ∀ u ∈ Ψ ⁻¹' V,
        v w_orig + r * (ϕ (Ψ u) + inner ℝ q₀ (Ψ u - z_one)) ≤ v u := by
      intro u hu
      have h_le : ϕ (Ψ u) - w (Ψ u) ≤ 0 := sub_nonpos.mpr (h_lower (Ψ u) hu)
      have h_diff := hψ_diff_eq u
      have h_nonpos : r * (ϕ (Ψ u) - w (Ψ u)) ≤ 0 :=
        mul_nonpos_of_nonneg_of_nonpos (le_of_lt hr) h_le
      linarith
    have h_op_ψ : limitingOperator
        (fun u => v w_orig + r * (ϕ (Ψ u) + inner ℝ q₀ (Ψ u - z_one))) (Φ z₀) ≤ 0 :=
      hv.2.2.1 (Φ z₀) _ (Ψ ⁻¹' V) hV'_open hw_c_mem hψ_C2 hψ_wc hψ_lower
    rw [h_lim_eq]
    exact mul_nonpos_of_nonneg_of_nonpos (le_of_lt hr) h_op_ψ

theorem fitted_frame_barycentric_covariance : ∀ (d : ℕ) (κ : ℝ), 0 < κ →
    ∀ (v : EuclideanSpace ℝ (Fin (d + 1)) → ℝ),
      HasHorizontalJensenBound d κ v →
      ∀ (x₀ p₀ : EuclideanSpace ℝ (Fin d)) (r a₀ : ℝ),
        0 < r →
        shiftedBarycentricEnvelope d κ v (mkSpaceTime x₀ r) = v (mkSpaceTime x₀ r) →
        let w := fittedFrameTransform d v x₀ r p₀ a₀
        HasHorizontalJensenBound d κ w ∧
        barycentricEnvelope d 1 w (mkSpaceTime 0 1) - w (mkSpaceTime 0 1) = κ ^ 2 / 2 :=
by
  intro d κ hκ_pos v hv_jensen x₀ p₀ r a₀ hr h_env
  dsimp only
  set w := fittedFrameTransform d v x₀ r p₀ a₀
  have hr_ne : r ≠ 0 := ne_of_gt hr
  have h_projSpace : ∀ (u : EuclideanSpace ℝ (Fin d)) (t : ℝ), projSpace (mkSpaceTime u t) = u := by
    intro u t
    ext j
    simp [projSpace, mkSpaceTime]
  have h_projTime : ∀ (u : EuclideanSpace ℝ (Fin d)) (t : ℝ), projTime (mkSpaceTime u t) = t := by
    intro u t
    simp [projTime, mkSpaceTime]
  have hw_eval : ∀ (u : EuclideanSpace ℝ (Fin d)) (s : ℝ),
      w (mkSpaceTime u s) =
        (v (mkSpaceTime (x₀ + r • (u + (s - 1) • p₀)) (r * s)) - v (mkSpaceTime x₀ r)) / r -
          inner ℝ p₀ u - (a₀ + ‖p₀‖ ^ 2 / 2) * (s - 1) := by
    intro u s
    change fittedFrameTransform d v x₀ r p₀ a₀ (mkSpaceTime u s) = _
    dsimp [fittedFrameTransform]
    rw [h_projSpace, h_projTime]
  have hw_slice : ∀ (u : EuclideanSpace ℝ (Fin d)),
      w (mkSpaceTime u 1) =
        (v (mkSpaceTime (x₀ + r • u) r) - v (mkSpaceTime x₀ r)) / r - inner ℝ p₀ u := by
    intro u
    rw [hw_eval u 1]
    simp
  have hw_zero : w (mkSpaceTime 0 1) = 0 := by
    rw [hw_slice 0]
    simp
  have h_env_eq : barycentricEnvelope d r v (mkSpaceTime x₀ r) =
      v (mkSpaceTime x₀ r) + κ ^ 2 * r / 2 := by
    unfold shiftedBarycentricEnvelope at h_env
    rw [h_projTime] at h_env
    linarith
  have hw_jensen : HasHorizontalJensenBound d κ w := by
    intro s N θ y hθ_pos hθ_sum
    dsimp only
    set x_bar : EuclideanSpace ℝ (Fin d) := ∑ i, θ i • y i
    set rho : ℝ := Real.sqrt (∑ i, θ i * ‖y i - x_bar‖ ^ 2)
    let t_hat : ℝ := r * s
    let y_hat : Fin N → EuclideanSpace ℝ (Fin d) := fun i => x₀ + r • (y i + (s - 1) • p₀)
    let x_hat : EuclideanSpace ℝ (Fin d) := x₀ + r • (x_bar + (s - 1) • p₀)
    let c_vec : EuclideanSpace ℝ (Fin d) := x₀ + r • ((s - 1) • p₀)
    have hy_hat_eq : ∀ i, y_hat i = r • y i + c_vec := by
      intro i
      dsimp [y_hat, c_vec]
      rw [smul_add]
      abel
    have hx_hat_eq : x_hat = r • x_bar + c_vec := by
      dsimp [x_hat, c_vec]
      rw [smul_add]
      abel
    have hx_hat : ∑ i, θ i • y_hat i = x_hat := by
      have h_term : ∀ i, θ i • y_hat i = r • (θ i • y i) + θ i • c_vec := by
        intro i
        rw [hy_hat_eq i, smul_add, smul_comm r (θ i) (y i)]
      simp_rw [h_term]
      rw [Finset.sum_add_distrib, ← Finset.smul_sum, ← Finset.sum_smul, hθ_sum, one_smul, ← hx_hat_eq]
    have h_diff : ∀ i, y_hat i - x_hat = r • (y i - x_bar) := by
      intro i
      rw [hy_hat_eq i, hx_hat_eq, add_sub_add_right_eq_sub, ← smul_sub]
    have hr_hat : Real.sqrt (∑ i, θ i * ‖y_hat i - (∑ j, θ j • y_hat j)‖ ^ 2) = r * rho := by
      rw [hx_hat]
      have h_norm_sq : ∀ i, θ i * ‖y_hat i - x_hat‖ ^ 2 = r ^ 2 * (θ i * ‖y i - x_bar‖ ^ 2) := by
        intro i
        rw [h_diff i, norm_smul, Real.norm_of_nonneg (le_of_lt hr)]
        ring
      simp_rw [h_norm_sq]
      rw [← Finset.mul_sum, Real.sqrt_mul (sq_nonneg r), Real.sqrt_sq (le_of_lt hr)]
    have h_inner_sum : ∑ i, θ i * inner ℝ p₀ (y i - x_bar) = 0 := by
      have h_term : ∀ i, θ i * inner ℝ p₀ (y i - x_bar) =
          inner ℝ p₀ (θ i • y i) - θ i * inner ℝ p₀ x_bar := by
        intro i
        rw [inner_sub_right, mul_sub, real_inner_smul_right]
      simp_rw [h_term]
      rw [Finset.sum_sub_distrib, ← inner_sum, ← Finset.sum_mul, hθ_sum, one_mul]
      exact sub_self (inner ℝ p₀ x_bar)
    have h_defect :
        (∑ i, θ i * w (mkSpaceTime (y i) s)) - w (mkSpaceTime x_bar s) =
        ((∑ i, θ i * v (mkSpaceTime (y_hat i) t_hat)) -
          v (mkSpaceTime (∑ i, θ i • y_hat i) t_hat)) / r := by
      rw [hx_hat]
      have h_pt : ∀ i,
          w (mkSpaceTime (y i) s) - w (mkSpaceTime x_bar s) =
          (v (mkSpaceTime (y_hat i) t_hat) - v (mkSpaceTime x_hat t_hat)) / r -
            inner ℝ p₀ (y i - x_bar) := by
        intro i
        rw [hw_eval (y i) s, hw_eval x_bar s, inner_sub_right]
        dsimp [y_hat, x_hat, t_hat]
        ring
      calc (∑ i, θ i * w (mkSpaceTime (y i) s)) - w (mkSpaceTime x_bar s)
        _ = (∑ i, θ i * w (mkSpaceTime (y i) s)) - (∑ i, θ i) * w (mkSpaceTime x_bar s) := by
            rw [hθ_sum, one_mul]
        _ = ∑ i, θ i * (w (mkSpaceTime (y i) s) - w (mkSpaceTime x_bar s)) := by
            rw [Finset.sum_mul, ← Finset.sum_sub_distrib]
            refine Finset.sum_congr rfl (fun i _ => ?_)
            ring
        _ = ∑ i, (θ i * ((v (mkSpaceTime (y_hat i) t_hat) - v (mkSpaceTime x_hat t_hat)) / r) -
            θ i * inner ℝ p₀ (y i - x_bar)) := by
            refine Finset.sum_congr rfl (fun i _ => ?_)
            rw [h_pt i, mul_sub]
        _ = (∑ i, (θ i * v (mkSpaceTime (y_hat i) t_hat) - θ i * v (mkSpaceTime x_hat t_hat)) / r) -
            ∑ i, θ i * inner ℝ p₀ (y i - x_bar) := by
            rw [Finset.sum_sub_distrib]
            congr 1
            refine Finset.sum_congr rfl (fun i _ => ?_)
            ring
        _ = ((∑ i, θ i * v (mkSpaceTime (y_hat i) t_hat)) -
            v (mkSpaceTime x_hat t_hat)) / r := by
            rw [h_inner_sum, sub_zero, ← Finset.sum_div, Finset.sum_sub_distrib, ← Finset.sum_mul,
              hθ_sum, one_mul]
    have hv_step := hv_jensen t_hat N θ y_hat hθ_pos hθ_sum
    dsimp only at hv_step
    rw [hr_hat] at hv_step
    rw [h_defect, div_le_iff₀ hr]
    linarith
  let z_w : EuclideanSpace ℝ (Fin (d + 1)) := mkSpaceTime 0 1
  let z_v : EuclideanSpace ℝ (Fin (d + 1)) := mkSpaceTime x₀ r
  let S_w : Set ℝ :=
    { val : ℝ | ∃ (N : ℕ) (θ : Fin N → ℝ) (y : Fin N → EuclideanSpace ℝ (Fin d)),
      (∀ i, 0 < θ i) ∧ (∑ i, θ i = 1) ∧ (∑ i, θ i • y i = projSpace z_w) ∧
      val = (∑ i, θ i * w (mkSpaceTime (y i) (projTime z_w))) -
        (∑ i, θ i * ‖y i - projSpace z_w‖ ^ 2) / (2 * 1) }
  let S_v : Set ℝ :=
    { val : ℝ | ∃ (N : ℕ) (θ : Fin N → ℝ) (y : Fin N → EuclideanSpace ℝ (Fin d)),
      (∀ i, 0 < θ i) ∧ (∑ i, θ i = 1) ∧ (∑ i, θ i • y i = projSpace z_v) ∧
      val = (∑ i, θ i * v (mkSpaceTime (y i) (projTime z_v))) -
        (∑ i, θ i * ‖y i - projSpace z_v‖ ^ 2) / (2 * r) }
  have hSw_ne : S_w.Nonempty := by
    refine ⟨0, 1, fun _ => 1, fun _ => 0, fun _ => zero_lt_one, by simp, ?_, ?_⟩
    · simp [z_w, h_projSpace]
    · simp [z_w, h_projSpace, h_projTime, hw_zero]
  have hSw_ub : ∀ val ∈ S_w, val ≤ κ ^ 2 / 2 := by
    rintro val ⟨N, θ, y, hθ_pos, hθ_sum, hy_mean, rfl⟩
    dsimp [z_w] at hy_mean ⊢
    rw [h_projSpace] at hy_mean ⊢
    rw [h_projTime]
    have hj := hw_jensen 1 N θ y hθ_pos hθ_sum
    dsimp only at hj
    rw [hy_mean, hw_zero] at hj
    set V : ℝ := ∑ i, θ i * ‖y i - 0‖ ^ 2
    set rho : ℝ := Real.sqrt V
    have hV_nonneg : 0 ≤ V := by
      apply Finset.sum_nonneg
      intro i _
      exact mul_nonneg (le_of_lt (hθ_pos i)) (sq_nonneg _)
    have hrho_sq : rho ^ 2 = V := Real.sq_sqrt hV_nonneg
    have h_sq_nonneg : 0 ≤ (rho - κ) ^ 2 / 2 := div_nonneg (sq_nonneg _) (by norm_num)
    have h_id : κ * rho - V / (2 * 1) = κ ^ 2 / 2 - (rho - κ) ^ 2 / 2 := by
      rw [← hrho_sq]
      ring
    linarith
  have hSw_bdd : BddAbove S_w := ⟨κ ^ 2 / 2, hSw_ub⟩
  have h_env_w_ub : barycentricEnvelope d 1 w z_w ≤ κ ^ 2 / 2 :=
    csSup_le hSw_ne hSw_ub
  have hSv_ne : S_v.Nonempty := by
    refine ⟨v z_v, 1, fun _ => 1, fun _ => x₀, fun _ => zero_lt_one, by simp, ?_, ?_⟩
    · simp [z_v, h_projSpace]
    · simp [z_v, h_projSpace, h_projTime]
  have hSv_ub : ∀ val_v ∈ S_v, val_v ≤ v z_v + r * barycentricEnvelope d 1 w z_w := by
    rintro val_v ⟨N, θ, y_tilde, hθ_pos, hθ_sum, hy_tilde_mean, rfl⟩
    dsimp [z_v] at hy_tilde_mean ⊢
    rw [h_projSpace] at hy_tilde_mean ⊢
    rw [h_projTime]
    let y : Fin N → EuclideanSpace ℝ (Fin d) := fun i => r⁻¹ • (y_tilde i - x₀)
    have hy_mean : ∑ i, θ i • y i = 0 := by
      change ∑ i, θ i • (r⁻¹ • (y_tilde i - x₀)) = 0
      have h_comm : ∀ i, θ i • (r⁻¹ • (y_tilde i - x₀)) = r⁻¹ • (θ i • (y_tilde i - x₀)) := by
        intro i
        exact smul_comm (θ i) r⁻¹ (y_tilde i - x₀)
      simp_rw [h_comm, ← Finset.smul_sum, smul_sub, Finset.sum_sub_distrib, ← Finset.sum_smul,
        hθ_sum, one_smul, hy_tilde_mean]
      simp
    have hy_rec : ∀ i, x₀ + r • y i = y_tilde i := by
      intro i
      change x₀ + r • (r⁻¹ • (y_tilde i - x₀)) = y_tilde i
      rw [smul_smul, mul_inv_cancel₀ hr_ne, one_smul, add_sub_cancel]
    have hy_tilt : ∑ i, θ i * inner ℝ p₀ (y i) = 0 := by
      have h_in : ∀ i, θ i * inner ℝ p₀ (y i) = inner ℝ p₀ (θ i • y i) := by
        intro i
        exact (real_inner_smul_right p₀ (y i) (θ i)).symm
      simp_rw [h_in, ← inner_sum, hy_mean, inner_zero_right]
    have hy_val : ∑ i, θ i * w (mkSpaceTime (y i) 1) =
        ((∑ i, θ i * v (mkSpaceTime (y_tilde i) r)) - v z_v) / r := by
      have h_w : ∀ i, θ i * w (mkSpaceTime (y i) 1) =
          (θ i * v (mkSpaceTime (y_tilde i) r) - θ i * v z_v) / r -
            θ i * inner ℝ p₀ (y i) := by
        intro i
        rw [hw_slice (y i), hy_rec i]
        dsimp [z_v]
        ring
      simp_rw [h_w]
      rw [Finset.sum_sub_distrib, hy_tilt, sub_zero, ← Finset.sum_div,
        Finset.sum_sub_distrib, ← Finset.sum_mul, hθ_sum, one_mul]
    have hy_pen : (∑ i, θ i * ‖y_tilde i - x₀‖ ^ 2) / (2 * r) =
        r * ((∑ i, θ i * ‖y i - 0‖ ^ 2) / (2 * 1)) := by
      have h_term : ∀ i, θ i * ‖y_tilde i - x₀‖ ^ 2 = r ^ 2 * (θ i * ‖y i - 0‖ ^ 2) := by
        intro i
        have h_diff_i : y_tilde i - x₀ = r • (y i - 0) := by
          rw [sub_zero]
          dsimp [y]
          rw [smul_smul, mul_inv_cancel₀ hr_ne, one_smul]
        rw [h_diff_i, norm_smul, Real.norm_of_nonneg (le_of_lt hr)]
        ring
      simp_rw [h_term, ← Finset.mul_sum]
      field_simp [hr_ne]
    let val_w : ℝ := (∑ i, θ i * w (mkSpaceTime (y i) 1)) -
      (∑ i, θ i * ‖y i - 0‖ ^ 2) / (2 * 1)
    have h_mem_w : val_w ∈ S_w := by
      refine ⟨N, θ, y, hθ_pos, hθ_sum, ?_, ?_⟩
      · dsimp [z_w]
        rw [h_projSpace, hy_mean]
      · dsimp [z_w, val_w]
        rw [h_projSpace, h_projTime]
    have h_le_w : val_w ≤ barycentricEnvelope d 1 w z_w :=
      le_csSup hSw_bdd h_mem_w
    have h_rel : (∑ i, θ i * v (mkSpaceTime (y_tilde i) r)) -
        (∑ i, θ i * ‖y_tilde i - x₀‖ ^ 2) / (2 * r) = v z_v + r * val_w := by
      dsimp [val_w]
      rw [hy_val, hy_pen]
      field_simp [hr_ne]
      ring
    rw [h_rel]
    have h_mul : r * val_w ≤ r * barycentricEnvelope d 1 w z_w :=
      mul_le_mul_of_nonneg_left h_le_w (le_of_lt hr)
    linarith
  have h_env_v_ub : barycentricEnvelope d r v z_v ≤ v z_v + r * barycentricEnvelope d 1 w z_w :=
    csSup_le hSv_ne hSv_ub
  have h_env_w_lb : κ ^ 2 / 2 ≤ barycentricEnvelope d 1 w z_w := by
    have h_ineq : r * (κ ^ 2 / 2) ≤ r * barycentricEnvelope d 1 w z_w := by
      dsimp [z_v] at h_env_v_ub
      linarith [h_env_eq, h_env_v_ub]
    exact le_of_mul_le_mul_left h_ineq hr
  have h_env_w_eq : barycentricEnvelope d 1 w z_w = κ ^ 2 / 2 :=
    le_antisymm h_env_w_ub h_env_w_lb
  refine ⟨hw_jensen, ?_⟩
  change barycentricEnvelope d 1 w z_w - w z_w = κ ^ 2 / 2
  rw [h_env_w_eq, hw_zero, sub_zero]

theorem fitted_frame_slope_covariance : ∀ (d : ℕ), 3 ≤ d → ∀ (C₁ : ℝ), 1 ≤ C₁ →
    HasUniformSubquadraticGrowth d C₁ →
    ∀ (v : EuclideanSpace ℝ (Fin (d + 1)) → ℝ) (x₀ p₀ x_end : EuclideanSpace ℝ (Fin d)) (r a₀ : ℝ),
      0 < r →
      let w := fittedFrameTransform d v x₀ r p₀ a₀
      let b₀ := r⁻¹ • (x_end - x₀ + r • p₀)
      InLimitingClassA d C₁ w →
      IsCenteredAt d C₁ w 0 1 →
      ∀ (ℓ : ℝ), 0 < ℓ →
        slopePlus d ℓ w (mkSpaceTime b₀ 0) =
          slopePlus d (r * ℓ) v (mkSpaceTime x_end 0) - a₀ ∧
        slopeMinus d ℓ w (mkSpaceTime b₀ 0) =
          slopeMinus d (r * ℓ) v (mkSpaceTime x_end 0) - a₀ :=
by
  intro d hd C₁ hC₁ h_growth v x₀ p₀ x_end r a₀ hr
  dsimp only
  set w := fittedFrameTransform d v x₀ r p₀ a₀
  set b₀ := r⁻¹ • (x_end - x₀ + r • p₀)
  intro hw_class hw_cent ℓ hℓ
  have hr_ne : r ≠ 0 := ne_of_gt hr
  have hℓ_ne : ℓ ≠ 0 := ne_of_gt hℓ
  have h_projSpace : ∀ (x : EuclideanSpace ℝ (Fin d)) (t : ℝ), projSpace (mkSpaceTime x t) = x := by
    intro x t
    ext i
    simp [projSpace, mkSpaceTime]
  have h_projTime : ∀ (x : EuclideanSpace ℝ (Fin d)) (t : ℝ), projTime (mkSpaceTime x t) = t := by
    intro x t
    simp [projTime, mkSpaceTime]
  have h_cont_mk : ∀ (t : ℝ), Continuous (fun y : EuclideanSpace ℝ (Fin d) => mkSpaceTime y t) := by
    intro t
    unfold mkSpaceTime
    apply (EuclideanSpace.equiv (Fin (d + 1)) ℝ).symm.continuous.comp
    apply continuous_pi
    intro j
    refine Fin.lastCases ?_ ?_ j
    · simp only [Fin.snoc_last]
      exact continuous_const
    · intro i
      simp only [Fin.snoc_castSucc]
      exact (continuous_apply i).comp (EuclideanSpace.equiv (Fin d) ℝ).continuous
  have hrb₀ : r • b₀ = x_end - x₀ + r • p₀ := by
    dsimp [b₀]
    exact smul_inv_smul₀ hr_ne (x_end - x₀ + r • p₀)
  have h_coord_shift : ∀ (y' : EuclideanSpace ℝ (Fin d)) (s : ℝ),
      x₀ + r • (y' + (s - 1) • p₀) = x_end + r • (y' - b₀ + s • p₀) := by
    intro y' s
    have h1 : r • (y' + (s - 1) • p₀) = r • y' + r • (s • p₀) - r • p₀ := by
      rw [smul_add, sub_smul, one_smul, smul_sub]
      abel
    have h2 : r • (y' - b₀ + s • p₀) = r • y' - r • b₀ + r • (s • p₀) := by
      rw [smul_add, smul_sub]
    rw [h1, h2, hrb₀]
    abel
  have h_coord_zero : x₀ + r • (b₀ + (0 - 1 : ℝ) • p₀) = x_end := by
    rw [h_coord_shift b₀ 0, sub_self, zero_smul, add_zero, smul_zero, add_zero]
  let ϕ_plus : EuclideanSpace ℝ (Fin d) → EuclideanSpace ℝ (Fin d) :=
    fun y' => x_end + r • (y' - b₀ + ℓ • p₀)
  let ψ_plus : EuclideanSpace ℝ (Fin d) → EuclideanSpace ℝ (Fin d) :=
    fun y => b₀ - ℓ • p₀ + r⁻¹ • (y - x_end)
  let ϕ_minus : EuclideanSpace ℝ (Fin d) → EuclideanSpace ℝ (Fin d) :=
    fun y' => x_end + r • (y' - b₀ - ℓ • p₀)
  let ψ_minus : EuclideanSpace ℝ (Fin d) → EuclideanSpace ℝ (Fin d) :=
    fun y => b₀ + ℓ • p₀ + r⁻¹ • (y - x_end)
  have hϕψ_plus : ∀ y : EuclideanSpace ℝ (Fin d), ϕ_plus (ψ_plus y) = y := by
    intro y
    dsimp [ϕ_plus, ψ_plus]
    have h_sub : b₀ - ℓ • p₀ + r⁻¹ • (y - x_end) - b₀ + ℓ • p₀ = r⁻¹ • (y - x_end) := by abel
    rw [h_sub, smul_inv_smul₀ hr_ne, add_sub_cancel]
  have hϕψ_minus : ∀ y : EuclideanSpace ℝ (Fin d), ϕ_minus (ψ_minus y) = y := by
    intro y
    dsimp [ϕ_minus, ψ_minus]
    have h_sub : b₀ + ℓ • p₀ + r⁻¹ • (y - x_end) - b₀ - ℓ • p₀ = r⁻¹ • (y - x_end) := by abel
    rw [h_sub, smul_inv_smul₀ hr_ne, add_sub_cancel]
  have hw_b₀ : w (mkSpaceTime b₀ 0) =
      (v (mkSpaceTime x_end 0) - v (mkSpaceTime x₀ r)) / r -
        inner ℝ p₀ b₀ - (a₀ + ‖p₀‖ ^ 2 / 2) * (0 - 1) := by
    change fittedFrameTransform d v x₀ r p₀ a₀ (mkSpaceTime b₀ 0) = _
    unfold fittedFrameTransform
    dsimp only
    rw [h_projSpace, h_projTime, h_coord_zero, mul_zero]
  have hw_plus : ∀ y' : EuclideanSpace ℝ (Fin d),
      w (mkSpaceTime y' ℓ) =
        (v (mkSpaceTime (ϕ_plus y') (r * ℓ)) - v (mkSpaceTime x₀ r)) / r -
          inner ℝ p₀ y' - (a₀ + ‖p₀‖ ^ 2 / 2) * (ℓ - 1) := by
    intro y'
    change fittedFrameTransform d v x₀ r p₀ a₀ (mkSpaceTime y' ℓ) = _
    unfold fittedFrameTransform
    dsimp only
    rw [h_projSpace, h_projTime, h_coord_shift y' ℓ]
  have hw_minus : ∀ y' : EuclideanSpace ℝ (Fin d),
      w (mkSpaceTime y' (-ℓ)) =
        (v (mkSpaceTime (ϕ_minus y') (-(r * ℓ))) - v (mkSpaceTime x₀ r)) / r -
          inner ℝ p₀ y' - (a₀ + ‖p₀‖ ^ 2 / 2) * (-ℓ - 1) := by
    intro y'
    change fittedFrameTransform d v x₀ r p₀ a₀ (mkSpaceTime y' (-ℓ)) = _
    unfold fittedFrameTransform
    dsimp only
    rw [h_projSpace, h_projTime, h_coord_shift y' (-ℓ), neg_smul, ← sub_eq_add_neg, mul_neg]
  have h_norm_plus : ∀ y' : EuclideanSpace ℝ (Fin d),
      ‖ϕ_plus y' - x_end‖ ^ 2 =
        r ^ 2 * (‖y' - b₀‖ ^ 2 + 2 * ℓ * (inner ℝ p₀ y' - inner ℝ p₀ b₀) + ℓ ^ 2 * ‖p₀‖ ^ 2) := by
    intro y'
    have h_sub : ϕ_plus y' - x_end = r • ((y' - b₀) + ℓ • p₀) := by
      dsimp [ϕ_plus]
      exact add_sub_cancel_left x_end (r • (y' - b₀ + ℓ • p₀))
    rw [h_sub, norm_smul, Real.norm_eq_abs, mul_pow, sq_abs, norm_add_sq_real]
    rw [real_inner_smul_right, real_inner_comm p₀ (y' - b₀), inner_sub_right]
    rw [norm_smul, Real.norm_eq_abs, mul_pow, sq_abs]
    ring
  have h_norm_minus : ∀ y' : EuclideanSpace ℝ (Fin d),
      ‖ϕ_minus y' - x_end‖ ^ 2 =
        r ^ 2 * (‖y' - b₀‖ ^ 2 - 2 * ℓ * (inner ℝ p₀ y' - inner ℝ p₀ b₀) + ℓ ^ 2 * ‖p₀‖ ^ 2) := by
    intro y'
    have h_sub : ϕ_minus y' - x_end = r • ((y' - b₀) - ℓ • p₀) := by
      dsimp [ϕ_minus]
      exact add_sub_cancel_left x_end (r • (y' - b₀ - ℓ • p₀))
    rw [h_sub, norm_smul, Real.norm_eq_abs, mul_pow, sq_abs, norm_sub_sq_real]
    rw [real_inner_smul_right, real_inner_comm p₀ (y' - b₀), inner_sub_right]
    rw [norm_smul, Real.norm_eq_abs, mul_pow, sq_abs]
    ring
  set f_w_plus : EuclideanSpace ℝ (Fin d) → ℝ :=
    fun y' => w (mkSpaceTime y' ℓ) - ‖y' - b₀‖ ^ 2 / (2 * ℓ)
  set f_v_plus : EuclideanSpace ℝ (Fin d) → ℝ :=
    fun y => v (mkSpaceTime y (r * ℓ)) - ‖y - x_end‖ ^ 2 / (2 * (r * ℓ))
  set f_w_minus : EuclideanSpace ℝ (Fin d) → ℝ :=
    fun y' => w (mkSpaceTime y' (-ℓ)) + ‖y' - b₀‖ ^ 2 / (2 * ℓ)
  set f_v_minus : EuclideanSpace ℝ (Fin d) → ℝ :=
    fun y => v (mkSpaceTime y (-(r * ℓ))) + ‖y - x_end‖ ^ 2 / (2 * (r * ℓ))
  have h_id_plus : ∀ y' : EuclideanSpace ℝ (Fin d),
      f_v_plus (ϕ_plus y') =
        v (mkSpaceTime x_end 0) + r * (f_w_plus y' - w (mkSpaceTime b₀ 0) + a₀ * ℓ) := by
    intro y'
    dsimp [f_v_plus, f_w_plus]
    rw [h_norm_plus y', hw_plus y', hw_b₀]
    field_simp [hr_ne, hℓ_ne]
    ring
  have h_id_minus : ∀ y' : EuclideanSpace ℝ (Fin d),
      f_v_minus (ϕ_minus y') =
        v (mkSpaceTime x_end 0) - r * (w (mkSpaceTime b₀ 0) - f_w_minus y' + a₀ * ℓ) := by
    intro y'
    dsimp [f_v_minus, f_w_minus]
    rw [h_norm_minus y', hw_minus y', hw_b₀]
    field_simp [hr_ne, hℓ_ne]
    ring
  have h_bdd_phi : ∀ (σ t : ℝ), |σ| = 1 → |t| ≤ ℓ →
      ∃ B : ℝ, ∀ y' : EuclideanSpace ℝ (Fin d),
        σ * w (mkSpaceTime y' t) - ‖y' - b₀‖ ^ 2 / (2 * ℓ) ≤ B := by
    intro σ t hσ ht
    have hε_pos : 0 < 1 / (4 * ℓ) := by positivity
    obtain ⟨M, hM_pos, hM_bound⟩ := h_growth ℓ (le_of_lt hℓ) (1 / (4 * ℓ)) hε_pos
    let K : Set (EuclideanSpace ℝ (Fin d)) := Metric.closedBall 0 M
    let Φ : EuclideanSpace ℝ (Fin d) → ℝ :=
      fun y' => σ * w (mkSpaceTime y' t) - ‖y' - b₀‖ ^ 2 / (2 * ℓ)
    have hΦ_cont : Continuous Φ :=
      (continuous_const.mul (hw_class.1.comp (h_cont_mk t))).sub
        (((continuous_id.sub continuous_const).norm.pow 2).div_const (2 * ℓ))
    obtain ⟨B_K, hB_K⟩ :=
      (isCompact_closedBall (0 : EuclideanSpace ℝ (Fin d)) M).bddAbove_image hΦ_cont.continuousOn
    refine ⟨max B_K (‖b₀‖ ^ 2 / (2 * ℓ)), fun y' => ?_⟩
    by_cases hy' : ‖y'‖ ≤ M
    · have hy'K : y' ∈ K := by simpa [K, mem_closedBall_zero_iff] using hy'
      exact le_trans (hB_K ⟨y', hy'K, rfl⟩) (le_max_left _ _)
    · push_neg at hy'
      have hw_abs : |w (mkSpaceTime y' t)| ≤ (1 / (4 * ℓ)) * ‖y'‖ ^ 2 :=
        hM_bound w hw_class hw_cent y' t ht (le_of_lt hy')
      have hw_y' : σ * w (mkSpaceTime y' t) ≤ ‖y'‖ ^ 2 / (4 * ℓ) := by
        have h1 : σ * w (mkSpaceTime y' t) ≤ |σ * w (mkSpaceTime y' t)| := le_abs_self _
        rw [abs_mul, hσ, one_mul] at h1
        rw [one_div_mul_eq_div] at hw_abs
        linarith
      have h_tri : ‖y'‖ ≤ ‖y' - b₀‖ + ‖b₀‖ := by
        simpa [sub_add_cancel] using norm_add_le (y' - b₀) b₀
      have h_sq : ‖y'‖ ^ 2 ≤ 2 * ‖y' - b₀‖ ^ 2 + 2 * ‖b₀‖ ^ 2 := by
        have h1 : 0 ≤ ‖y'‖ := norm_nonneg y'
        have h2 : 0 ≤ (‖y' - b₀‖ - ‖b₀‖) ^ 2 := sq_nonneg _
        nlinarith
      have h_div : ‖y'‖ ^ 2 / (4 * ℓ) ≤ ‖y' - b₀‖ ^ 2 / (2 * ℓ) + ‖b₀‖ ^ 2 / (2 * ℓ) := by
        have h_eq : ‖y' - b₀‖ ^ 2 / (2 * ℓ) + ‖b₀‖ ^ 2 / (2 * ℓ) =
            (2 * ‖y' - b₀‖ ^ 2 + 2 * ‖b₀‖ ^ 2) / (4 * ℓ) := by
          field_simp [hℓ_ne]
          ring
        rw [h_eq]
        exact div_le_div_of_nonneg_right h_sq (by positivity)
      have h_le : Φ y' ≤ ‖b₀‖ ^ 2 / (2 * ℓ) := by
        dsimp [Φ]
        linarith
      exact le_trans h_le (le_max_right _ _)
  have h_bdd_w_plus : BddAbove (f_w_plus '' Set.univ) := by
    obtain ⟨B_plus, hB_plus⟩ := h_bdd_phi 1 ℓ (by norm_num) (by rw [abs_of_pos hℓ])
    refine ⟨B_plus, ?_⟩
    rintro _ ⟨y', _, rfl⟩
    have h1 := hB_plus y'
    dsimp [f_w_plus]
    linarith
  have h_bdd_w_minus : BddBelow (f_w_minus '' Set.univ) := by
    obtain ⟨B_minus, hB_minus⟩ := h_bdd_phi (-1) (-ℓ) (by norm_num) (by rw [abs_neg, abs_of_pos hℓ])
    refine ⟨-B_minus, ?_⟩
    rintro _ ⟨y', _, rfl⟩
    have h1 := hB_minus y'
    dsimp [f_w_minus]
    linarith
  have h_v_plus_ub : ∀ y : EuclideanSpace ℝ (Fin d),
      f_v_plus y ≤ v (mkSpaceTime x_end 0) +
        r * (sSup (f_w_plus '' Set.univ) - w (mkSpaceTime b₀ 0) + a₀ * ℓ) := by
    intro y
    have h_id := h_id_plus (ψ_plus y)
    rw [hϕψ_plus y] at h_id
    have h_le : f_w_plus (ψ_plus y) ≤ sSup (f_w_plus '' Set.univ) :=
      le_csSup h_bdd_w_plus ⟨ψ_plus y, Set.mem_univ _, rfl⟩
    nlinarith
  have h_bdd_v_plus : BddAbove (f_v_plus '' Set.univ) := by
    refine ⟨v (mkSpaceTime x_end 0) +
      r * (sSup (f_w_plus '' Set.univ) - w (mkSpaceTime b₀ 0) + a₀ * ℓ), ?_⟩
    rintro _ ⟨y, _, rfl⟩
    exact h_v_plus_ub y
  have h_sup_v_le : sSup (f_v_plus '' Set.univ) ≤
      v (mkSpaceTime x_end 0) +
        r * (sSup (f_w_plus '' Set.univ) - w (mkSpaceTime b₀ 0) + a₀ * ℓ) := by
    apply csSup_le (Set.univ_nonempty.image _)
    rintro _ ⟨y, _, rfl⟩
    exact h_v_plus_ub y
  have h_sup_w_le : sSup (f_w_plus '' Set.univ) ≤
      (sSup (f_v_plus '' Set.univ) - v (mkSpaceTime x_end 0) +
        r * (w (mkSpaceTime b₀ 0) - a₀ * ℓ)) / r := by
    apply csSup_le (Set.univ_nonempty.image _)
    rintro _ ⟨y', _, rfl⟩
    rw [le_div_iff₀' hr]
    have h_id := h_id_plus y'
    have h_le : f_v_plus (ϕ_plus y') ≤ sSup (f_v_plus '' Set.univ) :=
      le_csSup h_bdd_v_plus ⟨ϕ_plus y', Set.mem_univ _, rfl⟩
    linarith
  have h_sup_v_ge : v (mkSpaceTime x_end 0) +
      r * (sSup (f_w_plus '' Set.univ) - w (mkSpaceTime b₀ 0) + a₀ * ℓ) ≤
        sSup (f_v_plus '' Set.univ) := by
    have h_mul := (le_div_iff₀' hr).mp h_sup_w_le
    linarith
  have h_sup_eq : sSup (f_v_plus '' Set.univ) =
      v (mkSpaceTime x_end 0) +
        r * (sSup (f_w_plus '' Set.univ) - w (mkSpaceTime b₀ 0) + a₀ * ℓ) :=
    le_antisymm h_sup_v_le h_sup_v_ge
  have h_v_minus_lb : ∀ y : EuclideanSpace ℝ (Fin d),
      v (mkSpaceTime x_end 0) -
        r * (w (mkSpaceTime b₀ 0) - sInf (f_w_minus '' Set.univ) + a₀ * ℓ) ≤ f_v_minus y := by
    intro y
    have h_id := h_id_minus (ψ_minus y)
    rw [hϕψ_minus y] at h_id
    have h_ge : sInf (f_w_minus '' Set.univ) ≤ f_w_minus (ψ_minus y) :=
      csInf_le h_bdd_w_minus ⟨ψ_minus y, Set.mem_univ _, rfl⟩
    nlinarith
  have h_bdd_v_minus : BddBelow (f_v_minus '' Set.univ) := by
    refine ⟨v (mkSpaceTime x_end 0) -
      r * (w (mkSpaceTime b₀ 0) - sInf (f_w_minus '' Set.univ) + a₀ * ℓ), ?_⟩
    rintro _ ⟨y, _, rfl⟩
    exact h_v_minus_lb y
  have h_inf_v_ge : v (mkSpaceTime x_end 0) -
      r * (w (mkSpaceTime b₀ 0) - sInf (f_w_minus '' Set.univ) + a₀ * ℓ) ≤
        sInf (f_v_minus '' Set.univ) := by
    apply le_csInf (Set.univ_nonempty.image _)
    rintro _ ⟨y, _, rfl⟩
    exact h_v_minus_lb y
  have h_inf_w_ge : (sInf (f_v_minus '' Set.univ) - v (mkSpaceTime x_end 0) +
      r * (w (mkSpaceTime b₀ 0) + a₀ * ℓ)) / r ≤ sInf (f_w_minus '' Set.univ) := by
    apply le_csInf (Set.univ_nonempty.image _)
    rintro _ ⟨y', _, rfl⟩
    rw [div_le_iff₀' hr]
    have h_id := h_id_minus y'
    have h_ge : sInf (f_v_minus '' Set.univ) ≤ f_v_minus (ϕ_minus y') :=
      csInf_le h_bdd_v_minus ⟨ϕ_minus y', Set.mem_univ _, rfl⟩
    linarith
  have h_inf_v_le : sInf (f_v_minus '' Set.univ) ≤
      v (mkSpaceTime x_end 0) -
        r * (w (mkSpaceTime b₀ 0) - sInf (f_w_minus '' Set.univ) + a₀ * ℓ) := by
    have h_mul := (div_le_iff₀' hr).mp h_inf_w_ge
    linarith
  have h_inf_eq : sInf (f_v_minus '' Set.univ) =
      v (mkSpaceTime x_end 0) -
        r * (w (mkSpaceTime b₀ 0) - sInf (f_w_minus '' Set.univ) + a₀ * ℓ) :=
    le_antisymm h_inf_v_le h_inf_v_ge
  have h_qplus_w : quadEnvelopePlus d ℓ w (mkSpaceTime b₀ 0) = sSup (f_w_plus '' Set.univ) := by
    unfold quadEnvelopePlus
    rw [h_projTime, h_projSpace, zero_add]
  have h_qplus_v : quadEnvelopePlus d (r * ℓ) v (mkSpaceTime x_end 0) = sSup (f_v_plus '' Set.univ) := by
    unfold quadEnvelopePlus
    rw [h_projTime, h_projSpace, zero_add]
  have h_qminus_w : quadEnvelopeMinus d ℓ w (mkSpaceTime b₀ 0) = sInf (f_w_minus '' Set.univ) := by
    unfold quadEnvelopeMinus
    rw [h_projTime, h_projSpace, zero_sub]
  have h_qminus_v : quadEnvelopeMinus d (r * ℓ) v (mkSpaceTime x_end 0) = sInf (f_v_minus '' Set.univ) := by
    unfold quadEnvelopeMinus
    rw [h_projTime, h_projSpace, zero_sub]
  constructor
  · unfold slopePlus
    rw [h_qplus_w, h_qplus_v, h_sup_eq]
    field_simp [hr_ne, hℓ_ne]
    ring
  · unfold slopeMinus
    rw [h_qminus_w, h_qminus_v, h_inf_eq]
    field_simp [hr_ne, hℓ_ne]
    ring

theorem fitted_frame_covariance_and_centering : ∀ (d : ℕ), 3 ≤ d → ∀ (C₁ : ℝ), 1 ≤ C₁ → ∀ (κ : ℝ), 0 < κ →
      HasUniformSubquadraticGrowth d C₁ →
      ∀ (v : EuclideanSpace ℝ (Fin (d + 1)) → ℝ),
        InLimitingClassA d C₁ v → HasHorizontalJensenBound d κ v →
        ∀ (x₀ p₀ x_end : EuclideanSpace ℝ (Fin d)) (r a₀ K : ℝ),
          0 < r →
          shiftedBarycentricEnvelope d κ v (mkSpaceTime x₀ r) = v (mkSpaceTime x₀ r) →
          IsFitAt d C₁ v x₀ r r p₀ a₀ →
          ‖x_end - x₀ + r • p₀‖ ≤ K * r →
          let w := fittedFrameTransform d v x₀ r p₀ a₀
          let b₀ := r⁻¹ • (x_end - x₀ + r • p₀)
          InLimitingClassA d C₁ w ∧
          IsCenteredAt d C₁ w 0 1 ∧
          HasHorizontalJensenBound d κ w ∧
          barycentricEnvelope d 1 w (mkSpaceTime 0 1) - w (mkSpaceTime 0 1) = κ ^ 2 / 2 ∧
          ‖b₀‖ ≤ K ∧
          (∀ ℓ : ℝ, 0 < ℓ →
            slopePlus d ℓ w (mkSpaceTime b₀ 0) =
              slopePlus d (r * ℓ) v (mkSpaceTime x_end 0) - a₀ ∧
            slopeMinus d ℓ w (mkSpaceTime b₀ 0) =
              slopeMinus d (r * ℓ) v (mkSpaceTime x_end 0) - a₀) :=
by
  intro d hd C₁ hC₁ κ hκ h_growth v hv_class hv_jensen x₀ p₀ x_end r a₀ K hr h_env h_fit h_loc
  dsimp only
  set w := fittedFrameTransform d v x₀ r p₀ a₀
  set b₀ := r⁻¹ • (x_end - x₀ + r • p₀)
  obtain ⟨hw_cont, hw_cent, hw_fits⟩ :=
    fitted_frame_fits_and_centering d C₁ v hv_class.1 hv_class.2.2.2 x₀ p₀ r a₀ hr h_fit
  obtain ⟨hw_sub, hw_super⟩ :=
    fitted_frame_viscosity_covariance d C₁ v hv_class x₀ p₀ r a₀ hr
  have hw_class : InLimitingClassA d C₁ w := ⟨hw_cont, hw_sub, hw_super, hw_fits⟩
  obtain ⟨hw_jensen, hw_gap⟩ :=
    fitted_frame_barycentric_covariance d κ hκ v hv_jensen x₀ p₀ r a₀ hr h_env
  have hb₀ : ‖b₀‖ ≤ K := by
    have hr_inv_nonneg : 0 ≤ r⁻¹ := le_of_lt (inv_pos.mpr hr)
    calc ‖b₀‖
      _ = ‖r⁻¹ • (x_end - x₀ + r • p₀)‖ := rfl
      _ = ‖r⁻¹‖ * ‖x_end - x₀ + r • p₀‖ := norm_smul r⁻¹ (x_end - x₀ + r • p₀)
      _ = r⁻¹ * ‖x_end - x₀ + r • p₀‖ := by
          rw [Real.norm_eq_abs, abs_of_nonneg hr_inv_nonneg]
      _ ≤ r⁻¹ * (K * r) := mul_le_mul_of_nonneg_left h_loc hr_inv_nonneg
      _ = K * (r⁻¹ * r) := by ring
      _ = K := by rw [inv_mul_cancel₀ (ne_of_gt hr), mul_one]
  have hw_slopes : ∀ ℓ : ℝ, 0 < ℓ →
      slopePlus d ℓ w (mkSpaceTime b₀ 0) =
        slopePlus d (r * ℓ) v (mkSpaceTime x_end 0) - a₀ ∧
      slopeMinus d ℓ w (mkSpaceTime b₀ 0) =
        slopeMinus d (r * ℓ) v (mkSpaceTime x_end 0) - a₀ :=
    fitted_frame_slope_covariance d hd C₁ hC₁ h_growth v x₀ p₀ x_end r a₀ hr hw_class hw_cent
  exact ⟨hw_class, hw_cent, hw_jensen, hw_gap, hb₀, hw_slopes⟩

theorem uniform_box_and_fit_bounds_of_subquadratic_growth : ∀ (d : ℕ), 3 ≤ d → ∀ (C₁ : ℝ), 1 ≤ C₁ →
      HasUniformSubquadraticGrowth d C₁ → HasUniformBoxAndFitBounds d C₁ :=
by
  intro d hd C₁ hC₁ h_growth
  have hC₁_nonneg : (0 : ℝ) ≤ C₁ := by linarith
  have h_mk_proj : ∀ z : EuclideanSpace ℝ (Fin (d + 1)),
      mkSpaceTime (projSpace z) (projTime z) = z := by
    intro z
    ext j
    refine Fin.lastCases ?_ ?_ j
    · simp [mkSpaceTime, projTime]
    · intro i
      simp [mkSpaceTime, projSpace]
  have h_box_bound :
      ∀ (M : ℝ), 0 ≤ M →
        ∃ (U_M : ℝ), 0 ≤ U_M ∧
          ∀ (w : EuclideanSpace ℝ (Fin (d + 1)) → ℝ),
            InLimitingClassA d C₁ w → IsCenteredAt d C₁ w 0 1 →
            ∀ (x : EuclideanSpace ℝ (Fin d)) (t : ℝ),
              ‖x‖ ≤ M → |t| ≤ M → |w (mkSpaceTime x t)| ≤ U_M := by
    intro M hM
    obtain ⟨M₀, hM₀_pos, hM₀⟩ := h_growth M hM 1 zero_lt_one
    let R : ℝ := max M M₀
    have hM_le_R : M ≤ R := le_max_left M M₀
    have hM₀_le_R : M₀ ≤ R := le_max_right M M₀
    have hR_pos : 0 < R := lt_of_lt_of_le hM₀_pos hM₀_le_R
    have h2R_pos : 0 < 2 * R := by linarith
    let U_M : ℝ := 9 * R ^ 2 + 2 * C₁ * R
    refine ⟨U_M, by positivity, ?_⟩
    intro w hw hw_cent x t hx ht
    obtain ⟨p, a, hfit⟩ := hw.2.2.2 x t (2 * R) h2R_pos
    let i₀ : Fin d := ⟨0, by omega⟩
    let e₀ : EuclideanSpace ℝ (Fin d) := EuclideanSpace.single i₀ (1 : ℝ)
    have he₀_norm : ‖e₀‖ = 1 := by
      dsimp [e₀]
      rw [PiLp.norm_single]
      simp
    let h : EuclideanSpace ℝ (Fin d) := (2 * R) • e₀
    have hh_norm : ‖h‖ = 2 * R := by
      dsimp [h]
      rw [norm_smul, Real.norm_eq_abs, abs_of_pos h2R_pos, he₀_norm, mul_one]
    have h0_le : |(0 : ℝ)| ≤ 2 * R := by simp [le_of_lt h2R_pos]
    have hh_ad : ‖h - (0 : ℝ) • p‖ ≤ 2 * R := by simp [hh_norm]
    have hnh_ad : ‖-h - (0 : ℝ) • p‖ ≤ 2 * R := by simp [hh_norm]
    have hfit_pos :
        |w (mkSpaceTime (x + h) (t + 0)) - w (mkSpaceTime x t) -
          inner ℝ p h - (a - ‖p‖ ^ 2 / 2) * 0| ≤ C₁ * (2 * R) :=
      hfit h 0 h0_le hh_ad
    have hfit_neg :
        |w (mkSpaceTime (x + -h) (t + 0)) - w (mkSpaceTime x t) -
          inner ℝ p (-h) - (a - ‖p‖ ^ 2 / 2) * 0| ≤ C₁ * (2 * R) :=
      hfit (-h) 0 h0_le hnh_ad
    rw [add_zero, mul_zero, sub_zero] at hfit_pos hfit_neg
    rw [inner_neg_right] at hfit_neg
    have hb_pos := abs_le.mp hfit_pos
    have hb_neg := abs_le.mp hfit_neg
    have hxh_ub : ‖x + h‖ ≤ 3 * R := by
      have := norm_add_le x h
      linarith
    have hxh_lb : M₀ ≤ ‖x + h‖ := by
      have h1 := norm_sub_le (x + h) x
      rw [add_sub_cancel_left] at h1
      linarith
    have hxnh_ub : ‖x + -h‖ ≤ 3 * R := by
      have h1 := norm_add_le x (-h)
      rw [norm_neg] at h1
      linarith
    have hxnh_lb : M₀ ≤ ‖x + -h‖ := by
      have h1 := norm_sub_le (x + -h) x
      rw [add_sub_cancel_left, norm_neg] at h1
      linarith
    have hw_pos : |w (mkSpaceTime (x + h) t)| ≤ 9 * R ^ 2 := by
      have h1 := hM₀ w hw hw_cent (x + h) t ht hxh_lb
      have h2 : ‖x + h‖ ^ 2 ≤ (3 * R) ^ 2 := pow_le_pow_left₀ (norm_nonneg _) hxh_ub 2
      linarith
    have hw_neg : |w (mkSpaceTime (x + -h) t)| ≤ 9 * R ^ 2 := by
      have h1 := hM₀ w hw hw_cent (x + -h) t ht hxnh_lb
      have h2 : ‖x + -h‖ ^ 2 ≤ (3 * R) ^ 2 := pow_le_pow_left₀ (norm_nonneg _) hxnh_ub 2
      linarith
    have hwp := abs_le.mp hw_pos
    have hwn := abs_le.mp hw_neg
    dsimp [U_M]
    rw [abs_le]
    constructor <;> linarith [hb_pos.1, hb_pos.2, hb_neg.1, hb_neg.2, hwp.1, hwp.2, hwn.1, hwn.2]
  have h_fit_bound :
      ∀ (M R : ℝ), 0 ≤ M → 0 < R →
        ∃ (B_MR : ℝ), 0 ≤ B_MR ∧
          ∀ (w : EuclideanSpace ℝ (Fin (d + 1)) → ℝ),
            InLimitingClassA d C₁ w → IsCenteredAt d C₁ w 0 1 →
            ∀ (x : EuclideanSpace ℝ (Fin d)) (t : ℝ)
              (p : EuclideanSpace ℝ (Fin d)) (a : ℝ),
              ‖x‖ ≤ M → |t| ≤ M → IsFitAt d C₁ w x t R p a →
              ‖p‖ ≤ B_MR ∧ |a| ≤ B_MR := by
    intro M R hM hR
    obtain ⟨U₁, hU₁_nn, hU₁⟩ := h_box_bound (M + R) (by linarith)
    let P₁ : ℝ := 2 * U₁ / R + C₁
    have hP₁_nn : 0 ≤ P₁ := by positivity
    obtain ⟨U₂, hU₂_nn, hU₂⟩ := h_box_bound (M + R * (1 + P₁)) (by positivity)
    let A₁ : ℝ := 2 * U₂ / R + C₁ + P₁ ^ 2 / 2
    have hA₁_nn : 0 ≤ A₁ := by positivity
    let B_MR : ℝ := max P₁ A₁
    refine ⟨B_MR, le_trans hP₁_nn (le_max_left P₁ A₁), ?_⟩
    intro w hw hw_cent x t p a hx ht hfit
    have hp_le : ‖p‖ ≤ P₁ := by
      by_cases hp : ‖p‖ = 0
      · linarith
      · have hp_pos : 0 < ‖p‖ := norm_pos_iff.mpr (fun h0 => hp (by simp [h0]))
        let h : EuclideanSpace ℝ (Fin d) := (R / ‖p‖) • p
        have hh_norm : ‖h‖ = R := by
          dsimp [h]
          rw [norm_smul, Real.norm_eq_abs, abs_of_pos (div_pos hR hp_pos),
            div_mul_cancel₀ R (ne_of_gt hp_pos)]
        have h0_le : |(0 : ℝ)| ≤ R := by simp [le_of_lt hR]
        have hh_ad : ‖h - (0 : ℝ) • p‖ ≤ R := by simp [hh_norm]
        have h_ev := hfit h 0 h0_le hh_ad
        rw [add_zero, mul_zero, sub_zero] at h_ev
        have h_ip : inner ℝ p h = R * ‖p‖ := by
          dsimp [h]
          rw [real_inner_smul_right, real_inner_self_eq_norm_sq, sq, ← mul_assoc,
            div_mul_cancel₀ R (ne_of_gt hp_pos)]
        rw [h_ip] at h_ev
        have hxh_norm : ‖x + h‖ ≤ M + R := by
          have := norm_add_le x h
          linarith
        have hw1 := abs_le.mp (hU₁ w hw hw_cent (x + h) t hxh_norm (by linarith))
        have hw0 := abs_le.mp (hU₁ w hw hw_cent x t (by linarith) (by linarith))
        have h_ev_abs := abs_le.mp h_ev
        have hPR : P₁ * R = 2 * U₁ + C₁ * R := by
          dsimp [P₁]
          have hR_ne : R ≠ 0 := ne_of_gt hR
          field_simp [hR_ne]
        have h_mul : ‖p‖ * R ≤ P₁ * R := by
          linarith [h_ev_abs.1, hw1.2, hw0.1, hPR]
        exact le_of_mul_le_mul_right h_mul hR
    have ha_le : |a| ≤ A₁ := by
      let h : EuclideanSpace ℝ (Fin d) := R • p
      have hR_abs : |R| ≤ R := by rw [abs_of_pos hR]
      have hh_ad : ‖h - R • p‖ ≤ R := by simp [h, le_of_lt hR]
      have h_ev := hfit h R hR_abs hh_ad
      have h_ip : inner ℝ p h = R * ‖p‖ ^ 2 := by
        dsimp [h]
        rw [real_inner_smul_right, real_inner_self_eq_norm_sq]
      have h_alg :
          w (mkSpaceTime (x + h) (t + R)) - w (mkSpaceTime x t) -
            inner ℝ p h - (a - ‖p‖ ^ 2 / 2) * R =
          w (mkSpaceTime (x + h) (t + R)) - w (mkSpaceTime x t) -
            (a + ‖p‖ ^ 2 / 2) * R := by
        rw [h_ip]
        ring
      rw [h_alg] at h_ev
      have hh_norm : ‖h‖ ≤ R * P₁ := by
        dsimp [h]
        rw [norm_smul, Real.norm_eq_abs, abs_of_pos hR]
        exact mul_le_mul_of_nonneg_left hp_le (le_of_lt hR)
      have hxh_norm : ‖x + h‖ ≤ M + R * (1 + P₁) := by
        have := norm_add_le x h
        nlinarith
      have htR_abs : |t + R| ≤ M + R * (1 + P₁) := by
        have h1 := abs_add_le t R
        rw [abs_of_pos hR] at h1
        nlinarith
      have hw1 := abs_le.mp (hU₂ w hw hw_cent (x + h) (t + R) hxh_norm htR_abs)
      have hw0 := abs_le.mp (hU₂ w hw hw_cent x t (by nlinarith) (by nlinarith))
      have h_ev_abs := abs_le.mp h_ev
      have hp_sq : ‖p‖ ^ 2 ≤ P₁ ^ 2 := pow_le_pow_left₀ (norm_nonneg _) hp_le 2
      have hp_sq_nn : 0 ≤ ‖p‖ ^ 2 := sq_nonneg _
      have hAR : A₁ * R = 2 * U₂ + C₁ * R + (P₁ ^ 2 / 2) * R := by
        dsimp [A₁]
        have hR_ne : R ≠ 0 := ne_of_gt hR
        field_simp [hR_ne]
      have ha_low : ( -A₁ ) * R ≤ a * R := by
        nlinarith [h_ev_abs.2, hw1.1, hw0.2, hp_sq, hp_sq_nn, hAR]
      have ha_high : a * R ≤ A₁ * R := by
        nlinarith [h_ev_abs.1, hw1.2, hw0.1, hp_sq, hp_sq_nn, hAR]
      rw [abs_le]
      exact ⟨le_of_mul_le_mul_right ha_low hR, le_of_mul_le_mul_right ha_high hR⟩
    exact ⟨le_trans hp_le (le_max_left P₁ A₁), le_trans ha_le (le_max_right P₁ A₁)⟩
  refine ⟨?_, h_fit_bound⟩
  intro M hM
  obtain ⟨U_M, hU_nn, hU⟩ := h_box_bound M hM
  refine ⟨U_M, hU_nn, ?_⟩
  intro w hw hw_cent z hzx hzt
  rw [← h_mk_proj z]
  exact hU w hw hw_cent (projSpace z) (projTime z) hzx hzt

theorem uniform_equicontinuity_of_centered_class_A : ∀ (d : ℕ), 3 ≤ d → ∀ (C₁ : ℝ), 1 ≤ C₁ →
      HasUniformBoxAndFitBounds d C₁ → HasUniformBoxEquicontinuity d C₁ :=
by
  intro d _hd C₁ hC₁ h_bounds M hM ε hε
  have h_mk_proj : ∀ z : EuclideanSpace ℝ (Fin (d + 1)),
      mkSpaceTime (projSpace z) (projTime z) = z := by
    intro z
    ext j
    refine Fin.lastCases ?_ ?_ j
    · simp [mkSpaceTime, projTime]
    · intro i
      simp [mkSpaceTime, projSpace]
  have h_two_scale :
      ∀ (w : EuclideanSpace ℝ (Fin (d + 1)) → ℝ)
        (x₀ : EuclideanSpace ℝ (Fin d)) (t₀ R : ℝ), 0 < R →
        ∀ (p p' : EuclideanSpace ℝ (Fin d)) (a a' : ℝ),
          IsFitAt d C₁ w x₀ t₀ R p a →
          IsFitAt d C₁ w x₀ t₀ (2 * R) p' a' →
          ‖p' - p‖ ≤ 3 * C₁ ∧
          |a' - a| ≤ 3 * C₁ * (1 + 3 * C₁) + (9 / 2) * C₁ ^ 2 := by
    intro w x₀ t₀ R hR p p' a a' hfit1 hfit2
    have h_horiz : ∀ h : EuclideanSpace ℝ (Fin d), ‖h‖ ≤ R →
        inner ℝ (p' - p) h ≤ 3 * C₁ * R := by
      intro h hh
      have h0_le_R : |(0 : ℝ)| ≤ R := by simp [le_of_lt hR]
      have h0_le_2R : |(0 : ℝ)| ≤ 2 * R := by simp; linarith
      have hh1 : ‖h - (0 : ℝ) • p‖ ≤ R := by simpa using hh
      have hh2 : ‖h - (0 : ℝ) • p'‖ ≤ 2 * R := by
        have : ‖h - (0 : ℝ) • p'‖ = ‖h‖ := by simp
        linarith
      have hb1 := abs_le.mp (hfit1 h 0 h0_le_R hh1)
      have hb2 := abs_le.mp (hfit2 h 0 h0_le_2R hh2)
      rw [inner_sub_left]
      linarith
    have hp_diff : ‖p' - p‖ ≤ 3 * C₁ := by
      by_cases hp : ‖p' - p‖ = 0
      · linarith
      · have hp_pos : 0 < ‖p' - p‖ := norm_pos_iff.mpr (fun h_eq => hp (by simp [h_eq]))
        let h : EuclideanSpace ℝ (Fin d) := (R / ‖p' - p‖) • (p' - p)
        have hh_norm : ‖h‖ ≤ R := by
          dsimp [h]
          rw [norm_smul, Real.norm_eq_abs, abs_of_pos (div_pos hR hp_pos),
            div_mul_cancel₀ R (ne_of_gt hp_pos)]
        have h_in := h_horiz h hh_norm
        have h_eval : inner ℝ (p' - p) h = R * ‖p' - p‖ := by
          dsimp [h]
          rw [real_inner_smul_right, real_inner_self_eq_norm_sq]
          rw [sq, ← mul_assoc, div_mul_cancel₀ R (ne_of_gt hp_pos)]
        rw [h_eval] at h_in
        nlinarith
    refine ⟨hp_diff, ?_⟩
    have h_denom_pos : 0 < 1 + 3 * C₁ := by linarith
    let ℓ : ℝ := R / (1 + 3 * C₁)
    have hℓ_pos : 0 < ℓ := div_pos hR h_denom_pos
    have hℓ_mul : ℓ * (1 + 3 * C₁) = R := div_mul_cancel₀ R (ne_of_gt h_denom_pos)
    have hℓ_le_R : ℓ ≤ R := by nlinarith
    have hℓ_abs_R : |ℓ| ≤ R := by rw [abs_of_pos hℓ_pos]; exact hℓ_le_R
    have hℓ_abs_2R : |ℓ| ≤ 2 * R := by rw [abs_of_pos hℓ_pos]; linarith
    let h : EuclideanSpace ℝ (Fin d) := ℓ • p
    have hh1 : ‖h - ℓ • p‖ ≤ R := by simp [h, le_of_lt hR]
    have hh2 : ‖h - ℓ • p'‖ ≤ 2 * R := by
      have h_eq : h - ℓ • p' = ℓ • (p - p') := by simp [h, smul_sub]
      rw [h_eq, norm_smul, Real.norm_eq_abs, abs_of_pos hℓ_pos, norm_sub_rev]
      nlinarith
    have hb1 := abs_le.mp (hfit1 h ℓ hℓ_abs_R hh1)
    have hb2 := abs_le.mp (hfit2 h ℓ hℓ_abs_2R hh2)
    have h_ip1 : inner ℝ p h = ℓ * ‖p‖ ^ 2 := by
      dsimp [h]
      rw [real_inner_smul_right, real_inner_self_eq_norm_sq]
    have h_ip2 : inner ℝ p' h = ℓ * inner ℝ p' p := by
      dsimp [h]
      rw [real_inner_smul_right]
    have h_norm_sub : ‖p' - p‖ ^ 2 = ‖p'‖ ^ 2 - 2 * inner ℝ p' p + ‖p‖ ^ 2 :=
      norm_sub_sq_real p' p
    have h_diff_id :
        (w (mkSpaceTime (x₀ + h) (t₀ + ℓ)) - w (mkSpaceTime x₀ t₀) -
          inner ℝ p h - (a - ‖p‖ ^ 2 / 2) * ℓ) -
        (w (mkSpaceTime (x₀ + h) (t₀ + ℓ)) - w (mkSpaceTime x₀ t₀) -
          inner ℝ p' h - (a' - ‖p'‖ ^ 2 / 2) * ℓ) =
        (a' - a - ‖p' - p‖ ^ 2 / 2) * ℓ := by
      rw [h_ip1, h_ip2, h_norm_sub]
      ring
    have h3R : 3 * C₁ * R = (3 * C₁ * (1 + 3 * C₁)) * ℓ := by
      rw [← hℓ_mul]
      ring
    have h_bd_low : (-(3 * C₁ * (1 + 3 * C₁))) * ℓ ≤ (a' - a - ‖p' - p‖ ^ 2 / 2) * ℓ := by
      linarith [hb1.1, hb2.2, h_diff_id, h3R]
    have h_bd_high : (a' - a - ‖p' - p‖ ^ 2 / 2) * ℓ ≤ (3 * C₁ * (1 + 3 * C₁)) * ℓ := by
      linarith [hb1.2, hb2.1, h_diff_id, h3R]
    have h_cancel_low : -(3 * C₁ * (1 + 3 * C₁)) ≤ a' - a - ‖p' - p‖ ^ 2 / 2 :=
      le_of_mul_le_mul_right h_bd_low hℓ_pos
    have h_cancel_high : a' - a - ‖p' - p‖ ^ 2 / 2 ≤ 3 * C₁ * (1 + 3 * C₁) :=
      le_of_mul_le_mul_right h_bd_high hℓ_pos
    have h_sq_le : ‖p' - p‖ ^ 2 ≤ 9 * C₁ ^ 2 := by
      have h_nn : 0 ≤ ‖p' - p‖ := norm_nonneg _
      nlinarith
    have h_sq_nn : 0 ≤ ‖p' - p‖ ^ 2 := sq_nonneg _
    rw [abs_le]
    constructor <;> linarith
  have h_ind_54 : ∀ k : ℕ, (k : ℝ) + 4 ≤ 4 * (5 / 4 : ℝ) ^ k := by
    intro k
    induction' k with k ih
    · norm_num
    · push_cast
      rw [pow_succ']
      have hk_nn : (0 : ℝ) ≤ (k : ℝ) := Nat.cast_nonneg k
      linarith
  have h_ind_3225 : ∀ k : ℕ, 1 + (7 / 25 : ℝ) * (k : ℝ) ≤ (32 / 25 : ℝ) ^ k := by
    intro k
    induction' k with k ih
    · norm_num
    · push_cast
      rw [pow_succ']
      have hk_nn : (0 : ℝ) ≤ (k : ℝ) := Nat.cast_nonneg k
      linarith
  let B₁ : ℝ := 3 * C₁ * (1 + 3 * C₁) + (9 / 2) * C₁ ^ 2
  have h3C₁_le_B₁ : 3 * C₁ ≤ B₁ := by
    dsimp [B₁]
    nlinarith
  have hB₁_ge_one : 1 ≤ B₁ := by linarith
  obtain ⟨B₀, hB₀_nn, hB₀⟩ := h_bounds.2 M 1 (le_of_lt hM) zero_lt_one
  let D₀ : ℝ := B₀ + 4 * B₁
  have hD₀_pos : 0 < D₀ := by dsimp [D₀]; linarith
  let D₁ : ℝ := C₁ + 2 * D₀ + D₀ ^ 2 / 2
  have hD₁_pos : 0 < D₁ := by dsimp [D₁]; positivity
  obtain ⟨k, hk⟩ := exists_nat_ge ((25 / 7 : ℝ) * (D₁ / ε))
  have hD₁_le_pow : D₁ * (25 / 32 : ℝ) ^ k ≤ ε := by
    have h1 := h_ind_3225 k
    have h2 : D₁ / ε ≤ (32 / 25 : ℝ) ^ k := by linarith
    have h3 : D₁ ≤ (32 / 25 : ℝ) ^ k * ε := (div_le_iff₀ hε).mp h2
    have h4 : D₁ * (25 / 32 : ℝ) ^ k ≤ ((32 / 25 : ℝ) ^ k * ε) * (25 / 32 : ℝ) ^ k :=
      mul_le_mul_of_nonneg_right h3 (by positivity)
    have h_pow_inv : (32 / 25 : ℝ) ^ k * (25 / 32 : ℝ) ^ k = 1 := by
      rw [← mul_pow]
      norm_num
    have h_eq : ((32 / 25 : ℝ) ^ k * ε) * (25 / 32 : ℝ) ^ k = ε := by
      calc ((32 / 25 : ℝ) ^ k * ε) * (25 / 32 : ℝ) ^ k
        _ = ε * ((32 / 25 : ℝ) ^ k * (25 / 32 : ℝ) ^ k) := by ring
        _ = ε * 1 := by rw [h_pow_inv]
        _ = ε := mul_one ε
    linarith
  let P_k : ℝ := B₀ + B₁ * (k : ℝ)
  have hPk_nn : 0 ≤ P_k := by dsimp [P_k]; positivity
  let r_k : ℝ := (1 / 2 : ℝ) ^ k
  have hrk_pos : 0 < r_k := by dsimp [r_k]; positivity
  let δ : ℝ := r_k / (2 * (1 + P_k))
  have h_denom_pos : 0 < 2 * (1 + P_k) := by linarith
  have hδ_pos : 0 < δ := div_pos hrk_pos h_denom_pos
  have hδ_mul : δ * (2 * (1 + P_k)) = r_k := div_mul_cancel₀ r_k (ne_of_gt h_denom_pos)
  have hδ_le_rk : δ ≤ r_k := by nlinarith
  refine ⟨δ, hδ_pos, ?_⟩
  intro w hw hw_cent z z' hzx hzt hdx hdt
  let x : EuclideanSpace ℝ (Fin d) := projSpace z
  let t : ℝ := projTime z
  have h_ex_fit : ∀ n : ℕ, ∃ (p : EuclideanSpace ℝ (Fin d)) (a : ℝ),
      IsFitAt d C₁ w x t ((1 / 2 : ℝ) ^ n) p a := by
    intro n
    exact hw.2.2.2 x t ((1 / 2 : ℝ) ^ n) (by positivity)
  let p : ℕ → EuclideanSpace ℝ (Fin d) := fun n => Classical.choose (h_ex_fit n)
  let a : ℕ → ℝ := fun n => Classical.choose (Classical.choose_spec (h_ex_fit n))
  have hfit : ∀ n : ℕ, IsFitAt d C₁ w x t ((1 / 2 : ℝ) ^ n) (p n) (a n) := by
    intro n
    exact Classical.choose_spec (Classical.choose_spec (h_ex_fit n))
  have hpa_n : ∀ n : ℕ, ‖p n‖ ≤ B₀ + B₁ * (n : ℝ) ∧ |a n| ≤ B₀ + B₁ * (n : ℝ) := by
    intro n
    induction' n with n ih
    · have hfit0 : IsFitAt d C₁ w x t 1 (p 0) (a 0) := by
        simpa using hfit 0
      have hb0 := hB₀ w hw hw_cent x t (p 0) (a 0) hzx hzt hfit0
      simp [hb0.1, hb0.2]
    · have h_r_eq : (1 / 2 : ℝ) ^ n = 2 * (1 / 2 : ℝ) ^ (n + 1) := by
        rw [pow_succ']
        ring
      have hfit_double : IsFitAt d C₁ w x t (2 * (1 / 2 : ℝ) ^ (n + 1)) (p n) (a n) := by
        rw [← h_r_eq]
        exact hfit n
      have h_step := h_two_scale w x t ((1 / 2 : ℝ) ^ (n + 1)) (by positivity)
        (p (n + 1)) (p n) (a (n + 1)) (a n) (hfit (n + 1)) hfit_double
      have ha_step : |a n - a (n + 1)| ≤ B₁ := h_step.2
      have hp_tri : ‖p (n + 1)‖ ≤ ‖p n‖ + ‖p n - p (n + 1)‖ := by
        have := norm_sub_le (p n) (p n - p (n + 1))
        simpa using this
      have ha_tri : |a (n + 1)| ≤ |a n| + |a n - a (n + 1)| := by
        have := abs_sub (a n) (a n - a (n + 1))
        simpa using this
      push_cast
      constructor <;> linarith [ih.1, ih.2, h_step.1, ha_step, h3C₁_le_B₁, hp_tri, ha_tri]
  have hpk_le : ‖p k‖ ≤ P_k := (hpa_n k).1
  have hak_le : |a k| ≤ P_k := (hpa_n k).2
  let h : EuclideanSpace ℝ (Fin d) := projSpace z' - x
  let ℓ : ℝ := projTime z' - t
  have hh_le_δ : ‖h‖ ≤ δ := hdx
  have hℓ_le_δ : |ℓ| ≤ δ := hdt
  have hh_le_rk : ‖h‖ ≤ r_k := le_trans hh_le_δ hδ_le_rk
  have hℓ_le_rk : |ℓ| ≤ r_k := le_trans hℓ_le_δ hδ_le_rk
  have hh_shear : ‖h - ℓ • p k‖ ≤ r_k := by
    have h1 : ‖h - ℓ • p k‖ ≤ ‖h‖ + ‖ℓ • p k‖ := norm_sub_le h (ℓ • p k)
    rw [norm_smul, Real.norm_eq_abs] at h1
    have h2 : |ℓ| * ‖p k‖ ≤ δ * P_k :=
      mul_le_mul hℓ_le_δ hpk_le (norm_nonneg _) (le_of_lt hδ_pos)
    nlinarith [h1, h2, hh_le_δ, hδ_mul, hrk_pos]
  have h_fit_k := hfit k h ℓ hℓ_le_rk hh_shear
  have hz_eq : mkSpaceTime x t = z := h_mk_proj z
  have hz'_eq : mkSpaceTime (x + h) (t + ℓ) = z' := by
    dsimp [x, t, h, ℓ]
    rw [add_sub_cancel, add_sub_cancel]
    exact h_mk_proj z'
  rw [hz_eq, hz'_eq] at h_fit_k
  have h_fit_abs := abs_le.mp h_fit_k
  have h_cs : |inner ℝ (p k) h| ≤ P_k * r_k := by
    have h1 : |inner ℝ (p k) h| ≤ ‖p k‖ * ‖h‖ := abs_real_inner_le_norm (p k) h
    have h2 : ‖p k‖ * ‖h‖ ≤ P_k * r_k :=
      mul_le_mul hpk_le hh_le_rk (norm_nonneg _) hPk_nn
    exact le_trans h1 h2
  have h_cs_abs := abs_le.mp h_cs
  have h_ak_ell : |a k * ℓ| ≤ P_k * r_k := by
    rw [abs_mul]
    exact mul_le_mul hak_le hℓ_le_rk (abs_nonneg _) hPk_nn
  have h_ak_abs := abs_le.mp h_ak_ell
  have h_pk_sq_ell : |(‖p k‖ ^ 2 / 2) * ℓ| ≤ (P_k ^ 2 / 2) * r_k := by
    rw [abs_mul, abs_of_nonneg (by positivity)]
    have hp_sq : ‖p k‖ ^ 2 ≤ P_k ^ 2 := pow_le_pow_left₀ (norm_nonneg _) hpk_le 2
    have h_half : ‖p k‖ ^ 2 / 2 ≤ P_k ^ 2 / 2 := by linarith
    exact mul_le_mul h_half hℓ_le_rk (abs_nonneg _) (by positivity)
  have h_pk_abs := abs_le.mp h_pk_sq_ell
  have h_lin_1 : (a k - ‖p k‖ ^ 2 / 2) * ℓ = a k * ℓ - (‖p k‖ ^ 2 / 2) * ℓ := by ring
  have h_lin_2 : (C₁ + 2 * P_k + P_k ^ 2 / 2) * r_k =
      C₁ * r_k + P_k * r_k + P_k * r_k + (P_k ^ 2 / 2) * r_k := by ring
  have hw_diff : |w z' - w z| ≤ (C₁ + 2 * P_k + P_k ^ 2 / 2) * r_k := by
    rw [abs_le]
    constructor <;> linarith [h_fit_abs.1, h_fit_abs.2, h_cs_abs.1, h_cs_abs.2,
      h_ak_abs.1, h_ak_abs.2, h_pk_abs.1, h_pk_abs.2, h_lin_1, h_lin_2]
  have h54_ge_1 : (1 : ℝ) ≤ (5 / 4 : ℝ) ^ k := one_le_pow₀ (by norm_num)
  have hPk_exp : P_k ≤ D₀ * (5 / 4 : ℝ) ^ k := by
    dsimp [P_k, D₀]
    have hk_le : (k : ℝ) ≤ 4 * (5 / 4 : ℝ) ^ k := by linarith [h_ind_54 k]
    nlinarith
  have hPk_sq_exp : P_k ^ 2 ≤ D₀ ^ 2 * (25 / 16 : ℝ) ^ k := by
    have h1 : P_k ^ 2 ≤ (D₀ * (5 / 4 : ℝ) ^ k) ^ 2 :=
      pow_le_pow_left₀ hPk_nn hPk_exp 2
    have h2 : (D₀ * (5 / 4 : ℝ) ^ k) ^ 2 = D₀ ^ 2 * (25 / 16 : ℝ) ^ k := by
      rw [mul_pow, ← pow_mul, mul_comm k 2, pow_mul]
      norm_num
    linarith
  have h54_le_2516 : (5 / 4 : ℝ) ^ k ≤ (25 / 16 : ℝ) ^ k :=
    pow_le_pow_left₀ (by norm_num) (by norm_num) k
  have h2516_ge_1 : (1 : ℝ) ≤ (25 / 16 : ℝ) ^ k := one_le_pow₀ (by norm_num)
  have h_coef_exp : C₁ + 2 * P_k + P_k ^ 2 / 2 ≤ D₁ * (25 / 16 : ℝ) ^ k := by
    dsimp [D₁]
    nlinarith
  have h_mod_exp : (C₁ + 2 * P_k + P_k ^ 2 / 2) * r_k ≤ D₁ * (25 / 32 : ℝ) ^ k := by
    have h1 : (C₁ + 2 * P_k + P_k ^ 2 / 2) * r_k ≤ (D₁ * (25 / 16 : ℝ) ^ k) * r_k :=
      mul_le_mul_of_nonneg_right h_coef_exp (le_of_lt hrk_pos)
    have h2 : (D₁ * (25 / 16 : ℝ) ^ k) * r_k = D₁ * (25 / 32 : ℝ) ^ k := by
      dsimp [r_k]
      rw [mul_assoc, ← mul_pow]
      norm_num
    linarith
  exact le_trans hw_diff (le_trans h_mod_exp hD₁_le_pow)

theorem subseq_extraction_of_bounded_equicontinuous : ∀ (d : ℕ), 3 ≤ d → ∀ (C₁ K : ℝ), 0 < K →
      HasUniformBoxAndFitBounds d C₁ → HasUniformBoxEquicontinuity d C₁ →
      ∀ (w_seq : ℕ → EuclideanSpace ℝ (Fin (d + 1)) → ℝ)
        (b_seq : ℕ → EuclideanSpace ℝ (Fin d)),
        (∀ j : ℕ,
          InLimitingClassA d C₁ (w_seq j) ∧
          IsCenteredAt d C₁ (w_seq j) 0 1 ∧
          ‖b_seq j‖ ≤ K) →
        ∃ (v_inf : EuclideanSpace ℝ (Fin (d + 1)) → ℝ)
          (b : EuclideanSpace ℝ (Fin d)) (φ : ℕ → ℕ),
          StrictMono φ ∧
          Continuous v_inf ∧
          ConvergesLocUnif d (fun m => w_seq (φ m)) v_inf ∧
          Filter.Tendsto (fun m => b_seq (φ m)) Filter.atTop (nhds b) :=
by
  intro d _ C₁ K hK h_bounds h_equi w_seq b_seq h_seq
  have hb_mem : ∀ j : ℕ, b_seq j ∈ Metric.closedBall (0 : EuclideanSpace ℝ (Fin d)) K := by
    intro j
    simpa [Metric.mem_closedBall, dist_zero_right] using (h_seq j).2.2
  obtain ⟨b, _, φ₀, hφ₀_mono, hb_φ₀_tendsto⟩ :=
    (isCompact_closedBall (0 : EuclideanSpace ℝ (Fin d)) K).tendsto_subseq hb_mem
  let E := EuclideanSpace ℝ (Fin (d + 1))
  let f_seq : ℕ → E → ℝ := fun n => w_seq (φ₀ n)
  have h_mk_proj : ∀ w : E, mkSpaceTime (projSpace w) (projTime w) = w := by
    intro w
    ext j
    refine Fin.lastCases ?_ ?_ j
    · simp [mkSpaceTime, projTime]
    · intro k
      simp [mkSpaceTime, projSpace]
  have h_mk_add : ∀ (x h : EuclideanSpace ℝ (Fin d)) (t ℓ : ℝ),
      mkSpaceTime (x + h) (t + ℓ) = mkSpaceTime x t + mkSpaceTime h ℓ := by
    intro x h t ℓ
    ext j
    refine Fin.lastCases ?_ ?_ j
    · simp [mkSpaceTime]
    · intro k
      simp [mkSpaceTime]
  have h_projSpace_sub : ∀ w w' : E, projSpace (w' - w) = projSpace w' - projSpace w := by
    intro w w'
    ext k
    simp [projSpace]
    rfl
  have h_projTime_sub : ∀ w w' : E, projTime (w' - w) = projTime w' - projTime w := by
    intro w w'
    rfl
  have h_norm_projTime : ∀ w : E, |projTime w| ≤ ‖w‖ := by
    intro w
    simpa [projTime, Real.norm_eq_abs] using PiLp.norm_apply_le w (Fin.last d)
  have h_norm_projSpace : ∀ w : E, ‖projSpace w‖ ≤ ‖w‖ := by
    intro w
    rw [PiLp.norm_eq_of_L2, PiLp.norm_eq_of_L2]
    apply Real.sqrt_le_sqrt
    rw [Fin.sum_univ_castSucc]
    have h_eq : ∑ i : Fin d, ‖projSpace w i‖ ^ 2 = ∑ i : Fin d, ‖w (Fin.castSucc i)‖ ^ 2 := by
      refine Finset.sum_congr rfl (fun i _ => ?_)
      simp [projSpace]
    rw [h_eq]
    have h_last : 0 ≤ ‖w (Fin.last d)‖ ^ 2 := sq_nonneg _
    linarith
  have h_norm_mk : ∀ (x : EuclideanSpace ℝ (Fin d)) (t : ℝ),
      ‖mkSpaceTime x t‖ ≤ ‖x‖ + |t| := by
    intro x t
    have h_split : mkSpaceTime x t = mkSpaceTime x 0 + mkSpaceTime (0 : EuclideanSpace ℝ (Fin d)) t := by
      have h1 := h_mk_add x 0 0 t
      rwa [add_zero, zero_add] at h1
    have h_nx : ‖mkSpaceTime x 0‖ ≤ ‖x‖ := by
      rw [PiLp.norm_eq_of_L2, PiLp.norm_eq_of_L2]
      apply Real.sqrt_le_sqrt
      rw [Fin.sum_univ_castSucc]
      have h_eq : ∑ i : Fin d, ‖mkSpaceTime x 0 (Fin.castSucc i)‖ ^ 2 = ∑ i : Fin d, ‖x i‖ ^ 2 := by
        refine Finset.sum_congr rfl (fun i _ => ?_)
        simp [mkSpaceTime]
      have h_last : ‖mkSpaceTime x 0 (Fin.last d)‖ ^ 2 = 0 := by
        simp [mkSpaceTime]
      linarith
    have h_nt : ‖mkSpaceTime (0 : EuclideanSpace ℝ (Fin d)) t‖ ≤ |t| := by
      rw [PiLp.norm_eq_of_L2, ← Real.sqrt_sq (abs_nonneg t)]
      apply Real.sqrt_le_sqrt
      rw [Fin.sum_univ_castSucc]
      have h_eq : ∑ i : Fin d, ‖mkSpaceTime (0 : EuclideanSpace ℝ (Fin d)) t (Fin.castSucc i)‖ ^ 2 = 0 := by
        refine Finset.sum_eq_zero (fun i _ => ?_)
        simp [mkSpaceTime]
      have h_last : ‖mkSpaceTime (0 : EuclideanSpace ℝ (Fin d)) t (Fin.last d)‖ ^ 2 = |t| ^ 2 := by
        simp [mkSpaceTime, Real.norm_eq_abs]
      linarith
    calc ‖mkSpaceTime x t‖ = ‖mkSpaceTime x 0 + mkSpaceTime (0 : EuclideanSpace ℝ (Fin d)) t‖ := by rw [h_split]
      _ ≤ ‖mkSpaceTime x 0‖ + ‖mkSpaceTime (0 : EuclideanSpace ℝ (Fin d)) t‖ := norm_add_le _ _
      _ ≤ ‖x‖ + |t| := add_le_add h_nx h_nt
  have h_bdd : ∀ w : E, ∃ B : ℝ, 0 ≤ B ∧ ∀ n : ℕ, |f_seq n w| ≤ B := by
    intro w
    obtain ⟨U, hU_nonneg, hU⟩ := h_bounds.1 ‖w‖ (norm_nonneg w)
    refine ⟨U, hU_nonneg, fun n => ?_⟩
    exact hU (w_seq (φ₀ n)) (h_seq (φ₀ n)).1 (h_seq (φ₀ n)).2.1 w
      (h_norm_projSpace w) (h_norm_projTime w)
  have h_ball_equi : ∀ M ε : ℝ, 0 < M → 0 < ε →
      ∃ δ : ℝ, 0 < δ ∧
        ∀ n : ℕ, ∀ w w' : E, ‖w‖ ≤ M → ‖w' - w‖ ≤ δ →
          |f_seq n w' - f_seq n w| ≤ ε := by
    intro M ε hM hε
    obtain ⟨δ, hδ_pos, hδ⟩ := h_equi M hM ε hε
    refine ⟨δ, hδ_pos, fun n w w' hw hww' => ?_⟩
    have hw_space : ‖projSpace w‖ ≤ M := le_trans (h_norm_projSpace w) hw
    have hw_time : |projTime w| ≤ M := le_trans (h_norm_projTime w) hw
    have h_diff_space : ‖projSpace w' - projSpace w‖ ≤ δ := by
      rw [← h_projSpace_sub]
      exact le_trans (h_norm_projSpace (w' - w)) hww'
    have h_diff_time : |projTime w' - projTime w| ≤ δ := by
      rw [← h_projTime_sub]
      exact le_trans (h_norm_projTime (w' - w)) hww'
    exact hδ (w_seq (φ₀ n)) (h_seq (φ₀ n)).1 (h_seq (φ₀ n)).2.1 w w'
      hw_space hw_time h_diff_space h_diff_time
  obtain ⟨D, hD_count, hD_dense⟩ := TopologicalSpace.exists_countable_dense E
  haveI : Countable D := hD_count.to_subtype
  haveI : FirstCountableTopology (D → ℝ) :=
    TopologicalSpace.instFirstCountableTopologyForallOfCountable
  choose B hB_nonneg hB_bound using h_bdd
  let S_D : Set (D → ℝ) := { g | ∀ y : D, g y ∈ Set.Icc (-B y.1) (B y.1) }
  have hS_D_compact : IsCompact S_D :=
    isCompact_pi_infinite (fun y : D => isCompact_Icc)
  have hf_mem_SD : ∀ n : ℕ, (fun y : D => f_seq n y.1) ∈ S_D := by
    intro n y
    exact abs_le.mp (hB_bound y.1 n)
  obtain ⟨g₀, _, φ₁, hφ₁_mono, hg₀_tendsto⟩ := hS_D_compact.tendsto_subseq hf_mem_SD
  have hD_tendsto : ∀ y : D, Filter.Tendsto (fun m => f_seq (φ₁ m) y.1) Filter.atTop (nhds (g₀ y)) :=
    tendsto_pi_nhds.mp hg₀_tendsto
  have h_unif_cauchy : ∀ M ε : ℝ, 0 < M → 0 < ε →
      ∃ N₀ : ℕ, ∀ m n : ℕ, N₀ ≤ m → N₀ ≤ n →
        ∀ w : E, ‖w‖ ≤ M → |f_seq (φ₁ m) w - f_seq (φ₁ n) w| ≤ ε := by
    intro M ε hM hε
    obtain ⟨δ, hδ, h_eq⟩ := h_ball_equi M (ε / 3) hM (by linarith)
    have h_dense_ball : ∀ z : E, ∃ y ∈ D, z ∈ Metric.ball y δ := by
      intro z
      obtain ⟨y, hy_ball, hy_D⟩ := Metric.dense_iff.mp hD_dense z δ hδ
      refine ⟨y, hy_D, ?_⟩
      rw [Metric.mem_ball, dist_comm]
      exact Metric.mem_ball.mp hy_ball
    choose y hy_D hy_ball using h_dense_ball
    have h_nhds : ∀ z ∈ Metric.closedBall (0 : E) M, Metric.ball (y z) δ ∈ nhds z :=
      fun z _ => Metric.isOpen_ball.mem_nhds (hy_ball z)
    obtain ⟨t, _, ht_cover⟩ :=
      (isCompact_closedBall (0 : E) M).elim_nhds_subcover (fun z => Metric.ball (y z) δ) h_nhds
    have h_cauchy_y : ∀ z : E, ∃ N : ℕ, ∀ m n : ℕ, N ≤ m → N ≤ n →
        |f_seq (φ₁ m) (y z) - f_seq (φ₁ n) (y z)| ≤ ε / 3 := by
      intro z
      have h_c : CauchySeq (fun m => f_seq (φ₁ m) (y z)) :=
        (hD_tendsto ⟨y z, hy_D z⟩).cauchySeq
      obtain ⟨N, hN⟩ := Metric.cauchySeq_iff.mp h_c (ε / 3) (by linarith)
      refine ⟨N, fun m n hm hn => ?_⟩
      rw [← Real.dist_eq]
      exact le_of_lt (hN m hm n hn)
    choose N hN using h_cauchy_y
    let N₀ : ℕ := t.sup N
    refine ⟨N₀, fun m n hm hn w hw => ?_⟩
    have hw_mem : w ∈ Metric.closedBall (0 : E) M := by
      simpa [Metric.mem_closedBall, dist_zero_right] using hw
    have hw_cov := ht_cover hw_mem
    rw [Set.mem_iUnion₂] at hw_cov
    obtain ⟨z, hz_t, hw_ball⟩ := hw_cov
    have hyw_le : ‖y z - w‖ ≤ δ := by
      rw [norm_sub_rev, ← dist_eq_norm]
      exact le_of_lt (Metric.mem_ball.mp hw_ball)
    have hNz_le : N z ≤ t.sup N := Finset.le_sup hz_t
    have hNz_m : N z ≤ m := le_trans hNz_le hm
    have hNz_n : N z ≤ n := le_trans hNz_le hn
    have h_eq_m : |f_seq (φ₁ m) (y z) - f_seq (φ₁ m) w| ≤ ε / 3 :=
      h_eq (φ₁ m) w (y z) hw hyw_le
    have h_eq_n : |f_seq (φ₁ n) (y z) - f_seq (φ₁ n) w| ≤ ε / 3 :=
      h_eq (φ₁ n) w (y z) hw hyw_le
    have h_mid : |f_seq (φ₁ m) (y z) - f_seq (φ₁ n) (y z)| ≤ ε / 3 :=
      hN z m n hNz_m hNz_n
    have h1 := (abs_le.mp h_eq_m).1
    have h2 := (abs_le.mp h_eq_m).2
    have h3 := (abs_le.mp h_eq_n).1
    have h4 := (abs_le.mp h_eq_n).2
    have h5 := (abs_le.mp h_mid).1
    have h6 := (abs_le.mp h_mid).2
    rw [abs_le]
    constructor <;> linarith
  have h_pt_cauchy : ∀ w : E, CauchySeq (fun m => f_seq (φ₁ m) w) := by
    intro w
    rw [Metric.cauchySeq_iff]
    intro ε hε
    obtain ⟨N₀, hN₀⟩ := h_unif_cauchy (‖w‖ + 1) (ε / 2) (by positivity) (half_pos hε)
    refine ⟨N₀, fun m hm n hn => ?_⟩
    rw [Real.dist_eq]
    have h_le := hN₀ m n hm hn w (by linarith)
    linarith
  have h_pt_conv : ∀ w : E, ∃ a : ℝ, Filter.Tendsto (fun m => f_seq (φ₁ m) w) Filter.atTop (nhds a) :=
    fun w => cauchySeq_tendsto_of_complete (h_pt_cauchy w)
  choose v_inf hv_tendsto using h_pt_conv
  have hv_unif : ∀ M ε : ℝ, 0 < M → 0 < ε →
      ∃ N₀ : ℕ, ∀ m : ℕ, N₀ ≤ m →
        ∀ w : E, ‖w‖ ≤ M → |f_seq (φ₁ m) w - v_inf w| ≤ ε := by
    intro M ε hM hε
    obtain ⟨N₀, hN₀⟩ := h_unif_cauchy M ε hM hε
    refine ⟨N₀, fun m hm w hw => ?_⟩
    have h_tend : Filter.Tendsto (fun n => |f_seq (φ₁ m) w - f_seq (φ₁ n) w|)
        Filter.atTop (nhds |f_seq (φ₁ m) w - v_inf w|) :=
      (tendsto_const_nhds.sub (hv_tendsto w)).abs
    refine le_of_tendsto h_tend (Filter.eventually_atTop.mpr ⟨N₀, fun n hn => ?_⟩)
    exact hN₀ m n hm hn w hw
  have h_conv : ConvergesLocUnif d (fun m => w_seq ((φ₀ ∘ φ₁) m)) v_inf := by
    intro R hR ε hε
    obtain ⟨N₀, hN₀⟩ := hv_unif (2 * R) ε (by linarith) hε
    refine ⟨N₀, fun m hm z hz_space hz_time => ?_⟩
    have hz_norm : ‖z‖ ≤ 2 * R := by
      have h1 := h_norm_mk (projSpace z) (projTime z)
      rw [h_mk_proj z] at h1
      linarith
    exact hN₀ m hm z hz_norm
  have hv_cont : Continuous v_inf := by
    rw [Metric.continuous_iff]
    intro w ε hε
    let M : ℝ := ‖w‖ + 1
    have hM_pos : 0 < M := by dsimp [M]; positivity
    obtain ⟨δ, hδ, h_eq⟩ := h_ball_equi M (ε / 2) hM_pos (half_pos hε)
    refine ⟨δ, hδ, fun w' hw' => ?_⟩
    rw [Real.dist_eq]
    have hw_le : ‖w‖ ≤ M := by dsimp [M]; linarith
    have hww'_le : ‖w' - w‖ ≤ δ := by
      rw [← dist_eq_norm]; exact le_of_lt hw'
    have h_tend : Filter.Tendsto (fun m => |f_seq (φ₁ m) w' - f_seq (φ₁ m) w|)
        Filter.atTop (nhds |v_inf w' - v_inf w|) :=
      ((hv_tendsto w').sub (hv_tendsto w)).abs
    have h_le : |v_inf w' - v_inf w| ≤ ε / 2 := by
      refine le_of_tendsto h_tend (Filter.eventually_atTop.mpr ⟨0, fun m _ => ?_⟩)
      exact h_eq (φ₁ m) w w' hw_le hww'_le
    linarith
  refine ⟨v_inf, b, φ₀ ∘ φ₁, hφ₀_mono.comp hφ₁_mono, hv_cont, h_conv, ?_⟩
  exact hb_φ₀_tendsto.comp hφ₁_mono.tendsto_atTop

theorem fits_and_centering_of_loc_unif : ∀ (d : ℕ), 3 ≤ d → ∀ (C₁ : ℝ), 1 ≤ C₁ →
      HasUniformBoxAndFitBounds d C₁ →
      ∀ (f_seq : ℕ → EuclideanSpace ℝ (Fin (d + 1)) → ℝ)
        (v_inf : EuclideanSpace ℝ (Fin (d + 1)) → ℝ),
        (∀ m : ℕ, InLimitingClassA d C₁ (f_seq m) ∧ IsCenteredAt d C₁ (f_seq m) 0 1) →
        ConvergesLocUnif d f_seq v_inf →
        IsCenteredAt d C₁ v_inf 0 1 ∧
        (∀ (x : EuclideanSpace ℝ (Fin d)) (t R : ℝ), 0 < R →
          ∃ (p : EuclideanSpace ℝ (Fin d)) (a : ℝ),
            ∀ (h : EuclideanSpace ℝ (Fin d)) (ℓ : ℝ),
              |ℓ| ≤ R → ‖h - ℓ • p‖ ≤ R →
              |v_inf (mkSpaceTime (x + h) (t + ℓ)) - v_inf (mkSpaceTime x t) -
                inner ℝ p h - (a - ‖p‖ ^ 2 / 2) * ℓ| ≤ C₁ * R) :=
by
  intro d hd C₁ hC₁ h_bounds f_seq v_inf hf_seq h_conv
  let E := EuclideanSpace ℝ (Fin (d + 1))
  have h_projSpace_mk : ∀ (x : EuclideanSpace ℝ (Fin d)) (t : ℝ),
      projSpace (mkSpaceTime x t) = x := by
    intro x t
    ext i
    simp [projSpace, mkSpaceTime]
  have h_projTime_mk : ∀ (x : EuclideanSpace ℝ (Fin d)) (t : ℝ),
      projTime (mkSpaceTime x t) = t := by
    intro x t
    simp [projTime, mkSpaceTime]
  have h_mk_sub : ∀ (x₁ x₂ : EuclideanSpace ℝ (Fin d)) (t₁ t₂ : ℝ),
      mkSpaceTime x₁ t₁ - mkSpaceTime x₂ t₂ = mkSpaceTime (x₁ - x₂) (t₁ - t₂) := by
    intro x₁ x₂ t₁ t₂
    ext j
    refine Fin.lastCases ?_ ?_ j
    · simp [mkSpaceTime]
    · intro k
      simp [mkSpaceTime]
  have h_norm_mk_zero : ∀ (x : EuclideanSpace ℝ (Fin d)),
      ‖mkSpaceTime x 0‖ ≤ ‖x‖ := by
    intro x
    rw [PiLp.norm_eq_of_L2, PiLp.norm_eq_of_L2]
    apply Real.sqrt_le_sqrt
    rw [Fin.sum_univ_castSucc]
    have h_eq : ∑ i : Fin d, ‖mkSpaceTime x 0 (Fin.castSucc i)‖ ^ 2 = ∑ i : Fin d, ‖x i‖ ^ 2 := by
      refine Finset.sum_congr rfl (fun i _ => ?_)
      simp [mkSpaceTime]
    have h_last : ‖mkSpaceTime x 0 (Fin.last d)‖ ^ 2 = 0 := by
      simp [mkSpaceTime]
    linarith
  have hv_tendsto : ∀ z : E, Filter.Tendsto (fun m => f_seq m z) Filter.atTop (nhds (v_inf z)) := by
    intro z
    rw [Metric.tendsto_atTop]
    intro ε hε
    let R_z : ℝ := ‖projSpace z‖ + |projTime z| + 1
    have hR_z_pos : 0 < R_z := by dsimp [R_z]; positivity
    have hz_sp : ‖projSpace z‖ ≤ R_z := by
      have : 0 ≤ |projTime z| := abs_nonneg _
      dsimp [R_z]; linarith
    have hz_tm : |projTime z| ≤ R_z := by
      have : 0 ≤ ‖projSpace z‖ := norm_nonneg _
      dsimp [R_z]; linarith
    obtain ⟨N, hN⟩ := h_conv R_z hR_z_pos (ε / 2) (half_pos hε)
    refine ⟨N, fun m hm => ?_⟩
    rw [Real.dist_eq]
    have h_le := hN m hm z hz_sp hz_tm
    linarith
  have hv_cent : IsCenteredAt d C₁ v_inf 0 1 := by
    refine ⟨?_, ?_⟩
    · have h_zero_seq : (fun m => f_seq m (mkSpaceTime 0 1)) = fun _ => (0 : ℝ) := by
        ext m; exact (hf_seq m).2.1
      have h_t0 := hv_tendsto (mkSpaceTime 0 1)
      rw [h_zero_seq] at h_t0
      exact tendsto_nhds_unique h_t0 tendsto_const_nhds
    · intro h ℓ hℓ hh
      have h_tend : Filter.Tendsto
          (fun m => |f_seq m (mkSpaceTime (0 + h) (1 + ℓ)) - f_seq m (mkSpaceTime 0 1) -
            inner ℝ (0 : EuclideanSpace ℝ (Fin d)) h - (0 - ‖(0 : EuclideanSpace ℝ (Fin d))‖ ^ 2 / 2) * ℓ|)
          Filter.atTop
          (nhds |v_inf (mkSpaceTime (0 + h) (1 + ℓ)) - v_inf (mkSpaceTime 0 1) -
            inner ℝ (0 : EuclideanSpace ℝ (Fin d)) h - (0 - ‖(0 : EuclideanSpace ℝ (Fin d))‖ ^ 2 / 2) * ℓ|) :=
        ((((hv_tendsto (mkSpaceTime (0 + h) (1 + ℓ))).sub (hv_tendsto (mkSpaceTime 0 1))).sub
          tendsto_const_nhds).sub tendsto_const_nhds).abs
      refine le_of_tendsto h_tend (Filter.eventually_atTop.mpr ⟨0, fun m _ => ?_⟩)
      exact (hf_seq m).2.2 h ℓ hℓ hh
  refine ⟨hv_cent, ?_⟩
  intro x t R hR
  let M : ℝ := ‖x‖ + |t|
  have hM_nonneg : 0 ≤ M := by dsimp [M]; positivity
  have hx_M : ‖x‖ ≤ M := by
    have : 0 ≤ |t| := abs_nonneg t
    dsimp [M]; linarith
  have ht_M : |t| ≤ M := by
    have : 0 ≤ ‖x‖ := norm_nonneg x
    dsimp [M]; linarith
  obtain ⟨B_fit, hB_fit_nonneg, hB_fit⟩ := h_bounds.2 M R hM_nonneg hR
  have h_fit_m : ∀ m : ℕ,
      ∃ (p : EuclideanSpace ℝ (Fin d)) (a : ℝ),
        ‖p‖ ≤ B_fit ∧ |a| ≤ B_fit ∧ IsFitAt d C₁ (f_seq m) x t R p a := by
    intro m
    obtain ⟨p, a, h_fit⟩ := (hf_seq m).1.2.2.2 x t R hR
    obtain ⟨hp, ha⟩ := hB_fit (f_seq m) (hf_seq m).1 (hf_seq m).2 x t p a hx_M ht_M h_fit
    exact ⟨p, a, hp, ha, h_fit⟩
  choose p_m a_m hp_m ha_m hbox_m using h_fit_m
  let K_slope : Set (EuclideanSpace ℝ (Fin d) × ℝ) :=
    Metric.closedBall (0 : EuclideanSpace ℝ (Fin d)) B_fit ×ˢ Set.Icc (-B_fit) B_fit
  have hK_slope_compact : IsCompact K_slope :=
    (isCompact_closedBall (0 : EuclideanSpace ℝ (Fin d)) B_fit).prod isCompact_Icc
  have h_mem_slope : ∀ m : ℕ, (p_m m, a_m m) ∈ K_slope := by
    intro m
    refine ⟨?_, ?_⟩
    · simpa [Metric.mem_closedBall, dist_zero_right] using hp_m m
    · exact abs_le.mp (ha_m m)
  obtain ⟨⟨p, a⟩, _, σ, hσ_mono, hpa_tendsto⟩ := hK_slope_compact.tendsto_subseq h_mem_slope
  have hp_tendsto : Filter.Tendsto (fun k => p_m (σ k)) Filter.atTop (nhds p) :=
    (Prod.tendsto_iff _ _).mp hpa_tendsto |>.1
  have ha_tendsto : Filter.Tendsto (fun k => a_m (σ k)) Filter.atTop (nhds a) :=
    (Prod.tendsto_iff _ _).mp hpa_tendsto |>.2
  refine ⟨p, a, fun h ℓ hℓ hh => ?_⟩
  let h_k : ℕ → EuclideanSpace ℝ (Fin d) := fun k => ℓ • p_m (σ k) + (h - ℓ • p)
  have hh_k_tendsto : Filter.Tendsto h_k Filter.atTop (nhds h) := by
    have h1 : Filter.Tendsto (fun k => ℓ • p_m (σ k) + (h - ℓ • p)) Filter.atTop
        (nhds (ℓ • p + (h - ℓ • p))) :=
      (tendsto_const_nhds.smul hp_tendsto).add tendsto_const_nhds
    rwa [add_sub_cancel] at h1
  let z_k : ℕ → E := fun k => mkSpaceTime (x + h_k k) (t + ℓ)
  let z_star : E := mkSpaceTime (x + h) (t + ℓ)
  have hz_k_tendsto : Filter.Tendsto z_k Filter.atTop (nhds z_star) := by
    rw [Metric.tendsto_atTop]
    intro ε hε
    obtain ⟨N₁, hN₁⟩ := Metric.tendsto_atTop.mp hh_k_tendsto ε hε
    refine ⟨N₁, fun k hk => ?_⟩
    rw [dist_eq_norm]
    have h_sub : z_k k - z_star = mkSpaceTime (h_k k - h) 0 := by
      dsimp [z_k, z_star]
      rw [h_mk_sub]
      have hx_sub : (x + h_k k) - (x + h) = h_k k - h := add_sub_add_left_eq_sub _ _ _
      rw [hx_sub, sub_self]
    have h_nm := h_norm_mk_zero (h_k k - h)
    rw [← h_sub] at h_nm
    have hk_lt : ‖h_k k - h‖ < ε := by
      rw [← dist_eq_norm]
      exact hN₁ k hk
    linarith
  let R_box : ℝ := ‖x‖ + |t| + ‖h‖ + R * B_fit + 2 * R + 1
  have hR_box_pos : 0 < R_box := by
    have : 0 ≤ R * B_fit := mul_nonneg (le_of_lt hR) hB_fit_nonneg
    dsimp [R_box]; positivity
  have hz_k_sp : ∀ k : ℕ, ‖projSpace (z_k k)‖ ≤ R_box := by
    intro k
    have h_hk_norm : ‖h_k k‖ ≤ R * B_fit + R := by
      dsimp [h_k]
      have h_tri := norm_add_le (ℓ • p_m (σ k)) (h - ℓ • p)
      rw [norm_smul, Real.norm_eq_abs] at h_tri
      have h_mul : |ℓ| * ‖p_m (σ k)‖ ≤ R * B_fit :=
        mul_le_mul hℓ (hp_m (σ k)) (norm_nonneg _) (le_of_lt hR)
      linarith
    have h_x_hk : ‖x + h_k k‖ ≤ ‖x‖ + (R * B_fit + R) := by
      have := norm_add_le x (h_k k)
      linarith
    have h_nonneg : 0 ≤ |t| + ‖h‖ + R + 1 := by positivity
    dsimp [z_k, R_box]
    rw [h_projSpace_mk]
    linarith
  have hz_k_tm : ∀ k : ℕ, |projTime (z_k k)| ≤ R_box := by
    intro k
    have h_t_ℓ : |t + ℓ| ≤ |t| + R := by
      have := abs_add_le t ℓ
      linarith
    have h_nonneg : 0 ≤ ‖x‖ + ‖h‖ + R * B_fit + R + 1 := by
      have : 0 ≤ R * B_fit := mul_nonneg (le_of_lt hR) hB_fit_nonneg
      positivity
    dsimp [z_k, R_box]
    rw [h_projTime_mk]
    linarith
  have hz_star_sp : ‖projSpace z_star‖ ≤ R_box := by
    have h_x_h : ‖x + h‖ ≤ ‖x‖ + ‖h‖ := norm_add_le x h
    have h_nonneg : 0 ≤ |t| + R * B_fit + 2 * R + 1 := by
      have : 0 ≤ R * B_fit := mul_nonneg (le_of_lt hR) hB_fit_nonneg
      positivity
    dsimp [z_star, R_box]
    rw [h_projSpace_mk]
    linarith
  have hz_star_tm : |projTime z_star| ≤ R_box := by
    have h_t_ℓ : |t + ℓ| ≤ |t| + R := by
      have := abs_add_le t ℓ
      linarith
    have h_nonneg : 0 ≤ ‖x‖ + ‖h‖ + R * B_fit + R + 1 := by
      have : 0 ≤ R * B_fit := mul_nonneg (le_of_lt hR) hB_fit_nonneg
      positivity
    dsimp [z_star, R_box]
    rw [h_projTime_mk]
    linarith
  have hv₁_tendsto : Filter.Tendsto (fun k => f_seq (σ k) (z_k k))
      Filter.atTop (nhds (v_inf z_star)) := by
    rw [Metric.tendsto_atTop]
    intro ε hε
    have hε4 : 0 < ε / 4 := by linarith
    obtain ⟨N₀, hN₀⟩ := h_conv R_box hR_box_pos (ε / 4) hε4
    have h_cont_N₀ : Continuous (f_seq N₀) := (hf_seq N₀).1.1
    obtain ⟨K₁, hK₁⟩ := Metric.tendsto_atTop.mp
      ((h_cont_N₀.tendsto z_star).comp hz_k_tendsto) (ε / 4) hε4
    refine ⟨max N₀ K₁, fun k hk => ?_⟩
    have hk_N₀ : N₀ ≤ σ k :=
      le_trans (le_trans (le_max_left N₀ K₁) hk) (hσ_mono.id_le k)
    have hk_K₁ : K₁ ≤ k := le_trans (le_max_right N₀ K₁) hk
    have h_d1 : |f_seq (σ k) (z_k k) - v_inf (z_k k)| ≤ ε / 4 :=
      hN₀ (σ k) hk_N₀ (z_k k) (hz_k_sp k) (hz_k_tm k)
    have h_d2 : |f_seq N₀ (z_k k) - v_inf (z_k k)| ≤ ε / 4 :=
      hN₀ N₀ le_rfl (z_k k) (hz_k_sp k) (hz_k_tm k)
    have h_d3 : |f_seq N₀ (z_k k) - f_seq N₀ z_star| < ε / 4 := by
      rw [← Real.dist_eq]
      exact hK₁ k hk_K₁
    have h_d4 : |f_seq N₀ z_star - v_inf z_star| ≤ ε / 4 :=
      hN₀ N₀ le_rfl z_star hz_star_sp hz_star_tm
    have h1 := (abs_le.mp h_d1).1
    have h2 := (abs_le.mp h_d1).2
    have h3 := (abs_le.mp h_d2).1
    have h4 := (abs_le.mp h_d2).2
    have h5 := (abs_lt.mp h_d3).1
    have h6 := (abs_lt.mp h_d3).2
    have h7 := (abs_le.mp h_d4).1
    have h8 := (abs_le.mp h_d4).2
    rw [Real.dist_eq, abs_lt]
    constructor <;> linarith
  have hv₀_tendsto : Filter.Tendsto (fun k => f_seq (σ k) (mkSpaceTime x t))
      Filter.atTop (nhds (v_inf (mkSpaceTime x t))) :=
    (hv_tendsto (mkSpaceTime x t)).comp hσ_mono.tendsto_atTop
  have h_inner_tendsto : Filter.Tendsto (fun k => inner ℝ (p_m (σ k)) (h_k k))
      Filter.atTop (nhds (inner ℝ p h)) :=
    hp_tendsto.inner hh_k_tendsto
  have h_aℓ_tendsto : Filter.Tendsto (fun k => (a_m (σ k) - ‖p_m (σ k)‖ ^ 2 / 2) * ℓ)
      Filter.atTop (nhds ((a - ‖p‖ ^ 2 / 2) * ℓ)) :=
    (ha_tendsto.sub ((hp_tendsto.norm.pow 2).div_const 2)).mul tendsto_const_nhds
  have h_lhs_tendsto : Filter.Tendsto
      (fun k => |f_seq (σ k) (z_k k) - f_seq (σ k) (mkSpaceTime x t) -
        inner ℝ (p_m (σ k)) (h_k k) - (a_m (σ k) - ‖p_m (σ k)‖ ^ 2 / 2) * ℓ|)
      Filter.atTop
      (nhds |v_inf z_star - v_inf (mkSpaceTime x t) - inner ℝ p h - (a - ‖p‖ ^ 2 / 2) * ℓ|) :=
    (((hv₁_tendsto.sub hv₀_tendsto).sub h_inner_tendsto).sub h_aℓ_tendsto).abs
  refine le_of_tendsto h_lhs_tendsto (Filter.eventually_atTop.mpr ⟨0, fun k _ => ?_⟩)
  have h_shear_k : ‖h_k k - ℓ • p_m (σ k)‖ ≤ R := by
    dsimp [h_k]
    rwa [add_sub_cancel_left]
  exact hbox_m (σ k) (h_k k) ℓ hℓ h_shear_k

theorem viscosity_stability_of_loc_unif : ∀ (d : ℕ) (C₁ : ℝ)
      (f_seq : ℕ → EuclideanSpace ℝ (Fin (d + 1)) → ℝ)
      (v_inf : EuclideanSpace ℝ (Fin (d + 1)) → ℝ),
      (∀ m : ℕ, InLimitingClassA d C₁ (f_seq m)) →
      ConvergesLocUnif d f_seq v_inf →
      (∀ z : EuclideanSpace ℝ (Fin (d + 1)), ∀ ϕ : EuclideanSpace ℝ (Fin (d + 1)) → ℝ,
        ∀ V : Set (EuclideanSpace ℝ (Fin (d + 1))),
          IsOpen V → z ∈ V → ContDiffOn ℝ 2 ϕ V → ϕ z = v_inf z → (∀ y ∈ V, v_inf y ≤ ϕ y) →
          0 ≤ limitingOperator ϕ z) ∧
      (∀ z : EuclideanSpace ℝ (Fin (d + 1)), ∀ ϕ : EuclideanSpace ℝ (Fin (d + 1)) → ℝ,
        ∀ V : Set (EuclideanSpace ℝ (Fin (d + 1))),
          IsOpen V → z ∈ V → ContDiffOn ℝ 2 ϕ V → ϕ z = v_inf z → (∀ y ∈ V, ϕ y ≤ v_inf y) →
          limitingOperator ϕ z ≤ 0) :=
by
  intro d C₁ f_seq v_inf hf_seq h_conv
  let E := EuclideanSpace ℝ (Fin (d + 1))
  have h_mk_add : ∀ (x h : EuclideanSpace ℝ (Fin d)) (t ℓ : ℝ),
      mkSpaceTime (x + h) (t + ℓ) = mkSpaceTime x t + mkSpaceTime h ℓ := by
    intro x h t ℓ
    ext j
    refine Fin.lastCases ?_ ?_ j
    · simp [mkSpaceTime]
    · intro k
      simp [mkSpaceTime]
  have h_mk_sub : ∀ (x₁ x₂ : EuclideanSpace ℝ (Fin d)) (t₁ t₂ : ℝ),
      mkSpaceTime x₁ t₁ - mkSpaceTime x₂ t₂ = mkSpaceTime (x₁ - x₂) (t₁ - t₂) := by
    intro x₁ x₂ t₁ t₂
    ext j
    refine Fin.lastCases ?_ ?_ j
    · simp [mkSpaceTime]
    · intro k
      simp [mkSpaceTime]
  have h_projSpace_sub : ∀ w w' : E, projSpace (w' - w) = projSpace w' - projSpace w := by
    intro w w'
    ext k
    simp [projSpace]
    rfl
  have h_norm_projTime : ∀ w : E, |projTime w| ≤ ‖w‖ := by
    intro w
    simpa [projTime, Real.norm_eq_abs] using PiLp.norm_apply_le w (Fin.last d)
  have h_norm_projSpace : ∀ w : E, ‖projSpace w‖ ≤ ‖w‖ := by
    intro w
    rw [PiLp.norm_eq_of_L2, PiLp.norm_eq_of_L2]
    apply Real.sqrt_le_sqrt
    rw [Fin.sum_univ_castSucc]
    have h_eq : ∑ i : Fin d, ‖projSpace w i‖ ^ 2 = ∑ i : Fin d, ‖w (Fin.castSucc i)‖ ^ 2 := by
      refine Finset.sum_congr rfl (fun i _ => ?_)
      simp [projSpace]
    rw [h_eq]
    have h_last : 0 ≤ ‖w (Fin.last d)‖ ^ 2 := sq_nonneg _
    linarith
  have h_norm_mk : ∀ (x : EuclideanSpace ℝ (Fin d)) (t : ℝ),
      ‖mkSpaceTime x t‖ ≤ ‖x‖ + |t| := by
    intro x t
    have h_split : mkSpaceTime x t = mkSpaceTime x 0 + mkSpaceTime (0 : EuclideanSpace ℝ (Fin d)) t := by
      have h1 := h_mk_add x 0 0 t
      rwa [add_zero, zero_add] at h1
    have h_nx : ‖mkSpaceTime x 0‖ ≤ ‖x‖ := by
      rw [PiLp.norm_eq_of_L2, PiLp.norm_eq_of_L2]
      apply Real.sqrt_le_sqrt
      rw [Fin.sum_univ_castSucc]
