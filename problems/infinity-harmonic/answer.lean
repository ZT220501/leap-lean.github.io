    have h_mem : val_star ∈ S_bary := by
      refine ⟨N, θ, y, hθ_pos, hθ_sum, ?_, ?_⟩
      · rw [h_proj_s]; exact hy_mean
      · rw [h_proj_t, h_proj_s]
        simp only [sub_zero, mul_one]
        exact h_att_val.symm
    have h_ub : ∀ val ∈ S_bary, val ≤ val_star := by
      rintro val ⟨N', θ', y', hθ'_pos, hθ'_sum, hy'_mean, rfl⟩
      rw [h_proj_s] at hy'_mean
      rw [h_proj_t, h_proj_s]
      simp only [sub_zero, mul_one]
      rw [h_var N' θ' y' hθ'_sum hy'_mean]
      have h_sum_le : ∑ i, θ' i * (v (mkSpaceTime (y' i) 1) - ‖y' i - b‖ ^ 2 / 2) ≤
          quadEnvelopePlus d 1 v (mkSpaceTime b 0) := by
        calc ∑ i, θ' i * (v (mkSpaceTime (y' i) 1) - ‖y' i - b‖ ^ 2 / 2)
          _ ≤ ∑ i, θ' i * quadEnvelopePlus d 1 v (mkSpaceTime b 0) := by
              apply Finset.sum_le_sum
              intro i _
              exact mul_le_mul_of_nonneg_left (h_le b (y' i)) (le_of_lt (hθ'_pos i))
          _ = (∑ i, θ' i) * quadEnvelopePlus d 1 v (mkSpaceTime b 0) := by
              rw [← Finset.sum_mul]
          _ = quadEnvelopePlus d 1 v (mkSpaceTime b 0) := by
              rw [hθ'_sum, one_mul]
      dsimp [val_star]
      linarith
    have h_bary_eq : barycentricEnvelope d 1 v (mkSpaceTime 0 1) = val_star := by
      change sSup S_bary = val_star
      exact le_antisymm (csSup_le ⟨val_star, h_mem⟩ h_ub) (le_csSup ⟨val_star, h_ub⟩ h_mem)
    exact ⟨b, h_bary_eq⟩
  obtain ⟨b, hb_dual⟩ := hb_dual_ex
  have h_projSpace : ∀ (x : EuclideanSpace ℝ (Fin d)) (t : ℝ),
      projSpace (mkSpaceTime x t) = x := by
    intro x t
    ext i
    simp [projSpace, mkSpaceTime]
  have h_projTime : ∀ (x : EuclideanSpace ℝ (Fin d)) (t : ℝ),
      projTime (mkSpaceTime x t) = t := by
    intro x t
    simp [projTime, mkSpaceTime]
  have h_cont_mk : ∀ (t : ℝ),
      Continuous (fun y : EuclideanSpace ℝ (Fin d) => mkSpaceTime y t) := by
    intro t
    unfold mkSpaceTime
    refine (EuclideanSpace.equiv (Fin (d + 1)) ℝ).symm.continuous.comp ?_
    rw [continuous_pi_iff]
    intro j
    refine Fin.lastCases ?_ ?_ j
    · simp only [Fin.snoc_last]
      exact continuous_const
    · intro i
      simp only [Fin.snoc_castSucc]
      exact (continuous_apply i).comp (EuclideanSpace.equiv (Fin d) ℝ).continuous
  let z₀ : EuclideanSpace ℝ (Fin (d + 1)) := mkSpaceTime 0 1
  have hz₀_space : projSpace z₀ = 0 := h_projSpace 0 1
  have hz₀_time : projTime z₀ = 1 := h_projTime 0 1
  have h_bary_mem : ∀ (f : EuclideanSpace ℝ (Fin (d + 1)) → ℝ),
      f z₀ ∈ { val : ℝ | ∃ (N : ℕ) (θ : Fin N → ℝ) (y : Fin N → EuclideanSpace ℝ (Fin d)),
        (∀ i, 0 < θ i) ∧ (∑ i, θ i = 1) ∧ (∑ i, θ i • y i = projSpace z₀) ∧
        val = (∑ i, θ i * f (mkSpaceTime (y i) (projTime z₀))) -
          (∑ i, θ i * ‖y i - projSpace z₀‖ ^ 2) / (2 * 1) } := by
    intro f
    refine ⟨1, fun _ => 1, fun _ => 0, fun _ => zero_lt_one, by simp, by simp [hz₀_space], ?_⟩
    simp [hz₀_space, hz₀_time, z₀]
  have h_ub : barycentricEnvelope d 1 v z₀ - v z₀ ≤ κ ^ 2 / 2 := by
    have h_le : barycentricEnvelope d 1 v z₀ ≤ v z₀ + κ ^ 2 / 2 := by
      apply csSup_le ⟨v z₀, h_bary_mem v⟩
      rintro val ⟨N, θ, y, hθ_pos, hθ_sum, hy_mean, rfl⟩
      let x : EuclideanSpace ℝ (Fin d) := ∑ i, θ i • y i
      have hx_eq : x = projSpace z₀ := hy_mean
      have hx_zero : x = 0 := hy_mean.trans hz₀_space
      let S_var : ℝ := ∑ i, θ i * ‖y i - x‖ ^ 2
      let r : ℝ := Real.sqrt S_var
      have hS_nonneg : 0 ≤ S_var := by
        apply Finset.sum_nonneg
        intro i _
        exact mul_nonneg (le_of_lt (hθ_pos i)) (sq_nonneg _)
      have hr_sq : r ^ 2 = S_var := Real.sq_sqrt hS_nonneg
      have h_jen := hv_jensen (projTime z₀) N θ y hθ_pos hθ_sum
      change (∑ i, θ i * v (mkSpaceTime (y i) (projTime z₀))) -
        v (mkSpaceTime x (projTime z₀)) ≤ κ * r at h_jen
      have h_mk_x : mkSpaceTime x (projTime z₀) = z₀ := by
        rw [hx_zero, hz₀_time]
      rw [h_mk_x] at h_jen
      have h_var_eq : (∑ i, θ i * ‖y i - projSpace z₀‖ ^ 2) = r ^ 2 := by
        rw [← hx_eq, hr_sq]
      rw [h_var_eq]
      have h_sq_nonneg : 0 ≤ (r - κ) ^ 2 := sq_nonneg (r - κ)
      linarith
    linarith
  let zb : EuclideanSpace ℝ (Fin (d + 1)) := mkSpaceTime b 0
  have hzb_space : projSpace zb = b := h_projSpace b 0
  have hzb_time : projTime zb = 0 := h_projTime b 0
  obtain ⟨M, hM_pos, hM⟩ := h_subquad_all (1 / 4) (by norm_num)
  let R_star : ℝ := max (max M (8 * ‖b‖)) 1
  have hR_ge_M : M ≤ R_star := le_trans (le_max_left M (8 * ‖b‖)) (le_max_left _ 1)
  have hR_ge_b : 8 * ‖b‖ ≤ R_star := le_trans (le_max_right M (8 * ‖b‖)) (le_max_left _ 1)
  have hR_ge_one : (1 : ℝ) ≤ R_star := le_max_right _ 1
  have hR_pos : 0 < R_star := lt_of_lt_of_le zero_lt_one hR_ge_one
  have h_tail : ∀ (w : EuclideanSpace ℝ (Fin (d + 1)) → ℝ) (y : EuclideanSpace ℝ (Fin d)),
      R_star ≤ ‖y‖ → |w (mkSpaceTime y 1)| ≤ (1 / 4 : ℝ) * ‖y‖ ^ 2 →
      w (mkSpaceTime y 1) - ‖y - b‖ ^ 2 / 2 ≤ - ‖b‖ ^ 2 / 2 := by
    intro w y hy_R hw_growth
    have hw_le : w (mkSpaceTime y 1) ≤ (1 / 4 : ℝ) * ‖y‖ ^ 2 :=
      le_trans (le_abs_self _) hw_growth
    have h_norm_sub : ‖y - b‖ ^ 2 = ‖y‖ ^ 2 - 2 * inner ℝ y b + ‖b‖ ^ 2 :=
      norm_sub_sq_real y b
    have h_inner : inner ℝ y b ≤ ‖y‖ * ‖b‖ :=
      le_trans (le_abs_self _) (abs_real_inner_le_norm y b)
    have hy_nonneg : 0 ≤ ‖y‖ := norm_nonneg y
    have h_yb : 8 * (‖y‖ * ‖b‖) ≤ ‖y‖ ^ 2 := by
      have h8b : 8 * ‖b‖ ≤ ‖y‖ := le_trans hR_ge_b hy_R
      nlinarith
    have hy_sq : 0 ≤ ‖y‖ ^ 2 := sq_nonneg ‖y‖
    linarith
  let g_v : EuclideanSpace ℝ (Fin d) → ℝ := fun y =>
    v (mkSpaceTime y (projTime zb + 1)) - ‖y - projSpace zb‖ ^ 2 / (2 * 1)
  have hg_v_eq : ∀ y : EuclideanSpace ℝ (Fin d),
      g_v y = v (mkSpaceTime y 1) - ‖y - b‖ ^ 2 / 2 := by
    intro y
    dsimp [g_v]
    rw [hzb_time, zero_add, hzb_space]
    ring
  have hg_v_cont : Continuous g_v := by
    refine Continuous.sub ?_ ?_
    · exact hv_class.1.comp (h_cont_mk (projTime zb + 1))
    · exact ((continuous_norm.comp (continuous_id.sub continuous_const)).pow 2).div_const (2 * 1)
  have h_bdd_v : BddAbove (g_v '' Set.univ) := by
    obtain ⟨U₀, hU₀⟩ :=
      (ProperSpace.isCompact_closedBall (0 : EuclideanSpace ℝ (Fin d)) R_star).bddAbove_image
        hg_v_cont.continuousOn
    refine ⟨max U₀ (- ‖b‖ ^ 2 / 2), ?_⟩
    rintro _ ⟨y, -, rfl⟩
    rcases le_or_gt ‖y‖ R_star with hy_le | hy_gt
    · have hy_mem : y ∈ Metric.closedBall (0 : EuclideanSpace ℝ (Fin d)) R_star := by
        simpa [Metric.mem_closedBall, dist_zero_right] using hy_le
      exact le_trans (hU₀ ⟨y, hy_mem, rfl⟩) (le_max_left _ _)
    · have hy_R : R_star ≤ ‖y‖ := le_of_lt hy_gt
      have hy_M : M ≤ ‖y‖ := le_trans hR_ge_M hy_R
      have h_est := h_tail v y hy_R (hM v hv_class hv_cent y hy_M)
      rw [← hg_v_eq y] at h_est
      exact le_trans h_est (le_max_right _ _)
  have hv_le_quad : ∀ y : EuclideanSpace ℝ (Fin d),
      v (mkSpaceTime y 1) - ‖y - b‖ ^ 2 / 2 ≤ quadEnvelopePlus d 1 v zb := by
    intro y
    rw [← hg_v_eq y]
    exact le_csSup h_bdd_v ⟨y, Set.mem_univ y, rfl⟩
  have h_quad_lb : - ‖b‖ ^ 2 / 2 ≤ quadEnvelopePlus d 1 v zb := by
    simpa [hv_cent.1, neg_div] using hv_le_quad 0
  have h_lb_dual : κ ^ 2 / 2 ≤ quadEnvelopePlus d 1 v zb + ‖b‖ ^ 2 / 2 := by
    apply le_of_forall_pos_le_add
    intro ε hε
    have hε2 : 0 < ε / 2 := by linarith
    obtain ⟨N₀, hN₀⟩ := h_conv R_star hR_pos (ε / 2) hε2
    let m : ℕ := N₀
    have hm_N₀ : N₀ ≤ m := le_rfl
    have hw_pt : ∀ y : EuclideanSpace ℝ (Fin d),
        w_seq m (mkSpaceTime y 1) - ‖y - b‖ ^ 2 / 2 ≤ quadEnvelopePlus d 1 v zb + ε / 2 := by
      intro y
      rcases le_or_gt ‖y‖ R_star with hy_le | hy_gt
      · have h_diff := hN₀ m hm_N₀ (mkSpaceTime y 1)
          (by simpa [h_projSpace] using hy_le)
          (by rw [h_projTime, abs_of_pos zero_lt_one]; exact hR_ge_one)
        have hw_le_v : w_seq m (mkSpaceTime y 1) ≤ v (mkSpaceTime y 1) + ε / 2 := by
          linarith [(abs_sub_le_iff.mp h_diff).1]
        have hv_y := hv_le_quad y
        linarith
      · have hy_R : R_star ≤ ‖y‖ := le_of_lt hy_gt
        have hy_M : M ≤ ‖y‖ := le_trans hR_ge_M hy_R
        have h_est := h_tail (w_seq m) y hy_R
          (hM (w_seq m) (hw_seq m).1 (hw_seq m).2.1 y hy_M)
        linarith
    have hw_bary_le : barycentricEnvelope d 1 (w_seq m) z₀ ≤
        quadEnvelopePlus d 1 v zb + ‖b‖ ^ 2 / 2 + ε / 2 := by
      apply csSup_le ⟨w_seq m z₀, h_bary_mem (w_seq m)⟩
      rintro val ⟨N, θ, y, hθ_pos, hθ_sum, hy_mean, rfl⟩
      have hy_zero : ∑ i, θ i • y i = 0 := hy_mean.trans hz₀_space
      have h_var_shift : (∑ i, θ i * ‖y i - b‖ ^ 2) =
          (∑ i, θ i * ‖y i - projSpace z₀‖ ^ 2) + ‖b‖ ^ 2 := by
        have h_sub_sq : ∀ i : Fin N,
            θ i * ‖y i - b‖ ^ 2 =
              θ i * ‖y i - projSpace z₀‖ ^ 2 - 2 * inner ℝ (θ i • y i) b + θ i * ‖b‖ ^ 2 := by
          intro i
          rw [hz₀_space, sub_zero, norm_sub_sq_real (y i) b, real_inner_smul_left]
          ring
        simp_rw [h_sub_sq, Finset.sum_add_distrib, Finset.sum_sub_distrib, ← Finset.mul_sum,
          ← sum_inner, hy_zero, inner_zero_left, mul_zero, sub_zero, ← Finset.sum_mul,
          hθ_sum, one_mul]
      have h_sum_pt : (∑ i, θ i * (w_seq m (mkSpaceTime (y i) 1) - ‖y i - b‖ ^ 2 / 2)) ≤
          quadEnvelopePlus d 1 v zb + ε / 2 := by
        calc ∑ i, θ i * (w_seq m (mkSpaceTime (y i) 1) - ‖y i - b‖ ^ 2 / 2)
          _ ≤ ∑ i, θ i * (quadEnvelopePlus d 1 v zb + ε / 2) := by
              apply Finset.sum_le_sum
              intro i _
              exact mul_le_mul_of_nonneg_left (hw_pt (y i)) (le_of_lt (hθ_pos i))
          _ = (∑ i, θ i) * (quadEnvelopePlus d 1 v zb + ε / 2) := by
              rw [← Finset.sum_mul]
          _ = quadEnvelopePlus d 1 v zb + ε / 2 := by
              rw [hθ_sum, one_mul]
      have h_lhs_id : (∑ i, θ i * (w_seq m (mkSpaceTime (y i) 1) - ‖y i - b‖ ^ 2 / 2)) =
          (∑ i, θ i * w_seq m (mkSpaceTime (y i) (projTime z₀))) -
            (∑ i, θ i * ‖y i - b‖ ^ 2) / 2 := by
        rw [hz₀_time, Finset.sum_div]
        rw [← Finset.sum_sub_distrib]
        congr 1 with i
        ring
      linarith
    have hw_gap := (hw_seq m).2.2.2
    have hw_zero : w_seq m z₀ = 0 := (hw_seq m).2.1.1
    linarith
  have hv_zero : v z₀ = 0 := hv_cent.1
  linarith

theorem constant_slope_limit_of_localized_contacts (d : ℕ) (hd : 3 ≤ d) (C₁ : ℝ) (hC₁ : 1 ≤ C₁)
    (κ : ℝ) (hκ : 0 < κ) (v : EuclideanSpace ℝ (Fin (d + 1)) → ℝ)
    (hv_class : InLimitingClassA d C₁ v)
    (hv_jensen : HasHorizontalJensenBound d κ v)
    (K : ℝ) (x_end : EuclideanSpace ℝ (Fin d)) (H_end : ℝ)
    (k : ℕ → ℕ) (x_seq : ℕ → EuclideanSpace ℝ (Fin d))
    (p_seq : ℕ → EuclideanSpace ℝ (Fin d)) (a_seq : ℕ → ℝ)
    (hK : 0 < K)
    (hslope_end : HasCommonSlopeLimit d v (mkSpaceTime x_end 0) H_end)
    (hk : StrictMono k)
    (h_contacts : ∀ j : ℕ,
      let r_j : ℝ := (1 / 2 : ℝ) ^ (k j)
      shiftedBarycentricEnvelope d κ v (mkSpaceTime (x_seq j) r_j) =
        v (mkSpaceTime (x_seq j) r_j) ∧
      IsFitAt d C₁ v (x_seq j) r_j r_j (p_seq j) (a_seq j) ∧
      ‖x_end - x_seq j + r_j • p_seq j‖ ≤ K * r_j) :
    ∃ (v_inf : EuclideanSpace ℝ (Fin (d + 1)) → ℝ) (b : EuclideanSpace ℝ (Fin d)) (B : ℝ),
      InLimitingClassA d C₁ v_inf ∧
      (∀ ℓ : ℝ, 0 < ℓ →
        slopePlus d ℓ v_inf (mkSpaceTime b 0) = B ∧
        slopeMinus d ℓ v_inf (mkSpaceTime b 0) = B) ∧
      barycentricEnvelope d 1 v_inf (mkSpaceTime 0 1) - v_inf (mkSpaceTime 0 1) = κ ^ 2 / 2 :=
by
  have h_growth : HasUniformSubquadraticGrowth d C₁ :=
    centered_class_A_subquadratic_growth d hd C₁ hC₁
  let r_seq : ℕ → ℝ := fun j => (1 / 2 : ℝ) ^ (k j)
  let w_seq : ℕ → EuclideanSpace ℝ (Fin (d + 1)) → ℝ :=
    fun j => fittedFrameTransform d v (x_seq j) (r_seq j) (p_seq j) (a_seq j)
  let b_seq : ℕ → EuclideanSpace ℝ (Fin d) :=
    fun j => (r_seq j)⁻¹ • (x_end - x_seq j + (r_seq j) • p_seq j)
  have hr_pos : ∀ j : ℕ, 0 < r_seq j := fun j => pow_pos (by norm_num) (k j)
  have h_frame : ∀ j : ℕ,
      InLimitingClassA d C₁ (w_seq j) ∧
      IsCenteredAt d C₁ (w_seq j) 0 1 ∧
      HasHorizontalJensenBound d κ (w_seq j) ∧
      barycentricEnvelope d 1 (w_seq j) (mkSpaceTime 0 1) - w_seq j (mkSpaceTime 0 1) = κ ^ 2 / 2 ∧
      ‖b_seq j‖ ≤ K ∧
      (∀ ℓ : ℝ, 0 < ℓ →
        slopePlus d ℓ (w_seq j) (mkSpaceTime (b_seq j) 0) =
          slopePlus d (r_seq j * ℓ) v (mkSpaceTime x_end 0) - a_seq j ∧
        slopeMinus d ℓ (w_seq j) (mkSpaceTime (b_seq j) 0) =
          slopeMinus d (r_seq j * ℓ) v (mkSpaceTime x_end 0) - a_seq j) := by
    intro j
    obtain ⟨h_env, h_fit, h_loc⟩ := h_contacts j
    exact fitted_frame_covariance_and_centering d hd C₁ hC₁ κ hκ h_growth v hv_class hv_jensen
      (x_seq j) (p_seq j) x_end (r_seq j) (a_seq j) K (hr_pos j) h_env h_fit h_loc
  obtain ⟨v_inf, b, φ, hφ, hv_inf_class, hv_inf_cent, h_conv, hb_tendsto⟩ :=
    centered_class_A_compactness d hd C₁ hC₁ h_growth K hK w_seq b_seq
      (fun j => ⟨(h_frame j).1, (h_frame j).2.1, (h_frame j).2.2.2.2.1⟩)
  have hv_inf_gap :
      barycentricEnvelope d 1 v_inf (mkSpaceTime 0 1) - v_inf (mkSpaceTime 0 1) = κ ^ 2 / 2 :=
    barycentric_gap_limit_of_loc_unif d hd C₁ hC₁ κ hκ h_growth
      (fun m => w_seq (φ m)) v_inf
      (fun m => ⟨(h_frame (φ m)).1, (h_frame (φ m)).2.1, (h_frame (φ m)).2.2.1,
        (h_frame (φ m)).2.2.2.1⟩)
      hv_inf_class hv_inf_cent h_conv
  let B : ℝ := slopePlus d 1 v_inf (mkSpaceTime b 0)
  have h_one_pos : (0 : ℝ) < 1 := zero_lt_one
  have h_tendsto_1 :
      Filter.Tendsto (fun m => slopePlus d 1 (w_seq (φ m)) (mkSpaceTime (b_seq (φ m)) 0))
        Filter.atTop (nhds B) :=
    (envelope_slopes_tendsto_of_loc_unif d hd C₁ hC₁ h_growth
      (fun m => w_seq (φ m)) v_inf (fun m => b_seq (φ m)) b
      (fun m => ⟨(h_frame (φ m)).1, (h_frame (φ m)).2.1⟩)
      hv_inf_class hv_inf_cent h_conv hb_tendsto 1 h_one_pos).1
  have hr_tendsto_zero : Filter.Tendsto (fun m => r_seq (φ m)) Filter.atTop (nhds 0) := by
    have hkφ : StrictMono (k ∘ φ) := hk.comp hφ
    exact (tendsto_pow_atTop_nhds_zero_of_lt_one (by norm_num) (by norm_num)).comp
      hkφ.tendsto_atTop
  have hr_scale_nhdsWithin : ∀ c : ℝ, 0 < c →
      Filter.Tendsto (fun m => r_seq (φ m) * c) Filter.atTop (nhdsWithin 0 (Set.Ioi 0)) := by
    intro c hc
    rw [tendsto_nhdsWithin_iff]
    refine ⟨?_, Filter.Eventually.of_forall (fun m => mul_pos (hr_pos (φ m)) hc)⟩
    simpa [zero_mul] using hr_tendsto_zero.mul_const c
  refine ⟨v_inf, b, B, hv_inf_class, ?_, hv_inf_gap⟩
  intro ℓ hℓ
  have h_tendsto_ℓ :=
    envelope_slopes_tendsto_of_loc_unif d hd C₁ hC₁ h_growth
      (fun m => w_seq (φ m)) v_inf (fun m => b_seq (φ m)) b
      (fun m => ⟨(h_frame (φ m)).1, (h_frame (φ m)).2.1⟩)
      hv_inf_class hv_inf_cent h_conv hb_tendsto ℓ hℓ
  have h_diff_plus_lhs :
      Filter.Tendsto
        (fun m => slopePlus d ℓ (w_seq (φ m)) (mkSpaceTime (b_seq (φ m)) 0) -
          slopePlus d 1 (w_seq (φ m)) (mkSpaceTime (b_seq (φ m)) 0))
        Filter.atTop (nhds (slopePlus d ℓ v_inf (mkSpaceTime b 0) - B)) :=
    h_tendsto_ℓ.1.sub h_tendsto_1
  have h_diff_minus_lhs :
      Filter.Tendsto
        (fun m => slopeMinus d ℓ (w_seq (φ m)) (mkSpaceTime (b_seq (φ m)) 0) -
          slopePlus d 1 (w_seq (φ m)) (mkSpaceTime (b_seq (φ m)) 0))
        Filter.atTop (nhds (slopeMinus d ℓ v_inf (mkSpaceTime b 0) - B)) :=
    h_tendsto_ℓ.2.sub h_tendsto_1
  have h_eq_plus :
      (fun m => slopePlus d ℓ (w_seq (φ m)) (mkSpaceTime (b_seq (φ m)) 0) -
        slopePlus d 1 (w_seq (φ m)) (mkSpaceTime (b_seq (φ m)) 0)) =
      (fun m => slopePlus d (r_seq (φ m) * ℓ) v (mkSpaceTime x_end 0) -
        slopePlus d (r_seq (φ m) * 1) v (mkSpaceTime x_end 0)) := by
    ext m
    have h1 := ((h_frame (φ m)).2.2.2.2.2 ℓ hℓ).1
    have h2 := ((h_frame (φ m)).2.2.2.2.2 1 h_one_pos).1
    linarith
  have h_eq_minus :
      (fun m => slopeMinus d ℓ (w_seq (φ m)) (mkSpaceTime (b_seq (φ m)) 0) -
        slopePlus d 1 (w_seq (φ m)) (mkSpaceTime (b_seq (φ m)) 0)) =
      (fun m => slopeMinus d (r_seq (φ m) * ℓ) v (mkSpaceTime x_end 0) -
        slopePlus d (r_seq (φ m) * 1) v (mkSpaceTime x_end 0)) := by
    ext m
    have h1 := ((h_frame (φ m)).2.2.2.2.2 ℓ hℓ).2
    have h2 := ((h_frame (φ m)).2.2.2.2.2 1 h_one_pos).1
    linarith
  have h_diff_plus_rhs :
      Filter.Tendsto
        (fun m => slopePlus d (r_seq (φ m) * ℓ) v (mkSpaceTime x_end 0) -
          slopePlus d (r_seq (φ m) * 1) v (mkSpaceTime x_end 0))
        Filter.atTop (nhds (H_end - H_end)) :=
    (hslope_end.1.comp (hr_scale_nhdsWithin ℓ hℓ)).sub
      (hslope_end.1.comp (hr_scale_nhdsWithin 1 h_one_pos))
  have h_diff_minus_rhs :
      Filter.Tendsto
        (fun m => slopeMinus d (r_seq (φ m) * ℓ) v (mkSpaceTime x_end 0) -
          slopePlus d (r_seq (φ m) * 1) v (mkSpaceTime x_end 0))
        Filter.atTop (nhds (H_end - H_end)) :=
    (hslope_end.2.comp (hr_scale_nhdsWithin ℓ hℓ)).sub
      (hslope_end.1.comp (hr_scale_nhdsWithin 1 h_one_pos))
  rw [h_eq_plus] at h_diff_plus_lhs
  rw [h_eq_minus] at h_diff_minus_lhs
  have h_zero_plus : slopePlus d ℓ v_inf (mkSpaceTime b 0) - B = H_end - H_end :=
    tendsto_nhds_unique h_diff_plus_lhs h_diff_plus_rhs
  have h_zero_minus : slopeMinus d ℓ v_inf (mkSpaceTime b 0) - B = H_end - H_end :=
    tendsto_nhds_unique h_diff_minus_lhs h_diff_minus_rhs
  constructor <;> linarith

theorem global_directed_comparison_of_constant_slopes (d : ℕ)
    (v : EuclideanSpace ℝ (Fin (d + 1)) → ℝ) (hv_cont : Continuous v)
    (h_comp : ∀ (x y : EuclideanSpace ℝ (Fin d)) (t ℓ : ℝ), 0 < ℓ →
      v (mkSpaceTime y (t + ℓ)) - v (mkSpaceTime x t) - ‖y - x‖ ^ 2 / (2 * ℓ) ≤
        ℓ * slopePlus d ℓ v (mkSpaceTime x t) ∧
      v (mkSpaceTime x t) - v (mkSpaceTime y (t - ℓ)) - ‖y - x‖ ^ 2 / (2 * ℓ) ≤
        ℓ * slopeMinus d ℓ v (mkSpaceTime x t))
    (h_attain : ∀ (x : EuclideanSpace ℝ (Fin d)) (t ℓ : ℝ), 0 < ℓ →
      (∃ y_plus : EuclideanSpace ℝ (Fin d),
        v (mkSpaceTime y_plus (t + ℓ)) - v (mkSpaceTime x t) - ‖y_plus - x‖ ^ 2 / (2 * ℓ) =
          ℓ * slopePlus d ℓ v (mkSpaceTime x t)) ∧
      (∃ y_minus : EuclideanSpace ℝ (Fin d),
        v (mkSpaceTime x t) - v (mkSpaceTime y_minus (t - ℓ)) - ‖y_minus - x‖ ^ 2 / (2 * ℓ) =
          ℓ * slopeMinus d ℓ v (mkSpaceTime x t)))
    (h_mono : ∀ (x : EuclideanSpace ℝ (Fin d)) (t ℓ₁ ℓ₂ : ℝ), 0 < ℓ₁ → ℓ₁ ≤ ℓ₂ →
      slopePlus d ℓ₁ v (mkSpaceTime x t) ≤ slopePlus d ℓ₂ v (mkSpaceTime x t) ∧
      slopeMinus d ℓ₁ v (mkSpaceTime x t) ≤ slopeMinus d ℓ₂ v (mkSpaceTime x t))
    (b : EuclideanSpace ℝ (Fin d)) (t₀ B : ℝ)
    (h_slopes : ∀ ℓ : ℝ, 0 < ℓ →
      slopePlus d ℓ v (mkSpaceTime b t₀) = B ∧
      slopeMinus d ℓ v (mkSpaceTime b t₀) = B)
    (x y : EuclideanSpace ℝ (Fin d)) (t ℓ : ℝ) (hℓ : 0 < ℓ) :
    v (mkSpaceTime y (t + ℓ)) - v (mkSpaceTime x t) ≤ B * ℓ + ‖y - x‖ ^ 2 / (2 * ℓ) :=
by
  have h_norm_smul_sq : ∀ (r : ℝ) (u : EuclideanSpace ℝ (Fin d)),
      ‖r • u‖ ^ 2 = r ^ 2 * ‖u‖ ^ 2 := by
    intro r u
    rw [norm_smul, mul_pow, Real.norm_eq_abs, sq_abs]
  have h_quad_diff_le : ∀ (b₀ x₀ y₀ : EuclideanSpace ℝ (Fin d)) (δ r : ℝ),
      0 < δ → 0 < r →
      ‖y₀ - b₀‖ ^ 2 / (2 * (δ + r)) - ‖y₀ - x₀‖ ^ 2 / (2 * r) ≤ ‖x₀ - b₀‖ ^ 2 / (2 * δ) := by
    intro b₀ x₀ y₀ δ r hδ hr
    let u : EuclideanSpace ℝ (Fin d) := x₀ - b₀
    let w : EuclideanSpace ℝ (Fin d) := y₀ - x₀
    have hyb : y₀ - b₀ = u + w := by
      dsimp [u, w]
      abel
    have h_id : ‖u‖ ^ 2 / (2 * δ) - (‖u + w‖ ^ 2 / (2 * (δ + r)) - ‖w‖ ^ 2 / (2 * r)) =
        ‖r • u - δ • w‖ ^ 2 / (2 * δ * r * (δ + r)) := by
      have hδ_ne : δ ≠ 0 := ne_of_gt hδ
      have hr_ne : r ≠ 0 := ne_of_gt hr
      have hδr_ne : δ + r ≠ 0 := ne_of_gt (add_pos hδ hr)
      rw [norm_add_sq_real u w, norm_sub_sq_real (r • u) (δ • w),
        h_norm_smul_sq r u, h_norm_smul_sq δ w, real_inner_smul_left, real_inner_smul_right]
      field_simp
      ring
    rw [← hyb] at h_id
    have h_nonneg : 0 ≤ ‖r • u - δ • w‖ ^ 2 / (2 * δ * r * (δ + r)) := by
      apply div_nonneg (sq_nonneg _)
      positivity
    linarith
  have h_slope_le : ∀ (S : ℝ → ℝ) (C : ℝ),
      (∀ r₁ r₂ : ℝ, 0 < r₁ → r₁ ≤ r₂ → S r₁ ≤ S r₂) →
      (∀ r : ℝ, 0 < r → r * (S r - B) ≤ C) →
      ∀ r₀ : ℝ, 0 < r₀ → S r₀ ≤ B := by
    intro S C hS_mono hS_lin r₀ hr₀
    by_contra h_gt
    push_neg at h_gt
    let D : ℝ := S r₀ - B
    have hD : 0 < D := sub_pos.mpr h_gt
    let M : ℝ := max C 0
    have hM_nonneg : 0 ≤ M := le_max_right C 0
    have hC_le_M : C ≤ M := le_max_left C 0
    let r : ℝ := r₀ + (M + 1) / D
    have h_div_pos : 0 < (M + 1) / D := div_pos (by linarith) hD
    have hr_pos : 0 < r := by dsimp [r]; linarith
    have hr₀_le : r₀ ≤ r := by dsimp [r]; linarith
    have hS_le : S r₀ ≤ S r := hS_mono r₀ r hr₀ hr₀_le
    have hD_le : D ≤ S r - B := by dsimp [D]; linarith
    have hrD_le : r * D ≤ r * (S r - B) :=
      mul_le_mul_of_nonneg_left hD_le (le_of_lt hr_pos)
    have hr_lin : r * (S r - B) ≤ C := hS_lin r hr_pos
    have hrD_eq : r * D = r₀ * D + (M + 1) := by
      dsimp [r]
      rw [add_mul, div_mul_cancel₀ (M + 1) (ne_of_gt hD)]
    have hr₀D_pos : 0 < r₀ * D := mul_pos hr₀ hD
    linarith
  have h_comp_gt : ∀ (x' y' : EuclideanSpace ℝ (Fin d)) (t' r : ℝ),
      t₀ < t' → 0 < r →
      v (mkSpaceTime y' (t' + r)) - v (mkSpaceTime x' t') ≤ B * r + ‖y' - x'‖ ^ 2 / (2 * r) := by
    intro x' y' t' r ht' hr
    let δ : ℝ := t' - t₀
    have hδ : 0 < δ := sub_pos.mpr ht'
    have h_lin : ∀ s : ℝ, 0 < s →
        s * (slopePlus d s v (mkSpaceTime x' t') - B) ≤
          v (mkSpaceTime b t₀) - v (mkSpaceTime x' t') + B * δ + ‖x' - b‖ ^ 2 / (2 * δ) := by
      intro s hs
      obtain ⟨y_plus, hy_plus⟩ := (h_attain x' t' s hs).1
      have hτ : 0 < δ + s := add_pos hδ hs
      have ht₀τ : t₀ + (δ + s) = t' + s := by dsimp [δ]; ring
      have h_b := (h_comp b y_plus t₀ (δ + s) hτ).1
      have h_sb := (h_slopes (δ + s) hτ).1
      rw [ht₀τ, h_sb] at h_b
      have h_q := h_quad_diff_le b x' y_plus δ s hδ hs
      linarith
    have h_sp_le : slopePlus d r v (mkSpaceTime x' t') ≤ B := by
      apply h_slope_le (fun s => slopePlus d s v (mkSpaceTime x' t'))
        (v (mkSpaceTime b t₀) - v (mkSpaceTime x' t') + B * δ + ‖x' - b‖ ^ 2 / (2 * δ))
      · intro r₁ r₂ hr₁ hr₁₂
        exact (h_mono x' t' r₁ r₂ hr₁ hr₁₂).1
      · exact h_lin
      · exact hr
    have h_r_sp : r * slopePlus d r v (mkSpaceTime x' t') ≤ r * B :=
      mul_le_mul_of_nonneg_left h_sp_le (le_of_lt hr)
    have h_c := (h_comp x' y' t' r hr).1
    linarith
  have h_comp_lt : ∀ (x' y' : EuclideanSpace ℝ (Fin d)) (t' r : ℝ),
      t' + r < t₀ → 0 < r →
      v (mkSpaceTime y' (t' + r)) - v (mkSpaceTime x' t') ≤ B * r + ‖y' - x'‖ ^ 2 / (2 * r) := by
    intro x' y' t' r ht' hr
    let s₀ : ℝ := t' + r
    let δ : ℝ := t₀ - s₀
    have hδ : 0 < δ := sub_pos.mpr ht'
    have h_lin : ∀ s : ℝ, 0 < s →
        s * (slopeMinus d s v (mkSpaceTime y' s₀) - B) ≤
          v (mkSpaceTime y' s₀) - v (mkSpaceTime b t₀) + B * δ + ‖y' - b‖ ^ 2 / (2 * δ) := by
      intro s hs
      obtain ⟨y_minus, hy_minus⟩ := (h_attain y' s₀ s hs).2
      have hτ : 0 < δ + s := add_pos hδ hs
      have ht₀τ : t₀ - (δ + s) = s₀ - s := by dsimp [δ]; ring
      have h_b := (h_comp b y_minus t₀ (δ + s) hτ).2
      have h_sb := (h_slopes (δ + s) hτ).2
      rw [ht₀τ, h_sb] at h_b
      have h_q := h_quad_diff_le b y' y_minus δ s hδ hs
      linarith
    have h_sm_le : slopeMinus d r v (mkSpaceTime y' s₀) ≤ B := by
      apply h_slope_le (fun s => slopeMinus d s v (mkSpaceTime y' s₀))
        (v (mkSpaceTime y' s₀) - v (mkSpaceTime b t₀) + B * δ + ‖y' - b‖ ^ 2 / (2 * δ))
      · intro r₁ r₂ hr₁ hr₁₂
        exact (h_mono y' s₀ r₁ r₂ hr₁ hr₁₂).2
      · exact h_lin
      · exact hr
    have h_r_sm : r * slopeMinus d r v (mkSpaceTime y' s₀) ≤ r * B :=
      mul_le_mul_of_nonneg_left h_sm_le (le_of_lt hr)
    have h_c := (h_comp y' x' s₀ r hr).2
    have hs₀_sub : s₀ - r = t' := by dsimp [s₀]; ring
    rw [hs₀_sub, norm_sub_rev x' y'] at h_c
    linarith
  have h_cont_mk : ∀ x' : EuclideanSpace ℝ (Fin d), Continuous (fun τ : ℝ => mkSpaceTime x' τ) := by
    intro x'
    unfold mkSpaceTime
    apply Continuous.comp (ContinuousLinearEquiv.continuous _)
    rw [continuous_pi_iff]
    intro j
    refine Fin.lastCases ?_ ?_ j
    · simp only [Fin.snoc_last]
      exact continuous_id
    · intro i
      simp only [Fin.snoc_castSucc]
      exact continuous_const
  have h_le_of_gt : ∀ (f : ℝ → ℝ) (a C : ℝ),
      Continuous f → (∀ τ : ℝ, a < τ → f τ ≤ C) → f a ≤ C := by
    intro f a C hf h_gt_bound
    by_contra h_gt
    push_neg at h_gt
    let ε : ℝ := f a - C
    have hε : 0 < ε := sub_pos.mpr h_gt
    obtain ⟨δ, hδ_pos, hδ⟩ := Metric.continuousAt_iff.mp hf.continuousAt ε hε
    let τ : ℝ := a + δ / 2
    have haτ : a < τ := by dsimp [τ]; linarith
    have hfτ_le : f τ ≤ C := h_gt_bound τ haτ
    have h_dist_τ : dist τ a < δ := by
      rw [Real.dist_eq]
      have h_sub : τ - a = δ / 2 := by dsimp [τ]; ring
      rw [h_sub, abs_of_pos (by linarith)]
      linarith
    have h_dist_f : dist (f τ) (f a) < ε := hδ h_dist_τ
    rw [Real.dist_eq] at h_dist_f
    have h_abs := (abs_lt.mp h_dist_f).1
    dsimp [ε] at h_abs
    linarith
  have h_le_of_lt : ∀ (f : ℝ → ℝ) (a C : ℝ),
      Continuous f → (∀ τ : ℝ, τ < a → f τ ≤ C) → f a ≤ C := by
    intro f a C hf h_lt_bound
    by_contra h_gt
    push_neg at h_gt
    let ε : ℝ := f a - C
    have hε : 0 < ε := sub_pos.mpr h_gt
    obtain ⟨δ, hδ_pos, hδ⟩ := Metric.continuousAt_iff.mp hf.continuousAt ε hε
    let τ : ℝ := a - δ / 2
    have hτa : τ < a := by dsimp [τ]; linarith
    have hfτ_le : f τ ≤ C := h_lt_bound τ hτa
    have h_dist_τ : dist τ a < δ := by
      rw [Real.dist_eq]
      have h_sub : τ - a = -(δ / 2) := by dsimp [τ]; ring
      rw [h_sub, abs_of_neg (by linarith)]
      linarith
    have h_dist_f : dist (f τ) (f a) < ε := hδ h_dist_τ
    rw [Real.dist_eq] at h_dist_f
    have h_abs := (abs_lt.mp h_dist_f).1
    dsimp [ε] at h_abs
    linarith
  have h_comp_ge : ∀ (x' y' : EuclideanSpace ℝ (Fin d)) (t' r : ℝ),
      t₀ ≤ t' → 0 < r →
      v (mkSpaceTime y' (t' + r)) - v (mkSpaceTime x' t') ≤ B * r + ‖y' - x'‖ ^ 2 / (2 * r) := by
    intro x' y' t' r ht' hr
    have hf_cont : Continuous (fun τ : ℝ => v (mkSpaceTime y' (τ + r)) - v (mkSpaceTime x' τ)) :=
      Continuous.sub (hv_cont.comp ((h_cont_mk y').comp (continuous_id.add continuous_const)))
        (hv_cont.comp (h_cont_mk x'))
    rcases lt_or_eq_of_le ht' with h_gt | rfl
    · exact h_comp_gt x' y' t' r h_gt hr
    · exact h_le_of_gt (fun τ : ℝ => v (mkSpaceTime y' (τ + r)) - v (mkSpaceTime x' τ))
        t₀ (B * r + ‖y' - x'‖ ^ 2 / (2 * r)) hf_cont (fun τ hτ => h_comp_gt x' y' τ r hτ hr)
  have h_comp_le : ∀ (x' y' : EuclideanSpace ℝ (Fin d)) (t' r : ℝ),
      t' + r ≤ t₀ → 0 < r →
      v (mkSpaceTime y' (t' + r)) - v (mkSpaceTime x' t') ≤ B * r + ‖y' - x'‖ ^ 2 / (2 * r) := by
    intro x' y' t' r ht' hr
    have hf_cont : Continuous (fun τ : ℝ => v (mkSpaceTime y' (τ + r)) - v (mkSpaceTime x' τ)) :=
      Continuous.sub (hv_cont.comp ((h_cont_mk y').comp (continuous_id.add continuous_const)))
        (hv_cont.comp (h_cont_mk x'))
    rcases lt_or_eq_of_le ht' with h_lt | h_eq
    · exact h_comp_lt x' y' t' r h_lt hr
    · have ht'_eq : t' = t₀ - r := by linarith
      rw [ht'_eq]
      exact h_le_of_lt (fun τ : ℝ => v (mkSpaceTime y' (τ + r)) - v (mkSpaceTime x' τ))
        (t₀ - r) (B * r + ‖y' - x'‖ ^ 2 / (2 * r)) hf_cont
        (fun τ hτ => h_comp_lt x' y' τ r (by linarith) hr)
  rcases le_or_gt t₀ t with ht_ge | ht_lt
  · exact h_comp_ge x y t ℓ ht_ge hℓ
  · rcases le_or_gt (t + ℓ) t₀ with h_le | h_gt
    · exact h_comp_le x y t ℓ h_le hℓ
    · let ℓ₁ : ℝ := t₀ - t
      let ℓ₂ : ℝ := t + ℓ - t₀
      have hℓ₁ : 0 < ℓ₁ := sub_pos.mpr ht_lt
      have hℓ₂ : 0 < ℓ₂ := sub_pos.mpr h_gt
      let z : EuclideanSpace ℝ (Fin d) := x + (ℓ₁ / ℓ) • (y - x)
      have ht₁ : t + ℓ₁ = t₀ := by dsimp [ℓ₁]; ring
      have ht₂ : t₀ + ℓ₂ = t + ℓ := by dsimp [ℓ₂]; ring
      have h1 := h_comp_le x z t ℓ₁ (by linarith) hℓ₁
      have h2 := h_comp_ge z y t₀ ℓ₂ (le_refl t₀) hℓ₂
      rw [ht₁] at h1
      rw [ht₂] at h2
      have hzx : z - x = (ℓ₁ / ℓ) • (y - x) := by
        dsimp [z]
        exact add_sub_cancel_left x ((ℓ₁ / ℓ) • (y - x))
      have hyz : y - z = (ℓ₂ / ℓ) • (y - x) := by
        have h_sub : y - z = (1 : ℝ) • (y - x) - (ℓ₁ / ℓ) • (y - x) := by
          dsimp [z]
          rw [one_smul]
          abel
        rw [h_sub, ← sub_smul]
        congr 1
        have hℓ_ne : ℓ ≠ 0 := ne_of_gt hℓ
        field_simp
        dsimp [ℓ₁, ℓ₂]
        ring
      have h_q_sum : ‖z - x‖ ^ 2 / (2 * ℓ₁) + ‖y - z‖ ^ 2 / (2 * ℓ₂) = ‖y - x‖ ^ 2 / (2 * ℓ) := by
        rw [hzx, hyz, h_norm_smul_sq (ℓ₁ / ℓ) (y - x), h_norm_smul_sq (ℓ₂ / ℓ) (y - x)]
        have hℓ_ne : ℓ ≠ 0 := ne_of_gt hℓ
        have hℓ₁_ne : ℓ₁ ≠ 0 := ne_of_gt hℓ₁
        have hℓ₂_ne : ℓ₂ ≠ 0 := ne_of_gt hℓ₂
        field_simp
        dsimp [ℓ₁, ℓ₂]
        ring
      have h_B_sum : B * ℓ₁ + B * ℓ₂ = B * ℓ := by
        dsimp [ℓ₁, ℓ₂]
        ring
      linarith

theorem affine_of_global_directed_comparison_and_attainment (d : ℕ)
    (v : EuclideanSpace ℝ (Fin (d + 1)) → ℝ)
    (b : EuclideanSpace ℝ (Fin d)) (t₀ B : ℝ)
    (h_global : ∀ (x y : EuclideanSpace ℝ (Fin d)) (t ℓ : ℝ), 0 < ℓ →
      v (mkSpaceTime y (t + ℓ)) - v (mkSpaceTime x t) ≤ B * ℓ + ‖y - x‖ ^ 2 / (2 * ℓ))
    (h_attain_b : ∀ ℓ : ℝ, 0 < ℓ →
      (∃ y_plus : EuclideanSpace ℝ (Fin d),
        v (mkSpaceTime y_plus (t₀ + ℓ)) - v (mkSpaceTime b t₀) - ‖y_plus - b‖ ^ 2 / (2 * ℓ) =
          B * ℓ) ∧
      (∃ y_minus : EuclideanSpace ℝ (Fin d),
        v (mkSpaceTime b t₀) - v (mkSpaceTime y_minus (t₀ - ℓ)) - ‖y_minus - b‖ ^ 2 / (2 * ℓ) =
          B * ℓ)) :
    IsAffineSpaceTime d v :=
by
  have h_norm_smul_sq : ∀ (s : ℝ) (q : EuclideanSpace ℝ (Fin d)),
      ‖s • q‖ ^ 2 = s ^ 2 * ‖q‖ ^ 2 := by
    intro s q
    rw [norm_smul, Real.norm_eq_abs, mul_pow, sq_abs]
  have h_norm_sub_smul_sq : ∀ (u q : EuclideanSpace ℝ (Fin d)) (ℓ : ℝ),
      ‖u - ℓ • q‖ ^ 2 =
        (1 + ℓ) * ‖u‖ ^ 2 + ℓ * (1 + ℓ) * ‖q‖ ^ 2 - ℓ * ‖u + q‖ ^ 2 := by
    intro u q ℓ
    have h1 : ‖u + q‖ ^ 2 = ‖u‖ ^ 2 + 2 * inner ℝ u q + ‖q‖ ^ 2 := norm_add_sq_real u q
    have h2 : ‖u - ℓ • q‖ ^ 2 = ‖u‖ ^ 2 - 2 * inner ℝ u (ℓ • q) + ‖ℓ • q‖ ^ 2 :=
      norm_sub_sq_real u (ℓ • q)
    rw [real_inner_smul_right, h_norm_smul_sq] at h2
    rw [h2, h1]
    ring
  have h_mkSpaceTime_proj : ∀ z : EuclideanSpace ℝ (Fin (d + 1)),
      mkSpaceTime (projSpace z) (projTime z) = z := by
    intro z
    ext j
    refine Fin.lastCases ?_ ?_ j
    · simp [mkSpaceTime, projTime]
    · intro i
      simp [mkSpaceTime, projSpace]
  have h_inner_mkSpaceTime : ∀ (q : EuclideanSpace ℝ (Fin d)) (a_t : ℝ)
      (z : EuclideanSpace ℝ (Fin (d + 1))),
      inner ℝ (mkSpaceTime q a_t) z = inner ℝ q (projSpace z) + a_t * projTime z := by
    intro q a_t z
    rw [PiLp.inner_apply, PiLp.inner_apply, Fin.sum_univ_castSucc]
    have h_sum : (∑ i : Fin d, inner ℝ (mkSpaceTime q a_t (Fin.castSucc i)) (z (Fin.castSucc i))) =
        ∑ i : Fin d, inner ℝ (q i) (projSpace z i) := by
      congr 1 with i
      simp [mkSpaceTime, projSpace]
    have h_last : inner ℝ (mkSpaceTime q a_t (Fin.last d)) (z (Fin.last d)) = a_t * projTime z := by
      simp [mkSpaceTime, projTime, mul_comm]
    rw [h_sum, h_last]
  obtain ⟨y₁_minus, hy₁_minus⟩ := (h_attain_b 1 zero_lt_one).2
  let q : EuclideanSpace ℝ (Fin d) := b - y₁_minus
  have hq_norm : ‖y₁_minus - b‖ ^ 2 = ‖q‖ ^ 2 := by
    dsimp [q]
    rw [norm_sub_rev]
  have hy₁_eq : v (mkSpaceTime b t₀) - v (mkSpaceTime y₁_minus (t₀ - 1)) = B + ‖q‖ ^ 2 / 2 := by
    linarith [hy₁_minus, hq_norm]
  have h_ray_plus : ∀ (ℓ : ℝ), 0 < ℓ →
      v (mkSpaceTime (b + ℓ • q) (t₀ + ℓ)) =
        v (mkSpaceTime b t₀) + (B + ‖q‖ ^ 2 / 2) * ℓ := by
    intro ℓ hℓ
    obtain ⟨y_plus, hy_plus⟩ := (h_attain_b ℓ hℓ).1
    let u : EuclideanSpace ℝ (Fin d) := y_plus - b
    have hu_q : y_plus - y₁_minus = u + q := by
      dsimp [u, q]
      abel
    have h_step_pos : 0 < 1 + ℓ := by linarith
    have h_glob := h_global y₁_minus y_plus (t₀ - 1) (1 + ℓ) h_step_pos
    have h_time : (t₀ - 1) + (1 + ℓ) = t₀ + ℓ := by ring
    rw [h_time, hu_q] at h_glob
    have hu_norm : ‖y_plus - b‖ ^ 2 = ‖u‖ ^ 2 := rfl
    rw [hu_norm] at hy_plus
    have h_ineq : ‖u‖ ^ 2 / (2 * ℓ) + ‖q‖ ^ 2 / 2 ≤ ‖u + q‖ ^ 2 / (2 * (1 + ℓ)) := by
      linarith [hy₁_eq, hy_plus, h_glob]
    have h_alg : (1 + ℓ) * ‖u‖ ^ 2 + ℓ * (1 + ℓ) * ‖q‖ ^ 2 - ℓ * ‖u + q‖ ^ 2 =
        2 * ℓ * (1 + ℓ) * (‖u‖ ^ 2 / (2 * ℓ) + ‖q‖ ^ 2 / 2 - ‖u + q‖ ^ 2 / (2 * (1 + ℓ))) := by
      have hℓ_ne : ℓ ≠ 0 := ne_of_gt hℓ
      have h1ℓ_ne : 1 + ℓ ≠ 0 := ne_of_gt h_step_pos
      field_simp
    have h_nonpos : ‖u - ℓ • q‖ ^ 2 ≤ 0 := by
      rw [h_norm_sub_smul_sq u q ℓ, h_alg]
      have h_pos_fac : 0 ≤ 2 * ℓ * (1 + ℓ) := by positivity
      have h_diff_nonpos :
          ‖u‖ ^ 2 / (2 * ℓ) + ‖q‖ ^ 2 / 2 - ‖u + q‖ ^ 2 / (2 * (1 + ℓ)) ≤ 0 := by
        linarith [h_ineq]
      exact mul_nonpos_of_nonneg_of_nonpos h_pos_fac h_diff_nonpos
    have h_sq_zero : ‖u - ℓ • q‖ ^ 2 = 0 := le_antisymm h_nonpos (sq_nonneg _)
    have hu_eq : u = ℓ • q := by
      exact sub_eq_zero.mp (norm_eq_zero.mp (sq_eq_zero_iff.mp h_sq_zero))
    have hy_plus_eq : y_plus = b + ℓ • q := by
      dsimp [u] at hu_eq
      calc y_plus = b + (y_plus - b) := by abel
        _ = b + ℓ • q := by rw [hu_eq]
    rw [hu_eq, h_norm_smul_sq, hy_plus_eq] at hy_plus
    have h_div_simp : ℓ ^ 2 * ‖q‖ ^ 2 / (2 * ℓ) = ‖q‖ ^ 2 / 2 * ℓ := by
      have hℓ_ne : ℓ ≠ 0 := ne_of_gt hℓ
      field_simp
    linarith [hy_plus, h_div_simp]
  have h_ray_plus_one : v (mkSpaceTime (b + q) (t₀ + 1)) - v (mkSpaceTime b t₀) =
      B + ‖q‖ ^ 2 / 2 := by
    have h1 := h_ray_plus 1 zero_lt_one
    rw [one_smul] at h1
    linarith
  have h_ray_minus : ∀ (r : ℝ), 0 < r →
      v (mkSpaceTime (b - r • q) (t₀ - r)) =
        v (mkSpaceTime b t₀) - (B + ‖q‖ ^ 2 / 2) * r := by
    intro r hr
    obtain ⟨y_minus, hy_minus⟩ := (h_attain_b r hr).2
    let u_m : EuclideanSpace ℝ (Fin d) := b - y_minus
    have hu_m_q : (b + q) - y_minus = u_m + q := by
      dsimp [u_m]
      abel
    have h_step_pos : 0 < 1 + r := by linarith
    have h_glob := h_global y_minus (b + q) (t₀ - r) (1 + r) h_step_pos
    have h_time : (t₀ - r) + (1 + r) = t₀ + 1 := by ring
    rw [h_time, hu_m_q] at h_glob
    have hu_m_norm : ‖y_minus - b‖ ^ 2 = ‖u_m‖ ^ 2 := by
      dsimp [u_m]
      rw [norm_sub_rev]
    rw [hu_m_norm] at hy_minus
    have h_ineq : ‖u_m‖ ^ 2 / (2 * r) + ‖q‖ ^ 2 / 2 ≤ ‖u_m + q‖ ^ 2 / (2 * (1 + r)) := by
      linarith [h_ray_plus_one, hy_minus, h_glob]
    have h_alg : (1 + r) * ‖u_m‖ ^ 2 + r * (1 + r) * ‖q‖ ^ 2 - r * ‖u_m + q‖ ^ 2 =
        2 * r * (1 + r) * (‖u_m‖ ^ 2 / (2 * r) + ‖q‖ ^ 2 / 2 - ‖u_m + q‖ ^ 2 / (2 * (1 + r))) := by
      have hr_ne : r ≠ 0 := ne_of_gt hr
      have h1r_ne : 1 + r ≠ 0 := ne_of_gt h_step_pos
      field_simp
    have h_nonpos : ‖u_m - r • q‖ ^ 2 ≤ 0 := by
      rw [h_norm_sub_smul_sq u_m q r, h_alg]
      have h_pos_fac : 0 ≤ 2 * r * (1 + r) := by positivity
      have h_diff_nonpos :
          ‖u_m‖ ^ 2 / (2 * r) + ‖q‖ ^ 2 / 2 - ‖u_m + q‖ ^ 2 / (2 * (1 + r)) ≤ 0 := by
        linarith [h_ineq]
      exact mul_nonpos_of_nonneg_of_nonpos h_pos_fac h_diff_nonpos
    have h_sq_zero : ‖u_m - r • q‖ ^ 2 = 0 := le_antisymm h_nonpos (sq_nonneg _)
    have hu_m_eq : u_m = r • q := by
      exact sub_eq_zero.mp (norm_eq_zero.mp (sq_eq_zero_iff.mp h_sq_zero))
    have hy_minus_eq : y_minus = b - r • q := by
      dsimp [u_m] at hu_m_eq
      calc y_minus = b - (b - y_minus) := by abel
        _ = b - r • q := by rw [hu_m_eq]
    rw [hu_m_eq, h_norm_smul_sq, hy_minus_eq] at hy_minus
    have h_div_simp : r ^ 2 * ‖q‖ ^ 2 / (2 * r) = ‖q‖ ^ 2 / 2 * r := by
      have hr_ne : r ≠ 0 := ne_of_gt hr
      field_simp
    linarith [hy_minus, h_div_simp]
  have h_eval : ∀ (x : EuclideanSpace ℝ (Fin d)) (t : ℝ),
      v (mkSpaceTime x t) =
        v (mkSpaceTime b t₀) + inner ℝ q (x - b) + (B - ‖q‖ ^ 2 / 2) * (t - t₀) := by
    intro x t
    let δ : ℝ := t - t₀
    let w : EuclideanSpace ℝ (Fin d) := (x - b) - δ • q
    let A : ℝ := v (mkSpaceTime b t₀) + inner ℝ q (x - b) + (B - ‖q‖ ^ 2 / 2) * δ
    have hw_inner : inner ℝ w q = inner ℝ q (x - b) - δ * ‖q‖ ^ 2 := by
      dsimp [w]
      rw [inner_sub_left, real_inner_smul_left, real_inner_comm (x - b) q,
        real_inner_self_eq_norm_mul_norm, sq]
    have h_bounds : ∀ (τ : ℝ), |δ| < τ →
        |v (mkSpaceTime x t) - A| ≤ (‖w‖ ^ 2 / 2) / τ := by
      intro τ hτ
      have hδ_le : δ ≤ |δ| := le_abs_self δ
      have hneg_δ_le : -δ ≤ |δ| := neg_le_abs δ
      have hτ_pos : 0 < τ := lt_of_le_of_lt (abs_nonneg δ) hτ
      have hτ_ne : τ ≠ 0 := ne_of_gt hτ_pos
      let r : ℝ := τ - δ
      let ℓ : ℝ := τ + δ
      have hr_pos : 0 < r := by dsimp [r]; linarith
      have hℓ_pos : 0 < ℓ := by dsimp [ℓ]; linarith
      have h_glob_ub := h_global (b - r • q) x (t₀ - r) τ hτ_pos
      have h_time_ub : (t₀ - r) + τ = t := by dsimp [r, δ]; ring
      have h_vec_ub : x - (b - r • q) = w + τ • q := by
        dsimp [w, r]
        rw [sub_smul]
        abel
      have h_norm_ub : ‖x - (b - r • q)‖ ^ 2 =
          ‖w‖ ^ 2 + 2 * τ * (inner ℝ q (x - b) - δ * ‖q‖ ^ 2) + τ ^ 2 * ‖q‖ ^ 2 := by
        rw [h_vec_ub, norm_add_sq_real w (τ • q), real_inner_smul_right, h_norm_smul_sq, hw_inner]
        ring
      have h_ray_r := h_ray_minus r hr_pos
      rw [h_time_ub, h_norm_ub, h_ray_r] at h_glob_ub
      have h_ub_alg :
          v (mkSpaceTime b t₀) - (B + ‖q‖ ^ 2 / 2) * r +
            (B * τ + (‖w‖ ^ 2 + 2 * τ * (inner ℝ q (x - b) - δ * ‖q‖ ^ 2) + τ ^ 2 * ‖q‖ ^ 2) / (2 * τ)) =
          A + (‖w‖ ^ 2 / 2) / τ := by
        dsimp [A, r]
        field_simp
        ring
      have h_ub : v (mkSpaceTime x t) - A ≤ (‖w‖ ^ 2 / 2) / τ := by
        linarith [h_glob_ub, h_ub_alg]
      have h_glob_lb := h_global x (b + ℓ • q) t τ hτ_pos
      have h_time_lb : t + τ = t₀ + ℓ := by dsimp [ℓ, δ]; ring
      have h_vec_lb : (b + ℓ • q) - x = -(w - τ • q) := by
        dsimp [w, ℓ]
        rw [add_smul]
        abel
      have h_norm_lb : ‖(b + ℓ • q) - x‖ ^ 2 =
          ‖w‖ ^ 2 - 2 * τ * (inner ℝ q (x - b) - δ * ‖q‖ ^ 2) + τ ^ 2 * ‖q‖ ^ 2 := by
        rw [h_vec_lb, norm_neg, norm_sub_sq_real w (τ • q), real_inner_smul_right, h_norm_smul_sq, hw_inner]
        ring
      have h_ray_l := h_ray_plus ℓ hℓ_pos
      rw [h_time_lb, h_norm_lb, h_ray_l] at h_glob_lb
      have h_lb_alg :
          v (mkSpaceTime b t₀) + (B + ‖q‖ ^ 2 / 2) * ℓ -
            (B * τ + (‖w‖ ^ 2 - 2 * τ * (inner ℝ q (x - b) - δ * ‖q‖ ^ 2) + τ ^ 2 * ‖q‖ ^ 2) / (2 * τ)) =
          A - (‖w‖ ^ 2 / 2) / τ := by
        dsimp [A, ℓ]
        field_simp
        ring
      have h_lb : -((‖w‖ ^ 2 / 2) / τ) ≤ v (mkSpaceTime x t) - A := by
        linarith [h_glob_lb, h_lb_alg]
      exact abs_le.mpr ⟨h_lb, h_ub⟩
    change v (mkSpaceTime x t) = A
    by_contra h_ne
    let D : ℝ := |v (mkSpaceTime x t) - A|
    let M : ℝ := ‖w‖ ^ 2 / 2
    have hD_pos : 0 < D := abs_pos.mpr (sub_ne_zero.mpr h_ne)
    have hD_ne : D ≠ 0 := ne_of_gt hD_pos
    have hM_nonneg : 0 ≤ M := by dsimp [M]; positivity
    let τ₀ : ℝ := |δ| + (M + 1) / D + 1
    have h_div_pos : 0 < (M + 1) / D := by positivity
    have hτ₀_gt : |δ| < τ₀ := by dsimp [τ₀]; linarith
    have hτ₀_pos : 0 < τ₀ := lt_of_le_of_lt (abs_nonneg δ) hτ₀_gt
    have h_le : D ≤ M / τ₀ := h_bounds τ₀ hτ₀_gt
    have h_mul_le : D * τ₀ ≤ M := by
      have h1 := mul_le_mul_of_nonneg_right h_le (le_of_lt hτ₀_pos)
      rw [div_mul_cancel₀ M (ne_of_gt hτ₀_pos)] at h1
      exact h1
    have h_mul_eq : D * τ₀ = |δ| * D + D + M + 1 := by
      dsimp [τ₀]
      field_simp
      ring
    have h_pos_extra : 0 ≤ |δ| * D := mul_nonneg (abs_nonneg δ) (le_of_lt hD_pos)
    linarith
  let a_t : ℝ := B - ‖q‖ ^ 2 / 2
  let P : EuclideanSpace ℝ (Fin (d + 1)) := mkSpaceTime q a_t
  let c : ℝ := v (mkSpaceTime b t₀) - inner ℝ q b - a_t * t₀
  refine ⟨P, c, fun z => ?_⟩
  let x : EuclideanSpace ℝ (Fin d) := projSpace z
  let t : ℝ := projTime z
  have hz : v z = v (mkSpaceTime x t) := by
    dsimp [x, t]
    rw [h_mkSpaceTime_proj z]
  have h_xt := h_eval x t
  have h_in_sub : inner ℝ q (x - b) = inner ℝ q x - inner ℝ q b := inner_sub_right q x b
  have h_in_P : inner ℝ P z = inner ℝ q x + a_t * t := h_inner_mkSpaceTime q a_t z
  dsimp [c, a_t] at *
  linarith

theorem affine_of_constant_envelope_slopes (d : ℕ) (hd : 3 ≤ d) (C₁ : ℝ) (hC₁ : 0 ≤ C₁)
    (v : EuclideanSpace ℝ (Fin (d + 1)) → ℝ) (hv : InLimitingClassA d C₁ v)
    (b : EuclideanSpace ℝ (Fin d)) (t₀ B : ℝ)
    (h_slopes : ∀ ℓ : ℝ, 0 < ℓ →
      slopePlus d ℓ v (mkSpaceTime b t₀) = B ∧
      slopeMinus d ℓ v (mkSpaceTime b t₀) = B) :
    IsAffineSpaceTime d v :=
by
  have h_growth := subquadratic_growth_of_inLimitingClassA d C₁ hC₁ v hv
  obtain ⟨h_comp, h_attain, h_mono⟩ :=
    envelope_attainment_and_slope_monotonicity d C₁ hC₁ v hv h_growth
  have h_global :=
    global_directed_comparison_of_constant_slopes d v hv.1 h_comp h_attain h_mono b t₀ B h_slopes
  apply affine_of_global_directed_comparison_and_attainment d v b t₀ B h_global
  intro ℓ hℓ
  obtain ⟨⟨y_plus, hy_plus⟩, ⟨y_minus, hy_minus⟩⟩ := h_attain b t₀ ℓ hℓ
  obtain ⟨h_sp, h_sm⟩ := h_slopes ℓ hℓ
  refine ⟨⟨y_plus, ?_⟩, ⟨y_minus, ?_⟩⟩
  · rw [h_sp, mul_comm ℓ B] at hy_plus
    exact hy_plus
  · rw [h_sm, mul_comm ℓ B] at hy_minus
    exact hy_minus

theorem liouville_limiting_class (d : ℕ) (hd : 3 ≤ d) (C₀ : ℝ) (hC₀ : 0 ≤ C₀)
    (v : EuclideanSpace ℝ (Fin (d + 1)) → ℝ) (hv : InLimitingClassA d C₀ v) :
    IsAffineSpaceTime d v :=
by
  by_contra h_nonaff
  have hC₁ : (1 : ℝ) ≤ max C₀ 1 := le_max_right C₀ 1
  have hC₁_nonneg : (0 : ℝ) ≤ max C₀ 1 := by linarith
  obtain ⟨κ, H_star, v_star, hκ_pos, hv_star_class, hv_star_cent, hv_star_jensen,
    hv_star_gap, hv_star_slope, hW_slope⟩ :=
    extremal_barycentric_contact d hd C₀ hC₀ v hv h_nonaff
  obtain ⟨K, x_end, H_end, k, x_seq, p_seq, a_seq, hK_pos, hslope_end, hk_mono, h_contacts⟩ :=
    stopped_walk_contact_localization d hd (max C₀ 1) hC₁ κ H_star hκ_pos v_star
      hv_star_class hv_star_cent hv_star_jensen hv_star_gap ⟨hv_star_slope, hW_slope⟩
  obtain ⟨v_inf, b, B, hv_inf_class, hv_inf_slopes, hv_inf_gap⟩ :=
    constant_slope_limit_of_localized_contacts d hd (max C₀ 1) hC₁ κ hκ_pos v_star
      hv_star_class hv_star_jensen K x_end H_end k x_seq p_seq a_seq
      hK_pos hslope_end hk_mono h_contacts
  have hv_inf_aff : IsAffineSpaceTime d v_inf :=
    affine_of_constant_envelope_slopes d hd (max C₀ 1) hC₁_nonneg v_inf
      hv_inf_class b 0 B hv_inf_slopes
  let z₀ : EuclideanSpace ℝ (Fin (d + 1)) := mkSpaceTime 0 1
  obtain ⟨P, c, hP⟩ := hv_inf_aff
  have h_mem : v_inf z₀ ∈
      { val : ℝ | ∃ (N : ℕ) (θ : Fin N → ℝ) (y : Fin N → EuclideanSpace ℝ (Fin d)),
        (∀ i, 0 < θ i) ∧ (∑ i, θ i = 1) ∧ (∑ i, θ i • y i = projSpace z₀) ∧
        val = (∑ i, θ i * v_inf (mkSpaceTime (y i) (projTime z₀))) -
          (∑ i, θ i * ‖y i - projSpace z₀‖ ^ 2) / (2 * 1) } := by
    refine ⟨1, fun _ => 1, fun _ => projSpace z₀, fun _ => zero_lt_one, by simp, by simp, ?_⟩
    have hz : mkSpaceTime (projSpace z₀) (projTime z₀) = z₀ := by
      ext j
      refine Fin.lastCases ?_ ?_ j
      · simp [mkSpaceTime, projTime]
      · intro i
        simp [mkSpaceTime, projSpace]
    simp [hz]
  have h_ub : ∀ val ∈
      { val : ℝ | ∃ (N : ℕ) (θ : Fin N → ℝ) (y : Fin N → EuclideanSpace ℝ (Fin d)),
        (∀ i, 0 < θ i) ∧ (∑ i, θ i = 1) ∧ (∑ i, θ i • y i = projSpace z₀) ∧
        val = (∑ i, θ i * v_inf (mkSpaceTime (y i) (projTime z₀))) -
          (∑ i, θ i * ‖y i - projSpace z₀‖ ^ 2) / (2 * 1) }, val ≤ v_inf z₀ := by
    rintro val ⟨N, θ, y, hθ_pos, hθ_sum, hy_mean, rfl⟩
    have hz_sum : ∑ i, θ i • mkSpaceTime (y i) (projTime z₀) = z₀ := by
      apply (EuclideanSpace.equiv (Fin (d + 1)) ℝ).injective
      ext j
      rw [map_sum, Finset.sum_apply]
      refine Fin.lastCases ?_ ?_ j
      · simp only [map_smul, Pi.smul_apply, smul_eq_mul, mkSpaceTime,
          ContinuousLinearEquiv.apply_symm_apply, Fin.snoc_last]
        rw [← Finset.sum_mul, hθ_sum, one_mul]
        rfl
      · intro m
        simp only [map_smul, Pi.smul_apply, smul_eq_mul, mkSpaceTime,
          ContinuousLinearEquiv.apply_symm_apply, Fin.snoc_castSucc]
        have h_m := congr_fun (congr_arg (EuclideanSpace.equiv (Fin d) ℝ) hy_mean) m
        rw [map_sum, Finset.sum_apply] at h_m
        simpa [projSpace] using h_m
    have hv_sum : (∑ i, θ i * v_inf (mkSpaceTime (y i) (projTime z₀))) = v_inf z₀ := by
      simp_rw [hP]
      calc ∑ i, θ i * (inner ℝ P (mkSpaceTime (y i) (projTime z₀)) + c)
        _ = (∑ i, inner ℝ P (θ i • mkSpaceTime (y i) (projTime z₀))) + (∑ i, θ i) * c := by
            rw [Finset.sum_mul, ← Finset.sum_add_distrib]
            congr 1 with i
            rw [real_inner_smul_right]
            ring
        _ = inner ℝ P (∑ i, θ i • mkSpaceTime (y i) (projTime z₀)) + 1 * c := by
            rw [← inner_sum, hθ_sum]
        _ = inner ℝ P z₀ + c := by rw [hz_sum, one_mul]
    rw [hv_sum]
    have h_pen : 0 ≤ (∑ i, θ i * ‖y i - projSpace z₀‖ ^ 2) / (2 * 1) := by
      apply div_nonneg
      · apply Finset.sum_nonneg
        intro i _
        exact mul_nonneg (le_of_lt (hθ_pos i)) (sq_nonneg _)
      · norm_num
    linarith
  have h_eq : barycentricEnvelope d 1 v_inf z₀ = v_inf z₀ :=
    le_antisymm (csSup_le ⟨v_inf z₀, h_mem⟩ h_ub) (le_csSup ⟨v_inf z₀, h_ub⟩ h_mem)
  have hκ_sq : 0 < κ ^ 2 := sq_pos_of_pos hκ_pos
  linarith

theorem horizontal_ball_fits_of_power_decay (d : ℕ) (B γ s₀ : ℝ)
    (h_decay : HasUniformCylinderPowerDecay d B γ s₀) :
    ∃ (A₀ r₀ : ℝ),
      0 < A₀ ∧ 0 < r₀ ∧ r₀ ≤ 1 ∧
      A₀ * r₀ ^ γ ≤ 1 / 2 ∧
      Real.sqrt A₀ * r₀ ^ (1 + γ / 2) ≤ 1 / 4 ∧
      ∀ u : EuclideanSpace ℝ (Fin d) → ℝ,
        IsNormalizedInfinityHarmonic d u →
        (∀ x ∈ Metric.ball (0 : EuclideanSpace ℝ (Fin d)) 1, |u x| ≤ 1) ∧
        (∀ y ∈ Metric.ball (0 : EuclideanSpace ℝ (Fin d)) (1 / 2),
          ∀ r : ℝ, 0 < r → r ≤ r₀ →
            ∃ p : EuclideanSpace ℝ (Fin d),
              ∀ h : EuclideanSpace ℝ (Fin d),
                ‖h‖ ≤ Real.sqrt A₀ * r ^ (1 + γ / 2) →
                |u (y + h) - u y - inner ℝ p h| ≤ A₀ * r ^ (1 + γ)) :=
by
  have h_projSpace_mk : ∀ x : EuclideanSpace ℝ (Fin d), projSpace (mkSpaceTime x 0) = x := by
    intro x
    ext i
    simp [projSpace, mkSpaceTime]
  have h_projTime_mk : ∀ x : EuclideanSpace ℝ (Fin d), projTime (mkSpaceTime x 0) = 0 := by
    intro x
    simp [projTime, mkSpaceTime]
  have h_lift_mk : ∀ (u : EuclideanSpace ℝ (Fin d) → ℝ) (x : EuclideanSpace ℝ (Fin d)),
      liftFunc u (mkSpaceTime x 0) = u x := by
    intro u x
    simp [liftFunc, h_projSpace_mk, h_projTime_mk]
  have h_mk_add : ∀ x h : EuclideanSpace ℝ (Fin d),
      mkSpaceTime x 0 + mkSpaceTime h 0 = mkSpaceTime (x + h) 0 := by
    intro x h
    ext i
    refine Fin.lastCases ?_ (fun j => ?_) i <;> simp [mkSpaceTime]
  have h_norm_mk : ∀ x : EuclideanSpace ℝ (Fin d), ‖mkSpaceTime x 0‖ = ‖x‖ := by
    intro x
    rw [PiLp.norm_eq_of_L2, PiLp.norm_eq_of_L2, Fin.sum_univ_castSucc]
    congr 1
    have h_last : ‖(mkSpaceTime x 0) (Fin.last d)‖ ^ 2 = 0 := by
      simp [mkSpaceTime]
    have h_cast : ∑ i : Fin d, ‖(mkSpaceTime x 0) (Fin.castSucc i)‖ ^ 2 = ∑ i : Fin d, ‖x i‖ ^ 2 := by
      refine Finset.sum_congr rfl (fun i _ => ?_)
      simp [mkSpaceTime]
    linarith
  have h_inner_mk : ∀ (P : EuclideanSpace ℝ (Fin (d + 1))) (h : EuclideanSpace ℝ (Fin d)),
      inner ℝ P (mkSpaceTime h 0) = inner ℝ (projSpace P) h := by
    intro P h
    rw [PiLp.inner_apply, PiLp.inner_apply, Fin.sum_univ_castSucc]
    have h_last : inner ℝ (P (Fin.last d)) ((mkSpaceTime h 0) (Fin.last d)) = 0 := by
      simp [mkSpaceTime]
    have h_cast : ∑ i : Fin d, inner ℝ (P (Fin.castSucc i)) ((mkSpaceTime h 0) (Fin.castSucc i)) =
        ∑ i : Fin d, inner ℝ ((projSpace P) i) (h i) := by
      refine Finset.sum_congr rfl (fun i _ => ?_)
      simp [mkSpaceTime, projSpace]
    linarith
  obtain ⟨hB_pos, hγ_pos, hγ_le, hs₀_pos, hs₀_le, h_cyl_all⟩ := h_decay
  let A₀ : ℝ := 2 * B * (4 : ℝ) ^ γ
  have hA₀_pos : 0 < A₀ := by positivity
  let r₀ : ℝ := min (s₀ / 4) (((2 * A₀)⁻¹) ^ (γ⁻¹))
  have hr₀_pos : 0 < r₀ := by
    refine lt_min (by positivity) ?_
    positivity
  have hr₀_le_s₀ : r₀ ≤ s₀ / 4 := min_le_left _ _
  have hr₀_le_quarter : r₀ ≤ 1 / 4 := by linarith
  have hr₀_le_one : r₀ ≤ 1 := by linarith
  have hAr₀_le : A₀ * r₀ ^ γ ≤ 1 / 2 := by
    have hr₀_le_inv : r₀ ≤ ((2 * A₀)⁻¹) ^ (γ⁻¹) := min_le_right _ _
    have hrpow : r₀ ^ γ ≤ (((2 * A₀)⁻¹) ^ (γ⁻¹)) ^ γ :=
      Real.rpow_le_rpow (le_of_lt hr₀_pos) hr₀_le_inv (le_of_lt hγ_pos)
    have h_inv_rpow : (((2 * A₀)⁻¹) ^ (γ⁻¹)) ^ γ = (2 * A₀)⁻¹ :=
      Real.rpow_inv_rpow (by positivity) (ne_of_gt hγ_pos)
    rw [h_inv_rpow] at hrpow
    calc A₀ * r₀ ^ γ ≤ A₀ * (2 * A₀)⁻¹ :=
          mul_le_mul_of_nonneg_left hrpow (le_of_lt hA₀_pos)
      _ = 1 / 2 := by
          have hA₀_ne : A₀ ≠ 0 := ne_of_gt hA₀_pos
          field_simp [hA₀_ne]
  have h_rho_eq : ∀ r : ℝ, 0 < r →
      Real.sqrt A₀ * r ^ (1 + γ / 2) = Real.sqrt (A₀ * r ^ γ) * r := by
    intro r hr_pos
    have h1 : r ^ (1 + γ / 2) = r * Real.sqrt (r ^ γ) := by
      rw [Real.rpow_add hr_pos 1 (γ / 2), Real.rpow_one]
      have h_half : γ / 2 = γ * (1 / 2) := by ring
      rw [h_half, Real.rpow_mul (le_of_lt hr_pos) γ (1 / 2), ← Real.sqrt_eq_rpow (r ^ γ)]
    rw [h1, ← mul_assoc, mul_comm (Real.sqrt A₀) r, mul_assoc,
      ← Real.sqrt_mul (le_of_lt hA₀_pos) (r ^ γ), mul_comm r]
  have hρ₀_le : Real.sqrt A₀ * r₀ ^ (1 + γ / 2) ≤ 1 / 4 := by
    rw [h_rho_eq r₀ hr₀_pos]
    have h_sqrt_le : Real.sqrt (A₀ * r₀ ^ γ) ≤ 1 := by
      calc Real.sqrt (A₀ * r₀ ^ γ) ≤ Real.sqrt 1 :=
            Real.sqrt_le_sqrt (by linarith)
        _ = 1 := Real.sqrt_one
    calc Real.sqrt (A₀ * r₀ ^ γ) * r₀ ≤ 1 * (1 / 4) :=
          mul_le_mul h_sqrt_le hr₀_le_quarter (le_of_lt hr₀_pos) zero_le_one
      _ = 1 / 4 := by ring
  refine ⟨A₀, r₀, hA₀_pos, hr₀_pos, hr₀_le_one, hAr₀_le, hρ₀_le, ?_⟩
  intro u hu
  refine ⟨?_, ?_⟩
  · obtain ⟨hbdd, _, hu0, hosc⟩ := hu
    intro x hx
    have h0_mem : (0 : EuclideanSpace ℝ (Fin d)) ∈ Metric.ball (0 : EuclideanSpace ℝ (Fin d)) 1 :=
      Metric.mem_ball_self zero_lt_one
    have hu0_mem : u 0 ∈ u '' Metric.ball 0 1 := Set.mem_image_of_mem u h0_mem
    have hux_mem : u x ∈ u '' Metric.ball 0 1 := Set.mem_image_of_mem u hx
    have h_ux_le : u x ≤ sSup (u '' Metric.ball 0 1) := le_csSup hbdd.bddAbove hux_mem
    have h_le_ux : sInf (u '' Metric.ball 0 1) ≤ u x := csInf_le hbdd.bddBelow hux_mem
    have h_u0_le : u 0 ≤ sSup (u '' Metric.ball 0 1) := le_csSup hbdd.bddAbove hu0_mem
    have h_le_u0 : sInf (u '' Metric.ball 0 1) ≤ u 0 := csInf_le hbdd.bddBelow hu0_mem
    change sSup (u '' Metric.ball 0 1) - sInf (u '' Metric.ball 0 1) ≤ 1 at hosc
    rw [abs_le]
    constructor <;> linarith
  · intro y hy r hr_pos hr_le
    let z : EuclideanSpace ℝ (Fin (d + 1)) := mkSpaceTime y 0
    let lam : ℝ := A₀ * r ^ γ
    have hlam_pos : 0 < lam := by positivity
    have hy_norm : ‖y‖ < 1 / 2 := by
      simpa [Metric.mem_ball, dist_zero_right] using hy
    have hz_norm : ‖z‖ = ‖y‖ := h_norm_mk y
    have hz_mem : z ∈ Metric.ball (0 : EuclideanSpace ℝ (Fin (d + 1))) (3 / 4) := by
      rw [Metric.mem_ball, dist_zero_right, hz_norm]
      linarith
    have h_dist_bd : 1 / 4 < 3 / 4 - ‖z‖ := by linarith
    have hr_adm : r ≤ s₀ * (3 / 4 - ‖z‖) := by
      have : r ≤ s₀ / 4 := le_trans hr_le hr₀_le_s₀
      nlinarith
    have hlam_gt : B * (r / (3 / 4 - ‖z‖)) ^ γ < lam := by
      have h_div_le : r / (3 / 4 - ‖z‖) ≤ 4 * r := by
        rw [div_le_iff₀ (by linarith)]
        nlinarith
      have h_rpow_le : (r / (3 / 4 - ‖z‖)) ^ γ ≤ (4 : ℝ) ^ γ * r ^ γ := by
        calc (r / (3 / 4 - ‖z‖)) ^ γ ≤ (4 * r) ^ γ :=
              Real.rpow_le_rpow (by positivity) h_div_le (le_of_lt hγ_pos)
          _ = (4 : ℝ) ^ γ * r ^ γ :=
              Real.mul_rpow (by norm_num) (le_of_lt hr_pos)
      have h_B_le : B * (r / (3 / 4 - ‖z‖)) ^ γ ≤ (1 / 2) * lam := by
        calc B * (r / (3 / 4 - ‖z‖)) ^ γ ≤ B * ((4 : ℝ) ^ γ * r ^ γ) :=
              mul_le_mul_of_nonneg_left h_rpow_le (le_of_lt hB_pos)
          _ = (1 / 2) * lam := by
              dsimp [lam, A₀]
              ring
      linarith
    have hlam_le_half : lam ≤ 1 / 2 := by
      have hrpow_le : r ^ γ ≤ r₀ ^ γ :=
        Real.rpow_le_rpow (le_of_lt hr_pos) hr_le (le_of_lt hγ_pos)
      calc lam = A₀ * r ^ γ := rfl
        _ ≤ A₀ * r₀ ^ γ := mul_le_mul_of_nonneg_left hrpow_le (le_of_lt hA₀_pos)
        _ ≤ 1 / 2 := hAr₀_le
    have hlam_lt : lam < 1 := by linarith
    obtain ⟨P, hP_ne, hP_fit⟩ := h_cyl_all u hu z hz_mem r hr_pos hr_adm lam hlam_gt hlam_lt
    refine ⟨projSpace P, ?_⟩
    intro h hh
    let h_hat : EuclideanSpace ℝ (Fin (d + 1)) := mkSpaceTime h 0
    let N_P : EuclideanSpace ℝ (Fin (d + 1)) := (‖P‖⁻¹) • P
    have h_norm_P_ne : ‖P‖ ≠ 0 := norm_ne_zero_iff.mpr hP_ne
    have h_norm_NP : ‖N_P‖ = 1 := by
      dsimp [N_P]
      rw [norm_smul, Real.norm_of_nonneg (inv_nonneg.mpr (norm_nonneg P)),
        inv_mul_cancel₀ h_norm_P_ne]
    have hh_hat_norm : ‖h_hat‖ ≤ Real.sqrt lam * r := by
      dsimp [h_hat, lam]
      rw [h_norm_mk h, ← h_rho_eq r hr_pos]
      exact hh
    have h_sqrt_lam_le_one : Real.sqrt lam ≤ 1 := by
      calc Real.sqrt lam ≤ Real.sqrt 1 := Real.sqrt_le_sqrt (le_of_lt hlam_lt)
        _ = 1 := Real.sqrt_one
    have h_axial : |inner ℝ h_hat N_P| ≤ r := by
      calc |inner ℝ h_hat N_P| ≤ ‖h_hat‖ * ‖N_P‖ := abs_real_inner_le_norm h_hat N_P
        _ = ‖h_hat‖ := by rw [h_norm_NP, mul_one]
        _ ≤ Real.sqrt lam * r := hh_hat_norm
        _ ≤ 1 * r := mul_le_mul_of_nonneg_right h_sqrt_lam_le_one (le_of_lt hr_pos)
        _ = r := one_mul r
    have h_trans : ‖h_hat - (inner ℝ h_hat N_P) • N_P‖ ≤ Real.sqrt lam * r := by
      let c : ℝ := inner ℝ h_hat N_P
      have h_sq : ‖h_hat - c • N_P‖ ^ 2 ≤ ‖h_hat‖ ^ 2 := by
        have h_expand : ‖h_hat - c • N_P‖ ^ 2 = ‖h_hat‖ ^ 2 - c ^ 2 := by
          rw [norm_sub_sq_real, inner_smul_right, norm_smul, Real.norm_eq_abs,
            mul_pow, sq_abs, h_norm_NP]
          change ‖h_hat‖ ^ 2 - 2 * (c * c) + c ^ 2 * 1 ^ 2 = ‖h_hat‖ ^ 2 - c ^ 2
          ring
        have hc_sq : 0 ≤ c ^ 2 := sq_nonneg c
        linarith
      have h_norm_le : ‖h_hat - c • N_P‖ ≤ ‖h_hat‖ := by
        have h_sqrt := Real.sqrt_le_sqrt h_sq
        rwa [Real.sqrt_sq (norm_nonneg _), Real.sqrt_sq (norm_nonneg _)] at h_sqrt
      exact le_trans h_norm_le hh_hat_norm
    have h_fit_inst := hP_fit h_hat h_axial h_trans
    have hz_add : z + h_hat = mkSpaceTime (y + h) 0 := h_mk_add y h
    have hU_zh : liftFunc u (z + h_hat) = u (y + h) := by
      rw [hz_add, h_lift_mk u (y + h)]
    have hU_z : liftFunc u z = u y := h_lift_mk u y
    have h_inner_Ph : inner ℝ P h_hat = inner ℝ (projSpace P) h := h_inner_mk P h
    have h_lam_r : lam * r = A₀ * r ^ (1 + γ) := by
      dsimp [lam]
      rw [Real.rpow_add hr_pos 1 γ, Real.rpow_one]
      ring
    rw [hU_zh, hU_z, h_inner_Ph, h_lam_r] at h_fit_inst
    exact h_fit_inst

theorem taylor_holder_of_horizontal_ball_fits (d : ℕ) (γ A₀ r₀ : ℝ)
    (hγ_pos : 0 < γ) (hγ_le : γ ≤ 1) (hA₀_pos : 0 < A₀) (hr₀_pos : 0 < r₀) (hr₀_le : r₀ ≤ 1)
    (hAr_le : A₀ * r₀ ^ γ ≤ 1 / 2) (hρ₀_le : Real.sqrt A₀ * r₀ ^ (1 + γ / 2) ≤ 1 / 4) :
    ∃ (L₀ C₃ : ℝ),
      0 ≤ L₀ ∧ 0 ≤ C₃ ∧
      ∀ u : EuclideanSpace ℝ (Fin d) → ℝ,
        (∀ x ∈ Metric.ball (0 : EuclideanSpace ℝ (Fin d)) 1, |u x| ≤ 1) →
        (∀ y ∈ Metric.ball (0 : EuclideanSpace ℝ (Fin d)) (1 / 2),
          ∀ r : ℝ, 0 < r → r ≤ r₀ →
            ∃ p : EuclideanSpace ℝ (Fin d),
              ∀ h : EuclideanSpace ℝ (Fin d),
                ‖h‖ ≤ Real.sqrt A₀ * r ^ (1 + γ / 2) →
                |u (y + h) - u y - inner ℝ p h| ≤ A₀ * r ^ (1 + γ)) →
        ∃ g : EuclideanSpace ℝ (Fin d) → EuclideanSpace ℝ (Fin d),
          (∀ y ∈ Metric.ball (0 : EuclideanSpace ℝ (Fin d)) (1 / 2), ‖g y‖ ≤ L₀) ∧
          (∀ y ∈ Metric.ball (0 : EuclideanSpace ℝ (Fin d)) (1 / 2),
            ∀ h : EuclideanSpace ℝ (Fin d),
              ‖h‖ ≤ Real.sqrt A₀ * r₀ ^ (1 + γ / 2) →
              |u (y + h) - u y - inner ℝ (g y) h| ≤ C₃ * ‖h‖ ^ (1 + γ / (2 + γ))) :=
by
  have h_s1 : ∀ (u : EuclideanSpace ℝ (Fin d) → ℝ),
      (∀ x ∈ Metric.ball (0 : EuclideanSpace ℝ (Fin d)) 1, |u x| ≤ 1) →
      ∀ (y : EuclideanSpace ℝ (Fin d)),
        y ∈ Metric.ball (0 : EuclideanSpace ℝ (Fin d)) (1 / 2) →
        ∀ (p : ℕ → EuclideanSpace ℝ (Fin d)),
          (∀ j : ℕ, ∀ h : EuclideanSpace ℝ (Fin d),
            ‖h‖ ≤ Real.sqrt A₀ * (r₀ * (1 / 2 : ℝ) ^ j) ^ (1 + γ / 2) →
            |u (y + h) - u y - inner ℝ (p j) h| ≤ A₀ * (r₀ * (1 / 2 : ℝ) ^ j) ^ (1 + γ)) →
          ‖p 0‖ ≤ (2 + A₀ * r₀ ^ (1 + γ)) / (Real.sqrt A₀ * r₀ ^ (1 + γ / 2)) ∧
          ∀ j : ℕ, ‖p j - p (j + 1)‖ ≤
            2 ^ (2 + γ / 2) * Real.sqrt A₀ * r₀ ^ (γ / 2) * ((2 : ℝ) ^ (-γ / 2)) ^ j := by
    intro u hu_bdd y hy p hp
    have h_dual : ∀ (v : EuclideanSpace ℝ (Fin d)) (ρ M : ℝ),
        0 < ρ → 0 ≤ M → (∀ h : EuclideanSpace ℝ (Fin d), ‖h‖ ≤ ρ → inner ℝ v h ≤ M) →
        ‖v‖ ≤ M / ρ := by
      intro v ρ M hρ hM h_in
      by_cases hv : v = 0
      · subst hv
        rw [norm_zero]
        positivity
      · have hv_pos : 0 < ‖v‖ := norm_pos_iff.mpr hv
        let h : EuclideanSpace ℝ (Fin d) := (ρ / ‖v‖) • v
        have hh_norm : ‖h‖ ≤ ρ := by
          dsimp [h]
          rw [norm_smul, Real.norm_of_nonneg (by positivity), div_mul_cancel₀ ρ (ne_of_gt hv_pos)]
        have h_inner : inner ℝ v h = ρ * ‖v‖ := by
          dsimp [h]
          rw [real_inner_smul_right, real_inner_self_eq_norm_mul_norm]
          field_simp [ne_of_gt hv_pos]
        have h_le := h_in h hh_norm
        rw [h_inner] at h_le
        rwa [le_div_iff₀ hρ, mul_comm]
    refine ⟨?_, ?_⟩
    · let ρ₀ : ℝ := Real.sqrt A₀ * r₀ ^ (1 + γ / 2)
      have hρ₀_pos : 0 < ρ₀ := by positivity
      have hM_nonneg : 0 ≤ 2 + A₀ * r₀ ^ (1 + γ) := by positivity
      apply h_dual (p 0) ρ₀ (2 + A₀ * r₀ ^ (1 + γ)) hρ₀_pos hM_nonneg
      intro h hh
      have hy_norm : ‖y‖ < 1 / 2 := by simpa [Metric.mem_ball, dist_zero_right] using hy
      have hy_in : y ∈ Metric.ball (0 : EuclideanSpace ℝ (Fin d)) 1 := by
        rw [Metric.mem_ball, dist_zero_right]
        linarith
      have hyh_in : y + h ∈ Metric.ball (0 : EuclideanSpace ℝ (Fin d)) 1 := by
        rw [Metric.mem_ball, dist_zero_right]
        have h_tri : ‖y + h‖ ≤ ‖y‖ + ‖h‖ := norm_add_le y h
        linarith
      have huy : |u y| ≤ 1 := hu_bdd y hy_in
      have huyh : |u (y + h)| ≤ 1 := hu_bdd (y + h) hyh_in
      have hp0 := hp 0 h (by simpa [ρ₀] using hh)
      simp only [pow_zero, mul_one] at hp0
      linarith [abs_le.mp huy, abs_le.mp huyh, abs_le.mp hp0]
    · intro j
      let rj : ℝ := r₀ * (1 / 2 : ℝ) ^ j
      let rj1 : ℝ := r₀ * (1 / 2 : ℝ) ^ (j + 1)
      have hrj_pos : 0 < rj := by positivity
      have hrj1_pos : 0 < rj1 := by positivity
      have hrj1_eq : rj1 = rj / 2 := by
        dsimp [rj, rj1]
        ring
      have hrj1_le : rj1 ≤ rj := by linarith
      let ρj : ℝ := Real.sqrt A₀ * rj ^ (1 + γ / 2)
      let ρj1 : ℝ := Real.sqrt A₀ * rj1 ^ (1 + γ / 2)
      have hρj1_pos : 0 < ρj1 := by positivity
      have hρ_le : ρj1 ≤ ρj := by
        dsimp [ρj1, ρj]
        gcongr
      have hr_pow_le : rj1 ^ (1 + γ) ≤ rj ^ (1 + γ) := by
        gcongr
      have h_step_div : ‖p j - p (j + 1)‖ ≤ (2 * A₀ * rj ^ (1 + γ)) / ρj1 := by
        apply h_dual (p j - p (j + 1)) ρj1 (2 * A₀ * rj ^ (1 + γ)) hρj1_pos (by positivity)
        intro h hh
        have hpj := hp j h (le_trans hh hρ_le)
        have hpj1 := hp (j + 1) h hh
        have h_in_sub : inner ℝ (p j - p (j + 1)) h = inner ℝ (p j) h - inner ℝ (p (j + 1)) h :=
          inner_sub_left (p j) (p (j + 1)) h
        have hA_le : A₀ * rj1 ^ (1 + γ) ≤ A₀ * rj ^ (1 + γ) :=
          mul_le_mul_of_nonneg_left hr_pow_le (le_of_lt hA₀_pos)
        linarith [abs_le.mp hpj, abs_le.mp hpj1]
      have h_alg : (2 * A₀ * rj ^ (1 + γ)) / ρj1 =
          2 ^ (2 + γ / 2) * Real.sqrt A₀ * r₀ ^ (γ / 2) * ((2 : ℝ) ^ (-γ / 2)) ^ j := by
        dsimp [ρj1]
        rw [hrj1_eq, Real.div_rpow (le_of_lt hrj_pos) (by norm_num)]
        have h_exp : 1 + γ = (1 + γ / 2) + γ / 2 := by ring
        rw [h_exp, Real.rpow_add hrj_pos]
        have hA_sqrt : A₀ = Real.sqrt A₀ * Real.sqrt A₀ := (Real.mul_self_sqrt (le_of_lt hA₀_pos)).symm
        have h2_pow : (2 : ℝ) ^ (2 + γ / 2) = 2 * (2 : ℝ) ^ (1 + γ / 2) := by
          have h2_exp : (2 + γ / 2 : ℝ) = 1 + (1 + γ / 2) := by ring
          rw [h2_exp, Real.rpow_add (by norm_num : (0 : ℝ) < 2), Real.rpow_one]
        have hrj_pow : rj ^ (γ / 2) = r₀ ^ (γ / 2) * ((2 : ℝ) ^ (-γ / 2)) ^ j := by
          dsimp [rj]
          rw [Real.mul_rpow (le_of_lt hr₀_pos) (by positivity)]
          congr 1
          rw [← Real.rpow_natCast ((2 : ℝ) ^ (-γ / 2)) j, ← Real.rpow_mul (by positivity)]
          rw [← Real.rpow_natCast (1 / 2 : ℝ) j, one_div, Real.inv_rpow (by positivity), ← Real.rpow_neg (by positivity)]
          rw [← Real.rpow_mul (by positivity)]
          ring_nf
        have hsqrt_ne : Real.sqrt A₀ ≠ 0 := ne_of_gt (Real.sqrt_pos.mpr hA₀_pos)
        have hrj_ne : rj ^ (1 + γ / 2) ≠ 0 := ne_of_gt (by positivity)
        have h2_ne : (2 : ℝ) ^ (1 + γ / 2) ≠ 0 := ne_of_gt (by positivity)
        calc 2 * A₀ * (rj ^ (1 + γ / 2) * rj ^ (γ / 2)) / (Real.sqrt A₀ * (rj ^ (1 + γ / 2) / 2 ^ (1 + γ / 2)))
            = 2 * (Real.sqrt A₀ * Real.sqrt A₀) * (rj ^ (1 + γ / 2) * rj ^ (γ / 2)) /
                (Real.sqrt A₀ * (rj ^ (1 + γ / 2) / 2 ^ (1 + γ / 2))) := by
              rw [← hA_sqrt]
          _ = 2 * (2 : ℝ) ^ (1 + γ / 2) * Real.sqrt A₀ * rj ^ (γ / 2) := by
              field_simp [hsqrt_ne, hrj_ne, h2_ne]
          _ = 2 ^ (2 + γ / 2) * Real.sqrt A₀ * r₀ ^ (γ / 2) * ((2 : ℝ) ^ (-γ / 2)) ^ j := by
              rw [h2_pow, hrj_pow]
              ring
      linarith
  have h_s2 : ∀ (p : ℕ → EuclideanSpace ℝ (Fin d)),
      ‖p 0‖ ≤ (2 + A₀ * r₀ ^ (1 + γ)) / (Real.sqrt A₀ * r₀ ^ (1 + γ / 2)) →
      (∀ j : ℕ, ‖p j - p (j + 1)‖ ≤
        2 ^ (2 + γ / 2) * Real.sqrt A₀ * r₀ ^ (γ / 2) * ((2 : ℝ) ^ (-γ / 2)) ^ j) →
      ∃ gy : EuclideanSpace ℝ (Fin d),
        ‖gy‖ ≤ (2 + A₀ * r₀ ^ (1 + γ)) / (Real.sqrt A₀ * r₀ ^ (1 + γ / 2)) +
          (2 ^ (2 + γ / 2) * Real.sqrt A₀ / (1 - (2 : ℝ) ^ (-γ / 2))) * r₀ ^ (γ / 2) ∧
        ∀ j : ℕ, ‖p j - gy‖ ≤
          (2 ^ (2 + γ / 2) * Real.sqrt A₀ / (1 - (2 : ℝ) ^ (-γ / 2))) *
            (r₀ * (1 / 2 : ℝ) ^ j) ^ (γ / 2) := by
    intro p hp0 hstep
    let q : ℝ := (2 : ℝ) ^ (-γ / 2)
    let C₁ : ℝ := 2 ^ (2 + γ / 2) * Real.sqrt A₀ * r₀ ^ (γ / 2)
    have hq_lt_one : q < 1 := by
      dsimp [q]
      exact Real.rpow_lt_one_of_one_lt_of_neg one_lt_two (by linarith)
    have h1q_pos : 0 < 1 - q := sub_pos.mpr hq_lt_one
    have hdist : ∀ j : ℕ, dist (p j) (p (j + 1)) ≤ C₁ * q ^ j := by
      intro j
      rw [dist_eq_norm]
      exact hstep j
    have hcauchy : CauchySeq p := cauchySeq_of_le_geometric q C₁ hq_lt_one hdist
    obtain ⟨gy, hgy⟩ := cauchySeq_tendsto_of_complete hcauchy
    refine ⟨gy, ?_, ?_⟩
    · have h0 := dist_le_of_le_geometric_of_tendsto₀ q C₁ hq_lt_one hdist hgy
      rw [dist_eq_norm] at h0
      have h_tri : ‖gy‖ ≤ ‖p 0‖ + ‖p 0 - gy‖ := by
        calc ‖gy‖ = ‖p 0 - (p 0 - gy)‖ := by abel_nf
          _ ≤ ‖p 0‖ + ‖p 0 - gy‖ := norm_sub_le _ _
      have hC1_eq : C₁ / (1 - q) = (2 ^ (2 + γ / 2) * Real.sqrt A₀ / (1 - (2 : ℝ) ^ (-γ / 2))) * r₀ ^ (γ / 2) := by
        dsimp [C₁, q]
        ring
      linarith
    · intro j
      have hj := dist_le_of_le_geometric_of_tendsto q C₁ hq_lt_one hdist hgy j
      rw [dist_eq_norm] at hj
      have hpow : r₀ ^ (γ / 2) * q ^ j = (r₀ * (1 / 2 : ℝ) ^ j) ^ (γ / 2) := by
        rw [Real.mul_rpow (le_of_lt hr₀_pos) (by positivity)]
        congr 1
        dsimp [q]
        rw [← Real.rpow_natCast ((2 : ℝ) ^ (-γ / 2)) j, ← Real.rpow_mul (by positivity)]
        rw [← Real.rpow_natCast (1 / 2 : ℝ) j, one_div, Real.inv_rpow (by positivity), ← Real.rpow_neg (by positivity)]
        rw [← Real.rpow_mul (by positivity)]
        ring_nf
      calc ‖p j - gy‖ ≤ C₁ * q ^ j / (1 - q) := hj
        _ = (2 ^ (2 + γ / 2) * Real.sqrt A₀ / (1 - q)) * (r₀ ^ (γ / 2) * q ^ j) := by
            dsimp [C₁]
            ring
        _ = (2 ^ (2 + γ / 2) * Real.sqrt A₀ / (1 - (2 : ℝ) ^ (-γ / 2))) * (r₀ * (1 / 2 : ℝ) ^ j) ^ (γ / 2) := by
            rw [hpow]
  have h_s3 : ∀ (C₂ : ℝ), 0 ≤ C₂ →
      ∀ (u : EuclideanSpace ℝ (Fin d) → ℝ) (y : EuclideanSpace ℝ (Fin d))
        (p : ℕ → EuclideanSpace ℝ (Fin d)) (gy : EuclideanSpace ℝ (Fin d)),
        (∀ j : ℕ, ∀ h : EuclideanSpace ℝ (Fin d),
          ‖h‖ ≤ Real.sqrt A₀ * (r₀ * (1 / 2 : ℝ) ^ j) ^ (1 + γ / 2) →
          |u (y + h) - u y - inner ℝ (p j) h| ≤ A₀ * (r₀ * (1 / 2 : ℝ) ^ j) ^ (1 + γ)) →
        (∀ j : ℕ, ‖p j - gy‖ ≤ C₂ * (r₀ * (1 / 2 : ℝ) ^ j) ^ (γ / 2)) →
        ∀ h : EuclideanSpace ℝ (Fin d),
          ‖h‖ ≤ Real.sqrt A₀ * r₀ ^ (1 + γ / 2) →
          |u (y + h) - u y - inner ℝ gy h| ≤
            (2 ^ (1 + γ / 2) * Real.sqrt A₀ + C₂) * (2 : ℝ) ^ (γ / 2) *
              A₀ ^ (-(γ / (2 + γ)) / 2) * ‖h‖ ^ (1 + γ / (2 + γ)) := by
    intro C₂ hC₂_nonneg u y p gy hp htail h hh
    let α_d : ℝ := γ / (2 + γ)
    have hα_pos : 0 < α_d := by positivity
    by_cases hh_zero : h = 0
    · subst hh_zero
      simp only [add_zero, sub_self, inner_zero_right, abs_zero, norm_zero]
      rw [Real.zero_rpow (by positivity), mul_zero]
    · have hh_pos : 0 < ‖h‖ := norm_pos_iff.mpr hh_zero
      let ρ : ℕ → ℝ := fun k => Real.sqrt A₀ * (r₀ * (1 / 2 : ℝ) ^ k) ^ (1 + γ / 2)
      let ρ₀ : ℝ := Real.sqrt A₀ * r₀ ^ (1 + γ / 2)
      let q₀ : ℝ := (1 / 2 : ℝ) ^ (1 + γ / 2)
      have hρ₀_pos : 0 < ρ₀ := by positivity
      have hq₀_lt_one : q₀ < 1 := Real.rpow_lt_one (by norm_num) (by norm_num) (by positivity)
      have hρ_eq : ∀ k : ℕ, ρ k = ρ₀ * q₀ ^ k := by
        intro k
        dsimp [ρ, ρ₀, q₀]
        rw [Real.mul_rpow (le_of_lt hr₀_pos) (by positivity), ← mul_assoc]
        congr 1
        rw [← Real.rpow_natCast ((1 / 2 : ℝ) ^ (1 + γ / 2)) k, ← Real.rpow_mul (by positivity)]
        rw [← Real.rpow_natCast (1 / 2 : ℝ) k, ← Real.rpow_mul (by positivity)]
        ring_nf
      have hex : ∃ k : ℕ, ρ k < ‖h‖ := by
        obtain ⟨k, hk⟩ := exists_pow_lt_of_lt_one (div_pos hh_pos hρ₀_pos) hq₀_lt_one
        refine ⟨k, ?_⟩
        rw [hρ_eq k, mul_comm, ← lt_div_iff₀ hρ₀_pos]
        exact hk
      classical
      let k : ℕ := Nat.find hex
      have hk_spec : ρ k < ‖h‖ := Nat.find_spec hex
      have hk_ne : k ≠ 0 := by
        intro hk0
        have h0 : ρ 0 < ‖h‖ := hk0 ▸ hk_spec
        have hρ0_eq : ρ 0 = ρ₀ := by simp [ρ, ρ₀]
        linarith
      let j : ℕ := k - 1
      have hjk : j + 1 = k := Nat.succ_pred_eq_of_ne_zero hk_ne
      have hj_lt : j < k := by omega
      have hj_ge : ‖h‖ ≤ ρ j := not_lt.mp (Nat.find_min hex hj_lt)
      have hj1_lt : ρ (j + 1) < ‖h‖ := hjk.symm ▸ hk_spec
      let rj : ℝ := r₀ * (1 / 2 : ℝ) ^ j
      let rj1 : ℝ := r₀ * (1 / 2 : ℝ) ^ (j + 1)
      have hrj_pos : 0 < rj := by positivity
      have hrj1_eq : rj1 = rj / 2 := by dsimp [rj, rj1]; ring
      have h_fit_j : |u (y + h) - u y - inner ℝ (p j) h| ≤ A₀ * rj ^ (1 + γ) := hp j h hj_ge
      have h_tail_j : ‖p j - gy‖ ≤ C₂ * rj ^ (γ / 2) := htail j
      have h_tri : |u (y + h) - u y - inner ℝ gy h| ≤
          |u (y + h) - u y - inner ℝ (p j) h| + |inner ℝ (p j - gy) h| := by
        have h_id : u (y + h) - u y - inner ℝ gy h =
            (u (y + h) - u y - inner ℝ (p j) h) + inner ℝ (p j - gy) h := by
          rw [inner_sub_left]
          ring
        rw [h_id]
        exact abs_add_le _ _
      have h_cs : |inner ℝ (p j - gy) h| ≤ C₂ * rj ^ (γ / 2) * ‖h‖ := by
        calc |inner ℝ (p j - gy) h| ≤ ‖p j - gy‖ * ‖h‖ := abs_real_inner_le_norm (p j - gy) h
          _ ≤ (C₂ * rj ^ (γ / 2)) * ‖h‖ := mul_le_mul_of_nonneg_right h_tail_j (by positivity)
      have hρj_eq : ρ j = 2 ^ (1 + γ / 2) * ρ (j + 1) := by
        change Real.sqrt A₀ * rj ^ (1 + γ / 2) = 2 ^ (1 + γ / 2) * (Real.sqrt A₀ * rj1 ^ (1 + γ / 2))
        rw [hrj1_eq, Real.div_rpow (le_of_lt hrj_pos) (by norm_num)]
        have h2_ne : (2 : ℝ) ^ (1 + γ / 2) ≠ 0 := ne_of_gt (by positivity)
        field_simp [h2_ne]
      have hArj_eq : A₀ * rj ^ (1 + γ) = Real.sqrt A₀ * rj ^ (γ / 2) * ρ j := by
        change A₀ * rj ^ (1 + γ) = Real.sqrt A₀ * rj ^ (γ / 2) * (Real.sqrt A₀ * rj ^ (1 + γ / 2))
        have h_exp : 1 + γ = γ / 2 + (1 + γ / 2) := by ring
        rw [h_exp, Real.rpow_add hrj_pos]
        have hA_sqrt : A₀ = Real.sqrt A₀ * Real.sqrt A₀ := (Real.mul_self_sqrt (le_of_lt hA₀_pos)).symm
        conv_lhs => rw [hA_sqrt]
        ring
      have hArj_le : A₀ * rj ^ (1 + γ) ≤ 2 ^ (1 + γ / 2) * Real.sqrt A₀ * rj ^ (γ / 2) * ‖h‖ := by
        rw [hArj_eq, hρj_eq]
        calc Real.sqrt A₀ * rj ^ (γ / 2) * (2 ^ (1 + γ / 2) * ρ (j + 1))
            = 2 ^ (1 + γ / 2) * Real.sqrt A₀ * rj ^ (γ / 2) * ρ (j + 1) := by ring
          _ ≤ 2 ^ (1 + γ / 2) * Real.sqrt A₀ * rj ^ (γ / 2) * ‖h‖ :=
            mul_le_mul_of_nonneg_left (le_of_lt hj1_lt) (by positivity)
      have h_step1 : |u (y + h) - u y - inner ℝ gy h| ≤
          (2 ^ (1 + γ / 2) * Real.sqrt A₀ + C₂) * rj ^ (γ / 2) * ‖h‖ := by
        linarith
      have hρj1_pow : (ρ (j + 1)) ^ α_d ≤ ‖h‖ ^ α_d :=
        Real.rpow_le_rpow (by positivity) (le_of_lt hj1_lt) (le_of_lt hα_pos)
      have h_exp_id : (1 + γ / 2) * α_d = γ / 2 := by
        dsimp [α_d]
        have h2γ : (2 + γ : ℝ) ≠ 0 := by linarith
        field_simp [h2γ]
      have hρj1_id : (2 : ℝ) ^ (γ / 2) * A₀ ^ (-α_d / 2) * (ρ (j + 1)) ^ α_d = rj ^ (γ / 2) := by
        change (2 : ℝ) ^ (γ / 2) * A₀ ^ (-α_d / 2) * (Real.sqrt A₀ * rj1 ^ (1 + γ / 2)) ^ α_d = rj ^ (γ / 2)
        rw [Real.mul_rpow (by positivity) (by positivity)]
        rw [Real.sqrt_eq_rpow, ← Real.rpow_mul (le_of_lt hA₀_pos), ← Real.rpow_mul (by positivity)]
        rw [h_exp_id, hrj1_eq, Real.div_rpow (le_of_lt hrj_pos) (by norm_num)]
        have hA_cancel : A₀ ^ (-α_d / 2) * A₀ ^ (1 / 2 * α_d) = 1 := by
          rw [← Real.rpow_add hA₀_pos]
          have h_zero : -α_d / 2 + 1 / 2 * α_d = 0 := by ring
          rw [h_zero, Real.rpow_zero]
        have h2_ne : (2 : ℝ) ^ (γ / 2) ≠ 0 := ne_of_gt (by positivity)
        calc (2 : ℝ) ^ (γ / 2) * A₀ ^ (-α_d / 2) * (A₀ ^ (1 / 2 * α_d) * (rj ^ (γ / 2) / 2 ^ (γ / 2)))
            = (A₀ ^ (-α_d / 2) * A₀ ^ (1 / 2 * α_d)) * ((2 : ℝ) ^ (γ / 2) * (rj ^ (γ / 2) / 2 ^ (γ / 2))) := by ring
          _ = 1 * rj ^ (γ / 2) := by
            rw [hA_cancel, mul_div_cancel₀ _ h2_ne]
          _ = rj ^ (γ / 2) := one_mul _
      have hrj_bound : rj ^ (γ / 2) ≤ (2 : ℝ) ^ (γ / 2) * A₀ ^ (-α_d / 2) * ‖h‖ ^ α_d := by
        rw [← hρj1_id]
        exact mul_le_mul_of_nonneg_left hρj1_pow (by positivity)
      have hh_pow : ‖h‖ ^ α_d * ‖h‖ = ‖h‖ ^ (1 + α_d) := by
        rw [add_comm, Real.rpow_add hh_pos, Real.rpow_one]
      calc |u (y + h) - u y - inner ℝ gy h|
          ≤ (2 ^ (1 + γ / 2) * Real.sqrt A₀ + C₂) * rj ^ (γ / 2) * ‖h‖ := h_step1
        _ ≤ (2 ^ (1 + γ / 2) * Real.sqrt A₀ + C₂) * ((2 : ℝ) ^ (γ / 2) * A₀ ^ (-α_d / 2) * ‖h‖ ^ α_d) * ‖h‖ := by
            gcongr
        _ = (2 ^ (1 + γ / 2) * Real.sqrt A₀ + C₂) * (2 : ℝ) ^ (γ / 2) * A₀ ^ (-α_d / 2) * (‖h‖ ^ α_d * ‖h‖) := by ring
        _ = (2 ^ (1 + γ / 2) * Real.sqrt A₀ + C₂) * (2 : ℝ) ^ (γ / 2) * A₀ ^ (-(γ / (2 + γ)) / 2) * ‖h‖ ^ (1 + γ / (2 + γ)) := by
            rw [hh_pow]
  let C₂ : ℝ := 2 ^ (2 + γ / 2) * Real.sqrt A₀ / (1 - (2 : ℝ) ^ (-γ / 2))
  let L₀ : ℝ := (2 + A₀ * r₀ ^ (1 + γ)) / (Real.sqrt A₀ * r₀ ^ (1 + γ / 2)) + C₂ * r₀ ^ (γ / 2)
  let C₃ : ℝ := (2 ^ (1 + γ / 2) * Real.sqrt A₀ + C₂) * (2 : ℝ) ^ (γ / 2) * A₀ ^ (-(γ / (2 + γ)) / 2)
  have hq_lt_one : (2 : ℝ) ^ (-γ / 2) < 1 :=
    Real.rpow_lt_one_of_one_lt_of_neg one_lt_two (by linarith)
  have h1q_pos : 0 < 1 - (2 : ℝ) ^ (-γ / 2) := sub_pos.mpr hq_lt_one
  have hC₂_nonneg : 0 ≤ C₂ := by positivity
  have hL₀_nonneg : 0 ≤ L₀ := by positivity
  have hC₃_nonneg : 0 ≤ C₃ := by positivity
  refine ⟨L₀, C₃, hL₀_nonneg, hC₃_nonneg, ?_⟩
  intro u hu_bdd hu_fit
  have h_pointwise : ∀ y ∈ Metric.ball (0 : EuclideanSpace ℝ (Fin d)) (1 / 2),
      ∃ gy : EuclideanSpace ℝ (Fin d),
        ‖gy‖ ≤ L₀ ∧
        ∀ h : EuclideanSpace ℝ (Fin d),
          ‖h‖ ≤ Real.sqrt A₀ * r₀ ^ (1 + γ / 2) →
          |u (y + h) - u y - inner ℝ gy h| ≤ C₃ * ‖h‖ ^ (1 + γ / (2 + γ)) := by
    intro y hy
    have hp_ex : ∀ j : ℕ, ∃ p : EuclideanSpace ℝ (Fin d),
        ∀ h : EuclideanSpace ℝ (Fin d),
          ‖h‖ ≤ Real.sqrt A₀ * (r₀ * (1 / 2 : ℝ) ^ j) ^ (1 + γ / 2) →
          |u (y + h) - u y - inner ℝ p h| ≤ A₀ * (r₀ * (1 / 2 : ℝ) ^ j) ^ (1 + γ) := by
      intro j
      have hrj_pos : 0 < r₀ * (1 / 2 : ℝ) ^ j := by positivity
      have hrj_le : r₀ * (1 / 2 : ℝ) ^ j ≤ r₀ :=
        mul_le_of_le_one_right (le_of_lt hr₀_pos) (pow_le_one₀ (by norm_num) (by norm_num))
      exact hu_fit y hy (r₀ * (1 / 2 : ℝ) ^ j) hrj_pos hrj_le
    let p : ℕ → EuclideanSpace ℝ (Fin d) := fun j => Classical.choose (hp_ex j)
    have hp : ∀ j : ℕ, ∀ h : EuclideanSpace ℝ (Fin d),
        ‖h‖ ≤ Real.sqrt A₀ * (r₀ * (1 / 2 : ℝ) ^ j) ^ (1 + γ / 2) →
        |u (y + h) - u y - inner ℝ (p j) h| ≤ A₀ * (r₀ * (1 / 2 : ℝ) ^ j) ^ (1 + γ) :=
      fun j => Classical.choose_spec (hp_ex j)
    obtain ⟨hp0, hstep⟩ := h_s1 u hu_bdd y hy p hp
    obtain ⟨gy, hgy_norm, htail⟩ := h_s2 p hp0 hstep
    refine ⟨gy, hgy_norm, ?_⟩
    intro h hh
    exact h_s3 C₂ hC₂_nonneg u y p gy hp htail h hh
  classical
  let g : EuclideanSpace ℝ (Fin d) → EuclideanSpace ℝ (Fin d) :=
    fun y => if hy : y ∈ Metric.ball (0 : EuclideanSpace ℝ (Fin d)) (1 / 2) then
      Classical.choose (h_pointwise y hy) else 0
  refine ⟨g, ?_, ?_⟩
  · intro y hy
    dsimp [g]
    rw [dif_pos hy]
    exact (Classical.choose_spec (h_pointwise y hy)).1
  · intro y hy h hh
    dsimp [g]
    rw [dif_pos hy]
    exact (Classical.choose_spec (h_pointwise y hy)).2 h hh

theorem holder_bound_of_taylor_remainder (d : ℕ) (α_d ρ₀ L₀ C₃ : ℝ)
    (hα_pos : 0 < α_d) (hρ₀_pos : 0 < ρ₀) (hL₀_nonneg : 0 ≤ L₀) (hC₃_nonneg : 0 ≤ C₃)
    (u : EuclideanSpace ℝ (Fin d) → ℝ)
    (g : EuclideanSpace ℝ (Fin d) → EuclideanSpace ℝ (Fin d))
    (hg_bdd : ∀ y ∈ Metric.ball (0 : EuclideanSpace ℝ (Fin d)) (1 / 2), ‖g y‖ ≤ L₀)
    (hg_taylor : ∀ y ∈ Metric.ball (0 : EuclideanSpace ℝ (Fin d)) (1 / 2),
      ∀ h : EuclideanSpace ℝ (Fin d),
        ‖h‖ ≤ ρ₀ → |u (y + h) - u y - inner ℝ (g y) h| ≤ C₃ * ‖h‖ ^ (1 + α_d)) :
    ∀ x ∈ Metric.ball (0 : EuclideanSpace ℝ (Fin d)) (1 / 2),
      ∀ y ∈ Metric.ball (0 : EuclideanSpace ℝ (Fin d)) (1 / 2),
        ‖g x - g y‖ ≤
          (C₃ * (2 + 2 ^ (1 + α_d)) + 2 * L₀ * (ρ₀ / 2) ^ (-α_d)) * ‖x - y‖ ^ α_d :=
by
  intro x hx y hy
  set v : EuclideanSpace ℝ (Fin d) := g x - g y
  set ℓ : ℝ := ‖x - y‖
  set C₄_small : ℝ := C₃ * (2 + 2 ^ (1 + α_d))
  set C₄_large : ℝ := 2 * L₀ * (ρ₀ / 2) ^ (-α_d)
  have hC₄_small_nonneg : 0 ≤ C₄_small := by positivity
  have hC₄_large_nonneg : 0 ≤ C₄_large := by positivity
  have hℓ_nonneg : 0 ≤ ℓ := norm_nonneg (x - y)
  have hℓ_rpow_nonneg : 0 ≤ ℓ ^ α_d := by positivity
  by_cases h_eq : g x = g y
  · have hv_zero : ‖g x - g y‖ = 0 := by rw [h_eq, sub_self, norm_zero]
    rw [hv_zero]
    positivity
  · have hv_ne : v ≠ 0 := sub_ne_zero.mpr h_eq
    have hv_pos : 0 < ‖v‖ := norm_pos_iff.mpr hv_ne
    have hxy_ne : x ≠ y := by
      intro hxy
      exact h_eq (congrArg g hxy)
    have hℓ_pos : 0 < ℓ := norm_pos_iff.mpr (sub_ne_zero.mpr hxy_ne)
    rcases le_or_gt ℓ (ρ₀ / 2) with h_le | h_gt
    · 
      set w : EuclideanSpace ℝ (Fin d) := (ℓ / ‖v‖) • v
      have hw_norm : ‖w‖ = ℓ := by
        rw [norm_smul, Real.norm_of_nonneg (by positivity : 0 ≤ ℓ / ‖v‖),
          div_mul_cancel₀ ℓ (ne_of_gt hv_pos)]
      have hvw_inner : inner ℝ v w = ℓ * ‖v‖ := by
        rw [inner_smul_right, real_inner_self_eq_norm_mul_norm,
          ← mul_assoc, div_mul_cancel₀ ℓ (ne_of_gt hv_pos)]
      have hw_le_ρ₀ : ‖w‖ ≤ ρ₀ := by linarith
      have hR₀ := hg_taylor y hy w hw_le_ρ₀
      rw [hw_norm] at hR₀
      have hyx_norm : ‖y - x‖ = ℓ := norm_sub_rev y x
      have hyx_le_ρ₀ : ‖y - x‖ ≤ ρ₀ := by linarith
      have hR₁ := hg_taylor x hx (y - x) hyx_le_ρ₀
      have hxy_add : x + (y - x) = y := add_sub_cancel x y
      rw [hxy_add, hyx_norm] at hR₁
      have hh₂_norm : ‖(y - x) + w‖ ≤ 2 * ℓ := by
        calc ‖(y - x) + w‖ ≤ ‖y - x‖ + ‖w‖ := norm_add_le (y - x) w
          _ = ℓ + ℓ := by rw [hyx_norm, hw_norm]
          _ = 2 * ℓ := by ring
      have hh₂_le_ρ₀ : ‖(y - x) + w‖ ≤ ρ₀ := by linarith
      have hR₂_raw := hg_taylor x hx ((y - x) + w) hh₂_le_ρ₀
      have hx_add₂ : x + ((y - x) + w) = y + w := by abel
      rw [hx_add₂] at hR₂_raw
      have hh₂_rpow : ‖(y - x) + w‖ ^ (1 + α_d) ≤ 2 ^ (1 + α_d) * ℓ ^ (1 + α_d) := by
        calc ‖(y - x) + w‖ ^ (1 + α_d) ≤ (2 * ℓ) ^ (1 + α_d) :=
              Real.rpow_le_rpow (norm_nonneg _) hh₂_norm (by linarith)
          _ = 2 ^ (1 + α_d) * ℓ ^ (1 + α_d) :=
              Real.mul_rpow (by norm_num : (0 : ℝ) ≤ 2) (le_of_lt hℓ_pos)
      have hR₂ : |u (y + w) - u x - inner ℝ (g x) ((y - x) + w)| ≤
          C₃ * (2 ^ (1 + α_d) * ℓ ^ (1 + α_d)) :=
        le_trans hR₂_raw (mul_le_mul_of_nonneg_left hh₂_rpow hC₃_nonneg)
      set R₀ : ℝ := u (y + w) - u y - inner ℝ (g y) w
      set R₁ : ℝ := u y - u x - inner ℝ (g x) (y - x)
      set R₂ : ℝ := u (y + w) - u x - inner ℝ (g x) ((y - x) + w)
      have h_pol : ℓ * ‖v‖ = R₀ + R₁ - R₂ := by
        have h_in1 : inner ℝ v w = inner ℝ (g x) w - inner ℝ (g y) w := inner_sub_left (g x) (g y) w
        have h_in2 : inner ℝ (g x) ((y - x) + w) = inner ℝ (g x) (y - x) + inner ℝ (g x) w :=
          inner_add_right (g x) (y - x) w
        dsimp only [R₀, R₁, R₂]
        linarith
      have h_abs_pol : ℓ * ‖v‖ ≤ |R₀| + |R₁| + |R₂| := by
        calc ℓ * ‖v‖ = |ℓ * ‖v‖| := (abs_of_nonneg (by positivity)).symm
          _ = |R₀ + R₁ - R₂| := by rw [h_pol]
          _ = |(R₀ + R₁) + (-R₂)| := by ring_nf
          _ ≤ |R₀ + R₁| + |-R₂| := abs_add_le (R₀ + R₁) (-R₂)
          _ = |R₀ + R₁| + |R₂| := by rw [abs_neg]
          _ ≤ |R₀| + |R₁| + |R₂| := by linarith [abs_add_le R₀ R₁]
      have h_rpow_split : ℓ ^ (1 + α_d) = ℓ * ℓ ^ α_d := by
        rw [Real.rpow_add hℓ_pos 1 α_d, Real.rpow_one]
      have h_mul_bound : ℓ * ‖v‖ ≤ ℓ * (C₄_small * ℓ ^ α_d) := by
        calc ℓ * ‖v‖ ≤ |R₀| + |R₁| + |R₂| := h_abs_pol
          _ ≤ C₃ * ℓ ^ (1 + α_d) + C₃ * ℓ ^ (1 + α_d) + C₃ * (2 ^ (1 + α_d) * ℓ ^ (1 + α_d)) := by
            linarith [hR₀, hR₁, hR₂]
          _ = C₄_small * ℓ ^ (1 + α_d) := by dsimp only [C₄_small]; ring
          _ = C₄_small * (ℓ * ℓ ^ α_d) := by rw [h_rpow_split]
          _ = ℓ * (C₄_small * ℓ ^ α_d) := by ring
      have hv_bound : ‖v‖ ≤ C₄_small * ℓ ^ α_d := le_of_mul_le_mul_left h_mul_bound hℓ_pos
      have h_extra : 0 ≤ C₄_large * ℓ ^ α_d := by positivity
      change ‖v‖ ≤ (C₄_small + C₄_large) * ℓ ^ α_d
      linarith
    · 
      have h_g_sub : ‖v‖ ≤ 2 * L₀ := by
        calc ‖v‖ = ‖g x - g y‖ := rfl
          _ ≤ ‖g x‖ + ‖g y‖ := norm_sub_le (g x) (g y)
          _ ≤ L₀ + L₀ := add_le_add (hg_bdd x hx) (hg_bdd y hy)
          _ = 2 * L₀ := by ring
      have hρ2_pos : 0 < ρ₀ / 2 := by linarith
      have h_rpow_le : (ρ₀ / 2) ^ α_d ≤ ℓ ^ α_d :=
        Real.rpow_le_rpow (le_of_lt hρ2_pos) (le_of_lt h_gt) (le_of_lt hα_pos)
      have hρ2_rpow_pos : 0 < (ρ₀ / 2) ^ α_d := Real.rpow_pos_of_pos hρ2_pos α_d
      have h_one_le : 1 ≤ (ρ₀ / 2) ^ (-α_d) * ℓ ^ α_d := by
        calc (1 : ℝ) = ((ρ₀ / 2) ^ α_d)⁻¹ * (ρ₀ / 2) ^ α_d :=
              (inv_mul_cancel₀ (ne_of_gt hρ2_rpow_pos)).symm
          _ = (ρ₀ / 2) ^ (-α_d) * (ρ₀ / 2) ^ α_d := by
              rw [Real.rpow_neg (le_of_lt hρ2_pos) α_d]
          _ ≤ (ρ₀ / 2) ^ (-α_d) * ℓ ^ α_d :=
              mul_le_mul_of_nonneg_left h_rpow_le (by positivity)
      have h_2L₀_le : 2 * L₀ ≤ C₄_large * ℓ ^ α_d := by
        calc 2 * L₀ = (2 * L₀) * 1 := (mul_one (2 * L₀)).symm
          _ ≤ (2 * L₀) * ((ρ₀ / 2) ^ (-α_d) * ℓ ^ α_d) :=
              mul_le_mul_of_nonneg_left h_one_le (by positivity)
          _ = C₄_large * ℓ ^ α_d := by dsimp only [C₄_large]; ring
      have h_extra : 0 ≤ C₄_small * ℓ ^ α_d := by positivity
      change ‖v‖ ≤ (C₄_small + C₄_large) * ℓ ^ α_d
      linarith

theorem memC1HolderOn_of_taylor_and_holder (d : ℕ) (α_d ρ₀ L₀ C₃ C₄ : ℝ)
    (hα_pos : 0 < α_d) (hρ₀_pos : 0 < ρ₀) (hL₀_nonneg : 0 ≤ L₀)
    (hC₃_nonneg : 0 ≤ C₃) (hC₄_nonneg : 0 ≤ C₄)
    (u : EuclideanSpace ℝ (Fin d) → ℝ)
    (g : EuclideanSpace ℝ (Fin d) → EuclideanSpace ℝ (Fin d))
    (hu_bdd : ∀ x ∈ Metric.ball (0 : EuclideanSpace ℝ (Fin d)) 1, |u x| ≤ 1)
    (hg_bdd : ∀ y ∈ Metric.ball (0 : EuclideanSpace ℝ (Fin d)) (1 / 2), ‖g y‖ ≤ L₀)
    (hg_taylor : ∀ y ∈ Metric.ball (0 : EuclideanSpace ℝ (Fin d)) (1 / 2),
      ∀ h : EuclideanSpace ℝ (Fin d),
        ‖h‖ ≤ ρ₀ → |u (y + h) - u y - inner ℝ (g y) h| ≤ C₃ * ‖h‖ ^ (1 + α_d))
    (hg_holder : ∀ x ∈ Metric.ball (0 : EuclideanSpace ℝ (Fin d)) (1 / 2),
      ∀ y ∈ Metric.ball (0 : EuclideanSpace ℝ (Fin d)) (1 / 2),
        ‖g x - g y‖ ≤ C₄ * ‖x - y‖ ^ α_d) :
    MemC1HolderOn α_d u (Metric.ball 0 (1 / 2)) ∧
    supNormOn (gradient u) (Metric.ball 0 (1 / 2)) +
      holderSeminormOn α_d (gradient u) (Metric.ball 0 (1 / 2)) ≤ L₀ + C₄ :=
by
  let E : Set (EuclideanSpace ℝ (Fin d)) := Metric.ball 0 (1 / 2)
  have h_grad : ∀ y ∈ E, HasGradientAt u (g y) y := by
    intro y hy
    rw [hasGradientAt_iff_isLittleO, Asymptotics.isLittleO_iff]
    intro c hc
    rw [Metric.eventually_nhds_iff]
    have hC3_pos : 0 < C₃ + 1 := by linarith
    have hc_div_pos : 0 < c / (C₃ + 1) := div_pos hc hC3_pos
    let δ : ℝ := min ρ₀ ((c / (C₃ + 1)) ^ (1 / α_d))
    have hδ_pos : 0 < δ := lt_min hρ₀_pos (Real.rpow_pos_of_pos hc_div_pos (1 / α_d))
    refine ⟨δ, hδ_pos, ?_⟩
    intro x' hx'
    let h : EuclideanSpace ℝ (Fin d) := x' - y
    have hh_lt : ‖h‖ < δ := by simpa [h, dist_eq_norm] using hx'
    have hh_le_ρ₀ : ‖h‖ ≤ ρ₀ := le_trans (le_of_lt hh_lt) (min_le_left _ _)
    have hh_le_c : ‖h‖ ≤ (c / (C₃ + 1)) ^ (1 / α_d) :=
      le_trans (le_of_lt hh_lt) (min_le_right _ _)
    have hyh : y + h = x' := add_sub_cancel y x'
    have h_tay := hg_taylor y hy h hh_le_ρ₀
    rw [hyh] at h_tay
    have h_rpow_split : ‖h‖ ^ (1 + α_d) = ‖h‖ * ‖h‖ ^ α_d :=
      Real.rpow_one_add' (norm_nonneg h) (by linarith)
    have h_rpow_le : ‖h‖ ^ α_d ≤ c / (C₃ + 1) := by
      calc ‖h‖ ^ α_d ≤ ((c / (C₃ + 1)) ^ (1 / α_d)) ^ α_d :=
            Real.rpow_le_rpow (norm_nonneg h) hh_le_c (le_of_lt hα_pos)
        _ = (c / (C₃ + 1)) ^ ((1 / α_d) * α_d) :=
            (Real.rpow_mul (le_of_lt hc_div_pos) (1 / α_d) α_d).symm
        _ = (c / (C₃ + 1)) ^ (1 : ℝ) := by rw [one_div_mul_cancel (ne_of_gt hα_pos)]
        _ = c / (C₃ + 1) := Real.rpow_one (c / (C₃ + 1))
    have hC3_mul_le : C₃ * ‖h‖ ^ α_d ≤ c := by
      calc C₃ * ‖h‖ ^ α_d ≤ C₃ * (c / (C₃ + 1)) :=
            mul_le_mul_of_nonneg_left h_rpow_le hC₃_nonneg
        _ ≤ (C₃ + 1) * (c / (C₃ + 1)) :=
            mul_le_mul_of_nonneg_right (by linarith) (le_of_lt hc_div_pos)
        _ = c := mul_div_cancel₀ c (ne_of_gt hC3_pos)
    rw [Real.norm_eq_abs]
    calc |u x' - u y - inner ℝ (g y) (x' - y)| = |u x' - u y - inner ℝ (g y) h| := rfl
      _ ≤ C₃ * ‖h‖ ^ (1 + α_d) := h_tay
      _ = (C₃ * ‖h‖ ^ α_d) * ‖h‖ := by rw [h_rpow_split]; ring
      _ ≤ c * ‖h‖ := mul_le_mul_of_nonneg_right hC3_mul_le (norm_nonneg h)
      _ = c * ‖x' - y‖ := rfl
  have h_grad_eq : ∀ y ∈ E, gradient u y = g y :=
    fun y hy => (h_grad y hy).gradient
  have h_fderiv : ∀ y ∈ E,
      HasFDerivAt u (InnerProductSpace.toDual ℝ (EuclideanSpace ℝ (Fin d)) (g y)) y :=
    fun y hy => (h_grad y hy).hasFDerivAt
  have hg_cont : ContinuousOn g E := by
    rw [Metric.continuousOn_iff]
    intro b hb ε hε
    have hC4_pos : 0 < C₄ + 1 := by linarith
    have hε_div_pos : 0 < ε / (C₄ + 1) := div_pos hε hC4_pos
    let δ : ℝ := (ε / (C₄ + 1)) ^ (1 / α_d)
    have hδ_pos : 0 < δ := Real.rpow_pos_of_pos hε_div_pos (1 / α_d)
    refine ⟨δ, hδ_pos, ?_⟩
    intro a ha hab
    have hab_le : ‖a - b‖ ≤ δ := by rw [← dist_eq_norm]; exact le_of_lt hab
    have h_rpow_le : ‖a - b‖ ^ α_d ≤ ε / (C₄ + 1) := by
      calc ‖a - b‖ ^ α_d ≤ δ ^ α_d :=
            Real.rpow_le_rpow (norm_nonneg (a - b)) hab_le (le_of_lt hα_pos)
        _ = (ε / (C₄ + 1)) ^ ((1 / α_d) * α_d) :=
            (Real.rpow_mul (le_of_lt hε_div_pos) (1 / α_d) α_d).symm
        _ = (ε / (C₄ + 1)) ^ (1 : ℝ) := by rw [one_div_mul_cancel (ne_of_gt hα_pos)]
        _ = ε / (C₄ + 1) := Real.rpow_one (ε / (C₄ + 1))
    rw [dist_eq_norm]
    calc ‖g a - g b‖ ≤ C₄ * ‖a - b‖ ^ α_d := hg_holder a ha b hb
      _ ≤ C₄ * (ε / (C₄ + 1)) := mul_le_mul_of_nonneg_left h_rpow_le hC₄_nonneg
      _ < (C₄ + 1) * (ε / (C₄ + 1)) := mul_lt_mul_of_pos_right (by linarith) hε_div_pos
      _ = ε := mul_div_cancel₀ ε (ne_of_gt hC4_pos)
  have hu_c1 : ContDiffOn ℝ 1 u E := by
    have hu_diff : DifferentiableOn ℝ u E :=
      fun y hy => (h_fderiv y hy).differentiableAt.differentiableWithinAt
    let L := InnerProductSpace.toDual ℝ (EuclideanSpace ℝ (Fin d))
    have hL_cont : ContinuousOn (fun y => L (g y)) E :=
      L.continuous.comp_continuousOn hg_cont
    have hfderiv_cont : ContinuousOn (fun y => fderivWithin ℝ u E y) E := by
      refine hL_cont.congr ?_
      intro y hy
      dsimp only
      exact (h_fderiv y hy).hasFDerivWithinAt.fderivWithin
        (Metric.isOpen_ball.uniqueDiffWithinAt hy)
    have hfderiv_c0 : ContDiffOn ℝ (0 : WithTop ℕ∞) (fun y => fderivWithin ℝ u E y) E :=
      contDiffOn_zero.mpr hfderiv_cont
    exact contDiffOn_succ_of_fderivWithin (n := 0) hu_diff (fun h => nomatch h) hfderiv_c0
  have hu_bdd_E : Bornology.IsBounded (u '' E) := by
    refine (Metric.isBounded_Icc (-1 : ℝ) 1).subset ?_
    rintro _ ⟨x, hx, rfl⟩
    have hx1 : x ∈ Metric.ball (0 : EuclideanSpace ℝ (Fin d)) 1 :=
      Metric.ball_subset_ball (by norm_num : (1 / 2 : ℝ) ≤ 1) hx
    exact abs_le.mp (hu_bdd x hx1)
  have h_sup_mem : ∀ a ∈ (fun x => ‖gradient u x‖) '' E, a ≤ L₀ := by
    rintro _ ⟨x, hx, rfl⟩
    dsimp only
    rw [h_grad_eq x hx]
    exact hg_bdd x hx
  have h_sup_bdd : BddAbove ((fun x => ‖gradient u x‖) '' E) := ⟨L₀, h_sup_mem⟩
  have h_sup_le : supNormOn (gradient u) E ≤ L₀ :=
    Real.sSup_le h_sup_mem hL₀_nonneg
  have h_hold_mem : ∀ q ∈ { q : ℝ | ∃ x ∈ E, ∃ y ∈ E, x ≠ y ∧
      q = ‖gradient u x - gradient u y‖ / ‖x - y‖ ^ α_d }, q ≤ C₄ := by
    rintro q ⟨x, hx, y, hy, hxy, rfl⟩
    have h_norm_pos : 0 < ‖x - y‖ := norm_pos_iff.mpr (sub_ne_zero.mpr hxy)
    have h_rpow_pos : 0 < ‖x - y‖ ^ α_d := Real.rpow_pos_of_pos h_norm_pos α_d
    rw [h_grad_eq x hx, h_grad_eq y hy, div_le_iff₀ h_rpow_pos]
    exact hg_holder x hx y hy
  have h_hold_bdd : BddAbove { q : ℝ | ∃ x ∈ E, ∃ y ∈ E, x ≠ y ∧
      q = ‖gradient u x - gradient u y‖ / ‖x - y‖ ^ α_d } := ⟨C₄, h_hold_mem⟩
  have h_hold_le : holderSeminormOn α_d (gradient u) E ≤ C₄ :=
    Real.sSup_le h_hold_mem hC₄_nonneg
  exact ⟨⟨hu_c1, hu_bdd_E, h_sup_bdd, h_hold_bdd⟩, add_le_add h_sup_le h_hold_le⟩

theorem c1_holder_of_normalized_of_power_decay (d : ℕ) (hd : 3 ≤ d) (B γ s₀ : ℝ)
    (h_decay : HasUniformCylinderPowerDecay d B γ s₀) :
    ∃ (α_d C_d : ℝ),
      0 < α_d ∧ α_d ≤ 1 / 3 ∧ 0 ≤ C_d ∧
      ∀ u : EuclideanSpace ℝ (Fin d) → ℝ,
        IsNormalizedInfinityHarmonic d u →
        MemC1HolderOn α_d u (Metric.ball 0 (1 / 2)) ∧
        supNormOn (gradient u) (Metric.ball 0 (1 / 2)) +
          holderSeminormOn α_d (gradient u) (Metric.ball 0 (1 / 2)) ≤ C_d :=
by
  obtain ⟨A₀, r₀, hA₀_pos, hr₀_pos, hr₀_le, hAr_le, hρ₀_le, h_fits⟩ :=
    horizontal_ball_fits_of_power_decay d B γ s₀ h_decay
  obtain ⟨_, hγ_pos, hγ_le, _, _, _⟩ := h_decay
  obtain ⟨L₀, C₃, hL₀_nonneg, hC₃_nonneg, h_taylor_all⟩ :=
    taylor_holder_of_horizontal_ball_fits d γ A₀ r₀
      hγ_pos hγ_le hA₀_pos hr₀_pos hr₀_le hAr_le hρ₀_le
  let α_d : ℝ := γ / (2 + γ)
  let ρ₀ : ℝ := Real.sqrt A₀ * r₀ ^ (1 + γ / 2)
  let C₄ : ℝ := C₃ * (2 + 2 ^ (1 + α_d)) + 2 * L₀ * (ρ₀ / 2) ^ (-α_d)
  let C_d : ℝ := L₀ + C₄
  have hα_pos : 0 < α_d := by positivity
  have hα_le : α_d ≤ 1 / 3 := by
    change γ / (2 + γ) ≤ 1 / 3
    rw [div_le_iff₀ (by linarith : (0 : ℝ) < 2 + γ)]
    linarith
  have hρ₀_pos : 0 < ρ₀ := by positivity
  have hC₄_nonneg : 0 ≤ C₄ := by positivity
  have hCd_nonneg : 0 ≤ C_d := by positivity
  refine ⟨α_d, C_d, hα_pos, hα_le, hCd_nonneg, ?_⟩
  intro u hu
  obtain ⟨hu_bdd, hu_fit⟩ := h_fits u hu
  obtain ⟨g, hg_bdd, hg_taylor⟩ := h_taylor_all u hu_bdd hu_fit
  have hg_holder :=
    holder_bound_of_taylor_remainder d α_d ρ₀ L₀ C₃
      hα_pos hρ₀_pos hL₀_nonneg hC₃_nonneg u g hg_bdd hg_taylor
  exact memC1HolderOn_of_taylor_and_holder d α_d ρ₀ L₀ C₃ C₄
    hα_pos hρ₀_pos hL₀_nonneg hC₃_nonneg hC₄_nonneg u g hu_bdd hg_bdd hg_taylor hg_holder

theorem c1_holder_scaling_reduction (d : ℕ) (hd : 3 ≤ d) (α_d C_d : ℝ)
    (hα_pos : 0 < α_d) (hα_le : α_d ≤ 1 / 3) (hC_nonneg : 0 ≤ C_d)
    (h_norm : ∀ w : EuclideanSpace ℝ (Fin d) → ℝ,
      IsNormalizedInfinityHarmonic d w →
      MemC1HolderOn α_d w (Metric.ball 0 (1 / 2)) ∧
      supNormOn (gradient w) (Metric.ball 0 (1 / 2)) +
        holderSeminormOn α_d (gradient w) (Metric.ball 0 (1 / 2)) ≤ C_d)
    (u : EuclideanSpace ℝ (Fin d) → ℝ)
    (hbdd : Bornology.IsBounded (u '' Metric.ball 0 1))
    (hhar : IsInfinityHarmonicOn u (Metric.ball 0 1)) :
    MemC1HolderOn α_d u (Metric.ball 0 (1 / 2)) ∧
    supNormOn (gradient u) (Metric.ball 0 (1 / 2)) +
      holderSeminormOn α_d (gradient u) (Metric.ball 0 (1 / 2)) ≤
        C_d * oscOn u (Metric.ball 0 1) :=
by
  have h_fderiv_scale : ∀ (f : EuclideanSpace ℝ (Fin d) → ℝ) (c b : ℝ)
      (x : EuclideanSpace ℝ (Fin d)),
      DifferentiableAt ℝ f x →
      fderiv ℝ (fun y => c * f y + b) x = c • fderiv ℝ f x := by
    intro f c b x hf
    rw [fderiv_add_const]
    exact fderiv_const_smul hf c
  have h_grad_scale : ∀ (f : EuclideanSpace ℝ (Fin d) → ℝ) (c b : ℝ)
      (x : EuclideanSpace ℝ (Fin d)),
      DifferentiableAt ℝ f x →
      gradient (fun y => c * f y + b) x = c • gradient f x := by
    intro f c b x hf
    unfold gradient
    rw [h_fderiv_scale f c b x hf, LinearIsometryEquiv.map_smul]
  have h_lap_scale : ∀ (ϕ : EuclideanSpace ℝ (Fin d) → ℝ)
      (V : Set (EuclideanSpace ℝ (Fin d))) (z : EuclideanSpace ℝ (Fin d)) (c b : ℝ),
      IsOpen V → z ∈ V → ContDiffOn ℝ 2 ϕ V →
      infinityLaplacian (fun y => c * ϕ y + b) z = c ^ 3 * infinityLaplacian ϕ z := by
    intro ϕ V z c b hV_open hz hϕ_diff
    have h_diff_on : ∀ y ∈ V, DifferentiableAt ℝ ϕ y := fun y hy =>
      (hϕ_diff.contDiffAt (hV_open.mem_nhds hy)).differentiableAt (by norm_num)
    have h_ev : fderiv ℝ (fun y => c * ϕ y + b) =ᶠ[nhds z] (c • fderiv ℝ ϕ) :=
      Filter.eventuallyEq_of_mem (hV_open.mem_nhds hz)
        (fun y hy => h_fderiv_scale ϕ c b y (h_diff_on y hy))
    have h_fderiv2_diff : DifferentiableAt ℝ (fderiv ℝ ϕ) z :=
      ((hϕ_diff.contDiffAt (hV_open.mem_nhds hz)).fderiv_right (m := 1) (by norm_num)).differentiableAt_one
    have h_fderiv2 : fderiv ℝ (fderiv ℝ (fun y => c * ϕ y + b)) z = c • fderiv ℝ (fderiv ℝ ϕ) z := by
      rw [h_ev.fderiv_eq]
      exact fderiv_const_smul h_fderiv2_diff c
    unfold infinityLaplacian
    rw [h_fderiv2, h_grad_scale ϕ c b z (h_diff_on z hz)]
    simp only [ContinuousLinearMap.smul_apply, ContinuousLinearMap.map_smul, smul_eq_mul]
    ring
  let B1 : Set (EuclideanSpace ℝ (Fin d)) := Metric.ball 0 1
  let B12 : Set (EuclideanSpace ℝ (Fin d)) := Metric.ball 0 (1 / 2)
  have h0_mem : (0 : EuclideanSpace ℝ (Fin d)) ∈ B1 := Metric.mem_ball_self zero_lt_one
  have h_sub : B12 ⊆ B1 := Metric.ball_subset_ball (by norm_num)
  rcases le_or_gt (oscOn u B1) 0 with hM_le | hM_pos
  · have h0_le : u 0 ≤ sSup (u '' B1) := le_csSup hbdd.bddAbove ⟨0, h0_mem, rfl⟩
    have h0_ge : sInf (u '' B1) ≤ u 0 := csInf_le hbdd.bddBelow ⟨0, h0_mem, rfl⟩
    have hM_def : oscOn u B1 = sSup (u '' B1) - sInf (u '' B1) := rfl
    have hM_zero : oscOn u B1 = 0 := by linarith
    have hu_const : ∀ x ∈ B12, u x = u 0 := by
      intro x hx
      have hx_le : u x ≤ sSup (u '' B1) := le_csSup hbdd.bddAbove ⟨x, h_sub hx, rfl⟩
      have hx_ge : sInf (u '' B1) ≤ u x := csInf_le hbdd.bddBelow ⟨x, h_sub hx, rfl⟩
      linarith
    have h_grad_zero : ∀ x ∈ B12, gradient u x = 0 := by
      intro x hx
      have h_ev : u =ᶠ[nhds x] (fun _ => u 0) :=
        Filter.eventuallyEq_of_mem (Metric.isOpen_ball.mem_nhds hx) hu_const
      unfold gradient
      rw [h_ev.fderiv_eq, fderiv_const_apply, LinearIsometryEquiv.map_zero]
    have h_sup_mem : ∀ a ∈ (fun x => ‖gradient u x‖) '' B12, a ≤ 0 := by
      rintro _ ⟨x, hx, rfl⟩
      dsimp
      rw [h_grad_zero x hx, norm_zero]
    have h_hold_mem : ∀ q ∈ { q : ℝ | ∃ x ∈ B12, ∃ y ∈ B12, x ≠ y ∧
        q = ‖gradient u x - gradient u y‖ / ‖x - y‖ ^ α_d }, q ≤ 0 := by
      rintro _ ⟨x, hx, y, hy, _, rfl⟩
      rw [h_grad_zero x hx, h_grad_zero y hy, sub_self, norm_zero, zero_div]
    refine ⟨⟨contDiffOn_const.congr hu_const, hbdd.subset (Set.image_mono h_sub),
      ⟨0, h_sup_mem⟩, ⟨0, h_hold_mem⟩⟩, ?_⟩
    have h_sup_le : supNormOn (gradient u) B12 ≤ 0 := Real.sSup_nonpos h_sup_mem
    have h_hold_le : holderSeminormOn α_d (gradient u) B12 ≤ 0 := Real.sSup_nonpos h_hold_mem
    change supNormOn (gradient u) B12 + holderSeminormOn α_d (gradient u) B12 ≤ C_d * oscOn u B1
    rw [hM_zero, mul_zero]
    linarith
  · let M : ℝ := oscOn u B1
    let w : EuclideanSpace ℝ (Fin d) → ℝ := fun x => M⁻¹ * (u x - u 0)
    have hM_ne : M ≠ 0 := ne_of_gt hM_pos
    have hMinv_pos : 0 < M⁻¹ := inv_pos.mpr hM_pos
    have hMinv_nonneg : 0 ≤ M⁻¹ := le_of_lt hMinv_pos
    have hw_lower : ∀ y ∈ w '' B1, M⁻¹ * (sInf (u '' B1) - u 0) ≤ y := by
      rintro _ ⟨x, hx, rfl⟩
      exact mul_le_mul_of_nonneg_left
        (sub_le_sub_right (csInf_le hbdd.bddBelow ⟨x, hx, rfl⟩) (u 0)) hMinv_nonneg
    have hw_upper : ∀ y ∈ w '' B1, y ≤ M⁻¹ * (sSup (u '' B1) - u 0) := by
      rintro _ ⟨x, hx, rfl⟩
      exact mul_le_mul_of_nonneg_left
        (sub_le_sub_right (le_csSup hbdd.bddAbove ⟨x, hx, rfl⟩) (u 0)) hMinv_nonneg
    have hw_bdd : Bornology.IsBounded (w '' B1) :=
      (IsOrderBornology.isBounded_iff_bddBelow_bddAbove (w '' B1)).mpr
        ⟨⟨M⁻¹ * (sInf (u '' B1) - u 0), hw_lower⟩, ⟨M⁻¹ * (sSup (u '' B1) - u 0), hw_upper⟩⟩
    have hw_ne : (w '' B1).Nonempty := ⟨w 0, 0, h0_mem, rfl⟩
    have hw_sup : sSup (w '' B1) ≤ M⁻¹ * (sSup (u '' B1) - u 0) := csSup_le hw_ne hw_upper
    have hw_inf : M⁻¹ * (sInf (u '' B1) - u 0) ≤ sInf (w '' B1) := le_csInf hw_ne hw_lower
    have hw_osc : oscOn w B1 ≤ 1 := by
      unfold oscOn
      have h_diff : M⁻¹ * (sSup (u '' B1) - u 0) - M⁻¹ * (sInf (u '' B1) - u 0) = 1 := by
        calc M⁻¹ * (sSup (u '' B1) - u 0) - M⁻¹ * (sInf (u '' B1) - u 0)
            = M⁻¹ * (sSup (u '' B1) - sInf (u '' B1)) := by ring
          _ = M⁻¹ * M := rfl
          _ = 1 := inv_mul_cancel₀ hM_ne
      linarith
    rcases hhar with ⟨hu_cont, hu_sub, hu_sup⟩
    have hw_cont : ContinuousOn w B1 := by
      change ContinuousOn (fun x => M⁻¹ • (u x - u 0)) B1
      exact (hu_cont.sub continuousOn_const).const_smul M⁻¹
    have hw_har : IsInfinityHarmonicOn w B1 := by
      refine ⟨hw_cont, ?_, ?_⟩
      · intro z hz ϕ V hV_open hzV hV_sub hϕ_diff hϕ_z hϕ_ge
        let ϕ' : EuclideanSpace ℝ (Fin d) → ℝ := fun y => M * ϕ y + u 0
        have hϕ'_diff : ContDiffOn ℝ 2 ϕ' V := by
          change ContDiffOn ℝ 2 (fun y => M • ϕ y + u 0) V
          exact (hϕ_diff.const_smul M).add contDiffOn_const
        have hϕ'_z : ϕ' z = u z := by
          dsimp [ϕ']
          rw [hϕ_z]
          dsimp [w]
          rw [← mul_assoc, mul_inv_cancel₀ hM_ne, one_mul, sub_add_cancel]
        have hϕ'_ge : ∀ y ∈ V, u y ≤ ϕ' y := by
          intro y hy
          have h_le := mul_le_mul_of_nonneg_left (hϕ_ge y hy) (le_of_lt hM_pos)
          dsimp [w] at h_le
          rw [← mul_assoc, mul_inv_cancel₀ hM_ne, one_mul] at h_le
          dsimp [ϕ']
          linarith
        have h_lap := hu_sub z hz ϕ' V hV_open hzV hV_sub hϕ'_diff hϕ'_z hϕ'_ge
        rw [h_lap_scale ϕ V z M (u 0) hV_open hzV hϕ_diff] at h_lap
        exact nonneg_of_mul_nonneg_right h_lap (pow_pos hM_pos 3)
      · intro z hz ϕ V hV_open hzV hV_sub hϕ_diff hϕ_z hϕ_le
        let ϕ' : EuclideanSpace ℝ (Fin d) → ℝ := fun y => M * ϕ y + u 0
        have hϕ'_diff : ContDiffOn ℝ 2 ϕ' V := by
          change ContDiffOn ℝ 2 (fun y => M • ϕ y + u 0) V
          exact (hϕ_diff.const_smul M).add contDiffOn_const
        have hϕ'_z : ϕ' z = u z := by
          dsimp [ϕ']
          rw [hϕ_z]
          dsimp [w]
          rw [← mul_assoc, mul_inv_cancel₀ hM_ne, one_mul, sub_add_cancel]
        have hϕ'_le : ∀ y ∈ V, ϕ' y ≤ u y := by
          intro y hy
          have h_le := mul_le_mul_of_nonneg_left (hϕ_le y hy) (le_of_lt hM_pos)
          dsimp [w] at h_le
          rw [← mul_assoc, mul_inv_cancel₀ hM_ne, one_mul] at h_le
          dsimp [ϕ']
          linarith
        have h_lap := hu_sup z hz ϕ' V hV_open hzV hV_sub hϕ'_diff hϕ'_z hϕ'_le
        rw [h_lap_scale ϕ V z M (u 0) hV_open hzV hϕ_diff] at h_lap
        exact nonpos_of_mul_nonpos_right h_lap (pow_pos hM_pos 3)
    have hw_norm : IsNormalizedInfinityHarmonic d w :=
      ⟨hw_bdd, hw_har, by simp [w], hw_osc⟩
    obtain ⟨⟨hw_diff, _, hw_grad_bdd, hw_hold_bdd⟩, hw_est⟩ := h_norm w hw_norm
    have hu_eq : u = fun y => M * w y + u 0 := by
      ext y
      dsimp [w]
      rw [← mul_assoc, mul_inv_cancel₀ hM_ne, one_mul, sub_add_cancel]
    have hu_diff : ContDiffOn ℝ 1 u B12 := by
      rw [hu_eq]
      change ContDiffOn ℝ 1 (fun y => M • w y + u 0) B12
      exact (hw_diff.const_smul M).add contDiffOn_const
    have hu_bdd12 : Bornology.IsBounded (u '' B12) :=
      hbdd.subset (Set.image_mono h_sub)
    have hu_grad : ∀ x ∈ B12, gradient u x = M • gradient w x := by
      intro x hx
      have hw_diff_x : DifferentiableAt ℝ w x :=
        (hw_diff.contDiffAt (Metric.isOpen_ball.mem_nhds hx)).differentiableAt_one
      rw [hu_eq]
      exact h_grad_scale w M (u 0) x hw_diff_x
    have h_sup_w_nonneg : 0 ≤ supNormOn (gradient w) B12 :=
      Real.sSup_nonneg (by rintro _ ⟨x, _, rfl⟩; exact norm_nonneg _)
    have h_hold_w_nonneg : 0 ≤ holderSeminormOn α_d (gradient w) B12 :=
      Real.sSup_nonneg (by rintro _ ⟨x, _, y, _, _, rfl⟩; exact div_nonneg (norm_nonneg _) (Real.rpow_nonneg (norm_nonneg _) _))
    have h_sup_u_mem : ∀ a ∈ (fun x => ‖gradient u x‖) '' B12, a ≤ M * supNormOn (gradient w) B12 := by
      rintro _ ⟨x, hx, rfl⟩
      dsimp
      rw [hu_grad x hx, norm_smul, Real.norm_eq_abs, abs_of_pos hM_pos]
      exact mul_le_mul_of_nonneg_left (le_csSup hw_grad_bdd ⟨x, hx, rfl⟩) (le_of_lt hM_pos)
    have h_hold_u_mem : ∀ q ∈ { q : ℝ | ∃ x ∈ B12, ∃ y ∈ B12, x ≠ y ∧
        q = ‖gradient u x - gradient u y‖ / ‖x - y‖ ^ α_d },
        q ≤ M * holderSeminormOn α_d (gradient w) B12 := by
      rintro _ ⟨x, hx, y, hy, hxy, rfl⟩
      rw [hu_grad x hx, hu_grad y hy, ← smul_sub, norm_smul, Real.norm_eq_abs, abs_of_pos hM_pos, mul_div_assoc]
      exact mul_le_mul_of_nonneg_left (le_csSup hw_hold_bdd ⟨x, hx, y, hy, hxy, rfl⟩) (le_of_lt hM_pos)
    refine ⟨⟨hu_diff, hu_bdd12, ⟨M * supNormOn (gradient w) B12, h_sup_u_mem⟩,
      ⟨M * holderSeminormOn α_d (gradient w) B12, h_hold_u_mem⟩⟩, ?_⟩
    have h_sup_u_le : supNormOn (gradient u) B12 ≤ M * supNormOn (gradient w) B12 :=
      Real.sSup_le h_sup_u_mem (mul_nonneg (le_of_lt hM_pos) h_sup_w_nonneg)
    have h_hold_u_le : holderSeminormOn α_d (gradient u) B12 ≤ M * holderSeminormOn α_d (gradient w) B12 :=
      Real.sSup_le h_hold_u_mem (mul_nonneg (le_of_lt hM_pos) h_hold_w_nonneg)
    have h_mul_est : M * (supNormOn (gradient w) B12 + holderSeminormOn α_d (gradient w) B12) ≤ M * C_d :=
      mul_le_mul_of_nonneg_left hw_est (le_of_lt hM_pos)
    change supNormOn (gradient u) B12 + holderSeminormOn α_d (gradient u) B12 ≤ C_d * M
    linarith

theorem OAI_377 (d : ℕ) (hd : 3 ≤ d) :
    ∃ (α_d C_d : ℝ),
      0 < α_d ∧ α_d ≤ 1 / 3 ∧ 0 ≤ C_d ∧
      ∀ u : EuclideanSpace ℝ (Fin d) → ℝ,
        Bornology.IsBounded (u '' Metric.ball 0 1) →
        IsInfinityHarmonicOn u (Metric.ball 0 1) →
        MemC1HolderOn α_d u (Metric.ball 0 (1 / 2)) ∧
        supNormOn (gradient u) (Metric.ball 0 (1 / 2)) +
          holderSeminormOn α_d (gradient u) (Metric.ball 0 (1 / 2)) ≤
            C_d * oscOn u (Metric.ball 0 1) :=
by
  have h_decay : ∃ B γ s₀ : ℝ, HasUniformCylinderPowerDecay d B γ s₀ := by
    by_contra h_no_decay
    obtain ⟨v, hv_class, hv_nonaff⟩ := nonaffine_limit_of_no_power_decay d hd h_no_decay
    have h256 : (0 : ℝ) ≤ 256 := by norm_num
    exact hv_nonaff (liouville_limiting_class d hd 256 h256 v hv_class)
  obtain ⟨B, γ, s₀, hBγs₀⟩ := h_decay
  obtain ⟨α_d, C_d, hα_pos, hα_le, hC_nonneg, h_norm⟩ :=
    c1_holder_of_normalized_of_power_decay d hd B γ s₀ hBγs₀
  exact ⟨α_d, C_d, hα_pos, hα_le, hC_nonneg,
    fun u hbdd hhar => c1_holder_scaling_reduction d hd α_d C_d hα_pos hα_le hC_nonneg h_norm u hbdd hhar⟩
