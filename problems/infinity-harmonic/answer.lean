      linarith
    have h_ak_abs := abs_le.mp h_ak_ell
    have h_pk_sq_ell : |(‖p k‖ ^ 2 / 2) * ℓ| ≤ (1 / 2 : ℝ) * ‖p k‖ * (2 : ℝ) ^ n := by
      rw [abs_mul, abs_of_nonneg (by positivity)]
      have h1 : (‖p k‖ ^ 2 / 2) * |ℓ| = (1 / 2 : ℝ) * ‖p k‖ * (|ℓ| * ‖p k‖) := by ring
      rw [h1]
