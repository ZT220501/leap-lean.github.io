  have hu_sub : u - α • n_hat = u_sh := by
    rw [← hu_decomp, add_sub_cancel_left]
  have hu_sh_norm : ‖u_sh‖ ≤ Real.sqrt lam * S := by
    dsimp [u_sh]
    rw [h_norm_mk_zero, norm_smul, Real.norm_of_nonneg (le_of_lt hsqrt_pos)]
