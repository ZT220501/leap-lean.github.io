    have hK_le_n : K_req ≤ (8 / 5 : ℝ) ^ n := le_trans hK_le_k0 h85_mono
    have h54_pos : (0 : ℝ) ≤ (5 / 4 : ℝ) ^ n := by positivity
    have h_mul : K_req * (5 / 4 : ℝ) ^ n ≤ (8 / 5 : ℝ) ^ n * (5 / 4 : ℝ) ^ n :=
