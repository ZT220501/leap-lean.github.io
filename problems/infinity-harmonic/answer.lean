  have h_sqrt_le_18 : Real.sqrt lam ≤ 1 / 8 := by
    have h1 : lam ≤ (1 / 8 : ℝ) ^ 2 := by linarith
    exact (Real.sqrt_le_sqrt h1).trans (by norm_num)
  have h_sqrt_le_32 : Real.sqrt lam ≤ Real.sqrt (32 * lam) :=
    Real.sqrt_le_sqrt (by linarith)
  have h_inner_u_n : inner ℝ u n_hat = α + inner ℝ u_sh n_hat := by
    rw [← hu_decomp, inner_add_left, real_inner_smul_left, real_inner_self_eq_norm_mul_norm,
