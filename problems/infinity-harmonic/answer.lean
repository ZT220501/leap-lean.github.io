  have h_ax_u : |inner ℝ u n_hat| ≤ S := by
    rw [h_inner_u_n]
    have h_tri := abs_add_le α (inner ℝ u_sh n_hat)
    linarith
  have h_trans_u : ‖u - (inner ℝ u n_hat) • n_hat‖ ≤ Real.sqrt (32 * lam) * S := by
    have h_sq_diff : ‖u - α • n_hat‖ ^ 2 - ‖u - (inner ℝ u n_hat) • n_hat‖ ^ 2 =
