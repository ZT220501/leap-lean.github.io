    rw [projTime_mkSpaceTime] at h_bary_le ⊢
    linarith
  have h_quad_mid_le : quadEnvelopePlus d ε W (mkSpaceTime x_mid t) ≤ U := by
    unfold quadEnvelopePlus
    rw [projTime_mkSpaceTime, projSpace_mkSpaceTime]
    apply csSup_le
    · refine ⟨W (mkSpaceTime x_mid (t + ε)) - ‖x_mid - x_mid‖ ^ 2 / (2 * ε),
        ⟨x_mid, Set.mem_univ x_mid, rfl⟩⟩
    · rintro val ⟨y_mid, -, rfl⟩
      exact h_ymid_le y_mid
  dsimp [U, x_left, x_mid, x_right, C_pen] at h_quad_mid_le
  linarith

theorem midpoint_path_convexity_of_envelopes (d : ℕ) (hd : 3 ≤ d) (C₁ : ℝ) (hC₁ : 1 ≤ C₁)
    (κ : ℝ) (hκ : 0 < κ) (v : EuclideanSpace ℝ (Fin (d + 1)) → ℝ)
    (hv_class : InLimitingClassA d C₁ v)
    (hv_jensen : HasHorizontalJensenBound d κ v)
    (h_growth : ∀ (t₁ t₂ η : ℝ), 0 < η →
      ∃ M : ℝ, ∀ (y : EuclideanSpace ℝ (Fin d)) (s : ℝ),
        t₁ ≤ s → s ≤ t₂ → |v (mkSpaceTime y s)| ≤ M + η * ‖y‖ ^ 2)
    (x b d_shift : EuclideanSpace ℝ (Fin d)) (t ε : ℝ) (hε : 0 < ε) (ht : ε < t) :
    let W := shiftedBarycentricEnvelope d κ v
    v (mkSpaceTime x t) + quadEnvelopeMinus d (2 * ε) v (mkSpaceTime x t) ≤
      2 * quadEnvelopeMinus d ε v (mkSpaceTime x t) ∧
    W (mkSpaceTime (x + d_shift) t) +
      quadEnvelopePlus d (2 * ε) W (mkSpaceTime (x + b) t) -
      2 * quadEnvelopePlus d ε W (mkSpaceTime (x + (1 / 2 : ℝ) • (b + d_shift)) t) ≥
        -(Real.log 2 / (2 * ε)) * ‖b - d_shift‖ ^ 2 :=
by
  have _hd : 3 ≤ d := hd
  have hC₁_nonneg : (0 : ℝ) ≤ C₁ := by linarith
  obtain ⟨h_comp, h_attain, h_mono⟩ :=
    envelope_attainment_and_slope_monotonicity d C₁ hC₁_nonneg v hv_class h_growth
  refine ⟨?_, ?_⟩
  · have h_m := (h_mono x t ε (2 * ε) hε (by linarith)).2
    dsimp [slopeMinus] at h_m
    have h_ne : ε ≠ 0 := ne_of_gt hε
    have h_clear : 2 * (v (mkSpaceTime x t) - quadEnvelopeMinus d ε v (mkSpaceTime x t)) ≤
        v (mkSpaceTime x t) - quadEnvelopeMinus d (2 * ε) v (mkSpaceTime x t) := by
      have h_mul := mul_le_mul_of_nonneg_left h_m (by positivity : (0 : ℝ) ≤ 2 * ε)
      have h_lhs : 2 * ε * ((v (mkSpaceTime x t) - quadEnvelopeMinus d ε v (mkSpaceTime x t)) / ε) =
          2 * (v (mkSpaceTime x t) - quadEnvelopeMinus d ε v (mkSpaceTime x t)) := by
        field_simp [h_ne]
      have h_rhs : 2 * ε * ((v (mkSpaceTime x t) - quadEnvelopeMinus d (2 * ε) v (mkSpaceTime x t)) / (2 * ε)) =
          v (mkSpaceTime x t) - quadEnvelopeMinus d (2 * ε) v (mkSpaceTime x t) := by
        field_simp [h_ne]
      linarith
    linarith
  · exact barycentric_transfer_of_midpoint_path_convexity d κ hκ v hv_jensen h_growth
      (fun x' y' t' ℓ' hℓ' => (h_comp x' y' t' ℓ' hℓ').1)
      (fun x' t' ℓ' hℓ' => (h_attain x' t' ℓ' hℓ').1)
      x b d_shift t ε hε ht
      (fun x₀ => midpoint_path_convexity_of_quadEnvelopePlus d C₁ hC₁_nonneg v hv_class h_growth
        (movingParabolicTestFunc_contDiffOn_and_limitingOperator d)
        x₀ ((2 * ε)⁻¹ • (b - d_shift)) t ε hε)

theorem existence_of_drift_step_selectors (d : ℕ) (hd : 3 ≤ d) (C₁ : ℝ) (hC₁ : 1 ≤ C₁)
    (κ : ℝ) (hκ : 0 < κ) (v : EuclideanSpace ℝ (Fin (d + 1)) → ℝ)
    (hv_class : InLimitingClassA d C₁ v)
    (hv_cent : IsCenteredAt d C₁ v 0 1)
    (hv_jensen : HasHorizontalJensenBound d κ v) :
    ∃ (Q_plus Q_minus Q_zero : EuclideanSpace ℝ (Fin d) → ℝ → ℝ → EuclideanSpace ℝ (Fin d)),
      (∀ (x : EuclideanSpace ℝ (Fin d)) (t ε : ℝ), 0 < ε → ε < t →
        IsOptimizingStepTriple d κ ε v x t (Q_plus x t ε) (Q_minus x t ε) (Q_zero x t ε) ∧
        (driftFunctional d κ ε v (mkSpaceTime (x + ε • Q_plus x t ε) (t + ε)) +
          driftFunctional d κ ε v (mkSpaceTime (x - ε • Q_minus x t ε) (t - ε))) / 2 -
          driftFunctional d κ ε v (mkSpaceTime x t) ≥
            (1 / (16 * (1 + Real.log 2))) *
              (‖Q_plus x t ε - Q_zero x t ε‖ ^ 2 + ‖Q_minus x t ε - Q_zero x t ε‖ ^ 2)) ∧
      (∀ (R T : ℝ), 2 ≤ R → 2 ≤ T →
        ∃ ε₀ : ℝ, 0 < ε₀ ∧
          ∀ (ε : ℝ) (x : EuclideanSpace ℝ (Fin d)) (t : ℝ),
            0 < ε → ε ≤ ε₀ → ‖x‖ ≤ R → ε < t → t ≤ T →
            ‖ε • Q_plus x t ε‖ ≤ 1 ∧ ‖ε • Q_minus x t ε‖ ≤ 1) :=
by
  have _hv0 : v (mkSpaceTime 0 1) = 0 := hv_cent.1
  have hC₁_nonneg : (0 : ℝ) ≤ C₁ := by linarith
  have h_growth : ∀ (t₁ t₂ η : ℝ), 0 < η →
      ∃ M : ℝ, ∀ (y : EuclideanSpace ℝ (Fin d)) (s : ℝ),
        t₁ ≤ s → s ≤ t₂ → |v (mkSpaceTime y s)| ≤ M + η * ‖y‖ ^ 2 :=
    subquadratic_growth_of_inLimitingClassA d C₁ hC₁_nonneg v hv_class
  obtain ⟨h_comp, Q_plus, Q_minus, Q_zero, hQ_opt, hQ_step⟩ :=
    existence_of_optimizing_step_triple_and_small_steps d κ hκ v hv_class.1 hv_jensen h_growth
  refine ⟨Q_plus, Q_minus, Q_zero, ?_, hQ_step⟩
  intro x t ε hε ht
  have h_opt := hQ_opt x t ε hε ht
  refine ⟨h_opt, ?_⟩
  let W : EuclideanSpace ℝ (Fin (d + 1)) → ℝ := shiftedBarycentricEnvelope d κ v
  let Qp : EuclideanSpace ℝ (Fin d) := Q_plus x t ε
  let Qm : EuclideanSpace ℝ (Fin d) := Q_minus x t ε
  let Q0 : EuclideanSpace ℝ (Fin d) := Q_zero x t ε
  let z : EuclideanSpace ℝ (Fin (d + 1)) := mkSpaceTime x t
  let z_plus : EuclideanSpace ℝ (Fin (d + 1)) := mkSpaceTime (x + ε • Qp) (t + ε)
  let z_minus : EuclideanSpace ℝ (Fin (d + 1)) := mkSpaceTime (x - ε • Qm) (t - ε)
  have ht_pos : 0 < t := by linarith
  have ht_plus_pos : 0 < t + ε := by linarith
  have ht_minus_pos : 0 < t - ε := by linarith
  have h2ε_pos : 0 < 2 * ε := by linarith
  have hlog2_pos : 0 < Real.log 2 := Real.log_pos (by norm_num)
  have h1log2_pos : 0 < 1 + Real.log 2 := by linarith
  let c₀ : ℝ := ε / (2 * (1 + Real.log 2))
  have hc₀_pos : 0 < c₀ := div_pos hε (by linarith)
  let b : EuclideanSpace ℝ (Fin d) := c₀ • (Q0 - Qp)
  let d_shift : EuclideanSpace ℝ (Fin d) := c₀ • (Q0 - Qm)
  have hQ0_eq : W (mkSpaceTime (x + ε • Q0) (t + ε)) - (ε / 2) * ‖Q0‖ ^ 2 =
      quadEnvelopePlus d ε W z := h_opt.1
  have hQp_eq : W (mkSpaceTime (x + (2 * ε) • Qp) (t + 2 * ε)) - ε * ‖Qp‖ ^ 2 =
      quadEnvelopePlus d (2 * ε) W z := h_opt.2.1
  have hQm_eq : v (mkSpaceTime (x - (2 * ε) • Qm) (t - 2 * ε)) + ε * ‖Qm‖ ^ 2 =
      quadEnvelopeMinus d (2 * ε) v z := h_opt.2.2
  
  have h_comp1_raw := (h_comp (x + ε • Qp) (x + (2 * ε) • Qp) (t + ε) ε ht_plus_pos hε).1
  have h_time1 : (t + ε) + ε = t + 2 * ε := by ring
  have h_diff1 : (x + (2 * ε) • Qp) - (x + ε • Qp) = ε • Qp := by
    rw [add_sub_add_left_eq_sub, ← sub_smul]
    ring_nf
  have h_norm1 : ‖(x + (2 * ε) • Qp) - (x + ε • Qp)‖ ^ 2 / (2 * ε) = (ε / 2) * ‖Qp‖ ^ 2 := by
    rw [h_diff1, norm_smul, Real.norm_eq_abs, abs_of_pos hε, mul_pow]
    field_simp [ne_of_gt hε]
  have h_ineq1 : quadEnvelopePlus d (2 * ε) W z + (ε / 2) * ‖Qp‖ ^ 2 ≤
      quadEnvelopePlus d ε W z_plus := by
    rw [h_time1, h_norm1] at h_comp1_raw
    linarith [hQp_eq, h_comp1_raw]
  
  have h_comp2_raw := (h_comp (x - ε • Qm) (x + d_shift) (t - ε) ε ht_minus_pos hε).1
  have h_time2 : (t - ε) + ε = t := by ring
  have h_diff2 : (x + d_shift) - (x - ε • Qm) = d_shift + ε • Qm := by abel
  have h_norm2 : ‖(x + d_shift) - (x - ε • Qm)‖ ^ 2 / (2 * ε) =
      ‖d_shift‖ ^ 2 / (2 * ε) + inner ℝ Qm d_shift + (ε / 2) * ‖Qm‖ ^ 2 := by
    rw [h_diff2, norm_add_sq_real, norm_smul ε Qm, Real.norm_eq_abs, abs_of_pos hε, mul_pow,
      real_inner_smul_right, real_inner_comm d_shift Qm]
    field_simp [ne_of_gt hε]
  have h_ineq2 : W (mkSpaceTime (x + d_shift) t) - inner ℝ Qm d_shift -
      ‖d_shift‖ ^ 2 / (2 * ε) - (ε / 2) * ‖Qm‖ ^ 2 ≤
      quadEnvelopePlus d ε W z_minus := by
    rw [h_time2, h_norm2] at h_comp2_raw
    linarith [h_comp2_raw]
  
  have h_comp3_raw := (h_comp (x + ε • Qp) x (t + ε) ε ht_plus_pos hε).2
  have h_time3 : (t + ε) - ε = t := by ring
  have h_diff3 : x - (x + ε • Qp) = -(ε • Qp) := by abel
  have h_norm3 : ‖x - (x + ε • Qp)‖ ^ 2 / (2 * ε) = (ε / 2) * ‖Qp‖ ^ 2 := by
    rw [h_diff3, norm_neg, norm_smul, Real.norm_eq_abs, abs_of_pos hε, mul_pow]
    field_simp [ne_of_gt hε]
  have h_ineq3 : quadEnvelopeMinus d ε v z_plus ≤ v z + (ε / 2) * ‖Qp‖ ^ 2 := by
    rw [h_time3, h_norm3] at h_comp3_raw
    exact h_comp3_raw
  
  have h_comp4_raw := (h_comp (x - ε • Qm) (x - (2 * ε) • Qm) (t - ε) ε ht_minus_pos hε).2
  have h_time4 : (t - ε) - ε = t - 2 * ε := by ring
  have h_diff4 : (x - (2 * ε) • Qm) - (x - ε • Qm) = -(ε • Qm) := by
    rw [sub_sub_sub_cancel_left, ← sub_smul]
    have h_sc : ε - 2 * ε = -ε := by ring
    rw [h_sc, neg_smul]
  have h_norm4 : ‖(x - (2 * ε) • Qm) - (x - ε • Qm)‖ ^ 2 / (2 * ε) = (ε / 2) * ‖Qm‖ ^ 2 := by
    rw [h_diff4, norm_neg, norm_smul, Real.norm_eq_abs, abs_of_pos hε, mul_pow]
    field_simp [ne_of_gt hε]
  have h_ineq4 : quadEnvelopeMinus d ε v z_minus ≤
      quadEnvelopeMinus d (2 * ε) v z - (ε / 2) * ‖Qm‖ ^ 2 := by
    rw [h_time4, h_norm4] at h_comp4_raw
    linarith [hQm_eq, h_comp4_raw]
  
  have hQp_eq' : W (mkSpaceTime (x + (2 * ε) • Qp) (t + 2 * ε)) - (2 * ε / 2) * ‖Qp‖ ^ 2 =
      quadEnvelopePlus d (2 * ε) W z := by
    have h_two : (2 * ε / 2) * ‖Qp‖ ^ 2 = ε * ‖Qp‖ ^ 2 := by ring
    rw [h_two]
    exact hQp_eq
  have h_supp_plus := (shifted_barycentric_envelope_supporting_bounds d κ hκ v hv_class.1
    hv_jensen h_growth x t (2 * ε) ht_pos h2ε_pos Qp hQp_eq' b).2
  have hb_t_le_ε : ‖b‖ ^ 2 / (2 * t) ≤ ‖b‖ ^ 2 / (2 * ε) := by
    apply div_le_div_of_nonneg_left (sq_nonneg ‖b‖) (by positivity) (by linarith)
  have h_ineq5 : quadEnvelopePlus d (2 * ε) W (mkSpaceTime (x + b) t) -
      inner ℝ Qp b - ‖b‖ ^ 2 / (2 * ε) ≤ quadEnvelopePlus d (2 * ε) W z := by
    linarith [h_supp_plus, hb_t_le_ε]
  
  have h_supp_zero := (shifted_barycentric_envelope_supporting_bounds d κ hκ v hv_class.1
    hv_jensen h_growth x t ε ht_pos hε Q0 hQ0_eq ((1 / 2 : ℝ) • (b + d_shift))).1
  have h_inner_mid : 2 * inner ℝ Q0 ((1 / 2 : ℝ) • (b + d_shift)) =
      inner ℝ Q0 b + inner ℝ Q0 d_shift := by
    rw [real_inner_smul_right, inner_add_right]
    ring
  have h_para : ‖b + d_shift‖ ^ 2 + ‖b - d_shift‖ ^ 2 = 2 * (‖b‖ ^ 2 + ‖d_shift‖ ^ 2) := by
    rw [norm_add_sq_real, norm_sub_sq_real]
    ring
  have h_mid_sq : ‖(1 / 2 : ℝ) • (b + d_shift)‖ ^ 2 ≤ (1 / 2 : ℝ) * (‖b‖ ^ 2 + ‖d_shift‖ ^ 2) := by
    rw [norm_smul, Real.norm_eq_abs, abs_of_pos (by norm_num : (0 : ℝ) < 1 / 2), mul_pow]
    have h_nonneg : 0 ≤ ‖b - d_shift‖ ^ 2 := sq_nonneg _
    linarith
  have h_mid_div : 2 * (‖(1 / 2 : ℝ) • (b + d_shift)‖ ^ 2 / (2 * ε)) ≤
      (‖b‖ ^ 2 + ‖d_shift‖ ^ 2) / (2 * ε) := by
    have h_div := div_le_div_of_nonneg_right h_mid_sq (by positivity : (0 : ℝ) ≤ 2 * ε)
    have h_eq : 2 * ((1 / 2 : ℝ) * (‖b‖ ^ 2 + ‖d_shift‖ ^ 2) / (2 * ε)) =
        (‖b‖ ^ 2 + ‖d_shift‖ ^ 2) / (2 * ε) := by ring
    linarith
  have h_ineq6 : 2 * quadEnvelopePlus d ε W z + inner ℝ Q0 b + inner ℝ Q0 d_shift -
      (‖b‖ ^ 2 + ‖d_shift‖ ^ 2) / (2 * ε) ≤
      2 * quadEnvelopePlus d ε W (mkSpaceTime (x + (1 / 2 : ℝ) • (b + d_shift)) t) := by
    linarith [h_supp_zero, h_inner_mid, h_mid_div]
  
  have h_mid_conv := midpoint_path_convexity_of_envelopes d hd C₁ hC₁ κ hκ v hv_class
    hv_jensen h_growth x b d_shift t ε hε ht
  have h_ineq7 : v z + quadEnvelopeMinus d (2 * ε) v z ≤ 2 * quadEnvelopeMinus d ε v z :=
    h_mid_conv.1
  have h_diff_sq_le : ‖b - d_shift‖ ^ 2 ≤ 2 * (‖b‖ ^ 2 + ‖d_shift‖ ^ 2) := by
    have h_nonneg : 0 ≤ ‖b + d_shift‖ ^ 2 := sq_nonneg _
    linarith [h_para]
  have h_log_pen : (Real.log 2 / (2 * ε)) * ‖b - d_shift‖ ^ 2 ≤
      (Real.log 2 / ε) * (‖b‖ ^ 2 + ‖d_shift‖ ^ 2) := by
    have h_mul := mul_le_mul_of_nonneg_left h_diff_sq_le
      (div_nonneg (le_of_lt hlog2_pos) (by positivity : (0 : ℝ) ≤ 2 * ε))
    have h_eq : (Real.log 2 / (2 * ε)) * (2 * (‖b‖ ^ 2 + ‖d_shift‖ ^ 2)) =
        (Real.log 2 / ε) * (‖b‖ ^ 2 + ‖d_shift‖ ^ 2) := by
      field_simp [ne_of_gt hε]
    linarith
  have h_ineq8 : -(Real.log 2 / ε) * (‖b‖ ^ 2 + ‖d_shift‖ ^ 2) ≤
      W (mkSpaceTime (x + d_shift) t) +
        quadEnvelopePlus d (2 * ε) W (mkSpaceTime (x + b) t) -
        2 * quadEnvelopePlus d ε W (mkSpaceTime (x + (1 / 2 : ℝ) • (b + d_shift)) t) := by
    linarith [h_mid_conv.2, h_log_pen]
  
  have h_inner_b : inner ℝ Q0 b - inner ℝ Qp b = c₀ * ‖Qp - Q0‖ ^ 2 := by
    rw [← inner_sub_left]
    dsimp [b]
    rw [real_inner_smul_right, real_inner_self_eq_norm_sq, norm_sub_rev]
  have h_inner_d : inner ℝ Q0 d_shift - inner ℝ Qm d_shift = c₀ * ‖Qm - Q0‖ ^ 2 := by
    rw [← inner_sub_left]
    dsimp [d_shift]
    rw [real_inner_smul_right, real_inner_self_eq_norm_sq, norm_sub_rev]
  have hb_norm_sq : ‖b‖ ^ 2 = c₀ ^ 2 * ‖Qp - Q0‖ ^ 2 := by
    dsimp [b]
    rw [norm_smul, Real.norm_eq_abs, abs_of_pos hc₀_pos, mul_pow, norm_sub_rev]
  have hd_norm_sq : ‖d_shift‖ ^ 2 = c₀ ^ 2 * ‖Qm - Q0‖ ^ 2 := by
    dsimp [d_shift]
    rw [norm_smul, Real.norm_eq_abs, abs_of_pos hc₀_pos, mul_pow, norm_sub_rev]
  have h_quad_opt :
      (inner ℝ Q0 b - inner ℝ Qp b) + (inner ℝ Q0 d_shift - inner ℝ Qm d_shift) -
        ‖d_shift‖ ^ 2 / (2 * ε) - ‖b‖ ^ 2 / (2 * ε) -
        (‖b‖ ^ 2 + ‖d_shift‖ ^ 2) / (2 * ε) -
        (Real.log 2 / ε) * (‖b‖ ^ 2 + ‖d_shift‖ ^ 2) =
      (ε / (4 * (1 + Real.log 2))) * (‖Qp - Q0‖ ^ 2 + ‖Qm - Q0‖ ^ 2) := by
    rw [h_inner_b, h_inner_d, hb_norm_sq, hd_norm_sq]
    dsimp [c₀]
    field_simp [ne_of_gt hε, ne_of_gt h1log2_pos]
    ring
  have h_4ε_drift :
      (quadEnvelopePlus d ε W z_plus + quadEnvelopePlus d ε W z_minus -
        2 * quadEnvelopePlus d ε W z) -
      (quadEnvelopeMinus d ε v z_plus + quadEnvelopeMinus d ε v z_minus -
        2 * quadEnvelopeMinus d ε v z) ≥
      (ε / (4 * (1 + Real.log 2))) * (‖Qp - Q0‖ ^ 2 + ‖Qm - Q0‖ ^ 2) := by
    linarith [h_ineq1, h_ineq2, h_ineq3, h_ineq4, h_ineq5, h_ineq6, h_ineq7, h_ineq8, h_quad_opt]
  have h_drift_id :
      (driftFunctional d κ ε v z_plus + driftFunctional d κ ε v z_minus) / 2 -
        driftFunctional d κ ε v z =
      ((quadEnvelopePlus d ε W z_plus + quadEnvelopePlus d ε W z_minus -
        2 * quadEnvelopePlus d ε W z) -
      (quadEnvelopeMinus d ε v z_plus + quadEnvelopeMinus d ε v z_minus -
        2 * quadEnvelopeMinus d ε v z)) / (4 * ε) := by
    dsimp [driftFunctional, W]
    field_simp [ne_of_gt hε]
    ring
  have h_rhs_id :
      ((ε / (4 * (1 + Real.log 2))) * (‖Qp - Q0‖ ^ 2 + ‖Qm - Q0‖ ^ 2)) / (4 * ε) =
      (1 / (16 * (1 + Real.log 2))) * (‖Qp - Q0‖ ^ 2 + ‖Qm - Q0‖ ^ 2) := by
    field_simp [ne_of_gt hε, ne_of_gt h1log2_pos]
    ring
  have h_div_final := div_le_div_of_nonneg_right h_4ε_drift (by positivity : (0 : ℝ) ≤ 4 * ε)
  linarith [h_drift_id, h_rhs_id, h_div_final]

theorem same_center_and_box_fit_bounds (d : ℕ) (C₁ : ℝ) (hC₁ : 1 ≤ C₁)
    (v : EuclideanSpace ℝ (Fin (d + 1)) → ℝ) (hv_class : InLimitingClassA d C₁ v) :
    ∃ (C_shift C_box : ℝ), 0 < C_shift ∧ 0 < C_box ∧
      (∀ (r : ℝ) (x₀ p₀ : EuclideanSpace ℝ (Fin d)) (a₀ : ℝ),
        0 < r → IsFitAt d C₁ v x₀ r r p₀ a₀ →
        ∀ (K τ : ℝ) (x_tilde p_fit : EuclideanSpace ℝ (Fin d)) (a_fit : ℝ),
          2 ≤ K → 0 < τ → τ ≤ 2 * K * r →
          ‖x_tilde - x₀ - (τ - r) • p₀‖ ≤ K * r →
          IsFitAt d C₁ v x_tilde τ τ p_fit a_fit →
          ‖p_fit - p₀‖ ≤ C_shift * (1 + Real.log K + |Real.log (τ / r)|)) ∧
      (IsCenteredAt d C₁ v 0 1 →
        ∀ (K : ℝ) (z : EuclideanSpace ℝ (Fin d)) (s : ℝ),
          2 ≤ K → ‖z‖ ≤ K → |s - 1| ≤ K →
          |v (mkSpaceTime z s)| ≤ C_box * K * (1 + Real.log K) ^ 2) :=
by
  have h_one_step : ∀ (x_c : EuclideanSpace ℝ (Fin d)) (t_c r₁ r₂ : ℝ)
      (p₁ p₂ : EuclideanSpace ℝ (Fin d)) (a₁ a₂ : ℝ),
      0 < r₁ → r₁ ≤ r₂ → r₂ ≤ 2 * r₁ →
      IsFitAt d C₁ v x_c t_c r₁ p₁ a₁ →
      IsFitAt d C₁ v x_c t_c r₂ p₂ a₂ →
      ‖p₁ - p₂‖ + |a₁ - a₂| ≤ 20 * C₁ ^ 2 := by
    intro x_c t_c r₁ r₂ p₁ p₂ a₁ a₂ hr₁ hr₁₂ hr₂₁ hfit₁ hfit₂
    have hp_bound : ‖p₁ - p₂‖ ≤ 3 * C₁ := by
      by_cases hp0 : ‖p₁ - p₂‖ = 0
      · linarith
      · have hp_pos : 0 < ‖p₁ - p₂‖ := lt_of_le_of_ne (norm_nonneg _) (Ne.symm hp0)
        let h : EuclideanSpace ℝ (Fin d) := (r₁ / ‖p₁ - p₂‖) • (p₁ - p₂)
        have hh_norm : ‖h‖ = r₁ := by
          dsimp [h]
          rw [norm_smul, Real.norm_eq_abs, abs_of_pos (div_pos hr₁ hp_pos),
            div_mul_cancel₀ _ (ne_of_gt hp_pos)]
        have h1 := hfit₁ h 0 (by simp [le_of_lt hr₁]) (by simp [hh_norm])
        have h2 := hfit₂ h 0 (by simp; linarith) (by simp [hh_norm, hr₁₂])
