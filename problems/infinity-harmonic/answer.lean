    have h_ev_nonpos : ∀ᶠ m in Filter.atTop, limitingOperator ψ₂ (y_seq m) ≤ 0 := by
      filter_upwards [h_ev_W] with m hym_W
      let ψ_tilde : E → ℝ := fun y => ψ₂ y + (f_seq m (y_seq m) - ψ₂ (y_seq m))
      have hψ_tilde_c2 : ContDiffOn ℝ 2 ψ_tilde W :=
        (hψ₂_c2.mono hW_sub_V).add contDiffOn_const
      have hψ_tilde_eq : ψ_tilde (y_seq m) = f_seq m (y_seq m) := by
        dsimp [ψ_tilde]; ring
      have hψ_tilde_le : ∀ y ∈ W, ψ_tilde y ≤ f_seq m y := by
        intro y hy
        have h_le := (hy_seq m).2 y (Metric.ball_subset_closedBall hy)
        dsimp [ψ_tilde]; linarith
      have h_visc := (hf_seq m).2.2.1 (y_seq m) ψ_tilde W
        Metric.isOpen_ball hym_W hψ_tilde_c2 hψ_tilde_eq hψ_tilde_le
      rwa [h_s2 ψ₂ (y_seq m) (f_seq m (y_seq m) - ψ₂ (y_seq m))] at h_visc
    have h_lim : Filter.Tendsto (fun m => limitingOperator ψ₂ (y_seq m)) Filter.atTop
        (nhds (limitingOperator ψ₂ z₀)) :=
      hψ₂_contAt.tendsto.comp hy_tendsto
    have h_z₀_nonpos : limitingOperator ψ₂ z₀ ≤ 0 := le_of_tendsto h_lim h_ev_nonpos
    rwa [hψ₂_eq] at h_z₀_nonpos
  exact ⟨hv_sub, hv_super⟩

theorem centered_class_A_compactness : ∀ (d : ℕ), 3 ≤ d → ∀ (C₁ : ℝ), 1 ≤ C₁ → HasUniformSubquadraticGrowth d C₁ →
      ∀ (K : ℝ), 0 < K →
        ∀ (w_seq : ℕ → EuclideanSpace ℝ (Fin (d + 1)) → ℝ)
          (b_seq : ℕ → EuclideanSpace ℝ (Fin d)),
          (∀ j : ℕ,
            InLimitingClassA d C₁ (w_seq j) ∧
            IsCenteredAt d C₁ (w_seq j) 0 1 ∧
            ‖b_seq j‖ ≤ K) →
          ∃ (v_inf : EuclideanSpace ℝ (Fin (d + 1)) → ℝ)
            (b : EuclideanSpace ℝ (Fin d)) (φ : ℕ → ℕ),
            StrictMono φ ∧
            InLimitingClassA d C₁ v_inf ∧
            IsCenteredAt d C₁ v_inf 0 1 ∧
            ConvergesLocUnif d (fun m => w_seq (φ m)) v_inf ∧
            Filter.Tendsto (fun m => b_seq (φ m)) Filter.atTop (nhds b) :=
by
  intro d hd C₁ hC₁ h_growth K hK w_seq b_seq h_seq
  have h_bounds : HasUniformBoxAndFitBounds d C₁ :=
    uniform_box_and_fit_bounds_of_subquadratic_growth d hd C₁ hC₁ h_growth
  have h_equi : HasUniformBoxEquicontinuity d C₁ :=
    uniform_equicontinuity_of_centered_class_A d hd C₁ hC₁ h_bounds
  obtain ⟨v_inf, b, φ, hφ, hv_cont, h_conv, hb_tendsto⟩ :=
    subseq_extraction_of_bounded_equicontinuous d hd C₁ K hK h_bounds h_equi w_seq b_seq h_seq
  obtain ⟨hv_cent, hv_fits⟩ :=
    fits_and_centering_of_loc_unif d hd C₁ hC₁ h_bounds
      (fun m => w_seq (φ m)) v_inf
      (fun m => ⟨(h_seq (φ m)).1, (h_seq (φ m)).2.1⟩) h_conv
  obtain ⟨hv_sub, hv_super⟩ :=
    viscosity_stability_of_loc_unif d C₁
      (fun m => w_seq (φ m)) v_inf
      (fun m => (h_seq (φ m)).1) h_conv
  exact ⟨v_inf, b, φ, hφ, ⟨hv_cont, hv_sub, hv_super, hv_fits⟩, hv_cent, h_conv, hb_tendsto⟩

theorem envelope_slopes_tendsto_of_loc_unif : ∀ (d : ℕ), 3 ≤ d → ∀ (C₁ : ℝ), 1 ≤ C₁ → HasUniformSubquadraticGrowth d C₁ →
      ∀ (w_seq : ℕ → EuclideanSpace ℝ (Fin (d + 1)) → ℝ)
        (v_inf : EuclideanSpace ℝ (Fin (d + 1)) → ℝ)
        (b_seq : ℕ → EuclideanSpace ℝ (Fin d)) (b : EuclideanSpace ℝ (Fin d)),
        (∀ m : ℕ, InLimitingClassA d C₁ (w_seq m) ∧ IsCenteredAt d C₁ (w_seq m) 0 1) →
        InLimitingClassA d C₁ v_inf →
        IsCenteredAt d C₁ v_inf 0 1 →
        ConvergesLocUnif d w_seq v_inf →
        Filter.Tendsto b_seq Filter.atTop (nhds b) →
        ∀ (ℓ : ℝ), 0 < ℓ →
          Filter.Tendsto
            (fun m => slopePlus d ℓ (w_seq m) (mkSpaceTime (b_seq m) 0))
            Filter.atTop (nhds (slopePlus d ℓ v_inf (mkSpaceTime b 0))) ∧
          Filter.Tendsto
            (fun m => slopeMinus d ℓ (w_seq m) (mkSpaceTime (b_seq m) 0))
            Filter.atTop (nhds (slopeMinus d ℓ v_inf (mkSpaceTime b 0))) :=
by
  intro d hd C₁ hC₁ h_growth w_seq v_inf b_seq b hw_seq hv_inf_class hv_inf_cent h_conv hb_tendsto ℓ hℓ
  have h_projSpace : ∀ (x : EuclideanSpace ℝ (Fin d)) (t : ℝ), projSpace (mkSpaceTime x t) = x := by
    intro x t
    ext i
    simp [projSpace, mkSpaceTime]
  have h_projTime : ∀ (x : EuclideanSpace ℝ (Fin d)) (t : ℝ), projTime (mkSpaceTime x t) = t := by
    intro x t
    simp [projTime, mkSpaceTime]
  have h_cont_mk : ∀ (t : ℝ), Continuous (fun y : EuclideanSpace ℝ (Fin d) => mkSpaceTime y t) := by
    intro t
    unfold mkSpaceTime
    apply (EuclideanSpace.equiv (Fin (d + 1)) ℝ).symm.continuous.comp
    apply continuous_pi
    intro j
    refine Fin.lastCases ?_ ?_ j
    · simp only [Fin.snoc_last]
      exact continuous_const
    · intro i
      simp only [Fin.snoc_castSucc]
      exact (continuous_apply i).comp (EuclideanSpace.equiv (Fin d) ℝ).continuous
  have h_eval_zero :
      Filter.Tendsto (fun m => w_seq m (mkSpaceTime (b_seq m) 0))
        Filter.atTop (nhds (v_inf (mkSpaceTime b 0))) := by
    have h_v_tendsto :
        Filter.Tendsto (fun m => v_inf (mkSpaceTime (b_seq m) 0))
          Filter.atTop (nhds (v_inf (mkSpaceTime b 0))) :=
      ((hv_inf_class.1.comp (h_cont_mk 0)).tendsto b).comp hb_tendsto
    have h_diff_tendsto :
        Filter.Tendsto (fun m => w_seq m (mkSpaceTime (b_seq m) 0) - v_inf (mkSpaceTime (b_seq m) 0))
          Filter.atTop (nhds 0) := by
      rw [Metric.tendsto_atTop]
      intro ε hε
      obtain ⟨N₁, hN₁⟩ := Metric.tendsto_atTop.mp hb_tendsto 1 zero_lt_one
      have hRb_pos : 0 < ‖b‖ + 1 := by positivity
      obtain ⟨N₂, hN₂⟩ := h_conv (‖b‖ + 1) hRb_pos (ε / 2) (half_pos hε)
      refine ⟨max N₁ N₂, fun m hm => ?_⟩
      have hm₁ : N₁ ≤ m := le_trans (le_max_left N₁ N₂) hm
      have hm₂ : N₂ ≤ m := le_trans (le_max_right N₁ N₂) hm
      have hb_dist : ‖b_seq m - b‖ < 1 := by
        simpa [dist_eq_norm] using hN₁ m hm₁
      have hb_norm : ‖b_seq m‖ ≤ ‖b‖ + 1 := by
        have h_tri : ‖b_seq m‖ ≤ ‖b_seq m - b‖ + ‖b‖ := by
          simpa using norm_add_le (b_seq m - b) b
        linarith
      have h_bound := hN₂ m hm₂ (mkSpaceTime (b_seq m) 0)
        (by rw [h_projSpace]; exact hb_norm)
        (by rw [h_projTime, abs_zero]; positivity)
      rw [Real.dist_eq, sub_zero]
      linarith
    simpa using h_diff_tendsto.add h_v_tendsto
  have h_sup_tendsto :
      ∀ (σ t : ℝ), |σ| = 1 → |t| ≤ ℓ →
        Filter.Tendsto
          (fun m => sSup ((fun y : EuclideanSpace ℝ (Fin d) =>
            σ * w_seq m (mkSpaceTime y t) - ‖y - b_seq m‖ ^ 2 / (2 * ℓ)) '' Set.univ))
          Filter.atTop
          (nhds (sSup ((fun y : EuclideanSpace ℝ (Fin d) =>
            σ * v_inf (mkSpaceTime y t) - ‖y - b‖ ^ 2 / (2 * ℓ)) '' Set.univ))) := by
    intro σ t hσ ht
    let Φ : (EuclideanSpace ℝ (Fin (d + 1)) → ℝ) → EuclideanSpace ℝ (Fin d) → EuclideanSpace ℝ (Fin d) → ℝ :=
      fun f x y => σ * f (mkSpaceTime y t) - ‖y - x‖ ^ 2 / (2 * ℓ)
    have hε_growth : 0 < 1 / (8 * ℓ) := by positivity
    obtain ⟨M, hM_pos, hM_bound⟩ := h_growth ℓ (le_of_lt hℓ) (1 / (8 * ℓ)) hε_growth
    let R_b : ℝ := ‖b‖ + 1
    let U₀ : ℝ := |v_inf (mkSpaceTime 0 t)| + 1
    let R_star : ℝ := M + R_b + 8 * ℓ * U₀ + 8 * R_b ^ 2 + 1
    let K : Set (EuclideanSpace ℝ (Fin d)) := Metric.closedBall 0 R_star
    have hRb_nonneg : 0 ≤ R_b := by positivity
    have hU₀_nonneg : 0 ≤ U₀ := by positivity
    have hR_ge_one : 1 ≤ R_star := by
      have : 0 ≤ M + R_b + 8 * ℓ * U₀ + 8 * R_b ^ 2 := by positivity
      linarith
    have hR_pos : 0 < R_star := by linarith
    have hM_le_R : M ≤ R_star := by
      have : 0 ≤ R_b + 8 * ℓ * U₀ + 8 * R_b ^ 2 + 1 := by positivity
      linarith
    have hRb_le_R : R_b ≤ R_star := by
      have : 0 ≤ M + 8 * ℓ * U₀ + 8 * R_b ^ 2 + 1 := by positivity
      linarith
    have hR_sq : 8 * ℓ * U₀ + 8 * R_b ^ 2 ≤ R_star ^ 2 := by
      have h1 : 8 * ℓ * U₀ + 8 * R_b ^ 2 ≤ R_star := by
        have : 0 ≤ M + R_b + 1 := by positivity
        linarith
      nlinarith
    have h0_mem_K : (0 : EuclideanSpace ℝ (Fin d)) ∈ K :=
      Metric.mem_closedBall_self (le_of_lt hR_pos)
    have hΦ_cont : ∀ (w : EuclideanSpace ℝ (Fin (d + 1)) → ℝ) (x : EuclideanSpace ℝ (Fin d)),
        Continuous w → Continuous (Φ w x) := by
      intro w x hw
      exact (continuous_const.mul (hw.comp (h_cont_mk t))).sub
        (((continuous_id.sub continuous_const).norm.pow 2).div_const (2 * ℓ))
    have h_trunc : ∀ (w : EuclideanSpace ℝ (Fin (d + 1)) → ℝ) (x : EuclideanSpace ℝ (Fin d)),
        InLimitingClassA d C₁ w → IsCenteredAt d C₁ w 0 1 →
        ‖x‖ ≤ R_b → -U₀ ≤ σ * w (mkSpaceTime 0 t) →
        sSup ((Φ w x) '' Set.univ) = sSup ((Φ w x) '' K) := by
      intro w x hw_class hw_cent hx hw0
      have hK_nonempty : ((Φ w x) '' K).Nonempty := ⟨Φ w x 0, 0, h0_mem_K, rfl⟩
      have hK_bdd : BddAbove ((Φ w x) '' K) :=
        (isCompact_closedBall 0 R_star).bddAbove_image (hΦ_cont w x hw_class.1).continuousOn
      have h0_le_sup : Φ w x 0 ≤ sSup ((Φ w x) '' K) :=
        le_csSup hK_bdd ⟨0, h0_mem_K, rfl⟩
      have h_dom_all : ∀ y : EuclideanSpace ℝ (Fin d), Φ w x y ≤ sSup ((Φ w x) '' K) := by
        intro y
        by_cases hy : ‖y‖ ≤ R_star
        · have hyK : y ∈ K := by simpa [K, mem_closedBall_zero_iff] using hy
          exact le_csSup hK_bdd ⟨y, hyK, rfl⟩
        · push_neg at hy
          have hyM : M ≤ ‖y‖ := le_trans hM_le_R (le_of_lt hy)
          have hw_abs : |w (mkSpaceTime y t)| ≤ (1 / (8 * ℓ)) * ‖y‖ ^ 2 :=
            hM_bound w hw_class hw_cent y t ht hyM
          have hw_y : σ * w (mkSpaceTime y t) ≤ ‖y‖ ^ 2 / (8 * ℓ) := by
            have h_abs_mul : σ * w (mkSpaceTime y t) ≤ |σ * w (mkSpaceTime y t)| := le_abs_self _
            rw [abs_mul, hσ, one_mul] at h_abs_mul
            rw [one_div_mul_eq_div] at hw_abs
            linarith
          have h_tri : ‖y‖ ≤ ‖y - x‖ + R_b := by
            have h1 : ‖y‖ ≤ ‖y - x‖ + ‖x‖ := by
              simpa [sub_add_cancel] using norm_add_le (y - x) x
            linarith
          have h_yx_sq : ‖y‖ ^ 2 / 2 - R_b ^ 2 ≤ ‖y - x‖ ^ 2 := by
            have h_nonneg : 0 ≤ (‖y - x‖ - R_b) ^ 2 := sq_nonneg _
            have hy_nonneg : 0 ≤ ‖y‖ := norm_nonneg y
            nlinarith
          have h_yx_div : (‖y‖ ^ 2 / 2 - R_b ^ 2) / (2 * ℓ) ≤ ‖y - x‖ ^ 2 / (2 * ℓ) :=
            div_le_div_of_nonneg_right h_yx_sq (by positivity)
          have h_x_sq : ‖(0 : EuclideanSpace ℝ (Fin d)) - x‖ ^ 2 ≤ R_b ^ 2 := by
            rw [zero_sub, norm_neg]
            have hx_nonneg : 0 ≤ ‖x‖ := norm_nonneg x
            nlinarith
          have h_x_div : ‖(0 : EuclideanSpace ℝ (Fin d)) - x‖ ^ 2 / (2 * ℓ) ≤ R_b ^ 2 / (2 * ℓ) :=
            div_le_div_of_nonneg_right h_x_sq (by positivity)
          have hy_sq : R_star ^ 2 ≤ ‖y‖ ^ 2 := by
            nlinarith
          have h_tail_eq : ‖y‖ ^ 2 / (8 * ℓ) - (‖y‖ ^ 2 / 2 - R_b ^ 2) / (2 * ℓ) =
              (4 * R_b ^ 2 - ‖y‖ ^ 2) / (8 * ℓ) := by
            field_simp [ne_of_gt hℓ]
            ring
          have h_rhs_eq : -U₀ - R_b ^ 2 / (2 * ℓ) = (-8 * ℓ * U₀ - 4 * R_b ^ 2) / (8 * ℓ) := by
            field_simp [ne_of_gt hℓ]
            ring
          have h_tail_alg : ‖y‖ ^ 2 / (8 * ℓ) - (‖y‖ ^ 2 / 2 - R_b ^ 2) / (2 * ℓ) ≤
              -U₀ - R_b ^ 2 / (2 * ℓ) := by
            rw [h_tail_eq, h_rhs_eq]
            exact div_le_div_of_nonneg_right (by linarith) (by positivity)
          have h_le_zero : Φ w x y ≤ Φ w x 0 := by
            dsimp [Φ]
            linarith
          exact le_trans h_le_zero h0_le_sup
      have h_univ_bdd : BddAbove ((Φ w x) '' Set.univ) := by
        refine ⟨sSup ((Φ w x) '' K), ?_⟩
        rintro _ ⟨y, _, rfl⟩
        exact h_dom_all y
      have h_univ_nonempty : ((Φ w x) '' Set.univ).Nonempty :=
        ⟨Φ w x 0, 0, Set.mem_univ 0, rfl⟩
      apply le_antisymm
      · apply csSup_le h_univ_nonempty
        rintro _ ⟨y, _, rfl⟩
        exact h_dom_all y
      · exact csSup_le_csSup h_univ_bdd hK_nonempty (Set.image_mono (Set.subset_univ K))
    have h_K_tendsto :
        Filter.Tendsto (fun m => sSup ((Φ (w_seq m) (b_seq m)) '' K))
          Filter.atTop (nhds (sSup ((Φ v_inf b) '' K))) := by
      rw [Metric.tendsto_atTop]
      intro ε hε
      let L : ℝ := 2 * R_star + 2 * ‖b‖ + 1
      have hL_pos : 0 < L := by positivity
      have hBox_pos : 0 < max R_star ℓ := lt_max_of_lt_left hR_pos
      obtain ⟨N₁, hN₁⟩ := h_conv (max R_star ℓ) hBox_pos (ε / 3) (by positivity)
      have hδ_pos : 0 < min 1 (2 * ℓ * (ε / 3) / L) := by positivity
      obtain ⟨N₂, hN₂⟩ := Metric.tendsto_atTop.mp hb_tendsto (min 1 (2 * ℓ * (ε / 3) / L)) hδ_pos
      refine ⟨max N₁ N₂, fun m hm => ?_⟩
      have hm₁ : N₁ ≤ m := le_trans (le_max_left N₁ N₂) hm
      have hm₂ : N₂ ≤ m := le_trans (le_max_right N₁ N₂) hm
      have hb_min : ‖b_seq m - b‖ < min 1 (2 * ℓ * (ε / 3) / L) := by
        simpa [dist_eq_norm] using hN₂ m hm₂
      have hb_one : ‖b_seq m - b‖ ≤ 1 := le_of_lt (lt_of_lt_of_le hb_min (min_le_left _ _))
      have hb_L : L * ‖b_seq m - b‖ ≤ 2 * ℓ * (ε / 3) := by
        have h_lt : ‖b_seq m - b‖ ≤ 2 * ℓ * (ε / 3) / L :=
          le_of_lt (lt_of_lt_of_le hb_min (min_le_right _ _))
        exact (le_div_iff₀' hL_pos).mp h_lt
      have h_ptwise : ∀ y ∈ K, |Φ (w_seq m) (b_seq m) y - Φ v_inf b y| ≤ 2 * ε / 3 := by
        intro y hyK
        have hy_norm : ‖y‖ ≤ R_star := by simpa [K, mem_closedBall_zero_iff] using hyK
        have hw_diff : |σ * w_seq m (mkSpaceTime y t) - σ * v_inf (mkSpaceTime y t)| ≤ ε / 3 := by
          rw [← mul_sub, abs_mul, hσ, one_mul]
          exact hN₁ m hm₁ (mkSpaceTime y t)
            (by rw [h_projSpace]; exact le_trans hy_norm (le_max_left R_star ℓ))
            (by rw [h_projTime]; exact le_trans ht (le_max_right R_star ℓ))
        have h_norm_sub : |‖y - b_seq m‖ - ‖y - b‖| ≤ ‖b_seq m - b‖ := by
          have h1 := abs_norm_sub_norm_le (y - b_seq m) (y - b)
          have h2 : (y - b_seq m) - (y - b) = -(b_seq m - b) := by abel
          rwa [h2, norm_neg] at h1
        have h_norm_sum : ‖y - b_seq m‖ + ‖y - b‖ ≤ L := by
          have h1 : ‖y - b_seq m‖ ≤ ‖y - b‖ + ‖b_seq m - b‖ := by
            have h_eq : y - b_seq m = (y - b) - (b_seq m - b) := by abel
            rw [h_eq]
            exact norm_sub_le (y - b) (b_seq m - b)
          have h2 : ‖y - b‖ ≤ ‖y‖ + ‖b‖ := norm_sub_le y b
          dsimp [L]
          linarith
        have h_sq_diff : |‖y - b_seq m‖ ^ 2 - ‖y - b‖ ^ 2| ≤ 2 * ℓ * (ε / 3) := by
          have h_fac : ‖y - b_seq m‖ ^ 2 - ‖y - b‖ ^ 2 =
              (‖y - b_seq m‖ - ‖y - b‖) * (‖y - b_seq m‖ + ‖y - b‖) := by ring
          rw [h_fac, abs_mul, abs_of_nonneg (by positivity : 0 ≤ ‖y - b_seq m‖ + ‖y - b‖)]
          have h_mul : |‖y - b_seq m‖ - ‖y - b‖| * (‖y - b_seq m‖ + ‖y - b‖) ≤
              ‖b_seq m - b‖ * L :=
            mul_le_mul h_norm_sub h_norm_sum (by positivity) (norm_nonneg _)
          linarith
        have h_quad_diff : |‖y - b_seq m‖ ^ 2 / (2 * ℓ) - ‖y - b‖ ^ 2 / (2 * ℓ)| ≤ ε / 3 := by
          rw [← sub_div, abs_div, abs_of_pos (by positivity : 0 < 2 * ℓ), div_le_iff₀ (by positivity)]
          linarith
        have h_split : Φ (w_seq m) (b_seq m) y - Φ v_inf b y =
            (σ * w_seq m (mkSpaceTime y t) - σ * v_inf (mkSpaceTime y t)) -
            (‖y - b_seq m‖ ^ 2 / (2 * ℓ) - ‖y - b‖ ^ 2 / (2 * ℓ)) := by
          dsimp [Φ]
          ring
        rw [h_split]
        have h_tri := abs_sub (σ * w_seq m (mkSpaceTime y t) - σ * v_inf (mkSpaceTime y t))
          (‖y - b_seq m‖ ^ 2 / (2 * ℓ) - ‖y - b‖ ^ 2 / (2 * ℓ))
        linarith
      have hK_nonempty_m : ((Φ (w_seq m) (b_seq m)) '' K).Nonempty := ⟨Φ (w_seq m) (b_seq m) 0, 0, h0_mem_K, rfl⟩
      have hK_nonempty_inf : ((Φ v_inf b) '' K).Nonempty := ⟨Φ v_inf b 0, 0, h0_mem_K, rfl⟩
      have hK_bdd_m : BddAbove ((Φ (w_seq m) (b_seq m)) '' K) :=
        (isCompact_closedBall 0 R_star).bddAbove_image (hΦ_cont (w_seq m) (b_seq m) (hw_seq m).1.1).continuousOn
      have hK_bdd_inf : BddAbove ((Φ v_inf b) '' K) :=
        (isCompact_closedBall 0 R_star).bddAbove_image (hΦ_cont v_inf b hv_inf_class.1).continuousOn
      have h_sup_le1 : sSup ((Φ (w_seq m) (b_seq m)) '' K) ≤ sSup ((Φ v_inf b) '' K) + 2 * ε / 3 := by
        apply csSup_le hK_nonempty_m
        rintro _ ⟨y, hyK, rfl⟩
        have hy_diff := (abs_sub_le_iff.mp (h_ptwise y hyK)).1
        have hy_sup : Φ v_inf b y ≤ sSup ((Φ v_inf b) '' K) := le_csSup hK_bdd_inf ⟨y, hyK, rfl⟩
        linarith
      have h_sup_le2 : sSup ((Φ v_inf b) '' K) ≤ sSup ((Φ (w_seq m) (b_seq m)) '' K) + 2 * ε / 3 := by
        apply csSup_le hK_nonempty_inf
        rintro _ ⟨y, hyK, rfl⟩
        have hy_diff := (abs_sub_le_iff.mp (h_ptwise y hyK)).2
        have hy_sup : Φ (w_seq m) (b_seq m) y ≤ sSup ((Φ (w_seq m) (b_seq m)) '' K) :=
          le_csSup hK_bdd_m ⟨y, hyK, rfl⟩
        linarith
      rw [Real.dist_eq]
      have h_abs : |sSup ((Φ (w_seq m) (b_seq m)) '' K) - sSup ((Φ v_inf b) '' K)| ≤ 2 * ε / 3 :=
        abs_sub_le_iff.mpr ⟨by linarith, by linarith⟩
      linarith
    have h_inf_eq : sSup ((Φ v_inf b) '' Set.univ) = sSup ((Φ v_inf b) '' K) := by
      apply h_trunc v_inf b hv_inf_class hv_inf_cent
      · dsimp [R_b]
        linarith
      · have h_abs : |σ * v_inf (mkSpaceTime 0 t)| = |v_inf (mkSpaceTime 0 t)| := by
          rw [abs_mul, hσ, one_mul]
        have h_le : -|σ * v_inf (mkSpaceTime 0 t)| ≤ σ * v_inf (mkSpaceTime 0 t) := neg_abs_le _
        dsimp [U₀]
        linarith
    rw [h_inf_eq]
    refine h_K_tendsto.congr' ?_
    rw [Filter.EventuallyEq, Filter.eventually_atTop]
    obtain ⟨N_b, hN_b⟩ := Metric.tendsto_atTop.mp hb_tendsto 1 zero_lt_one
    obtain ⟨N_w, hN_w⟩ := h_conv (max 1 ℓ) (by positivity) 1 zero_lt_one
    refine ⟨max N_b N_w, fun m hm => ?_⟩
    have hm_b : N_b ≤ m := le_trans (le_max_left N_b N_w) hm
    have hm_w : N_w ≤ m := le_trans (le_max_right N_b N_w) hm
    symm
    apply h_trunc (w_seq m) (b_seq m) (hw_seq m).1 (hw_seq m).2
    · have hb_dist : ‖b_seq m - b‖ < 1 := by simpa [dist_eq_norm] using hN_b m hm_b
      have h_tri : ‖b_seq m‖ ≤ ‖b_seq m - b‖ + ‖b‖ := by
        simpa using norm_add_le (b_seq m - b) b
      dsimp [R_b]
      linarith
    · have hw0_diff : |w_seq m (mkSpaceTime 0 t) - v_inf (mkSpaceTime 0 t)| ≤ 1 :=
        hN_w m hm_w (mkSpaceTime 0 t)
          (by rw [h_projSpace, norm_zero]; positivity)
          (by rw [h_projTime]; exact le_trans ht (le_max_right 1 ℓ))
      have h_sigma_diff : |σ * w_seq m (mkSpaceTime 0 t) - σ * v_inf (mkSpaceTime 0 t)| ≤ 1 := by
        rw [← mul_sub, abs_mul, hσ, one_mul]
        exact hw0_diff
      have h_sigma_inf : |σ * v_inf (mkSpaceTime 0 t)| = |v_inf (mkSpaceTime 0 t)| := by
        rw [abs_mul, hσ, one_mul]
      have h1 := (abs_sub_le_iff.mp h_sigma_diff).2
      have h2 : -|σ * v_inf (mkSpaceTime 0 t)| ≤ σ * v_inf (mkSpaceTime 0 t) := neg_abs_le _
      dsimp [U₀]
      linarith
  have h_env_plus_eq : ∀ (f : EuclideanSpace ℝ (Fin (d + 1)) → ℝ) (x : EuclideanSpace ℝ (Fin d)),
      quadEnvelopePlus d ℓ f (mkSpaceTime x 0) =
        sSup ((fun y : EuclideanSpace ℝ (Fin d) =>
          1 * f (mkSpaceTime y ℓ) - ‖y - x‖ ^ 2 / (2 * ℓ)) '' Set.univ) := by
    intro f x
    unfold quadEnvelopePlus
    rw [h_projTime, h_projSpace, zero_add]
    simp only [one_mul]
  have h_env_minus_eq : ∀ (f : EuclideanSpace ℝ (Fin (d + 1)) → ℝ) (x : EuclideanSpace ℝ (Fin d)),
      quadEnvelopeMinus d ℓ f (mkSpaceTime x 0) =
        - sSup ((fun y : EuclideanSpace ℝ (Fin d) =>
          (-1) * f (mkSpaceTime y (-ℓ)) - ‖y - x‖ ^ 2 / (2 * ℓ)) '' Set.univ) := by
    intro f x
    unfold quadEnvelopeMinus
    rw [h_projTime, h_projSpace, zero_sub, Real.sInf_def]
    congr 2
    ext v
    simp only [Set.mem_neg, Set.mem_image, Set.mem_univ, true_and]
    constructor
    · rintro ⟨y, hy⟩
      refine ⟨y, ?_⟩
      linarith
    · rintro ⟨y, hy⟩
      refine ⟨y, ?_⟩
      linarith
  have h_plus_tendsto :
      Filter.Tendsto
        (fun m => quadEnvelopePlus d ℓ (w_seq m) (mkSpaceTime (b_seq m) 0))
        Filter.atTop (nhds (quadEnvelopePlus d ℓ v_inf (mkSpaceTime b 0))) := by
    simp_rw [h_env_plus_eq]
    exact h_sup_tendsto 1 ℓ (by norm_num) (by rw [abs_of_pos hℓ])
  have h_minus_tendsto :
      Filter.Tendsto
        (fun m => quadEnvelopeMinus d ℓ (w_seq m) (mkSpaceTime (b_seq m) 0))
        Filter.atTop (nhds (quadEnvelopeMinus d ℓ v_inf (mkSpaceTime b 0))) := by
    simp_rw [h_env_minus_eq]
    exact (h_sup_tendsto (-1) (-ℓ) (by norm_num) (by rw [abs_neg, abs_of_pos hℓ])).neg
  constructor
  · unfold slopePlus
    exact (h_plus_tendsto.sub h_eval_zero).div_const ℓ
  · unfold slopeMinus
    exact (h_eval_zero.sub h_minus_tendsto).div_const ℓ

theorem barycentric_gap_limit_of_loc_unif : ∀ (d : ℕ), 3 ≤ d → ∀ (C₁ : ℝ), 1 ≤ C₁ → ∀ (κ : ℝ), 0 < κ →
      HasUniformSubquadraticGrowth d C₁ →
      ∀ (w_seq : ℕ → EuclideanSpace ℝ (Fin (d + 1)) → ℝ)
        (v_inf : EuclideanSpace ℝ (Fin (d + 1)) → ℝ),
        (∀ m : ℕ,
          InLimitingClassA d C₁ (w_seq m) ∧
          IsCenteredAt d C₁ (w_seq m) 0 1 ∧
          HasHorizontalJensenBound d κ (w_seq m) ∧
          barycentricEnvelope d 1 (w_seq m) (mkSpaceTime 0 1) -
            w_seq m (mkSpaceTime 0 1) = κ ^ 2 / 2) →
        InLimitingClassA d C₁ v_inf →
        IsCenteredAt d C₁ v_inf 0 1 →
        ConvergesLocUnif d w_seq v_inf →
        barycentricEnvelope d 1 v_inf (mkSpaceTime 0 1) -
          v_inf (mkSpaceTime 0 1) = κ ^ 2 / 2 :=
by
  intro d hd C₁ hC₁ κ hκ_pos h_growth w_seq v hw_seq hv_class hv_cent h_conv
  have hv_cont : Continuous v := hv_class.1
  have h_subquad_all : ∀ (ε : ℝ), 0 < ε →
      ∃ (M : ℝ), 0 < M ∧
        ∀ (w : EuclideanSpace ℝ (Fin (d + 1)) → ℝ),
          InLimitingClassA d C₁ w → IsCenteredAt d C₁ w 0 1 →
          ∀ (y : EuclideanSpace ℝ (Fin d)),
            M ≤ ‖y‖ → |w (mkSpaceTime y 1)| ≤ ε * ‖y‖ ^ 2 := by
    intro ε hε
    obtain ⟨M, hM_pos, hM⟩ := h_growth 1 zero_le_one ε hε
    refine ⟨M, hM_pos, fun w hw_cl hw_ce y hy => ?_⟩
    exact hM w hw_cl hw_ce y 1 (by norm_num) hy
  have hv_subquad : ∀ (ε : ℝ), 0 < ε →
      ∃ (M : ℝ), 0 < M ∧
        ∀ (y : EuclideanSpace ℝ (Fin d)),
          M ≤ ‖y‖ → |v (mkSpaceTime y 1)| ≤ ε * ‖y‖ ^ 2 := by
    intro ε hε
    obtain ⟨M, hM_pos, hM⟩ := h_subquad_all ε hε
    exact ⟨M, hM_pos, hM v hv_class hv_cent⟩
  have hv_tendsto : ∀ z : EuclideanSpace ℝ (Fin (d + 1)),
      Filter.Tendsto (fun m => w_seq m z) Filter.atTop (nhds (v z)) := by
    intro z
    rw [Metric.tendsto_atTop]
    intro ε hε
    let R : ℝ := max (‖projSpace z‖ + 1) (|projTime z| + 1)
    have hR_pos : 0 < R := by
      have : 0 < ‖projSpace z‖ + 1 := by positivity
      exact lt_of_lt_of_le this (le_max_left _ _)
    obtain ⟨N₀, hN₀⟩ := h_conv R hR_pos (ε / 2) (half_pos hε)
    refine ⟨N₀, fun m hm => ?_⟩
    rw [Real.dist_eq]
    have hz_s : ‖projSpace z‖ ≤ R :=
      le_trans (by linarith) (le_max_left (‖projSpace z‖ + 1) (|projTime z| + 1))
    have hz_t : |projTime z| ≤ R :=
      le_trans (by linarith) (le_max_right (‖projSpace z‖ + 1) (|projTime z| + 1))
    have h_le := hN₀ m hm z hz_s hz_t
    linarith
  have hv_jensen : HasHorizontalJensenBound d κ v := by
    intro t N θ y hθ_pos hθ_sum
    let x : EuclideanSpace ℝ (Fin d) := ∑ i, θ i • y i
    let r : ℝ := Real.sqrt (∑ i, θ i * ‖y i - x‖ ^ 2)
    have h_sum_tend : Filter.Tendsto
        (fun m => (∑ i, θ i * w_seq m (mkSpaceTime (y i) t)) - w_seq m (mkSpaceTime x t))
        Filter.atTop
        (nhds ((∑ i, θ i * v (mkSpaceTime (y i) t)) - v (mkSpaceTime x t))) :=
      (tendsto_finset_sum Finset.univ (fun i _ =>
        (hv_tendsto (mkSpaceTime (y i) t)).const_mul (θ i))).sub (hv_tendsto (mkSpaceTime x t))
    refine le_of_tendsto h_sum_tend (Filter.eventually_atTop.mpr ⟨0, fun m _ => ?_⟩)
    exact (hw_seq m).2.2.1 t N θ y hθ_pos hθ_sum
  have hb_dual_ex : ∃ (b : EuclideanSpace ℝ (Fin d)),
      barycentricEnvelope d 1 v (mkSpaceTime 0 1) =
        quadEnvelopePlus d 1 v (mkSpaceTime b 0) + ‖b‖ ^ 2 / 2 := by
    have h_mk_cont : Continuous (fun y : EuclideanSpace ℝ (Fin d) => mkSpaceTime y 1) := by
      unfold mkSpaceTime
      refine (EuclideanSpace.equiv (Fin (d + 1)) ℝ).symm.continuous.comp (continuous_pi (fun j => ?_))
      refine Fin.lastCases ?_ ?_ j
      · simp only [Fin.snoc_last]; exact continuous_const
      · intro i; simp only [Fin.snoc_castSucc]
        exact (continuous_apply i).comp (EuclideanSpace.equiv (Fin d) ℝ).continuous
    obtain ⟨M, hM_pos, hM⟩ := hv_subquad (1 / 4) (by norm_num)
    have h_main : ∀ (B : ℝ), 0 ≤ B →
        ∃ (R : ℝ), 0 < R ∧
          ∀ (b : EuclideanSpace ℝ (Fin d)), ‖b‖ ≤ B →
            (∀ (y : EuclideanSpace ℝ (Fin d)),
              v (mkSpaceTime y 1) - ‖y - b‖ ^ 2 / 2 ≤ quadEnvelopePlus d 1 v (mkSpaceTime b 0)) ∧
            (∃ (y : EuclideanSpace ℝ (Fin d)),
              ‖y‖ ≤ R ∧
              v (mkSpaceTime y 1) - ‖y - b‖ ^ 2 / 2 = quadEnvelopePlus d 1 v (mkSpaceTime b 0)) ∧
            (∀ (y : EuclideanSpace ℝ (Fin d)),
              v (mkSpaceTime y 1) - ‖y - b‖ ^ 2 / 2 = quadEnvelopePlus d 1 v (mkSpaceTime b 0) →
              ‖y‖ ≤ R) := by
      intro B hB
      let R : ℝ := max M (max (8 * B) (8 * |v (mkSpaceTime 0 1)| + 8))
      have hR_pos : 0 < R := lt_of_lt_of_le hM_pos (le_max_left _ _)
      have hR_ge_M : M ≤ R := le_max_left _ _
      have hR_ge_8B : 8 * B ≤ R := le_trans (le_max_left _ _) (le_max_right _ _)
      have hR_ge_v0 : 8 * |v (mkSpaceTime 0 1)| + 8 ≤ R :=
        le_trans (le_max_right _ _) (le_max_right _ _)
      refine ⟨R, hR_pos, ?_⟩
      intro b hb
      have h_proj_s : projSpace (mkSpaceTime b 0) = b := by
        ext i; simp [projSpace, mkSpaceTime]
      have h_proj_t : projTime (mkSpaceTime b 0) = 0 := by
        simp [projTime, mkSpaceTime]
      let g : EuclideanSpace ℝ (Fin d) → ℝ := fun y => v (mkSpaceTime y 1) - ‖y - b‖ ^ 2 / 2
      have hg_cont : Continuous g :=
        (hv_cont.comp h_mk_cont).sub (((continuous_id.sub continuous_const).norm.pow 2).div_const 2)
      have h_strict : ∀ y : EuclideanSpace ℝ (Fin d), R < ‖y‖ → g y < g 0 := by
        intro y hy
        have hy_M : M ≤ ‖y‖ := le_of_lt (lt_of_le_of_lt hR_ge_M hy)
        have hv_y : v (mkSpaceTime y 1) ≤ (1 / 4) * ‖y‖ ^ 2 :=
          le_trans (le_abs_self _) (hM y hy_M)
        have hy_pos : 0 < ‖y‖ := lt_trans hR_pos hy
        have hb_le : ‖b‖ ≤ (1 / 8) * ‖y‖ := by linarith
        have h_inner : inner ℝ y b ≤ (1 / 8) * ‖y‖ ^ 2 := by
          calc inner ℝ y b
            _ ≤ ‖y‖ * ‖b‖ := real_inner_le_norm y b
            _ ≤ ‖y‖ * ((1 / 8) * ‖y‖) := mul_le_mul_of_nonneg_left hb_le (le_of_lt hy_pos)
            _ = (1 / 8) * ‖y‖ ^ 2 := by ring
        have hy_ge_one : 1 ≤ ‖y‖ := by
          have : (0 : ℝ) ≤ |v (mkSpaceTime 0 1)| := abs_nonneg _
          linarith
        have hy_sq_gt : 8 * |v (mkSpaceTime 0 1)| + 8 < ‖y‖ ^ 2 := by
          calc 8 * |v (mkSpaceTime 0 1)| + 8
            _ < ‖y‖ := lt_of_le_of_lt hR_ge_v0 hy
            _ = 1 * ‖y‖ := by ring
            _ ≤ ‖y‖ * ‖y‖ := mul_le_mul_of_nonneg_right hy_ge_one (le_of_lt hy_pos)
            _ = ‖y‖ ^ 2 := by ring
        have hv0_ge : -|v (mkSpaceTime 0 1)| ≤ v (mkSpaceTime 0 1) := neg_abs_le _
        have h_norm_sub : ‖y - b‖ ^ 2 = ‖y‖ ^ 2 - 2 * inner ℝ y b + ‖b‖ ^ 2 :=
          norm_sub_sq_real y b
        have h_norm_zero : ‖(0 : EuclideanSpace ℝ (Fin d)) - b‖ ^ 2 = ‖b‖ ^ 2 := by
          rw [zero_sub, norm_neg]
        dsimp [g]
        rw [h_norm_sub, h_norm_zero]
        linarith
      have hK_comp : IsCompact (Metric.closedBall (0 : EuclideanSpace ℝ (Fin d)) R) :=
        isCompact_closedBall 0 R
      have h0_mem : (0 : EuclideanSpace ℝ (Fin d)) ∈ Metric.closedBall 0 R := by
        simp [Metric.mem_closedBall, le_of_lt hR_pos]
      obtain ⟨y_star, hy_star_mem, hy_star_max⟩ :=
        hK_comp.exists_isMaxOn ⟨0, h0_mem⟩ hg_cont.continuousOn
      have hy_star_norm : ‖y_star‖ ≤ R := by simpa [Metric.mem_closedBall] using hy_star_mem
      have hg0_le : g 0 ≤ g y_star := hy_star_max h0_mem
      have hg_ub : ∀ y : EuclideanSpace ℝ (Fin d), g y ≤ g y_star := by
        intro y
        by_cases hy : ‖y‖ ≤ R
        · exact hy_star_max (by simpa [Metric.mem_closedBall] using hy)
        · exact le_of_lt (lt_of_lt_of_le (h_strict y (lt_of_not_ge hy)) hg0_le)
      have h_env_eq_sSup : quadEnvelopePlus d 1 v (mkSpaceTime b 0) = sSup (g '' Set.univ) := by
        unfold quadEnvelopePlus
        congr 1
        ext val
        simp only [Set.mem_image, Set.mem_univ, true_and, h_proj_t, h_proj_s, zero_add, mul_one, g]
      have h_bdd : BddAbove (g '' Set.univ) := by
        refine ⟨g y_star, ?_⟩
        rintro _ ⟨y, -, rfl⟩
        exact hg_ub y
      have h_le_env : ∀ y : EuclideanSpace ℝ (Fin d),
          g y ≤ quadEnvelopePlus d 1 v (mkSpaceTime b 0) := by
        intro y
        rw [h_env_eq_sSup]
        exact le_csSup h_bdd ⟨y, Set.mem_univ y, rfl⟩
      have hy_star_eq : g y_star = quadEnvelopePlus d 1 v (mkSpaceTime b 0) := by
        rw [h_env_eq_sSup]
        refine le_antisymm (le_csSup h_bdd ⟨y_star, Set.mem_univ y_star, rfl⟩) ?_
        refine csSup_le ⟨g y_star, ⟨y_star, Set.mem_univ y_star, rfl⟩⟩ ?_
        rintro _ ⟨y, -, rfl⟩
        exact hg_ub y
      refine ⟨h_le_env, ⟨y_star, hy_star_norm, hy_star_eq⟩, ?_⟩
      intro y hy_eq
      by_contra hy_gt
      have h1 : g y < g 0 := h_strict y (lt_of_not_ge hy_gt)
      have h2 : g 0 ≤ g y := by
        calc g 0 ≤ g y_star := hg0_le
          _ = quadEnvelopePlus d 1 v (mkSpaceTime b 0) := hy_star_eq
          _ = g y := hy_eq.symm
      linarith
    have h_le : ∀ (b y : EuclideanSpace ℝ (Fin d)),
        v (mkSpaceTime y 1) - ‖y - b‖ ^ 2 / 2 ≤ quadEnvelopePlus d 1 v (mkSpaceTime b 0) := by
      intro b y
      obtain ⟨R, _, hR⟩ := h_main ‖b‖ (norm_nonneg b)
      exact (hR b le_rfl).1 y
    have h_conf : ∀ (B : ℝ), 0 ≤ B →
        ∃ (R : ℝ), 0 < R ∧
          ∀ (b : EuclideanSpace ℝ (Fin d)), ‖b‖ ≤ B →
            (∃ (y : EuclideanSpace ℝ (Fin d)),
              ‖y‖ ≤ R ∧
              v (mkSpaceTime y 1) - ‖y - b‖ ^ 2 / 2 = quadEnvelopePlus d 1 v (mkSpaceTime b 0)) ∧
            (∀ (y : EuclideanSpace ℝ (Fin d)),
              v (mkSpaceTime y 1) - ‖y - b‖ ^ 2 / 2 = quadEnvelopePlus d 1 v (mkSpaceTime b 0) →
              ‖y‖ ≤ R) := by
      intro B hB
      obtain ⟨R, hR_pos, hR⟩ := h_main B hB
      exact ⟨R, hR_pos, fun b hb => ⟨(hR b hb).2.1, (hR b hb).2.2⟩⟩
    let Φ : EuclideanSpace ℝ (Fin d) → ℝ :=
      fun b => quadEnvelopePlus d 1 v (mkSpaceTime b 0) + ‖b‖ ^ 2 / 2
    have h_sq_id : ∀ (b y : EuclideanSpace ℝ (Fin d)),
        (v (mkSpaceTime y 1) - ‖y - b‖ ^ 2 / 2) + ‖b‖ ^ 2 / 2 =
          v (mkSpaceTime y 1) - ‖y‖ ^ 2 / 2 + inner ℝ b y := by
      intro b y
      rw [norm_sub_sq_real, real_inner_comm]
      ring
    have hΦ_ge : ∀ (b y : EuclideanSpace ℝ (Fin d)),
        v (mkSpaceTime y 1) - ‖y‖ ^ 2 / 2 + inner ℝ b y ≤ Φ b := by
      intro b y
      have h1 := h_le b y
      have h2 := h_sq_id b y
      dsimp [Φ]
      linarith
    have hΦ_lip : ∀ (B : ℝ), 0 ≤ B →
        ∃ (R : ℝ), 0 < R ∧
          ∀ (b₁ b₂ : EuclideanSpace ℝ (Fin d)), ‖b₁‖ ≤ B → ‖b₂‖ ≤ B →
            |Φ b₁ - Φ b₂| ≤ R * ‖b₁ - b₂‖ := by
      intro B hB
      obtain ⟨R, hR_pos, hR⟩ := h_conf B hB
      have h_one_side : ∀ (b₁ b₂ : EuclideanSpace ℝ (Fin d)), ‖b₁‖ ≤ B →
          Φ b₁ - Φ b₂ ≤ R * ‖b₁ - b₂‖ := by
        intro b₁ b₂ hb₁
        obtain ⟨y₁, hy₁_norm, hy₁_eq⟩ := (hR b₁ hb₁).1
        have h1 : Φ b₁ = v (mkSpaceTime y₁ 1) - ‖y₁‖ ^ 2 / 2 + inner ℝ b₁ y₁ := by
          dsimp [Φ]
          rw [← hy₁_eq, h_sq_id b₁ y₁]
        have h2 : v (mkSpaceTime y₁ 1) - ‖y₁‖ ^ 2 / 2 + inner ℝ b₂ y₁ ≤ Φ b₂ := hΦ_ge b₂ y₁
        have h_diff : Φ b₁ - Φ b₂ ≤ inner ℝ (b₁ - b₂) y₁ := by
          rw [inner_sub_left]
          linarith
        calc Φ b₁ - Φ b₂
          _ ≤ inner ℝ (b₁ - b₂) y₁ := h_diff
          _ ≤ ‖b₁ - b₂‖ * ‖y₁‖ := real_inner_le_norm (b₁ - b₂) y₁
          _ ≤ ‖b₁ - b₂‖ * R := mul_le_mul_of_nonneg_left hy₁_norm (norm_nonneg _)
          _ = R * ‖b₁ - b₂‖ := mul_comm _ _
      refine ⟨R, hR_pos, ?_⟩
      intro b₁ b₂ hb₁ hb₂
      rw [abs_sub_le_iff]
      refine ⟨h_one_side b₁ b₂ hb₁, ?_⟩
      simpa [norm_sub_rev] using h_one_side b₂ b₁ hb₂
    have hΦ_cont : Continuous Φ := by
      rw [Metric.continuous_iff]
      intro b₀ ε hε
      obtain ⟨R, hR_pos, hR⟩ := hΦ_lip (‖b₀‖ + 1) (by positivity)
      refine ⟨min 1 (ε / (R + 1)), lt_min zero_lt_one (div_pos hε (by positivity)), ?_⟩
      intro b₁ hb₁
      rw [dist_eq_norm] at hb₁
      rw [Real.dist_eq]
      have hb₁_lt_one : ‖b₁ - b₀‖ < 1 := lt_of_lt_of_le hb₁ (min_le_left _ _)
      have hb₁_lt_div : ‖b₁ - b₀‖ < ε / (R + 1) := lt_of_lt_of_le hb₁ (min_le_right _ _)
      have hb₀_norm : ‖b₀‖ ≤ ‖b₀‖ + 1 := by linarith
      have hb₁_norm : ‖b₁‖ ≤ ‖b₀‖ + 1 := by
        have : ‖b₁‖ ≤ ‖b₀‖ + ‖b₁ - b₀‖ := norm_le_insert' b₁ b₀
        linarith
      have h_le_R : |Φ b₁ - Φ b₀| ≤ R * ‖b₁ - b₀‖ := hR b₁ b₀ hb₁_norm hb₀_norm
      have h_R_lt : R * ‖b₁ - b₀‖ < (R + 1) * (ε / (R + 1)) := by
        calc R * ‖b₁ - b₀‖
          _ ≤ (R + 1) * ‖b₁ - b₀‖ := by
              nlinarith [norm_nonneg (b₁ - b₀)]
          _ < (R + 1) * (ε / (R + 1)) :=
              mul_lt_mul_of_pos_left hb₁_lt_div (by positivity)
      have h_cancel : (R + 1) * (ε / (R + 1)) = ε := mul_div_cancel₀ ε (by positivity)
      linarith
    have hB1_comp : IsCompact (Metric.closedBall (0 : EuclideanSpace ℝ (Fin d)) 1) :=
      isCompact_closedBall 0 1
    have hB1_ne : (Metric.closedBall (0 : EuclideanSpace ℝ (Fin d)) 1).Nonempty :=
      ⟨0, by simp [Metric.mem_closedBall]⟩
    obtain ⟨y_min, hy_min_mem, hy_min⟩ :=
      hB1_comp.exists_isMinOn hB1_ne (hv_cont.comp h_mk_cont).continuousOn
    let m₁ : ℝ := v (mkSpaceTime y_min 1)
    have h_coercive : ∀ b : EuclideanSpace ℝ (Fin d), 1 ≤ ‖b‖ → m₁ - 1 / 2 + ‖b‖ ≤ Φ b := by
      intro b hb
      have hb_pos : 0 < ‖b‖ := lt_of_lt_of_le zero_lt_one hb
      have hb_ne : ‖b‖ ≠ 0 := ne_of_gt hb_pos
      let y_b : EuclideanSpace ℝ (Fin d) := (‖b‖⁻¹) • b
      have hy_b_norm : ‖y_b‖ = 1 := by
        dsimp [y_b]
        rw [norm_smul, Real.norm_of_nonneg (inv_nonneg.mpr (le_of_lt hb_pos)), inv_mul_cancel₀ hb_ne]
      have hy_b_mem : y_b ∈ Metric.closedBall (0 : EuclideanSpace ℝ (Fin d)) 1 := by
        simp [Metric.mem_closedBall, hy_b_norm]
      have hv_ge : m₁ ≤ v (mkSpaceTime y_b 1) := hy_min hy_b_mem
      have h_inner_b : inner ℝ b y_b = ‖b‖ := by
        dsimp [y_b]
        rw [real_inner_smul_right, real_inner_self_eq_norm_sq]
        calc ‖b‖⁻¹ * ‖b‖ ^ 2 = (‖b‖⁻¹ * ‖b‖) * ‖b‖ := by ring
          _ = 1 * ‖b‖ := by rw [inv_mul_cancel₀ hb_ne]
