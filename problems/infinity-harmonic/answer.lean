  have h_ind_85 : ∀ k : ℕ, 1 + (3 / 5 : ℝ) * (k : ℝ) ≤ (8 / 5 : ℝ) ^ k := by
    intro k
    induction' k with k ih
    · norm_num
    · push_cast
      rw [pow_succ']
      have hk_nn : (0 : ℝ) ≤ (k : ℝ) := Nat.cast_nonneg k
      linarith
  have h_ind_2 : ∀ k : ℕ, (k : ℝ) ≤ (2 : ℝ) ^ k := by
    intro k
    induction' k with k ih
    · norm_num
    · push_cast
      rw [pow_succ']
      have h1 : (1 : ℝ) ≤ (2 : ℝ) ^ k := one_le_pow₀ (by norm_num)
      linarith
  have hK_le_k0 : K_req ≤ (8 / 5 : ℝ) ^ k₀ := by
    have h1 := h_ind_85 k₀
    linarith
  have hK_dom : ∀ n : ℕ, k₀ ≤ n → K_req * (5 / 4 : ℝ) ^ n ≤ (2 : ℝ) ^ n := by
    intro n hn
    have h85_mono : (8 / 5 : ℝ) ^ k₀ ≤ (8 / 5 : ℝ) ^ n :=
