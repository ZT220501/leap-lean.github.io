      abel
    have hZY_norm : ‖Z_Y - z_i‖ = R * ‖Y - X‖ := by
      rw [hZY_sub, norm_smul, Real.norm_of_nonneg (le_of_lt hR_i_pos)]
    have hZY_mem : Z_Y ∈ Metric.closedBall z_i r_i := by
      rw [Metric.mem_closedBall, dist_eq_norm, hZY_norm]
      exact mul_le_mul_of_nonneg_left hYX_le_T (le_of_lt hR_i_pos)
    have h_cone := (hU₀_cone z_i r_i (L_star + 3 * ε) hr_i_pos hz_i_lt (by positivity)).1
      h_ball_bound Z_Y hZY_mem
    rw [hZY_norm] at h_cone
    have hU_ZY_diff : U₀ Z_Y - U₀ z_i = R * (V_seq (k₂ i) Y - V_seq (k₂ i) X) := by
      dsimp [V_seq, isotropicBlowup, Z_Y, z_i, R]
      field_simp [ne_of_gt (hR_pos (k₂ i))]
      ring
    rw [hU_ZY_diff] at h_cone
    have hVi_YX : V_seq (k₂ i) Y - V_seq (k₂ i) X ≤ (L_star + 3 * ε) * ‖Y - X‖ := by
      have h_rearranged : R * (V_seq (k₂ i) Y - V_seq (k₂ i) X) ≤ R * ((L_star + 3 * ε) * ‖Y - X‖) := by
        linarith
      exact le_of_mul_le_mul_left h_rearranged hR_i_pos
    have hY_mem : Y ∈ Metric.closedBall (0 : E) M_T := by
      rw [Metric.mem_closedBall, dist_zero_right]
      have h_tri : ‖Y‖ ≤ ‖X‖ + ‖Y - X‖ := norm_le_insert' Y X
      dsimp [M_T]
      linarith
    have h_approx_Y := hi₂ i (le_max_right _ _) Y hY_mem
    have hVY_le : V Y ≤ V_seq (k₂ i) Y + ε := by
      have h1 : V Y - V_seq (k₂ i) Y ≤ |V_seq (k₂ i) Y - V Y| := by
        rw [abs_sub_comm]
        exact le_abs_self _
      linarith
    have hVX_ge : V_seq (k₂ i) X - ε ≤ V X := by
      have h1 : V_seq (k₂ i) X - V X ≤ |V_seq (k₂ i) X - V X| := le_abs_self _
      linarith
    have h_eps_eq : D_XY * ε = δ := by
      dsimp [ε]
      field_simp [ne_of_gt hD_pos]
    have h_expand : (L_star + 3 * ε) * ‖Y - X‖ + 2 * ε = L_star * ‖Y - X‖ + D_XY * ε := by
      dsimp [D_XY]
      ring
    linarith
  have hV_lip : ∀ X Y : E, |V X - V Y| ≤ L_star * ‖X - Y‖ := by
    intro X Y
    rw [abs_sub_le_iff]
    refine ⟨hV_one_sided Y X, ?_⟩
    have h1 := hV_one_sided X Y
    rw [norm_sub_rev] at h1
    exact h1
  refine ⟨k₂, V, hk₂, hV0, ?_, hV_lip, hV_ext⟩
  intro δ hδ_pos
  obtain ⟨i₀, hi₀⟩ := hV_conv 1 δ zero_lt_one hδ_pos
  exact ⟨i₀, fun i hi X hX => hi₀ i hi X (Metric.ball_subset_closedBall hX)⟩

theorem linear_of_global_lipschitz_and_origin_extrema (d : ℕ) (L_star : ℝ) (hL_star_nonneg : 0 ≤ L_star)
    (V : EuclideanSpace ℝ (Fin (d + 1)) → ℝ)
    (hV0 : V 0 = 0)
    (hV_lip : ∀ X Y : EuclideanSpace ℝ (Fin (d + 1)), |V X - V Y| ≤ L_star * ‖X - Y‖)
    (hV_ext : ∀ R : ℝ, 0 < R →
      (∃ x_R ∈ Metric.closedBall (0 : EuclideanSpace ℝ (Fin (d + 1))) R, V x_R = L_star * R) ∧
      (∃ y_R ∈ Metric.closedBall (0 : EuclideanSpace ℝ (Fin (d + 1))) R, V y_R = -L_star * R)) :
    ∃ P_star : EuclideanSpace ℝ (Fin (d + 1)),
      ∀ X : EuclideanSpace ℝ (Fin (d + 1)), V X = inner ℝ P_star X :=
by
  rcases eq_or_lt_of_le hL_star_nonneg with hL0 | hL_pos
  · refine ⟨0, fun X => ?_⟩
    have h1 := hV_lip X 0
    rw [← hL0, hV0, sub_zero, zero_mul] at h1
    have h2 : |V X| = 0 := le_antisymm h1 (abs_nonneg (V X))
    rw [abs_eq_zero.mp h2, inner_zero_left]
  · have h_align : ∀ (z e : EuclideanSpace ℝ (Fin (d + 1))) (t : ℝ),
        0 ≤ t → ‖z‖ ≤ t → ‖e‖ ≤ 1 → t + 1 ≤ ‖z + e‖ → z = t • e := by
      intro z e t ht hz he hze
      have hz_sq : ‖z‖ ^ 2 ≤ t ^ 2 := by nlinarith [norm_nonneg z]
      have he_sq : ‖e‖ ^ 2 ≤ 1 := by nlinarith [norm_nonneg e]
      have hze_sq : t ^ 2 + 2 * t + 1 ≤ ‖z + e‖ ^ 2 := by
        have h1 : (t + 1) ^ 2 ≤ ‖z + e‖ ^ 2 := by nlinarith
        linarith [show (t + 1) ^ 2 = t ^ 2 + 2 * t + 1 by ring]
      have h_add_sq := norm_add_sq_real z e
      have h_inner_ge : t ≤ inner ℝ z e := by linarith
      have h_sub_sq := norm_sub_sq_real z (t • e)
      rw [real_inner_smul_right] at h_sub_sq
      have h_smul_norm : ‖t • e‖ ^ 2 = t ^ 2 * ‖e‖ ^ 2 := by
        rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg ht, mul_pow]
      rw [h_smul_norm] at h_sub_sq
      have ht_inner : t ^ 2 ≤ t * inner ℝ z e := by nlinarith
      have ht_e_sq : t ^ 2 * ‖e‖ ^ 2 ≤ t ^ 2 := by
        have ht2 : 0 ≤ t ^ 2 := sq_nonneg t
        nlinarith
      have h_norm_sub_nonneg : 0 ≤ ‖z - t • e‖ ^ 2 := sq_nonneg ‖z - t • e‖
      have h_norm_sub_sq_zero : ‖z - t • e‖ ^ 2 = 0 := by linarith
      have h_norm_sub_zero : ‖z - t • e‖ = 0 := sq_eq_zero_iff.mp h_norm_sub_sq_zero
      exact sub_eq_zero.mp (norm_eq_zero.mp h_norm_sub_zero)
    obtain ⟨e, he_ball, hVe⟩ := (hV_ext 1 zero_lt_one).1
    rw [mul_one] at hVe
    have he_le : ‖e‖ ≤ 1 := by
      simpa [Metric.mem_closedBall, dist_zero_right] using he_ball
    have he_ge : 1 ≤ ‖e‖ := by
      have h1 := hV_lip e 0
      rw [hVe, hV0, sub_zero, sub_zero, abs_of_pos hL_pos] at h1
      nlinarith
    have he_norm : ‖e‖ = 1 := le_antisymm he_le he_ge
    have hV_neg_ray : ∀ t : ℝ, 0 < t → V (-(t • e)) = -L_star * t := by
      intro t ht
      obtain ⟨y_t, hy_ball, hVy⟩ := (hV_ext t ht).2
      have hy_le : ‖y_t‖ ≤ t := by
        simpa [Metric.mem_closedBall, dist_zero_right] using hy_ball
      have h_lip := hV_lip e y_t
      have h_diff : L_star * (t + 1) ≤ |V e - V y_t| := by
        have h1 : V e - V y_t = L_star * (t + 1) := by
          rw [hVe, hVy]
          ring
        linarith [le_abs_self (V e - V y_t)]
      have h_norm_ge : t + 1 ≤ ‖-y_t + e‖ := by
        have h2 : L_star * (t + 1) ≤ L_star * ‖e - y_t‖ := le_trans h_diff h_lip
        have h3 : t + 1 ≤ ‖e - y_t‖ := by nlinarith
        have h_eq : e - y_t = -y_t + e := by abel
        rwa [h_eq] at h3
      have hy_neg_le : ‖-y_t‖ ≤ t := by
        rwa [norm_neg]
      have h_neg_y_eq : -y_t = t • e :=
        h_align (-y_t) e t (le_of_lt ht) hy_neg_le he_le h_norm_ge
      have hy_eq : y_t = -(t • e) := by
        rw [← neg_neg y_t, h_neg_y_eq]
      rwa [hy_eq] at hVy
    have hV_neg_e : V (-e) = -L_star := by
      have h1 := hV_neg_ray 1 zero_lt_one
      rwa [one_smul, mul_one] at h1
    have hV_pos_ray : ∀ t : ℝ, 0 < t → V (t • e) = L_star * t := by
      intro t ht
      obtain ⟨x_t, hx_ball, hVx⟩ := (hV_ext t ht).1
      have hx_le : ‖x_t‖ ≤ t := by
        simpa [Metric.mem_closedBall, dist_zero_right] using hx_ball
      have h_lip := hV_lip x_t (-e)
      have h_diff : L_star * (t + 1) ≤ |V x_t - V (-e)| := by
        have h1 : V x_t - V (-e) = L_star * (t + 1) := by
          rw [hVx, hV_neg_e]
          ring
        linarith [le_abs_self (V x_t - V (-e))]
      have h_norm_ge : t + 1 ≤ ‖x_t + e‖ := by
        have h2 : L_star * (t + 1) ≤ L_star * ‖x_t - (-e)‖ := le_trans h_diff h_lip
        have h3 : t + 1 ≤ ‖x_t - (-e)‖ := by nlinarith
        rwa [sub_neg_eq_add] at h3
      have hx_eq : x_t = t • e :=
        h_align x_t e t (le_of_lt ht) hx_le he_le h_norm_ge
      rwa [hx_eq] at hVx
    refine ⟨L_star • e, fun X => ?_⟩
    rw [real_inner_smul_left]
    set u : ℝ := V X / L_star
    set v : ℝ := inner ℝ e X
    have hVX : V X = L_star * u := by
      dsimp [u]
      exact (mul_div_cancel₀ (V X) (ne_of_gt hL_pos)).symm
    have h_ray_bounds : ∀ t : ℝ, max 1 |u| ≤ t →
        2 * t * (v - u) ≤ ‖X‖ ^ 2 ∧ 2 * t * (u - v) ≤ ‖X‖ ^ 2 := by
      intro t ht_max
      have ht_ge_one : 1 ≤ t := le_trans (le_max_left 1 |u|) ht_max
      have ht_pos : 0 < t := lt_of_lt_of_le zero_lt_one ht_ge_one
      have ht_nonneg : 0 ≤ t := le_of_lt ht_pos
      have hu_abs : |u| ≤ t := le_trans (le_max_right 1 |u|) ht_max
      have hu_bounds : -t ≤ u ∧ u ≤ t := abs_le.mp hu_abs
      have h_inner_te : inner ℝ X (t • e) = t * v := by
        rw [real_inner_smul_right, real_inner_comm]
      have h_norm_te : ‖t • e‖ ^ 2 = t ^ 2 := by
        rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg ht_nonneg, he_norm, mul_one]
      have hu_sq : 0 ≤ u ^ 2 := sq_nonneg u
      constructor
      · have h_lip1 := hV_lip (t • e) X
        have hV_te := hV_pos_ray t ht_pos
        have h_diff1 : L_star * (t - u) ≤ |V (t • e) - V X| := by
          have h1 : V (t • e) - V X = L_star * (t - u) := by
            rw [hV_te, hVX]
            ring
          linarith [le_abs_self (V (t • e) - V X)]
        have h_le1 : t - u ≤ ‖X - t • e‖ := by
          have h2 : L_star * (t - u) ≤ L_star * ‖t • e - X‖ := le_trans h_diff1 h_lip1
          rw [norm_sub_rev] at h2
          nlinarith
        have h_sq1 : t ^ 2 - 2 * t * u + u ^ 2 ≤ ‖X - t • e‖ ^ 2 := by
          have h_nonneg1 : 0 ≤ t - u := by linarith
          have h_sq : (t - u) ^ 2 ≤ ‖X - t • e‖ ^ 2 := by nlinarith
          linarith [show (t - u) ^ 2 = t ^ 2 - 2 * t * u + u ^ 2 by ring]
        have h_sub_sq := norm_sub_sq_real X (t • e)
        rw [h_inner_te, h_norm_te] at h_sub_sq
        have h_lin1 : 2 * t * v - 2 * t * u ≤ ‖X‖ ^ 2 := by linarith
        linarith [show 2 * t * (v - u) = 2 * t * v - 2 * t * u by ring]
      · have h_lip2 := hV_lip X (-(t • e))
        have hV_nte := hV_neg_ray t ht_pos
        have h_diff2 : L_star * (t + u) ≤ |V X - V (-(t • e))| := by
          have h1 : V X - V (-(t • e)) = L_star * (t + u) := by
            rw [hVX, hV_nte]
            ring
          linarith [le_abs_self (V X - V (-(t • e)))]
        have h_le2 : t + u ≤ ‖X + t • e‖ := by
          have h2 : L_star * (t + u) ≤ L_star * ‖X - -(t • e)‖ := le_trans h_diff2 h_lip2
          rw [sub_neg_eq_add] at h2
          nlinarith
        have h_sq2 : t ^ 2 + 2 * t * u + u ^ 2 ≤ ‖X + t • e‖ ^ 2 := by
          have h_nonneg2 : 0 ≤ t + u := by linarith
          have h_sq : (t + u) ^ 2 ≤ ‖X + t • e‖ ^ 2 := by nlinarith
          linarith [show (t + u) ^ 2 = t ^ 2 + 2 * t * u + u ^ 2 by ring]
        have h_add_sq := norm_add_sq_real X (t • e)
        rw [h_inner_te, h_norm_te] at h_add_sq
        have h_lin2 : 2 * t * u - 2 * t * v ≤ ‖X‖ ^ 2 := by linarith
        linarith [show 2 * t * (u - v) = 2 * t * u - 2 * t * v by ring]
    have huv : u = v := by
      by_contra h_ne
      rcases lt_or_gt_of_ne h_ne with h_lt | h_gt
      · let t₁ : ℝ := max (max 1 |u|) ((‖X‖ ^ 2 + 1) / (2 * (v - u)))
        have ht₁_max : max 1 |u| ≤ t₁ := le_max_left _ _
        have ht₁_frac : (‖X‖ ^ 2 + 1) / (2 * (v - u)) ≤ t₁ := le_max_right _ _
        have h_bound1 : 2 * t₁ * (v - u) ≤ ‖X‖ ^ 2 := (h_ray_bounds t₁ ht₁_max).1
        have h_pos1 : 0 < 2 * (v - u) := by linarith
        have h_ge1 : ‖X‖ ^ 2 + 1 ≤ 2 * t₁ * (v - u) := by
          have h_mul := (div_le_iff₀ h_pos1).mp ht₁_frac
          linarith
        linarith
      · let t₂ : ℝ := max (max 1 |u|) ((‖X‖ ^ 2 + 1) / (2 * (u - v)))
        have ht₂_max : max 1 |u| ≤ t₂ := le_max_left _ _
        have ht₂_frac : (‖X‖ ^ 2 + 1) / (2 * (u - v)) ≤ t₂ := le_max_right _ _
        have h_bound2 : 2 * t₂ * (u - v) ≤ ‖X‖ ^ 2 := (h_ray_bounds t₂ ht₂_max).2
        have h_pos2 : 0 < 2 * (u - v) := by linarith
        have h_ge2 : ‖X‖ ^ 2 + 1 ≤ 2 * t₂ * (u - v) := by
          have h_mul := (div_le_iff₀ h_pos2).mp ht₂_frac
          linarith
        linarith
    rw [hVX, huv]

theorem fixed_center_affine_blowup (d : ℕ) (hd : 3 ≤ d) (L : ℝ) (hL_ge : 1 ≤ L)
    (U₀ : EuclideanSpace ℝ (Fin (d + 1)) → ℝ)
    (z_star : EuclideanSpace ℝ (Fin (d + 1)))
    (R_seq : ℕ → ℝ)
    (hU₀_har : IsInfinityHarmonicOn U₀ (Metric.ball 0 (27 / 32)))
    (hU₀_lip : ∀ z₁ ∈ Metric.ball (0 : EuclideanSpace ℝ (Fin (d + 1))) (27 / 32),
      ∀ z₂ ∈ Metric.ball (0 : EuclideanSpace ℝ (Fin (d + 1))) (27 / 32),
        |U₀ z₁ - U₀ z₂| ≤ L * ‖z₁ - z₂‖)
    (hz_star : z_star ∈ Metric.closedBall (0 : EuclideanSpace ℝ (Fin (d + 1))) (3 / 4))
    (hR_bounds : ∀ i : ℕ, 0 < R_seq i ∧ R_seq i ≤ 1 / 16)
    (hR_tendsto : Filter.Tendsto R_seq Filter.atTop (nhds 0)) :
    ∃ (k₂ : ℕ → ℕ) (P_star : EuclideanSpace ℝ (Fin (d + 1))),
      StrictMono k₂ ∧
      HasUniformLinearLimitOnBall (fun i => isotropicBlowup U₀ z_star (R_seq (k₂ i))) 1 P_star :=
by
  have hU₀_cone : HasSphericalConeComparison U₀ :=
    spherical_cone_comparison d hd U₀ hU₀_har
  obtain ⟨L_star, _, hL_star⟩ :=
    common_infinitesimal_slope_at_center d hd L hL_ge U₀ z_star hU₀_cone hU₀_lip hz_star
  obtain ⟨k₂, V, hk₂, hV0, hV_conv, hV_lip, hV_ext⟩ :=
    blowup_subseq_limit_and_global_lipschitz d hd L hL_ge U₀ z_star R_seq L_star
      hU₀_cone hU₀_lip hz_star hR_bounds hR_tendsto hL_star
  obtain ⟨P_star, hV_lin⟩ :=
    linear_of_global_lipschitz_and_origin_extrema d L_star hL_star.1 V hV0 hV_lip hV_ext
  refine ⟨k₂, P_star, hk₂, fun δ hδ_pos => ?_⟩
  obtain ⟨i₀, hi₀⟩ := hV_conv δ hδ_pos
  refine ⟨i₀, fun i hi X hX => ?_⟩
  rw [← hV_lin X]
  exact hi₀ i hi X hX

theorem three_point_penalized_maximizer (d : ℕ) (hd : 3 ≤ d) (L δ ε : ℝ)
    (hL_ge : 1 ≤ L) (hδ_pos : 0 < δ) (hε_pos : 0 < ε)
    (hε_le : ε ≤ δ / (320 * (1 + 4 * L)))
    (U : EuclideanSpace ℝ (Fin (d + 1)) → ℝ)
    (P_star x₀ y₀ : EuclideanSpace ℝ (Fin (d + 1)))
    (hP_star : ‖P_star‖ ≤ L)
    (hU_lip : ∀ X₁ ∈ Metric.ball (0 : EuclideanSpace ℝ (Fin (d + 1))) 1,
      ∀ X₂ ∈ Metric.ball (0 : EuclideanSpace ℝ (Fin (d + 1))) 1,
        |U X₁ - U X₂| ≤ L * ‖X₁ - X₂‖)
    (hU_approx : ∀ X ∈ Metric.ball (0 : EuclideanSpace ℝ (Fin (d + 1))) 1,
      |U X - inner ℝ P_star X| ≤ ε)
    (hx₀ : x₀ ∈ Metric.ball (0 : EuclideanSpace ℝ (Fin (d + 1))) (1 / 4))
    (hy₀ : y₀ ∈ Metric.ball (0 : EuclideanSpace ℝ (Fin (d + 1))) (1 / 4))
    (h_viol : δ * ‖x₀ - y₀‖ < U x₀ + U y₀ - 2 * U ((1 / 2 : ℝ) • (x₀ + y₀))) :
    let c₀ := (1 / 2 : ℝ) • (x₀ + y₀)
    ∃ (x_hat y_hat z_hat : EuclideanSpace ℝ (Fin (d + 1))),
      x_hat ∈ Metric.ball (0 : EuclideanSpace ℝ (Fin (d + 1))) (3 / 4) ∧
      y_hat ∈ Metric.ball (0 : EuclideanSpace ℝ (Fin (d + 1))) (3 / 4) ∧
      z_hat ∈ Metric.ball (0 : EuclideanSpace ℝ (Fin (d + 1))) (3 / 4) ∧
      0 < ‖x_hat - y_hat‖ ∧
      ‖x_hat - y_hat‖ ≤ 10 * ε / δ ∧
      ‖z_hat - (1 / 2 : ℝ) • (x_hat + y_hat)‖ ≤ 4 * L * ‖x_hat - y_hat‖ ^ 2 ∧
      ‖(1 / 2 : ℝ) • (x_hat + y_hat) - c₀‖ < 1 / 4 ∧
      ∀ x ∈ Metric.closedBall (0 : EuclideanSpace ℝ (Fin (d + 1))) (3 / 4),
        ∀ y ∈ Metric.closedBall (0 : EuclideanSpace ℝ (Fin (d + 1))) (3 / 4),
          ∀ z ∈ Metric.closedBall (0 : EuclideanSpace ℝ (Fin (d + 1))) (3 / 4),
            x ≠ y →
            U x + U y - 2 * U z - threePointPenaltyPsi L δ P_star c₀ x y z ≤
              U x_hat + U y_hat - 2 * U z_hat -
                threePointPenaltyPsi L δ P_star c₀ x_hat y_hat z_hat :=
by
  intro c₀
  let B : Set (EuclideanSpace ℝ (Fin (d + 1))) :=
    Metric.closedBall (0 : EuclideanSpace ℝ (Fin (d + 1))) (3 / 4)
  let w : EuclideanSpace ℝ (Fin (d + 1)) → ℝ := fun X => U X - inner ℝ P_star X
  let Φ : EuclideanSpace ℝ (Fin (d + 1)) → EuclideanSpace ℝ (Fin (d + 1)) →
      EuclideanSpace ℝ (Fin (d + 1)) → ℝ := fun x y z =>
    U x + U y - 2 * U z - threePointPenaltyPsi L δ P_star c₀ x y z
  have hB_sub : ∀ X ∈ B, X ∈ Metric.ball (0 : EuclideanSpace ℝ (Fin (d + 1))) 1 := by
    intro X hX
    rw [Metric.mem_closedBall, dist_zero_right] at hX
    rw [Metric.mem_ball, dist_zero_right]
    linarith
  have hw_bdd : ∀ X ∈ B, |w X| ≤ ε := fun X hX => hU_approx X (hB_sub X hX)
  have hw_lip : ∀ X₁ ∈ B, ∀ X₂ ∈ B, |w X₁ - w X₂| ≤ 2 * L * ‖X₁ - X₂‖ := by
    intro X₁ hX₁ X₂ hX₂
    have h_eq : w X₁ - w X₂ = (U X₁ - U X₂) - inner ℝ P_star (X₁ - X₂) := by
      simp only [w, inner_sub_right]
      ring
    rw [h_eq]
    have h1 := abs_sub (U X₁ - U X₂) (inner ℝ P_star (X₁ - X₂))
    have h2 := hU_lip X₁ (hB_sub X₁ hX₁) X₂ (hB_sub X₂ hX₂)
    have h3 : |inner ℝ P_star (X₁ - X₂)| ≤ L * ‖X₁ - X₂‖ :=
      le_trans (abs_real_inner_le_norm P_star (X₁ - X₂))
        (mul_le_mul_of_nonneg_right hP_star (norm_nonneg _))
    linarith
  have h_mid_mem : ∀ x ∈ B, ∀ y ∈ B, (1 / 2 : ℝ) • (x + y) ∈ B := by
    intro x hx y hy
    rw [Metric.mem_closedBall, dist_zero_right] at hx hy ⊢
    calc ‖(1 / 2 : ℝ) • (x + y)‖
      _ = (1 / 2 : ℝ) * ‖x + y‖ := by
          rw [norm_smul, Real.norm_eq_abs, abs_of_pos (by norm_num)]
      _ ≤ (1 / 2 : ℝ) * (‖x‖ + ‖y‖) := by
          gcongr
          exact norm_add_le x y
      _ ≤ 3 / 4 := by linarith
  have h_xc : ∀ x y : EuclideanSpace ℝ (Fin (d + 1)),
      x - (1 / 2 : ℝ) • (x + y) = (1 / 2 : ℝ) • (x - y) := by
    intro x y
    ext i
    simp [PiLp.add_apply, PiLp.sub_apply, PiLp.smul_apply, smul_eq_mul]
    ring
  have h_yc : ∀ x y : EuclideanSpace ℝ (Fin (d + 1)),
      y - (1 / 2 : ℝ) • (x + y) = -((1 / 2 : ℝ) • (x - y)) := by
    intro x y
    ext i
    simp [PiLp.add_apply, PiLp.sub_apply, PiLp.smul_apply, PiLp.neg_apply, smul_eq_mul]
    ring
