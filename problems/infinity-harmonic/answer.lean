  set e_b : EuclideanSpace ℝ (Fin (d + 1)) := mkSpaceTime 0 1
  have h_norm_eb : ‖e_b‖ = 1 := by
    have hsq : ‖e_b‖ ^ 2 = 1 ^ 2 := by
      dsimp [e_b]
      rw [h_norm_sq (mkSpaceTime 0 1), h_projSpace_mk, h_projTime_mk, norm_zero]
