        _ = ∑ i, θ i * quadEnvelopePlus d 1 v (mkSpaceTime b 0) := by
            congr 1 with i
            rw [hy_opt i]
        _ = (∑ i, θ i) * quadEnvelopePlus d 1 v (mkSpaceTime b 0) := by
            rw [← Finset.sum_mul]
        _ = quadEnvelopePlus d 1 v (mkSpaceTime b 0) := by
            rw [hθ_sum, one_mul]
    rw [h_sum_opt]
  let S_bary : Set ℝ := { val : ℝ | ∃ (N' : ℕ) (θ' : Fin N' → ℝ) (y' : Fin N' → EuclideanSpace ℝ (Fin d)),
    (∀ i, 0 < θ' i) ∧ (∑ i, θ' i = 1) ∧ (∑ i, θ' i • y' i = projSpace (mkSpaceTime (0 : EuclideanSpace ℝ (Fin d)) 1)) ∧
    val = (∑ i, θ' i * v (mkSpaceTime (y' i) (projTime (mkSpaceTime (0 : EuclideanSpace ℝ (Fin d)) 1)))) -
      (∑ i, θ' i * ‖y' i - projSpace (mkSpaceTime (0 : EuclideanSpace ℝ (Fin d)) 1)‖ ^ 2) / (2 * 1) }
  have h_mem : val_star ∈ S_bary := by
    refine ⟨N, θ, y, hθ_pos, hθ_sum, ?_, ?_⟩
    · rw [h_proj_s]; exact hy_mean
    · rw [h_proj_t, h_proj_s]
      simp only [sub_zero, mul_one]
      exact h_att_val.symm
  have h_ub : ∀ val ∈ S_bary, val ≤ val_star := by
    rintro val ⟨N', θ', y', hθ'_pos, hθ'_sum, hy'_mean, rfl⟩
    rw [h_proj_s] at hy'_mean
    rw [h_proj_t, h_proj_s]
    simp only [sub_zero, mul_one]
    rw [h_var N' θ' y' hθ'_sum hy'_mean]
    have h_sum_le : ∑ i, θ' i * (v (mkSpaceTime (y' i) 1) - ‖y' i - b‖ ^ 2 / 2) ≤
        quadEnvelopePlus d 1 v (mkSpaceTime b 0) := by
      calc ∑ i, θ' i * (v (mkSpaceTime (y' i) 1) - ‖y' i - b‖ ^ 2 / 2)
        _ ≤ ∑ i, θ' i * quadEnvelopePlus d 1 v (mkSpaceTime b 0) := by
            apply Finset.sum_le_sum
            intro i _
            exact mul_le_mul_of_nonneg_left (h_le b (y' i)) (le_of_lt (hθ'_pos i))
        _ = (∑ i, θ' i) * quadEnvelopePlus d 1 v (mkSpaceTime b 0) := by
            rw [← Finset.sum_mul]
        _ = quadEnvelopePlus d 1 v (mkSpaceTime b 0) := by
            rw [hθ'_sum, one_mul]
    dsimp [val_star]
    linarith
  have h_bary_eq : barycentricEnvelope d 1 v (mkSpaceTime 0 1) = val_star := by
    change sSup S_bary = val_star
    exact le_antisymm (csSup_le ⟨val_star, h_mem⟩ h_ub) (le_csSup ⟨val_star, h_ub⟩ h_mem)
  exact ⟨N, θ, y, b, hθ_pos, hθ_sum, hy_mean, h_att_val.trans h_bary_eq.symm, hy_opt, h_bary_eq⟩

theorem extremal_barycentric_gap_of_subseq_limit (d : ℕ) (hd : 3 ≤ d) (C₁ : ℝ) (hC₁ : 1 ≤ C₁)
    (κ : ℝ) (hκ_pos : 0 < κ) (h_bounds : HasCenteredClassABounds d C₁)
    (w_seq : ℕ → EuclideanSpace ℝ (Fin (d + 1)) → ℝ)
    (v : EuclideanSpace ℝ (Fin (d + 1)) → ℝ)
    (φ : ℕ → ℕ) (b : EuclideanSpace ℝ (Fin d))
    (hφ : StrictMono φ)
    (hw_seq : ∀ m : ℕ,
      InLimitingClassA d C₁ (w_seq m) ∧
      IsCenteredAt d C₁ (w_seq m) 0 1 ∧
      HasHorizontalJensenBound d κ (w_seq m) ∧
      κ ^ 2 / 2 - κ / ((φ m : ℝ) + 1) ≤
        barycentricEnvelope d 1 (w_seq m) (mkSpaceTime 0 1) - (w_seq m) (mkSpaceTime 0 1))
    (hv_class : InLimitingClassA d C₁ v)
    (hv_cent : IsCenteredAt d C₁ v 0 1)
    (hv_jensen : HasHorizontalJensenBound d κ v)
    (h_conv : ConvergesLocUnif d w_seq v)
    (hb_dual : barycentricEnvelope d 1 v (mkSpaceTime 0 1) =
      quadEnvelopePlus d 1 v (mkSpaceTime b 0) + ‖b‖ ^ 2 / 2) :
    barycentricEnvelope d 1 v (mkSpaceTime 0 1) - v (mkSpaceTime 0 1) = κ ^ 2 / 2 :=
by
  have h_projSpace : ∀ (x : EuclideanSpace ℝ (Fin d)) (t : ℝ),
      projSpace (mkSpaceTime x t) = x := by
    intro x t
    ext i
    simp [projSpace, mkSpaceTime]
  have h_projTime : ∀ (x : EuclideanSpace ℝ (Fin d)) (t : ℝ),
      projTime (mkSpaceTime x t) = t := by
    intro x t
    simp [projTime, mkSpaceTime]
  have h_cont_mk : ∀ (t : ℝ),
      Continuous (fun y : EuclideanSpace ℝ (Fin d) => mkSpaceTime y t) := by
    intro t
    unfold mkSpaceTime
    refine (EuclideanSpace.equiv (Fin (d + 1)) ℝ).symm.continuous.comp ?_
    rw [continuous_pi_iff]
    intro j
    refine Fin.lastCases ?_ ?_ j
    · simp only [Fin.snoc_last]
      exact continuous_const
    · intro i
      simp only [Fin.snoc_castSucc]
      exact (continuous_apply i).comp (EuclideanSpace.equiv (Fin d) ℝ).continuous
  let z₀ : EuclideanSpace ℝ (Fin (d + 1)) := mkSpaceTime 0 1
  have hz₀_space : projSpace z₀ = 0 := h_projSpace 0 1
  have hz₀_time : projTime z₀ = 1 := h_projTime 0 1
  have h_bary_mem : ∀ (f : EuclideanSpace ℝ (Fin (d + 1)) → ℝ),
      f z₀ ∈ { val : ℝ | ∃ (N : ℕ) (θ : Fin N → ℝ) (y : Fin N → EuclideanSpace ℝ (Fin d)),
        (∀ i, 0 < θ i) ∧ (∑ i, θ i = 1) ∧ (∑ i, θ i • y i = projSpace z₀) ∧
        val = (∑ i, θ i * f (mkSpaceTime (y i) (projTime z₀))) -
          (∑ i, θ i * ‖y i - projSpace z₀‖ ^ 2) / (2 * 1) } := by
    intro f
    refine ⟨1, fun _ => 1, fun _ => 0, fun _ => zero_lt_one, by simp, by simp [hz₀_space], ?_⟩
    simp [hz₀_space, hz₀_time, z₀]
  have h_ub : barycentricEnvelope d 1 v z₀ - v z₀ ≤ κ ^ 2 / 2 := by
    have h_le : barycentricEnvelope d 1 v z₀ ≤ v z₀ + κ ^ 2 / 2 := by
      apply csSup_le ⟨v z₀, h_bary_mem v⟩
      rintro val ⟨N, θ, y, hθ_pos, hθ_sum, hy_mean, rfl⟩
      let x : EuclideanSpace ℝ (Fin d) := ∑ i, θ i • y i
      have hx_eq : x = projSpace z₀ := hy_mean
      have hx_zero : x = 0 := hy_mean.trans hz₀_space
      let S_var : ℝ := ∑ i, θ i * ‖y i - x‖ ^ 2
      let r : ℝ := Real.sqrt S_var
      have hS_nonneg : 0 ≤ S_var := by
        apply Finset.sum_nonneg
        intro i _
        exact mul_nonneg (le_of_lt (hθ_pos i)) (sq_nonneg _)
      have hr_sq : r ^ 2 = S_var := Real.sq_sqrt hS_nonneg
      have h_jen := hv_jensen (projTime z₀) N θ y hθ_pos hθ_sum
      change (∑ i, θ i * v (mkSpaceTime (y i) (projTime z₀))) -
        v (mkSpaceTime x (projTime z₀)) ≤ κ * r at h_jen
      have h_mk_x : mkSpaceTime x (projTime z₀) = z₀ := by
        rw [hx_zero, hz₀_time]
      rw [h_mk_x] at h_jen
      have h_var_eq : (∑ i, θ i * ‖y i - projSpace z₀‖ ^ 2) = r ^ 2 := by
        rw [← hx_eq, hr_sq]
      rw [h_var_eq]
      have h_sq_nonneg : 0 ≤ (r - κ) ^ 2 := sq_nonneg (r - κ)
      linarith
    linarith
  let zb : EuclideanSpace ℝ (Fin (d + 1)) := mkSpaceTime b 0
  have hzb_space : projSpace zb = b := h_projSpace b 0
  have hzb_time : projTime zb = 0 := h_projTime b 0
  obtain ⟨M, hM_pos, hM⟩ := h_bounds.1 (1 / 4) (by norm_num)
  let R_star : ℝ := max (max M (8 * ‖b‖)) 1
  have hR_ge_M : M ≤ R_star := le_trans (le_max_left M (8 * ‖b‖)) (le_max_left _ 1)
  have hR_ge_b : 8 * ‖b‖ ≤ R_star := le_trans (le_max_right M (8 * ‖b‖)) (le_max_left _ 1)
  have hR_ge_one : (1 : ℝ) ≤ R_star := le_max_right _ 1
  have hR_pos : 0 < R_star := lt_of_lt_of_le zero_lt_one hR_ge_one
  have h_tail : ∀ (w : EuclideanSpace ℝ (Fin (d + 1)) → ℝ) (y : EuclideanSpace ℝ (Fin d)),
      R_star ≤ ‖y‖ → |w (mkSpaceTime y 1)| ≤ (1 / 4 : ℝ) * ‖y‖ ^ 2 →
      w (mkSpaceTime y 1) - ‖y - b‖ ^ 2 / 2 ≤ - ‖b‖ ^ 2 / 2 := by
    intro w y hy_R hw_growth
    have hw_le : w (mkSpaceTime y 1) ≤ (1 / 4 : ℝ) * ‖y‖ ^ 2 :=
      le_trans (le_abs_self _) hw_growth
    have h_norm_sub : ‖y - b‖ ^ 2 = ‖y‖ ^ 2 - 2 * inner ℝ y b + ‖b‖ ^ 2 :=
      norm_sub_sq_real y b
    have h_inner : inner ℝ y b ≤ ‖y‖ * ‖b‖ :=
      le_trans (le_abs_self _) (abs_real_inner_le_norm y b)
    have hy_nonneg : 0 ≤ ‖y‖ := norm_nonneg y
    have h_yb : 8 * (‖y‖ * ‖b‖) ≤ ‖y‖ ^ 2 := by
      have h8b : 8 * ‖b‖ ≤ ‖y‖ := le_trans hR_ge_b hy_R
      nlinarith
    have hy_sq : 0 ≤ ‖y‖ ^ 2 := sq_nonneg ‖y‖
    linarith
  let g_v : EuclideanSpace ℝ (Fin d) → ℝ := fun y =>
    v (mkSpaceTime y (projTime zb + 1)) - ‖y - projSpace zb‖ ^ 2 / (2 * 1)
  have hg_v_eq : ∀ y : EuclideanSpace ℝ (Fin d),
      g_v y = v (mkSpaceTime y 1) - ‖y - b‖ ^ 2 / 2 := by
    intro y
    dsimp [g_v]
    rw [hzb_time, zero_add, hzb_space]
    ring
  have hg_v_cont : Continuous g_v := by
    refine Continuous.sub ?_ ?_
    · exact hv_class.1.comp (h_cont_mk (projTime zb + 1))
    · exact ((continuous_norm.comp (continuous_id.sub continuous_const)).pow 2).div_const (2 * 1)
  have h_bdd_v : BddAbove (g_v '' Set.univ) := by
    obtain ⟨U₀, hU₀⟩ :=
      (ProperSpace.isCompact_closedBall (0 : EuclideanSpace ℝ (Fin d)) R_star).bddAbove_image
        hg_v_cont.continuousOn
    refine ⟨max U₀ (- ‖b‖ ^ 2 / 2), ?_⟩
    rintro _ ⟨y, -, rfl⟩
    rcases le_or_gt ‖y‖ R_star with hy_le | hy_gt
    · have hy_mem : y ∈ Metric.closedBall (0 : EuclideanSpace ℝ (Fin d)) R_star := by
        simpa [Metric.mem_closedBall, dist_zero_right] using hy_le
      exact le_trans (hU₀ ⟨y, hy_mem, rfl⟩) (le_max_left _ _)
    · have hy_R : R_star ≤ ‖y‖ := le_of_lt hy_gt
      have hy_M : M ≤ ‖y‖ := le_trans hR_ge_M hy_R
      have h_est := h_tail v y hy_R (hM v hv_class hv_cent y hy_M)
      rw [← hg_v_eq y] at h_est
      exact le_trans h_est (le_max_right _ _)
  have hv_le_quad : ∀ y : EuclideanSpace ℝ (Fin d),
      v (mkSpaceTime y 1) - ‖y - b‖ ^ 2 / 2 ≤ quadEnvelopePlus d 1 v zb := by
    intro y
    rw [← hg_v_eq y]
    exact le_csSup h_bdd_v ⟨y, Set.mem_univ y, rfl⟩
  have h_quad_lb : - ‖b‖ ^ 2 / 2 ≤ quadEnvelopePlus d 1 v zb := by
    simpa [hv_cent.1, neg_div] using hv_le_quad 0
  have h_lb_dual : κ ^ 2 / 2 ≤ quadEnvelopePlus d 1 v zb + ‖b‖ ^ 2 / 2 := by
    apply le_of_forall_pos_le_add
    intro ε hε
    have hε2 : 0 < ε / 2 := by linarith
    obtain ⟨N₀, hN₀⟩ := h_conv R_star hR_pos (ε / 2) hε2
    obtain ⟨K, hK⟩ := exists_nat_gt (2 * κ / ε)
    let m : ℕ := max N₀ K
    have hm_N₀ : N₀ ≤ m := le_max_left N₀ K
    have hm_K : K ≤ m := le_max_right N₀ K
    have hφ_m : m ≤ φ m := hφ.id_le m
    have hK_φ : (K : ℝ) ≤ (φ m : ℝ) := by exact_mod_cast le_trans hm_K hφ_m
    have hφ_pos : (0 : ℝ) < (φ m : ℝ) + 1 := by positivity
    have h_err : κ / ((φ m : ℝ) + 1) ≤ ε / 2 := by
      rw [div_le_iff₀ hφ_pos]
      have h1 : 2 * κ / ε < (φ m : ℝ) + 1 := by linarith
      have h2 := (div_lt_iff₀ hε).mp h1
      linarith
    have hw_pt : ∀ y : EuclideanSpace ℝ (Fin d),
        w_seq m (mkSpaceTime y 1) - ‖y - b‖ ^ 2 / 2 ≤ quadEnvelopePlus d 1 v zb + ε / 2 := by
      intro y
      rcases le_or_gt ‖y‖ R_star with hy_le | hy_gt
      · have h_diff := hN₀ m hm_N₀ (mkSpaceTime y 1)
          (by simpa [h_projSpace] using hy_le)
          (by rw [h_projTime, abs_of_pos zero_lt_one]; exact hR_ge_one)
        have hw_le_v : w_seq m (mkSpaceTime y 1) ≤ v (mkSpaceTime y 1) + ε / 2 := by
          linarith [(abs_sub_le_iff.mp h_diff).1]
        have hv_y := hv_le_quad y
        linarith
      · have hy_R : R_star ≤ ‖y‖ := le_of_lt hy_gt
        have hy_M : M ≤ ‖y‖ := le_trans hR_ge_M hy_R
        have h_est := h_tail (w_seq m) y hy_R
          (hM (w_seq m) (hw_seq m).1 (hw_seq m).2.1 y hy_M)
        linarith
    have hw_bary_le : barycentricEnvelope d 1 (w_seq m) z₀ ≤
        quadEnvelopePlus d 1 v zb + ‖b‖ ^ 2 / 2 + ε / 2 := by
      apply csSup_le ⟨w_seq m z₀, h_bary_mem (w_seq m)⟩
      rintro val ⟨N, θ, y, hθ_pos, hθ_sum, hy_mean, rfl⟩
      have hy_zero : ∑ i, θ i • y i = 0 := hy_mean.trans hz₀_space
      have h_var_shift : (∑ i, θ i * ‖y i - b‖ ^ 2) =
          (∑ i, θ i * ‖y i - projSpace z₀‖ ^ 2) + ‖b‖ ^ 2 := by
        have h_sub_sq : ∀ i : Fin N,
            θ i * ‖y i - b‖ ^ 2 =
              θ i * ‖y i - projSpace z₀‖ ^ 2 - 2 * inner ℝ (θ i • y i) b + θ i * ‖b‖ ^ 2 := by
          intro i
          rw [hz₀_space, sub_zero, norm_sub_sq_real (y i) b, real_inner_smul_left]
          ring
        simp_rw [h_sub_sq, Finset.sum_add_distrib, Finset.sum_sub_distrib, ← Finset.mul_sum,
          ← sum_inner, hy_zero, inner_zero_left, mul_zero, sub_zero, ← Finset.sum_mul,
          hθ_sum, one_mul]
      have h_sum_pt : (∑ i, θ i * (w_seq m (mkSpaceTime (y i) 1) - ‖y i - b‖ ^ 2 / 2)) ≤
          quadEnvelopePlus d 1 v zb + ε / 2 := by
        calc ∑ i, θ i * (w_seq m (mkSpaceTime (y i) 1) - ‖y i - b‖ ^ 2 / 2)
          _ ≤ ∑ i, θ i * (quadEnvelopePlus d 1 v zb + ε / 2) := by
              apply Finset.sum_le_sum
              intro i _
              exact mul_le_mul_of_nonneg_left (hw_pt (y i)) (le_of_lt (hθ_pos i))
          _ = (∑ i, θ i) * (quadEnvelopePlus d 1 v zb + ε / 2) := by
              rw [← Finset.sum_mul]
          _ = quadEnvelopePlus d 1 v zb + ε / 2 := by
              rw [hθ_sum, one_mul]
      have h_lhs_id : (∑ i, θ i * (w_seq m (mkSpaceTime (y i) 1) - ‖y i - b‖ ^ 2 / 2)) =
          (∑ i, θ i * w_seq m (mkSpaceTime (y i) (projTime z₀))) -
            (∑ i, θ i * ‖y i - b‖ ^ 2) / 2 := by
        rw [hz₀_time, Finset.sum_div]
        rw [← Finset.sum_sub_distrib]
        congr 1 with i
        ring
      linarith
    have hw_gap := (hw_seq m).2.2.2
    have hw_zero : w_seq m z₀ = 0 := (hw_seq m).2.1.1
    linarith
  have hv_zero : v z₀ = 0 := hv_cent.1
  linarith

theorem extremal_limit_and_barycentric_attainment (d : ℕ) (hd : 3 ≤ d) (C₁ : ℝ) (hC₁ : 1 ≤ C₁)
    (κ : ℝ) (hκ_pos : 0 < κ)
    (v_seq : ℕ → EuclideanSpace ℝ (Fin (d + 1)) → ℝ)
    (hv_seq : ∀ j : ℕ,
      InLimitingClassA d C₁ (v_seq j) ∧
      IsCenteredAt d C₁ (v_seq j) 0 1 ∧
      HasHorizontalJensenBound d κ (v_seq j) ∧
      κ ^ 2 / 2 - κ / ((j : ℝ) + 1) ≤
        barycentricEnvelope d 1 (v_seq j) (mkSpaceTime 0 1) - (v_seq j) (mkSpaceTime 0 1)) :
    ∃ (v : EuclideanSpace ℝ (Fin (d + 1)) → ℝ)
      (N : ℕ) (θ : Fin N → ℝ) (y : Fin N → EuclideanSpace ℝ (Fin d))
      (b : EuclideanSpace ℝ (Fin d)),
      InLimitingClassA d C₁ v ∧
      IsCenteredAt d C₁ v 0 1 ∧
      HasHorizontalJensenBound d κ v ∧
      barycentricEnvelope d 1 v (mkSpaceTime 0 1) - v (mkSpaceTime 0 1) = κ ^ 2 / 2 ∧
      (∀ i, 0 < θ i) ∧
      (∑ i, θ i = 1) ∧
      (∑ i, θ i • y i = 0) ∧
      (∑ i, θ i * v (mkSpaceTime (y i) 1)) - (∑ i, θ i * ‖y i‖ ^ 2) / 2 =
        barycentricEnvelope d 1 v (mkSpaceTime 0 1) ∧
      (∀ i, v (mkSpaceTime (y i) 1) - ‖y i - b‖ ^ 2 / 2 =
        quadEnvelopePlus d 1 v (mkSpaceTime b 0)) :=
by
  have h_bounds : HasCenteredClassABounds d C₁ :=
    centered_class_A_equicontinuity_and_growth d hd C₁ hC₁
  obtain ⟨v, φ, hφ, hv_class, hv_cent, hv_jensen, h_conv⟩ :=
    centered_class_A_subseq_limit d hd C₁ hC₁ κ hκ_pos h_bounds v_seq
      (fun j => ⟨(hv_seq j).1, (hv_seq j).2.1, (hv_seq j).2.2.1⟩)
  have hv_subquad : ∀ ε : ℝ, 0 < ε → ∃ M : ℝ, 0 < M ∧
      ∀ y : EuclideanSpace ℝ (Fin d), M ≤ ‖y‖ → |v (mkSpaceTime y 1)| ≤ ε * ‖y‖ ^ 2 := by
    intro ε hε
    obtain ⟨M, hM_pos, hM⟩ := h_bounds.1 ε hε
    exact ⟨M, hM_pos, hM v hv_class hv_cent⟩
  obtain ⟨N, θ, y, b, hθ_pos, hθ_sum, hy_mean, hy_att, hy_opt, hb_dual⟩ :=
    barycentric_duality_and_caratheodory_attainment d hd v hv_class.1 hv_subquad
  have hv_gap : barycentricEnvelope d 1 v (mkSpaceTime 0 1) - v (mkSpaceTime 0 1) = κ ^ 2 / 2 :=
    extremal_barycentric_gap_of_subseq_limit d hd C₁ hC₁ κ hκ_pos h_bounds
      (fun m => v_seq (φ m)) v φ b hφ (fun m => hv_seq (φ m))
      hv_class hv_cent hv_jensen h_conv hb_dual
  exact ⟨v, N, θ, y, b, hv_class, hv_cent, hv_jensen, hv_gap,
    hθ_pos, hθ_sum, hy_mean, hy_att, hy_opt⟩

theorem subquadratic_growth_of_inLimitingClassA (d : ℕ) (C₁ : ℝ) (hC₁ : 0 ≤ C₁)
    (v : EuclideanSpace ℝ (Fin (d + 1)) → ℝ) (hv : InLimitingClassA d C₁ v)
    (t₁ t₂ ε : ℝ) (hε : 0 < ε) :
    ∃ M : ℝ, ∀ (y : EuclideanSpace ℝ (Fin d)) (s : ℝ),
      t₁ ≤ s → s ≤ t₂ → |v (mkSpaceTime y s)| ≤ M + ε * ‖y‖ ^ 2 :=
by
  have h_two_scale : ∀ (R : ℝ), 0 < R →
      ∀ (p p' : EuclideanSpace ℝ (Fin d)) (a a' : ℝ),
        IsFitAt d C₁ v 0 0 R p a →
        IsFitAt d C₁ v 0 0 (2 * R) p' a' →
        ‖p' - p‖ ≤ 3 * C₁ ∧ |a' - a| ≤ 3 * C₁ * (1 + 3 * C₁) + (9 / 2) * C₁ ^ 2 := by
    intro R hR p p' a a' hfit1 hfit2
    have hp_diff : ‖p' - p‖ ≤ 3 * C₁ := by
      by_cases hp : ‖p' - p‖ = 0
      · linarith
      · have hp_pos : 0 < ‖p' - p‖ := lt_of_le_of_ne (norm_nonneg _) (Ne.symm hp)
        let h : EuclideanSpace ℝ (Fin d) := (R / ‖p' - p‖) • (p' - p)
        have hh_norm : ‖h‖ = R := by
          dsimp [h]
          rw [norm_smul, Real.norm_eq_abs, abs_of_pos (div_pos hR hp_pos), div_mul_cancel₀ R hp]
        have h1 := hfit1 h 0 (by simp [le_of_lt hR]) (by simp [hh_norm])
        have h2 := hfit2 h 0 (by simp; linarith) (by simp [hh_norm]; linarith)
        simp only [zero_add, mul_zero, sub_zero] at h1 h2
        have h_inner : inner ℝ p' h - inner ℝ p h = R * ‖p' - p‖ := by
          rw [← inner_sub_left]
          dsimp [h]
          rw [real_inner_smul_right, real_inner_self_eq_norm_sq]
          have h_ring : R / ‖p' - p‖ * ‖p' - p‖ ^ 2 = R / ‖p' - p‖ * ‖p' - p‖ * ‖p' - p‖ := by ring
          rw [h_ring, div_mul_cancel₀ R hp]
        have h1_le := (abs_le.mp h1).2
        have h2_le := (abs_le.mp h2).1
        nlinarith
    refine ⟨hp_diff, ?_⟩
    let ℓ : ℝ := R / (1 + 3 * C₁)
    have h_denom : 0 < 1 + 3 * C₁ := by linarith
    have hℓ_pos : 0 < ℓ := div_pos hR h_denom
    have hℓ_eq : (1 + 3 * C₁) * ℓ = R := mul_div_cancel₀ R (ne_of_gt h_denom)
    have hCℓ_nonneg : 0 ≤ C₁ * ℓ := mul_nonneg hC₁ (le_of_lt hℓ_pos)
    have hℓ_le_R : |ℓ| ≤ R := by
      rw [abs_of_pos hℓ_pos]
      linarith
    have hℓ_le_2R : |ℓ| ≤ 2 * R := by linarith
    have hh1 : ‖ℓ • p - ℓ • p‖ ≤ R := by
      simp [le_of_lt hR]
    have hh2 : ‖ℓ • p - ℓ • p'‖ ≤ 2 * R := by
      rw [← smul_sub, norm_smul, Real.norm_eq_abs, abs_of_pos hℓ_pos, norm_sub_rev]
      nlinarith
    have h1 := hfit1 (ℓ • p) ℓ hℓ_le_R hh1
    have h2 := hfit2 (ℓ • p) ℓ hℓ_le_2R hh2
    simp only [zero_add] at h1 h2
    have h_ip1 : inner ℝ p (ℓ • p) = ℓ * ‖p‖ ^ 2 := by
      rw [real_inner_smul_right, real_inner_self_eq_norm_sq]
    have h_ip2 : inner ℝ p' (ℓ • p) = ℓ * inner ℝ p' p := by
      rw [real_inner_smul_right]
    have h_sq : ‖p' - p‖ ^ 2 = ‖p'‖ ^ 2 - 2 * inner ℝ p' p + ‖p‖ ^ 2 :=
      norm_sub_sq_real p' p
    have h_p_sq_le : ‖p' - p‖ ^ 2 ≤ 9 * C₁ ^ 2 := by
      have : 0 ≤ ‖p' - p‖ := norm_nonneg _
      nlinarith
    have h_alg : (inner ℝ p (ℓ • p) + (a - ‖p‖ ^ 2 / 2) * ℓ) -
        (inner ℝ p' (ℓ • p) + (a' - ‖p'‖ ^ 2 / 2) * ℓ) =
        ℓ * (a - a' + ‖p' - p‖ ^ 2 / 2) := by
      rw [h_ip1, h_ip2, h_sq]
      ring
    have h1a := (abs_le.mp h1).1
    have h1b := (abs_le.mp h1).2
    have h2a := (abs_le.mp h2).1
    have h2b := (abs_le.mp h2).2
    rw [abs_le]
    constructor
    · nlinarith
    · nlinarith
  have h_exists : ∀ k : ℕ, ∃ (p : EuclideanSpace ℝ (Fin d)) (a : ℝ),
      IsFitAt d C₁ v 0 0 ((2 : ℝ) ^ k) p a :=
    fun k => hv.2.2.2 0 0 ((2 : ℝ) ^ k) (by positivity)
  choose p a hfit using h_exists
  let C₂ : ℝ := 3 * C₁ * (1 + 3 * C₁) + (9 / 2) * C₁ ^ 2
  have hC₂_nonneg : 0 ≤ C₂ := by positivity
  have h_step : ∀ k : ℕ, ‖p (k + 1) - p k‖ ≤ 3 * C₁ ∧ |a (k + 1) - a k| ≤ C₂ := by
    intro k
    have hfit_succ : IsFitAt d C₁ v 0 0 (2 * (2 : ℝ) ^ k) (p (k + 1)) (a (k + 1)) := by
      simpa [pow_succ'] using hfit (k + 1)
    exact h_two_scale ((2 : ℝ) ^ k) (by positivity) (p k) (p (k + 1)) (a k) (a (k + 1))
      (hfit k) hfit_succ
  have hp_lin : ∀ k : ℕ, ‖p k‖ ≤ ‖p 0‖ + 3 * C₁ * (k : ℝ) := by
    intro k
    induction k with
    | zero => simp
    | succ k ih =>
      have h_tri : ‖p (k + 1)‖ ≤ ‖p k‖ + ‖p (k + 1) - p k‖ := by
        calc ‖p (k + 1)‖ = ‖p k + (p (k + 1) - p k)‖ := by rw [add_sub_cancel]
          _ ≤ ‖p k‖ + ‖p (k + 1) - p k‖ := norm_add_le _ _
      have h_diff := (h_step k).1
      push_cast
      linarith
  have ha_lin : ∀ k : ℕ, |a k| ≤ |a 0| + C₂ * (k : ℝ) := by
    intro k
    induction k with
    | zero => simp
    | succ k ih =>
      have h_tri : |a (k + 1)| ≤ |a k| + |a (k + 1) - a k| := by
        calc |a (k + 1)| = |a k + (a (k + 1) - a k)| := by rw [add_sub_cancel]
          _ ≤ |a k| + |a (k + 1) - a k| := abs_add_le _ _
      have h_diff := (h_step k).2
      push_cast
      linarith
  let B₁ : ℝ := max (‖p 0‖ + 3 * C₁ + 1) (|a 0| + C₂ + 1)
  have hB₁_ge_one : 1 ≤ B₁ := by
    have : 1 ≤ ‖p 0‖ + 3 * C₁ + 1 := by
      have : 0 ≤ ‖p 0‖ := norm_nonneg _
      linarith
    exact le_trans this (le_max_left _ _)
  have h_pow54 : ∀ k : ℕ, (k : ℝ) + 4 ≤ 4 * (5 / 4 : ℝ) ^ k := by
    intro k
    induction k with
    | zero => norm_num
    | succ k ih =>
      push_cast
      rw [pow_succ']
      have hk : (0 : ℝ) ≤ (k : ℝ) := Nat.cast_nonneg k
      linarith
  have h_pow85 : ∀ k : ℕ, 1 + (3 / 5 : ℝ) * (k : ℝ) ≤ (8 / 5 : ℝ) ^ k := by
    intro k
    induction k with
    | zero => norm_num
    | succ k ih =>
      push_cast
      rw [pow_succ']
      have hk : (0 : ℝ) ≤ (k : ℝ) := Nat.cast_nonneg k
      linarith
  have h_pow2 : ∀ k : ℕ, (k : ℝ) ≤ (2 : ℝ) ^ k := by
    intro k
    induction k with
    | zero => norm_num
    | succ k ih =>
      push_cast
      rw [pow_succ']
      have h1 : (1 : ℝ) ≤ (2 : ℝ) ^ k := one_le_pow₀ (by norm_num)
      linarith
  let B₀ : ℝ := 4 * B₁
  have hB₀_ge : 4 ≤ B₀ := by dsimp [B₀]; linarith
  have hp_exp : ∀ k : ℕ, ‖p k‖ ≤ B₀ * (5 / 4 : ℝ) ^ k := by
    intro k
    have hk_nonneg : (0 : ℝ) ≤ (k : ℝ) := Nat.cast_nonneg k
    have hB₁_left : ‖p 0‖ + 3 * C₁ + 1 ≤ B₁ := le_max_left _ _
    have h1 := hp_lin k
    have h2 := h_pow54 k
    have h_p0 : 0 ≤ ‖p 0‖ := norm_nonneg _
    dsimp [B₀]
    nlinarith
  have ha_exp : ∀ k : ℕ, |a k| ≤ B₀ * (5 / 4 : ℝ) ^ k := by
    intro k
    have hk_nonneg : (0 : ℝ) ≤ (k : ℝ) := Nat.cast_nonneg k
    have hB₁_right : |a 0| + C₂ + 1 ≤ B₁ := le_max_right _ _
    have h1 := ha_lin k
    have h2 := h_pow54 k
    have h_a0 : 0 ≤ |a 0| := abs_nonneg _
    dsimp [B₀]
    nlinarith
  let T : ℝ := max |t₁| |t₂| + 1
  have hT_ge_one : 1 ≤ T := by
    have : 0 ≤ max |t₁| |t₂| := le_trans (abs_nonneg t₁) (le_max_left _ _)
    dsimp [T]; linarith
  let K_req : ℝ := (5 / 4) * max (T * B₀) ((4 / ε) * ((3 / 2) * B₀ + 1 + 2 * C₁))
  obtain ⟨k₀, hk₀⟩ := exists_nat_ge ((5 / 3) * K_req)
  have hK_dom : ∀ m : ℕ, K_req * (5 / 4 : ℝ) ^ (k₀ + m) ≤ (2 : ℝ) ^ (k₀ + m) := by
    intro m
    have h_k0_le : K_req ≤ (8 / 5 : ℝ) ^ k₀ := by
      have h_b := h_pow85 k₀
      linarith
    have h_km_le : (8 / 5 : ℝ) ^ k₀ ≤ (8 / 5 : ℝ) ^ (k₀ + m) :=
      pow_le_pow_right₀ (by norm_num) (Nat.le_add_right k₀ m)
    have h_prod : (8 / 5 : ℝ) ^ (k₀ + m) * (5 / 4 : ℝ) ^ (k₀ + m) = (2 : ℝ) ^ (k₀ + m) := by
      rw [← mul_pow]
      norm_num
    have h_pos : (0 : ℝ) ≤ (5 / 4 : ℝ) ^ (k₀ + m) := by positivity
    nlinarith
  have h_shell_bound : ∀ (m : ℕ) (y : EuclideanSpace ℝ (Fin d)) (s : ℝ),
      t₁ ≤ s → s ≤ t₂ → ‖y‖ ≤ (2 : ℝ) ^ (k₀ + m) →
      |v (mkSpaceTime y s)| ≤ |v (mkSpaceTime 0 0)| + (ε / 4) * ((2 : ℝ) ^ (k₀ + m)) ^ 2 := by
    intro m y s hs1 hs2 hy
    let k : ℕ := k₀ + m + 1
    have hs_abs : |s| ≤ T := by
      have h_t1 : -max |t₁| |t₂| ≤ t₁ := by
        have : -|t₁| ≤ t₁ := neg_abs_le t₁
        have : |t₁| ≤ max |t₁| |t₂| := le_max_left _ _
        linarith
      have h_t2 : t₂ ≤ max |t₁| |t₂| := le_trans (le_abs_self t₂) (le_max_right _ _)
      rw [abs_le]
      dsimp [T]
      constructor <;> linarith
    have h_pow54_k : (5 / 4 : ℝ) ^ k = (5 / 4) * (5 / 4 : ℝ) ^ (k₀ + m) := by
      dsimp [k]
      rw [pow_succ']
    have h_pow2_k : (2 : ℝ) ^ k = 2 * (2 : ℝ) ^ (k₀ + m) := by
      dsimp [k]
      rw [pow_succ']
    have h_54_ge_one : 1 ≤ (5 / 4 : ℝ) ^ (k₀ + m) := one_le_pow₀ (by norm_num)
    have hK_left : (5 / 4) * (T * B₀) ≤ K_req := by
      dsimp [K_req]
      have : T * B₀ ≤ max (T * B₀) ((4 / ε) * ((3 / 2) * B₀ + 1 + 2 * C₁)) := le_max_left _ _
      linarith
    have hK_right : (5 / 4) * ((3 / 2) * B₀ + 1 + 2 * C₁) ≤ (ε / 4) * K_req := by
      have h_max : (4 / ε) * ((3 / 2) * B₀ + 1 + 2 * C₁) ≤
          max (T * B₀) ((4 / ε) * ((3 / 2) * B₀ + 1 + 2 * C₁)) := le_max_right _ _
      have h_mul := mul_le_mul_of_nonneg_left h_max (show 0 ≤ (5 / 4) * (ε / 4) by positivity)
      have h_eq : (5 / 4) * (ε / 4) * ((4 / ε) * ((3 / 2) * B₀ + 1 + 2 * C₁)) =
          (5 / 4) * ((3 / 2) * B₀ + 1 + 2 * C₁) := by
        field_simp [ne_of_gt hε]
      have h_eq2 : (5 / 4) * (ε / 4) * max (T * B₀) ((4 / ε) * ((3 / 2) * B₀ + 1 + 2 * C₁)) =
          (ε / 4) * K_req := by
        dsimp [K_req]
        ring
      linarith
    have h_dom_m := hK_dom m
    have h_pk_bound : ‖p k‖ ≤ B₀ * ((5 / 4) * (5 / 4 : ℝ) ^ (k₀ + m)) := by
      simpa [h_pow54_k] using hp_exp k
    have h_ak_bound : |a k| ≤ B₀ * ((5 / 4) * (5 / 4 : ℝ) ^ (k₀ + m)) := by
      simpa [h_pow54_k] using ha_exp k
    have h_T_pk : T * ‖p k‖ ≤ (2 : ℝ) ^ (k₀ + m) := by nlinarith
    have h_T_ak : T * |a k| ≤ (2 : ℝ) ^ (k₀ + m) := by nlinarith
    have h_T_K : T ≤ K_req := by nlinarith
    have h_T_le : T ≤ (2 : ℝ) ^ (k₀ + m) := by nlinarith
    have h_coeff : (3 / 2) * ‖p k‖ + 1 + 2 * C₁ ≤ (ε / 4) * (2 : ℝ) ^ (k₀ + m) := by
      have h_pk_nonneg : 0 ≤ ‖p k‖ := norm_nonneg _
      nlinarith
    have hs_le_2k : |s| ≤ (2 : ℝ) ^ k := by
      have : (0 : ℝ) ≤ (2 : ℝ) ^ (k₀ + m) := by positivity
      linarith
    have hy_sp : ‖y - s • p k‖ ≤ (2 : ℝ) ^ k := by
      have h_tri : ‖y - s • p k‖ ≤ ‖y‖ + ‖s • p k‖ := norm_sub_le y (s • p k)
      rw [norm_smul, Real.norm_eq_abs] at h_tri
      have : |s| * ‖p k‖ ≤ T * ‖p k‖ :=
        mul_le_mul_of_nonneg_right hs_abs (norm_nonneg _)
      linarith
    have h_fit_ys := hfit k y s hs_le_2k hy_sp
    simp only [zero_add] at h_fit_ys
    rw [h_pow2_k, sub_mul] at h_fit_ys
    have h_cs : |inner ℝ (p k) y| ≤ ‖p k‖ * (2 : ℝ) ^ (k₀ + m) := by
      calc |inner ℝ (p k) y| ≤ ‖p k‖ * ‖y‖ := abs_real_inner_le_norm (p k) y
        _ ≤ ‖p k‖ * (2 : ℝ) ^ (k₀ + m) :=
            mul_le_mul_of_nonneg_left hy (norm_nonneg _)
    have h_as : |a k * s| ≤ (2 : ℝ) ^ (k₀ + m) := by
      rw [abs_mul]
      have : |a k| * |s| ≤ |a k| * T :=
        mul_le_mul_of_nonneg_left hs_abs (abs_nonneg _)
      linarith
    have h_ps : ‖p k‖ ^ 2 / 2 * |s| ≤ (1 / 2) * ‖p k‖ * (2 : ℝ) ^ (k₀ + m) := by
      have h1 : ‖p k‖ ^ 2 / 2 * |s| ≤ ‖p k‖ ^ 2 / 2 * T :=
        mul_le_mul_of_nonneg_left hs_abs (by positivity)
      have h2 : (1 / 2) * ‖p k‖ * (T * ‖p k‖) ≤ (1 / 2) * ‖p k‖ * (2 : ℝ) ^ (k₀ + m) :=
        mul_le_mul_of_nonneg_left h_T_pk (by positivity)
      linarith
    have h_ps_abs : |‖p k‖ ^ 2 / 2 * s| ≤ (1 / 2) * ‖p k‖ * (2 : ℝ) ^ (k₀ + m) := by
      rw [abs_mul, abs_of_nonneg (show 0 ≤ ‖p k‖ ^ 2 / 2 by positivity)]
      exact h_ps
    have h_v_diff : |v (mkSpaceTime y s)| - |v (mkSpaceTime 0 0)| ≤
        |v (mkSpaceTime y s) - v (mkSpaceTime 0 0)| := abs_sub_abs_le_abs_sub _ _
    have h_f1 := (abs_le.mp h_fit_ys).1
    have h_f2 := (abs_le.mp h_fit_ys).2
    have h_cs1 := (abs_le.mp h_cs).1
    have h_cs2 := (abs_le.mp h_cs).2
    have h_as1 := (abs_le.mp h_as).1
    have h_as2 := (abs_le.mp h_as).2
    have h_ps1 := (abs_le.mp h_ps_abs).1
    have h_ps2 := (abs_le.mp h_ps_abs).2
    have h_2m_nonneg : (0 : ℝ) ≤ (2 : ℝ) ^ (k₀ + m) := by positivity
    have h_v_abs : |v (mkSpaceTime y s) - v (mkSpaceTime 0 0)| ≤
        ((3 / 2) * ‖p k‖ + 1 + 2 * C₁) * (2 : ℝ) ^ (k₀ + m) := by
      rw [abs_le]
      constructor <;> nlinarith
    nlinarith
  let M : ℝ := |v (mkSpaceTime 0 0)| + (ε / 4) * ((2 : ℝ) ^ k₀) ^ 2
  have h_ind : ∀ (m : ℕ) (y : EuclideanSpace ℝ (Fin d)) (s : ℝ),
      t₁ ≤ s → s ≤ t₂ → ‖y‖ ≤ (2 : ℝ) ^ (k₀ + m) →
      |v (mkSpaceTime y s)| ≤ M + ε * ‖y‖ ^ 2 := by
    intro m
    induction m with
    | zero =>
      intro y s hs1 hs2 hy
      have h0 := h_shell_bound 0 y s hs1 hs2 (by simpa using hy)
      simp only [Nat.add_zero] at h0
      have : 0 ≤ ε * ‖y‖ ^ 2 := by positivity
      dsimp [M]
      linarith
    | succ m ih =>
      intro y s hs1 hs2 hy
      rcases le_total ‖y‖ ((2 : ℝ) ^ (k₀ + m)) with hy_le | hy_ge
      · exact ih y s hs1 hs2 hy_le
      · have h_sh := h_shell_bound (m + 1) y s hs1 hs2 (by simpa [Nat.add_assoc] using hy)
        have h_pow_succ : (2 : ℝ) ^ (k₀ + (m + 1)) = 2 * (2 : ℝ) ^ (k₀ + m) := by
          rw [← Nat.add_assoc, pow_succ']
        rw [h_pow_succ] at h_sh
        have h_sq_le : ((2 : ℝ) ^ (k₀ + m)) ^ 2 ≤ ‖y‖ ^ 2 :=
          pow_le_pow_left₀ (by positivity) hy_ge 2
        have h_M_ge : |v (mkSpaceTime 0 0)| ≤ M := by
          dsimp [M]
          have : 0 ≤ (ε / 4) * ((2 : ℝ) ^ k₀) ^ 2 := by positivity
          linarith
        nlinarith
  refine ⟨M, fun y s hs1 hs2 => ?_⟩
  obtain ⟨m, hm⟩ := exists_nat_ge ‖y‖
  have hm_pow : ‖y‖ ≤ (2 : ℝ) ^ (k₀ + m) := by
    have h1 : (m : ℝ) ≤ (2 : ℝ) ^ m := h_pow2 m
    have h2 : (2 : ℝ) ^ m ≤ (2 : ℝ) ^ (k₀ + m) :=
      pow_le_pow_right₀ (by norm_num) (Nat.le_add_left m k₀)
    linarith
  exact h_ind m y s hs1 hs2 hm_pow

theorem envelope_competitor_attainment_and_localization (d : ℕ)
    (v : EuclideanSpace ℝ (Fin (d + 1)) → ℝ) (hv_cont : Continuous v)
    (h_growth : ∀ (t₁ t₂ ε : ℝ), 0 < ε → ∃ M : ℝ, ∀ (y : EuclideanSpace ℝ (Fin d)) (s : ℝ),
      t₁ ≤ s → s ≤ t₂ → |v (mkSpaceTime y s)| ≤ M + ε * ‖y‖ ^ 2) :
    (∀ (x y : EuclideanSpace ℝ (Fin d)) (t ℓ : ℝ), 0 < ℓ →
      v (mkSpaceTime y (t + ℓ)) - v (mkSpaceTime x t) - ‖y - x‖ ^ 2 / (2 * ℓ) ≤
        ℓ * slopePlus d ℓ v (mkSpaceTime x t) ∧
      v (mkSpaceTime x t) - v (mkSpaceTime y (t - ℓ)) - ‖y - x‖ ^ 2 / (2 * ℓ) ≤
        ℓ * slopeMinus d ℓ v (mkSpaceTime x t)) ∧
    (∀ (x : EuclideanSpace ℝ (Fin d)) (t ℓ : ℝ), 0 < ℓ →
      (∃ y_plus : EuclideanSpace ℝ (Fin d),
        v (mkSpaceTime y_plus (t + ℓ)) - v (mkSpaceTime x t) - ‖y_plus - x‖ ^ 2 / (2 * ℓ) =
          ℓ * slopePlus d ℓ v (mkSpaceTime x t)) ∧
      (∃ y_minus : EuclideanSpace ℝ (Fin d),
        v (mkSpaceTime x t) - v (mkSpaceTime y_minus (t - ℓ)) - ‖y_minus - x‖ ^ 2 / (2 * ℓ) =
          ℓ * slopeMinus d ℓ v (mkSpaceTime x t))) ∧
    (∀ (x : EuclideanSpace ℝ (Fin d)) (t L : ℝ), 0 < L →
      ∃ C : ℝ, 0 ≤ C ∧ ∀ (ℓ : ℝ) (y : EuclideanSpace ℝ (Fin d)), 0 < ℓ → ℓ ≤ L →
        (v (mkSpaceTime y (t + ℓ)) - v (mkSpaceTime x t) - ‖y - x‖ ^ 2 / (2 * ℓ) =
          ℓ * slopePlus d ℓ v (mkSpaceTime x t) → ‖y - x‖ ^ 2 ≤ C * ℓ) ∧
        (v (mkSpaceTime x t) - v (mkSpaceTime y (t - ℓ)) - ‖y - x‖ ^ 2 / (2 * ℓ) =
          ℓ * slopeMinus d ℓ v (mkSpaceTime x t) → ‖y - x‖ ^ 2 ≤ C * ℓ)) :=
by
  have projSpace_mkSpaceTime : ∀ (x : EuclideanSpace ℝ (Fin d)) (s : ℝ),
      projSpace (mkSpaceTime x s) = x := by
    intro x s
    ext i
    simp [projSpace, mkSpaceTime, Fin.snoc_castSucc]
  have projTime_mkSpaceTime : ∀ (x : EuclideanSpace ℝ (Fin d)) (s : ℝ),
      projTime (mkSpaceTime x s) = s := by
    intro x s
    simp [projTime, mkSpaceTime, Fin.snoc_last]
  have continuous_mkSpaceTime_left : ∀ s : ℝ,
      Continuous (fun y : EuclideanSpace ℝ (Fin d) => mkSpaceTime y s) := by
    intro s
    unfold mkSpaceTime
    apply (ContinuousLinearEquiv.continuous _).comp
    rw [continuous_pi_iff]
    intro j
    refine Fin.lastCases ?_ ?_ j
    · simp only [Fin.snoc_last]
      exact continuous_const
    · intro i
      simp only [Fin.snoc_castSucc]
      exact (continuous_apply i).comp (EuclideanSpace.equiv (Fin d) ℝ).continuous
  have norm_sq_le_two_sub_add : ∀ (x y : EuclideanSpace ℝ (Fin d)),
      ‖y‖ ^ 2 ≤ 2 * ‖y - x‖ ^ 2 + 2 * ‖x‖ ^ 2 := by
    intro x y
    have h_tri : ‖y‖ ≤ ‖y - x‖ + ‖x‖ := by
      simpa [sub_add_cancel] using norm_add_le (y - x) x
    have h_sq : ‖y‖ ^ 2 ≤ (‖y - x‖ + ‖x‖) ^ 2 :=
      pow_le_pow_left₀ (norm_nonneg y) h_tri 2
    have h_amgm : 0 ≤ (‖y - x‖ - ‖x‖) ^ 2 := sq_nonneg (‖y - x‖ - ‖x‖)
    linarith
  have h_master : ∀ (x : EuclideanSpace ℝ (Fin d)) (t L : ℝ), 0 < L →
      ∃ C : ℝ, 0 ≤ C ∧ ∀ (ℓ : ℝ), 0 < ℓ → ℓ ≤ L →
        (∀ y : EuclideanSpace ℝ (Fin d),
          v (mkSpaceTime y (t + ℓ)) - v (mkSpaceTime x t) - ‖y - x‖ ^ 2 / (2 * ℓ) ≤
            ℓ * slopePlus d ℓ v (mkSpaceTime x t) ∧
          v (mkSpaceTime x t) - v (mkSpaceTime y (t - ℓ)) - ‖y - x‖ ^ 2 / (2 * ℓ) ≤
            ℓ * slopeMinus d ℓ v (mkSpaceTime x t)) ∧
        ((∃ y_plus : EuclideanSpace ℝ (Fin d),
          v (mkSpaceTime y_plus (t + ℓ)) - v (mkSpaceTime x t) - ‖y_plus - x‖ ^ 2 / (2 * ℓ) =
            ℓ * slopePlus d ℓ v (mkSpaceTime x t)) ∧
        (∃ y_minus : EuclideanSpace ℝ (Fin d),
          v (mkSpaceTime x t) - v (mkSpaceTime y_minus (t - ℓ)) - ‖y_minus - x‖ ^ 2 / (2 * ℓ) =
            ℓ * slopeMinus d ℓ v (mkSpaceTime x t))) ∧
        (∀ y : EuclideanSpace ℝ (Fin d),
          (v (mkSpaceTime y (t + ℓ)) - v (mkSpaceTime x t) - ‖y - x‖ ^ 2 / (2 * ℓ) =
            ℓ * slopePlus d ℓ v (mkSpaceTime x t) → ‖y - x‖ ^ 2 ≤ C * ℓ) ∧
          (v (mkSpaceTime x t) - v (mkSpaceTime y (t - ℓ)) - ‖y - x‖ ^ 2 / (2 * ℓ) =
            ℓ * slopeMinus d ℓ v (mkSpaceTime x t) → ‖y - x‖ ^ 2 ≤ C * ℓ)) := by
    intro x t L hL
    have hε_pos : 0 < 1 / (8 * L) := by positivity
    obtain ⟨M₀, hM₀⟩ := h_growth (t - L) (t + L) (1 / (8 * L)) hε_pos
    let M_x : ℝ := max M₀ 0 + ‖x‖ ^ 2 / (4 * L)
    have hM_x_nonneg : 0 ≤ M_x := by
      have h1 : 0 ≤ max M₀ 0 := le_max_right M₀ 0
      have h2 : 0 ≤ ‖x‖ ^ 2 / (4 * L) := by positivity
      linarith
    have hM₀_le : M₀ ≤ max M₀ 0 := le_max_left M₀ 0
    have hv_shifted : ∀ (y : EuclideanSpace ℝ (Fin d)) (s : ℝ),
        t - L ≤ s → s ≤ t + L →
        -M_x - ‖y - x‖ ^ 2 / (4 * L) ≤ v (mkSpaceTime y s) ∧
        v (mkSpaceTime y s) ≤ M_x + ‖y - x‖ ^ 2 / (4 * L) := by
      intro y s hs₁ hs₂
      have h_abs := hM₀ y s hs₁ hs₂
      have h_abs' := abs_le.mp h_abs
      have h_norm := norm_sq_le_two_sub_add x y
      have h_mul : (1 / (8 * L)) * ‖y‖ ^ 2 ≤
          (1 / (8 * L)) * (2 * ‖y - x‖ ^ 2 + 2 * ‖x‖ ^ 2) :=
        mul_le_mul_of_nonneg_left h_norm (le_of_lt hε_pos)
      have h_ring : (1 / (8 * L)) * (2 * ‖y - x‖ ^ 2 + 2 * ‖x‖ ^ 2) =
          ‖y - x‖ ^ 2 / (4 * L) + ‖x‖ ^ 2 / (4 * L) := by ring
      constructor <;> linarith [h_abs'.1, h_abs'.2, h_mul, h_ring, hM₀_le]
    have hv_x : ∀ s : ℝ, t - L ≤ s → s ≤ t + L →
        -M_x ≤ v (mkSpaceTime x s) ∧ v (mkSpaceTime x s) ≤ M_x := by
      intro s hs₁ hs₂
      have h_xx := hv_shifted x s hs₁ hs₂
      simpa [sub_self] using h_xx
    let C : ℝ := 8 * M_x
    have hC_nonneg : 0 ≤ C := by positivity
    let R : ℝ := Real.sqrt (C * L)
    have hR_nonneg : 0 ≤ R := Real.sqrt_nonneg (C * L)
    have hB_compact : IsCompact (Metric.closedBall x R) := isCompact_closedBall x R
    have hx_mem : x ∈ Metric.closedBall x R := Metric.mem_closedBall_self hR_nonneg
    refine ⟨C, hC_nonneg, ?_⟩
    intro ℓ hℓ hℓL
    let Φ_plus : EuclideanSpace ℝ (Fin d) → ℝ :=
      fun y => v (mkSpaceTime y (t + ℓ)) - ‖y - x‖ ^ 2 / (2 * ℓ)
    let Φ_minus : EuclideanSpace ℝ (Fin d) → ℝ :=
      fun y => v (mkSpaceTime y (t - ℓ)) + ‖y - x‖ ^ 2 / (2 * ℓ)
    have h_quad_cont : Continuous (fun y : EuclideanSpace ℝ (Fin d) => ‖y - x‖ ^ 2 / (2 * ℓ)) :=
      ((continuous_norm.comp (continuous_id.sub continuous_const)).pow 2).div_const (2 * ℓ)
    have hΦ_plus_cont : Continuous Φ_plus :=
      (hv_cont.comp (continuous_mkSpaceTime_left (t + ℓ))).sub h_quad_cont
    have hΦ_minus_cont : Continuous Φ_minus :=
      (hv_cont.comp (continuous_mkSpaceTime_left (t - ℓ))).add h_quad_cont
    have h_loc_plus : ∀ y : EuclideanSpace ℝ (Fin d),
        Φ_plus x ≤ Φ_plus y → ‖y - x‖ ^ 2 ≤ C * ℓ := by
      intro y hy
      have hs₁ : t - L ≤ t + ℓ := by linarith
      have hs₂ : t + ℓ ≤ t + L := by linarith
      have hv_y := (hv_shifted y (t + ℓ) hs₁ hs₂).2
      have hv_x_lb := (hv_x (t + ℓ) hs₁ hs₂).1
      have hΦ_x : Φ_plus x = v (mkSpaceTime x (t + ℓ)) := by
        simp [Φ_plus]
      have h_div_le : ‖y - x‖ ^ 2 / (4 * L) ≤ ‖y - x‖ ^ 2 / (4 * ℓ) :=
        div_le_div_of_nonneg_left (sq_nonneg ‖y - x‖) (by positivity) (by linarith)
      have h_div_two : ‖y - x‖ ^ 2 / (2 * ℓ) = 2 * (‖y - x‖ ^ 2 / (4 * ℓ)) := by ring
      have h_bound : ‖y - x‖ ^ 2 / (4 * ℓ) ≤ 2 * M_x := by
        dsimp only [Φ_plus] at hy
        linarith
      have h_mul := (div_le_iff₀ (by positivity : (0 : ℝ) < 4 * ℓ)).mp h_bound
      linarith
    have h_loc_minus : ∀ y : EuclideanSpace ℝ (Fin d),
        Φ_minus y ≤ Φ_minus x → ‖y - x‖ ^ 2 ≤ C * ℓ := by
      intro y hy
      have hs₁ : t - L ≤ t - ℓ := by linarith
      have hs₂ : t - ℓ ≤ t + L := by linarith
      have hv_y := (hv_shifted y (t - ℓ) hs₁ hs₂).1
      have hv_x_ub := (hv_x (t - ℓ) hs₁ hs₂).2
      have hΦ_x : Φ_minus x = v (mkSpaceTime x (t - ℓ)) := by
        simp [Φ_minus]
      have h_div_le : ‖y - x‖ ^ 2 / (4 * L) ≤ ‖y - x‖ ^ 2 / (4 * ℓ) :=
        div_le_div_of_nonneg_left (sq_nonneg ‖y - x‖) (by positivity) (by linarith)
      have h_div_two : ‖y - x‖ ^ 2 / (2 * ℓ) = 2 * (‖y - x‖ ^ 2 / (4 * ℓ)) := by ring
      have h_bound : ‖y - x‖ ^ 2 / (4 * ℓ) ≤ 2 * M_x := by
        dsimp only [Φ_minus] at hy
        linarith
      have h_mul := (div_le_iff₀ (by positivity : (0 : ℝ) < 4 * ℓ)).mp h_bound
      linarith
    have h_mem_ball : ∀ y : EuclideanSpace ℝ (Fin d),
        ‖y - x‖ ^ 2 ≤ C * ℓ → y ∈ Metric.closedBall x R := by
      intro y hy
      have h_le_CL : ‖y - x‖ ^ 2 ≤ C * L :=
        le_trans hy (mul_le_mul_of_nonneg_left hℓL hC_nonneg)
      have h_sqrt := Real.sqrt_le_sqrt h_le_CL
      rw [Real.sqrt_sq (norm_nonneg (y - x))] at h_sqrt
      rw [Metric.mem_closedBall, dist_eq_norm]
      exact h_sqrt
    obtain ⟨y_plus, hy_plus_mem, hy_plus_max⟩ :=
      hB_compact.exists_isMaxOn ⟨x, hx_mem⟩ hΦ_plus_cont.continuousOn
    obtain ⟨y_minus, hy_minus_mem, hy_minus_min⟩ :=
      hB_compact.exists_isMinOn ⟨x, hx_mem⟩ hΦ_minus_cont.continuousOn
    have hy_plus_ge_x : Φ_plus x ≤ Φ_plus y_plus := isMaxOn_iff.mp hy_plus_max x hx_mem
    have hy_minus_le_x : Φ_minus y_minus ≤ Φ_minus x := isMinOn_iff.mp hy_minus_min x hx_mem
    have h_max_all : ∀ y : EuclideanSpace ℝ (Fin d), Φ_plus y ≤ Φ_plus y_plus := by
      intro y
      by_cases hy : Φ_plus x ≤ Φ_plus y
      · exact isMaxOn_iff.mp hy_plus_max y (h_mem_ball y (h_loc_plus y hy))
      · linarith
    have h_min_all : ∀ y : EuclideanSpace ℝ (Fin d), Φ_minus y_minus ≤ Φ_minus y := by
      intro y
      by_cases hy : Φ_minus y ≤ Φ_minus x
      · exact isMinOn_iff.mp hy_minus_min y (h_mem_ball y (h_loc_minus y hy))
      · linarith
    have h_mem_plus : Φ_plus y_plus ∈ Φ_plus '' Set.univ :=
      Set.mem_image_of_mem Φ_plus (Set.mem_univ y_plus)
    have h_ub_plus : ∀ b ∈ Φ_plus '' Set.univ, b ≤ Φ_plus y_plus := by
      rintro _ ⟨y, -, rfl⟩
      exact h_max_all y
    have h_sSup_plus : sSup (Φ_plus '' Set.univ) = Φ_plus y_plus :=
      le_antisymm (csSup_le ⟨Φ_plus y_plus, h_mem_plus⟩ h_ub_plus)
        (le_csSup ⟨Φ_plus y_plus, h_ub_plus⟩ h_mem_plus)
    have h_quadPlus : quadEnvelopePlus d ℓ v (mkSpaceTime x t) = Φ_plus y_plus := by
      simp only [quadEnvelopePlus, projTime_mkSpaceTime, projSpace_mkSpaceTime]
      exact h_sSup_plus
    have h_slopePlus : ℓ * slopePlus d ℓ v (mkSpaceTime x t) =
        Φ_plus y_plus - v (mkSpaceTime x t) := by
      unfold slopePlus
      rw [h_quadPlus, mul_div_cancel₀ _ (ne_of_gt hℓ)]
    have h_mem_minus : Φ_minus y_minus ∈ Φ_minus '' Set.univ :=
      Set.mem_image_of_mem Φ_minus (Set.mem_univ y_minus)
    have h_lb_minus : ∀ b ∈ Φ_minus '' Set.univ, Φ_minus y_minus ≤ b := by
      rintro _ ⟨y, -, rfl⟩
      exact h_min_all y
    have h_sInf_minus : sInf (Φ_minus '' Set.univ) = Φ_minus y_minus :=
      le_antisymm (csInf_le ⟨Φ_minus y_minus, h_lb_minus⟩ h_mem_minus)
        (le_csInf ⟨Φ_minus y_minus, h_mem_minus⟩ h_lb_minus)
    have h_quadMinus : quadEnvelopeMinus d ℓ v (mkSpaceTime x t) = Φ_minus y_minus := by
      simp only [quadEnvelopeMinus, projTime_mkSpaceTime, projSpace_mkSpaceTime]
      exact h_sInf_minus
    have h_slopeMinus : ℓ * slopeMinus d ℓ v (mkSpaceTime x t) =
        v (mkSpaceTime x t) - Φ_minus y_minus := by
      unfold slopeMinus
      rw [h_quadMinus, mul_div_cancel₀ _ (ne_of_gt hℓ)]
    refine ⟨?_, ⟨⟨y_plus, ?_⟩, ⟨y_minus, ?_⟩⟩, ?_⟩
    · intro y
      have h1 := h_max_all y
      have h2 := h_min_all y
      dsimp only [Φ_plus, Φ_minus] at h1 h2 h_slopePlus h_slopeMinus
      constructor <;> linarith
    · dsimp only [Φ_plus] at h_slopePlus
      linarith
    · dsimp only [Φ_minus] at h_slopeMinus
      linarith
    · intro y
      constructor
      · intro hy_eq
        have hy_ge : Φ_plus x ≤ Φ_plus y := by
          dsimp only [Φ_plus] at hy_plus_ge_x h_slopePlus ⊢
          linarith
        exact h_loc_plus y hy_ge
      · intro hy_eq
        have hy_le : Φ_minus y ≤ Φ_minus x := by
          dsimp only [Φ_minus] at hy_minus_le_x h_slopeMinus ⊢
          linarith
        exact h_loc_minus y hy_le
  refine ⟨?_, ?_, ?_⟩
  · intro x y t ℓ hℓ
    obtain ⟨C, _, hC⟩ := h_master x t ℓ hℓ
    exact (hC ℓ hℓ le_rfl).1 y
  · intro x t ℓ hℓ
    obtain ⟨C, _, hC⟩ := h_master x t ℓ hℓ
    exact (hC ℓ hℓ le_rfl).2.1
  · intro x t L hL
    obtain ⟨C, hC_nonneg, hC⟩ := h_master x t L hL
    exact ⟨C, hC_nonneg, fun ℓ y hℓ hℓL => (hC ℓ hℓ hℓL).2.2 y⟩

theorem scaled_slope_continuousOn_Icc (d : ℕ)
    (v : EuclideanSpace ℝ (Fin (d + 1)) → ℝ) (hv_cont : Continuous v)
    (h_comp : ∀ (x y : EuclideanSpace ℝ (Fin d)) (t ℓ : ℝ), 0 < ℓ →
      v (mkSpaceTime y (t + ℓ)) - v (mkSpaceTime x t) - ‖y - x‖ ^ 2 / (2 * ℓ) ≤
        ℓ * slopePlus d ℓ v (mkSpaceTime x t) ∧
      v (mkSpaceTime x t) - v (mkSpaceTime y (t - ℓ)) - ‖y - x‖ ^ 2 / (2 * ℓ) ≤
        ℓ * slopeMinus d ℓ v (mkSpaceTime x t))
    (h_attain : ∀ (x : EuclideanSpace ℝ (Fin d)) (t ℓ : ℝ), 0 < ℓ →
      (∃ y_plus : EuclideanSpace ℝ (Fin d),
        v (mkSpaceTime y_plus (t + ℓ)) - v (mkSpaceTime x t) - ‖y_plus - x‖ ^ 2 / (2 * ℓ) =
          ℓ * slopePlus d ℓ v (mkSpaceTime x t)) ∧
      (∃ y_minus : EuclideanSpace ℝ (Fin d),
        v (mkSpaceTime x t) - v (mkSpaceTime y_minus (t - ℓ)) - ‖y_minus - x‖ ^ 2 / (2 * ℓ) =
          ℓ * slopeMinus d ℓ v (mkSpaceTime x t)))
    (h_loc : ∀ (x : EuclideanSpace ℝ (Fin d)) (t L : ℝ), 0 < L →
      ∃ C : ℝ, 0 ≤ C ∧ ∀ (ℓ : ℝ) (y : EuclideanSpace ℝ (Fin d)), 0 < ℓ → ℓ ≤ L →
        (v (mkSpaceTime y (t + ℓ)) - v (mkSpaceTime x t) - ‖y - x‖ ^ 2 / (2 * ℓ) =
          ℓ * slopePlus d ℓ v (mkSpaceTime x t) → ‖y - x‖ ^ 2 ≤ C * ℓ) ∧
        (v (mkSpaceTime x t) - v (mkSpaceTime y (t - ℓ)) - ‖y - x‖ ^ 2 / (2 * ℓ) =
          ℓ * slopeMinus d ℓ v (mkSpaceTime x t) → ‖y - x‖ ^ 2 ≤ C * ℓ))
    (x : EuclideanSpace ℝ (Fin d)) (t L : ℝ) (hL : 0 < L) :
    ContinuousOn (fun ℓ => ℓ * slopePlus d ℓ v (mkSpaceTime x t)) (Set.Icc 0 L) ∧
    ContinuousOn (fun ℓ => ℓ * slopeMinus d ℓ v (mkSpaceTime x t)) (Set.Icc 0 L) :=
by
  have h_cont_mk : Continuous (fun p : EuclideanSpace ℝ (Fin d) × ℝ => mkSpaceTime p.1 p.2) := by
    unfold mkSpaceTime
    refine (ContinuousLinearEquiv.continuous _).comp (continuous_pi_iff.mpr fun j => ?_)
    refine Fin.lastCases ?_ ?_ j
    · simpa [Fin.snoc_last] using continuous_snd
    · intro i
      simp only [Fin.snoc_castSucc]
      exact (PiLp.continuous_apply 2 _ i).comp continuous_fst
  have h_abstract : ∀ (C : ℝ), 0 ≤ C →
      ∀ (w : EuclideanSpace ℝ (Fin d) × ℝ → ℝ) (E : ℝ → ℝ),
        Continuous w → w (x, 0) = 0 → E 0 = 0 →
        (∀ (y : EuclideanSpace ℝ (Fin d)) (ℓ : ℝ), 0 < ℓ →
          w (y, ℓ) - ‖y - x‖ ^ 2 / (2 * ℓ) ≤ E ℓ) →
        (∀ ℓ : ℝ, 0 < ℓ →
          ∃ y : EuclideanSpace ℝ (Fin d), w (y, ℓ) - ‖y - x‖ ^ 2 / (2 * ℓ) = E ℓ) →
        (∀ (ℓ : ℝ) (y : EuclideanSpace ℝ (Fin d)), 0 < ℓ → ℓ ≤ L →
          w (y, ℓ) - ‖y - x‖ ^ 2 / (2 * ℓ) = E ℓ → ‖y - x‖ ^ 2 ≤ C * ℓ) →
        ContinuousOn E (Set.Icc 0 L) := by
    intro C hC w E hw_cont hw0 hE0 h_comp_w h_attain_w h_loc_w ℓ₀ hℓ₀
    rcases eq_or_lt_of_le hℓ₀.1 with hℓ₀_eq | hℓ₀_pos
    · subst hℓ₀_eq
      rw [Metric.continuousWithinAt_iff]
      intro ε hε
      obtain ⟨δ₀, hδ₀_pos, hδ₀⟩ :=
        Metric.continuousAt_iff.mp (hw_cont.continuousAt (x := (x, 0))) ε hε
      have hC1_pos : (0 : ℝ) < C + 1 := by linarith
      let δ := min L (min (δ₀ / 2) (δ₀ ^ 2 / (2 * (C + 1))))
      have hδ_pos : 0 < δ := lt_min hL (lt_min (half_pos hδ₀_pos) (by positivity))
      refine ⟨δ, hδ_pos, fun ℓ hℓ hdist => ?_⟩
      rw [Real.dist_eq, hE0, sub_zero]
      rcases eq_or_lt_of_le hℓ.1 with hℓ_eq | hℓ_pos
      · subst hℓ_eq
        rw [hE0, abs_zero]
        exact hε
      · rw [Real.dist_eq, sub_zero, abs_of_pos hℓ_pos] at hdist
        have hℓ_lt_δ₀ : ℓ < δ₀ := by
          have : ℓ < δ₀ / 2 :=
            lt_of_lt_of_le hdist (le_trans (min_le_right _ _) (min_le_left _ _))
          linarith
        have hCℓ_lt : (C + 1) * ℓ < δ₀ ^ 2 := by
          have h1 : ℓ < δ₀ ^ 2 / (2 * (C + 1)) :=
            lt_of_lt_of_le hdist (le_trans (min_le_right _ _) (min_le_right _ _))
          have h2 : ℓ * (2 * (C + 1)) < δ₀ ^ 2 := (lt_div_iff₀ (by positivity)).mp h1
          have h3 : 0 < δ₀ ^ 2 := sq_pos_of_pos hδ₀_pos
          nlinarith
        have h_low : -ε < E ℓ := by
          have h_cx := h_comp_w x ℓ hℓ_pos
          simp only [sub_self, norm_zero, ne_eq, OfNat.ofNat_ne_zero, not_false_eq_true,
            zero_pow, zero_div, sub_zero] at h_cx
          have hd_x : dist (x, ℓ) (x, (0 : ℝ)) < δ₀ := by
            rw [Prod.dist_eq, max_lt_iff, dist_self, Real.dist_eq, sub_zero, abs_of_pos hℓ_pos]
            exact ⟨hδ₀_pos, hℓ_lt_δ₀⟩
          have hw_x := hδ₀ hd_x
          rw [Real.dist_eq, hw0, sub_zero] at hw_x
          linarith [(abs_lt.mp hw_x).1]
        have h_high : E ℓ < ε := by
          obtain ⟨y_ℓ, hy_ℓ⟩ := h_attain_w ℓ hℓ_pos
          have hy_loc : ‖y_ℓ - x‖ ^ 2 ≤ C * ℓ := h_loc_w ℓ y_ℓ hℓ_pos hℓ.2 hy_ℓ
          have hy_sq : ‖y_ℓ - x‖ ^ 2 < δ₀ ^ 2 := by nlinarith
          have hy_norm : ‖y_ℓ - x‖ < δ₀ := by
            nlinarith [norm_nonneg (y_ℓ - x)]
          have hd_y : dist (y_ℓ, ℓ) (x, (0 : ℝ)) < δ₀ := by
            rw [Prod.dist_eq, max_lt_iff, dist_eq_norm, Real.dist_eq, sub_zero, abs_of_pos hℓ_pos]
            exact ⟨hy_norm, hℓ_lt_δ₀⟩
          have hw_y := hδ₀ hd_y
          rw [Real.dist_eq, hw0, sub_zero] at hw_y
          have h_pen_nonneg : 0 ≤ ‖y_ℓ - x‖ ^ 2 / (2 * ℓ) :=
            div_nonneg (sq_nonneg _) (by linarith)
          linarith [(abs_lt.mp hw_y).2]
        exact abs_lt.mpr ⟨h_low, h_high⟩
    · rw [Metric.continuousWithinAt_iff]
      intro ε hε
      let R : ℝ := C * L + 1
      have hR_pos : 0 < R := by positivity
      let K : Set (EuclideanSpace ℝ (Fin d) × ℝ) := Metric.closedBall x R ×ˢ Set.Icc 0 L
      have hK_compact : IsCompact K := (isCompact_closedBall x R).prod isCompact_Icc
      have hw_uc : UniformContinuousOn w K :=
        hK_compact.uniformContinuousOn_of_continuous hw_cont.continuousOn
      obtain ⟨δ₁, hδ₁_pos, hδ₁⟩ :=
        Metric.uniformContinuousOn_iff.mp hw_uc (ε / 2) (half_pos hε)
      let a : ℝ := ℓ₀ / 2
      have ha_pos : 0 < a := half_pos hℓ₀_pos
      let δ : ℝ := min a (min δ₁ (ε * a ^ 2 / R))
      have hδ_pos : 0 < δ := lt_min ha_pos (lt_min hδ₁_pos (by positivity))
      have h_one_sided : ∀ ℓ₁ ∈ Set.Icc 0 L, ∀ ℓ₂ ∈ Set.Icc 0 L,
          a ≤ ℓ₁ → a ≤ ℓ₂ → |ℓ₁ - ℓ₂| < δ → E ℓ₁ - E ℓ₂ < ε := by
        intro ℓ₁ hℓ₁ ℓ₂ hℓ₂ ha₁ ha₂ h_diff
        have hℓ₁_pos : 0 < ℓ₁ := lt_of_lt_of_le ha_pos ha₁
        have hℓ₂_pos : 0 < ℓ₂ := lt_of_lt_of_le ha_pos ha₂
        obtain ⟨y₁, hy₁⟩ := h_attain_w ℓ₁ hℓ₁_pos
        have hy₁_loc : ‖y₁ - x‖ ^ 2 ≤ C * ℓ₁ := h_loc_w ℓ₁ y₁ hℓ₁_pos hℓ₁.2 hy₁
        have hy₁_CL : ‖y₁ - x‖ ^ 2 ≤ C * L := by nlinarith [hℓ₁.2]
        have hy₁_R : ‖y₁ - x‖ ≤ R := by
          have h_sq : 0 ≤ (‖y₁ - x‖ - 1 / 2) ^ 2 := sq_nonneg _
          change ‖y₁ - x‖ ≤ C * L + 1
          nlinarith
        have hy₁_ball : y₁ ∈ Metric.closedBall x R := by
          rw [Metric.mem_closedBall, dist_eq_norm]
          exact hy₁_R
        have hp₁ : (y₁, ℓ₁) ∈ K := ⟨hy₁_ball, hℓ₁⟩
        have hp₂ : (y₁, ℓ₂) ∈ K := ⟨hy₁_ball, hℓ₂⟩
        have h_dist_p : dist (y₁, ℓ₁) (y₁, ℓ₂) < δ₁ := by
          rw [Prod.dist_eq, max_lt_iff, dist_self, Real.dist_eq]
          refine ⟨hδ₁_pos,
            lt_of_lt_of_le h_diff (le_trans (min_le_right _ _) (min_le_left _ _))⟩
        have hw_diff : w (y₁, ℓ₁) - w (y₁, ℓ₂) < ε / 2 := by
          have h_uc_app := hδ₁ (y₁, ℓ₁) hp₁ (y₁, ℓ₂) hp₂ h_dist_p
          rw [Real.dist_eq] at h_uc_app
          linarith [(abs_lt.mp h_uc_app).2]
        have h_comp₂ := h_comp_w y₁ ℓ₂ hℓ₂_pos
        have h_pen_diff : ‖y₁ - x‖ ^ 2 / (2 * ℓ₂) - ‖y₁ - x‖ ^ 2 / (2 * ℓ₁) < ε / 2 := by
          have h_alg : ‖y₁ - x‖ ^ 2 / (2 * ℓ₂) - ‖y₁ - x‖ ^ 2 / (2 * ℓ₁) =
              (‖y₁ - x‖ ^ 2 * (ℓ₁ - ℓ₂)) / (2 * ℓ₁ * ℓ₂) := by
            field_simp
          rw [h_alg, div_lt_iff₀ (by positivity)]
          have h_diff_R : |ℓ₁ - ℓ₂| < ε * a ^ 2 / R :=
            lt_of_lt_of_le h_diff (le_trans (min_le_right _ _) (min_le_right _ _))
          have h_mul_R : |ℓ₁ - ℓ₂| * R < ε * a ^ 2 := (lt_div_iff₀ hR_pos).mp h_diff_R
          have h_num1 : ‖y₁ - x‖ ^ 2 * (ℓ₁ - ℓ₂) ≤ R * |ℓ₁ - ℓ₂| := by
            have : ‖y₁ - x‖ ^ 2 ≤ R := by change ‖y₁ - x‖ ^ 2 ≤ C * L + 1; linarith
            nlinarith [sq_nonneg ‖y₁ - x‖, le_abs_self (ℓ₁ - ℓ₂), abs_nonneg (ℓ₁ - ℓ₂)]
          have h_a_le : a ^ 2 ≤ ℓ₁ * ℓ₂ := by nlinarith
          nlinarith
        linarith
      refine ⟨δ, hδ_pos, fun ℓ hℓ hdist => ?_⟩
      rw [Real.dist_eq] at hdist ⊢
      have h_lt_a : |ℓ - ℓ₀| < a := lt_of_lt_of_le hdist (min_le_left _ _)
      have ha_ℓ : a ≤ ℓ := by
        have h_sub : ℓ₀ - ℓ < ℓ₀ / 2 := (abs_sub_lt_iff.mp h_lt_a).2
        change ℓ₀ / 2 ≤ ℓ
        linarith
      have ha_ℓ₀ : a ≤ ℓ₀ := by change ℓ₀ / 2 ≤ ℓ₀; linarith
      have h1 : E ℓ - E ℓ₀ < ε := h_one_sided ℓ hℓ ℓ₀ hℓ₀ ha_ℓ ha_ℓ₀ hdist
      have h2 : E ℓ₀ - E ℓ < ε := by
        rw [abs_sub_comm] at hdist
        exact h_one_sided ℓ₀ hℓ₀ ℓ hℓ ha_ℓ₀ ha_ℓ hdist
      exact abs_sub_lt_iff.mpr ⟨h1, h2⟩
  obtain ⟨C, hC, h_loc_C⟩ := h_loc x t L hL
  refine ⟨?_, ?_⟩
  · refine h_abstract C hC
      (fun p => v (mkSpaceTime p.1 (t + p.2)) - v (mkSpaceTime x t))
      (fun ℓ => ℓ * slopePlus d ℓ v (mkSpaceTime x t))
      ?_ ?_ ?_ ?_ ?_ ?_
    · exact (hv_cont.comp (h_cont_mk.comp (continuous_fst.prodMk (continuous_const.add continuous_snd)))).sub continuous_const
    · simp
    · simp
    · intro y ℓ hℓ
      exact (h_comp x y t ℓ hℓ).1
    · intro ℓ hℓ
      exact (h_attain x t ℓ hℓ).1
    · intro ℓ y hℓ hℓL
      exact (h_loc_C ℓ y hℓ hℓL).1
  · refine h_abstract C hC
      (fun p => v (mkSpaceTime x t) - v (mkSpaceTime p.1 (t - p.2)))
      (fun ℓ => ℓ * slopeMinus d ℓ v (mkSpaceTime x t))
      ?_ ?_ ?_ ?_ ?_ ?_
    · exact continuous_const.sub (hv_cont.comp (h_cont_mk.comp (continuous_fst.prodMk (continuous_const.sub continuous_snd))))
    · simp
    · simp
    · intro y ℓ hℓ
      exact (h_comp x y t ℓ hℓ).2
    · intro ℓ hℓ
      exact (h_attain x t ℓ hℓ).2
    · intro ℓ y hℓ hℓL
      exact (h_loc_C ℓ y hℓ hℓL).2

theorem parabolicTestFunc_contDiffOn_and_limitingOperator (d : ℕ)
    (x y₀ : EuclideanSpace ℝ (Fin d)) (t τ₀ c₀ c₁ c₂ : ℝ) (hτ₀ : τ₀ ≠ t) :
    ContDiffOn ℝ 2 (parabolicTestFunc d x t τ₀ c₀ c₁ c₂)
      {z : EuclideanSpace ℝ (Fin (d + 1)) | projTime z ≠ t} ∧
    limitingOperator (parabolicTestFunc d x t τ₀ c₀ c₁ c₂) (mkSpaceTime y₀ τ₀) = c₂ :=
by
  have projSpace_mkSpaceTime :
      ∀ (y : EuclideanSpace ℝ (Fin d)) (s : ℝ), projSpace (mkSpaceTime y s) = y := by
    intro y s
    ext i
    simp [projSpace, mkSpaceTime, Fin.snoc_castSucc]
  have projTime_mkSpaceTime :
      ∀ (y : EuclideanSpace ℝ (Fin d)) (s : ℝ), projTime (mkSpaceTime y s) = s := by
    intro y s
    simp [projTime, mkSpaceTime, Fin.snoc_last]
  have projSpace_add :
      ∀ z₁ z₂ : EuclideanSpace ℝ (Fin (d + 1)),
        projSpace (z₁ + z₂) = projSpace z₁ + projSpace z₂ := by
    intro z₁ z₂
    ext i
    simp [projSpace]
  have projTime_add :
      ∀ z₁ z₂ : EuclideanSpace ℝ (Fin (d + 1)),
        projTime (z₁ + z₂) = projTime z₁ + projTime z₂ := by
    intro z₁ z₂
    simp [projTime]
  have projSpace_smul :
      ∀ (c : ℝ) (z : EuclideanSpace ℝ (Fin (d + 1))),
        projSpace (c • z) = c • projSpace z := by
    intro c z
    ext i
    simp [projSpace]
  have projTime_smul :
      ∀ (c : ℝ) (z : EuclideanSpace ℝ (Fin (d + 1))),
        projTime (c • z) = c * projTime z := by
    intro c z
    simp [projTime]
  have inner_eq_projSpace_add_projTime :
      ∀ z₁ z₂ : EuclideanSpace ℝ (Fin (d + 1)),
        inner ℝ z₁ z₂ = inner ℝ (projSpace z₁) (projSpace z₂) + projTime z₁ * projTime z₂ := by
    intro z₁ z₂
    rw [PiLp.inner_apply, PiLp.inner_apply, Fin.sum_univ_castSucc]
    simp [projSpace, projTime, mul_comm]
  let projSpaceCLM : EuclideanSpace ℝ (Fin (d + 1)) →L[ℝ] EuclideanSpace ℝ (Fin d) :=
    LinearMap.toContinuousLinearMap
      { toFun := projSpace
        map_add' := projSpace_add
        map_smul' := projSpace_smul }
  let projTimeCLM : EuclideanSpace ℝ (Fin (d + 1)) →L[ℝ] ℝ :=
    LinearMap.toContinuousLinearMap
      { toFun := projTime
        map_add' := projTime_add
        map_smul' := projTime_smul }
  have deriv_deriv_line_eq_fderiv_fderiv :
      ∀ {E : Type} [NormedAddCommGroup E] [NormedSpace ℝ E]
        {f : E → ℝ} {W : Set E}, IsOpen W → ∀ {z₀ : E}, z₀ ∈ W →
        ContDiffOn ℝ 2 f W → ∀ (ξ : E),
        deriv (deriv (fun s : ℝ => f (z₀ + s • ξ))) 0 = fderiv ℝ (fderiv ℝ f) z₀ ξ ξ := by
    intro E _ _ f W hW z₀ hz₀ hf ξ
    have h_pre : IsOpen ((fun s : ℝ => z₀ + s • ξ) ⁻¹' W) :=
      hW.preimage (continuous_const.add (continuous_id.smul continuous_const))
    have h0_mem : (0 : ℝ) ∈ (fun s : ℝ => z₀ + s • ξ) ⁻¹' W := by simp [hz₀]
    have h_ev : (fun s : ℝ => deriv (fun r : ℝ => f (z₀ + r • ξ)) s) =ᶠ[nhds 0]
        (fun s : ℝ => (fderiv ℝ f (z₀ + s • ξ)) ξ) := by
      filter_upwards [h_pre.mem_nhds h0_mem] with s hs
      have hf_diff : DifferentiableAt ℝ f (z₀ + s • ξ) :=
        ((hf.contDiffAt (hW.mem_nhds hs)).differentiableAt (by norm_num))
      have h_line : HasDerivAt (fun r : ℝ => z₀ + r • ξ) ξ s := by
        simpa using (hasDerivAt_id s).smul_const ξ |>.const_add z₀
      exact (hf_diff.hasFDerivAt.comp_hasDerivAt s h_line).deriv
    rw [h_ev.deriv_eq]
    have hcd : ContDiffAt ℝ 2 f z₀ := hf.contDiffAt (hW.mem_nhds hz₀)
    have hcd1 : ContDiffAt ℝ 1 (fderiv ℝ f) z₀ := hcd.fderiv_right (by norm_num)
    have hf2_diff : HasFDerivAt (fderiv ℝ f) (fderiv ℝ (fderiv ℝ f) z₀) (z₀ + (0 : ℝ) • ξ) := by
      simpa using (hcd1.differentiableAt (by norm_num)).hasFDerivAt
    have h_line0 : HasDerivAt (fun s : ℝ => z₀ + s • ξ) ξ 0 := by
      simpa using (hasDerivAt_id (0 : ℝ)).smul_const ξ |>.const_add z₀
    have h_comp : HasDerivAt (fun s : ℝ => fderiv ℝ f (z₀ + s • ξ))
        (fderiv ℝ (fderiv ℝ f) z₀ ξ) 0 :=
      hf2_diff.comp_hasDerivAt 0 h_line0
    exact ((ContinuousLinearMap.apply ℝ ℝ ξ).hasFDerivAt.comp_hasDerivAt 0 h_comp).deriv
  set U : Set (EuclideanSpace ℝ (Fin (d + 1))) :=
    {z : EuclideanSpace ℝ (Fin (d + 1)) | projTime z ≠ t}
  set Ψ : EuclideanSpace ℝ (Fin (d + 1)) → ℝ :=
    parabolicTestFunc d x t τ₀ c₀ c₁ c₂
  have hU_open : IsOpen U := isOpen_ne.preimage projTimeCLM.continuous
  have h_time_cd : ContDiff ℝ 2 (fun z : EuclideanSpace ℝ (Fin (d + 1)) => projTime z) :=
    projTimeCLM.contDiff
  have h_space_cd : ContDiff ℝ 2 (fun z : EuclideanSpace ℝ (Fin (d + 1)) => projSpace z) :=
    projSpaceCLM.contDiff
  have h_P_cd : ContDiff ℝ 2 (fun z : EuclideanSpace ℝ (Fin (d + 1)) =>
      c₀ + c₁ * (projTime z - τ₀) + (c₂ / 2) * (projTime z - τ₀) ^ 2) :=
    (contDiff_const.add (contDiff_const.mul (h_time_cd.sub contDiff_const))).add
      (contDiff_const.mul ((h_time_cd.sub contDiff_const).pow 2))
  have h_N_cd : ContDiff ℝ 2 (fun z : EuclideanSpace ℝ (Fin (d + 1)) => ‖projSpace z - x‖ ^ 2) :=
    (h_space_cd.sub contDiff_const).norm_sq ℝ
  have h_D_cd : ContDiff ℝ 2 (fun z : EuclideanSpace ℝ (Fin (d + 1)) => 2 * (projTime z - t)) :=
    contDiff_const.mul (h_time_cd.sub contDiff_const)
  have h_D_ne : ∀ z ∈ U, 2 * (projTime z - t) ≠ 0 :=
    fun z hz => mul_ne_zero two_ne_zero (sub_ne_zero.mpr hz)
  have hΨ_C2 : ContDiffOn ℝ 2 Ψ U :=
    h_P_cd.contDiffOn.add (h_N_cd.contDiffOn.div h_D_cd.contDiffOn h_D_ne)
  refine ⟨hΨ_C2, ?_⟩
  set z₀ : EuclideanSpace ℝ (Fin (d + 1)) := mkSpaceTime y₀ τ₀
  set Δ₀ : ℝ := τ₀ - t
  set q : EuclideanSpace ℝ (Fin d) := Δ₀⁻¹ • (y₀ - x)
  have hz₀ : z₀ ∈ U := by
    change projTime (mkSpaceTime y₀ τ₀) ≠ t
    rw [projTime_mkSpaceTime]
    exact hτ₀
  have hΔ₀_ne : Δ₀ ≠ 0 := sub_ne_zero.mpr hτ₀
  have hΨ_diff : DifferentiableAt ℝ Ψ z₀ :=
    (hΨ_C2.contDiffAt (hU_open.mem_nhds hz₀)).differentiableAt (by norm_num)
  have hΨ_fd : HasFDerivAt Ψ (InnerProductSpace.toDual ℝ _ (gradient Ψ z₀)) z₀ :=
    hasGradientAt_iff_hasFDerivAt.mp hΨ_diff.hasGradientAt
  have h_grad_space : projSpace (gradient Ψ z₀) = q := by
    apply ext_inner_right ℝ
    intro h
    set v_h : EuclideanSpace ℝ (Fin (d + 1)) := mkSpaceTime h 0
    set α_h : ℝ → EuclideanSpace ℝ (Fin (d + 1)) := fun s => z₀ + s • v_h
    have h_line : HasDerivAt α_h v_h 0 := by
      simpa [α_h] using (hasDerivAt_id (0 : ℝ)).smul_const v_h |>.const_add z₀
    have hα0 : α_h 0 = z₀ := by simp [α_h]
    have h_fd0 : HasFDerivAt Ψ (InnerProductSpace.toDual ℝ _ (gradient Ψ z₀)) (α_h 0) := by
      rw [hα0]; exact hΨ_fd
    have h_val : (InnerProductSpace.toDual ℝ _ (gradient Ψ z₀)) v_h =
        inner ℝ (projSpace (gradient Ψ z₀)) h := by
      rw [InnerProductSpace.toDual_apply_apply, inner_eq_projSpace_add_projTime]
      simp [v_h, projSpace_mkSpaceTime, projTime_mkSpaceTime]
    have h_d1 : HasDerivAt (fun s : ℝ => Ψ (α_h s)) (inner ℝ (projSpace (gradient Ψ z₀)) h) 0 := by
      rw [← h_val]
      exact h_fd0.comp_hasDerivAt 0 h_line
    have h_poly_eq : (fun s : ℝ => Ψ (α_h s)) =
        fun s : ℝ => (c₀ + ‖y₀ - x‖ ^ 2 / (2 * Δ₀)) +
          (Δ₀⁻¹ * inner ℝ (y₀ - x) h) * s + (‖h‖ ^ 2 / (2 * Δ₀)) * s ^ 2 := by
      ext s
      dsimp [Ψ, parabolicTestFunc, α_h, z₀, v_h]
      rw [projTime_add, projTime_smul, projTime_mkSpaceTime, projTime_mkSpaceTime,
        projSpace_add, projSpace_smul, projSpace_mkSpaceTime, projSpace_mkSpaceTime]
      have h_sub : y₀ + s • h - x = (y₀ - x) + s • h := by abel
      have h_norm : ‖y₀ + s • h - x‖ ^ 2 =
          ‖y₀ - x‖ ^ 2 + 2 * s * inner ℝ (y₀ - x) h + s ^ 2 * ‖h‖ ^ 2 := by
        rw [h_sub, norm_add_sq_real, real_inner_smul_right, norm_smul, Real.norm_eq_abs,
          mul_pow, sq_abs]
        ring
      have h_time_sub : τ₀ + s * 0 - t = Δ₀ := by dsimp [Δ₀]; ring
      have h_time_τ : τ₀ + s * 0 - τ₀ = 0 := by ring
      rw [h_norm, h_time_sub, h_time_τ, inv_eq_one_div]
      have h2Δ₀_ne : 2 * Δ₀ ≠ 0 := mul_ne_zero two_ne_zero hΔ₀_ne
      field_simp [hΔ₀_ne, h2Δ₀_ne]
      ring
    have h_d2 : HasDerivAt (fun s : ℝ => Ψ (α_h s)) (inner ℝ q h) 0 := by
      rw [h_poly_eq]
      have h_id : HasDerivAt (fun s : ℝ => s) 1 0 := hasDerivAt_id 0
      have h_comb := ((hasDerivAt_const (0 : ℝ) (c₀ + ‖y₀ - x‖ ^ 2 / (2 * Δ₀))).add
        (h_id.const_mul (Δ₀⁻¹ * inner ℝ (y₀ - x) h))).add
        ((h_id.pow 2).const_mul (‖h‖ ^ 2 / (2 * Δ₀)))
      convert h_comb using 1
      dsimp [q]
      rw [real_inner_smul_left]
      ring
    exact h_d1.unique h_d2
  set ξ : EuclideanSpace ℝ (Fin (d + 1)) := mkSpaceTime q 1
  change limitingOperator Ψ z₀ = c₂
  unfold limitingOperator
  rw [h_grad_space, ← deriv_deriv_line_eq_fderiv_fderiv hU_open hz₀ hΨ_C2 ξ]
  set Q : ℝ → ℝ :=
    fun s => (c₀ + ‖q‖ ^ 2 / 2 * Δ₀) + (c₁ + ‖q‖ ^ 2 / 2) * s + (c₂ / 2) * s ^ 2
  have hW_open : IsOpen {s : ℝ | Δ₀ + s ≠ 0} :=
    isOpen_ne.preimage (continuous_const.add continuous_id)
  have h0_W : (0 : ℝ) ∈ {s : ℝ | Δ₀ + s ≠ 0} := by
    change Δ₀ + 0 ≠ 0
    simpa using hΔ₀_ne
  have h_ev_Q : (fun s : ℝ => Ψ (z₀ + s • ξ)) =ᶠ[nhds 0] Q := by
    filter_upwards [hW_open.mem_nhds h0_W] with s hs
    change Δ₀ + s ≠ 0 at hs
    dsimp [Ψ, parabolicTestFunc, Q, z₀, ξ]
    rw [projTime_add, projTime_smul, projTime_mkSpaceTime, projTime_mkSpaceTime,
      projSpace_add, projSpace_smul, projSpace_mkSpaceTime, projSpace_mkSpaceTime]
    have h_space_vec : y₀ + s • q - x = (Δ₀ + s) • q := by
      have h_sub : y₀ + s • q - x = (y₀ - x) + s • q := by abel
      have h_Δq : Δ₀ • q = y₀ - x := smul_inv_smul₀ hΔ₀_ne (y₀ - x)
      rw [h_sub, ← h_Δq, ← add_smul]
    have h_norm_sq : ‖y₀ + s • q - x‖ ^ 2 = (Δ₀ + s) ^ 2 * ‖q‖ ^ 2 := by
      rw [h_space_vec, norm_smul, Real.norm_eq_abs, mul_pow, sq_abs]
    have h_time_sub : τ₀ + s * 1 - t = Δ₀ + s := by dsimp [Δ₀]; ring
    have h_time_τ : τ₀ + s * 1 - τ₀ = s := by ring
    rw [h_norm_sq, h_time_sub, h_time_τ]
    have h2s_ne : 2 * (Δ₀ + s) ≠ 0 := mul_ne_zero two_ne_zero hs
    field_simp [hs, h2s_ne]
    ring
  have h_d2_eq : deriv (deriv (fun s : ℝ => Ψ (z₀ + s • ξ))) 0 = deriv (deriv Q) 0 :=
    h_ev_Q.deriv.deriv_eq
  rw [h_d2_eq]
  have h_Q_d1 : deriv Q = fun s : ℝ => (c₁ + ‖q‖ ^ 2 / 2) + c₂ * s := by
    ext s
    have h_id : HasDerivAt (fun r : ℝ => r) 1 s := hasDerivAt_id s
    have hd : HasDerivAt Q ((c₁ + ‖q‖ ^ 2 / 2) + c₂ * s) s := by
      dsimp [Q]
      convert ((hasDerivAt_const s (c₀ + ‖q‖ ^ 2 / 2 * Δ₀)).add
        (h_id.const_mul (c₁ + ‖q‖ ^ 2 / 2))).add ((h_id.pow 2).const_mul (c₂ / 2)) using 1
      ring
    exact hd.deriv
  rw [h_Q_d1]
  have hd2 : HasDerivAt (fun s : ℝ => (c₁ + ‖q‖ ^ 2 / 2) + c₂ * s) c₂ 0 := by
    have h_id : HasDerivAt (fun s : ℝ => s) 1 0 := hasDerivAt_id 0
    convert (hasDerivAt_const (0 : ℝ) (c₁ + ‖q‖ ^ 2 / 2)).add (h_id.const_mul c₂) using 1
    ring
  exact hd2.deriv

theorem slope_monotonicity_of_continuous_and_parabolic_test (d : ℕ) (C₁ : ℝ)
    (v : EuclideanSpace ℝ (Fin (d + 1)) → ℝ) (hv : InLimitingClassA d C₁ v)
    (h_comp : ∀ (x y : EuclideanSpace ℝ (Fin d)) (t ℓ : ℝ), 0 < ℓ →
      v (mkSpaceTime y (t + ℓ)) - v (mkSpaceTime x t) - ‖y - x‖ ^ 2 / (2 * ℓ) ≤
        ℓ * slopePlus d ℓ v (mkSpaceTime x t) ∧
      v (mkSpaceTime x t) - v (mkSpaceTime y (t - ℓ)) - ‖y - x‖ ^ 2 / (2 * ℓ) ≤
        ℓ * slopeMinus d ℓ v (mkSpaceTime x t))
    (h_attain : ∀ (x : EuclideanSpace ℝ (Fin d)) (t ℓ : ℝ), 0 < ℓ →
      (∃ y_plus : EuclideanSpace ℝ (Fin d),
        v (mkSpaceTime y_plus (t + ℓ)) - v (mkSpaceTime x t) - ‖y_plus - x‖ ^ 2 / (2 * ℓ) =
          ℓ * slopePlus d ℓ v (mkSpaceTime x t)) ∧
      (∃ y_minus : EuclideanSpace ℝ (Fin d),
        v (mkSpaceTime x t) - v (mkSpaceTime y_minus (t - ℓ)) - ‖y_minus - x‖ ^ 2 / (2 * ℓ) =
          ℓ * slopeMinus d ℓ v (mkSpaceTime x t)))
    (h_cont : ∀ (x : EuclideanSpace ℝ (Fin d)) (t L : ℝ), 0 < L →
      ContinuousOn (fun ℓ => ℓ * slopePlus d ℓ v (mkSpaceTime x t)) (Set.Icc 0 L) ∧
      ContinuousOn (fun ℓ => ℓ * slopeMinus d ℓ v (mkSpaceTime x t)) (Set.Icc 0 L))
    (h_test : ∀ (x y₀ : EuclideanSpace ℝ (Fin d)) (t τ₀ c₀ c₁ c₂ : ℝ), τ₀ ≠ t →
      ContDiffOn ℝ 2 (parabolicTestFunc d x t τ₀ c₀ c₁ c₂)
        {z : EuclideanSpace ℝ (Fin (d + 1)) | projTime z ≠ t} ∧
      limitingOperator (parabolicTestFunc d x t τ₀ c₀ c₁ c₂) (mkSpaceTime y₀ τ₀) = c₂)
    (x : EuclideanSpace ℝ (Fin d)) (t ℓ₁ ℓ₂ : ℝ) (hℓ₁ : 0 < ℓ₁) (hℓ₁₂ : ℓ₁ ≤ ℓ₂) :
    slopePlus d ℓ₁ v (mkSpaceTime x t) ≤ slopePlus d ℓ₂ v (mkSpaceTime x t) ∧
    slopeMinus d ℓ₁ v (mkSpaceTime x t) ≤ slopeMinus d ℓ₂ v (mkSpaceTime x t) :=
by
  have projTime_mkSpaceTime : ∀ (y : EuclideanSpace ℝ (Fin d)) (s : ℝ),
      projTime (mkSpaceTime y s) = s := by
    intro y s
    simp [projTime, mkSpaceTime, Fin.snoc_last]
  have projSpace_mkSpaceTime : ∀ (y : EuclideanSpace ℝ (Fin d)) (s : ℝ),
      projSpace (mkSpaceTime y s) = y := by
    intro y s
    ext i
    simp [projSpace, mkSpaceTime, Fin.snoc_castSucc]
  have mkSpaceTime_proj : ∀ (z : EuclideanSpace ℝ (Fin (d + 1))),
      mkSpaceTime (projSpace z) (projTime z) = z := by
    intro z
    ext j
    refine Fin.lastCases ?_ ?_ j
    · simp [mkSpaceTime, projTime, Fin.snoc_last]
    · intro i
      simp [mkSpaceTime, projSpace, Fin.snoc_castSucc]
  have continuous_projTime : Continuous (projTime : EuclideanSpace ℝ (Fin (d + 1)) → ℝ) :=
    PiLp.continuous_apply 2 (fun _ : Fin (d + 1) => ℝ) (Fin.last d)
  have h_chord : ∀ (E : ℝ → ℝ) (S : ℝ),
      0 < ℓ₁ → ℓ₁ < ℓ₂ →
      ContinuousOn E (Set.Icc 0 ℓ₂) →
      E 0 = 0 → E ℓ₂ = ℓ₂ * S → ℓ₁ * S < E ℓ₁ →
      ∃ ℓ₀ δ : ℝ, 0 < ℓ₀ ∧ ℓ₀ < ℓ₂ ∧ 0 < δ ∧
        ∀ ℓ ∈ Set.Icc 0 ℓ₂,
          E ℓ ≤ E ℓ₀ + (S + δ * ℓ₂ - 2 * δ * ℓ₀) * (ℓ - ℓ₀) - δ * (ℓ - ℓ₀) ^ 2 := by
    intro E S hℓ₁_pos hℓ₁₂_lt hE_cont hE0 hE2 hE_gt
    have hℓ₂_pos : 0 < ℓ₂ := lt_trans hℓ₁_pos hℓ₁₂_lt
    have h_diff_pos : 0 < ℓ₂ - ℓ₁ := sub_pos.mpr hℓ₁₂_lt
    have hD_pos : 0 < E ℓ₁ - ℓ₁ * S := sub_pos.mpr hE_gt
    set D : ℝ := E ℓ₁ - ℓ₁ * S
    set δ : ℝ := D / (2 * ℓ₁ * (ℓ₂ - ℓ₁))
    have h_denom_pos : 0 < 2 * ℓ₁ * (ℓ₂ - ℓ₁) := by positivity
    have hδ_pos : 0 < δ := div_pos hD_pos h_denom_pos
    let h : ℝ → ℝ := fun ℓ => E ℓ - S * ℓ - δ * (ℓ * (ℓ₂ - ℓ))
    have hh_cont : ContinuousOn h (Set.Icc 0 ℓ₂) := by
      refine (hE_cont.sub (continuousOn_const.mul continuousOn_id)).sub ?_
      exact continuousOn_const.mul (continuousOn_id.mul (continuousOn_const.sub continuousOn_id))
    have h_nonempty : (Set.Icc 0 ℓ₂).Nonempty := Set.nonempty_Icc.mpr (le_of_lt hℓ₂_pos)
    obtain ⟨ℓ₀, hℓ₀_mem, hℓ₀_max⟩ := isCompact_Icc.exists_isMaxOn h_nonempty hh_cont
    rw [isMaxOn_iff] at hℓ₀_max
    have hh0 : h 0 = 0 := by
      simp only [h, hE0]
      ring
    have hh2 : h ℓ₂ = 0 := by
      simp only [h, hE2]
      ring
    have h_δ_prod : δ * (ℓ₁ * (ℓ₂ - ℓ₁)) = D / 2 := by
      have h_ne1 : ℓ₁ ≠ 0 := ne_of_gt hℓ₁_pos
      have h_ne2 : ℓ₂ - ℓ₁ ≠ 0 := ne_of_gt h_diff_pos
      dsimp [δ]
      field_simp
    have hh1 : h ℓ₁ = D / 2 := by
      dsimp [h]
      rw [h_δ_prod]
      dsimp [D]
      ring
    have hℓ₁_mem : ℓ₁ ∈ Set.Icc 0 ℓ₂ := ⟨le_of_lt hℓ₁_pos, le_of_lt hℓ₁₂_lt⟩
    have hh0_pos : 0 < h ℓ₀ := by
      have hh1_le : h ℓ₁ ≤ h ℓ₀ := hℓ₀_max ℓ₁ hℓ₁_mem
      linarith
    have hℓ₀_ne0 : ℓ₀ ≠ 0 := by
      intro h_eq
      rw [h_eq, hh0] at hh0_pos
      exact lt_irrefl 0 hh0_pos
    have hℓ₀_ne2 : ℓ₀ ≠ ℓ₂ := by
      intro h_eq
      rw [h_eq, hh2] at hh0_pos
      exact lt_irrefl 0 hh0_pos
    have hℓ₀_pos : 0 < ℓ₀ := lt_of_le_of_ne hℓ₀_mem.1 (Ne.symm hℓ₀_ne0)
    have hℓ₀_lt : ℓ₀ < ℓ₂ := lt_of_le_of_ne hℓ₀_mem.2 hℓ₀_ne2
    refine ⟨ℓ₀, δ, hℓ₀_pos, hℓ₀_lt, hδ_pos, ?_⟩
    intro ℓ hℓ_mem
    have h_le : h ℓ ≤ h ℓ₀ := hℓ₀_max ℓ hℓ_mem
    dsimp [h] at h_le
    have h_poly : S * ℓ + δ * (ℓ * (ℓ₂ - ℓ)) + (E ℓ₀ - S * ℓ₀ - δ * (ℓ₀ * (ℓ₂ - ℓ₀))) =
        E ℓ₀ + (S + δ * ℓ₂ - 2 * δ * ℓ₀) * (ℓ - ℓ₀) - δ * (ℓ - ℓ₀) ^ 2 := by ring
    linarith
  rcases eq_or_lt_of_le hℓ₁₂ with rfl | hℓ₁₂_lt
  · exact ⟨le_rfl, le_rfl⟩
  have hℓ₂_pos : 0 < ℓ₂ := lt_trans hℓ₁ hℓ₁₂_lt
  let z_x := mkSpaceTime x t
  refine ⟨?_, ?_⟩
  · by_contra h_not_le
    push_neg at h_not_le
    let E_plus : ℝ → ℝ := fun ℓ => ℓ * slopePlus d ℓ v z_x
    let S_plus : ℝ := slopePlus d ℓ₂ v z_x
    have hE_gt : ℓ₁ * S_plus < E_plus ℓ₁ := mul_lt_mul_of_pos_left h_not_le hℓ₁
    have hE_cont : ContinuousOn E_plus (Set.Icc 0 ℓ₂) := (h_cont x t ℓ₂ hℓ₂_pos).1
    have hE0 : E_plus 0 = 0 := zero_mul _
    have hE2 : E_plus ℓ₂ = ℓ₂ * S_plus := rfl
    obtain ⟨ℓ₀, δ, hℓ₀_pos, hℓ₀_lt, hδ_pos, h_upper⟩ :=
      h_chord E_plus S_plus hℓ₁ hℓ₁₂_lt hE_cont hE0 hE2 hE_gt
    obtain ⟨y₀, hy₀⟩ := (h_attain x t ℓ₀ hℓ₀_pos).1
    let τ₀ : ℝ := t + ℓ₀
    let c₀ : ℝ := v z_x + E_plus ℓ₀
    let c₁ : ℝ := S_plus + δ * ℓ₂ - 2 * δ * ℓ₀
    let c₂ : ℝ := -2 * δ
    let Ψ_plus := parabolicTestFunc d x t τ₀ c₀ c₁ c₂
    let z₀ := mkSpaceTime y₀ τ₀
    let V_plus : Set (EuclideanSpace ℝ (Fin (d + 1))) :=
      {z | t < projTime z} ∩ {z | projTime z < t + ℓ₂}
    have hV_open : IsOpen V_plus :=
      IsOpen.inter (isOpen_lt continuous_const continuous_projTime)
        (isOpen_lt continuous_projTime continuous_const)
    have hz₀_mem : z₀ ∈ V_plus := by
      simp only [V_plus, Set.mem_inter_iff, Set.mem_setOf_eq, z₀, projTime_mkSpaceTime, τ₀]
      constructor <;> linarith
    have hτ₀_ne : τ₀ ≠ t := by
      dsimp [τ₀]
      linarith
    have hΨ_c2 : ContDiffOn ℝ 2 Ψ_plus V_plus := by
      refine (h_test x y₀ t τ₀ c₀ c₁ c₂ hτ₀_ne).1.mono ?_
      intro z hz
      simp only [V_plus, Set.mem_inter_iff, Set.mem_setOf_eq] at hz ⊢
      exact ne_of_gt hz.1
    have hΨ_z₀ : Ψ_plus z₀ = v z₀ := by
      dsimp [Ψ_plus, parabolicTestFunc, z₀, τ₀, c₀, z_x, E_plus] at hy₀ ⊢
      rw [projSpace_mkSpaceTime, projTime_mkSpaceTime]
      have h_sub1 : t + ℓ₀ - (t + ℓ₀) = 0 := by ring
      have h_sub2 : t + ℓ₀ - t = ℓ₀ := by ring
      rw [h_sub1, h_sub2]
      linarith
    have hΨ_ge : ∀ z ∈ V_plus, v z ≤ Ψ_plus z := by
      intro z hz
      simp only [V_plus, Set.mem_inter_iff, Set.mem_setOf_eq] at hz
      let y := projSpace z
      let ℓ := projTime z - t
      have hℓ_pos : 0 < ℓ := by dsimp [ℓ]; linarith
      have hℓ_lt : ℓ < ℓ₂ := by dsimp [ℓ]; linarith
      have hℓ_mem : ℓ ∈ Set.Icc 0 ℓ₂ := ⟨le_of_lt hℓ_pos, le_of_lt hℓ_lt⟩
      have hz_eq : mkSpaceTime y (t + ℓ) = z := by
        have ht : t + ℓ = projTime z := by dsimp [ℓ]; ring
        rw [ht]
        exact mkSpaceTime_proj z
      have h_comp_z := (h_comp x y t ℓ hℓ_pos).1
      rw [hz_eq] at h_comp_z
      have h_up_ℓ := h_upper ℓ hℓ_mem
      dsimp [Ψ_plus, parabolicTestFunc, τ₀, c₀, c₁, c₂, z_x, E_plus, y, ℓ] at h_comp_z h_up_ℓ ⊢
      have h_poly : c₁ * (projTime z - (t + ℓ₀)) + (-2 * δ / 2) * (projTime z - (t + ℓ₀)) ^ 2 =
          c₁ * (projTime z - t - ℓ₀) - δ * (projTime z - t - ℓ₀) ^ 2 := by ring
      linarith
    have h_visc := hv.2.1 z₀ Ψ_plus V_plus hV_open hz₀_mem hΨ_c2 hΨ_z₀ hΨ_ge
    have h_op := (h_test x y₀ t τ₀ c₀ c₁ c₂ hτ₀_ne).2
    dsimp [Ψ_plus, z₀, c₂] at h_visc h_op
    linarith
  · by_contra h_not_le
    push_neg at h_not_le
    let E_minus : ℝ → ℝ := fun ℓ => ℓ * slopeMinus d ℓ v z_x
    let S_minus : ℝ := slopeMinus d ℓ₂ v z_x
    have hE_gt : ℓ₁ * S_minus < E_minus ℓ₁ := mul_lt_mul_of_pos_left h_not_le hℓ₁
    have hE_cont : ContinuousOn E_minus (Set.Icc 0 ℓ₂) := (h_cont x t ℓ₂ hℓ₂_pos).2
    have hE0 : E_minus 0 = 0 := zero_mul _
    have hE2 : E_minus ℓ₂ = ℓ₂ * S_minus := rfl
    obtain ⟨ℓ₀, δ, hℓ₀_pos, hℓ₀_lt, hδ_pos, h_upper⟩ :=
      h_chord E_minus S_minus hℓ₁ hℓ₁₂_lt hE_cont hE0 hE2 hE_gt
    obtain ⟨y₀, hy₀⟩ := (h_attain x t ℓ₀ hℓ₀_pos).2
    let τ₀ : ℝ := t - ℓ₀
    let c₀ : ℝ := v z_x - E_minus ℓ₀
    let c₁ : ℝ := S_minus + δ * ℓ₂ - 2 * δ * ℓ₀
    let c₂ : ℝ := 2 * δ
    let Ψ_minus := parabolicTestFunc d x t τ₀ c₀ c₁ c₂
    let z₀ := mkSpaceTime y₀ τ₀
    let V_minus : Set (EuclideanSpace ℝ (Fin (d + 1))) :=
      {z | t - ℓ₂ < projTime z} ∩ {z | projTime z < t}
    have hV_open : IsOpen V_minus :=
      IsOpen.inter (isOpen_lt continuous_const continuous_projTime)
        (isOpen_lt continuous_projTime continuous_const)
    have hz₀_mem : z₀ ∈ V_minus := by
      simp only [V_minus, Set.mem_inter_iff, Set.mem_setOf_eq, z₀, projTime_mkSpaceTime, τ₀]
      constructor <;> linarith
    have hτ₀_ne : τ₀ ≠ t := by
      dsimp [τ₀]
      linarith
    have hΨ_c2 : ContDiffOn ℝ 2 Ψ_minus V_minus := by
      refine (h_test x y₀ t τ₀ c₀ c₁ c₂ hτ₀_ne).1.mono ?_
      intro z hz
      simp only [V_minus, Set.mem_inter_iff, Set.mem_setOf_eq] at hz ⊢
      exact ne_of_lt hz.2
    have hΨ_z₀ : Ψ_minus z₀ = v z₀ := by
      dsimp [Ψ_minus, parabolicTestFunc, z₀, τ₀, c₀, z_x, E_minus] at hy₀ ⊢
      rw [projSpace_mkSpaceTime, projTime_mkSpaceTime]
      have h_sub1 : t - ℓ₀ - (t - ℓ₀) = 0 := by ring
      have h_denom : 2 * (t - ℓ₀ - t) = -(2 * ℓ₀) := by ring
      rw [h_sub1, h_denom, div_neg]
      linarith
    have hΨ_le : ∀ z ∈ V_minus, Ψ_minus z ≤ v z := by
      intro z hz
      simp only [V_minus, Set.mem_inter_iff, Set.mem_setOf_eq] at hz
      let y := projSpace z
      let ℓ := t - projTime z
      have hℓ_pos : 0 < ℓ := by dsimp [ℓ]; linarith
      have hℓ_lt : ℓ < ℓ₂ := by dsimp [ℓ]; linarith
      have hℓ_mem : ℓ ∈ Set.Icc 0 ℓ₂ := ⟨le_of_lt hℓ_pos, le_of_lt hℓ_lt⟩
      have hz_eq : mkSpaceTime y (t - ℓ) = z := by
        have ht : t - ℓ = projTime z := by dsimp [ℓ]; ring
        rw [ht]
        exact mkSpaceTime_proj z
      have h_comp_z := (h_comp x y t ℓ hℓ_pos).2
      rw [hz_eq] at h_comp_z
      have h_up_ℓ := h_upper ℓ hℓ_mem
      dsimp [Ψ_minus, parabolicTestFunc, τ₀, c₀, c₁, c₂, z_x, E_minus, y, ℓ] at h_comp_z h_up_ℓ ⊢
      have h_denom : 2 * (projTime z - t) = -(2 * (t - projTime z)) := by ring
      rw [h_denom, div_neg]
      have h_poly : c₁ * (projTime z - (t - ℓ₀)) + (2 * δ / 2) * (projTime z - (t - ℓ₀)) ^ 2 =
          -(c₁ * (t - projTime z - ℓ₀) - δ * (t - projTime z - ℓ₀) ^ 2) := by ring
      linarith
    have h_visc := hv.2.2.1 z₀ Ψ_minus V_minus hV_open hz₀_mem hΨ_c2 hΨ_z₀ hΨ_le
    have h_op := (h_test x y₀ t τ₀ c₀ c₁ c₂ hτ₀_ne).2
    dsimp [Ψ_minus, z₀, c₂] at h_visc h_op
    linarith

theorem envelope_attainment_and_slope_monotonicity (d : ℕ) (C₁ : ℝ) (hC₁ : 0 ≤ C₁)
    (v : EuclideanSpace ℝ (Fin (d + 1)) → ℝ) (hv : InLimitingClassA d C₁ v)
    (h_growth : ∀ (t₁ t₂ ε : ℝ), 0 < ε → ∃ M : ℝ, ∀ (y : EuclideanSpace ℝ (Fin d)) (s : ℝ),
      t₁ ≤ s → s ≤ t₂ → |v (mkSpaceTime y s)| ≤ M + ε * ‖y‖ ^ 2) :
    (∀ (x y : EuclideanSpace ℝ (Fin d)) (t ℓ : ℝ), 0 < ℓ →
      v (mkSpaceTime y (t + ℓ)) - v (mkSpaceTime x t) - ‖y - x‖ ^ 2 / (2 * ℓ) ≤
        ℓ * slopePlus d ℓ v (mkSpaceTime x t) ∧
      v (mkSpaceTime x t) - v (mkSpaceTime y (t - ℓ)) - ‖y - x‖ ^ 2 / (2 * ℓ) ≤
        ℓ * slopeMinus d ℓ v (mkSpaceTime x t)) ∧
    (∀ (x : EuclideanSpace ℝ (Fin d)) (t ℓ : ℝ), 0 < ℓ →
      (∃ y_plus : EuclideanSpace ℝ (Fin d),
        v (mkSpaceTime y_plus (t + ℓ)) - v (mkSpaceTime x t) - ‖y_plus - x‖ ^ 2 / (2 * ℓ) =
          ℓ * slopePlus d ℓ v (mkSpaceTime x t)) ∧
      (∃ y_minus : EuclideanSpace ℝ (Fin d),
        v (mkSpaceTime x t) - v (mkSpaceTime y_minus (t - ℓ)) - ‖y_minus - x‖ ^ 2 / (2 * ℓ) =
          ℓ * slopeMinus d ℓ v (mkSpaceTime x t))) ∧
    (∀ (x : EuclideanSpace ℝ (Fin d)) (t ℓ₁ ℓ₂ : ℝ), 0 < ℓ₁ → ℓ₁ ≤ ℓ₂ →
      slopePlus d ℓ₁ v (mkSpaceTime x t) ≤ slopePlus d ℓ₂ v (mkSpaceTime x t) ∧
      slopeMinus d ℓ₁ v (mkSpaceTime x t) ≤ slopeMinus d ℓ₂ v (mkSpaceTime x t)) :=
by
  obtain ⟨h_comp, h_attain, h_loc⟩ :=
    envelope_competitor_attainment_and_localization d v hv.1 h_growth
  have h_cont :=
    scaled_slope_continuousOn_Icc d v hv.1 h_comp h_attain h_loc
  have h_test :=
    parabolicTestFunc_contDiffOn_and_limitingOperator d
  have h_mono :=
    slope_monotonicity_of_continuous_and_parabolic_test d C₁ v hv h_comp h_attain h_cont h_test
  exact ⟨h_comp, h_attain, h_mono⟩

theorem common_slope_limit_of_monotone_envelopes (d : ℕ)
    (v : EuclideanSpace ℝ (Fin (d + 1)) → ℝ) (hv_cont : Continuous v)
    (h_growth : ∀ (t₁ t₂ ε : ℝ), 0 < ε → ∃ M : ℝ, ∀ (y : EuclideanSpace ℝ (Fin d)) (s : ℝ),
      t₁ ≤ s → s ≤ t₂ → |v (mkSpaceTime y s)| ≤ M + ε * ‖y‖ ^ 2)
    (h_comp : ∀ (x y : EuclideanSpace ℝ (Fin d)) (t ℓ : ℝ), 0 < ℓ →
      v (mkSpaceTime y (t + ℓ)) - v (mkSpaceTime x t) - ‖y - x‖ ^ 2 / (2 * ℓ) ≤
        ℓ * slopePlus d ℓ v (mkSpaceTime x t) ∧
      v (mkSpaceTime x t) - v (mkSpaceTime y (t - ℓ)) - ‖y - x‖ ^ 2 / (2 * ℓ) ≤
        ℓ * slopeMinus d ℓ v (mkSpaceTime x t))
    (h_attain : ∀ (x : EuclideanSpace ℝ (Fin d)) (t ℓ : ℝ), 0 < ℓ →
      (∃ y_plus : EuclideanSpace ℝ (Fin d),
        v (mkSpaceTime y_plus (t + ℓ)) - v (mkSpaceTime x t) - ‖y_plus - x‖ ^ 2 / (2 * ℓ) =
          ℓ * slopePlus d ℓ v (mkSpaceTime x t)) ∧
      (∃ y_minus : EuclideanSpace ℝ (Fin d),
        v (mkSpaceTime x t) - v (mkSpaceTime y_minus (t - ℓ)) - ‖y_minus - x‖ ^ 2 / (2 * ℓ) =
          ℓ * slopeMinus d ℓ v (mkSpaceTime x t)))
    (h_mono : ∀ (x : EuclideanSpace ℝ (Fin d)) (t ℓ₁ ℓ₂ : ℝ), 0 < ℓ₁ → ℓ₁ ≤ ℓ₂ →
      slopePlus d ℓ₁ v (mkSpaceTime x t) ≤ slopePlus d ℓ₂ v (mkSpaceTime x t) ∧
      slopeMinus d ℓ₁ v (mkSpaceTime x t) ≤ slopeMinus d ℓ₂ v (mkSpaceTime x t)) :
    (∀ (x : EuclideanSpace ℝ (Fin d)) (t L : ℝ),
      (∀ ℓ : ℝ, 0 < ℓ → ℓ < 1 → L ≤ slopeMinus d ℓ v (mkSpaceTime x t)) →
      ∀ h : ℝ, 0 < h → L ≤ slopePlus d h v (mkSpaceTime x t)) ∧
    (∀ (x : EuclideanSpace ℝ (Fin d)) (t L : ℝ),
      (∀ ℓ : ℝ, 0 < ℓ → L ≤ slopePlus d ℓ v (mkSpaceTime x t)) →
      ∃ H_star : ℝ, HasCommonSlopeLimit d v (mkSpaceTime x t) H_star) :=
by
  have h_loc : ∀ (t₁ t₂ R₀ ℓ₀ : ℝ), 0 ≤ R₀ → 0 < ℓ₀ →
      ∃ C : ℝ, 0 ≤ C ∧
        ∀ (x' y : EuclideanSpace ℝ (Fin d)) (t' ℓ : ℝ),
          ‖x'‖ ≤ R₀ → 0 < ℓ → ℓ ≤ ℓ₀ →
          (t₁ ≤ t' + ℓ → t' + ℓ ≤ t₂ →
            v (mkSpaceTime y (t' + ℓ)) - v (mkSpaceTime x' t') - ‖y - x'‖ ^ 2 / (2 * ℓ) =
              ℓ * slopePlus d ℓ v (mkSpaceTime x' t') →
            ‖y - x'‖ ^ 2 ≤ C * ℓ) ∧
          (t₁ ≤ t' - ℓ → t' - ℓ ≤ t₂ →
            v (mkSpaceTime x' t') - v (mkSpaceTime y (t' - ℓ)) - ‖y - x'‖ ^ 2 / (2 * ℓ) =
              ℓ * slopeMinus d ℓ v (mkSpaceTime x' t') →
            ‖y - x'‖ ^ 2 ≤ C * ℓ) := by
    intro t₁ t₂ R₀ ℓ₀ hR₀ hℓ₀
    have hε_pos : (0 : ℝ) < 1 / (8 * ℓ₀) := by positivity
    obtain ⟨M, hM⟩ := h_growth t₁ t₂ (1 / (8 * ℓ₀)) hε_pos
    let C : ℝ := 8 * max M 0 + (3 / (2 * ℓ₀)) * R₀ ^ 2
    have hC_nonneg : 0 ≤ C := by positivity
    have h_coercive : ∀ (x' y : EuclideanSpace ℝ (Fin d)) (s ℓ : ℝ),
        ‖x'‖ ≤ R₀ → 0 < ℓ → ℓ ≤ ℓ₀ → t₁ ≤ s → s ≤ t₂ →
        ‖y - x'‖ ^ 2 / (2 * ℓ) ≤ |v (mkSpaceTime y s)| + |v (mkSpaceTime x' s)| →
        ‖y - x'‖ ^ 2 ≤ C * ℓ := by
      intro x' y s ℓ hx' hℓ_pos hℓ_le hs₁ hs₂ h_ineq
      have hy_tri : ‖y‖ ≤ ‖y - x'‖ + R₀ := by
        have h1 : ‖y‖ ≤ ‖y - x'‖ + ‖x'‖ := by
          simpa [sub_add_cancel] using norm_add_le (y - x') x'
        linarith
      have hx'_nonneg : 0 ≤ ‖x'‖ := norm_nonneg x'
      have hy_nonneg : 0 ≤ ‖y‖ := norm_nonneg y
      have hx'_sq : ‖x'‖ ^ 2 ≤ R₀ ^ 2 := by nlinarith
      have hy_sq : ‖y‖ ^ 2 ≤ 2 * ‖y - x'‖ ^ 2 + 2 * R₀ ^ 2 := by
        have h1 : ‖y‖ ^ 2 ≤ (‖y - x'‖ + R₀) ^ 2 := by nlinarith
        have h2 : 0 ≤ (‖y - x'‖ - R₀) ^ 2 := sq_nonneg (‖y - x'‖ - R₀)
        linarith
      have hvy := hM y s hs₁ hs₂
      have hvx' := hM x' s hs₁ hs₂
      have hM_le : M ≤ max M 0 := le_max_left M 0
      have h_sum_bound : |v (mkSpaceTime y s)| + |v (mkSpaceTime x' s)| ≤
          C / 4 + ‖y - x'‖ ^ 2 / (4 * ℓ₀) := by
        have h1 : (1 / (8 * ℓ₀)) * ‖y‖ ^ 2 ≤
            (1 / (8 * ℓ₀)) * (2 * ‖y - x'‖ ^ 2 + 2 * R₀ ^ 2) :=
          mul_le_mul_of_nonneg_left hy_sq (by positivity)
        have h2 : (1 / (8 * ℓ₀)) * ‖x'‖ ^ 2 ≤ (1 / (8 * ℓ₀)) * R₀ ^ 2 :=
          mul_le_mul_of_nonneg_left hx'_sq (by positivity)
        have hC_def : C = 8 * max M 0 + (3 / (2 * ℓ₀)) * R₀ ^ 2 := rfl
        have h_alg : 2 * max M 0 + (1 / (8 * ℓ₀)) * (2 * ‖y - x'‖ ^ 2 + 2 * R₀ ^ 2) +
            (1 / (8 * ℓ₀)) * R₀ ^ 2 = C / 4 + ‖y - x'‖ ^ 2 / (4 * ℓ₀) := by
          rw [hC_def]
          have hℓ₀_ne : ℓ₀ ≠ 0 := ne_of_gt hℓ₀
          field_simp [hℓ₀_ne]
          ring
        linarith
      have h_div_ineq : ‖y - x'‖ ^ 2 / (2 * ℓ) ≤ C / 4 + ‖y - x'‖ ^ 2 / (4 * ℓ₀) :=
        le_trans h_ineq h_sum_bound
      have h_mul : 4 * ℓ * (‖y - x'‖ ^ 2 / (2 * ℓ)) ≤
          4 * ℓ * (C / 4 + ‖y - x'‖ ^ 2 / (4 * ℓ₀)) :=
        mul_le_mul_of_nonneg_left h_div_ineq (by positivity)
      have h_lhs : 4 * ℓ * (‖y - x'‖ ^ 2 / (2 * ℓ)) = 2 * ‖y - x'‖ ^ 2 := by
        have hℓ_ne : ℓ ≠ 0 := ne_of_gt hℓ_pos
        field_simp [hℓ_ne]
        ring
      have h_rhs : 4 * ℓ * (C / 4 + ‖y - x'‖ ^ 2 / (4 * ℓ₀)) =
          C * ℓ + ℓ * (‖y - x'‖ ^ 2 / ℓ₀) := by
        have hℓ₀_ne : ℓ₀ ≠ 0 := ne_of_gt hℓ₀
        field_simp [hℓ₀_ne]
      have h_scale : ℓ * (‖y - x'‖ ^ 2 / ℓ₀) ≤ ‖y - x'‖ ^ 2 := by
        have h1 : ℓ * (‖y - x'‖ ^ 2 / ℓ₀) ≤ ℓ₀ * (‖y - x'‖ ^ 2 / ℓ₀) :=
          mul_le_mul_of_nonneg_right hℓ_le (by positivity)
        have h2 : ℓ₀ * (‖y - x'‖ ^ 2 / ℓ₀) = ‖y - x'‖ ^ 2 :=
          mul_div_cancel₀ _ (ne_of_gt hℓ₀)
        linarith
      linarith
    refine ⟨C, hC_nonneg, fun x' y t' ℓ hx' hℓ_pos hℓ_le => ⟨?_, ?_⟩⟩
    · intro hs₁ hs₂ h_opt
      have h_stat := (h_comp x' x' t' ℓ hℓ_pos).1
      simp only [sub_self, norm_zero, ne_eq, OfNat.ofNat_ne_zero, not_false_eq_true, zero_pow,
        zero_div, sub_zero] at h_stat
      have h1 : ‖y - x'‖ ^ 2 / (2 * ℓ) ≤
          v (mkSpaceTime y (t' + ℓ)) - v (mkSpaceTime x' (t' + ℓ)) := by linarith
      have h2 : v (mkSpaceTime y (t' + ℓ)) ≤ |v (mkSpaceTime y (t' + ℓ))| := le_abs_self _
