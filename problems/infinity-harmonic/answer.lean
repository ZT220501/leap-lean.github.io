      dsimp [anisotropicRescale, z]
      rw [h_projSpace_mk, h_projTime_mk]
    dsimp [Δ_res]
    rw [h_unfold1, h_unfold2, h_P_inner_phys]
    have h_denom_ne : r * c * lam ≠ 0 := by positivity
    field_simp [h_denom_ne]
    ring
  have h_rcl_pos : 0 < r * c * lam := by positivity
  rw [h_res_ident, abs_mul, abs_of_pos h_rcl_pos] at h_fit_ineq
  have h_half_pos : 0 < (1 / 2) * r * lam := by positivity
  have h_comb : ((1 / 2) * r * lam) * |Δ_res| ≤ ((1 / 2) * r * lam) * (64 * S) := by
    have h1 : (1 / 2) * r * lam ≤ r * c * lam := by nlinarith
    have h2 := mul_le_mul_of_nonneg_right h1 (abs_nonneg Δ_res)
    linarith
  exact le_of_mul_le_mul_left h_comb h_half_pos

theorem rescaled_sheared_box_fits_of_selected_scales (d : ℕ) (hd : 3 ≤ d) (L : ℝ) (hL_ge : 1 ≤ L)
    (hL : HasUniformNormalizedLiftBounds d L)
    (h_comp : HasCylinderFitComparisonBounds d L)
    (u_seq : ℕ → EuclideanSpace ℝ (Fin d) → ℝ)
    (z_seq : ℕ → EuclideanSpace ℝ (Fin (d + 1)))
    (r_seq lam_seq : ℕ → ℝ)
    (h_scales : HasSelectedBlowupScales d u_seq z_seq r_seq lam_seq)
    (P_base : ℕ → EuclideanSpace ℝ (Fin (d + 1)))
    (O_base : ℕ → (EuclideanSpace ℝ (Fin (d + 1)) ≃ₗᵢ[ℝ] EuclideanSpace ℝ (Fin (d + 1))))
    (h_base : IsBaseSlopeAndFrameSeq d L u_seq z_seq r_seq lam_seq P_base O_base) :
    HasUniformRescaledShearedBoxFits d lam_seq
      (fun i => anisotropicRescale (liftFunc (u_seq i)) (z_seq i) (r_seq i) ‖P_base i‖ (lam_seq i) (O_base i)) :=
by
  intro K S hK_pos hS_pos
  obtain ⟨C_comp, hC_pos, hC_body⟩ := h_comp
  have hC_comp : IsCylinderComparisonConstant d L C_comp := ⟨hC_pos, hC_body⟩
  obtain ⟨n, hn_gt⟩ := exists_nat_gt (max 1 (4 * K * (2 + 3 * C_comp)))
  have hn_gt1 : (1 : ℝ) < (n : ℝ) := (le_max_left _ _).trans_lt hn_gt
  have hn_gtK : 4 * K * (2 + 3 * C_comp) < (n : ℝ) := (le_max_right _ _).trans_lt hn_gt
  let m : ℕ := 2 * n
  let R : ℝ := (2 : ℝ) ^ m
  have hn_pow_nat : n < 2 ^ n := Nat.lt_two_pow_self
  have hn_pow : (n : ℝ) ≤ (2 : ℝ) ^ n := by exact_mod_cast hn_pow_nat.le
  have hR_eq : R = ((2 : ℝ) ^ n) ^ 2 := by
    dsimp [R, m]
    rw [mul_comm, pow_mul]
  have hn_sq_le_R : (n : ℝ) ^ 2 ≤ R := by
    rw [hR_eq]
    nlinarith
  have hm_cast : (m : ℝ) = 2 * (n : ℝ) := by
    dsimp [m]
    push_cast
    ring
  let B₁ : ℝ := ((m : ℝ) + 1) * C_comp
  have hB₁_nonneg : 0 ≤ B₁ := by positivity
  have hR_ge1 : 1 ≤ R := by nlinarith
  have hR_K : 8 * K ≤ R := by nlinarith
  have hR_B₁ : 4 * K * (1 + B₁) ≤ R := by
    have h_factor : 1 + B₁ ≤ (n : ℝ) * (2 + 3 * C_comp) := by
      dsimp [B₁]
      rw [hm_cast]
      nlinarith [mul_nonneg (sub_nonneg.mpr hn_gt1.le) hC_pos.le]
    have h1 : 4 * K * (1 + B₁) ≤ 4 * K * ((n : ℝ) * (2 + 3 * C_comp)) :=
      mul_le_mul_of_nonneg_left h_factor (by linarith)
    have h2 : 4 * K * ((n : ℝ) * (2 + 3 * C_comp)) = (n : ℝ) * (4 * K * (2 + 3 * C_comp)) := by
      ring
    nlinarith
  have hR_pos : 0 < R := by linarith
  obtain ⟨k, hk_gt⟩ := exists_nat_gt (max (R / S) (S / R))
  have hk_RS : R / S < (k : ℝ) := (le_max_left _ _).trans_lt hk_gt
  have hk_SR : S / R < (k : ℝ) := (le_max_right _ _).trans_lt hk_gt
  have hk_pow_nat : k < 2 ^ k := Nat.lt_two_pow_self
  have hk_pow : (k : ℝ) ≤ (2 : ℝ) ^ k := by exact_mod_cast hk_pow_nat.le
  have hR_le_kS : R ≤ (2 : ℝ) ^ k * S :=
    (div_le_iff₀ hS_pos).mp (hk_RS.le.trans hk_pow)
  have hS_le_kR : S ≤ (2 : ℝ) ^ k * R :=
    (div_le_iff₀ hR_pos).mp (hk_SR.le.trans hk_pow)
  let M : ℝ := 2 + 2 * K + R + S
  have hM : 2 ≤ M := by dsimp [M]; linarith
  obtain ⟨i₁, hi₁⟩ :=
    admissible_cylinder_fits_of_selected_scales d hd L hL_ge hL u_seq z_seq r_seq lam_seq h_scales M hM
  let B₂ : ℝ := ((k : ℝ) + 1) * C_comp
  have hB₂_nonneg : 0 ≤ B₂ := by positivity
  let B : ℝ := B₁ + C_comp + B₂
  have hB_nonneg : 0 ≤ B := by positivity
  let C_KS : ℝ := 2 * Real.sqrt 32 * (L + 1) * B + 32 * (L + 1) * B ^ 2 + 64 * B
  have hC_KS_nonneg : 0 ≤ C_KS := by positivity
  have h_denom_pos : 0 < (C_KS + 1) ^ 2 := by positivity
  have h_delta_pos : 0 < (1 / 64 : ℝ) / ((C_KS + 1) ^ 2) := div_pos (by norm_num) h_denom_pos
  obtain ⟨i₂, hi₂⟩ :=
    (Metric.tendsto_atTop.mp h_scales.2.1) ((1 / 64 : ℝ) / ((C_KS + 1) ^ 2)) h_delta_pos
  refine ⟨C_KS, max i₁ i₂, hC_KS_nonneg, ?_⟩
  intro i hi x t hxt
  have hi₁_le : i₁ ≤ i := (le_max_left i₁ i₂).trans hi
  have hi₂_le : i₂ ≤ i := (le_max_right i₁ i₂).trans hi
  obtain ⟨hθ_pos, hθ_lt, hθ_sq, h_adm⟩ := hi₁ i hi₁_le
  let θ : ℝ := Real.sqrt (32 * lam_seq i)
  obtain ⟨_, _, hr_pos, _, hlam_pos, hlam_lt, _, _⟩ := h_scales.1 i
  obtain ⟨hP_base_fit, hP_base_lower, hP_base_upper, hO_eb⟩ := h_base i
  have hP_base_bdd :
      IsBoundedCylinderFitAt d L (liftFunc (u_seq i)) (z_seq i) (r_seq i) (θ ^ 2) (P_base i) := by
    refine ⟨?_, hP_base_lower, hP_base_upper⟩
    dsimp [θ]
    rw [hθ_sq]
    exact hP_base_fit
  have h_zi_dist : ‖z_seq i - z_seq i‖ ≤ M * r_seq i := by
    rw [sub_self, norm_zero]
    positivity
  have hRr_pos : 0 < R * r_seq i := mul_pos hR_pos hr_pos
  have hRr_le_M : R * r_seq i ≤ M * r_seq i :=
    mul_le_mul_of_nonneg_right (by dsimp [M]; linarith) hr_pos.le
  obtain ⟨P_R, hP_R⟩ := h_adm (z_seq i) h_zi_dist (R * r_seq i) hRr_pos hRr_le_M
  have hr_le_M : r_seq i ≤ M * r_seq i := by
    have h1 : 1 * r_seq i ≤ M * r_seq i :=
      mul_le_mul_of_nonneg_right (by dsimp [M]; linarith) hr_pos.le
    linarith
  have hr_le_mRr : r_seq i ≤ (2 : ℝ) ^ m * (R * r_seq i) := by
    have h1 : 1 ≤ (2 : ℝ) ^ m * R := by
      change 1 ≤ R * R
      nlinarith
    have h2 : 1 * r_seq i ≤ ((2 : ℝ) ^ m * R) * r_seq i :=
      mul_le_mul_of_nonneg_right h1 hr_pos.le
    linarith
  have hRr_le_mr : R * r_seq i ≤ (2 : ℝ) ^ m * r_seq i := le_refl _
  obtain ⟨h_dir_R_rev, h_norm_R_rev⟩ :=
    same_center_multi_scale_cylinder_comparison d hd L C_comp hC_comp
      (liftFunc (u_seq i)) (z_seq i) (M * r_seq i) θ hθ_pos hθ_lt (h_adm (z_seq i) h_zi_dist)
      m (r_seq i) (R * r_seq i) hr_pos hRr_pos hr_le_M hRr_le_M hr_le_mRr hRr_le_mr
      (P_base i) P_R hP_base_bdd hP_R
  have h_dir_R : ‖(‖P_R‖⁻¹) • P_R - (‖P_base i‖⁻¹) • P_base i‖ ≤ B₁ * θ := by
    rw [norm_sub_rev]
    exact h_dir_R_rev
  have h_norm_R : |‖P_R‖ - ‖P_base i‖| ≤ B₁ * θ ^ 2 := by
    rw [abs_sub_comm]
    exact h_norm_R_rev
  obtain ⟨hz_dist_2K, h_displaced⟩ :=
    displaced_box_center_cylinder_comparison d hd L C_comp hC_comp
      (liftFunc (u_seq i)) (z_seq i) (r_seq i) ‖P_base i‖ (lam_seq i) K R B₁
      (O_base i) (P_base i) P_R
      hr_pos hlam_pos hlam_lt hK_pos hB₁_nonneg hR_K hR_B₁ hO_eb rfl
      hP_R h_dir_R h_norm_R x t hxt
  let z : EuclideanSpace ℝ (Fin (d + 1)) :=
    z_seq i + r_seq i • O_base i (mkSpaceTime (Real.sqrt (lam_seq i) • x) t)
  have hz_dist_M : ‖z - z_seq i‖ ≤ M * r_seq i := by
    have h1 : 2 * K * r_seq i ≤ M * r_seq i :=
      mul_le_mul_of_nonneg_right (by dsimp [M]; linarith) hr_pos.le
    exact hz_dist_2K.trans h1
  obtain ⟨P_zR, hP_zR⟩ := h_adm z hz_dist_M (R * r_seq i) hRr_pos hRr_le_M
  obtain ⟨h_dir_zR, h_norm_zR⟩ := h_displaced P_zR hP_zR
  have hSr_pos : 0 < S * r_seq i := mul_pos hS_pos hr_pos
  have hSr_le_M : S * r_seq i ≤ M * r_seq i :=
    mul_le_mul_of_nonneg_right (by dsimp [M]; linarith) hr_pos.le
  obtain ⟨P, hP⟩ := h_adm z hz_dist_M (S * r_seq i) hSr_pos hSr_le_M
  have hRr_le_kSr : R * r_seq i ≤ (2 : ℝ) ^ k * (S * r_seq i) := by
    calc R * r_seq i ≤ ((2 : ℝ) ^ k * S) * r_seq i :=
          mul_le_mul_of_nonneg_right hR_le_kS hr_pos.le
      _ = (2 : ℝ) ^ k * (S * r_seq i) := by ring
  have hSr_le_kRr : S * r_seq i ≤ (2 : ℝ) ^ k * (R * r_seq i) := by
    calc S * r_seq i ≤ ((2 : ℝ) ^ k * R) * r_seq i :=
          mul_le_mul_of_nonneg_right hS_le_kR hr_pos.le
      _ = (2 : ℝ) ^ k * (R * r_seq i) := by ring
  obtain ⟨h_dir_zS_rev, h_norm_zS_rev⟩ :=
    same_center_multi_scale_cylinder_comparison d hd L C_comp hC_comp
      (liftFunc (u_seq i)) z (M * r_seq i) θ hθ_pos hθ_lt (h_adm z hz_dist_M)
      k (R * r_seq i) (S * r_seq i) hRr_pos hSr_pos hRr_le_M hSr_le_M hRr_le_kSr hSr_le_kRr
      P_zR P hP_zR hP
  have h_dir_P : ‖(‖P‖⁻¹) • P - (‖P_base i‖⁻¹) • P_base i‖ ≤ B * θ := by
    have h1 : ‖(‖P‖⁻¹) • P - (‖P_zR‖⁻¹) • P_zR‖ ≤ B₂ * θ := by
      rw [norm_sub_rev]
      exact h_dir_zS_rev
    have h2 : ‖(‖P‖⁻¹) • P - (‖P_base i‖⁻¹) • P_base i‖ ≤
        ‖(‖P‖⁻¹) • P - (‖P_zR‖⁻¹) • P_zR‖ + ‖(‖P_zR‖⁻¹) • P_zR - (‖P_base i‖⁻¹) • P_base i‖ := by
      simpa only [sub_add_sub_cancel] using
        norm_add_le ((‖P‖⁻¹) • P - (‖P_zR‖⁻¹) • P_zR) ((‖P_zR‖⁻¹) • P_zR - (‖P_base i‖⁻¹) • P_base i)
    dsimp [B]
    linarith
  have h_norm_P : |‖P‖ - ‖P_base i‖| ≤ B * (32 * lam_seq i) := by
    have h1 : |‖P‖ - ‖P_zR‖| ≤ B₂ * θ ^ 2 := by
      rw [abs_sub_comm]
      exact h_norm_zS_rev
    have h2 := abs_sub_le ‖P‖ ‖P_zR‖ ‖P_base i‖
    have h3 : |‖P‖ - ‖P_base i‖| ≤ B * θ ^ 2 := by
      dsimp [B]
      linarith
    rwa [hθ_sq] at h3
  have hlam_small : lam_seq i * (C_KS + 1) ^ 2 ≤ 1 / 64 := by
    have h_dist := hi₂ i hi₂_le
    rw [Real.dist_eq, sub_zero, abs_of_pos hlam_pos] at h_dist
    exact (le_div_iff₀ h_denom_pos).mp h_dist.le
  have hP_32 :
      IsBoundedCylinderFitAt d L (liftFunc (u_seq i)) z (S * r_seq i) (32 * lam_seq i) P := by
    rwa [← hθ_sq]
  exact sheared_box_fit_of_cylinder_fit_and_slope_bounds d hd L hL_ge (liftFunc (u_seq i))
    (z_seq i) (r_seq i) ‖P_base i‖ (lam_seq i) S B (O_base i) (P_base i) P
    hr_pos hP_base_lower hP_base_upper hlam_pos hlam_lt hS_pos hB_nonneg hO_eb
    x t hP_32 h_dir_P h_norm_P hlam_small

theorem subseq_limit_and_fits_of_rescaled_sheared_box_fits (d : ℕ) (hd : 3 ≤ d)
    (lam_seq : ℕ → ℝ) (hlam_pos : ∀ i : ℕ, 0 < lam_seq i)
    (hlam_tendsto : Filter.Tendsto lam_seq Filter.atTop (nhds 0))
    (v_seq : ℕ → EuclideanSpace ℝ (Fin (d + 1)) → ℝ)
    (hv_zero : ∀ i : ℕ, v_seq i 0 = 0)
    (h_boxes : HasUniformRescaledShearedBoxFits d lam_seq v_seq) :
    ∃ (v : EuclideanSpace ℝ (Fin (d + 1)) → ℝ) (k : ℕ → ℕ),
      v 0 = 0 ∧
      Continuous v ∧
      StrictMono k ∧
      (∀ K ε : ℝ, 0 < K → 0 < ε →
        ∃ i₀ : ℕ, ∀ i : ℕ, i₀ ≤ i →
          ∀ w : EuclideanSpace ℝ (Fin (d + 1)), ‖w‖ ≤ K →
            |v_seq (k i) w - v w| ≤ ε) ∧
      (∀ (x : EuclideanSpace ℝ (Fin d)) (t R : ℝ), 0 < R →
        ∃ (p : EuclideanSpace ℝ (Fin d)) (a : ℝ),
          ∀ (h : EuclideanSpace ℝ (Fin d)) (ℓ : ℝ),
            |ℓ| ≤ R → ‖h - ℓ • p‖ ≤ R →
            |v (mkSpaceTime (x + h) (t + ℓ)) - v (mkSpaceTime x t) -
              inner ℝ p h - (a - ‖p‖ ^ 2 / 2) * ℓ| ≤ 256 * R) :=
by
  have h_mk_proj : ∀ w : EuclideanSpace ℝ (Fin (d + 1)),
      mkSpaceTime (projSpace w) (projTime w) = w := by
    intro w
    ext j
    refine Fin.lastCases ?_ ?_ j
    · simp [mkSpaceTime, projTime]
    · intro k
      simp [mkSpaceTime, projSpace]
  have h_mk_zero : mkSpaceTime (0 : EuclideanSpace ℝ (Fin d)) 0 = 0 := by
    ext j
    refine Fin.lastCases ?_ ?_ j
    · simp [mkSpaceTime]
    · intro k
      simp [mkSpaceTime]
  have h_mk_add : ∀ (x h : EuclideanSpace ℝ (Fin d)) (t ℓ : ℝ),
      mkSpaceTime (x + h) (t + ℓ) = mkSpaceTime x t + mkSpaceTime h ℓ := by
    intro x h t ℓ
    ext j
    refine Fin.lastCases ?_ ?_ j
    · simp [mkSpaceTime]
    · intro k
      simp [mkSpaceTime]
  have h_projSpace_sub : ∀ w w' : EuclideanSpace ℝ (Fin (d + 1)),
      projSpace (w' - w) = projSpace w' - projSpace w := by
    intro w w'
    ext k
    simp [projSpace]
  have h_projTime_sub : ∀ w w' : EuclideanSpace ℝ (Fin (d + 1)),
      projTime (w' - w) = projTime w' - projTime w := by
    intro w w'
    simp [projTime]
  have h_norm_projTime : ∀ w : EuclideanSpace ℝ (Fin (d + 1)), |projTime w| ≤ ‖w‖ := by
    intro w
    simpa [projTime, Real.norm_eq_abs] using PiLp.norm_apply_le w (Fin.last d)
  have h_norm_projSpace : ∀ w : EuclideanSpace ℝ (Fin (d + 1)), ‖projSpace w‖ ≤ ‖w‖ := by
    intro w
    rw [PiLp.norm_eq_of_L2, PiLp.norm_eq_of_L2]
    apply Real.sqrt_le_sqrt
    rw [Fin.sum_univ_castSucc]
    have h_eq : ∑ i : Fin d, ‖projSpace w i‖ ^ 2 = ∑ i : Fin d, ‖w (Fin.castSucc i)‖ ^ 2 := by
      refine Finset.sum_congr rfl (fun i _ => ?_)
      simp [projSpace]
    rw [h_eq]
    have h_last : 0 ≤ ‖w (Fin.last d)‖ ^ 2 := sq_nonneg _
    linarith
  have h_norm_mk : ∀ (x : EuclideanSpace ℝ (Fin d)) (t : ℝ),
      ‖mkSpaceTime x t‖ ≤ ‖x‖ + |t| := by
    intro x t
    have h_split : mkSpaceTime x t = mkSpaceTime x 0 + mkSpaceTime (0 : EuclideanSpace ℝ (Fin d)) t := by
      have h1 := h_mk_add x 0 0 t
      rwa [add_zero, zero_add] at h1
    have h_nx : ‖mkSpaceTime x 0‖ ≤ ‖x‖ := by
      rw [PiLp.norm_eq_of_L2, PiLp.norm_eq_of_L2]
      apply Real.sqrt_le_sqrt
      rw [Fin.sum_univ_castSucc]
      have h_eq : ∑ i : Fin d, ‖mkSpaceTime x 0 (Fin.castSucc i)‖ ^ 2 = ∑ i : Fin d, ‖x i‖ ^ 2 := by
        refine Finset.sum_congr rfl (fun i _ => ?_)
        simp [mkSpaceTime]
      have h_last : ‖mkSpaceTime x 0 (Fin.last d)‖ ^ 2 = 0 := by
        simp [mkSpaceTime]
      linarith
    have h_nt : ‖mkSpaceTime (0 : EuclideanSpace ℝ (Fin d)) t‖ ≤ |t| := by
      rw [PiLp.norm_eq_of_L2, ← Real.sqrt_sq (abs_nonneg t)]
      apply Real.sqrt_le_sqrt
      rw [Fin.sum_univ_castSucc]
      have h_eq : ∑ i : Fin d, ‖mkSpaceTime (0 : EuclideanSpace ℝ (Fin d)) t (Fin.castSucc i)‖ ^ 2 = 0 := by
        refine Finset.sum_eq_zero (fun i _ => ?_)
        simp [mkSpaceTime]
      have h_last : ‖mkSpaceTime (0 : EuclideanSpace ℝ (Fin d)) t (Fin.last d)‖ ^ 2 = |t| ^ 2 := by
        simp [mkSpaceTime, Real.norm_eq_abs]
      linarith
    calc ‖mkSpaceTime x t‖ = ‖mkSpaceTime x 0 + mkSpaceTime (0 : EuclideanSpace ℝ (Fin d)) t‖ := by rw [h_split]
      _ ≤ ‖mkSpaceTime x 0‖ + ‖mkSpaceTime (0 : EuclideanSpace ℝ (Fin d)) t‖ := norm_add_le _ _
      _ ≤ ‖x‖ + |t| := add_le_add h_nx h_nt
  have h_bdd : ∀ w : EuclideanSpace ℝ (Fin (d + 1)), ∃ B : ℝ, 0 ≤ B ∧ ∀ i : ℕ, |v_seq i w| ≤ B := by
    intro w
    let x := projSpace w
    let t := projTime w
    let K : ℝ := ‖w‖ + 1
    have hK_pos : 0 < K := by dsimp [K]; positivity
    have hx_le : ‖x‖ ≤ K := by
      have := h_norm_projSpace w
      dsimp [x, K]; linarith
    have ht_le : |t| ≤ K := by
      have := h_norm_projTime w
      dsimp [t, K]; linarith
    obtain ⟨C₀, i₀, hC₀_nonneg, h_fit₀⟩ := h_boxes 1 (2 * K) zero_lt_one (by linarith)
    let K₁ : ℝ := (2 * C₀ + 1) * K
    have hK₁_pos : 0 < K₁ := by dsimp [K₁]; positivity
    obtain ⟨C₁, i₁, hC₁_nonneg, h_fit₁⟩ := h_boxes K₁ K₁ hK₁_pos hK₁_pos
    let I₀ : ℕ := max i₀ i₁
    let B_tail : ℝ := 128 * K + 2 * K * C₀ ^ 2 + K * C₀ + (C₁ + 64) * K₁
    have hB_tail_nonneg : 0 ≤ B_tail := by dsimp [B_tail]; positivity
    have h_tail : ∀ i : ℕ, I₀ ≤ i → |v_seq i w| ≤ B_tail := by
      intro i hi
      have hi₀ : i₀ ≤ i := le_trans (le_max_left i₀ i₁) hi
      have hi₁ : i₁ ≤ i := le_trans (le_max_right i₀ i₁) hi
      have h_zero_norm : ‖mkSpaceTime (0 : EuclideanSpace ℝ (Fin d)) 0‖ ≤ 1 := by
        rw [h_mk_zero, norm_zero]; exact zero_le_one
      obtain ⟨p₀, q₀, hpq₀, hA₀, h_box₀⟩ := h_fit₀ i hi₀ 0 0 h_zero_norm
      have hp₀_le : ‖p₀‖ ≤ C₀ := by
        have : 0 ≤ |q₀| := abs_nonneg q₀
        linarith
      have hq₀_le : |q₀| ≤ C₀ := by
        have : 0 ≤ ‖p₀‖ := norm_nonneg p₀
        linarith
      have hA₀_pos : 0 < 1 + lam_seq i * q₀ := by linarith
      have hA₀_inv_nonneg : 0 ≤ (1 + lam_seq i * q₀)⁻¹ := inv_nonneg.mpr (le_of_lt hA₀_pos)
      have hA₀_inv_le : (1 + lam_seq i * q₀)⁻¹ ≤ 2 := by
        rw [inv_le_comm₀ hA₀_pos (by norm_num)]
        linarith
      let α_i : ℝ := (1 + lam_seq i * q₀)⁻¹ * t
      let x₁ : EuclideanSpace ℝ (Fin d) := α_i • p₀
      have hα_abs : |α_i| ≤ 2 * K := by
        dsimp [α_i]
        rw [abs_mul, abs_of_nonneg hA₀_inv_nonneg]
        nlinarith [abs_nonneg t]
      have hx₁_norm : ‖x₁‖ ≤ 2 * K * C₀ := by
        dsimp [x₁]
        rw [norm_smul, Real.norm_eq_abs]
        nlinarith [norm_nonneg p₀, abs_nonneg α_i]
      have ht_half : |t| ≤ (2 * K) / 2 := by linarith
      have hx₁_res : ‖x₁ - ((1 + lam_seq i * q₀)⁻¹ * t) • p₀‖ ≤ 2 * K := by
        dsimp [x₁, α_i]
        rw [sub_self, norm_zero]
        linarith
      have h_step₀ := h_box₀ x₁ t ht_half hx₁_res
      simp only [zero_add] at h_step₀
      rw [h_mk_zero, hv_zero i, sub_zero] at h_step₀
      have h_cs₀ : |inner ℝ p₀ x₁| ≤ 2 * K * C₀ ^ 2 := by
        calc |inner ℝ p₀ x₁| ≤ ‖p₀‖ * ‖x₁‖ := abs_real_inner_le_norm p₀ x₁
          _ ≤ C₀ * (2 * K * C₀) := by nlinarith [norm_nonneg p₀, norm_nonneg x₁]
